let app_render(app) =
    let windows = app[0]
    let i = 0
    let n = windows.length
    for i < n
        let w = windows[i]
        if w[8] == 1
            let fb = w[6]
            let pixels = fb[2]
            let j = 0
            let npix = pixels.length
            for j < npix
                pixels[j] = 0
                j = j + 1
        i = i + 1
    1

let app_run(app) =
    let max_frames = 65536
    let frame = 0
    for app_is_running(app) == 1
        if frame >= max_frames
            (app = app_stop(app))
        else
            app = app_step(app, 1)
            app = app_render(app)
            frame = frame + 1
    app

