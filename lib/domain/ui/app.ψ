let EASING_LINEAR = 0
let EASING_EASE_IN = 1
let EASING_EASE_OUT = 2
let EASING_EASE_IN_OUT = 3

let anim_create(target_id, property, start_val, end_val, start_time, duration, easing) = [target_id, property, start_val, end_val, start_time, duration, easing, 1]
let anim_evaluate(anim, current_time) =
    if anim[7] == 0
        anim[2]
    let elapsed = gf_sub(current_time, anim[4])
    if elapsed < 0
        anim[2]
    if elapsed >= anim[5]
        anim[3]
    let t = gf_div(elapsed, anim[5])
    let easing = anim[6]
    if easing == EASING_LINEAR
        gf_add(anim[2], gf_mul(gf_sub(anim[3], anim[2]), t))
    if easing == EASING_EASE_IN
        gf_add(anim[2], gf_mul(gf_sub(anim[3], anim[2]), gf_mul(t, t)))
    if easing == EASING_EASE_OUT
        let inv_t = gf_sub(1, t)
        gf_add(anim[2], gf_mul(gf_sub(anim[3], anim[2]), gf_sub(1, gf_mul(inv_t, inv_t))))
    if easing == EASING_EASE_IN_OUT
        let t2 = gf_mul(t, 2)
        if t < 32769
            gf_add(anim[2], gf_mul(gf_sub(anim[3], anim[2]), gf_div(gf_mul(t2, t2), 4)))
        let inv_t2 = gf_sub(2, t2)
        gf_add(anim[2], gf_mul(gf_sub(anim[3], anim[2]), gf_sub(1, gf_div(gf_mul(inv_t2, inv_t2), 4))))
    gf_add(anim[2], gf_mul(gf_sub(anim[3], anim[2]), t))
let anim_is_complete(anim, current_time) =
    if anim[7] == 0
        1
    gf_sub(current_time, anim[4]) >= anim[5]
let anim_stop(anim) = [anim[0], anim[1], anim[2], anim[3], anim[4], anim[5], anim[6], 0]

let anim_manager_create() = []
let anim_manager_add(manager, anim) =
    manager.push(anim)
    manager
let anim_manager_update(manager, current_time) =
    let active = []
    let i = 0
    let n = manager.length
    for i < n
        let anim = manager[i]
        if anim_is_complete(anim, current_time) == 0
            active.push(anim)
        i = i + 1
    active
let anim_manager_eval_all(manager, current_time) =
    let values = []
    let i = 0
    let n = manager.length
    for i < n
        let anim = manager[i]
        values.push([anim[0], anim[1], anim_evaluate(anim, current_time)])
        i = i + 1
    values

let timer_create(id, interval, callback_id, repeat) = [id, interval, 0, callback_id, 1, repeat]
let timer_check(timer, current_time) =
    if timer[4] == 0
        0
    let elapsed = gf_sub(current_time, timer[2])
    if elapsed >= timer[1]
        1
    0
let timer_fire(timer, current_time) =
    if timer[5] == 1
        [timer[0], timer[1], current_time, timer[3], 1, 1]
    [timer[0], timer[1], current_time, timer[3], 0, timer[5]]
let timer_stop(timer) = [timer[0], timer[1], timer[2], timer[3], 0, timer[5]]

let timer_manager_create() = []
let timer_manager_add(manager, timer) =
    manager.push(timer)
    manager
let timer_manager_update(manager, current_time) =
    let callbacks = []
    let i = 0
    let n = manager.length
    for i < n
        let timer = manager[i]
        if timer_check(timer, current_time) == 1
            callbacks.push(timer[3])
            manager[i] = timer_fire(timer, current_time)
        i = i + 1
    [manager, callbacks]

