let poles3d_spiral() =
    let p = []
    let r = []
    let i = 0
    for i < 8
        let angle = gf_mul(i, 8192)
        let radius = 50
        let x = gf_mul(radius, gf_pow(angle, 0))
        let y = gf_mul(radius, gf_pow(angle, 1))
        let z = gf_mul(i, 10)
        p.push([0, x, y, z])
        r.push([1, 0, 0, 0])
        i = i + 1
    [p, r]

