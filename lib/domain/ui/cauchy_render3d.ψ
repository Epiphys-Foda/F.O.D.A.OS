let CR3_I = 256
let CR3_PI = 52011
let CR3_MAX_STEPS = 64
let CR3_MAX_DIST = 1000

let quat4_create(w, x, y, z) = [w, x, y, z]
let quat4_add(a, b) = [gf_add(a[0], b[0]), gf_add(a[1], b[1]), gf_add(a[2], b[2]), gf_add(a[3], b[3])]
let quat4_sub(a, b) = [gf_sub(a[0], b[0]), gf_sub(a[1], b[1]), gf_sub(a[2], b[2]), gf_sub(a[3], b[3])]
let quat4_scale(a, s) = [gf_mul(a[0], s), gf_mul(a[1], s), gf_mul(a[2], s), gf_mul(a[3], s)]
let quat4_mul(a, b) = [
        gf_sub(gf_sub(gf_sub(gf_mul(a[0], b[0]), gf_mul(a[1], b[1])), gf_mul(a[2], b[2])), gf_mul(a[3], b[3])),
        gf_add(gf_add(gf_sub(gf_mul(a[0], b[1]), gf_mul(a[1], b[0])), gf_mul(a[2], b[3])), gf_mul(a[3], b[2])),
        gf_add(gf_sub(gf_add(gf_mul(a[0], b[2]), gf_mul(a[1], b[3])), gf_mul(a[2], b[0])), gf_mul(a[3], b[1])),
        gf_add(gf_add(gf_sub(gf_mul(a[0], b[3]), gf_mul(a[1], b[2])), gf_mul(a[2], b[1])), gf_mul(a[3], b[0]))
    ]
let quat4_norm_sq(a) = gf_add(gf_add(gf_add(gf_mul(a[0], a[0]), gf_mul(a[1], a[1])), gf_mul(a[2], a[2])), gf_mul(a[3], a[3]))
let quat4_abs(a) = gf_sqrt(quat4_norm_sq(a))
let quat4_conj(a) = [a[0], gf_neg(a[1]), gf_neg(a[2]), gf_neg(a[3])]
let quat4_inv(a) =
    let n = quat4_norm_sq(a)
    if n == 0
        [0, 0, 0, 0]
    else
        let c = quat4_conj(a)
        [gf_div(c[0], n), gf_div(c[1], n), gf_div(c[2], n), gf_div(c[3], n)]

let quat4_residue_eval(poles, residues, q) =
    let result = [0, 0, 0, 0]
    let n = poles.length
    let i = 0
    for i < n
        let diff = quat4_sub(q, poles[i])
        let nsq = quat4_norm_sq(diff)
        if nsq != 0
            let inv_diff = quat4_inv(diff)
            let term = quat4_mul(residues[i], inv_diff)
            result = quat4_add(result, term)
        i = i + 1
    result

let quat4_to_rgb565(q) =
    let w = q[0]
    let x = q[1]
    let y = q[2]
    let z = q[3]
    let abs_val = quat4_abs(q)
    let r = gf_div(gf_mul(gf_add(w, 32768), 31), 65537)
    let g = gf_div(gf_mul(gf_add(x, 32768), 63), 65537)
    let b = gf_div(gf_mul(gf_add(y, 32768), 31), 65537)
    if r > 31
        r = 31
    if g > 63
        g = 63
    if b > 31
        b = 31
    gf_add(gf_add(gf_mul(r, 2048), gf_mul(g, 32)), b)

let ray_create(ox, oy, oz, dx, dy, dz) = [[ox, oy, oz], [dx, dy, dz]]
let ray_at(ray, t) =
    let o = ray[0]
    let d = ray[1]
    [gf_add(o[0], gf_mul(d[0], t)), gf_add(o[1], gf_mul(d[1], t)), gf_add(o[2], gf_mul(d[2], t))]

let ray_march_volume(fb, x, y, poles, residues, ray, step_size, max_steps, threshold) =
    let color_acc = 0
    let alpha_acc = 0
    let t = 0
    let step = 0
    for step < max_steps
        let pos = ray_at(ray, t)
        let q = [0, pos[0], pos[1], pos[2]]
        let psi = quat4_residue_eval(poles, residues, q)
        let val = quat4_abs(psi)
        if val > threshold
            let sample_color = quat4_to_rgb565(psi)
            let sample_alpha = gf_div(val, gf_add(val, 1))
            let remain = gf_sub(1, alpha_acc)
            color_acc = gf_add(color_acc, gf_mul(gf_mul(sample_color, sample_alpha), remain))
            alpha_acc = gf_add(alpha_acc, gf_mul(sample_alpha, remain))
            if alpha_acc > 32768
                step = max_steps
        t = gf_add(t, step_size)
        step = step + 1
    color_acc

let cauchy3d_render_frame(fb, poles, residues, camera_pos, camera_dir, fov, step_size, max_steps, threshold) =
    let w = fb[0]
    let h = fb[1]
    let pixels = fb[2]
    let cx = gf_div(w, 2)
    let cy = gf_div(h, 2)
    let focal = gf_div(gf_add(w, h), 4)
    let px = 0
    for px < w
        let py = 0
        for py < h
            let dx = gf_sub(px, cx)
            let dy = gf_sub(py, cy)
            let dz = focal
            let ray = ray_create(camera_pos[0], camera_pos[1], camera_pos[2], dx, dy, dz)
            let color = ray_march_volume(fb, px, py, poles, residues, ray, step_size, max_steps, threshold)
            pixels[gf_add(gf_mul(py, w), px)] = color
            py = py + 1
        px = px + 1

let cauchy3d_isosurface(poles, residues, grid_x, grid_y, grid_z, grid_w, grid_h, grid_d, isovalue) =
    let vertices = []
    let gz = 0
    for gz < grid_d
        let gy = 0
        for gy < grid_h
            let gx = 0
            for gx < grid_w
                let x0 = gf_add(grid_x, gx)
                let y0 = gf_add(grid_y, gy)
                let z0 = gf_add(grid_z, gz)
                let x1 = gf_add(x0, 1)
                let y1 = gf_add(y0, 1)
                let z1 = gf_add(z0, 1)
                let v000 = quat4_abs(quat4_residue_eval(poles, residues, [0, x0, y0, z0]))
                let v100 = quat4_abs(quat4_residue_eval(poles, residues, [0, x1, y0, z0]))
                let v010 = quat4_abs(quat4_residue_eval(poles, residues, [0, x0, y1, z0]))
                let v110 = quat4_abs(quat4_residue_eval(poles, residues, [0, x1, y1, z0]))
                let v001 = quat4_abs(quat4_residue_eval(poles, residues, [0, x0, y0, z1]))
                let v101 = quat4_abs(quat4_residue_eval(poles, residues, [0, x1, y0, z1]))
                let v011 = quat4_abs(quat4_residue_eval(poles, residues, [0, x0, y1, z1]))
                let v111 = quat4_abs(quat4_residue_eval(poles, residues, [0, x1, y1, z1]))
                let cube_index = 0
                if v000 < isovalue
                    cube_index = gf_add(cube_index, 1)
                if v100 < isovalue
                    cube_index = gf_add(cube_index, 2)
                if v010 < isovalue
                    cube_index = gf_add(cube_index, 4)
                if v110 < isovalue
                    cube_index = gf_add(cube_index, 8)
                if v001 < isovalue
                    cube_index = gf_add(cube_index, 16)
                if v101 < isovalue
                    cube_index = gf_add(cube_index, 32)
                if v011 < isovalue
                    cube_index = gf_add(cube_index, 64)
                if v111 < isovalue
                    cube_index = gf_add(cube_index, 128)
                if cube_index != 0
                    if cube_index != 255
                        vertices.push([x0, y0, z0, cube_index])
                gx = gx + 1
            gy = gy + 1
        gz = gz + 1
    vertices

let cauchy3d_slice(poles, residues, w_slice, grid_x, grid_y, grid_z, grid_w, grid_h, grid_d) =
    let field = []
    let gz = 0
    for gz < grid_d
        let gy = 0
        for gy < grid_h
            let gx = 0
            for gx < grid_w
                let x = gf_add(grid_x, gx)
                let y = gf_add(grid_y, gy)
                let z = gf_add(grid_z, gz)
                let q = [w_slice, x, y, z]
                let psi = quat4_residue_eval(poles, residues, q)
                field.push(quat4_abs(psi))
                gx = gx + 1
            gy = gy + 1
        gz = gz + 1
    field

