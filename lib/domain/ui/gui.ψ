let layout_vertical(widgets, x, y, spacing) =
    let laid_out = []
    let cy = y
    let i = 0
    let n = widgets.length
    for i < n
        let w = widgets[i]
        laid_out.push(widget_set_pos(w, x, cy))
        cy = gf_add(gf_add(cy, w[5]), spacing)
        i = i + 1
    laid_out
let layout_horizontal(widgets, x, y, spacing) =
    let laid_out = []
    let cx = x
    let i = 0
    let n = widgets.length
    for i < n
        let w = widgets[i]
        laid_out.push(widget_set_pos(w, cx, y))
        cx = gf_add(gf_add(cx, w[4]), spacing)
