let layout_grid(widgets, x, y, cols, cell_w, cell_h) =
    let laid_out = []
    let i = 0
    let n = widgets.length
    for i < n
        let row = i / cols
        let col = i % cols
        laid_out.push(widget_set_pos(widgets[i], gf_add(x, gf_mul(col, cell_w)), gf_add(y, gf_mul(row, cell_h))))
        i = i + 1
    laid_out

