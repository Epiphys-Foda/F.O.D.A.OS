let transform_identity() = [1, 0, 0, 1, 0, 0]
let transform_compose(parent, local) =
    let pa = parent[0]
    let pb = parent[1]
    let pc = parent[2]
    let pd = parent[3]
    let pe = parent[4]
    let pf = parent[5]
    let la = local[0]
    let lb = local[1]
    let lc = local[2]
    let ld = local[3]
    let le = local[4]
    let lf = local[5]
    [
        gf_add(gf_mul(pa, la), gf_mul(pb, lc)),
        gf_add(gf_mul(pa, lb), gf_mul(pb, ld)),
        gf_add(gf_mul(pc, la), gf_mul(pd, lc)),
        gf_add(gf_mul(pc, lb), gf_mul(pd, ld)),
        gf_add(gf_add(gf_mul(pa, le), gf_mul(pb, lf)), pe),
        gf_add(gf_add(gf_mul(pc, le), gf_mul(pd, lf)), pf)
    ]
let transform_apply(t, x, y) = [
        gf_add(gf_mul(t[0], x), gf_add(gf_mul(t[1], y), t[4])),
        gf_add(gf_mul(t[2], x), gf_add(gf_mul(t[3], y), t[5]))
    ]
let transform_invert(t) =
    let a = t[0]
    let b = t[1]
    let c = t[2]
    let d = t[3]
    let det = gf_sub(gf_mul(a, d), gf_mul(b, c))
    if det == 0
        transform_identity()
    let inv_det = gf_inv(det)
    let inv_a = gf_mul(d, inv_det)
    let inv_b = gf_neg(gf_mul(b, inv_det))
    let inv_c = gf_neg(gf_mul(c, inv_det))
    let inv_d = gf_mul(a, inv_det)
    let inv_e = gf_neg(gf_add(gf_mul(inv_a, t[4]), gf_mul(inv_b, t[5])))
    let inv_f = gf_neg(gf_add(gf_mul(inv_c, t[4]), gf_mul(inv_d, t[5])))
    [inv_a, inv_b, inv_c, inv_d, inv_e, inv_f]

