import "../../core/stdlib_lang2/gf_base.ψ"

let CR_I = 256
let CR_PI = 52011
let CR_2PI = 10485

let cpx_create(re, im) = [re, im]
let cpx_add(a, b) = [gf_add(a[0], b[0]), gf_add(a[1], b[1])]
let cpx_sub(a, b) = [gf_sub(a[0], b[0]), gf_sub(a[1], b[1])]
let cpx_mul(a, b) = [
        gf_sub(gf_mul(a[0], b[0]), gf_mul(a[1], b[1])),
        gf_add(gf_mul(a[0], b[1]), gf_mul(a[1], b[0]))
    ]
let cpx_neg(a) = [gf_neg(a[0]), gf_neg(a[1])]
let cpx_conj(a) = [a[0], gf_neg(a[1])]
let cpx_scale(a, s) = [gf_mul(a[0], s), gf_mul(a[1], s)]
let cpx_mul_i(a) = [gf_neg(a[1]), a[0]]
let cpx_div_i(a) = [a[1], gf_neg(a[0])]

let cpx_norm_sq(a) = gf_add(gf_mul(a[0], a[0]), gf_mul(a[1], a[1]))

let cpx_abs(a) = gf_sqrt(cpx_norm_sq(a))

let cpx_arg(a) =
    let re = a[0]
    let im = a[1]
    if re == 0
        if im == 0
            0
        (im < 32769 ? CR_PI / 2 : gf_neg(CR_PI / 2))
    let ratio = gf_div(im, re)
    let angle = ratio
    let x_sq = gf_mul(ratio, ratio)
    let term = ratio
    let k = 1
    for k < 8
        term = gf_mul(term, x_sq)
        let coeff = gf_div(term, gf_add(gf_mul(2, k), 1))
        (k % 2 == 1 ? (angle = gf_sub(angle, coeff)) : (angle = gf_add(angle, coeff)))
        k = k + 1
    if re < 32769
        angle = gf_add(angle, CR_PI)
    angle

let cpx_inv(a) =
    let n = cpx_norm_sq(a)
    if n == 0
        [0, 0]
    else
        let conj = cpx_conj(a)
        [gf_div(conj[0], n), gf_div(conj[1], n)]

let cpx_div(a, b) = cpx_mul(a, cpx_inv(b))

let cpx_pow(a, n) =
    if n == 0
        [1, 0]
    let result = [1, 0]
    let base = a
    let e = n
    for e > 0
        if e % 2 == 1
            result = cpx_mul(result, base)
        base = cpx_mul(base, base)
        e = e / 2
    result

let cpx_exp(a) =
    let re = a[0]
    let im = a[1]
    let exp_re = gf_pow(9680, re)
    let cos_im = 1
    let sin_im = im
    let im_sq = gf_mul(im, im)
    let term_c = 1
    let term_s = im
    let k = 1
    for k < 8
        term_c = gf_mul(term_c, im_sq)
        term_s = gf_mul(term_s, im_sq)
        let fact = gf_mul(gf_mul(gf_mul(2, k), gf_add(gf_mul(2, k), 1)), 1)
        let cc = gf_div(term_c, fact)
        let ss = gf_div(term_s, fact)
        if k % 2 == 1
            cos_im = gf_sub(cos_im, cc)
            sin_im = gf_sub(sin_im, ss)
        else
            cos_im = gf_add(cos_im, cc)
            sin_im = gf_add(sin_im, ss)
        k = k + 1
    [gf_mul(exp_re, cos_im), gf_mul(exp_re, sin_im)]

let cpx_residue_eval(poles, residues, z) =
    let result = [0, 0]
    let n = poles.length
    let i = 0
    for i < n
        let diff = cpx_sub(z, poles[i])
        let nsq = cpx_norm_sq(diff)
        if nsq != 0
            let inv_diff = cpx_inv(diff)
            let term = cpx_mul(residues[i], inv_diff)
            result = cpx_add(result, term)
        i = i + 1
    result

let cpx_to_rgb565(z) =
    let arg = cpx_arg(z)
    let abs_val = cpx_abs(z)
    let hue = gf_div(arg, CR_2PI)
    let bright = gf_div(abs_val, gf_add(abs_val, 1))
    let r = gf_mul(hue, 31)
    let g = gf_mul(bright, 63)
    let b = gf_mul(gf_sub(1, hue), 31)
    if r > 31
        r = 31
    if g > 63
        g = 63
    if b > 31
        b = 31
    gf_add(gf_add(gf_mul(r, 2048), gf_mul(g, 32)), b)

let pixel_to_complex(px, py, w, h, scale, center) =
    let re = gf_add(gf_mul(gf_sub(px, gf_div(w, 2)), scale), center[0])
    let im = gf_add(gf_mul(gf_sub(py, gf_div(h, 2)), scale), center[1])
    [re, im]

let cauchy_render_pixel(poles, residues, px, py, w, h, scale, center) =
    let z = pixel_to_complex(px, py, w, h, scale, center)
    let psi = cpx_residue_eval(poles, residues, z)
    cpx_to_rgb565(psi)

let cauchy_render_frame(fb, poles, residues, scale, center) =
    let w = fb[0]
    let h = fb[1]
    let pixels = fb[2]
    let px = 0
    for px < w
        let py = 0
        for py < h
            let color = cauchy_render_pixel(poles, residues, px, py, w, h, scale, center)
            let idx = gf_add(gf_mul(py, w), px)
            pixels[idx] = color
            py = py + 1
        px = px + 1

let cauchy_render_region(fb, poles, residues, x0, y0, x1, y1, scale, center) =
    let w = fb[0]
    let h = fb[1]
    let pixels = fb[2]
    let px = x0
    for px <= x1
        let py = y0
        for py <= y1
            let color = cauchy_render_pixel(poles, residues, px, py, w, h, scale, center)
            let idx = gf_add(gf_mul(py, w), px)
            pixels[idx] = color
            py = py + 1
        px = px + 1

let cauchy_render_pixel_aa2(poles, residues, px, py, w, h, scale, center) =
    let half = gf_div(scale, 2)
    let z00 = pixel_to_complex(px, py, w, h, scale, center)
    let z10 = pixel_to_complex(gf_add(px, 1), py, w, h, scale, center)
    let z01 = pixel_to_complex(px, gf_add(py, 1), w, h, scale, center)
    let z11 = pixel_to_complex(gf_add(px, 1), gf_add(py, 1), w, h, scale, center)
    let v00 = cpx_residue_eval(poles, residues, z00)
    let v10 = cpx_residue_eval(poles, residues, z10)
    let v01 = cpx_residue_eval(poles, residues, z01)
    let v11 = cpx_residue_eval(poles, residues, z11)
    let avg_re = gf_div(gf_add(gf_add(v00[0], v10[0]), gf_add(v01[0], v11[0])), 4)
    let avg_im = gf_div(gf_add(gf_add(v00[1], v10[1]), gf_add(v01[1], v11[1])), 4)
    cpx_to_rgb565([avg_re, avg_im])

let cauchy_render_frame_aa2(fb, poles, residues, scale, center) =
    let w = fb[0]
    let h = fb[1]
    let pixels = fb[2]
    let px = 0
    for px < w
        let py = 0
        for py < h
            let color = cauchy_render_pixel_aa2(poles, residues, px, py, w, h, scale, center)
            let idx = gf_add(gf_mul(py, w), px)
            pixels[idx] = color
            py = py + 1
        px = px + 1

let cauchy_render_contour_pixel(poles, residues, px, py, w, h, scale, center, levels) =
    let z = pixel_to_complex(px, py, w, h, scale, center)
    let psi = cpx_residue_eval(poles, residues, z)
    let abs_val = cpx_abs(psi)
    let best_dist = 65537
    let best_level = 0
    let i = 0
    let nl = levels.length
    for i < nl
        let diff = gf_sub(abs_val, levels[i])
        let d = gf_mul(diff, diff)
        if d < best_dist
            best_dist = d
        best_level = i
        i = i + 1
    gf_mul(gf_add(best_level, 1), 4096)

let cauchy_render_phase_pixel(poles, residues, px, py, w, h, scale, center) =
    let z = pixel_to_complex(px, py, w, h, scale, center)
    let psi = cpx_residue_eval(poles, residues, z)
    let arg = cpx_arg(psi)
    gf_div(gf_add(arg, CR_PI), CR_2PI)

let cauchy_mark_poles(fb, poles, w, h, scale, center) =
    let pixels = fb[2]
    let n = poles.length
    let i = 0
    for i < n
        let p = poles[i]
        let px = gf_add(gf_div(gf_sub(p[0], center[0]), scale), gf_div(w, 2))
        let py = gf_add(gf_div(gf_sub(p[1], center[1]), scale), gf_div(h, 2))
        if px >= 0
            if px < w
                if py >= 0
                    if py < h
                        let idx = gf_add(gf_mul(py, w), px)
                        pixels[idx] = 65535
                        if gf_add(px, 1) < w
                            pixels[gf_add(idx, 1)] = 65535
                        if gf_sub(px, 1) >= 0
                            pixels[gf_sub(idx, 1)] = 65535
                        if gf_add(py, 1) < h
                            pixels[gf_add(idx, w)] = 65535
                        if gf_sub(py, 1) >= 0
                            pixels[gf_sub(idx, w)] = 65535
        i = i + 1

