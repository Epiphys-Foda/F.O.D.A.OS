        [code, w, 16, w, bmp, 0, 0]
    if code == 108
        glyph_draw_vline(bmp, w, 3, 0, 13)
        [code, w, 16, w, bmp, 0, 0]
    if code == 109
        glyph_draw_vline(bmp, w, 1, 7, 13)
        glyph_draw_vline(bmp, w, 3, 7, 13)
        glyph_draw_vline(bmp, w, 5, 7, 13)
        glyph_draw_hline(bmp, w, 1, 5, 7)
