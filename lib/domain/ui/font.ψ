        glyph_draw_vline(bmp, w, 5, 2, 12)
        glyph_draw_hline(bmp, w, 2, 5, 1)
        glyph_draw_hline(bmp, w, 2, 5, 13)
        [code, w, 16, w, bmp, 0, 0]
    if code == 49
        glyph_draw_vline(bmp, w, 3, 1, 12)
        glyph_pixel_set(bmp, w, 2, 2, 1)
        glyph_draw_hline(bmp, w, 2, 4, 13)
        [code, w, 16, w, bmp, 0, 0]
    if code == 50
        glyph_draw_hline(bmp, w, 1, 6, 1)
        glyph_draw_hline(bmp, w, 1, 6, 7)
        glyph_draw_hline(bmp, w, 1, 6, 13)
        glyph_draw_vline(bmp, w, 6, 1, 7)
        glyph_draw_vline(bmp, w, 1, 7, 13)
        [code, w, 16, w, bmp, 0, 0]
    if code == 51
        glyph_draw_hline(bmp, w, 1, 6, 1)
        glyph_draw_hline(bmp, w, 1, 6, 7)
        glyph_draw_hline(bmp, w, 1, 6, 13)
        glyph_draw_vline(bmp, w, 4, 1, 13)
        [code, w, 16, w, bmp, 0, 0]
    if code == 52
        glyph_draw_vline(bmp, w, 1, 1, 7)
        glyph_draw_vline(bmp, w, 5, 1, 13)
        glyph_draw_hline(bmp, w, 1, 5, 7)
        [code, w, 16, w, bmp, 0, 0]
    if code == 53
        glyph_draw_hline(bmp, w, 1, 6, 1)
