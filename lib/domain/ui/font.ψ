        glyph_draw_hline(bmp, w, 1, 6, 13)
        glyph_draw_hline(bmp, w, 1, 4, 10)
        glyph_draw_vline(bmp, w, 1, 7, 13)
        [code, w, 16, w, bmp, 0, 0]
