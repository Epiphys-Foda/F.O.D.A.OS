import "../../core/stdlib_lang2/gf_base.ψ"

let FONT_MAX_GLYPHS = 65536
let FONT_DEFAULT_SIZE = 16
let FONT_GLYPH_W = 8
let FONT_GLYPH_H = 16

let FONT_ATTR_NORMAL = 0
let FONT_ATTR_BOLD = 1
let FONT_ATTR_ITALIC = 2
let FONT_ATTR_UNDERLINE = 4

let glyph_create(code, width, height, advance) = [code, width, height, advance, [], 0, 0]
let glyph_set_bitmap(glyph, bitmap) = [glyph[0], glyph[1], glyph[2], glyph[3], bitmap, glyph[5], glyph[6]]
let glyph_set_bearing(glyph, bx, by) = [glyph[0], glyph[1], glyph[2], glyph[3], glyph[4], bx, by]

let glyph_gen_blank(w, h) =
    let bmp = []
    let i = 0
    for i < gf_mul(w, h)
        bmp.push(0)
        i = i + 1
    bmp
let glyph_pixel_set(bmp, w, x, y, val) =
    bmp[gf_add(gf_mul(y, w), x)] = val
let glyph_pixel_get(bmp, w, x, y) =
    bmp[gf_add(gf_mul(y, w), x)]
let glyph_fill_rect(bmp, w, x0, y0, x1, y1) =
    let y = y0
    for y <= y1
        let x = x0
        for x <= x1
            glyph_pixel_set(bmp, w, x, y, 1)
            x = x + 1
        y = y + 1
let glyph_draw_hline(bmp, w, x0, x1, y) =
    let x = x0
    for x <= x1
        glyph_pixel_set(bmp, w, x, y, 1)
        x = x + 1
let glyph_draw_vline(bmp, w, x, y0, y1) =
    let y = y0
    for y <= y1
        glyph_pixel_set(bmp, w, x, y, 1)
        y = y + 1
let glyph_draw_diag(bmp, w, x0, y0, x1, y1) =
    let dx = 1
    let dy = 1
    if x1 < x0
        dx = -1
    if y1 < y0
        dy = -1
    let steps = x1 - x0
    if y1 - y0 > steps
        steps = y1 - y0
    if y0 - y1 > steps
        steps = y0 - y1
    let i = 0
    for i <= steps
        let x = x0 + dx * i
        let y = y0 + dy * i
        if x >= 0
            if x < 8
                (y >= 0 ? (y < 16 ? glyph_pixel_set(bmp, w, x, y, 1) : 0) : 0)
        i = i + 1

let glyph_gen_ascii(code) =
    let w = FONT_GLYPH_W
    let h = FONT_GLYPH_H
    let bmp = glyph_gen_blank(w, h)
    if code == 32
        [code, w, h, w, bmp, 0, 0]
    if code == 33
        glyph_draw_vline(bmp, w, 3, 0, 10)
        glyph_pixel_set(bmp, w, 3, 12, 1)
        [code, w, h, w, bmp, 0, 0]
    if code == 34
        glyph_draw_vline(bmp, w, 2, 0, 4)
        glyph_draw_vline(bmp, w, 5, 0, 4)
        [code, w, h, w, bmp, 0, 0]
    if code == 39
        glyph_draw_vline(bmp, w, 3, 0, 3)
        [code, w, h, w, bmp, 0, 0]
    if code == 40
        glyph_pixel_set(bmp, w, 4, 1, 1)
        glyph_pixel_set(bmp, w, 3, 2, 1)
        glyph_draw_vline(bmp, w, 3, 3, 11)
        glyph_pixel_set(bmp, w, 4, 12, 1)
        [code, w, h, w, bmp, 0, 0]
    if code == 41
        glyph_pixel_set(bmp, w, 3, 1, 1)
        glyph_pixel_set(bmp, w, 4, 2, 1)
        glyph_draw_vline(bmp, w, 4, 3, 11)
        glyph_pixel_set(bmp, w, 3, 12, 1)
        [code, w, h, w, bmp, 0, 0]
    if code == 42
        glyph_pixel_set(bmp, w, 3, 2, 1)
        glyph_pixel_set(bmp, w, 4, 2, 1)
        glyph_pixel_set(bmp, w, 2, 1, 1)
        glyph_pixel_set(bmp, w, 5, 1, 1)
        glyph_pixel_set(bmp, w, 3, 0, 1)
        glyph_pixel_set(bmp, w, 4, 0, 1)
        [code, w, h, w, bmp, 0, 0]
    if code == 43
        glyph_draw_hline(bmp, w, 1, 5, 7)
        glyph_draw_vline(bmp, w, 3, 4, 10)
        [code, w, h, w, bmp, 0, 0]
    if code == 44
        glyph_draw_vline(bmp, w, 3, 11, 13)
        glyph_pixel_set(bmp, w, 2, 13, 1)
        [code, w, h, w, bmp, 0, 0]
    if code == 45
        glyph_draw_hline(bmp, w, 1, 5, 7)
        [code, w, h, w, bmp, 0, 0]
    if code == 46
        glyph_pixel_set(bmp, w, 3, 12, 1)
        [code, w, h, w, bmp, 0, 0]
    if code == 47
        glyph_draw_diag(bmp, w, 0, 12, 6, 0)
        [code, w, h, w, bmp, 0, 0]
    if code == 48
        glyph_draw_vline(bmp, w, 2, 2, 12)
        glyph_draw_vline(bmp, w, 5, 2, 12)
        glyph_draw_hline(bmp, w, 2, 5, 1)
        glyph_draw_hline(bmp, w, 2, 5, 13)
        [code, w, h, w, bmp, 0, 0]
    if code == 49
        glyph_draw_vline(bmp, w, 3, 1, 12)
        glyph_pixel_set(bmp, w, 4, 1, 1)
        glyph_draw_hline(bmp, w, 2, 4, 13)
        [code, w, h, w, bmp, 0, 0]
    if code == 58
        glyph_pixel_set(bmp, w, 3, 4, 1)
        glyph_pixel_set(bmp, w, 3, 12, 1)
        [code, w, h, w, bmp, 0, 0]
    if code == 59
        glyph_pixel_set(bmp, w, 3, 4, 1)
        glyph_draw_vline(bmp, w, 3, 11, 13)
        [code, w, h, w, bmp, 0, 0]
    if code == 60
        glyph_draw_diag(bmp, w, 5, 1, 1, 7)
        glyph_draw_diag(bmp, w, 1, 7, 5, 13)
        [code, w, h, w, bmp, 0, 0]
    if code == 61
        glyph_draw_hline(bmp, w, 1, 5, 5)
        glyph_draw_hline(bmp, w, 1, 5, 9)
        [code, w, h, w, bmp, 0, 0]
    if code == 62
        glyph_draw_diag(bmp, w, 1, 1, 5, 7)
        glyph_draw_diag(bmp, w, 5, 7, 1, 13)
        [code, w, h, w, bmp, 0, 0]
    if code == 63
        glyph_draw_vline(bmp, w, 5, 1, 4)
        glyph_draw_hline(bmp, w, 2, 5, 0)
        glyph_draw_vline(bmp, w, 2, 1, 3)
        glyph_pixel_set(bmp, w, 3, 12, 1)
        [code, w, h, w, bmp, 0, 0]
    if code == 91
        glyph_draw_vline(bmp, w, 4, 1, 12)
        glyph_draw_hline(bmp, w, 4, 6, 1)
        glyph_draw_hline(bmp, w, 4, 6, 12)
        [code, w, h, w, bmp, 0, 0]
    if code == 93
        glyph_draw_vline(bmp, w, 4, 1, 12)
        glyph_draw_hline(bmp, w, 2, 4, 1)
        glyph_draw_hline(bmp, w, 2, 4, 12)
        [code, w, h, w, bmp, 0, 0]
    if code == 95
        glyph_draw_hline(bmp, w, 1, 6, 14)
        [code, w, h, w, bmp, 0, 0]
    if code == 123
        glyph_pixel_set(bmp, w, 4, 1, 1)
        glyph_draw_vline(bmp, w, 3, 2, 6)
        glyph_pixel_set(bmp, w, 4, 7, 1)
        glyph_draw_vline(bmp, w, 3, 8, 12)
        glyph_pixel_set(bmp, w, 4, 12, 1)
        [code, w, h, w, bmp, 0, 0]
    if code == 125
        glyph_pixel_set(bmp, w, 3, 1, 1)
        glyph_draw_vline(bmp, w, 4, 2, 6)
        glyph_pixel_set(bmp, w, 3, 7, 1)
        glyph_draw_vline(bmp, w, 4, 8, 12)
        glyph_pixel_set(bmp, w, 3, 12, 1)
        [code, w, h, w, bmp, 0, 0]
    if code == 124
        glyph_draw_vline(bmp, w, 3, 0, 13)
        [code, w, h, w, bmp, 0, 0]
    if code == 126
        glyph_pixel_set(bmp, w, 2, 3, 1)
        glyph_pixel_set(bmp, w, 3, 2, 1)
        glyph_pixel_set(bmp, w, 4, 3, 1)
        glyph_pixel_set(bmp, w, 5, 4, 1)
        [code, w, h, w, bmp, 0, 0]
    if code >= 65
        if code <= 90
            glyph_gen_upper(bmp, w, code)
    if code >= 97
        if code <= 122
            glyph_gen_lower(bmp, w, code)
    if code >= 48
        if code <= 57
            glyph_gen_digit(bmp, w, code)
    [code, w, h, w, bmp, 0, 0]

let glyph_gen_upper(bmp, w, code) =
    if code == 65
        glyph_draw_vline(bmp, w, 1, 3, 13)
        glyph_draw_vline(bmp, w, 6, 3, 13)
        glyph_draw_hline(bmp, w, 1, 6, 2)
        glyph_draw_hline(bmp, w, 1, 6, 7)
        glyph_pixel_set(bmp, w, 0, 2, 1)
        glyph_pixel_set(bmp, w, 7, 2, 1)
        [code, w, 16, w, bmp, 0, 0]
    if code == 66
        glyph_draw_vline(bmp, w, 1, 1, 13)
        glyph_draw_hline(bmp, w, 1, 5, 1)
        glyph_draw_hline(bmp, w, 1, 5, 7)
        glyph_draw_hline(bmp, w, 1, 5, 13)
