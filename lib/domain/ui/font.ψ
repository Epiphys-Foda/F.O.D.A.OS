    if code == 114
        glyph_draw_vline(bmp, w, 1, 7, 13)
        glyph_draw_hline(bmp, w, 1, 4, 7)
        glyph_pixel_set(bmp, w, 4, 8, 1)
        glyph_pixel_set(bmp, w, 5, 9, 1)
        [code, w, 16, w, bmp, 0, 0]
    if code == 115
        glyph_draw_hline(bmp, w, 1, 5, 7)
        glyph_draw_hline(bmp, w, 1, 5, 10)
        glyph_draw_hline(bmp, w, 1, 5, 13)
        glyph_draw_vline(bmp, w, 1, 7, 10)
        glyph_draw_vline(bmp, w, 5, 10, 13)
        [code, w, 16, w, bmp, 0, 0]
    if code == 116
        glyph_draw_vline(bmp, w, 3, 3, 13)
        glyph_draw_hline(bmp, w, 1, 5, 3)
        [code, w, 16, w, bmp, 0, 0]
    if code == 117
        glyph_draw_vline(bmp, w, 1, 7, 13)
        glyph_draw_vline(bmp, w, 5, 7, 13)
