        glyph_draw_hline(bmp, w, 1, 6, 13)
        glyph_draw_vline(bmp, w, 1, 7, 13)
        glyph_draw_vline(bmp, w, 6, 7, 13)
        [code, w, 16, w, bmp, 0, 0]
    if code == 98
        glyph_draw_vline(bmp, w, 1, 0, 13)
        glyph_draw_hline(bmp, w, 1, 5, 7)
        glyph_draw_hline(bmp, w, 1, 5, 13)
        glyph_draw_vline(bmp, w, 5, 7, 13)
        [code, w, 16, w, bmp, 0, 0]
    if code == 99
        glyph_draw_hline(bmp, w, 2, 6, 7)
        glyph_draw_hline(bmp, w, 2, 6, 13)
        glyph_draw_vline(bmp, w, 2, 7, 13)
        [code, w, 16, w, bmp, 0, 0]
