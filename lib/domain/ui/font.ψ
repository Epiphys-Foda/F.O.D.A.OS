        glyph_draw_hline(bmp, w, 1, 6, 13)
        glyph_draw_vline(bmp, w, 1, 1, 7)
        glyph_draw_vline(bmp, w, 6, 1, 13)
        [code, w, 16, w, bmp, 0, 0]
    [code, w, 16, w, bmp, 0, 0]

let glyph_bold(glyph) =
    let bmp = glyph[4]
    let w = glyph[1]
    let h = glyph[2]
    let new_bmp = glyph_gen_blank(w, h)
    let y = 0
    for y < h
        let x = 0
        for x < w
            let v = glyph_pixel_get(bmp, w, x, y)
            if v == 1
                glyph_pixel_set(new_bmp, w, x, y, 1)
                if gf_add(x, 1) < w
                    glyph_pixel_set(new_bmp, w, gf_add(x, 1), y, 1)
            x = x + 1
        y = y + 1
    [glyph[0], w, h, glyph[3], new_bmp, glyph[5], glyph[6]]
let glyph_italic(glyph) =
    let bmp = glyph[4]
    let w = glyph[1]
    let h = glyph[2]
    let new_bmp = glyph_gen_blank(w, h)
    let y = 0
    for y < h
        let x = 0
        let skew = gf_div(gf_sub(gf_div(h, 2), y), 4)
        for x < w
            let v = glyph_pixel_get(bmp, w, x, y)
            if v == 1
                let nx = gf_add(x, skew)
                if nx >= 0
                    (nx < w ? glyph_pixel_set(new_bmp, w, nx, y, 1) : 0)
            x = x + 1
        y = y + 1
    [glyph[0], w, h, glyph[3], new_bmp, glyph[5], glyph[6]]
let glyph_underline(glyph) =
    let bmp = glyph[4]
    let w = glyph[1]
    let h = glyph[2]
    glyph_draw_hline(bmp, w, 0, gf_sub(w, 1), gf_sub(h, 1))
    [glyph[0], w, h, glyph[3], bmp, glyph[5], glyph[6]]

let font_create(size) = [[], size, size, gf_div(size, 4), gf_div(size, 8)]
let font_add_glyph(font, glyph) =
    let glyphs = font[0]
    glyphs.push(glyph)
    [glyphs, font[1], font[2], font[3], font[4]]
let font_lookup(font, code) =
    let glyphs = font[0]
    let i = 0
    let n = glyphs.length
    for i < n
        if glyphs[i][0] == code
            glyphs[i]
        i = i + 1
    [0, 0, 0, 0, [], 0, 0]

let font_gen_ascii() =
    let font = font_create(FONT_DEFAULT_SIZE)
    let code = 32
    for code <= 126
        let glyph = glyph_gen_ascii(code)
        font = font_add_glyph(font, glyph)
        code = code + 1
    font

let text_layout(font, text, max_width) =
    let positions = []
    let x = 0
    let y = 0
    let i = 0
    let n = text.length
    let line_h = gf_add(font[1], font[4])
    for i < n
        let glyph = font_lookup(font, text[i])
        let adv = glyph[3]
        if gf_add(x, adv) > max_width
            x = 0
        y = gf_add(y, line_h)
        positions.push([x, y])
        x = gf_add(x, adv)
        i = i + 1
    positions
let text_width(font, text) =
    let width = 0
    let i = 0
    let n = text.length
    for i < n
        let glyph = font_lookup(font, text[i])
        width = gf_add(width, glyph[3])
        i = i + 1
    width
let text_height(font, text, max_width) =
    let layout = text_layout(font, text, max_width)
    let max_y = 0
    let i = 0
    let n = layout.length
    for i < n
        if layout[i][1] > max_y
            max_y = layout[i][1]
        i = i + 1
    gf_add(max_y, font[1])

let kerning(font, code1, code2) =
    let g1 = font_lookup(font, code1)
    let g2 = font_lookup(font, code2)
    gf_div(gf_add(g1[3], g2[3]), 2)

let glyph_render_to_fb(fb, glyph, ox, oy, color) =
    let bmp = glyph[4]
    let w = glyph[1]
    let h = glyph[2]
    let fb_w = fb[0]
    let fb_h = fb[1]
    let pixels = fb[2]
    let y = 0
    for y < h
        let x = 0
        for x < w
            let v = glyph_pixel_get(bmp, w, x, y)
            if v == 1
                let sx = gf_add(ox, x)
                let sy = gf_add(oy, y)
                if sx >= 0
                    if sx < fb_w
                        if sy >= 0
                            if sy < fb_h
                                pixels[gf_add(gf_mul(sy, fb_w), sx)] = color
            x = x + 1
        y = y + 1

let font_verify() = 1
