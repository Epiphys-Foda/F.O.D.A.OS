        glyph_pixel_set(bmp, w, 6, 8, 1)
        glyph_pixel_set(bmp, w, 6, 9, 1)
        glyph_pixel_set(bmp, w, 6, 10, 1)
        glyph_pixel_set(bmp, w, 6, 11, 1)
        glyph_pixel_set(bmp, w, 6, 12, 1)
        [code, w, 16, w, bmp, 0, 0]
    if code == 67
        glyph_draw_vline(bmp, w, 1, 3, 11)
        glyph_draw_hline(bmp, w, 1, 5, 2)
        glyph_draw_hline(bmp, w, 1, 5, 12)
        [code, w, 16, w, bmp, 0, 0]
    if code == 73
        glyph_draw_vline(bmp, w, 3, 1, 13)
        glyph_draw_hline(bmp, w, 2, 4, 1)
        glyph_draw_hline(bmp, w, 2, 4, 13)
        [code, w, 16, w, bmp, 0, 0]
    if code == 76
        glyph_draw_vline(bmp, w, 1, 1, 13)
        glyph_draw_hline(bmp, w, 1, 6, 13)
        [code, w, 16, w, bmp, 0, 0]
    if code == 79
        glyph_draw_vline(bmp, w, 1, 2, 12)
        glyph_draw_vline(bmp, w, 6, 2, 12)
        glyph_draw_hline(bmp, w, 1, 6, 1)
        glyph_draw_hline(bmp, w, 1, 6, 13)
        [code, w, 16, w, bmp, 0, 0]
    if code == 83
        glyph_draw_hline(bmp, w, 1, 6, 1)
        glyph_draw_hline(bmp, w, 1, 6, 7)
        glyph_draw_hline(bmp, w, 1, 6, 13)
        glyph_draw_vline(bmp, w, 1, 1, 7)
        glyph_draw_vline(bmp, w, 6, 7, 13)
        [code, w, 16, w, bmp, 0, 0]
    if code == 84
        glyph_draw_hline(bmp, w, 0, 6, 1)
        glyph_draw_vline(bmp, w, 3, 1, 13)
        [code, w, 16, w, bmp, 0, 0]
    if code == 90
        glyph_draw_hline(bmp, w, 1, 6, 1)
        glyph_draw_hline(bmp, w, 1, 6, 13)
        glyph_draw_diag(bmp, w, 6, 1, 1, 13)
        [code, w, 16, w, bmp, 0, 0]
    [code, w, 16, w, bmp, 0, 0]

