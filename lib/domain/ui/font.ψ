        glyph_draw_hline(bmp, w, 1, 6, 1)
        glyph_draw_hline(bmp, w, 1, 6, 7)
        glyph_draw_hline(bmp, w, 1, 6, 13)
        glyph_draw_vline(bmp, w, 1, 1, 13)
        glyph_draw_vline(bmp, w, 6, 7, 13)
