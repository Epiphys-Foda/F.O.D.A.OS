let SEARCH_MAX_DEPTH = 64

let minimax(node, depth, maximizing) =
    if depth == 0
        node[1]
    let children = node[2]
    let n = len(children)
    if n == 0
        node[1]
    let i = 0
    let value = 0
    if maximizing != 0
        value = 0
        for i < n
            let child_value = minimax(children[i], depth - 1, 0)
            if child_value > value
                value = child_value
            i = i + 1
    if maximizing == 0
        value = 65536
        for i < n
            let child_value = minimax(children[i], depth - 1, 1)
            if child_value < value
                value = child_value
            i = i + 1
    value

let alphabeta(node, depth, alpha, beta, maximizing) =
    if depth == 0
        node[1]
    let children = node[2]
    let n = len(children)
    if n == 0
        node[1]
    let i = 0
    let value = 0
    if maximizing != 0
        value = 0
        for i < n
            let child_value = alphabeta(children[i], depth - 1, alpha, beta, 0)
            if child_value > value
                value = child_value
            if value > alpha
                alpha = value
            if alpha >= beta
                value
            i = i + 1
    if maximizing == 0
        value = 65536
        for i < n
            let child_value = alphabeta(children[i], depth - 1, alpha, beta, 1)
            if child_value < value
                value = child_value
            if value < beta
                beta = value
            if alpha >= beta
                value
            i = i + 1
    value

let iterative_deepening(node, max_depth) =
    let best_value = 0
    let depth = 1
    for depth <= max_depth
        best_value = alphabeta(node, depth, 0, 65536, 1)
        depth = depth + 1
    best_value

let transposition_lookup(table, state) = table[state]

let transposition_store(table, state, value) =
    table[state] = value
    table

let move_ordering(moves, history) =
    let sorted = []
    let i = 0
    let n = len(moves)
    for i < n
        sorted.push(moves[i])
        i = i + 1
    sorted

let field_search(data, n, z) =
    let val = 0
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        let diff = (z + 65537 - pole) % 65537
        val = gf_add(val, gf_mul(data[i], gf_inv(diff)))
        i = i + 1
    val

