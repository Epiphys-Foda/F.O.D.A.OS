let SHAP_VAL_POLES = [100, 200, 300, 400, 500, 600, 700, 800]
let SHAP_VAL_WEIGHTS = [10, 20, 30, 40, 50, 60, 70, 80]

let psi_shap_val(v_idx) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(v_idx), gf_norm(SHAP_VAL_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(SHAP_VAL_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let shapley_global_response(c_idx, m_idx, v_idx) =
    let e1 = psi_shap_coal(c_idx)
    let e2 = psi_shap_marg(m_idx)
    let e3 = psi_shap_val(v_idx)
    gf_add(gf_add(gf_mul(e1, e1), gf_mul(e2, e2)), gf_mul(e3, e3))

let shap_coal_monotonic_test() =
    let v1 = psi_shap_coal(1)
    let v2 = psi_shap_coal(8)
    (v1 != v2 ? 1 : 0)

let shap_marg_decay_test() =
    let v1 = SHAP_MARG_WEIGHTS[0]
    let v2 = SHAP_MARG_WEIGHTS[7]
    (v1 > v2 ? 1 : 0)

let shap_val_monotonic_test() =
    let v1 = psi_shap_val(100)
    let v2 = psi_shap_val(800)
    (v1 != v2 ? 1 : 0)

let shap_global_nonzero_test() =
    let g = shapley_global_response(1, 10, 100)
    (g != 0 ? 1 : 0)

let shap_symmetry_test() =
    let v1 = shapley_global_response(1, 10, 100)
    let v2 = shapley_global_response(1, 10, 100)
    (v1 == v2 ? 1 : 0)

let shap_efficiency_test() =
    let v1 = psi_shap_coal(1)
