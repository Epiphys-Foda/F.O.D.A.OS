let SHAP_COAL_POLES = [1, 2, 3, 4, 5, 6, 7, 8]
let SHAP_COAL_WEIGHTS = [10, 20, 30, 40, 50, 60, 70, 80]

let psi_shap_coal(c_idx) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(c_idx), gf_norm(SHAP_COAL_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(SHAP_COAL_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let SHAP_MARG_POLES = [10, 20, 30, 40, 50, 60, 70, 80]
let SHAP_MARG_WEIGHTS = [80, 70, 60, 50, 40, 30, 20, 10]

let psi_shap_marg(m_idx) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(m_idx), gf_norm(SHAP_MARG_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(SHAP_MARG_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
