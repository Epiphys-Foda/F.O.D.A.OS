let SHAPLEY_MAX_PLAYERS = 16

let shapley_value(game, player) =
    let n = game[0]
    let values = game[1]
    let shapley = 0
    let i = 0
    let n_coalitions = len(values)
    for i < n_coalitions
        let coalition_value = values[i]
        let mask = i
        let size = 0
        let j = 0
        for j < n
            if mask / gf_pow(2, j) % 2 == 1
                size = size + 1
            j = j + 1
        let in_coalition = mask / gf_pow(2, player) % 2
        if in_coalition == 1
            let prev_mask = mask - gf_pow(2, player)
            let prev_value = values[prev_mask]
            let marginal = gf_sub(coalition_value, prev_value)
            let weight = gf_div(gf_mul(factorial(size - 1), factorial(n - size)), factorial(n))
            shapley = gf_add(shapley, gf_mul(weight, marginal))
        i = i + 1
    shapley
let factorial(n) =
    let result = 1
    let i = 2
    for i <= n
        result = gf_mul(result, i)
        i = i + 1
    result
let core_check(game, allocation) =
    let values = game[1]
    let i = 0
    let n_coalitions = len(values)
    for i < n_coalitions
        let coalition_value = values[i]
        let allocation_sum = 0
        let j = 0
        let n = game[0]
        for j < n
            if i / gf_pow(2, j) % 2 == 1
                allocation_sum = gf_add(allocation_sum, allocation[j])
            j = j + 1
        if allocation_sum < coalition_value
            0
        i = i + 1
    1
let coalition_create(members) = [members, 0]
let coalition_value(game, coalition) =
    let members = coalition[0]
    let mask = 0
    let i = 0
    let n = len(members)
    for i < n
        mask = mask + gf_pow(2, members[i])
        i = i + 1
    game[1][mask]
let banzhaf_index(game, player) =
    let n = game[0]
    let values = game[1]
    let banzhaf = 0
    let i = 0
    let n_coalitions = len(values)
    for i < n_coalitions
        let in_coalition = i / gf_pow(2, player) % 2
        if in_coalition == 1
            let prev_mask = i - gf_pow(2, player)
            let marginal = gf_sub(values[i], values[prev_mask])
            if marginal > 0
                banzhaf = banzhaf + 1
        i = i + 1
    banzhaf
let field_shapley(data, n, z) =
    let val = 0
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        let diff = (z + 65537 - pole) % 65537
        val = gf_add(val, gf_mul(data[i], gf_inv(diff)))
        i = i + 1
    val

