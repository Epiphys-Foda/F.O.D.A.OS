let route_new(methods, path_prefix, service_name) =
    [methods, path_prefix, "", service_name, 0, [], 100]

let route_methods(r) = r[0]
let route_path(r) = r[1]
let route_host(r) = r[2]
let route_service(r) = r[3]
let route_strip(r) = r[4]
let route_tags(r) = r[5]
let route_weight(r) = r[6]

let route_set_host(r, host) =
    r[2] = host
    r

let route_set_strip(r, flag) =
    r[4] = flag
    r

let route_set_weight(r, w) =
    r[6] = w
    r

let route_add_tag(r, tag) =
    r[5].push(tag)
    r

let route_matches(r, method, path, host) =
    let method_ok = 1
    let methods = route_methods(r)
    if len(methods) > 0
        method_ok = 0
        let i = 0
        let n = len(methods)
        for i < n
            if methods[i] == method
                method_ok = 1
                i = n
            i = i + 1
    let path_ok = str_starts_with(path, route_path(r))
    let host_ok = 1
    if route_host(r) != ""
        host_ok = host == route_host(r)
    method_ok * path_ok * host_ok

let router_new() =
    [[]]

let router_routes(rt) = rt[0]

let router_add(rt, route) =
    let routes = router_routes(rt)
    routes.push(route)
    rt[0] = routes
    rt

let router_match(rt, method, path, host) =
    let routes = router_routes(rt)
    let i = 0
    let n = len(routes)
    let result = 0
    for i < n
        let r = routes[i]
        if route_matches(r, method, path, host) == 1
            result = r
            i = n
        i = i + 1
    result

let router_match_all(rt, method, path, host) =
    let routes = router_routes(rt)
    let result = []
    let i = 0
    let n = len(routes)
    for i < n
        let r = routes[i]
        if route_matches(r, method, path, host) == 1
            result.push(r)
        i = i + 1
    result

