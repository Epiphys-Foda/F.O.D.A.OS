let doc_new(id, content, vector) =
    [id, content, vector, [], 0]

let doc_id(d) = d[0]
let doc_content(d) = d[1]
let doc_vector(d) = d[2]
let doc_terms(d) = d[3]
let doc_ts(d) = d[4]

let doc_set_terms(d, terms) =
    d[3] = terms
    d

let doc_set_ts(d, ts) =
    d[4] = ts
    d

let tokenize(content) =
    let tokens = []
    let n = len(content)
    let i = 0
    for i < n
        tokens.push(content[i])
        i = i + 1
    tokens

let index_new() =
    [{}, 0]

let idx_map(idx) = idx[0]
let idx_count(idx) = idx[1]

let index_add_doc(idx, doc) =
    let content = doc_content(doc)
    let tokens = tokenize(content)
    doc = doc_set_terms(doc, tokens)
    let m = idx_map(idx)
    let i = 0
    let n = len(tokens)
    for i < n
        let t = tokens[i]
        let lst = m[t]
        if lst == 0
            lst = []
            lst.push(doc_id(doc))
            m[t] = lst
        else
            let found = 0
            let j = 0
            let k = len(lst)
            for j < k
                if lst[j] == doc_id(doc)
                    found = 1
                    j = k
                j = j + 1
            if found == 0
                lst.push(doc_id(doc))
        i = i + 1
    idx[0] = m
    idx[1] = idx_count(idx) + 1
    idx

let index_search(idx, query) =
    let tokens = tokenize(query)
    let m = idx_map(idx)
    let n = len(tokens)
    if n == 0
        []
    else
        let result = 0
        let i = 0
        for i < n
            let t = tokens[i]
            let lst = m[t]
            if lst == 0
                result = []
                i = n
            else
                if result == 0
                    result = lst
                else
                    let inter = []
                    let j = 0
                    let jn = len(result)
                    for j < jn
                        let k = 0
                        let kn = len(lst)
                        let found = 0
                        for k < kn
                            if result[j] == lst[k]
                                found = 1
                                k = kn
                            k = k + 1
                        if found == 1
                            inter.push(result[j])
                        j = j + 1
                    result = inter
            i = i + 1
        if result == 0
            []
        else
            result

let ri_mulmod(a, b) =
    let r = 0
    let x = a % 65537
    let y = b % 65537
    for y > 0
        if y % 2 == 1
            r = (r + x) % 65537
        x = (x + x) % 65537
        y = y / 2
    r

let vector_dot(a, b) =
    let sum = 0
    let n = len(a)
    let i = 0
    for i < n
        sum = sum + ri_mulmod(a[i], b[i])
        i = i + 1
    sum % 65537

let vector_norm_sq(a) =
    let sum = 0
    let n = len(a)
    let i = 0
    for i < n
        sum = sum + ri_mulmod(a[i], a[i])
        i = i + 1
    sum % 65537

let manhattan_dist(a, b) =
    let dist = 0
    let n = len(a)
    let i = 0
    for i < n
        let diff = a[i] - b[i]
        if diff < 0
            dist = dist - diff
        else
            dist = dist + diff
        i = i + 1
    dist

let vector_search(docs, query_vec, k) =
    let scored = []
    let i = 0
    let n = len(docs)
    for i < n
        let d = docs[i]
        let vec = doc_vector(d)
        if len(vec) > 0
            let dist = manhattan_dist(query_vec, vec)
            scored.push([dist, d])
        i = i + 1
    let result = []
    let j = 0
    for j < k && j < len(scored)
        let max_idx = j
        let m = j + 1
        for m < len(scored)
            if scored[m][0] < scored[max_idx][0]
                max_idx = m
            m = m + 1
        let tmp = scored[j]
        scored[j] = scored[max_idx]
        scored[max_idx] = tmp
        result.push(scored[j][1])
        j = j + 1
    result

let rrf_k() = 60

let rrf_score(rank) =
    let denom = rrf_k() + rank
    if denom == 0
        0
    else
        65537 / denom

let rrf_fuse(rankings) =
    let scores = []
    let max_id = 0
    let i = 0
    let n = len(rankings)
    for i < n
        let ranking = rankings[i]
        let j = 0
        let m = len(ranking)
        for j < m
            if ranking[j] > max_id
                max_id = ranking[j]
            j = j + 1
        i = i + 1
    let z = 0
    for z <= max_id
        scores.push(0)
        z = z + 1
    i = 0
    for i < n
        let ranking = rankings[i]
        let j = 0
        let m = len(ranking)
        for j < m
            let did = ranking[j]
            scores[did] = scores[did] + rrf_score(j)
            j = j + 1
        i = i + 1
    let ids = []
    let k0 = 0
    for k0 <= max_id
        ids.push(k0)
        k0 = k0 + 1
    let vals = []
    let k = 0
    let kn = len(ids)
    for k < kn
        vals.push(scores[ids[k]])
        k = k + 1
    let L = len(ids)
    let p = 0
    for p < L - 1
        let max_i = p
        let q = p + 1
        for q < L
            if vals[q] > vals[max_i]
                max_i = q
            q = q + 1
        let tmp_id = ids[p]
        ids[p] = ids[max_i]
        ids[max_i] = tmp_id
        let tmp_v = vals[p]
        vals[p] = vals[max_i]
        vals[max_i] = tmp_v
        p = p + 1
    ids

let hybrid_search(docs, idx, query, query_vec, k) =
    let vec_results = vector_search(docs, query_vec, k * 2)
    let vec_ids = []
    let i = 0
    for i < len(vec_results)
        vec_ids.push(doc_id(vec_results[i]))
        i = i + 1
    let kw_ids = index_search(idx, query)
    let rankings = [vec_ids, kw_ids]
    let fused_ids = rrf_fuse(rankings)
    let result = []
    let j = 0
    for j < k && j < len(fused_ids)
        result.push(fused_ids[j])
        j = j + 1
    result

let kg_new() =
    [arr_new_n(64), [], [], 0, []]

let kg_entities(kg) = kg[0]
let kg_relations(kg) = kg[1]
let kg_next_id(kg) = kg[3]

let kg_add_entity(kg, name, vector) =
    let eid = kg_next_id(kg)
    let ents = kg_entities(kg)
    ents[eid] = [eid, name, vector, 0]
    kg[0] = ents
    kg[3] = eid + 1
    eid

let kg_add_relation(kg, src_id, target_id, rel_type) =
    let srcs = kg[1]
    let dsts = kg[2]
    let types = kg[4]
    srcs.push(src_id)
    dsts.push(target_id)
    types.push(rel_type)
    kg[1] = srcs
    kg[2] = dsts
    kg[4] = types
    kg

let graphrag_expand(kg, seed_ids, depth) =
    let n_total = kg_next_id(kg)
    let visited = []
    let z = 0
    for z < n_total
        visited.push(0)
        z = z + 1
    let out_ids = []
    let frontier = []
    let i = 0
    let n = len(seed_ids)
    for i < n
        frontier.push(seed_ids[i])
        visited[seed_ids[i]] = 1
        out_ids.push(seed_ids[i])
        i = i + 1
    let d = 0
    for d < depth && len(frontier) > 0
        let next_frontier = []
        let j = 0
        let m = len(frontier)
        for j < m
            let eid = frontier[j]
            let srcs = kg[1]
            let dsts = kg[2]
            let rn = len(srcs)
            let k = 0
            for k < rn
                if srcs[k] == eid
                    let target = dsts[k]
                    if visited[target] == 0
                        visited[target] = 1
                        next_frontier.push(target)
                        out_ids.push(target)
                k = k + 1
            j = j + 1
        frontier = next_frontier
        d = d + 1
    out_ids

