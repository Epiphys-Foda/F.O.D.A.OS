let service_new(name, lb_policy) =
    [name, [], lb_policy, {}]

let svc_name(s) = s[0]
let svc_instances(s) = s[1]
let svc_policy(s) = s[2]
let svc_cb(s) = s[3]

let service_add_instance(s, inst) =
    let instances = svc_instances(s)
    instances.push(inst)
    s[1] = instances
    s

let lb_round_robin(instances, counter) =
    let n = len(instances)
    if n == 0
        0
    else
        let idx = counter % n
        instances[idx]

let lb_least_connections(instances) =
    let best = 0
    let min_conns = 65536
    let i = 0
    let n = len(instances)
    for i < n
        let inst = instances[i]
        if inst_healthy(inst) == 1
            let c = inst_conns(inst)
            if c < min_conns
                min_conns = c
                best = inst
        i = i + 1
    best

let lb_weighted_rr(instances, counter) =
    let total_weight = 0
    let i = 0
    let n = len(instances)
    for i < n
        let inst = instances[i]
        if inst_healthy(inst) == 1
            total_weight = total_weight + inst_weight(inst)
        i = i + 1
    if total_weight == 0
        0
    else
        let target = counter % total_weight
        let cumulative = 0
        let i2 = 0
        let found = 0
        for i2 < n
            let inst = instances[i2]
            if inst_healthy(inst) == 1
                cumulative = cumulative + inst_weight(inst)
                if target < cumulative
                    found = inst
                    i2 = n
            i2 = i2 + 1
        found

let lb_select(service, counter) =
    let instances = svc_instances(service)
    let policy = svc_policy(service)
    if policy == 0
        lb_round_robin(instances, counter)
    else
        0
    if policy == 1
        lb_least_connections(instances)
    else
        0
    if policy == 2
        lb_weighted_rr(instances, counter)
    else
        lb_round_robin(instances, counter)

let cb_new(failure_threshold, timeout_ms) =
    [0, 0, 0, failure_threshold, timeout_ms, 0]

let cb_state(cb) = cb[0]
let cb_failures(cb) = cb[1]
let cb_successes(cb) = cb[2]
let cb_threshold(cb) = cb[3]
let cb_timeout(cb) = cb[4]
let cb_last_fail(cb) = cb[5]

let cb_record_success(cb) =
    if cb_state(cb) == 2
        cb[2] = cb[2] + 1
        if cb[2] >= 2
            cb[0] = 0
            cb[1] = 0
        else
            0
        cb[1] = 0
    cb

let cb_record_failure(cb, current_time) =
    cb[1] = cb[1] + 1
    cb[5] = current_time
    if cb[1] >= cb_threshold(cb)
        cb[0] = 1
    cb

let cb_can_request(cb, current_time) =
    let state = cb_state(cb)
    if state == 0
        1
    else
        0
    if state == 1
        if current_time - cb_last_fail(cb) > cb_timeout(cb)
            cb[0] = 2
            cb[2] = 0
            1
        else
            0
    else
        1

let token_bucket_new(capacity, rate) =
    [capacity, rate, capacity, 0]

let tb_capacity(tb) = tb[0]
let tb_rate(tb) = tb[1]
let tb_tokens(tb) = tb[2]
let tb_last_refill(tb) = tb[3]

let tb_refill(tb, current_time) =
    let elapsed = current_time - tb_last_refill(tb)
    let new_tokens = tb_tokens(tb) + (elapsed * tb_rate(tb))
    let cap = tb_capacity(tb)
    if new_tokens > cap
        new_tokens = cap
    tb[2] = new_tokens
    tb[3] = current_time
    tb

let tb_try_consume(tb, current_time, count) =
    tb = tb_refill(tb, current_time)
    if tb_tokens(tb) >= count
        tb[2] = tb_tokens(tb) - count
        1
    else
        0

let route_new(match_path, target_service, weight) =
    [match_path, target_service, weight]

let route_path(r) = r[0]
let route_service(r) = r[1]
let route_weight(r) = r[2]

let registry_add_route(reg, route) =
    let routes = reg_routes(reg)
    routes[route_path(route)] = route
    reg[1] = routes
    reg

let registry_match_route(reg, path) =
    let routes = reg_routes(reg)
    let keys = keys_of(routes)
    let best = 0
    let best_len = 0
    let i = 0
    let n = len(keys)
    for i < n
        let p = keys[i]
        let match_ok = 1
        let j = 0
        let pn = len(p)
        for j < pn
            if j >= len(path)
                match_ok = 0
                j = pn
            else
                0
            if path[j] != p[j]
                match_ok = 0
                j = pn
            j = j + 1
        if match_ok == 1
            if pn > best_len
                best_len = pn
                best = routes[p]
        i = i + 1
    best

let retry_call(fn_ref, args, max_retries, timeout) =
    let attempts = 0
    let success = 0
    let result = 0
    for attempts <= max_retries && success == 0
        if fn_ref != 0
            result = fn_ref
            success = 1
        else
            success = 0
        attempts = attempts + 1
    [success, result, attempts - 1]

let mesh_call(reg, path, request, current_time, counter) =
    let route = registry_match_route(reg, path)
    if route == 0
        [-1, "no_route"]
    else
        let svc_name = route_service(route)
        let services = reg_services(reg)
        let service = services[svc_name]
        if service == 0
            [-2, "no_service"]
        else
            let cb = svc_cb(service)
            if cb != 0
                if cb_can_request(cb, current_time) == 0
                    [-3, "circuit_open"]
            let inst = lb_select(service, counter)
            if inst == 0
                [-4, "no_instance"]
            else
                inst = inst_inc_conn(inst)
                let result = [1, "ok"]
                inst = inst_dec_conn(inst)
                if cb != 0
                    if result[0] == 1
                        cb_record_success(cb)
                    else
                        cb_record_failure(cb, current_time)
                result

