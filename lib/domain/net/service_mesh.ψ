let instance_new(id, host, port, weight) =
    [id, host, port, weight, 1, 0]

let inst_id(i) = i[0]
let inst_host(i) = i[1]
let inst_port(i) = i[2]
let inst_weight(i) = i[3]
let inst_healthy(i) = i[4]
let inst_conns(i) = i[5]

let inst_set_healthy(i, h) =
    i[4] = h
    i

let inst_inc_conn(i) =
    i[5] = i[5] + 1
    i

let inst_dec_conn(i) =
    i[5] = i[5] - 1
    i

let registry_new() =
    [{}, {}, {}, {}]

let reg_services(r) = r[0]
let reg_routes(r) = r[1]
