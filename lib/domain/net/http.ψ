let http_request_create(method, path) = [method, path, [], []]
let http_request_set_header(req, key, value) =
    let headers = req[2]
    headers.push([key, value])
    [req[0], req[1], headers, req[3]]
let http_request_set_body(req, body) = [req[0], req[1], req[2], body]
let http_response_create(status) = [status, [], []]
let http_response_set_header(resp, key, value) =
    let headers = resp[1]
    headers.push([key, value])
    [resp[0], headers, resp[2]]
let http_response_set_body(resp, body) = [resp[0], resp[1], body]
let http_route_create(method, path, handler) = [method, path, handler]
let http_route_match(route, method, path) =
    (route[0] == method && route[1] == path ? 1 : 0)
let http_router_dispatch(routes, req) =
    let i = 0
    let n = len(routes)
    for i < n
        let route = routes[i]
        if http_route_match(route, req[0], req[1]) == 1
            route[2]
        i = i + 1
    0
let middleware_chain(mw_ids, req) =
    let result = req
    let i = 0
    let n = len(mw_ids)
    for i < n
        result = http_mw_apply(mw_ids[i], result)
        i = i + 1
    result
let http_mw_apply(mw_id, req) =
    req
let HTTP_200_OK = 200
let HTTP_400_BAD_REQUEST = 400
let HTTP_404_NOT_FOUND = 404
let HTTP_500_INTERNAL = 500
let url_parse_path(url) = gf_norm(url) % 65536
let url_parse_query(url) = gf_norm(url) / 65536
let http_field_route(path, n) =
    let hash = 0
    let i = 0
    for i < n
        hash = gf_add(hash, gf_mul(path, gf_pow(3, i)))
        i = i + 1
    hash

