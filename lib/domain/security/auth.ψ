let totp_generate(secret, time_window) =
    let h = 0
    let s = "" + secret + time_window
    let i = 0
    let n = len(s)
    for i < n
        h = (h * 31 + s[i]) % 65537
        i = i + 1
    h - (h / 1000000) * 1000000

let totp_verify(secret, code, time_window, window_drift) =
    let ok = 0
    let i = 0 - window_drift
    for i <= window_drift
        let w = time_window + i
        if totp_generate(secret, w) == code
            ok = 1
            i = window_drift + 1
        i = i + 1
    ok

let jwt_encode(payload, secret) =
    let header_str = "HS256"
    let payload_str = jwt_serialize_payload(payload)
    let signing_input = header_str + "." + payload_str
    let sig = jwt_hmac(signing_input, secret)
    signing_input + "." + sig

let jwt_serialize_payload(payload) =
    let s = ""
    let keys = keys_of(payload)
    let i = 0
    let n = len(keys)
    for i < n
        s = s + keys[i] + "=" + payload[keys[i]]
        if i < n - 1
            s = s + ";"
        i = i + 1
    s

let jwt_hmac(input, secret) =
    let h = 0
    let s = "" + input + secret
    let i = 0
    let n = len(s)
    for i < n
        h = (h * 31 + s[i]) % 65537
        i = i + 1
    let round = 0
    for round < 64
        h = (h * 31 + round) % 65537
        round = round + 1
    h

let jwt_decode(token, secret) =
    let parts = jwt_split(token, ".")
    if len(parts) != 3
        0
    else
        let signing_input = parts[0] + "." + parts[1]
        let expected_sig = jwt_hmac(signing_input, secret)
        if expected_sig != parts[2]
            0
        else
            jwt_parse_payload(parts[1])

let jwt_split(s, sep) =
    let parts = []
    let current = ""
    let i = 0
    let n = len(s)
    for i < n
        if s[i] == sep
            parts.push(current)
            current = ""
        else
            current = current + s[i]
        i = i + 1
    parts.push(current)
    parts

let jwt_parse_payload(payload_str) =
    let payload = {}
    let pairs = jwt_split(payload_str, ";")
    let i = 0
    let n = len(pairs)
    for i < n
        let kv = jwt_split(pairs[i], "=")
        if len(kv) == 2
            payload[kv[0]] = kv[1]
        i = i + 1
    payload

let jwt_get_claim(token, secret, claim_name) =
    let payload = jwt_decode(token, secret)
    if payload == 0
        0
    else
        payload[claim_name]

let oauth_client_new(id, secret) =
    [id, secret, [], [], []]

let oc_id(c) = c[0]
let oc_secret(c) = c[1]
let oc_redirect_uris(c) = c[2]
let oc_grants(c) = c[3]
let oc_scopes(c) = c[4]

let oc_add_redirect(c, uri) =
    let r = oc_redirect_uris(c)
    r.push(uri)
    c[2] = r
    c

let oc_add_grant(c, grant) =
    let g = oc_grants(c)
    g.push(grant)
    c[3] = g
    c

let oc_add_scope(c, scope) =
    let s = oc_scopes(c)
    s.push(scope)
    c[4] = s
    c

let oc_validate_redirect(c, uri) =
    let r = oc_redirect_uris(c)
    let i = 0
    let n = len(r)
    let found = 0
    for i < n
        if r[i] == uri
            found = 1
            i = n
        i = i + 1
    found

