let user_set_password(u, password, salt) =
    let h = 0
    let s = "" + password + salt
    let i = 0
    let n = len(s)
    for i < n
        h = (h * 31 + s[i]) % 65537
        i = i + 1
    let round = 0
    for round < 1000
        h = (h * 31 + round) % 65537
        round = round + 1
    u[2] = h
    u[3] = salt
    u

let user_verify_password(u, password) =
