let token_generate_access(client_id, user_id, ts) =
    let h = 0
    let s = "" + client_id + user_id + ts
    let i = 0
    let n = len(s)
    for i < n
        h = (h * 31 + s[i]) % 65537
        i = i + 1
    "" + h

let token_generate_refresh(client_id, user_id, ts) =
    let h = 0
    let s = "" + client_id + user_id + ts + "refresh"
    let i = 0
    let n = len(s)
    for i < n
        h = (h * 31 + s[i]) % 65537
        i = i + 1
    "" + h

let auth_server_new() =
    [{}, {}, {}, []]

let as_clients(a) = a[0]
let as_codes(a) = a[1]
let as_tokens(a) = a[2]
let as_revoked(a) = a[3]

let as_register_client(a, client) =
    let cs = as_clients(a)
    cs[oc_id(client)] = client
    a[0] = cs
    a

let as_get_client(a, client_id) =
    let cs = as_clients(a)
    cs[client_id]

let as_create_auth_code(a, client_id, user_id, redirect_uri, scope, current_ts) =
    let client = as_get_client(a, client_id)
    if client == 0
        0
    else
        if oc_validate_redirect(client, redirect_uri) == 0
            0
        else
            let code = "" + current_ts + user_id
            let auth_code = auth_code_new(code, client_id, user_id, redirect_uri, scope, current_ts + 600)
            let codes = as_codes(a)
            codes[code] = auth_code
            a[1] = codes
            code

let as_exchange_code(a, code, client_id, client_secret, current_ts) =
    let codes = as_codes(a)
    let auth_code = codes[code]
    if auth_code == 0
        0
    else
        if ac_is_valid(auth_code, current_ts) == 0
            0
        else
            let client = as_get_client(a, ac_client(auth_code))
            if client == 0
                0
            else
                0
            if oc_secret(client) != client_secret
                0
            else
                auth_code = ac_use(auth_code)
                codes[code] = auth_code
                a[1] = codes
                let access = token_generate_access(client_id, ac_user(auth_code), current_ts)
                let refresh = token_generate_refresh(client_id, ac_user(auth_code), current_ts)
                let token = token_new(access, refresh, 3600, ac_scope(auth_code))
                let tokens = as_tokens(a)
                tokens[access] = [ac_user(auth_code), ac_scope(auth_code), current_ts + 3600]
                a[2] = tokens
                token

let as_refresh_token(a, refresh_token, current_ts) =
    let access = token_generate_access("refreshed", 0, current_ts)
    let new_token = token_new(access, refresh_token, 3600, "default")
    new_token

let as_validate_token(a, access_token, current_ts) =
    let revoked = as_revoked(a)
    let i = 0
    let n = len(revoked)
    for i < n
        if revoked[i] == access_token
            0
            i = n
        i = i + 1
    let tokens = as_tokens(a)
    let info = tokens[access_token]
    if info == 0
        0
    else
        let expires_at = info[2]
        if current_ts > expires_at
            0
        else
            [info[0], info[1]]

let as_revoke_token(a, access_token) =
    let revoked = as_revoked(a)
    revoked.push(access_token)
    a[3] = revoked
    a

