let audit_event_new(id, ts, actor, action, resource, result, ip) =
    [id, ts, actor, action, resource, result, ip, {}, ""]

let ev_id(e) = e[0]
let ev_ts(e) = e[1]
let ev_actor(e) = e[2]
let ev_action(e) = e[3]
let ev_resource(e) = e[4]
let ev_result(e) = e[5]
let ev_ip(e) = e[6]
let ev_details(e) = e[7]
let ev_prev_hash(e) = e[8]

let ev_set_detail(e, key, value) =
    let d = ev_details(e)
    d[key] = value
    e[7] = d
    e

let ev_get_detail(e, key) =
    let d = ev_details(e)
    d[key]

let ev_compute_hash(e) =
    let s = "" + ev_id(e) + ev_ts(e) + ev_actor(e) + ev_action(e) + ev_resource(e) + ev_result(e) + ev_prev_hash(e)
    let h = 0
    let i = 0
    let n = len(s)
    for i < n
        h = (h * 31 + s[i]) % 65537
        i = i + 1
    let round = 0
    for round < 16
        h = (h * 31 + round) % 65537
        round = round + 1
    h

let ev_set_prev_hash(e, prev_hash) =
    e[8] = prev_hash
    e

let audit_log_new() =
    [[], "", 0, 1]

let log_events(l) = l[0]
let log_last_hash(l) = l[1]
let log_count(l) = l[2]
let log_append_only(l) = l[3]

let log_append(l, event) =
    if log_append_only(l) == 0
        0
    else
        event = ev_set_prev_hash(event, log_last_hash(l))
        let events = log_events(l)
        events.push(event)
        l[0] = events
        l[2] = log_count(l) + 1
        let new_hash = ev_compute_hash(event)
        l[1] = new_hash
        l

let log_verify_chain(l) =
    let events = log_events(l)
    let expected_prev = ""
    let i = 0
    let n = len(events)
    let ok = 1
    for i < n
        let e = events[i]
        if ev_prev_hash(e) != expected_prev
            ok = 0
            i = n
        let computed = ev_compute_hash(e)
        if i == n - 1
            if computed != log_last_hash(l)
                ok = 0
                i = n
        expected_prev = computed
        i = i + 1
    ok

let log_query(l, filter_actor, filter_action, filter_result, start_ts, end_ts) =
    let events = log_events(l)
    let results = []
    let i = 0
    let n = len(events)
    for i < n
        let e = events[i]
        let match_ = 1
        if filter_actor != "*"
            if ev_actor(e) != filter_actor
                match_ = 0
        if filter_action != "*"
            if ev_action(e) != filter_action
                match_ = 0
        if filter_result != -1
            if ev_result(e) != filter_result
                match_ = 0
        if ev_ts(e) < start_ts
            match_ = 0
        if ev_ts(e) > end_ts
            match_ = 0
        if match_ == 1
            results.push(e)
        i = i + 1
    results

let log_seal(l) =
    l[3] = 0
    l

let alert_rule_new(name, condition_fn, threshold, window_sec) =
    [name, condition_fn, threshold, window_sec, "log_alert"]

let ar_name(r) = r[0]
let ar_fn(r) = r[1]
let ar_threshold(r) = r[2]
let ar_window(r) = r[3]
let ar_action(r) = r[4]

let alert_engine_new() =
    [[], [], []]

let ae_rules(ae) = ae[0]
let ae_alerts(ae) = ae[1]
let ae_count(ae) = ae[2]

let ae_add_rule(ae, rule) =
    let rs = ae_rules(ae)
    rs.push(rule)
    ae[0] = rs
    ae

let ae_evaluate(ae, log, current_ts) =
    let rules = ae_rules(ae)
    let i = 0
    let n = len(rules)
    let triggered = []
    for i < n
        let rule = rules[i]
        let matches = log_query(log, "*", "*", 0, current_ts - ar_window(rule), current_ts)
        let match_count = len(matches)
        if match_count >= ar_threshold(rule)
            let alert = [ar_name(rule), current_ts, match_count, ar_action(rule)]
            triggered.push(alert)
        i = i + 1
    let alerts = ae_alerts(ae)
    let j = 0
    let m = len(triggered)
    for j < m
        alerts.push(triggered[j])
        j = j + 1
    ae[1] = alerts
    ae[2] = ae_count(ae) + len(triggered)
    triggered

let ae_get_alerts(ae) = ae_alerts(ae)

let compliance_report_generate(log, period_start, period_end, framework) =
    let events = log_query(log, "*", "*", -1, period_start, period_end)
    let total = len(events)
    let success = 0
    let failed = 0
    let i = 0
    for i < total
        let e = events[i]
        if ev_result(e) == 1
            success = success + 1
        else
            failed = failed + 1
        i = i + 1
    [framework, period_start, period_end, total, success, failed]

let compliance_framework_name(f) =
    if f == 0
        "SOX"
    else
        0
    if f == 1
        "HIPAA"
    else
        0
    if f == 2
        "GDPR"
    else
        "Unknown"

