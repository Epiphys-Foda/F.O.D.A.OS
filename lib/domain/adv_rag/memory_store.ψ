        ok2 = 0
    if entries[2] == 0
        ok2 = 0

    let r5 = ms_store(s, "epi1", [10, 20, 30], ["history"], 500, MS_EPISODIC)
    s = r5[0]

    let r6 = ms_store(s, "fact1", [100, 200, 300], ["knowledge"], 600, MS_SEMANTIC)
    s = r6[0]

    let recalled = ms_recall_by_vector(s, [1, 2, 3], 5)
    let ok3 = 1
