        ok5 = 0

    let epi_msgs = ms_recall_by_type(s, MS_EPISODIC)
    let ok6 = 1
    if len(epi_msgs) != 1
        ok6 = 0

    let ar = ms_access(s, 5)
    s = ar[0]
    let ok7 = 1
    if ar[1] == 0
        ok7 = 0
    let e = ms_entries(s)[5]
    if ms_e_access(e) != 1
        ok7 = 0

    let cr = ms_consolidate(s)
    s = cr[0]
    let ok8 = 1
    if cr[1] != 3
        ok8 = 0
    if ms_consolidated(s) != 3
        ok8 = 0
    let type_idx = ms_types(s)
    if len(type_idx[MS_WORKING]) != 0
        ok8 = 0
    if len(type_idx[MS_EPISODIC]) != 4
        ok8 = 0

    let fr = ms_forget(s, 1, 600)
    s = fr[0]
    let ok9 = 1
    if fr[1] < 0
        ok9 = 0

    let ok10 = 1
    if ms_bragg_check(s) != 1
        ok10 = 0

    ok1 * ok2 * ok3 * ok4 * ok5 * ok6 * ok7 * ok8 * ok9 * ok10

