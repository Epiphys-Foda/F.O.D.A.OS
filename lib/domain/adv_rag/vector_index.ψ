        ok5 = 0

    let r4 = vi_ivf_add(ivf, [1, 2, 4], "a", 100)
    ivf = r4[0]
    let r5 = vi_ivf_add(ivf, [10, 20, 31], "b", 200)
    ivf = r5[0]
    let r6 = vi_ivf_add(ivf, [1, 3, 5], "a", 300)
    ivf = r6[0]

    let ivf_knn = vi_ivf_search(ivf, [1, 2, 3], 2)
    let ok6 = 1
    if len(ivf_knn) == 0
        ok6 = 0

    ok1 * ok2 * ok3 * ok4 * ok5 * ok6

