import "../domain_field.ψ"
let HY_P = 65537

let HY_SRC_VECTOR  = 1
let HY_SRC_KEYWORD = 2
let HY_SRC_GRAPH   = 3

let HY_FUSION_RRF      = 1
let HY_FUSION_WEIGHTED = 2

let HY_RRF_K         = 60
let HY_RRF_SCALE     = 61440
let HY_DEFAULT_WEIGHT_V = 512
let HY_DEFAULT_WEIGHT_K = 256
let HY_DEFAULT_WEIGHT_G = 256

let hy_result_new(doc_id, score, source) =
    [doc_id, score, source]

let hy_res_id(r)     = r[0]
let hy_res_score(r)   = r[1]
let hy_res_src(r)    = r[2]

let hy_vector_search(doc_vectors, query_vec, top_k) =
    let n = len(doc_vectors)
    let scores = []
    let i = 0
    for i < n
        let doc = doc_vectors[i]
        let doc_id = doc[0]
        let dot = 0
        let j = 1
        let m = len(query_vec)
        for j <= m
            if j < len(doc)
                dot = dot + doc[j] * query_vec[j - 1]
            j = j + 1
        let score = dot / 1024
        if score < 0
            score = -score
        scores.push(hy_result_new(doc_id, score, HY_SRC_VECTOR))
        i = i + 1
    let sn = len(scores)
    i = 0
    for i < sn - 1
        let j = i + 1
        for j < sn
            if hy_res_score(scores[j]) > hy_res_score(scores[i])
                let tmp = scores[i]
                scores[i] = scores[j]
                scores[j] = tmp
            j = j + 1
        i = i + 1
    let top = []
    i = 0
    for i < top_k
        if i < sn
            top.push(scores[i])
        i = i + 1
    top

let hy_keyword_search(inverted_index, doc_freq_map, n_docs, query_terms, top_k) =
    let scores = {}
    let i = 0
    let n = len(query_terms)
    for i < n
        let term = query_terms[i]
        let postings = inverted_index[term]
        if postings != 0
            let df = doc_freq_map[term]
            if df == 0
                df = 1
            let idf = (n_docs - df + 1) * 1024 / (df + 1)
            let j = 0
            let m = len(postings)
            for j < m
                let p = postings[j]
                let doc_id = p[0]
                let tf = p[1]
                let score = tf * idf
                let cur = scores[doc_id]
                if cur == 0
                    cur = 0
                scores[doc_id] = cur + score
                j = j + 1
        i = i + 1
    let keys = keys_of(scores)
    let results = []
    i = 0
    let nk = len(keys)
    for i < nk
        results.push(hy_result_new(keys[i], scores[keys[i]], HY_SRC_KEYWORD))
        i = i + 1
    let rn = len(results)
    i = 0
    for i < rn - 1
        let j = i + 1
        for j < rn
            if hy_res_score(results[j]) > hy_res_score(results[i])
                let tmp = results[i]
                results[i] = results[j]
                results[j] = tmp
            j = j + 1
        i = i + 1
    let top = []
    i = 0
    for i < top_k
        if i < rn
            top.push(results[i])
        i = i + 1
    top

let hy_graph_search(adjacency_map, seed_nodes, max_depth, top_k) =
    let visited = {}
    let scores = {}
    let queue = []
    let i = 0
    let n = len(seed_nodes)
    for i < n
        queue.push([seed_nodes[i], 0, 1024])
        i = i + 1
    for len(queue) > 0
        let item = queue[0]
        queue = arr_drop(queue, 1)
        let node_id = item[0]
        let depth = item[1]
        let score = item[2]
        if visited[node_id] == 0
            visited[node_id] = 1
            let cur_score = scores[node_id]
            if cur_score == 0
                cur_score = 0
            scores[node_id] = cur_score + score
            if depth < max_depth
                let neighbors = adjacency_map[node_id]
                if neighbors != 0
                    let j = 0
                    let m = len(neighbors)
                    for j < m
                        let edge = neighbors[j]
                        let new_score = score * edge[1] / 1024
                        queue.push([edge[0], depth + 1, new_score])
                        j = j + 1
    let keys = keys_of(scores)
    let results = []
    i = 0
    let nk = len(keys)
    for i < nk
        results.push(hy_result_new(keys[i], scores[keys[i]], HY_SRC_GRAPH))
        i = i + 1
    let rn = len(results)
    i = 0
    for i < rn - 1
        let j = i + 1
        for j < rn
            if hy_res_score(results[j]) > hy_res_score(results[i])
                let tmp = results[i]
                results[i] = results[j]
                results[j] = tmp
            j = j + 1
        i = i + 1
    let top = []
    i = 0
    for i < top_k
        if i < rn
            top.push(results[i])
        i = i + 1
    top

let hy_fuse_rrf(vector_results, keyword_results, graph_results) =
    let scores = {}
    let i = 0
    let sources = [vector_results, keyword_results, graph_results]
    let n_sources = len(sources)
    for i < n_sources
        let src = sources[i]
        let j = 0
        let m = len(src)
        for j < m
            let r = src[j]
            let doc_id = hy_res_id(r)
            let rank = j + 1
            let rrf_score = HY_RRF_SCALE / (HY_RRF_K + rank)
            let cur = scores[doc_id]
            if cur == 0
                cur = 0
            scores[doc_id] = cur + rrf_score
            j = j + 1
        i = i + 1
    let keys = keys_of(scores)
    let results = []
    i = 0
    let nk = len(keys)
    for i < nk
        results.push(hy_result_new(keys[i], scores[keys[i]], 0))
        i = i + 1
    let rn = len(results)
    i = 0
    for i < rn - 1
        let j = i + 1
        for j < rn
            if hy_res_score(results[j]) > hy_res_score(results[i])
                let tmp = results[i]
                results[i] = results[j]
                results[j] = tmp
            j = j + 1
        i = i + 1
    results

let hy_fuse_weighted(vector_results, keyword_results, graph_results, w_v, w_k, w_g) =
    let scores = {}
    let i = 0
    let nv = len(vector_results)
    for i < nv
        let r = vector_results[i]
        let doc_id = hy_res_id(r)
        let s = hy_res_score(r) * w_v / 1024
        scores[doc_id] = s
        i = i + 1
    i = 0
    let nk = len(keyword_results)
    for i < nk
        let r = keyword_results[i]
        let doc_id = hy_res_id(r)
        let s = hy_res_score(r) * w_k / 1024
        let cur = scores[doc_id]
        if cur == 0
            cur = 0
        scores[doc_id] = cur + s
        i = i + 1
    i = 0
    let ng = len(graph_results)
    for i < ng
        let r = graph_results[i]
        let doc_id = hy_res_id(r)
        let s = hy_res_score(r) * w_g / 1024
        let cur = scores[doc_id]
        if cur == 0
            cur = 0
        scores[doc_id] = cur + s
        i = i + 1
    let keys = keys_of(scores)
    let results = []
    i = 0
    let nkeys = len(keys)
    for i < nkeys
        results.push(hy_result_new(keys[i], scores[keys[i]], 0))
        i = i + 1
    let rn = len(results)
    i = 0
    for i < rn - 1
        let j = i + 1
        for j < rn
            if hy_res_score(results[j]) > hy_res_score(results[i])
                let tmp = results[i]
                results[i] = results[j]
                results[j] = tmp
            j = j + 1
        i = i + 1
    results

let hy_bragg_consistency(doc_vectors, query_vec, inverted_index, doc_freq_map, n_docs, query_terms, adjacency_map, seed_nodes, max_depth, top_k) =
    let v1 = hy_vector_search(doc_vectors, query_vec, top_k)
    let k1 = hy_keyword_search(inverted_index, doc_freq_map, n_docs, query_terms, top_k)
    let g1 = hy_graph_search(adjacency_map, seed_nodes, max_depth, top_k)
    let f1 = hy_fuse_rrf(v1, k1, g1)
    let v2 = hy_vector_search(doc_vectors, query_vec, top_k)
    let k2 = hy_keyword_search(inverted_index, doc_freq_map, n_docs, query_terms, top_k)
    let g2 = hy_graph_search(adjacency_map, seed_nodes, max_depth, top_k)
    let f2 = hy_fuse_rrf(v2, k2, g2)
    let pass = 1
    if len(f1) != len(f2)
        pass = 0
    else
        let i = 0
        let n = len(f1)
        for i < n
            if hy_res_id(f1[i]) != hy_res_id(f2[i])
                pass = 0
            if hy_res_score(f1[i]) != hy_res_score(f2[i])
                pass = 0
            i = i + 1
    pass

let hy_self_test() =
    let docs = [[1, 100, 200], [2, 200, 100], [3, 50, 50]]
    let query = [100, 200]
    let v_results = hy_vector_search(docs, query, 2)
    let t_vector = 0
    if len(v_results) == 2
        if hy_res_id(v_results[0]) == 1
            t_vector = 1

    let inv_idx = {}
    inv_idx[10] = [[1, 3], [2, 1]]
    inv_idx[20] = [[1, 1], [3, 2]]
    let df_map = {}
    df_map[10] = 2
    df_map[20] = 2
    let k_results = hy_keyword_search(inv_idx, df_map, 3, [10, 20], 2)
    let t_keyword = 0
    if len(k_results) > 0
        if hy_res_id(k_results[0]) == 1
            t_keyword = 1

    let adj = {}
    adj[1] = [[2, 1024], [3, 512]]
    adj[2] = [[3, 1024]]
    let g_results = hy_graph_search(adj, [1], 2, 3)
    let t_graph = 0
    if len(g_results) > 0
        if hy_res_id(g_results[0]) == 1
            t_graph = 1

    let v_top = hy_vector_search(docs, query, 3)
    let k_top = hy_keyword_search(inv_idx, df_map, 3, [10, 20], 3)
    let g_top = hy_graph_search(adj, [1], 2, 3)
    let fused = hy_fuse_rrf(v_top, k_top, g_top)
    let t_rrf = 0
    if len(fused) > 0
        t_rrf = 1

    let fused_w = hy_fuse_weighted(v_top, k_top, g_top, HY_DEFAULT_WEIGHT_V, HY_DEFAULT_WEIGHT_K, HY_DEFAULT_WEIGHT_G)
    let t_weighted = 0
    if len(fused_w) > 0
        t_weighted = 1

    let bragg = hy_bragg_consistency(docs, query, inv_idx, df_map, 3, [10, 20], adj, [1], 2, 3)
    let t_bragg = 0
    if bragg == 1
        t_bragg = 1

    [t_vector, t_keyword, t_graph, t_rrf, t_weighted, t_bragg]

let hy_default_engine() =
    [{}, {}, {}, HY_FUSION_RRF, HY_DEFAULT_WEIGHT_V, HY_DEFAULT_WEIGHT_K, HY_DEFAULT_WEIGHT_G]
