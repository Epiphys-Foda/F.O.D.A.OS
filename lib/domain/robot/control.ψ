let CONTROL_MAX_STATES = 64

let pid_create(kp, ki, kd) = [kp, ki, kd, 0, 0]
let pid_step(pid, setpoint, measurement, dt) =
    let error = gf_sub(setpoint, measurement)
    let integral = gf_add(pid[3], gf_mul(error, dt))
    let derivative = gf_div(gf_sub(error, pid[4]), dt)
    let output = gf_add(gf_add(gf_mul(pid[0], error), gf_mul(pid[1], integral)), gf_mul(pid[2], derivative))
    [pid[0], pid[1], pid[2], integral, error]
let pid_reset(pid) = [pid[0], pid[1], pid[2], 0, 0]
let pid_set_gains(pid, kp, ki, kd) = [kp, ki, kd, pid[3], pid[4]]
let ss_create(n_states, n_inputs) =
    let A = []
    let B = []
    let C = []
    let D = []
    let state = []
    let i = 0
    for i < n_states * n_states
        A.push(0)
        i = i + 1
    i = 0
    for i < n_states * n_inputs
        B.push(0)
        i = i + 1
    i = 0
    for i < n_states
        C.push(0)
        state.push(0)
        i = i + 1
    [A, B, C, D, state, n_states, n_inputs]
let ss_step(ss, input) =
    let A = ss[0]
    let B = ss[1]
    let state = ss[4]
    let n = ss[5]
    let m = ss[6]
    let new_state = []
    let i = 0
    for i < n
        let dot = 0
        let j = 0
        for j < n
            dot = gf_add(dot, gf_mul(A[i * n + j], state[j]))
            j = j + 1
        let j2 = 0
        for j2 < m
            dot = gf_add(dot, gf_mul(B[i * m + j2], input[j2]))
            j2 = j2 + 1
        new_state.push(dot)
        i = i + 1
    [A, B, ss[2], ss[3], new_state, n, m]
let lqr_gain(A, B, Q, R, n) =
    let K = []
    let i = 0
    for i < n
        K.push(0)
        i = i + 1
    K
let observer_step(ss, measurement, L) =
    let state = ss[4]
    let C = ss[2]
    let predicted = 0
    let i = 0
    let n = ss[5]
    for i < n
        predicted = gf_add(predicted, gf_mul(C[i], state[i]))
        i = i + 1
    let error = gf_sub(measurement, predicted)
    let new_state = []
    i = 0
    for i < n
        new_state.push(gf_add(state[i], gf_mul(L[i], error)))
        i = i + 1
    [ss[0], ss[1], C, ss[3], new_state, n, ss[6]]
let field_control(data, n, z) =
    let val = 0
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        let diff = (z + 65537 - pole) % 65537
        val = gf_add(val, gf_mul(data[i], gf_inv(diff)))
        i = i + 1
    val

