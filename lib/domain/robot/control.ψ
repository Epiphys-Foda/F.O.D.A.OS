let CTRL_ERR_POLES = [10, 20, 30, 40, 50, 60, 70, 80]
let CTRL_ERR_WEIGHTS = [80, 70, 60, 50, 40, 30, 20, 10]

let psi_ctrl_err(e_idx) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(e_idx), gf_norm(CTRL_ERR_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(CTRL_ERR_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let CTRL_SIG_POLES = [100, 200, 300, 400, 500, 600, 700, 800]
let CTRL_SIG_WEIGHTS = [10, 20, 30, 40, 50, 60, 70, 80]

let psi_ctrl_sig(u_idx) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(u_idx), gf_norm(CTRL_SIG_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(CTRL_SIG_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let CTRL_STATE_POLES = [1, 2, 3, 4, 5, 6, 7, 8]
let CTRL_STATE_WEIGHTS = [10, 20, 30, 40, 50, 60, 70, 80]

let psi_ctrl_state(x_idx) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(x_idx), gf_norm(CTRL_STATE_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(CTRL_STATE_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let control_global_response(e_idx, u_idx, x_idx) =
    let e1 = psi_ctrl_err(e_idx)
    let e2 = psi_ctrl_sig(u_idx)
    let e3 = psi_ctrl_state(x_idx)
    gf_add(gf_add(gf_mul(e1, e1), gf_mul(e2, e2)), gf_mul(e3, e3))

let ctrl_err_decay_test() =
    let v1 = CTRL_ERR_WEIGHTS[0]
    let v2 = CTRL_ERR_WEIGHTS[7]
    (v1 > v2 ? 1 : 0)

let ctrl_sig_monotonic_test() =
    let v1 = psi_ctrl_sig(100)
    let v2 = psi_ctrl_sig(800)
    (v1 != v2 ? 1 : 0)

let ctrl_state_monotonic_test() =
    let v1 = psi_ctrl_state(1)
    let v2 = psi_ctrl_state(8)
    (v1 != v2 ? 1 : 0)

let ctrl_global_nonzero_test() =
    let g = control_global_response(15, 150, 2)
    (g != 0 ? 1 : 0)

let ctrl_symmetry_test() =
    let v1 = control_global_response(15, 150, 2)
    let v2 = control_global_response(15, 150, 2)
    (v1 == v2 ? 1 : 0)

