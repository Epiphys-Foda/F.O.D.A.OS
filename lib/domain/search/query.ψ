let q_is_space(ch) =
    if ch == 32
        1
    else
        0
    if ch == 9
        1
    else
        0
    if ch == 10
        1
    else
        0

let q_is_alpha_num(ch) =
    if ch >= 48 && ch <= 57
        1
    else
        0
    if ch >= 65 && ch <= 90
        1
    else
        0
    if ch >= 97 && ch <= 122
        1
    else
        0
    if ch == 95
        1
    else
        0

let q_tokenize(chars) =
    let tokens = []
    let i = 0
    let n = len(chars)
    for i < n
        let ch = chars[i]
        if q_is_space(ch) == 1
            i = i + 1
        else
            0
        if ch == 40
            tokens.push([Q_TOK_LPAREN, 0])
            i = i + 1
        else
            0
        if ch == 41
            tokens.push([Q_TOK_RPAREN, 0])
            i = i + 1
        else
            0
        if ch == 34
            i = i + 1
            let phrase_terms = []
            let cur_word = []
            let in_word = 0
            for i < n && chars[i] != 34
                if q_is_space(chars[i]) == 1
                    if in_word == 1
                        phrase_terms.push(cur_word)
                        cur_word = []
                        in_word = 0
                    else
                        0
                    cur_word.push(chars[i])
                    in_word = 1
                i = i + 1
            if in_word == 1
                phrase_terms.push(cur_word)
            if i < n
                i = i + 1
            tokens.push([Q_TOK_PHRASE, phrase_terms])
        else
            let word = []
            for i < n && q_is_alpha_num(chars[i]) == 1
                word.push(chars[i])
                i = i + 1
            if len(word) == 0
                i = i + 1
            else
                let tok_type = Q_TOK_WORD
                if len(word) == 3
                    if word[0] == 65 && word[1] == 78 && word[2] == 68
                        tok_type = Q_TOK_AND
                    else
                        0
                    if word[0] == 78 && word[1] == 79 && word[2] == 84
                        tok_type = Q_TOK_NOT
                    else
                        0
                if len(word) == 2
                    if word[0] == 79 && word[1] == 82
                        tok_type = Q_TOK_OR
                tokens.push([tok_type, word])
    tokens.push([Q_TOK_EOF, 0])
    tokens

let q_word_to_term_int(word) =
    let h = 5381
    let i = 0
    let n = len(word)
    for i < n
        h = (h * 33 + word[i]) % II_P_MOD
        i = i + 1
    h

let q_parser_new(tokens) =
    [tokens, 0]

let q_parser_tokens(p) = p[0]
let q_parser_pos(p) = p[1]
let q_parser_set_pos(p, pos) =
    p[1] = pos
    p

let q_parser_peek(p) =
    let tokens = q_parser_tokens(p)
    let pos = q_parser_pos(p)
    tokens[pos]

let q_parser_advance(p) =
    let pos = q_parser_pos(p)
    q_parser_set_pos(p, pos + 1)
    p

let q_parse_atom(p) =
    let tok = q_parser_peek(p)
    let ttype = tok[0]
    if ttype == Q_TOK_WORD
        let word = tok[1]
        let term_int = q_word_to_term_int(word)
        q_parser_advance(p)
        query_term(term_int)
    else
        0
    if ttype == Q_TOK_PHRASE
        let phrase_words = tok[1]
        let terms = []
        let i = 0
        let n = len(phrase_words)
        for i < n
            terms.push(q_word_to_term_int(phrase_words[i]))
            i = i + 1
        q_parser_advance(p)
        query_phrase(terms, 0)
    else
        0
    if ttype == Q_TOK_LPAREN
        q_parser_advance(p)
        let inner = q_parse_or(p)
        let next_tok = q_parser_peek(p)
        if next_tok[0] == Q_TOK_RPAREN
            q_parser_advance(p)
        inner
    else
        query_term(0)

let q_parse_not(p) =
    let tok = q_parser_peek(p)
    if tok[0] == Q_TOK_NOT
        q_parser_advance(p)
        let sub = q_parse_not(p)
        query_boolean([qclause_mustnot(sub)])
    else
        q_parse_atom(p)

let q_parse_and(p) =
    let left = q_parse_not(p)
    let tok = q_parser_peek(p)
    for tok[0] == Q_TOK_AND
        q_parser_advance(p)
        let right = q_parse_not(p)
        let lt = query_type(left)
        if lt == Q_TYPE_BOOLEAN
            let existing_clauses = query_params(left)
            existing_clauses.push(qclause_must(right))
            left = query_boolean(existing_clauses)
        else
            left = query_boolean([qclause_must(left), qclause_must(right)])
        tok = q_parser_peek(p)
    left

let q_parse_or(p) =
    let left = q_parse_and(p)
    let tok = q_parser_peek(p)
    for tok[0] == Q_TOK_OR
        q_parser_advance(p)
        let right = q_parse_and(p)
        let lt = query_type(left)
        if lt == Q_TYPE_BOOLEAN
            let existing_clauses = query_params(left)
            existing_clauses.push(qclause_should(right))
            left = query_boolean(existing_clauses)
        else
            left = query_boolean([qclause_should(left), qclause_should(right)])
        tok = q_parser_peek(p)
    left

let q_parse(p) =
    q_parse_or(p)

let query_parse(query_chars) =
    let tokens = q_tokenize(query_chars)
    let parser = q_parser_new(tokens)
    let ast = q_parse(parser)
    ast

let Q_SORT_BY_SCORE  = 1
let Q_SORT_BY_FIELD  = 2
let Q_SORT_BY_DOC_ID = 3

let q_sort_results(results, sort_type, field_accessor) =
    let arr = results
    let n = len(arr)
    let i = 0
    for i < n
        let best = i
        let j = i + 1
        for j < n
            let cmp = 0
            if sort_type == Q_SORT_BY_SCORE
                if arr[j][1] > arr[best][1]
                    cmp = 1
                else
                    0
            if sort_type == Q_SORT_BY_FIELD
                if arr[j][1] > arr[best][1]
                    cmp = 1
                else
                    0
            if sort_type == Q_SORT_BY_DOC_ID
                if arr[j][0] < arr[best][0]
                    cmp = 1
            if cmp == 1
                best = j
            j = j + 1
        if best != i
            let tmp = arr[i]
            arr[i] = arr[best]
            arr[best] = tmp
        i = i + 1
    arr

let q_sort_by_score(results) =
    q_sort_results(results, Q_SORT_BY_SCORE, 0)

let q_sort_by_doc_id(results) =
    q_sort_results(results, Q_SORT_BY_DOC_ID, 0)

let query_paginate(results, from_offset, size) =
    let total = len(results)
    if from_offset >= total
        []
    let end = from_offset + size
    if end > total
        end = total
    let page = []
    let i = from_offset
    for i < end
        page.push(results[i])
        i = i + 1
    page

let query_search_full(idx, query_chars, sort_type, from_offset, size) =
    let ast = query_parse(query_chars)
    let raw = query_execute(idx, ast)
    let sorted = q_sort_results(raw, sort_type, 0)
    query_paginate(sorted, from_offset, size)

