let q_verify_wildcard() =
    let idx = index_new()
    idx = index_add_doc(idx, 1, [10, 20, 10, 30])
    idx = index_add_doc(idx, 2, [10, 30, 40])
    idx = index_add_doc(idx, 3, [20, 50])

    let q = query_wildcard(0, [Q_WILDCARD_ANY])
    let results = query_execute(idx, q)
    let ok = 0
    if len(results) > 0
        ok = 1
    ok

let q_verify_parser() =
    let chars = [49, 48]
    let ast = query_parse(chars)
    let qt = query_type(ast)
    let ok = 0
    if qt == Q_TYPE_TERM
        ok = 1
    ok

let q_verify_sort() =
    let results = [[1, 5], [2, 10], [3, 3]]
    let sorted = q_sort_by_score(results)
    let ok = 0
    if sorted[0][1] == 10
        ok = 1
    ok

let q_verify_paginate() =
    let results = [[1, 5], [2, 10], [3, 3], [4, 8], [5, 1]]
    let page = query_paginate(results, 1, 2)
    let ok = 0
    if len(page) == 2
        ok = 1
    ok

let q_verify_all() =
    let r1 = q_verify_term()
    let r2 = q_verify_boolean_and()
    let r3 = q_verify_boolean_or()
    let r4 = q_verify_boolean_not()
    let r5 = q_verify_phrase()
    let r6 = q_verify_range()
    let r7 = q_verify_wildcard()
    let r8 = q_verify_parser()
    let r9 = q_verify_sort()
    let r10 = q_verify_paginate()
    r1 + r2 + r3 + r4 + r5 + r6 + r7 + r8 + r9 + r10
