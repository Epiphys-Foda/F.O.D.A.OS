let Q_TYPE_TERM     = 1
let Q_TYPE_BOOLEAN  = 2
let Q_TYPE_PHRASE   = 3
let Q_TYPE_RANGE    = 4
let Q_TYPE_WILDCARD = 5

let Q_OCCUR_MUST    = 1
let Q_OCCUR_SHOULD  = 2
let Q_OCCUR_MUSTNOT = 3

let Q_FIELD_TYPE   = 0
let Q_FIELD_PARAMS = 1
let Q_FIELD_BOOST  = 2

let Q_DEFAULT_BOOST = 1024

let Q_TOK_WORD   = 1
let Q_TOK_AND    = 2
let Q_TOK_OR     = 3
let Q_TOK_NOT    = 4
let Q_TOK_PHRASE = 5
let Q_TOK_LPAREN = 6
let Q_TOK_RPAREN = 7
let Q_TOK_EOF    = 8

let query_new(qtype, params, boost) =
    [qtype, params, boost]

let query_type(q) = q[Q_FIELD_TYPE]
let query_params(q) = q[Q_FIELD_PARAMS]
let query_boost(q) = q[Q_FIELD_BOOST]

let query_set_boost(q, boost) =
    q[Q_FIELD_BOOST] = boost
    q

let query_term(term) =
    query_new(Q_TYPE_TERM, [term], Q_DEFAULT_BOOST)

let query_term_boost(term, boost) =
    query_new(Q_TYPE_TERM, [term], boost)

let query_boolean(clauses) =
    query_new(Q_TYPE_BOOLEAN, clauses, Q_DEFAULT_BOOST)

let query_boolean_boost(clauses, boost) =
    query_new(Q_TYPE_BOOLEAN, clauses, boost)

let qclause_must(sub_query) =
    [Q_OCCUR_MUST, sub_query]

let qclause_should(sub_query) =
    [Q_OCCUR_SHOULD, sub_query]

let qclause_mustnot(sub_query) =
    [Q_OCCUR_MUSTNOT, sub_query]

let query_phrase(terms, slop) =
    query_new(Q_TYPE_PHRASE, [terms, slop], Q_DEFAULT_BOOST)

let query_phrase_boost(terms, slop, boost) =
    query_new(Q_TYPE_PHRASE, [terms, slop], boost)

let query_range(field, low, high, inclusive) =
    query_new(Q_TYPE_RANGE, [field, low, high, inclusive], Q_DEFAULT_BOOST)

let query_wildcard(field, pattern) =
    query_new(Q_TYPE_WILDCARD, [field, pattern], Q_DEFAULT_BOOST)

let query_execute_term(idx, q) =
    let params = query_params(q)
    let term = params[0]
    let boost = query_boost(q)
    let plist = index_search_term(idx, term)
    if len(plist) == 0
        []
    let result = []
    let i = 0
    let n = len(plist)
    for i < n
        let p = plist[i]
        let doc_id = posting_doc_id(p)
        let score = index_bm25_score(idx, term, doc_id)
        score = score * boost / Q_DEFAULT_BOOST
        result.push([doc_id, score])
        i = i + 1
    result

let q_exec_subquery(idx, q) =
    let qt = query_type(q)
    if qt == Q_TYPE_TERM
        query_execute_term(idx, q)
    else
        0
    if qt == Q_TYPE_BOOLEAN
        query_execute_boolean(idx, q)
    else
        0
    if qt == Q_TYPE_PHRASE
        query_execute_phrase(idx, q)
    else
        0
    if qt == Q_TYPE_RANGE
        query_execute_range(idx, q)
    else
        0
    if qt == Q_TYPE_WILDCARD
        query_execute_wildcard(idx, q)
    else
        []

let q_results_to_doc_ids(results) =
    let ids = []
    let i = 0
    let n = len(results)
    for i < n
        ids.push(results[i][0])
        i = i + 1
    ids

let q_doc_id_to_score(doc_id, results) =
    let i = 0
    let n = len(results)
    let best = 0
    for i < n
        if results[i][0] == doc_id
            if results[i][1] > best
                best = results[i][1]
        i = i + 1
    best

let q_and_merge(results_list) =
    if len(results_list) == 0
        []
    let first = results_list[0]
    let first_ids = q_results_to_doc_ids(first)
    let result = first_ids
    let i = 1
    let n = len(results_list)
    for i < n
        let cur_ids = q_results_to_doc_ids(results_list[i])
        result = ii_and_doc_ids(result, cur_ids)
        i = i + 1
    let scored = []
    let j = 0
    let m = len(result)
    for j < m
        let doc_id = result[j]
        let min_score = 0
        let first_score = 0
        let k = 0
        let kn = len(results_list)
        for k < kn
            let s = q_doc_id_to_score(doc_id, results_list[k])
            if k == 0
                min_score = s
            else
                if s < min_score
                    min_score = s
            k = k + 1
        scored.push([doc_id, min_score])
        j = j + 1
    scored

let q_or_merge(results_list) =
    let seen = {}
    let scored = []
    let i = 0
    let n = len(results_list)
    for i < n
        let sub = results_list[i]
        let j = 0
        let m = len(sub)
        for j < m
            let doc_id = sub[j][0]
            let score = sub[j][1]
            if seen[doc_id] == 0
                seen[doc_id] = 1
                scored.push([doc_id, score])
            else
                let k = 0
                let kn = len(scored)
                for k < kn
                    if scored[k][0] == doc_id
                        scored[k][1] = scored[k][1] + score
                        k = kn
                    k = k + 1
            j = j + 1
        i = i + 1
    scored

let q_not_filter(base_results, exclude_results) =
    let exclude_ids = q_results_to_doc_ids(exclude_results)
    let result = []
    let i = 0
    let n = len(base_results)
    for i < n
        let doc_id = base_results[i][0]
        let excluded = 0
        let j = 0
        let m = len(exclude_ids)
        for j < m
            if exclude_ids[j] == doc_id
                excluded = 1
                j = m
            j = j + 1
        if excluded == 0
            result.push(base_results[i])
        i = i + 1
    result

let query_execute_boolean(idx, q) =
    let clauses = query_params(q)
    let boost = query_boost(q)

    let must_results = []
    let should_results = []
    let mustnot_results = []

    let i = 0
    let n = len(clauses)
    for i < n
        let clause = clauses[i]
        let occur = clause[0]
        let sub_q = clause[1]
        let sub_results = q_exec_subquery(idx, sub_q)
        if occur == Q_OCCUR_MUST
            must_results.push(sub_results)
        else
            0
        if occur == Q_OCCUR_SHOULD
            should_results.push(sub_results)
        else
            0
        if occur == Q_OCCUR_MUSTNOT
            mustnot_results.push(sub_results)
        i = i + 1

    let base = []
    if len(must_results) > 0
        base = q_and_merge(must_results)
    else
        base = q_or_merge(should_results)
        should_results = []

    if len(must_results) > 0 && len(should_results) > 0
        let should_merged = q_or_merge(should_results)
        let i2 = 0
        let n2 = len(should_merged)
        for i2 < n2
            let doc_id = should_merged[i2][0]
            let sc = should_merged[i2][1]
            let j2 = 0
            let m2 = len(base)
            for j2 < m2
                if base[j2][0] == doc_id
                    base[j2][1] = base[j2][1] + sc
                    j2 = m2
                j2 = j2 + 1
            i2 = i2 + 1

    let k = 0
    let kn = len(mustnot_results)
    for k < kn
        base = q_not_filter(base, mustnot_results[k])
        k = k + 1

    let final = []
    let fi = 0
    let fn_ = len(base)
    for fi < fn_
        let doc_id = base[fi][0]
        let sc = base[fi][1]
        sc = sc * boost / Q_DEFAULT_BOOST
        final.push([doc_id, sc])
        fi = fi + 1
    final

let query_execute_phrase(idx, q) =
    let params = query_params(q)
    let terms = params[0]
    let slop = params[1]
    let boost = query_boost(q)

    if len(terms) == 0
        []
    let first_term = terms[0]
    let plist = index_search_term(idx, first_term)
    let candidates = ii_plist_to_doc_ids(plist)

    let result = []
    let i = 0
    let n = len(candidates)
    for i < n
        let doc_id = candidates[i]
        let matched = index_phrase_match(idx, terms, doc_id, slop)
        if matched == 1
            let score = 0
            let ti = 0
            let tn = len(terms)
            for ti < tn
                score = score + index_bm25_score(idx, terms[ti], doc_id)
                ti = ti + 1
            score = score * boost / Q_DEFAULT_BOOST
            result.push([doc_id, score])
        i = i + 1
    result

let query_execute_range(idx, q) =
    let params = query_params(q)
    let field = params[0]
    let low = params[1]
    let high = params[2]
    let inclusive = params[3]
    let boost = query_boost(q)

    let doc_freqs = index_doc_freqs(idx)
    let all_terms = doc_freqs.keys()
    let matched_terms = []
    let i = 0
    let n = len(all_terms)
    for i < n
        let t = all_terms[i]
        let ok = 0
        if inclusive == 1
            if t >= low && t <= high
                ok = 1
            else
                0
            if t > low && t < high
                ok = 1
        if ok == 1
            matched_terms.push(t)
        i = i + 1

    let result_map = {}
    let j = 0
    let m = len(matched_terms)
    for j < m
        let term = matched_terms[j]
        let plist = index_search_term(idx, term)
        let k = 0
        let p = len(plist)
        for k < p
            let posting = plist[k]
            let doc_id = posting_doc_id(posting)
            let score = index_bm25_score(idx, term, doc_id)
            if result_map[doc_id] == 0
                result_map[doc_id] = score
            else
                result_map[doc_id] = result_map[doc_id] + score
            k = k + 1
        j = j + 1

    let keys = result_map.keys()
    let result = []
    let ri = 0
    let rn = len(keys)
    for ri < rn
        let doc_id = keys[ri]
        let sc = result_map[doc_id]
        sc = sc * boost / Q_DEFAULT_BOOST
        result.push([doc_id, sc])
        ri = ri + 1
    result

let Q_WILDCARD_ANY = -2
let Q_WILDCARD_ONE = -1

let q_wildcard_match_impl(term_arr, ti, tn, pat, pi, pn) =
    if pi == pn
        if ti == tn
            1
        else
            0
    if ti == tn
        if pat[pi] == Q_WILDCARD_ANY
            q_wildcard_match_impl(term_arr, ti, tn, pat, pi + 1, pn)
        else
            0
    let pc = pat[pi]
    if pc == Q_WILDCARD_ANY
        let r1 = q_wildcard_match_impl(term_arr, ti, tn, pat, pi + 1, pn)
        if r1 == 1
            1
        let r2 = q_wildcard_match_impl(term_arr, ti + 1, tn, pat, pi, pn)
        if r2 == 1
            1
        0
    if pc == Q_WILDCARD_ONE
        q_wildcard_match_impl(term_arr, ti + 1, tn, pat, pi + 1, pn)
    else
        if ti < tn && term_arr[ti] == pc
            q_wildcard_match_impl(term_arr, ti + 1, tn, pat, pi + 1, pn)
        else
            0

let q_wildcard_match(term_arr, pattern) =
    let tn = len(term_arr)
    let pn = len(pattern)
    q_wildcard_match_impl(term_arr, 0, tn, pattern, 0, pn)

let query_execute_wildcard(idx, q) =
    let params = query_params(q)
    let field = params[0]
    let pattern = params[1]
    let boost = query_boost(q)

    let doc_freqs = index_doc_freqs(idx)
