let DL_P = 65537

let DL_REASON_TIMEOUT       = 1
let DL_REASON_PROCESSING_ERR = 2
let DL_REASON_INVALID_MSG    = 3
let DL_REASON_QUOTA_EXCEEDED = 4
let DL_REASON_DEPENDENCY_FAIL = 5

let DL_OVERFLOW_DROP    = 1
let DL_OVERFLOW_NOTIFY  = 2
let DL_OVERFLOW_BLOCK   = 3
let DL_OVERFLOW_ARCHIVE = 4

let DL_MAX_RETRIES      = 5
let DL_BACKOFF_BASE_MS  = 1000
let DL_BACKOFF_MAX_MS   = 60000
let DL_MAX_DLQ_SIZE     = 1024

let dl_new(msg_id, original_msg, reason, fail_ts) =
    [msg_id, original_msg, reason, 1, fail_ts, fail_ts, [fail_ts]]

let dl_id(d)           = d[0]
let dl_orig(d)         = d[1]
let dl_reason(d)       = d[2]
let dl_attempts(d)     = d[3]
let dl_first(d)        = d[4]
let dl_last(d)         = d[5]
let dl_history(d)      = d[6]

let dl_record_failure(d, fail_ts) =
    let atts = dl_attempts(d) + 1
    let hist = dl_history(d)
    hist.push(fail_ts)
    [dl_id(d), dl_orig(d), dl_reason(d), atts, dl_first(d), fail_ts, hist]

let dl_policy_new(max_retries, base_ms, max_ms, overflow) =
    [max_retries, base_ms, max_ms, overflow]

let dl_policy_max(p)      = p[0]
let dl_policy_base(p)     = p[1]
let dl_policy_cap(p)      = p[2]
let dl_policy_overflow(p) = p[3]

let dl_policy_backoff(p, attempts) =
    let base = dl_policy_base(p)
    let cap = dl_policy_cap(p)
    let backoff = base
    let i = 0
    for i < attempts
        backoff = backoff * 2
        if backoff > cap
            backoff = cap
            i = attempts
        i = i + 1
    backoff

let dl_policy_can_retry(p, attempts) =
    if attempts < dl_policy_max(p)
        1
    else
        0

let dl_queue_new(policy, max_size) =
    [[], policy, 1, max_size]

let dl_queue_letters(q)  = q[0]
let dl_queue_policy(q)   = q[1]
let dl_queue_head(q)    = q[2]
let dl_queue_max(q)     = q[3]

let dl_queue_enqueue(q, original_msg, reason, fail_ts) =
    let letters = dl_queue_letters(q)
    let mid = dl_queue_head(q)
    let d = dl_new(mid, original_msg, reason, fail_ts)
    letters.push(d)
    let max_sz = dl_queue_max(q)
    let policy = dl_queue_policy(q)
    let overflow = dl_policy_overflow(policy)
    for len(letters) > max_sz
        if overflow == DL_OVERFLOW_DROP
            letters = arr_drop(letters, 1)
        else
            if overflow == DL_OVERFLOW_BLOCK
                let dummy = 0
                letters = letters
                let k = 0
                if k == 0
                    letters = arr_drop(letters, 1)
                else
                    0
                letters = arr_drop(letters, 1)
    [letters, policy, mid + 1, max_sz]

let dl_queue_retry_next(q, current_ts) =
    let letters = dl_queue_letters(q)
    if len(letters) == 0
        [0, 0, q]
    else
        let policy = dl_queue_policy(q)
        let d = letters[0]
        if dl_policy_can_retry(policy, dl_attempts(d)) == 0
            let rest = arr_drop(letters, 1)
            [d, 0, [rest, policy, dl_queue_head(q), dl_queue_max(q)]]
        else
            let backoff = dl_policy_backoff(policy, dl_attempts(d))
            let next_ts = current_ts + backoff
            let d_new = dl_record_failure(d, current_ts)
            let rest = arr_drop(letters, 1)
            rest.push(d_new)
            [d_new, next_ts, [rest, policy, dl_queue_head(q), dl_queue_max(q)]]

let dl_queue_count_by_reason(q) =
    let letters = dl_queue_letters(q)
    let counts = {}
    let i = 0
    let n = len(letters)
    for i < n
        let r = dl_reason(letters[i])
        let c = counts[r]
        if c == 0
            c = 0
        counts[r] = c + 1
        i = i + 1
    counts

let dl_handle_overflow(q, letter) =
    let policy = dl_queue_policy(q)
    let strategy = dl_policy_overflow(policy)
    let notify_action = 0
    if strategy == DL_OVERFLOW_DROP
        notify_action = 0
    else
        if strategy == DL_OVERFLOW_NOTIFY
            notify_action = 1
        else
            if strategy == DL_OVERFLOW_BLOCK
                notify_action = 2
            else
                if strategy == DL_OVERFLOW_ARCHIVE
                    notify_action = 3
    [strategy, notify_action, dl_id(letter)]

let dl_self_test() =
    let d = dl_new(1, 100, DL_REASON_TIMEOUT, 1000)
    let d2 = dl_record_failure(d, 2000)
    let t_record = 0
    if dl_attempts(d2) == 2
        if dl_last(d2) == 2000
            t_record = 1

    let p = dl_policy_new(DL_MAX_RETRIES, DL_BACKOFF_BASE_MS, DL_BACKOFF_MAX_MS, DL_OVERFLOW_NOTIFY)
    let b0 = dl_policy_backoff(p, 0)
    let b1 = dl_policy_backoff(p, 1)
    let b2 = dl_policy_backoff(p, 2)
    let t_backoff = 0
    if b0 == 1000
        if b1 == 2000
            if b2 == 4000
                t_backoff = 1

    let b10 = dl_policy_backoff(p, 10)
    let t_cap = 0
    if b10 == DL_BACKOFF_MAX_MS
        t_cap = 1

    let cr_5 = dl_policy_can_retry(p, 5)
    let cr_6 = dl_policy_can_retry(p, 6)
    let t_can = 0
    if cr_5 == 0
        if cr_6 == 0
            t_can = 1

    let q = dl_queue_new(p, 64)
    q = dl_queue_enqueue(q, 100, DL_REASON_TIMEOUT, 1000)
    q = dl_queue_enqueue(q, 200, DL_REASON_PROCESSING_ERR, 2000)
    let t_enqueue = 0
    if len(dl_queue_letters(q)) == 2
        t_enqueue = 1

    let retry_res = dl_queue_retry_next(q, 3000)
    let d_retry = retry_res[0]
    let next_ts = retry_res[1]
    let q_after = retry_res[2]
    let t_retry = 0
    if d_retry != 0
        if next_ts == 3000 + 1000
            t_retry = 1

    let i = 0
    let q2 = q
    let last_d = 0
    for i < 10
        let res = dl_queue_retry_next(q2, 1000 + i * 1000)
        last_d = res[0]
        q2 = res[2]
        if last_d == 0
            i = 10
        i = i + 1
    let t_exhaust = 0
    if i > 0
        t_exhaust = 1

    let counts = dl_queue_count_by_reason(q)
    let t_count = 0
    let c_timeout = counts[DL_REASON_TIMEOUT]
    if c_timeout == 1
        t_count = 1

    let h = dl_handle_overflow(q, dl_queue_letters(q)[0])
    let t_handle = 0
    if h[0] == DL_OVERFLOW_NOTIFY
        if h[1] == 1
            t_handle = 1

    [t_record, t_backoff, t_cap, t_can, t_enqueue, t_retry, t_exhaust, t_count, t_handle]

let dl_default_queue() =
    let p = dl_policy_new(DL_MAX_RETRIES, DL_BACKOFF_BASE_MS, DL_BACKOFF_MAX_MS, DL_OVERFLOW_NOTIFY)
    dl_queue_new(p, DL_MAX_DLQ_SIZE)
