    if cr_gs_contains(s_merged, 100) == 1
        if cr_gs_contains(s_merged, 200) == 1
            if cr_gs_contains(s_merged, 300) == 1
                if cr_gs_size(s_merged) == 3
                    t_gs = 1

    let o1 = cr_orset_new()
    o1 = cr_or_add(o1, 1, 100)
    let has_before = cr_or_contains(o1, 1)
    o1 = cr_or_remove(o1, 1)
    let has_after = cr_or_contains(o1, 1)
    let t_or = 0
    if has_before == 1
        if has_after == 0
            t_or = 1

    let o2 = cr_orset_new()
    o2 = cr_or_add(o2, 1, 200)
    let o_merged = cr_or_merge(o1, o2)
    let has_merged = cr_or_contains(o_merged, 1)
    let t_or_merge = 0
    if has_merged == 1
        t_or_merge = 1

    let m1 = cr_lww_new()
    m1 = cr_lww_put(m1, 1, 100, 1000, 1)
    m1 = cr_lww_put(m1, 1, 200, 2000, 1)
    let t_lww = 0
