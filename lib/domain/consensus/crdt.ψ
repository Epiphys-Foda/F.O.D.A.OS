    let m2 = cr_lww_new()
    m2 = cr_lww_put(m2, 1, 300, 1500, 2)
    let m_merged = cr_lww_merge(m1, m2)
    let t_lww_merge = 0
    if cr_lww_get(m_merged, 1) == 200
