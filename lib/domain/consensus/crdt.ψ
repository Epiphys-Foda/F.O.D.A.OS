    let m3 = cr_lww_new()
    m3 = cr_lww_put(m3, 1, 500, 2000, 5)
    let m4 = cr_lww_new()
    m4 = cr_lww_put(m4, 1, 600, 2000, 3)
    let m34 = cr_lww_merge(m3, m4)
    let t_lww_node = 0
    if cr_lww_get(m34, 1) == 500
        t_lww_node = 1

    [t_gc, t_pn, t_gs, t_or, t_or_merge, t_lww, t_lww_merge, t_lww_node]

