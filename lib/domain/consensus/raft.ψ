import "../domain_field.ψ"

let RF_P = 65537
let RF_GF_M1 = 65536

let RF_ROLE_FOLLOWER  = 1
let RF_ROLE_CANDIDATE = 2
let RF_ROLE_LEADER    = 3

let RF_STATE_UP     = 1
let RF_STATE_DOWN   = 2

let RF_VOTE_GRANT   = 1
let RF_VOTE_DENY    = 0

let RF_TIMEOUT     = 8192
let RF_HEARTBEAT   = 1024

let RF_POLE_OFFSET  = 127
let RF_POLE_SCALE   = 100
let RF_FRACTAL_N0   = 0
let RF_FRACTAL_N1   = 1
let RF_FRACTAL_N2   = 2
let RF_FRACTAL_N3   = 3
let RF_FRACTAL_N_INF = 65535

let rf_entry_new(term, index, command, client_id) =
    [term, index, command, client_id]

let rf_entry_term(e)    = e[0]
let rf_entry_idx(e)      = e[1]
let rf_entry_cmd(e)      = e[2]
let rf_entry_client(e)   = e[3]

let rf_node_new(node_id) =
    [node_id, RF_ROLE_FOLLOWER, 0, 0, [], 0, 0, {}, {}, {}]

let rf_n_id(n)          = n[0]
let rf_n_role(n)        = n[1]
let rf_n_term(n)        = n[2]
let rf_n_voted(n)       = n[3]
let rf_n_log(n)         = n[4]
let rf_n_commit(n)      = n[5]
let rf_n_applied(n)     = n[6]
let rf_n_state(n)       = n[7]
let rf_n_next(n)        = n[8]
let rf_n_match(n)       = n[9]

let rf_n_set_role(n, r) =
    n[1] = r
    n

let rf_n_set_term(n, t) =
    n[2] = t
    n

let rf_n_set_voted(n, v) =
    n[3] = v
    n

let rf_start_election(node) =
    let new_term = rf_n_term(node) + 1
    node = rf_n_set_term(node, new_term)
    node = rf_n_set_role(node, RF_ROLE_CANDIDATE)
    node = rf_n_set_voted(node, rf_n_id(node))
    [node, new_term, 1]

let rf_handle_vote_request(node, candidate_id, candidate_term, candidate_last_idx, candidate_last_term) =
    let cur_term = rf_n_term(node)
    if candidate_term < cur_term
        [node, RF_VOTE_DENY]
    else
        if candidate_term > cur_term
            node = rf_n_set_term(node, candidate_term)
            node = rf_n_set_voted(node, 0)
            node = rf_n_set_role(node, RF_ROLE_FOLLOWER)
        let log = rf_n_log(node)
        let my_last_idx = len(log)
        let my_last_term = 0
        if my_last_idx > 0
            my_last_term = rf_entry_term(log[my_last_idx - 1])
        let log_ok = 0
        if candidate_last_term > my_last_term
            log_ok = 1
        else
            if candidate_last_term == my_last_term
                if candidate_last_idx >= my_last_idx
                    log_ok = 1
        let voted = rf_n_voted(node)
        if voted == 0
            if log_ok == 1
                node = rf_n_set_voted(node, candidate_id)
                [node, RF_VOTE_GRANT]
            else
                [node, RF_VOTE_DENY]
        else
            if voted == candidate_id
                [node, RF_VOTE_GRANT]
            else
                [node, RF_VOTE_DENY]

let rf_check_election_win(votes_received, cluster_size) =
    let quorum = cluster_size / 2 + 1
    if votes_received >= quorum
        1
    else
        0

let rf_leader_append(node, command, client_id) =
    if rf_n_role(node) != RF_ROLE_LEADER
        [node, 0]
    else
        let log = rf_n_log(node)
        let new_idx = len(log) + 1
        let term = rf_n_term(node)
        let e = rf_entry_new(term, new_idx, command, client_id)
        log.push(e)
        node[4] = log
        [node, new_idx]

let rf_follower_append(node, leader_term, prev_idx, prev_term, entries) =
    let cur_term = rf_n_term(node)
    if leader_term < cur_term
        [node, 0, 0]
    else
        if leader_term > cur_term
            node = rf_n_set_term(node, leader_term)
            node = rf_n_set_voted(node, 0)
        node = rf_n_set_role(node, RF_ROLE_FOLLOWER)
        let log = rf_n_log(node)
        let log_ok = 0
        if prev_idx == 0
            log_ok = 1
        else
            if prev_idx <= len(log)
                if rf_entry_term(log[prev_idx - 1]) == prev_term
                    log_ok = 1
        if log_ok == 0
            [node, 0, 0]
        else
            let i = 0
            let n = len(entries)
            for i < n
                log.push(entries[i])
                i = i + 1
            node[4] = log
            let new_match = len(log)
            [node, 1, new_match]

let rf_leader_advance_commit(node, cluster_size) =
    let quorum = cluster_size / 2 + 1
    let match_map = rf_n_match(node)
    let n = len(match_map)
    let log = rf_n_log(node)
    let log_len = len(log)
    let new_commit = rf_n_commit(node)
    let i = log_len
    for i > new_commit
        let count = 1
        let keys = keys_of(match_map)
        let nk = len(keys)
        let j = 0
        for j < nk
            if match_map[keys[j]] >= i
                count = count + 1
            j = j + 1
        if count >= quorum
            if rf_entry_term(log[i - 1]) == rf_n_term(node)
                new_commit = i
                i = 0
            else
                i = i - 1
        else
            i = i - 1
    node[5] = new_commit
    node

let rf_apply_entries(node) =
    let log = rf_n_log(node)
    let commit = rf_n_commit(node)
    let applied = rf_n_applied(node)
    let state = rf_n_state(node)
    for applied < commit
        applied = applied + 1
        let e = log[applied - 1]
        let cmd = rf_entry_cmd(e)
        let key = cmd / 65536
        let val = cmd % 65536
        state[key] = val
    node[6] = applied
    node[7] = state
    node

let rf_bragg_replay(node) =
    let log = rf_n_log(node)
    let state = {}
    let i = 0
    let n = len(log)
    for i < n
        let e = log[i]
        let cmd = rf_entry_cmd(e)
        let key = cmd / 65536
        let val = cmd % 65536
        state[key] = val
        i = i + 1
    let cur_state = rf_n_state(node)
    let keys = keys_of(cur_state)
    let nk = len(keys)
    let pass = 1
    i = 0
    for i < nk
        let k = keys[i]
        if state[k] != cur_state[k]
            pass = 0
        i = i + 1
    pass

let rf_self_test() =
    let n = rf_node_new(1)
    let t_init = 0
    if rf_n_role(n) == RF_ROLE_FOLLOWER
        if rf_n_term(n) == 0
            t_init = 1

    let elect_res = rf_start_election(n)
    n = elect_res[0]
    let new_term = elect_res[1]
    let votes = elect_res[2]
    let t_elect = 0
    if rf_n_role(n) == RF_ROLE_CANDIDATE
        if new_term == 1
            if votes == 1
                t_elect = 1

    let follower = rf_node_new(2)
    let vote_res = rf_handle_vote_request(follower, 1, 1, 0, 0)
    follower = vote_res[0]
    let granted = vote_res[1]
    let t_vote = 0
    if granted == RF_VOTE_GRANT
        if rf_n_voted(follower) == 1
            t_vote = 1

    let win = rf_check_election_win(2, 3)
    let t_win = 0
    if win == 1
        t_win = 1

    n = rf_n_set_role(n, RF_ROLE_LEADER)
    let append_res = rf_leader_append(n, 65536 + 100, 10)
    n = append_res[0]
    let idx = append_res[1]
    let t_append = 0
    if idx == 1
        t_append = 1

    let f2 = rf_node_new(3)
    let entries = rf_n_log(n)
    let app_res = rf_follower_append(f2, rf_n_term(n), 0, 0, entries)
    f2 = app_res[0]
    let success = app_res[1]
    let m_ok = app_res[2]
    let t_replicate = 0
    if success == 1
        if m_ok == 1
            t_replicate = 1

    let bragg = rf_bragg_replay(n)
    let t_bragg = 0
    if bragg == 1
        t_bragg = 1

    n[5] = 1
    n = rf_apply_entries(n)
    let state = rf_n_state(n)
    let t_apply = 0
    if state[1] == 100
        if rf_n_applied(n) == 1
            t_apply = 1

    [t_init, t_elect, t_vote, t_win, t_append, t_replicate, t_bragg, t_apply]

let rf_default_node(node_id) =
    rf_node_new(node_id)

let rf_gf_mod(x) = domain_gf_mod(x)
let rf_gf_mul(a, b) = domain_gf_mul(a, b)
let rf_gf_add(a, b) = domain_gf_add(a, b)
let rf_gf_inv(a) = domain_gf_inv(a)

let rf_field_encode(log, n) =
    let records = []
    let i = 0
    for i < n
        let entry = log[i]
        records.push([rf_entry_term(entry), rf_entry_idx(entry)])
        i = i + 1
    let enc = domain_field_encode(records, n, RF_POLE_SCALE, RF_POLE_OFFSET)
    let depths = enc[2]
    let j = 0
    for j < n
        let depth = RF_FRACTAL_N0
        if j > 0
            depth = RF_FRACTAL_N1
        if j > 1
            depth = RF_FRACTAL_N2
        depths[j] = depth
        j = j + 1
    enc

let rf_field_eval(poles, residues, z) = domain_field_eval(poles, residues, z)

let rf_field_eval_depth(poles, residues, depths, z) = domain_field_eval_fractal(poles, residues, depths, z)

let rf_bragg_field_verify(node, z) =
    let log = rf_n_log(node)
    let n = len(log)
    if n == 0
        1
    else
        let enc = rf_field_encode(log, n)
        let poles = enc[0]
        let residues = enc[1]
        domain_bragg_verify(poles, residues, poles, residues)
