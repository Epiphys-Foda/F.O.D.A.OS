let sx_reduce(stream, data, init, op) =
    let i = 0
    let n = len(data)
    let result = init
    for i < n
        if op == 0
            result = result + data[i]
        else
            0
        if op == 1
            result = result * data[i]
        else
            0
        if op == 2
            if data[i] < result
                result = data[i]
            else
                0
        if op == 3
            if data[i] > result
                result = data[i]
        i = i + 1
    result

let sx_scan(stream, data, init, op) =
    let result = [init]
    let i = 0
    let n = len(data)
    let acc = init
    for i < n
        if op == 0
            acc = acc + data[i]
        else
            0
        if op == 1
            acc = acc * data[i]
        result.push(acc)
        i = i + 1
    result

let sx_transform(stream, data, op, scalar) =
    let result = []
    let i = 0
    let n = len(data)
    for i < n
        let v = data[i]
        if op == 0
            v = v + scalar
        else
            0
        if op == 1
            v = v * scalar
        else
            0
        if op == 2
            v = 0 - v
        result.push(v)
        i = i + 1
    result

let sx_sort(stream, data, ascending) =
    let arr = data
    let n = len(arr)
    let i = 0
    for i < n - 1
        let j = 0
        for j < n - 1 - i
            let swap = 0
            if ascending == 1
                if arr[j] > arr[j + 1]
                    swap = 1
                else
                    0
                if arr[j] < arr[j + 1]
                    swap = 1
            if swap == 1
                let tmp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = tmp
            j = j + 1
        i = i + 1
    arr

let sx_gather(stream, src, indices) =
    let result = []
    let i = 0
    let n = len(indices)
    for i < n
        result.push(src[indices[i]])
        i = i + 1
    result

let sx_scatter(stream, dst, indices, values) =
    let result = dst
    let i = 0
    let n = len(indices)
    for i < n
        if indices[i] < len(result)
            result[indices[i]] = values[i]
        i = i + 1
    result

