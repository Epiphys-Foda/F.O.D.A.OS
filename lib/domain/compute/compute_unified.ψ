let device_new(id, name, kind, sm_count, mem_total) =
    [id, name, kind, sm_count, mem_total, mem_total, 0]

let dev_id(d) = d[0]
let dev_name_str(d) = d[1]
let dev_dtype(d) = d[2]
let dev_sms(d) = d[3]
let dev_mem_total(d) = d[4]
let dev_mem_free(d) = d[5]
let dev_cap(d) = d[6]

let dev_alloc_mem(d, size) =
    if dev_mem_free(d) >= size
        d[5] = dev_mem_free(d) - size
        1
    else
        0

let dev_free_mem(d, size) =
    d[5] = dev_mem_free(d) + size
    if d[5] > dev_mem_total(d)
        d[5] = dev_mem_total(d)
    d

let dev_set_cap(d, cap) =
    d[6] = cap
    d

let dev_supports_fp64(d) =
    if dev_cap(d) - (dev_cap(d) / 2) * 2 == 1
        1
    else
        0

let context_new(device_id) =
    [device_id, {}, [], 1, 1]

let ctx_dev_id(c) = c[0]
let ctx_mem_pool(c) = c[1]
let ctx_streams(c) = c[2]
let ctx_active(c) = c[3]
let ctx_refcount(c) = c[4]

let ctx_retain(c) =
    c[4] = ctx_refcount(c) + 1
    c

let ctx_release(c) =
    if ctx_refcount(c) > 0
        c[4] = ctx_refcount(c) - 1
    if ctx_refcount(c) == 0
        c[3] = 0
    c

let ctx_alloc_buffer(c, size) =
    let pool = ctx_mem_pool(c)
    let buf_id = len(pool) + 1
    pool[buf_id] = [size, 0]
    c[1] = pool
    buf_id

let ctx_free_buffer(c, buf_id) =
    let pool = ctx_mem_pool(c)
    let buf = pool[buf_id]
    if buf != 0
        pool[buf_id] = 0
        c[1] = pool
        1
    else
        0

let stream_new(id, priority) =
    [id, [], priority, 0, 0]

let stream_id(s) = s[0]
let stream_queue(s) = s[1]
let stream_priority(s) = s[2]
let stream_last_event(s) = s[4]

let stream_enqueue_kernel(s, name, grid, block, args) =
    let q = stream_queue(s)
    let cmd = [0, name, grid, block, args, 0]
    q.push(cmd)
    s[1] = q
    s

let stream_enqueue_memcpy(s, dst, src, size, dir) =
    let q = stream_queue(s)
    let cmd = [1, dst, src, size, dir, 0]
    q.push(cmd)
    s[1] = q
    s

let stream_enqueue_event(s, event_id) =
    let q = stream_queue(s)
    let cmd = [2, event_id, 0, 0, 0, 0]
    q.push(cmd)
    s[1] = q
    s[4] = event_id
    s

let stream_synchronize(s) =
    let q = stream_queue(s)
    let n = len(q)
    let i = 0
    let results = []
    for i < n
        let cmd = q[i]
        cmd[5] = 1
        results.push(cmd)
        i = i + 1
    s[1] = []
    results

let stream_query(s) =
    if len(stream_queue(s)) == 0
        1
    else
        0

let event_new(id) =
    [id, 0, 0, 0, 0]

let event_id(e) = e[0]
let event_recorded(e) = e[1]
let event_stream(e) = e[2]
let event_ts(e) = e[3]
let event_value(e) = e[4]

let event_record(e, stream_id, ts) =
    e[1] = 1
    e[2] = stream_id
    e[3] = ts
    e

let event_reset(e) =
    e[1] = 0
    e

let event_query(e) =
    event_recorded(e)

let event_synchronize(e) =
    let max_poll = 1024
    let n = 0
    for n < max_poll
        if event_recorded(e) == 1
            n = max_poll
        n = n + 1
    event_recorded(e)

