    [{}, {}, {}, 0, 0]

let m_count(m) = m[0]
let m_latency(m) = m[1]
let m_errors(m) = m[2]
let m_bragg_pass(m) = m[3]
let m_bragg_fail(m) = m[4]

let metrics_record_op(m, op_name, latency) =
    let counts = m_count(m)
    let c = counts[op_name]
    if c == 0
        c = 0
    counts[op_name] = c + 1
    let lats = m_latency(m)
    let l = lats[op_name]
    if l == 0
        l = 0
    lats[op_name] = l + latency
    m[0] = counts
    m[1] = lats
    m

let metrics_record_error(m, op_name) =
    let errs = m_errors(m)
    let e = errs[op_name]
    if e == 0
        e = 0
    errs[op_name] = e + 1
    m[2] = errs
    m

let metrics_record_bragg(m, pass) =
    if pass == 1
        m[3] = m[3] + 1
    else
        m[4] = m[4] + 1
    m

let metrics_avg_latency(m, op_name) =
    let counts = m_count(m)
    let lats = m_latency(m)
    let c = counts[op_name]
    let l = lats[op_name]
    if c == 0
        0
    else
        l / c

