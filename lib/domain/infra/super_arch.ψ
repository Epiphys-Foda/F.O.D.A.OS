let sa_field_consistency_verify(components, replay_components) =
    let sample_points = [256, 512, 1024, 2048]
    let all_ok = 1
    let i = 0
    for i < 4
        let z = sample_points[i]
        let d1 = sa_field_eval_all(components, z)
        let r1 = sa_field_eval_all(replay_components, z)
        if d1 != r1
            all_ok = 0
        i = i + 1
    all_ok

let sa_field_eval_all(components, z) =
    let total = 0
    let i = 0
    let n = len(components)
    for i < n
        let comp = components[i]
        let poles = comp[0]
        let residues = comp[1]
        let depths = comp[2]
        let j = 0
        let m = len(poles)
        for j < m
            let zk = poles[j]
            let rk = residues[j]
            let nk = depths[j]
            let dz = z - zk
            if dz == 0
                dz = 1
            if nk == 0
                total = total + rk
            else
                0
            if nk == 1
                total = total + rk / dz
            else
                let denom = 1
                let k = 0
                for k < nk
                    denom = denom * dz
                    k = k + 1
                if denom == 0
                    denom = 1
                total = total + rk / denom
            j = j + 1
        i = i + 1
    total

