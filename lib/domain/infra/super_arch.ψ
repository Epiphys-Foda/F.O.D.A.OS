    let db = sa_db(sa)
    let tables = engine_records(db)
    let all_docs = []
    let table_names = keys_of(tables)
    let i = 0
    let n = len(table_names)
    for i < n
        let tbl = tables[table_names[i]]
        if tbl != 0
            let doc_ids = keys_of(tbl)
            let j = 0
            let m = len(doc_ids)
            for j < m
                all_docs.push(tbl[doc_ids[j]])
                j = j + 1
        i = i + 1
    metrics_record_op(sa_metrics(sa), "vector_search", 1)
    vector_search(all_docs, query_vec, k)

