import "../domain_field.ψ"

let wf_task_new(id, name, action_fn) =
    [id, name, action_fn, [], 0, 0, 3, 0, 0]

let task_id(t) = t[0]
let task_name(t) = t[1]
let task_action(t) = t[2]
let task_deps(t) = t[3]
let task_cond(t) = t[4]
let task_retries(t) = t[5]
let task_max_retries(t) = t[6]
let task_status(t) = t[7]
let task_result(t) = t[8]

let task_set_deps(t, deps) =
    t[3] = deps
    t

let task_set_cond(t, cond) =
    t[4] = cond
    t

let task_set_status(t, status) =
    t[7] = status
    t

let task_set_result(t, result) =
    t[8] = result
    t

let task_inc_retries(t) =
    t[5] = t[5] + 1
    t

let workflow_new(name) =
    [name, {}, [], 0, 0, 0]

let wf_name(wf) = wf[0]
let wf_tasks(wf) = wf[1]
let wf_edges(wf) = wf[2]
let wf_status(wf) = wf[3]
let wf_completed(wf) = wf[4]
let wf_failed(wf) = wf[5]

let wf_add_task(wf, task) =
    let tasks = wf_tasks(wf)
    tasks[task_id(task)] = task
    wf[1] = tasks
    wf

let wf_add_edge(wf, from_id, to_id) =
    let edges = wf_edges(wf)
    edges.push([from_id, to_id])
    wf[2] = edges
    let tasks = wf_tasks(wf)
    let to_task = tasks[to_id]
    if to_task != 0
        let deps = task_deps(to_task)
        deps.push(from_id)
        to_task[3] = deps
        tasks[to_id] = to_task
    wf[1] = tasks
    wf

let compute_in_degrees(wf) =
    let tasks = wf_tasks(wf)
    let in_degrees = {}
    let keys = keys_of(tasks)
    let i = 0
    let n = len(keys)
    for i < n
        in_degrees[keys[i]] = 0
        i = i + 1
    let edges = wf_edges(wf)
    let j = 0
    let m = len(edges)
    for j < m
        let to_id = edges[j][1]
        let d = in_degrees[to_id]
        if d == 0
            d = 0
        in_degrees[to_id] = d + 1
        j = j + 1
    in_degrees

let topological_sort(wf) =
    let in_degrees = compute_in_degrees(wf)
    let tasks = wf_tasks(wf)
    let queue = []
    let keys = keys_of(in_degrees)
    let i = 0
    let n = len(keys)
    for i < n
        if in_degrees[keys[i]] == 0
            queue.push(keys[i])
        i = i + 1
    let sorted = []
    for len(queue) > 0
        let tid = queue[0]
        queue.pop(0)
        sorted.push(tid)
        let edges = wf_edges(wf)
        let j = 0
        let m = len(edges)
        for j < m
            if edges[j][0] == tid
                let to_id = edges[j][1]
                let d = in_degrees[to_id]
                in_degrees[to_id] = d - 1
                if d - 1 == 0
                    queue.push(to_id)
            j = j + 1
    sorted

let deps_satisfied(wf, task) =
    let deps = task_deps(task)
    let tasks = wf_tasks(wf)
    let ok = 1
    let i = 0
    let n = len(deps)
    for i < n
        let dep_task = tasks[deps[i]]
        if dep_task == 0
            ok = 0
            i = n
        else
            0
        if task_status(dep_task) != 2
            ok = 0
            i = n
        i = i + 1
    ok

let check_condition(wf, task) =
    let cond = task_cond(task)
    if cond == 0
        1
    else
        let deps = task_deps(task)
        let tasks = wf_tasks(wf)
        if len(deps) == 0
            1
        else
            let dep_task = tasks[deps[0]]
            if dep_task == 0
                0
            else
                let result = task_result(dep_task)
                if result == cond
                    1
                else
                    0

let execute_task(wf, task, max_retries) =
    task = task_set_status(task, 1)
    let action = task_action(task)
    let success = 0
    let result = 0
    if action != 0
        result = action
        success = 1
    if success == 1
        task = task_set_status(task, 2)
        task = task_set_result(task, result)
        wf[4] = wf[4] + 1
    else
        let retries = task_retries(task)
        if retries < max_retries
            task = task_inc_retries(task)
            task = task_set_status(task, 0)
        else
            task = task_set_status(task, 3)
            wf[5] = wf[5] + 1
    let tasks = wf_tasks(wf)
    tasks[task_id(task)] = task
    wf[1] = tasks
    task

let workflow_run(wf) =
    let sorted = topological_sort(wf)
    let i = 0
    let n = len(sorted)
    for i < n
        let tid = sorted[i]
        let tasks = wf_tasks(wf)
        let task = tasks[tid]
        if task == 0
            i = n
        else
            if deps_satisfied(wf, task) == 1
                if check_condition(wf, task) == 1
                    task = execute_task(wf, task, task_max_retries(task))
                else
                    task = task_set_status(task, 4)
                    tasks[tid] = task
                    wf[1] = tasks
        i = i + 1
    wf

let saga_task_new(id, name, action_fn, compensate_fn) =
    [id, name, action_fn, compensate_fn, [], 0, 3, 0, 0]

let saga_compensate(t) = t[3]

let saga_run(wf) =
    let sorted = topological_sort(wf)
    let executed = []
    let failed = 0
    let i = 0
    let n = len(sorted)
    for i < n
        let tid = sorted[i]
        let tasks = wf_tasks(wf)
        let task = tasks[tid]
        if task == 0
            failed = 1
            i = n
        else
            if deps_satisfied(wf, task) == 1
                task = execute_task(wf, task, task_max_retries(task))
                if task_status(task) == 2
                    executed.push(task)
                else
                    failed = 1
                    i = n
        i = i + 1
    if failed == 1
        let j = len(executed) - 1
        for j >= 0
            let t = executed[j]
            let comp = saga_compensate(t)
            if comp != 0
                t[8] = comp
            j = j - 1
    wf

