let KB = []
let KB_LEN = 0

let reason_round(state, offset, n_obs, n_pred, lr) =
    let observed = []
    let i = 0
    for i < n_obs
        let idx = gf_add(offset, i)
        observed = observed.push(KB[idx])
        i = i + 1

    let discovery = bm_learn(observed, n_obs)
    let min_poly = discovery[0]
    let L = discovery[1]

    let predictions = bm_predict(min_poly, L, observed, n_pred)

    let actual = []
    let j = 0
    for j < n_pred
        actual = actual.push(KB[gf_add(offset, n_obs + j)])
        j = j + 1
    let correct = 0
    let total_error = 0
    let t = 0
    for t < n_pred
        let diff = gf_sub(predictions[t], actual[t])
        total_error = gf_add(total_error, gf_mul(diff, diff))
        if diff == 0
            correct = correct + 1
        t = t + 1
    let acc_x100 = gf_div(gf_mul(correct, 100), n_pred)

    let bragg_ok = bragg_verify(observed, observed, n_obs)

    let train_error = reason_correct(state, predictions, actual, lr)

    let attn = cauchy_attention(observed[n_obs - 1], observed, predictions, n_obs)

    [acc_x100, train_error, L, bragg_ok, attn]

let main() =
    KB = kb_build()
    KB_LEN = len(KB)

    let state = reason_state_init(8)
    let lr = 3
    let n_obs = 16
    let n_pred = 4
    let window_step = 8
    let best_acc = 0
    let laws = 0
    let gaps = 0
    let total_improve = 0
    let prev_err = 65537
    let prev_L = 0
    let last_bragg = 1
    let last_attn = 0

    let rounds = 120
    let max_off = KB_LEN - n_obs - n_pred - 1
    let r = 0
    let off = 0
    for r < rounds
        let result = reason_round(state, off, n_obs, n_pred, lr)
        let acc = result[0]
        let err = result[1]
        let L = result[2]
        let bragg_ok = result[3]
        let attn = result[4]
        last_bragg = bragg_ok
        last_attn = attn

        if L > 0
            laws = laws + 1
        if acc > best_acc
            best_acc = acc

        if err < prev_err
            total_improve = gf_add(total_improve, gf_sub(prev_err, err))
        prev_err = err

        let gap = 0
        if L >= n_obs
            gap = gf_add(gap, 1)
        if L > prev_L
            gap = gf_add(gap, gf_sub(L, prev_L))
        if err > 30000
            gap = gf_add(gap, 1)
        if gap > 0
            gaps = gaps + 1
        prev_L = L

        off = off + window_step
        if off > max_off
            off = 0
        r = r + 1

    let q0 = gf_add(gaps, last_attn)
    let q1 = gf_mul(gaps, 2)
    let q2 = gf_mul(last_attn, 3)
    let q3 = gf_add(total_improve, 1)
    let q4 = gf_add(prev_err, 1)
    let q_logits = [q0, q1, q2, q3, q4]
    let query_code = born_select(q_logits, 5)

    let gaps_c = gaps
    if gaps_c > 63
        gaps_c = 63
    let packed = gf_add(gf_mul(query_code, 8192), gf_add(gf_mul(gaps_c, 128), best_acc))
    print(packed)
    packed

