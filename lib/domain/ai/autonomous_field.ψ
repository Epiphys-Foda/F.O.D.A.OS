import "../../core/stdlib/gf65537.ψ"

let cauchy_attention(query, keys, values, n) =
    let numerator = 0
    let denominator = 0
    let j = 0
    for j < n
        let diff = gf_sub(query, keys[j])
        if diff != 0
            let w = gf_inv(diff)
            numerator = gf_add(numerator, gf_mul(w, values[j]))
            denominator = gf_add(denominator, w)
        j = j + 1
    if denominator != 0
        gf_div(numerator, denominator)
    else
        0

let bm_learn(sequence, n) =
    let C = []
    let B = []
    let i = 0
    for i < n
        C = C.push(0)
        B = B.push(0)
        i = i + 1
    C[0] = 1
    B[0] = 1
    let L = 0
    let b = 1
    let m = 1
    let step = 0
    for step < n
        let d = sequence[step]
        let ii = 1
        for ii <= L
            d = gf_add(d, gf_mul(C[ii], sequence[step - ii]))
            ii = ii + 1
        if d != 0
            let coeff = gf_div(d, b)
            let oldC = []
            let oc = 0
            for oc < n
                oldC = oldC.push(C[oc])
                oc = oc + 1
            let kk = 0
            for kk < n
                if kk + m < n
                    C[kk + m] = gf_sub(C[kk + m], gf_mul(coeff, B[kk]))
                kk = kk + 1
            let new_L = step + 1 - L
            if new_L > L
                let jj = 0
                for jj < n
                    B[jj] = oldC[jj]
                    jj = jj + 1
                L = new_L
                b = d
                m = 1
            else
                m = m + 1
        else
            m = m + 1
        step = step + 1
    let result = []
    let ri = 0
    for ri <= L
        result = result.push(C[ri])
        ri = ri + 1
    [result, L]

let bm_predict(min_poly, L, history, n_predict) =
    let work = []
    let hn = len(history)
    let i = 0
    for i < hn
        work = work.push(history[i])
        i = i + 1
    let predictions = []
    let p = 0
    for p < n_predict
        let wn = len(work)
        let val = 0
        let j = 1
        for j <= L
            let coeff = min_poly[j]
            if wn - j >= 0
                val = gf_add(val, gf_mul(gf_neg(coeff), work[wn - j]))
            j = j + 1
        work = work.push(val)
        predictions = predictions.push(val)
        p = p + 1
    predictions

let reason_state_init(n_poles) =
    let poles = []
    let residues = []
    let k = 0
    for k < n_poles
        poles = poles.push(gf_mul(k + 7, 911))
        residues = residues.push(gf_mul(k + 3, 5471))
        k = k + 1
    [poles, residues, [], [], 0, 0]

let reason_correct(state, predictions, actual, lr) =
    let poles = state[0]
    let residues = state[1]
    let n_poles = len(poles)
    let n = len(predictions)
    let total_error = 0
    let t = 0
    for t < n
        let pred = predictions[t]
        let target = actual[t]
        let error = gf_sub(pred, target)
        total_error = gf_add(total_error, gf_mul(error, error))
        let k = 0
        for k < n_poles
            let z = poles[k]
            let r = residues[k]
            let x = gf_reduce(t + 1)
            let diff = gf_sub(x, z)
            if diff != 0
                let inv_diff = gf_inv(diff)
                let grad_r = inv_diff
                let grad_z = gf_neg(gf_mul(r, gf_mul(inv_diff, inv_diff)))
                residues[k] = gf_sub(r, gf_mul(lr, gf_mul(error, grad_r)))
                poles[k] = gf_sub(z, gf_mul(lr, gf_mul(error, grad_z)))
            k = k + 1
        t = t + 1
    total_error

let born_select(logits, n) =
    let best_idx = 0
    let best_val = logits[0]
    let i = 1
    for i < n
        let a = logits[i]
        let p = gf_mul(a, a)
        let bp = gf_mul(best_val, best_val)
        if p > bp
            best_val = a
            best_idx = i
        i = i + 1
    best_idx

let bragg_verify(input_wave, output_wave, n) =
    let d1 = 0
    let r1 = 0
    let i = 0
    for i < n
        d1 = gf_add(d1, input_wave[i])
        r1 = gf_add(r1, output_wave[i])
        i = i + 1
    if d1 == r1
        1
    else
        0

let kb_algebraic() =
    let s = []
    let i = 0
    for i < 64
        s = s.push(gf_pow(3, i))
        i = i + 1
    let j = 0
    for j < 64
        s = s.push((17 * j + 41) % 65537)
        j = j + 1
    let a = 1
    let b = 1
    let k = 0
    for k < 64
        s = s.push(a)
        let nxt = (a + b) % 65537
        a = b
        b = nxt
        k = k + 1
    let q = 0
    for q < 48
        s = s.push(gf_pow(7, (q * q) % 65536))
        q = q + 1
    s

let kb_primes() =
    let ps = []
    let is_c = []
    let N = 1200
    let i = 0
    for i <= N
        is_c = is_c.push(0)
        i = i + 1
    let x = 2
    for x <= N
        if is_c[x] == 0
            ps = ps.push(x % 65537)
            let y = x * x
            for y <= N
                is_c[y] = 1
                y = y + x
        x = x + 1
    let j = 0
    let sq = []
    for j < 100
        sq = sq.push(gf_mul(ps[j], ps[j]))
        j = j + 1
    let all = []
    let t = 0
    for t < len(ps)
        all = all.push(ps[t])
        t = t + 1
    let u = 0
    for u < len(sq)
        all = all.push(sq[u])
        u = u + 1
    all

