import "../../core/stdlib_lang2/gf_base.ψ"

let RAG_MAX_DOCS = 65536
let RAG_EMBED_DIM = 256
let RAG_TOP_K = 10

let vs_create() = [[], [], 0]
let vs_add(store, doc) =
    let docs = store[0]
    let idx = store[1]
    docs.push(doc)
    idx.push(doc[0])
    [docs, idx, store[2] + 1]
let cosine_sim(a, b) =
    let dot = 0
    let norm_a = 0
    let norm_b = 0
    let i = 0
    let n = len(a)
    for i < n
        dot = gf_add(dot, gf_mul(a[i], b[i]))
        norm_a = gf_add(norm_a, gf_mul(a[i], a[i]))
        norm_b = gf_add(norm_b, gf_mul(b[i], b[i]))
        i = i + 1
    gf_div(dot, gf_mul(gf_sqrt(norm_a), gf_sqrt(norm_b)))
let euclidean_dist(a, b) =
    let dist = 0
    let i = 0
    let n = len(a)
    for i < n
        let diff = gf_sub(a[i], b[i])
        dist = gf_add(dist, gf_mul(diff, diff))
        i = i + 1
    dist
let vs_search(store, query_embedding, top_k) =
    let docs = store[0]
    let scores = []
    let i = 0
    let n = len(docs)
    for i < n
        let score = cosine_sim(query_embedding, docs[i][2])
        scores.push([docs[i][0], score])
        i = i + 1
    let sorted = []
    let count = 0
    for count < top_k && count < len(scores)
        let best_idx = 0
        let best_score = 0
        let j = 0
        let m = len(scores)
        for j < m
            if scores[j][1] > best_score
                best_idx = j
            best_score = scores[j][1]
            j = j + 1
        sorted.push(scores[best_idx])
        count = count + 1
    sorted
let rag_context(query, retrieved_docs) =
    let context = query
    let i = 0
    let n = len(retrieved_docs)
    for i < n
        context = gf_add(context, retrieved_docs[i][0])
        i = i + 1
    context
let rag_generate(query, store) =
    let results = vs_search(store, query, RAG_TOP_K)
    let context = rag_context(query, results)
    context
let rag_field_retrieve(query, docs, n, z) =
    let scores = arr_new_n(n)
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        let diff = (z + 65537 - pole) % 65537
        scores[i] = gf_mul(docs[i], gf_inv(diff))
        i = i + 1
    let best = 0
    let best_score = 0
    let j = 0
    for j < n
        if scores[j] > best_score
            best_score = scores[j]
            best = j
        j = j + 1
    best

let rag_verify() =
    let docs = arr_new_n(3)
    docs[0] = 100
