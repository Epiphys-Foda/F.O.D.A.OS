    docs[2] = 200
    let best = rag_field_retrieve(0, docs, 3, 500)
    let ok = 0
    (best == 1 ? (ok = 1) : (ok = 0))
    ok

let pmul_abs(x) =
    if x < 0
        0 - x
    else
        x
let pmul(a0, b0) =
    let a = pmul_abs(a0)
    let b = pmul_abs(b0)
    let r = 0
    for b > 0
        if b % 2 == 1
            r = r + a
        a = a + a
        b = b / 2
    r

let RAG2_POLES = [
    1000, 1500, 2600, 3400,
    5000, 6100, 7300, 8800,
]
let RAG2_RES = [
    500, 800, 300, 900,
    200, 700, 400, 600,
]
let RAG2_IDS = [
    11, 22, 33, 44,
    55, 66, 77, 88,
]
let RAG2_CHK_POLES = 17321
let RAG2_CHK_RES = 964
let RAG2_CHK_IDS = 54076

let rag2_scores(z) =
    let s = []
    let i = 0
    for i < 8
        let d = z - RAG2_POLES[i]
        let dn = (d < 0 ? 0 - d : d)
        s.push(pmul(RAG2_RES[i], 1024) / (1 + dn))
        i = i + 1
    s

let rag2_retrieve(z) =
    let s = rag2_scores(z)
    let best = 0
    let i = 1
    for i < 8
        if s[i] > s[best]
            best = i
        i = i + 1
    best

let rag2_chk(T) =
    let s = 0
    let i = 0
    let n = len(T)
    for i < n
        s = gf_norm(gf_norm(s) * 3 + gf_norm(T[i]))
        i = i + 1
    s

let rag2_verify() =
    let c1 = rag2_chk(RAG2_POLES) == RAG2_CHK_POLES
    let c2 = rag2_chk(RAG2_RES) == RAG2_CHK_RES
    let c3 = rag2_chk(RAG2_IDS) == RAG2_CHK_IDS
    let uniq = 1
    let i4 = 0
    for i4 < 8
        let j4 = i4 + 1
        for j4 < 8
            if RAG2_POLES[i4] == RAG2_POLES[j4]
                uniq = 0
            j4 = j4 + 1
        i4 = i4 + 1
    let selfhit = 1
    let i5 = 0
    for i5 < 8
        if rag2_retrieve(RAG2_POLES[i5]) != i5
            selfhit = 0
        i5 = i5 + 1
    let qhit = rag2_retrieve(3200) == 3
    let det = rag2_retrieve(3200) == rag2_retrieve(3200)
    let sp = rag2_scores(RAG2_POLES[0])
    let nz = sp[0] > 0
    c1 && c2 && c3 && uniq == 1 && selfhit == 1 && qhit && det && nz
