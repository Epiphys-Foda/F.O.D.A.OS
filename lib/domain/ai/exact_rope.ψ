let ROPE_P = 65537
let ROPE_CTX = 4096
let ROPE_ROOT_E = 16

let rope_pow(b, e) =
    let r = 1
    let base = b % ROPE_P
    let ex = e
    for ex > 0
        if ex % 2 == 1
            r = r * base % ROPE_P
        base = base * base % ROPE_P
        ex = ex / 2
    r

let rope_zeta() =
    rope_pow(3, ROPE_ROOT_E)

let rope_enc(qx, qy, i) =
    let z = rope_zeta()
    let i2 = (i % ROPE_CTX + ROPE_CTX) % ROPE_CTX
    let e2 = (ROPE_CTX - i2) % ROPE_CTX
    [qx * rope_pow(z, i2) % ROPE_P, qy * rope_pow(z, e2) % ROPE_P]

let rope_score(qx, qy, kx, ky, i, j) =
    let z = rope_zeta()
    let d = ((i - j) % ROPE_CTX + ROPE_CTX) % ROPE_CTX
    let dz = (ROPE_CTX - d) % ROPE_CTX
    let t1 = qx * rope_pow(z, d) % ROPE_P * (ky * rope_pow(z, d) % ROPE_P) % ROPE_P
    let t2 = qy * rope_pow(z, dz) % ROPE_P * (kx * rope_pow(z, dz) % ROPE_P) % ROPE_P
    (t1 + t2) % ROPE_P

let rope_plain(qx, qy, kx, ky, i, j) =
    let z = rope_zeta()
    let s = ((i + j) % ROPE_CTX + ROPE_CTX) % ROPE_CTX
    let sz = (ROPE_CTX - s) % ROPE_CTX
    let t1 = qx * rope_pow(z, s) % ROPE_P * (kx * rope_pow(z, s) % ROPE_P) % ROPE_P
    let t2 = qy * rope_pow(z, sz) % ROPE_P * (ky * rope_pow(z, sz) % ROPE_P) % ROPE_P
    (t1 + t2) % ROPE_P

let rope_v_all() =
    let ok = 1
    let z = rope_zeta()
    ok = ok * (rope_pow(z, ROPE_CTX) == 1 ? 1 : 0)
    ok = ok * (rope_pow(z, ROPE_CTX / 2) == ROPE_P - 1 ? 1 : 0)
    ok = ok * (z != 1 ? 1 : 0)
    ok = ok * (ROPE_CTX == 4096 ? 1 : 0)
    let qx = 7
    let qy = 11
    let kx = 13
    let ky = 17
    let law = 1
    let i = 0
    for i < 7
        let j = 0
        for j < 7
            if rope_score(qx, qy, kx, ky, i, j) != rope_score(qx, qy, kx, ky, i + 1, j + 1)
                law = 0
            j = j + 1
        i = i + 1
    ok = ok * law
    let s1 = rope_score(qx, qy, kx, ky, 2, 5)
    ok = ok * (s1 == rope_score(qx, qy, kx, ky, 0, 3) && s1 == rope_score(qx, qy, kx, ky, 7, 10) ? 1 : 0)
    let base = rope_score(qx, qy, qx, qy, 0, 0)
    let inv = 1
    let i2 = 0
    for i2 < 9
        if rope_score(qx, qy, qx, qy, i2, i2) != base
            inv = 0
        i2 = i2 + 1
    ok = ok * (rope_score(qx, qy, qx, qy, 4095, 4095) == base ? 1 : 0)
    ok = ok * inv
    let viol = 0
    let i3 = 0
    for i3 < 7
        let j3 = 0
        for j3 < 7
            if rope_plain(qx, qy, kx, ky, i3, j3) != rope_plain(qx, qy, kx, ky, i3 + 1, j3 + 1)
                viol = 1
            j3 = j3 + 1
        i3 = i3 + 1
    ok = ok * viol
    let e0 = rope_enc(qx, qy, 0)
    let e1 = rope_enc(qx, qy, ROPE_CTX)
    ok = ok * (e0[0] == e1[0] && e0[1] == e1[1] ? 1 : 0)
    ok
