let tool_new(name, description, function_ref) =
    [name, description, function_ref]

let tool_name(t) = t[0]
let tool_desc(t) = t[1]
let tool_fn(t) = t[2]

let agent_new(id, name, goal) =
    [id, name, [], [], 0, goal, 0]

let ag_id(a) = a[0]
let ag_name(a) = a[1]
let ag_tools(a) = a[2]
let ag_short_mem(a) = a[3]
let ag_long_mem(a) = a[4]
let ag_goal(a) = a[5]
let ag_status(a) = a[6]

let ag_add_tool(a, tool) =
    let tools = ag_tools(a)
    tools.push(tool)
    a[2] = tools
    a

let ag_set_long_mem(a, mem_ref) =
    a[4] = mem_ref
    a

let ag_set_status(a, status) =
    a[6] = status
    a

let ag_mem_add(a, observation) =
    let mem = ag_short_mem(a)
    mem.push([len(mem), "observation", observation])
    let max_len = 16
    if len(mem) > max_len
        let new_mem = []
        let i = len(mem) - max_len
        for i < len(mem)
            new_mem.push(mem[i])
            i = i + 1
        mem = new_mem
    a[3] = mem
    a

let ag_mem_get_recent(a, n) =
    let mem = ag_short_mem(a)
    let result = []
    let start = len(mem) - n
    if start < 0
        start = 0
    let i = start
    for i < len(mem)
        result.push(mem[i])
        i = i + 1
    result

let agent_find_tool(a, tool_name) =
    let tools = ag_tools(a)
    let i = 0
    let n = len(tools)
    let found = 0
    for i < n
        if tool_name(tools[i]) == tool_name
            found = tools[i]
            i = n
        i = i + 1
    found

let agent_call_tool(a, tool_name, args) =
    let tool = agent_find_tool(a, tool_name)
    if tool == 0
        ["error", "tool_not_found"]
    else
        let fn_ref = tool_fn(tool)
        if fn_ref == 0
            ["error", "no_function"]
        else
            ["ok", fn_ref]

let react_step(a, thought, action_tool, action_args) =
    let mem = ag_short_mem(a)
    mem.push([len(mem), "thought", thought])
    a[3] = mem
    a = ag_set_status(a, 2)
    let result = agent_call_tool(a, action_tool, action_args)
    mem = ag_short_mem(a)
    mem.push([len(mem), "observation", result])
    a[3] = mem
    a = ag_set_status(a, 1)
    a

let task_decompose(goal) =
    let steps = []
    steps.push(["analyze", "analyze goal: " + goal])
    steps.push(["plan", "make plan"])
    steps.push(["execute_step1", "execute step1"])
    steps.push(["execute_step2", "execute step2"])
    steps.push(["verify", "verify result"])
    steps.push(["finalize", "finalize"])
    steps

let agent_execute_plan(a) =
    let goal = ag_goal(a)
    let steps = task_decompose(goal)
    let i = 0
    let n = len(steps)
    for i < n
        let step = steps[i]
        let action = step[0]
        let thought = step[1]
        let result = react_step(a, thought, action, [])
        i = i + 1
    a = ag_set_status(a, 3)
    a

let multi_agent_new() =
    [{}, []]

let ma_agents(ma) = ma[0]
let ma_shared(ma) = ma[1]

let ma_add_agent(ma, agent) =
    let agents = ma_agents(ma)
    agents[ag_id(agent)] = agent
    ma[0] = agents
    ma

let ma_get_agent(ma, agent_id) =
    let agents = ma_agents(ma)
    agents[agent_id]

let ma_share_context(ma, key, value) =
    let shared = ma_shared(ma)
    shared[key] = value
    ma[1] = shared
    ma

let ma_get_shared(ma, key) =
    let shared = ma_shared(ma)
    shared[key]

let ma_collaborate(ma, agent1_id, agent2_id, task) =
    let a1 = ma_get_agent(ma, agent1_id)
    let a2 = ma_get_agent(ma, agent2_id)
    if a1 == 0 || a2 == 0
        0
    else
        a1 = ag_mem_add(a1, task)
        a1 = agent_execute_plan(a1)
        let recent = ag_mem_get_recent(a1, 1)
        let output = 0
        if len(recent) > 0
            output = recent[0][2]
        ma = ma_share_context(ma, "task_output", output)
        a2 = ag_mem_add(a2, ma_get_shared(ma, "task_output"))
        1

