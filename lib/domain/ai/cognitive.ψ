let COG_MAX_MEMORY = 65536
let COG_MAX_RULES = 4096

let memory_create(capacity) = [[], 0, capacity]
let memory_add(mem, item) =
        let items = mem[0]
        if mem[1] < mem[2]
            items.push(item)
            [items, mem[1] + 1, mem[2]]
        else
            let new_items = []
            let i = 1
            let n = len(items)
            for i < n
                new_items.push(items[i])
                i = i + 1
            new_items.push(item)
            [new_items, mem[1], mem[2]]
let memory_recall(mem, pattern) =
    let items = mem[0]
    let results = []
    let i = 0
    let n = len(items)
    for i < n
        if items[i] / 256 == pattern / 256
            results.push(items[i])
        i = i + 1
    results
let memory_forget(mem, item) =
    let items = mem[0]
    let new_items = []
    let i = 0
    let n = len(items)
    for i < n
        if items[i] != item
            new_items.push(items[i])
        i = i + 1
    [new_items, mem[1] - 1, mem[2]]
let rule_create(condition, action, priority) = [condition, action, priority]
let rule_match(rule, state) =
    (state / 256 == rule[0] / 256 ? 1 : 0)
let cog_infer(engine, input) =
    let rules = engine[1]
    let state = gf_add(engine[2], input)
    let best_action = 0
    let best_priority = 0
    let i = 0
    let n = len(rules)
    for i < n
        let rule = rules[i]
        if rule_match(rule, state) == 1 && rule[2] > best_priority
            best_action = rule[1]
            best_priority = rule[2]
        i = i + 1
    best_action
let cog_learn(engine, experience, reward) =
    let mem = engine[0]
    let new_mem = memory_add(mem, [experience, reward])
    [new_mem, engine[1], engine[2]]
let cog_step(engine, input) =
    let action = cog_infer(engine, input)
    let new_state = gf_add(gf_mul(engine[2], 2), action)
    [engine[0], engine[1], new_state]
let cog_field_crystallize(observations, n, z) =
    let poles = arr_new_n(n)
    let residues = arr_new_n(n)
    let i = 0
    for i < n
        poles[i] = 127 + i * 1000
        residues[i] = observations[i]
        i = i + 1
    let val = 0
    let j = 0
    for j < n
        let diff = (z + 65537 - poles[j]) % 65537
        val = gf_add(val, gf_mul(residues[j], gf_inv(diff)))
        j = j + 1
    val

