let COG_DEC_POLES = [1, 2, 3, 4, 5, 6, 7, 8]
let COG_DEC_WEIGHTS = [90, 80, 70, 60, 50, 40, 30, 20]

let psi_cog_dec(action) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(action), gf_norm(COG_DEC_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(COG_DEC_WEIGHTS[k], gf_inv(diff)))
