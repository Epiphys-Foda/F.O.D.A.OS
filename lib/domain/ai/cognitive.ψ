let COG_ATTN_POLES = [1, 2, 3, 4, 5, 6, 7, 8]
let COG_ATTN_WEIGHTS = [40, 60, 80, 100, 70, 50, 30, 20]

let psi_cog_attn(head) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(head), gf_norm(COG_ATTN_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(COG_ATTN_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let COG_WM_POLES = [1, 2, 3, 4, 5, 6, 7, 8]
let COG_WM_WEIGHTS = [10, 20, 30, 40, 50, 60, 70, 80]

let psi_cog_wm(slot) =
    let val = 0
