let cognitive_global_response(head, slot, action) =
    let e1 = psi_cog_attn(head)
    let e2 = psi_cog_wm(slot)
    let e3 = psi_cog_dec(action)
    gf_add(gf_add(gf_mul(e1, e1), gf_mul(e2, e2)), gf_mul(e3, e3))

