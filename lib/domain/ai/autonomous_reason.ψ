import "../../core/stdlib/gf65537.ψ"

let cauchy_attention(query, keys, values, n) =
    let numerator = 0
    let denominator = 0
    let j = 0
    for j < n
        let diff = gf_sub(query, keys[j])
        if diff != 0
            let w = gf_inv(diff)
            numerator = gf_add(numerator, gf_mul(w, values[j]))
            denominator = gf_add(denominator, w)
        j = j + 1

    if denominator != 0
        gf_div(numerator, denominator)
    else
        0

let cauchy_attention_raw(query, keys, values, n) =
    let result = 0
    let j = 0
    for j < n
        let diff = gf_sub(query, keys[j])
        if diff != 0
            result = gf_add(result, gf_div(values[j], diff))
        j = j + 1
    result

let multi_head_cauchy(queries, keys, values, n, n_heads) =
    let outputs = []
    let h = 0
    for h < n_heads
        let q = queries[h]
        let k = keys[h]
        let v = values[h]
        outputs.push(cauchy_attention(q, k, v, n))
        h = h + 1
    outputs

let bm_learn(sequence, n) =
    let C = []
    let B = []
    let i = 0
    for i < n
        C.push(0)
        B.push(0)
        i = i + 1
    C[0] = 1
    B[0] = 1

    let L = 0
    let b = 1
    let m = 1

    let step = 0
    for step < n
        let d = sequence[step]
        let ii = 1
        for ii <= L
            d = gf_add(d, gf_mul(C[ii], sequence[step - ii]))
            ii = ii + 1

        if d != 0
            let coeff = gf_div(d, b)
            let kk = 0
            for kk < n
                if kk + m < n
                    C[kk + m] = gf_sub(C[kk + m], gf_mul(coeff, B[kk]))
                kk = kk + 1

            let new_L = step + 1 - L
            if new_L > L
                let jj = 0
                for jj < n
                    B[jj] = C[jj]
                    jj = jj + 1
                L = new_L
                b = d
                m = 1
            else
                m = m + 1
        else
            m = m + 1
        step = step + 1

    let result = []
    let ri = 0
    for ri <= L
        result.push(C[ri])
        ri = ri + 1
    [result, L]

let bm_predict(min_poly, L, history, n_predict) =
    let work = []
    let i = 0
    let hn = len(history)
    for i < hn
        work.push(history[i])
        i = i + 1

    let predictions = []
    let p = 0
    for p < n_predict
        let wn = len(work)
        let val = 0
        let j = 1
        for j <= L
            let coeff = min_poly[L - j]
            if wn - j >= 0
                val = gf_add(val, gf_mul(gf_neg(coeff), work[wn - j]))
            j = j + 1
        work.push(val)
        predictions.push(val)
        p = p + 1
    predictions

let reason_state_init(n_poles) =
    let poles = []
    let residues = []
    let i = 0
    for i < n_poles
        poles.push(gf_reduce(i + 2))
        residues.push(1)
        i = i + 1
    [poles, residues, [], [], 0, 0]

let reason_observe(env_data, n) =
    let observed = []
    let i = 0
    for i < n
        if i < len(env_data)
            observed.push(env_data[i])
        else
            observed.push(0)
        i = i + 1
    observed

let reason_discover(observed, n) =
    let result = bm_learn(observed, n)
    let min_poly = result[0]
    let L = result[1]
    [min_poly, L]

let reason_predict(min_poly, L, observed, n_predict) =
    bm_predict(min_poly, L, observed, n_predict)

let reason_verify(predictions, actual, n) =
    let correct = 0
    let total_error = 0
    let i = 0
    for i < n
        let diff = gf_sub(predictions[i], actual[i])
        let err = gf_mul(diff, diff)
        total_error = gf_add(total_error, err)
        if gf_abs(diff) < 50
            correct = correct + 1
        i = i + 1
    [correct, total_error]

let reason_correct(state, observed, predictions, actual, lr) =
    let poles = state[0]
    let residues = state[1]
    let n_poles = len(poles)
    let n = len(predictions)

    let total_error = 0
    let t = 0
    for t < n
        let pred = predictions[t]
        let target = actual[t]
        let error = gf_sub(pred, target)
        total_error = gf_add(total_error, gf_mul(error, error))

        let k = 0
        for k < n_poles
            let z = poles[k]
            let r = residues[k]
            let x = gf_reduce(t + 1)
            let diff = gf_sub(x, z)
            if diff != 0
                let inv_diff = gf_inv(diff)
                let inv_diff_sq = gf_mul(inv_diff, inv_diff)
                let grad_r = inv_diff
                let grad_z = gf_neg(gf_mul(r, inv_diff_sq))
                residues[k] = gf_sub(r, gf_mul(lr, gf_mul(error, grad_r)))
                poles[k] = gf_sub(z, gf_mul(lr, gf_mul(error, grad_z)))
            k = k + 1
        t = t + 1

    let new_state = []
    new_state.push(poles)
    new_state.push(residues)
    new_state.push(state[2])
    new_state.push(state[3])
    new_state.push(state[4] + 1)
    new_state.push(state[5])
    [total_error, new_state]

let reason_cycle(state, env_data, n_observe, n_predict, lr) =
    let observed = reason_observe(env_data, n_observe)

    let discovery = reason_discover(observed, n_observe)
    let min_poly = discovery[0]
    let L = discovery[1]

    let predictions = reason_predict(min_poly, L, observed, n_predict)

    let actual = []
    let i = 0
    for i < n_predict
        if n_observe + i < len(env_data)
            actual.push(env_data[n_observe + i])
        else
            actual.push(0)
        i = i + 1

    let verify_result = reason_verify(predictions, actual, n_predict)
    let correct = verify_result[0]
    let verify_error = verify_result[1]

    let correct_result = reason_correct(state, observed, predictions, actual, lr)
    let train_error = correct_result[0]
    let new_state = correct_result[1]

    let accuracy = gf_div(correct, n_predict)
    [accuracy, train_error, new_state, L]

let continuous_reasoning(n_rounds, env_data, n_poles, lr) =
    let state = reason_state_init(n_poles)
    let best_accuracy = 0
    let total_improvement = 0
    let prev_error = 65537
    let laws_discovered = 0

    let round = 0
    for round < n_rounds
        let n_obs = 8
        let n_pred = 4

        let result = reason_cycle(state, env_data, n_obs, n_pred, lr)
        let accuracy = result[0]
        let error = result[1]
        state = result[2]
        let L = result[3]

        if L > 0
            laws_discovered = laws_discovered + 1

        if accuracy > best_accuracy
            best_accuracy = accuracy

        if error < prev_error
            total_improvement = gf_add(total_improvement, gf_sub(prev_error, error))
        prev_error = error

        round = round + 1

    [round, best_accuracy, total_improvement, laws_discovered]

let detect_knowledge_gaps(prev_L, curr_L, prediction_error) =
    let gap = 0
    if curr_L > prev_L
        gap = gf_sub(curr_L, prev_L)
    gap = gf_add(gap, gf_div(prediction_error, 100))
    gap

let generate_query(gap_score, observations) =
    if gap_score == 0
        0
    else
        if gap_score < 10
            1
        else
            if gap_score < 100
                2
            else
                if gap_score < 1000
                    3
                else
                    4

let measure_contraction(prev_error, curr_error) =
    if prev_error == 0
        0
    else
        gf_div(curr_error, prev_error)

let bootstrap_health(contraction) =
    if contraction < 32768
        1
    else
        0

let run_autonomous_experiment() =
    let env_data = []
    let i = 0
    for i < 20
        env_data.push(gf_pow(3, i))
        i = i + 1

    let result = continuous_reasoning(15, env_data, 3, gf_div(1, 100))
    let rounds = result[0]
    let best_acc = result[1]
    let improvement = result[2]
    let laws = result[3]

    let health = bootstrap_health(improvement)

    [rounds, best_acc, improvement, laws, health]

let main() =
    let exp = run_autonomous_experiment()
    let rounds = exp[0]
    let best_acc = exp[1]
    let improvement = exp[2]
    let laws = exp[3]
    let health = exp[4]

    gf_add(gf_add(gf_add(gf_add(rounds, best_acc), improvement), laws), health)
