let CMEM_P = 65537

let cmem_pow(b, e) =
    let r = 1
    let base = b % CMEM_P
    let ex = e
    for ex > 0
        if ex % 2 == 1
            r = r * base % CMEM_P
        base = base * base % CMEM_P
        ex = ex / 2
    r

let cmem_inv(a) =
    cmem_pow(a, CMEM_P - 2)

let cmem_distinct(keys, n) =
    let ok = 1
    let i = 0
    for i < n
        let j = i + 1
        for j < n
            if keys[i] == keys[j]
                ok = 0
            j = j + 1
        i = i + 1
    ok

let cmem_bary(keys, n) =
    let lam = arr_new_n(n)
    let j = 0
    for j < n
        let pr = 1
        let l = 0
        for l < n
            if l != j
                pr = pr * ((keys[j] - keys[l]) % CMEM_P) % CMEM_P
            l = l + 1
        lam[j] = cmem_inv(pr)
        j = j + 1
    lam

let cmem_recall(keys, vals, lam, n, q) =
    let i = 0
    for i < n
        if keys[i] == q
            return vals[i]
        i = i + 1
    let sum = 0
    let j = 0
    for j < n
        let pr = 1
        let l = 0
        for l < n
            if l != j
                pr = pr * ((q - keys[l]) % CMEM_P) % CMEM_P
            l = l + 1
        sum = (sum + vals[j] * lam[j] % CMEM_P * pr) % CMEM_P
        j = j + 1
    sum

let cmem_forget(vals, n, c) =
    let out = arr_new_n(n)
    let i = 0
    for i < n
        out[i] = vals[i] * c % CMEM_P
        i = i + 1
    out

