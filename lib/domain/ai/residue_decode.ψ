let rd_field_eval_inline(poles, residues, z, n) =
    let sum = 0
    let i = 0
    for i < n
        let dz = (z - poles[i]) % 65537
        if dz < 0
            dz = dz + 65537
        if dz == 0
            sum = (sum + residues[i]) % 65537
        else
            let or = dz
            let r = 65537
            let os = 1
            let s = 0
            for r > 0
                let q = or // r
                let tr = or - q * r
                or = r
                r = tr
                let ts = os - q * s
                os = s
                s = ts
            let inv = os % 65537
            if inv < 0
                inv = inv + 65537
            sum = (sum + residues[i] * inv) % 65537
        i = i + 1
    sum

