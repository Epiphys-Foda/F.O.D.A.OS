let residue_field_eval(poles, z) =
    let _poles = []
    let _residues = []
    let _depths = []
    let _i = 0
    let _n = len(poles)
    for _i < _n
        _poles.push(poles[_i][0])
        _residues.push(poles[_i][1])
        _depths.push(1)
        _i = _i + 1
    domain_field_eval(_poles, _residues, z)
let pole_update(pole, z, target, lr) =
    let diff = gf_sub(z, pole[0])
    let inv_diff = gf_inv(diff)
    let pred = gf_mul(pole[1], inv_diff)
    let error = gf_sub(target, pred)
    let new_residue = gf_add(pole[1], gf_mul(lr, gf_mul(error, inv_diff)))
    let grad_pos = gf_mul(error, gf_mul(pole[1], gf_mul(inv_diff, inv_diff)))
    let new_pos = gf_sub(pole[0], gf_mul(lr, grad_pos))
    [new_pos, new_residue, pole[2]]
let rlayer_create(n_poles, activation) =
    let poles = []
    let i = 0
    for i < n_poles
        poles.push([i + 1, 1, 1])
        i = i + 1
    [poles, n_poles, activation]
let rlayer_forward(layer, input) =
    let poles = layer[0]
    let output = residue_field_eval(poles, input)
    (layer[2] == 1 ? gf_pow(output, 3) : output)
let rlayer_backward(layer, input, grad, lr) =
    let poles = layer[0]
    let new_poles = []
    let i = 0
    let n = len(poles)
    for i < n
        let pole = poles[i]
        new_poles.push(pole_update(pole, input, grad, lr))
        i = i + 1
    [new_poles, layer[1], layer[2]]
let rnet_create(n_layers, input_dim, output_dim) =
    let layers = []
    let i = 0
    for i < n_layers
        layers.push(rlayer_create(16, 1))
        i = i + 1
    [layers, n_layers, input_dim, output_dim]
let rnet_forward(net, input) =
    let layers = net[0]
    let x = input
    let i = 0
    let n = net[1]
    for i < n
        x = rlayer_forward(layers[i], x)
        i = i + 1
    x
let rnet_train(net, data, labels, lr, epochs) =
    let n = net
    let e = 0
    for e < epochs
        let i = 0
        let m = len(data)
        for i < m
            let pred = rnet_forward(n, data[i])
            let error = gf_sub(labels[i], pred)
            let j = 0
            let layers = n[0]
            let new_layers = []
            for j < n[1]
                new_layers.push(rlayer_backward(layers[j], data[i], error, lr))
                j = j + 1
            n = [new_layers, n[1], n[2], n[3]]
            i = i + 1
        e = e + 1
    n
let field_interference(poles1, residues1, n1, poles2, residues2, n2, z) =
    let val1 = 0
    let i = 0
    for i < n1
        let diff = gf_sub(z, poles1[i])
        val1 = gf_add(val1, gf_mul(residues1[i], gf_inv(diff)))
        i = i + 1
    let val2 = 0
    let j = 0
    for j < n2
        let diff = gf_sub(z, poles2[j])
        val2 = gf_add(val2, gf_mul(residues2[j], gf_inv(diff)))
        j = j + 1
    gf_add(val1, val2)

let soliton_memory_create(positions, amplitudes, n) =
    let poles = arr_new_n(n)
    let residues = arr_new_n(n)
    let i = 0
    for i < n
        poles[i] = positions[i]
        residues[i] = amplitudes[i]
        i = i + 1
    [poles, residues, n]

let soliton_memory_recall(memory, query_z) =
    let poles = memory[0]
    let residues = memory[1]
    let n = memory[2]
    residue_field_eval(poles, query_z)

let born_decision(amplitudes, n) =
    let total_prob = 0
    let i = 0
    for i < n
        let a = amplitudes[i]
        total_prob = gf_add(total_prob, gf_mul(a, a))
        i = i + 1
    let best = 0
    let best_prob = 0
    let j = 0
    for j < n
        let a = amplitudes[j]
        let prob = gf_mul(a, a)
        if prob > best_prob
            best_prob = prob
            best = j
        j = j + 1
    best

let field_attention(query_poles, key_poles, value_residues, n, z) =
    let scores = arr_new_n(n)
    let i = 0
    for i < n
        let q_diff = gf_sub(z, query_poles[i])
        let k_diff = gf_sub(z, key_poles[i])
        let score = gf_mul(gf_inv(q_diff), gf_inv(k_diff))
        scores[i] = score
        i = i + 1
    let total = 0
    let j = 0
    for j < n
        total = gf_add(total, scores[j])
        j = j + 1
    let result = 0
    let k = 0
    for k < n
        let weight = gf_mul(scores[k], gf_inv(total))
        result = gf_add(result, gf_mul(weight, value_residues[k]))
        k = k + 1
    result

