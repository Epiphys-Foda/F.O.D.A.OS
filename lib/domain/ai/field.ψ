let RFAI_INJECT_POLES = [100, 200, 300, 400, 500, 600, 700, 800]
let RFAI_INJECT_WEIGHTS = [10, 20, 30, 40, 50, 60, 70, 80]

let psi_rfai_inject(stimulus) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(stimulus), gf_norm(RFAI_INJECT_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(RFAI_INJECT_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let RFAI_RESONATE_POLES = [10, 20, 30, 40, 50, 60, 70, 80]
let RFAI_RESONATE_WEIGHTS = [80, 70, 60, 50, 40, 30, 20, 10]

let psi_rfai_resonate(freq) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(freq), gf_norm(RFAI_RESONATE_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(RFAI_RESONATE_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let RFAI_VORTEX_POLES = [1, 2, 3, 4, 5, 6, 7, 8]
let RFAI_VORTEX_WEIGHTS = [10, 30, 50, 70, 90, 70, 50, 30]

let psi_rfai_vortex(position) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(position), gf_norm(RFAI_VORTEX_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(RFAI_VORTEX_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let field_global_response(stimulus, freq, position) =
    let e1 = psi_rfai_inject(stimulus)
    let e2 = psi_rfai_resonate(freq)
    let e3 = psi_rfai_vortex(position)
    gf_add(gf_add(gf_mul(e1, e1), gf_mul(e2, e2)), gf_mul(e3, e3))

