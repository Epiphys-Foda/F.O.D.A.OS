    m

let mm_search_text_to_image(m, a, text_vec, k) =
    let query = mm_encode_text(a, text_vec)
    let images = mi_image(m)
    let keys = keys_of(images)
    let scored = []
    let i = 0
    let n = len(keys)
    for i < n
        let id = keys[i]
        let sim = mm_cosine(query, images[id])
        scored.push([sim, id])
        i = i + 1
    let result = []
    let j = 0
    for j < k
        let best_idx = 0
        let best_sim = -65536
        let idx = 0
        let ns = len(scored)
        for idx < ns
            if scored[idx][0] > best_sim
                best_sim = scored[idx][0]
                best_idx = idx
            idx = idx + 1
        if best_sim > -65536
            result.push(scored[best_idx])
            scored[best_idx] = [-65536, ""]
        j = j + 1
    result

