let mm_early_fusion(a, text_vec, image_vec, audio_vec) =
    let t = mm_encode_text(a, text_vec)
    let i = mm_encode_image(a, image_vec)
    let au = mm_encode_audio(a, audio_vec)
    let fused = []
    let j = 0
    let dim = ma_dim(a)
    for j < dim
        fused.push(t[j])
        j = j + 1
    j = 0
    for j < dim
        fused.push(i[j])
        j = j + 1
    j = 0
    for j < dim
        fused.push(au[j])
        j = j + 1
    fused

let mm_late_fusion(text_score, image_score, audio_score, weights) =
    let w_sum = weights[0] + weights[1] + weights[2]
    if w_sum == 0
        (text_score + image_score + audio_score) / 3
    else
        (text_score * weights[0] + image_score * weights[1] + audio_score * weights[2]) / w_sum

let mm_get_or_zero(map, id, dim) =
    let v = map[id]
    if v == 0
        let zero = []
        let i = 0
        for i < dim
            zero.push(0)
            i = i + 1
        zero
    else
        v

let mm_encode_or_zero(proj, vec, dim) =
    if vec == 0
        let zero = []
        let i = 0
        for i < dim
            zero.push(0)
            i = i + 1
        zero
    else
        mm_project(proj, vec)

let mm_robust_fusion(a, text_vec, image_vec, audio_vec) =
    let dim = ma_dim(a)
    let t = mm_encode_or_zero(ma_text_proj(a), text_vec, dim)
    let i = mm_encode_or_zero(ma_image_proj(a), image_vec, dim)
    let au = mm_encode_or_zero(ma_audio_proj(a), audio_vec, dim)
    let fused = []
    let j = 0
    for j < dim
        fused.push((t[j] + i[j] + au[j]) / 3)
        j = j + 1
    fused

let mm_text_to_image(a, text_vec) =
    mm_encode_text(a, text_vec)

let mm_image_to_text(a, image_vec) =
    mm_encode_image(a, image_vec)

let mm_memory_new() =
    [[]]

let mm_mem_list(m) = m[0]

let mm_memory_add(m, id, text_vec, image_vec, audio_vec, timestamp) =
    let entry = [id, text_vec, image_vec, audio_vec, timestamp]
    mm_mem_list(m).push(entry)
    m

let mm_memory_search_by_text(m, a, query_text_vec, k) =
    let query = mm_encode_text(a, query_text_vec)
    let entries = mm_mem_list(m)
    let scored = []
    let i = 0
    let n = len(entries)
    for i < n
        let e = entries[i]
        if e[1] != 0
            let ev = mm_encode_text(a, e[1])
            let sim = mm_cosine(query, ev)
            scored.push([sim, e])
        i = i + 1
    let result = []
    let j = 0
    for j < k
        let best_idx = 0
        let best_sim = -65536
        let idx = 0
        let ns = len(scored)
        for idx < ns
            if scored[idx][0] > best_sim
                best_sim = scored[idx][0]
                best_idx = idx
            idx = idx + 1
        if best_sim > -65536
            result.push(scored[best_idx][1])
            scored[best_idx] = [-65536, 0]
        j = j + 1
    result

