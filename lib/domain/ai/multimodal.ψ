import "../domain_field.ψ"

let MM_DIM = 64

let mm_projector_new(modality, input_dim) =
    [modality, input_dim, MM_DIM, {}]

let proj_modality(p) = p[0]
let proj_in_dim(p) = p[1]
let proj_out_dim(p) = p[2]
let proj_weights(p) = p[3]

let mm_project(p, input_vec) =
    let in_dim = proj_in_dim(p)
    let out_dim = proj_out_dim(p)
    let weights = proj_weights(p)
    let output = []
    let i = 0
    for i < out_dim
        let sum = 0
        let j = 0
        for j < in_dim
            let w_key = proj_modality(p) + "_" + i + "_" + j
            let w = weights[w_key]
            if w == 0
                w = ((i * 2654435761 + j * 40503) % 65537) - 32768
                weights[w_key] = w
            if j < len(input_vec)
                sum = sum + w * input_vec[j]
            j = j + 1
        output.push(sum / in_dim)
        i = i + 1
    p[3] = weights
    output

let mm_aligner_new(dim) =
    [{}, {}, {}, {}, dim]

let ma_text_proj(a) = a[0]
let ma_image_proj(a) = a[1]
let ma_audio_proj(a) = a[2]
let ma_video_proj(a) = a[3]
let ma_dim(a) = a[4]

let mm_aligner_init(a, text_dim, image_dim, audio_dim, video_dim) =
    a[0] = mm_projector_new("text", text_dim)
    a[1] = mm_projector_new("image", image_dim)
    a[2] = mm_projector_new("audio", audio_dim)
    a[3] = mm_projector_new("video", video_dim)
    a

let mm_encode_text(a, text_vec) =
    mm_project(ma_text_proj(a), text_vec)

let mm_encode_image(a, image_vec) =
    mm_project(ma_image_proj(a), image_vec)

let mm_encode_audio(a, audio_vec) =
    mm_project(ma_audio_proj(a), audio_vec)

let mm_encode_video(a, video_vec) =
    mm_project(ma_video_proj(a), video_vec)

let mm_cosine(v1, v2) =
    let sum = 0
    let n1 = 0
    let n2 = 0
    let i = 0
    let n = len(v1)
    for i < n
        sum = sum + v1[i] * v2[i]
        n1 = n1 + v1[i] * v1[i]
        n2 = n2 + v2[i] * v2[i]
        i = i + 1
    if n1 == 0 || n2 == 0
        0
    else
        sum * 10000 / (n1 * n2)

let mm_text_image_sim(a, text_vec, image_vec) =
    let t = mm_encode_text(a, text_vec)
    let im = mm_encode_image(a, image_vec)
    mm_cosine(t, im)

