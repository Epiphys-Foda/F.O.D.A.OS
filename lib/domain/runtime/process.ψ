let PROC_IPC_PIPE      = 1
let PROC_IPC_MSGQUEUE  = 2
let PROC_IPC_SHAREDMEM = 3
let PROC_IPC_SEMAPHORE = 4

let PROC_SIG_TERM = 1
let PROC_SIG_INT  = 2
let PROC_SIG_KILL = 3
let PROC_SIG_HUP  = 4
let PROC_SIG_USR1 = 5
let PROC_SIG_USR2 = 6

let PROC_ACT_TERM  = 1
let PROC_ACT_IGN   = 2
let PROC_ACT_BLOCK = 3

let PROC_DEFAULT_RR_QUANTUM = 8
let PROC_DEFAULT_STACK     = 65536
let PROC_DEFAULT_PRIORITY  = 16
let PROC_MAX_CHILDREN      = 256
let PROC_MAX_SIGNALS       = 32
