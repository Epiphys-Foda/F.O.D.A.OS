let pr_create(r, name, priority, parent_pid, mem_base, mem_size) =
    let table = pr_table(r)
    let pid = pt_alloc_pid(table)
    let result = 0
    if pid != 0
        let p = proc_new(pid, name, priority, parent_pid, mem_base, mem_size, pr_tick(r))
        pt_add(table, p)
        ps_transition(table, pid, PROC_STATE_READY)
        let sched = pr_sched(r)
        sched_enqueue(sched, pid)
        if parent_pid != 0
            let pp = pt_get(table, parent_pid)
            if pp != 0
                proc_add_child(pp, pid)
                let procs = pt_procs(table)
                procs[parent_pid] = pp
                pt_set_procs(table, procs)
        result = pid
    result

let pr_destroy(r, pid, code) =
    let table = pr_table(r)
    let exitmgr = pr_exitmgr(r)
    exitmgr_exit(exitmgr, table, pid, code)
    r

let pr_step(r) =
    let tick = pr_tick(r) + 1
    pr_set_tick(r, tick)
    let sched = pr_sched(r)
    let table = pr_table(r)
    sched_tick(sched, table)
    let cur = sched_current(sched)
    if cur != 0
        let sigmgr = pr_sigmgr(r)
        sigmgr_dispatch(sigmgr, table, cur)
    let exitmgr = pr_exitmgr(r)
    exitmgr_reap_all(exitmgr, table)
    r

