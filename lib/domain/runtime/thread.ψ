let ws_register(w, tid) =
    let deques = ws_deques(w)
    deques[tid] = [[], [], []]
    ws_set_deques(w, deques)
    let stats = ws_stats(w)
    stats[tid] = 0
    ws_set_stats(w, stats)
    w

let ws_push(w, tid, task) =
    let deques = ws_deques(w)
    let dq = deques[tid]
    if dq != 0
        let local = dq[0]
        local.push(task)
        dq[0] = local
        deques[tid] = dq
        ws_set_deques(w, deques)
    w

let ws_pop(w, tid) =
    let deques = ws_deques(w)
    let dq = deques[tid]
    let result = 0
    if dq != 0
        let local = dq[0]
        if len(local) > 0
            result = local[len(local) - 1]
            let out = []
            let i = 0
            let n = len(local) - 1
            for i < n
                out.push(local[i])
                i = i + 1
            dq[0] = out
            deques[tid] = dq
            ws_set_deques(w, deques)
    result

let ws_steal(w, thief_tid, victim_tid) =
    let deques = ws_deques(w)
    let dq = deques[victim_tid]
    let result = 0
    if dq != 0
        let steal = dq[2]
        if len(steal) > 0
            result = steal[0]
            let out = []
            let i = 1
            let n = len(steal)
            for i < n
                out.push(steal[i])
                i = i + 1
            dq[2] = out
            deques[victim_tid] = dq
            ws_set_deques(w, deques)
            let stats = ws_stats(w)
            let cnt = stats[victim_tid]
            if cnt == 0
                cnt = 0
            stats[victim_tid] = cnt + 1
            ws_set_stats(w, stats)
            let owners = ws_owners(w)
            owners[thief_tid] = victim_tid
            ws_set_owners(w, owners)
    result

let ws_find_victim(w, except_tid) =
    let deques = ws_deques(w)
    let keys = keys_of(deques)
    let result = 0
    let i = 0
    let n = len(keys)
    for i < n
        let k = keys[i]
        if k != except_tid
            let dq = deques[k]
            if dq != 0
                let steal = dq[2]
                if len(steal) > 0
                    result = k
                    i = n
                else
                    i = i + 1
            else
                i = i + 1
        else
            i = i + 1
    result

