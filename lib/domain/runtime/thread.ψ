let sync_mutex_create(m) =
    let id = sync_next_id(m)
    sync_set_next_id(m, id + 1)
    let mutexes = sync_mutexes(m)
    mutexes[id] = [0, 0, []]
    sync_set_mutexes(m, mutexes)
    id

let sync_mutex_lock(m, id, tid) =
    let mutexes = sync_mutexes(m)
    let mtx = mutexes[id]
    let result = 1
    if mtx != 0
        let locked = mtx[0]
        if locked == 0
            mtx[0] = 1
            mtx[1] = tid
            mutexes[id] = mtx
            sync_set_mutexes(m, mutexes)
            result = 1
        else
            let wq = mtx[2]
            wq.push(tid)
            mtx[2] = wq
            mutexes[id] = mtx
            sync_set_mutexes(m, mutexes)
            result = 0
    result

let sync_mutex_unlock(m, id, tid) =
    let mutexes = sync_mutexes(m)
    let mtx = mutexes[id]
    let result = 0
    if mtx != 0
        if mtx[1] == tid
            let wq = mtx[2]
            if len(wq) > 0
                let next_tid = wq[0]
                let out = []
                let i = 1
                let n = len(wq)
                for i < n
                    out.push(wq[i])
                    i = i + 1
                mtx[2] = out
                mtx[1] = next_tid
                mtx[0] = 1
                result = next_tid
            else
                mtx[0] = 0
                mtx[1] = 0
                result = 0
            mutexes[id] = mtx
            sync_set_mutexes(m, mutexes)
    result

let sync_sem_create(m, initial) =
    let id = sync_next_id(m)
    sync_set_next_id(m, id + 1)
    let sems = sync_sems(m)
    sems[id] = [initial, []]
    sync_set_sems(m, sems)
    id

let sync_sem_wait(m, id, tid) =
    let sems = sync_sems(m)
    let sem = sems[id]
    let result = 1
    if sem != 0
        let cnt = sem[0]
        if cnt > 0
            sem[0] = cnt - 1
            sems[id] = sem
            sync_set_sems(m, sems)
            result = 1
        else
            let wq = sem[1]
            wq.push(tid)
            sem[1] = wq
            sems[id] = sem
            sync_set_sems(m, sems)
            result = 0
    result

let sync_sem_post(m, id) =
    let sems = sync_sems(m)
    let sem = sems[id]
    let result = 0
    if sem != 0
        let wq = sem[1]
        if len(wq) > 0
            let woken = wq[0]
            let out = []
            let i = 1
            let n = len(wq)
            for i < n
                out.push(wq[i])
                i = i + 1
            sem[1] = out
            result = woken
        else
            sem[0] = sem[0] + 1
            result = 0
        sems[id] = sem
        sync_set_sems(m, sems)
    result

let sync_cond_create(m, mutex_id) =
