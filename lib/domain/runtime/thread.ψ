let sync_rwlock_create(m) =
    let id = sync_next_id(m)
    sync_set_next_id(m, id + 1)
    let rwlocks = sync_rwlocks(m)
    rwlocks[id] = [0, 0, [], []]
    sync_set_rwlocks(m, rwlocks)
    id

let sync_rwlock_rlock(m, id, tid) =
    let rwlocks = sync_rwlocks(m)
    let lock = rwlocks[id]
    let result = 1
    if lock != 0
        let writer = lock[1]
        let write_wait = lock[2]
        if writer == 0
            if len(write_wait) == 0
                lock[0] = lock[0] + 1
                rwlocks[id] = lock
                sync_set_rwlocks(m, rwlocks)
                result = 1
            else
                let rw = lock[3]
                rw.push(tid)
                lock[3] = rw
                rwlocks[id] = lock
                sync_set_rwlocks(m, rwlocks)
                result = 0
        else
            let rw = lock[3]
            rw.push(tid)
            lock[3] = rw
            rwlocks[id] = lock
            sync_set_rwlocks(m, rwlocks)
            result = 0
    result

let sync_rwlock_wlock(m, id, tid) =
    let rwlocks = sync_rwlocks(m)
    let lock = rwlocks[id]
    let result = 1
    if lock != 0
        let readers = lock[0]
        let writer = lock[1]
        if readers == 0
            if writer == 0
                lock[1] = tid
                rwlocks[id] = lock
                sync_set_rwlocks(m, rwlocks)
                result = 1
            else
                let ww = lock[2]
                ww.push(tid)
                lock[2] = ww
                rwlocks[id] = lock
                sync_set_rwlocks(m, rwlocks)
                result = 0
        else
            let ww = lock[2]
            ww.push(tid)
            lock[2] = ww
            rwlocks[id] = lock
            sync_set_rwlocks(m, rwlocks)
            result = 0
    result

let sync_rwlock_unlock(m, id, tid) =
    let rwlocks = sync_rwlocks(m)
    let lock = rwlocks[id]
    let result = 0
    if lock != 0
        if lock[1] == tid
            lock[1] = 0
            let ww = lock[2]
            if len(ww) > 0
                let next_tid = ww[0]
                let out = []
                let i = 1
                let n = len(ww)
                for i < n
                    out.push(ww[i])
                    i = i + 1
                lock[2] = out
                lock[1] = next_tid
                result = next_tid
            else
                let rw = lock[3]
                result = len(rw)
                lock[0] = len(rw)
                lock[3] = []
            rwlocks[id] = lock
            sync_set_rwlocks(m, rwlocks)
        else
            lock[0] = lock[0] - 1
            if lock[0] == 0
                let ww = lock[2]
                if len(ww) > 0
                    let next_tid = ww[0]
                    let out = []
                    let i = 1
                    let n = len(ww)
                    for i < n
                        out.push(ww[i])
                        i = i + 1
                    lock[2] = out
                    lock[1] = next_tid
                    result = next_tid
            rwlocks[id] = lock
            sync_set_rwlocks(m, rwlocks)
    result

