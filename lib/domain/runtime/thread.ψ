    if th != 0
        let pid = th_pid(th)
        let by_pid = tt_by_pid(t)
        let list = by_pid[pid]
        if list != 0
            let out = []
            let i = 0
            let n = len(list)
            for i < n
                if list[i] != tid
                    out.push(list[i])
                i = i + 1
            by_pid[pid] = out
            tt_set_by_pid(t, by_pid)
        threads[tid] = 0
        tt_set_threads(t, threads)
        tt_set_count(t, tt_count(t) - 1)
    t

