let th_can_transition(from, to_) =
    let ok = 0
    if from == TH_STATE_NEW
        if to_ == TH_STATE_READY
            ok = 1
        else
            0
    if from == TH_STATE_READY
        if to_ == TH_STATE_RUNNING
            ok = 1
        else
            0
        if to_ == TH_STATE_DEAD
            ok = 1
        else
            0
    if from == TH_STATE_RUNNING
        if to_ == TH_STATE_READY
            ok = 1
        else
            0
        if to_ == TH_STATE_BLOCKED
            ok = 1
        else
            0
        if to_ == TH_STATE_DEAD
            ok = 1
        else
            0
    if from == TH_STATE_BLOCKED
        if to_ == TH_STATE_READY
            ok = 1
        else
            0
        if to_ == TH_STATE_DEAD
            ok = 1
    ok

