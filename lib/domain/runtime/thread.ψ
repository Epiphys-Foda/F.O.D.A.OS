let tp_submit(p, task_id, fn_ref, args, priority) =
    let active = tp_active(p)
    let max_w = tp_max_workers(p)
    let result = 1
    if active < max_w
        let tasks = tp_tasks(p)
        tasks.push({task_id: task_id, fref: fn_ref, args: args, priority: priority})
        tp_set_tasks(p, tasks)
        tp_set_active(p, active + 1)
        result = 1
    else
        let policy = tp_reject(p)
        if policy == TH_REJECT_ABORT
            result = 0
        else
            0
        if policy == TH_REJECT_CALLER_RUNS
            let tasks = tp_tasks(p)
            tasks.push({task_id: task_id, fref: fn_ref, args: args, priority: priority})
            tp_set_tasks(p, tasks)
            result = 1
        else
            0
        if policy == TH_REJECT_DISCARD
            result = 0
    result

let tp_pick_task(p) =
    let tasks = tp_tasks(p)
    let n = len(tasks)
    let result = 0
    if n > 0
        let best_i = 0
        let best_prio = 0
        let i = 0
        for i < n
            let t = tasks[i]
            let prio = t["priority"]
            if i == 0
                best_i = 0
                best_prio = prio
            else
                0
            if prio < best_prio
                best_i = i
                best_prio = prio
            i = i + 1
        result = tasks[best_i]
        let out = []
        let j = 0
        for j < n
            if j != best_i
                out.push(tasks[j])
            j = j + 1
        tp_set_tasks(p, out)
    result

let tp_done(p, tid) =
    tp_set_active(p, tp_active(p) - 1)
    tp_set_completed(p, tp_completed(p) + 1)
    p

let fut_new() =
    [TH_FUTURE_PENDING, 0, 0, []]

let fut_state(f) = f[0]
let fut_value(f) = f[1]
let fut_error(f) = f[2]
let fut_callbacks(f) = f[3]

let fut_set_state(f, s) =
    f[0] = s
    f

let fut_set_value(f, v) =
    f[1] = v
    f

let fut_set_error(f, e) =
    f[2] = e
    f

let fut_set_callbacks(f, c) =
    f[3] = c
    f

let fut_then(f, fn_ref) =
    let state = fut_state(f)
    if state == TH_FUTURE_RESOLVED
        let new_f = fut_new()
        fut_set_state(new_f, TH_FUTURE_RESOLVED)
        let chained = fn_ref
        fut_set_value(new_f, fut_value(f))
        new_f
    else
        0
    if state == TH_FUTURE_REJECTED
        let new_f = fut_new()
        fut_set_state(new_f, TH_FUTURE_REJECTED)
        fut_set_error(new_f, fut_error(f))
        new_f
    else
        let cbs = fut_callbacks(f)
        cbs.push(fn_ref)
        fut_set_callbacks(f, cbs)
        f

let fut_resolve(f, value) =
    let state = fut_state(f)
    if state == TH_FUTURE_PENDING
        fut_set_value(f, value)
        fut_set_state(f, TH_FUTURE_RESOLVED)
    f

let fut_reject(f, error) =
    let state = fut_state(f)
    if state == TH_FUTURE_PENDING
        fut_set_error(f, error)
        fut_set_state(f, TH_FUTURE_REJECTED)
    f

let fut_await(f) =
    fut_state(f)

