let chan_send(c, tid, item) =
    let result = 1
    if chan_closed(c) != 0
        result = 0
    else
        let q = chan_queue(c)
        let type_v = chan_type(c)
        let can_send = 0
        if type_v == TH_CHAN_UNBOUNDED
            can_send = 1
        else
            let cap = chan_cap(c)
            if len(q) < cap
                can_send = 1
        if can_send != 0
            q.push(item)
            chan_set_queue(c, q)
            let r = chan_receivers(c)
            if len(r) > 0
                let woken = r[0]
                let out = []
                let i = 1
                let n = len(r)
                for i < n
                    out.push(r[i])
                    i = i + 1
                chan_set_receivers(c, out)
                result = 2
            else
                0
            let s = chan_senders(c)
            s.push(tid)
            chan_set_senders(c, s)
            result = 0
    result

let chan_recv(c, tid) =
    let result = [0, 0]
    let q = chan_queue(c)
    if len(q) > 0
        let item = q[0]
        let out = []
        let i = 1
        let n = len(q)
        for i < n
            out.push(q[i])
            i = i + 1
        chan_set_queue(c, out)
        let s = chan_senders(c)
        if len(s) > 0
            let woken = s[0]
            let out2 = []
            let j = 1
            let m = len(s)
            for j < m
                out2.push(s[j])
                j = j + 1
            chan_set_senders(c, out2)
        result = [1, item]
    else
        if chan_closed(c) != 0
            result = [-1, 0]
        else
            let r = chan_receivers(c)
            r.push(tid)
            chan_set_receivers(c, r)
            result = [0, 0]
    result

let chan_close(c) =
    chan_set_closed(c, 1)
    c

let ws_new() =
