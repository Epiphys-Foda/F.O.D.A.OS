    let pe_in = arr_new_n(n)
    let pe_out = arr_new_n(n)
    field_to_pe(ops_type, ops_data, n, pe_op, pe_in, pe_out)
    let field_r = field_execute(ops_type, ops_data, n)
    let pe_r = pe_execute(pe_op, pe_in, n)
