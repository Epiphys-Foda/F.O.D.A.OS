let qqbc_verify() =
    let n = 5
    let ops_type = arr_new_n(n)
    ops_type[0] = 0
    ops_type[1] = 5
    ops_type[2] = 4
    ops_type[3] = 0
    ops_type[4] = 1
    let ops_data = arr_new_n(n)
    ops_data[0] = 42
