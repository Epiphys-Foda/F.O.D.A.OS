let compute_delta(table_rows, last_seq, filter_fn) =
    let delta = []
    let i = 0
    let n = len(table_rows)
    for i < n
        let row = table_rows[i]
        let seq = row[4]
        if seq > last_seq
            if filter_fn == 0
                delta.push(row)
            else
                let pass = 0
                pass = 1
                if pass == 1
                    delta.push(row)
        i = i + 1
    delta

let wasm_exec_op(opcode, args, memory) =
    let result = 0
    if opcode == 106
        result = (args[0] + args[1]) % 65537
    else
        0
    if opcode == 108
        result = (args[0] * args[1]) % 65537
    else
        0
    if opcode == 107
        let d = args[0] - args[1]
        if d < 0
            d = d + 65537
        result = d % 65537
    else
        0
    if opcode == 115
        result = args[0] ^ args[1]
    else
        0
    if opcode == 27
        if args[2] != 0
            result = args[0]
        else
            result = args[1]
    else
        0
    if opcode == 40
        let addr = args[0]
        result = memory[addr]
    else
        0
    if opcode == 41
        let addr = args[0]
        let val = args[1]
        memory[addr] = val
        result = 0
    else
        result = 0
    result

let wasm_exec_reducer(module, reducer, args, memory, tx) =
    let gas_used = 0
    let gas_limit = mod_gas_limit(module)
    let stack = []
    let result = 0
    let body = reducer[2]
    let i = 0
    let n = len(body)
    let aborted = 0
    for i < n
        let instr = body[i]
        let opcode = instr[0]
        let cost = opcode_gas(opcode)
        gas_used = gas_used + cost
        if gas_used > gas_limit
            aborted = 1
            i = n
        else
            let op_args = instr[1]
            let exec_result = wasm_exec_op(opcode, op_args, memory)
            stack.push(exec_result)
        i = i + 1
    if aborted == 1
        tx_abort(tx)
        0
    else
        tx[5] = gas_used
        if len(stack) > 0
            result = stack[len(stack) - 1]
        else
            result = 0
        tx_commit(tx)
        result

let sandbox_call(sandbox, module_name, reducer_name, args) =
    let modules = sb_modules(sandbox)
    let module = modules[module_name]
    if module == 0
        [-1, "module_not_found"]
    else
        let reducer = module_get_reducer(module, reducer_name)
        if reducer == 0
            [-1, "reducer_not_found"]
        else
            let tx = tx_begin(sandbox, module_name, reducer_name, args)
            let memory = mod_memory(module)
            let result = wasm_exec_reducer(module, reducer, args, memory, tx)
            module[6] = module[6] + 1
            [tx_status(tx), result]

let sandbox_load_module(sandbox, module) =
    let name = mod_name(module)
    let modules = sb_modules(sandbox)
    modules[name] = module
    let loaded = sb_loaded(sandbox)
    loaded.push(name)
    sandbox[0] = modules
    sandbox[1] = loaded
    sandbox

let sandbox_unload_module(sandbox, name) =
    let modules = sb_modules(sandbox)
    modules[name] = 0
    sandbox[0] = modules
    sandbox

