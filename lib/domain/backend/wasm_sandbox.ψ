let check_mem_quota(m, additional) =
    let used = mod_mem_used(m)
    let limit = mod_gas_limit(m)
    if used + additional > limit
        0
    else
        1

let mod_use_mem(m, amount) =
    m[7] = m[7] + amount
    m

let tx_begin(sandbox, module_name, reducer_name, args) =
    let tx_id = sb_tx_count(sandbox)
    sandbox[5] = tx_id + 1
    let tx = [tx_id, module_name, reducer_name, args, [], 0, 0]
    tx

let tx_id(tx) = tx[0]
let tx_module(tx) = tx[1]
let tx_reducer(tx) = tx[2]
let tx_args(tx) = tx[3]
let tx_undo(tx) = tx[4]
let tx_gas(tx) = tx[5]
let tx_status(tx) = tx[6]

let tx_record_undo(tx, table, key, old_value) =
    let undo = tx_undo(tx)
    undo.push(["set", table, key, old_value])
    tx[4] = undo
    tx

let tx_record_undo_push(tx, table) =
    let undo = tx_undo(tx)
    undo.push(["pop", table, 0, 0])
    tx[4] = undo
    tx

let tx_commit(tx) =
    tx[6] = 1
    tx

let tx_abort(tx) =
    tx[6] = 2
    tx

let tx_rollback(tx, tables_map) =
    let undo = tx_undo(tx)
    let i = len(undo) - 1
    for i >= 0
        let op = undo[i]
        let kind = op[0]
        let table = op[1]
        let key = op[2]
        let old = op[3]
        let tbl = tables_map[table]
        if tbl != 0
            if kind == "set"
                tbl[key] = old
            else
                0
            if kind == "pop"
                tbl.pop()
        i = i - 1
    tx[6] = 2
    tx

let subscriber_new(client_id, table_name, filter_fn) =
    [client_id, table_name, filter_fn, 0]

let sub_client(s) = s[0]
let sub_table(s) = s[1]
let sub_filter(s) = s[2]
