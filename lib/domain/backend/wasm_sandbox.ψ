let module_new(name, gas_limit) =
    [name, {}, [], [], [], gas_limit, 0, 0]

let mod_name(m) = m[0]
let mod_memory(m) = m[1]
let mod_tables(m) = m[2]
let mod_reducers(m) = m[3]
let mod_subscribers(m) = m[4]
let mod_gas_limit(m) = m[5]
let mod_call_count(m) = m[6]
let mod_mem_used(m) = m[7]

let module_add_reducer(m, name, params, body_ref, table_access) =
    let reducers = mod_reducers(m)
    reducers.push([name, params, body_ref, table_access])
    m[3] = reducers
    m

let module_get_reducer(m, name) =
    let reducers = mod_reducers(m)
    let i = 0
    let n = len(reducers)
    let found = 0
    for i < n
        if reducers[i][0] == name
            found = reducers[i]
        i = i + 1
    found

let check_table_access(reducer, table_name, mode) =
    let access = reducer[3]
    let perm = access[table_name]
    if perm == 0
        0
    else
        0
    if perm == "readwrite"
        1
    else
        0
    if perm == mode
        1
    else
        0

