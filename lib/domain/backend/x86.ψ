let X86_RAX = 0
let X86_RBX = 1
let X86_RCX = 2
let X86_RDX = 3
let X86_RSI = 4
let X86_RDI = 5
let X86_RBP = 6
let X86_RSP = 7
let X86_R8 = 8
let X86_R9 = 9
let X86_R10 = 10
let X86_R11 = 11
let X86_R12 = 12
let X86_R13 = 13
let X86_R14 = 14
let X86_R15 = 15
let X86_MOV = 1
let X86_ADD = 2
let X86_SUB = 3
let X86_MUL = 4
let X86_PUSH = 6
let X86_POP = 7
let X86_CALL = 8
let X86_RET = 9
let X86_JMP = 10
let X86_CMP = 11
let X86_JE = 12
