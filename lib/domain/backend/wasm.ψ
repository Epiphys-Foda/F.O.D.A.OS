let wasm_bytecode(ir) =
    let bytecode = []
    let i = 0
    let n = len(ir)
    for i < n
        bytecode.push(WASM_NOP)
        i = i + 1
    bytecode
let wasm_stack_push(stack, val) =
    stack.push(val)
    stack
let wasm_stack_pop(stack) =
    if len(stack) == 0
        [0, stack]
    let val = stack[stack.len() - 1]
    let new_stack = []
    let i = 0
    for i < len(stack) - 1
        new_stack.push(stack[i])
        i = i + 1
    [val, new_stack]
let field_wasm(data, n, z) =
    let val = 0
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        let diff = (z + 65537 - pole) % 65537
        val = gf_add(val, gf_mul(data[i], gf_inv(diff)))
        i = i + 1
    val

