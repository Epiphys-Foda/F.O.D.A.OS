let wasm_module_create() = [1, [], [], [], []]
let wasm_module_add_function(module, name, params, results, body) =
    let types = module[1]
    types.push([params, results])
    let functions = module[2]
    functions.push(name)
    let code = module[4]
    code.push(body)
    [module[0], types, functions, module[3], code]
let wasm_module_export(module, name, func_idx) =
    let exports = module[3]
    exports.push([name, func_idx])
    [module[0], module[1], module[2], exports, module[4]]
let wasm_vm_execute(module, func_idx, args) =
    let code = module[4]
    if func_idx < len(code)
        let body = code[func_idx]
        (len(args) > 0 ? args[0] : 0)
    else
            0
let wasm_memory_create(n_pages) =
    let mem = []
    let i = 0
    for i < n_pages * 65536
        mem.push(0)
        i = i + 1
    mem
let wasm_memory_load(mem, addr) =
    (addr < len(mem) ? mem[addr] : 0)
let wasm_memory_store(mem, addr, val) =
    if addr < len(mem)
        mem[addr] = val
    mem
