let gpu_fb_clear(fb, color) =
    let pixels = fb[2]
    let i = 0
    let n = pixels.length
    for i < n
        pixels[i] = color
        i = i + 1
let gpu_fb_present(fb) = 1

let field_gpu(data, n, z) =
    let val = 0
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        let diff = (z + 65537 - pole) % 65537
        val = gf_add(val, gf_mul(data[i], gf_inv(diff)))
        i = i + 1
    val

let gpu_verify() =
    let test_data = arr_new_n(3)
    test_data[0] = 100
    test_data[1] = 200
    test_data[2] = 300
    let result = field_gpu(test_data, 3, 500)
    let ok = 0
    (result != 0 ? (ok = 1) : (ok = 0))
    ok
