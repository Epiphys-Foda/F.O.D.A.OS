let P = 65537

let CGRA_N_PE = 64
let CGRA_GRID_W = 8

let PE_SOURCE = 0
let PE_MAC = 1
let PE_ALU = 2
let PE_NTT = 3
let PE_CMP = 4
let PE_LAP = 5

let op_to_pe_type(op_type) =
    if op_type == 0
        PE_SOURCE
    else
        0
    if op_type == 1
        PE_MAC
    else
        0
    if op_type == 2
        PE_ALU
    else
        0
    if op_type == 3
        PE_NTT
    else
        0
    if op_type == 4
        PE_CMP
    else
        0
    if op_type == 5
        PE_LAP
    else
        PE_SOURCE

let pe_create(id) = [id, 0, [], 0]
let pe_set_operation(pe, op) = [pe[0], op, pe[2], pe[3]]
let pe_add_input(pe, input) =
    let inputs = pe[2]
    inputs.push(input)
    [pe[0], pe[1], inputs, pe[3]]

let cgra_create() =
    let pes = []
    let i = 0
    for i < CGRA_N_PE
        pes.push(pe_create(i))
        i = i + 1
    pes

let field_to_cgra(ops_type, ops_data, n, pe_type, pe_data, pe_x, pe_y, fifo_src, fifo_dst) =
    let i = 0
    for i < n
        pe_type[i] = op_to_pe_type(ops_type[i])
        pe_data[i] = ops_data[i]
        pe_x[i] = i % CGRA_GRID_W
        pe_y[i] = i / CGRA_GRID_W
        if i > 0
            fifo_src[i] = i - 1
            fifo_dst[i] = i
        else
            fifo_src[i] = 0
            fifo_dst[i] = 0
        i = i + 1

let cgra_execute(pe_type, pe_data, n) =
    let stack = arr_new_n(n)
    let sp = 0
    let i = 0
    for i < n
        let t = pe_type[i]
        if t == PE_SOURCE
            stack[sp] = pe_data[i]
            sp = sp + 1
        if t == PE_MAC
            if sp >= 2
                let b = stack[sp - 1]
                let a = stack[sp - 2]
                sp = sp - 2
                stack[sp] = (a * b) % P
                sp = sp + 1
        if t == PE_ALU
            if sp >= 2
                let b = stack[sp - 1]
                let a = stack[sp - 2]
                sp = sp - 2
                stack[sp] = (a + b) % P
                sp = sp + 1
        if t == PE_NTT
            if sp >= 1
                stack[sp - 1] = (stack[sp - 1] * 3) % P
        if t == PE_CMP
            if sp >= 1
                let a = stack[sp - 1]
                if a > 32768
                    stack[sp - 1] = 0
        if t == PE_LAP
            if sp >= 1
                stack[sp - 1] = (65535 * stack[sp - 1] + 2) % P
        i = i + 1
    (sp > 0 ? stack[sp - 1] : 0)

