let bit_identical_verify(ops_type, ops_data, n) =
    let field_result = field_execute(ops_type, ops_data, n)
    let pe_type = arr_new_n(n)
    let pe_data = arr_new_n(n)
    let pe_x = arr_new_n(n)
    let pe_y = arr_new_n(n)
    let fifo_src = arr_new_n(n)
    let fifo_dst = arr_new_n(n)
    field_to_cgra(ops_type, ops_data, n, pe_type, pe_data, pe_x, pe_y, fifo_src, fifo_dst)
    let cgra_result = cgra_execute(pe_type, pe_data, n)
    let ok = 0
    if field_result == cgra_result
        ok = 1
    let out = arr_new_n(3)
    out[0] = field_result
    out[1] = cgra_result
    out[2] = ok
    out

let cgra_configure(cgra, config) =
    let i = 0
    let n = len(config)
    for i < n && i < CGRA_N_PE
        cgra[i] = pe_set_operation(cgra[i], config[i])
        i = i + 1
    cgra

let cgra_route(src_pe, dst_pe, data) = [src_pe, dst_pe, data]

let cgra_verify() =
    let all_ok = 1
    let test_idx = 0
    for test_idx < 6
        let nt = 3
        let tt = arr_new_n(nt)
        let td = arr_new_n(nt)
        tt[0] = 0
        tt[1] = 0
        td[0] = test_idx + 1
        td[1] = test_idx + 2
        if test_idx < 2
            tt[2] = 1
        else
            0
        if test_idx < 4
            tt[2] = 2
        else
            tt[2] = 1
        td[2] = 0
        let rt = bit_identical_verify(tt, td, nt)
        if rt[2] == 0
            all_ok = 0
        test_idx = test_idx + 1
    all_ok