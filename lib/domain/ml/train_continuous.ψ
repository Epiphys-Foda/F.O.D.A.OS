import "../../core/stdlib/gf65537.ψ"

let fp_verify() =
    let bits_zero = 0
    let s0 = (bits_zero >> 31) & 1
    let e0 = (bits_zero >> 23) & 255
    let m0 = bits_zero & 8388607
    let pass_zero = 0
    if e0 == 0
        if m0 == 0
            pass_zero = 1

    let bits_one = 1065353216
    let s1 = (bits_one >> 31) & 1
    let e1 = (bits_one >> 23) & 255
    let m1_raw = bits_one & 8388607
    let m1 = m1_raw + 8388608
    let exp1 = e1 - 127 - 23
    let pass_one = 0
    if s1 == 0
        if m1 == 8388608
            pass_one = 1

    pass_zero + pass_one

let bm_verify_geometric() =
    let seq = []
    let i = 0
    for i < 8
        seq.push(gf_pow(2, i))
        i = i + 1

    let C = []
    let B = []
    let j = 0
    for j < 8
        C.push(0)
        B.push(0)
        j = j + 1
    C[0] = 1
    B[0] = 1

    let L = 0
    let b = 1
    let m = 1

    let n = 0
    for n < 8
        let d = seq[n]
        let ii = 1
        for ii <= L
            d = gf_add(d, gf_mul(C[ii], seq[n - ii]))
            ii = ii + 1

        if d != 0
            let coeff = gf_div(d, b)
            let kk = 0
            for kk < 8
                if kk + m < 8
                    C[kk + m] = gf_sub(C[kk + m], gf_mul(coeff, B[kk]))
                kk = kk + 1

            let new_L = n + 1 - L
            if new_L > L
                let jj = 0
                for jj < 8
                    B[jj] = C[jj]
                    jj = jj + 1
                L = new_L
                b = d
                m = 1
            else
                m = m + 1
        else
            m = m + 1
        n = n + 1

    L

let bm_verify_fibonacci() =
    let seq = []
    let a = 1
    let b = 1
    let i = 0
    for i < 10
        seq.push(a)
        let c = gf_add(a, b)
        a = b
        b = c
        i = i + 1

    let C = []
    let B = []
    let j = 0
    for j < 10
        C.push(0)
        B.push(0)
        j = j + 1
    C[0] = 1
    B[0] = 1

    let L = 0
    let b_val = 1
    let m = 1

    let n = 0
    for n < 10
        let d = seq[n]
        let ii = 1
        for ii <= L
            d = gf_add(d, gf_mul(C[ii], seq[n - ii]))
            ii = ii + 1

        if d != 0
            let coeff = gf_div(d, b_val)
            let kk = 0
            for kk < 10
                if kk + m < 10
                    C[kk + m] = gf_sub(C[kk + m], gf_mul(coeff, B[kk]))
                kk = kk + 1

            let new_L = n + 1 - L
            if new_L > L
                let jj = 0
                for jj < 10
                    B[jj] = C[jj]
                    jj = jj + 1
                L = new_L
                b_val = d
                m = 1
            else
                m = m + 1
        else
            m = m + 1
        n = n + 1

    L

let ssm_verify() =
    let z1 = 2
    let r1 = 1
    let z2 = 3
    let r2 = 1
    let h1 = r1
    let h2 = r2
    let u = 1

    let new_h1 = gf_add(gf_mul(z1, h1), gf_mul(r1, u))
    let new_h2 = gf_add(gf_mul(z2, h2), gf_mul(r2, u))
    let output = gf_add(new_h1, new_h2)
    output

let discriminant_verify() =
    let tr_A = gf_add(2, 3)
    let det_A = gf_mul(2, 3)
    let tr_sq = gf_mul(tr_A, tr_A)
    let four_det = gf_mul(4, det_A)
    let delta = gf_sub(tr_sq, four_det)
    let leg = gf_legendre(delta)
    leg

let train_one_step(pole, residue, x, y_target, lr) =
    let diff = gf_sub(x, pole)
    let pred = 0
    if diff != 0
        pred = gf_div(residue, diff)
    let error = gf_sub(pred, y_target)
    let loss = gf_mul(error, error)

    let new_pole = pole
    let new_residue = residue
    if diff != 0
        let inv_diff = gf_inv(diff)
        let inv_diff_sq = gf_mul(inv_diff, inv_diff)
        let grad_r = inv_diff
        let grad_z = gf_neg(gf_mul(residue, inv_diff_sq))
        new_residue = gf_sub(residue, gf_mul(lr, gf_mul(error, grad_r)))
        new_pole = gf_sub(pole, gf_mul(lr, gf_mul(error, grad_z)))

    [new_pole, new_residue, loss]

let train_round(n_epochs, lr) =
    let pole = 2
    let residue = 1

    let total_loss = 0
    let epoch = 0
    for epoch < n_epochs
        let i = 0
        for i < 10
            let x = gf_reduce(i + 1)
            let y = gf_div(100, x)
            let result = train_one_step(pole, residue, x, y, lr)
            pole = result[0]
            residue = result[1]
            total_loss = gf_add(total_loss, result[2])
            i = i + 1
        epoch = epoch + 1

    total_loss

let continuous_train(n_rounds) =
    let best_loss = 65537
    let total_improvement = 0
    let prev_loss = 65537

    let round = 0
    for round < n_rounds
        let lr = gf_div(1, gf_add(10, round))
        let loss = train_round(5, lr)

        if loss < best_loss
            best_loss = loss
        if loss < prev_loss
            total_improvement = gf_add(total_improvement, gf_sub(prev_loss, loss))
        prev_loss = loss

        round = round + 1

    [best_loss, total_improvement]

let main() =
    let fp_score = fp_verify()
    let bm_geo = bm_verify_geometric()
    let bm_fib = bm_verify_fibonacci()
    let ssm_score = ssm_verify()
    let disc_score = discriminant_verify()

    let train_result = continuous_train(10)
    let best_loss = train_result[0]
    let improvement = train_result[1]

    let score = gf_add(gf_add(gf_add(gf_add(gf_add(fp_score, bm_geo), bm_fib), ssm_score), disc_score), improvement)
    score
