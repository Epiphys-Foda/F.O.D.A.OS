import "../../core/stdlib/gf65537.ψ"

let ssm_create(state_dim, input_dim, output_dim) =
    let A = []
    let i = 0
    for i < state_dim
        let row = []
        let j = 0
        for j < state_dim
            if i == j
                row.push(gf_reduce(i + 2))
            else
                row.push(0)
            j = j + 1
        A.push(row)
        i = i + 1

    let B = []
    let i2 = 0
    for i2 < state_dim
        let row2 = []
        let j2 = 0
        for j2 < input_dim
            row2.push(1)
            j2 = j2 + 1
        B.push(row2)
        i2 = i2 + 1

    let C = []
    let i3 = 0
    for i3 < output_dim
        let row3 = []
        let j3 = 0
        for j3 < state_dim
            row3.push(1)
            j3 = j3 + 1
        C.push(row3)
        i3 = i3 + 1

    let D = []
    let i4 = 0
    for i4 < output_dim
        let row4 = []
        let j4 = 0
        for j4 < input_dim
            row4.push(0)
            j4 = j4 + 1
        D.push(row4)
        i4 = i4 + 1

    let state = []
    let i5 = 0
    for i5 < state_dim
        state.push(0)
        i5 = i5 + 1

    [A, B, C, D, state, state_dim, input_dim, output_dim]

let _ssm_matvec(M, v) =
    let rows = len(M)
    let result = []
    let i = 0
    for i < rows
        let row = M[i]
        let acc = 0
        let j = 0
        let cols = len(row)
        for j < cols
            acc = gf_add(acc, gf_mul(row[j], v[j]))
            j = j + 1
        result.push(acc)
        i = i + 1
    result

let ssm_step(ssm, input_vec) =
    let A = ssm[0]
    let B = ssm[1]
    let C = ssm[2]
    let D = ssm[3]
    let state = ssm[4]
    let sd = ssm[5]
    let id = ssm[6]
    let od = ssm[7]

    let Ah = _ssm_matvec(A, state)
    let Bu = _ssm_matvec(B, input_vec)
    let new_state = []
    let i = 0
    for i < sd
        new_state.push(gf_add(Ah[i], Bu[i]))
        i = i + 1

    let Ch = _ssm_matvec(C, new_state)
    let Du = _ssm_matvec(D, input_vec)
    let output = []
    let j = 0
    for j < od
        output.push(gf_add(Ch[j], Du[j]))
        j = j + 1

    let new_ssm = [A, B, C, D, new_state, sd, id, od]
    [output, new_ssm]

let ssm_discriminant(ssm) =
    let A = ssm[0]
    let a11 = A[0][0]
    let a12 = A[0][1]
    let a21 = A[1][0]
    let a22 = A[1][1]
    let tr_A = gf_add(a11, a22)
    let det_A = gf_sub(gf_mul(a11, a22), gf_mul(a12, a21))
    let tr_sq = gf_mul(tr_A, tr_A)
    let four_det = gf_mul(4, det_A)
    gf_sub(tr_sq, four_det)

let infer_memory_mode(ssm) =
    let delta = ssm_discriminant(ssm)
    if delta == 0
        2
    else
        let leg = gf_legendre(delta)
        if leg == 1
            0
        else
            1

let memory_mode_name(mode) = mode

let mamba_selective_param(x, base, sensitivity) =
    let adjusted = gf_add(base, gf_mul(sensitivity, x))
    gf_reduce(adjusted)

let mamba_selective_scan(inputs, A_base, B_base, C_base, sensitivity, state_dim) =
    let n = len(inputs)
    let outputs = []
    let state = []
    let i = 0
    for i < state_dim
        state.push(0)
        i = i + 1

    let t = 0
    for t < n
        let u = inputs[t]
        let A_val = mamba_selective_param(u, A_base, sensitivity)
        let B_val = mamba_selective_param(u, B_base, sensitivity)
        let C_val = mamba_selective_param(u, C_base, sensitivity)

        let new_state = []
        let s = 0
        for s < state_dim
            let prev = state[s]
            let updated = gf_add(gf_mul(A_val, prev), gf_mul(B_val, u))
            new_state.push(updated)
            s = s + 1
        state = new_state

        let y = 0
        let s2 = 0
        for s2 < state_dim
            y = gf_add(y, gf_mul(C_val, state[s2]))
            s2 = s2 + 1
        outputs.push(y)
        t = t + 1

    outputs

let residue_ssm_create(poles, residues, input_dim, output_dim) =
    let n_poles = len(poles)
    let state = []
    let i = 0
    for i < n_poles
        state.push(residues[i])
        i = i + 1
    [poles, residues, state, input_dim, output_dim]

let residue_ssm_step(rssm, input_val) =
    let poles = rssm[0]
    let residues = rssm[1]
    let state = rssm[2]
    let id = rssm[3]
    let od = rssm[4]
    let n_poles = len(poles)

    let new_state = []
    let output = 0
    let k = 0
    for k < n_poles
        let z = poles[k]
        let r = residues[k]
        let h = state[k]
        let new_h = gf_add(gf_mul(z, h), gf_mul(r, input_val))
        new_state.push(new_h)
        output = gf_add(output, new_h)
        k = k + 1

    let new_rssm = [poles, residues, new_state, id, od]
    [output, new_rssm]

let residue_ssm_run(rssm, inputs) =
    let n = len(inputs)
    let outputs = []
    let current = rssm
    let i = 0
    for i < n
        let result = residue_ssm_step(current, inputs[i])
        outputs.push(result[0])
        current = result[1]
        i = i + 1
    [outputs, current]

let residue_ssm_train_step(rssm, input_val, target, lr, t) =
    let step_result = residue_ssm_step(rssm, input_val)
    let output = step_result[0]
    let new_rssm = step_result[1]

    let error = gf_sub(output, target)
    let loss = gf_mul(error, error)

    let poles = new_rssm[0]
    let residues = new_rssm[1]
    let state = new_rssm[2]
    let id = new_rssm[3]
    let od = new_rssm[4]
    let n_poles = len(poles)

    let new_poles = []
    let new_residues = []
    let k = 0
    for k < n_poles
        let z = poles[k]
        let r = residues[k]
        let grad_r = gf_pow(z, t)
        let grad_z = 0
        if t > 0
            grad_z = gf_mul(r, gf_mul(t, gf_pow(z, t - 1)))
        let new_z = gf_sub(z, gf_mul(lr, gf_mul(error, grad_z)))
        let new_r = gf_sub(r, gf_mul(lr, gf_mul(error, grad_r)))
        new_poles.push(new_z)
        new_residues.push(new_r)
        k = k + 1

    let trained_rssm = [new_poles, new_residues, state, id, od]
    [loss, trained_rssm]

let ssm_step_backward(ssm, input_vec) =
    let A = ssm[0]
    let B = ssm[1]
    let C = ssm[2]
    let D = ssm[3]
    let state = ssm[4]
    let sd = ssm[5]
    let id = ssm[6]
    let od = ssm[7]

    let Bu = _ssm_matvec(B, input_vec)
    let temp = []
    let i = 0
    for i < sd
        temp.push(gf_sub(state[i], Bu[i]))
        i = i + 1

    let a11 = A[0][0]
    let a12 = A[0][1]
    let a21 = A[1][0]
    let a22 = A[1][1]
    let det_A = gf_sub(gf_mul(a11, a22), gf_mul(a12, a21))

    let new_state = []
    if det_A != 0
        let inv_det = gf_inv(det_A)
        let inv_a11 = gf_mul(a22, inv_det)
        let inv_a12 = gf_neg(gf_mul(a12, inv_det))
        let inv_a21 = gf_neg(gf_mul(a21, inv_det))
        let inv_a22 = gf_mul(a11, inv_det)
        new_state.push(gf_add(gf_mul(inv_a11, temp[0]), gf_mul(inv_a12, temp[1])))
        new_state.push(gf_add(gf_mul(inv_a21, temp[0]), gf_mul(inv_a22, temp[1])))
    else
        let j = 0
        for j < sd
            new_state.push(state[j])
            j = j + 1

    let Ch = _ssm_matvec(C, new_state)
    let Du = _ssm_matvec(D, input_vec)
    let output = []
    let k = 0
    for k < od
        output.push(gf_add(Ch[k], Du[k]))
        k = k + 1

    let new_ssm = [A, B, C, D, new_state, sd, id, od]
    [output, new_ssm]

let ssm_self_test() =
    let pass = 0

    let ssm = ssm_create(2, 1, 1)
    let result1 = ssm_step(ssm, [5])
    let output1 = result1[0]
    if output1[0] != 0
        pass = pass + 1

    let ssm_hyper = ssm_create(2, 1, 1)
    let mode_h = infer_memory_mode(ssm_hyper)
    if mode_h >= 0
        if mode_h <= 2
            pass = pass + 1

    let poles = [2, 3]
    let residues = [1, 1]
    let rssm = residue_ssm_create(poles, residues, 1, 1)
    let r_result = residue_ssm_step(rssm, 1)
    let r_output = r_result[0]
    if r_output != 0
        pass = pass + 1

    let ssm4 = ssm_create(2, 1, 1)
    let fwd = ssm_step(ssm4, [3])
    let new_ssm = fwd[1]
    let bwd = ssm_step_backward(new_ssm, [3])
    let restored_state = bwd[1][4]
    let orig_state = ssm4[4]
    let ok = 1
    let i = 0
    for i < 2
        if restored_state[i] != orig_state[i]
            ok = 0
        i = i + 1
    pass = pass + ok

    pass
