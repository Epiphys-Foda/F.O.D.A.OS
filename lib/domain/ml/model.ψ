let QTYPE_INT4  = 0
let QTYPE_INT8  = 1
let QTYPE_INT16 = 2
let QTYPE_F32   = 3

let qtype_name(q) =
    if q == 0
        "INT4"
    else
        0
    if q == 1
        "INT8"
    else
        0
    if q == 2
        "INT16"
    else
        "F32"

let qtensor_new(data, scale, zero, qtype, shape) =
    [data, scale, zero, qtype, shape]

let qt_data(t) = t[0]
let qt_scale(t) = t[1]
let qt_zero(t) = t[2]
let qt_qtype(t) = t[3]
let qt_shape(t) = t[4]

let qt_ndim(t) = len(qt_shape(t))

let qt_numel(t) =
    let s = qt_shape(t)
    let n = 1
    let i = 0
    let k = len(s)
    for i < k
        n = n * s[i]
        i = i + 1
    n

let qt_dequant_value(t, idx) =
    let q = qt_data(t)[idx]
    let s = qt_scale(t)
    let z = qt_zero(t)
    (q - z) * s

let LAYER_EMBED    = 0
let LAYER_ATTN     = 1
let LAYER_MLP      = 2
let LAYER_NORM     = 3
let LAYER_RESIDUAL = 4
let LAYER_OUTPUT   = 5

let layer_new(kind, params, qtype, name) =
    [kind, params, qtype, name]

let ly_type(l) = l[0]
let ly_params(l) = l[1]
let ly_qtype(l) = l[2]
let ly_name(l) = l[3]

let layer_embed(vocab, dim, qt_w) =
    layer_new(LAYER_EMBED, [vocab, dim, qt_w], QTYPE_INT4, "embed")

let embed_forward(l, token_ids) =
    let p = ly_params(l)
    let qt = p[2]
    let dim = p[1]
    let data = qt_data(qt)
    let scale = qt_scale(qt)
    let zero = qt_zero(qt)
    let seq = len(token_ids)
    let out = []
    let i = 0
    for i < seq
        let tok = token_ids[i]
        let row_start = tok * dim
        let j = 0
        for j < dim
            let q = data[row_start + j]
            out.push(q - zero)
            j = j + 1
        i = i + 1
    [out, [seq, dim], scale]

let layer_mlp(dim, hidden, qt_w1, qt_w2, qt_b1, qt_b2) =
    layer_new(LAYER_MLP, [dim, hidden, qt_w1, qt_w2, qt_b1, qt_b2], QTYPE_INT4, "mlp")

let mlp_forward(l, x) =
    let p = ly_params(l)
    let dim = p[0]
    let hidden = p[1]
    let w1 = qt_data(p[2])
    let w2 = qt_data(p[3])
    let b1 = qt_data(p[4])
    let b2 = qt_data(p[5])
    let seq = len(x) / dim
    let out = []
    let i = 0
    for i < seq
        let j = 0
        for j < hidden
            let acc = b1[j]
            let k = 0
            for k < dim
                acc = acc + x[i * dim + k] * w1[j * dim + k]
                k = k + 1
            if acc < 0
                acc = 0
            out.push(acc)
            j = j + 1
        i = i + 1
    let final_out = []
    i = 0
    for i < seq
        let j = 0
        for j < dim
            let acc = b2[j]
            let k = 0
            for k < hidden
                acc = acc + out[i * hidden + k] * w2[j * hidden + k]
                k = k + 1
            final_out.push(acc)
            j = j + 1
        i = i + 1
    final_out

let layer_norm(dim, qt_g, qt_b) =
    layer_new(LAYER_NORM, [dim, qt_g, qt_b], QTYPE_F32, "norm")

let norm_forward(l, x) =
    let p = ly_params(l)
    let dim = p[0]
    let g = qt_data(p[1])
    let b = qt_data(p[2])
    let seq = len(x) / dim
    let out = []
    let i = 0
    for i < seq
        let sum = 0
        let j = 0
        for j < dim
            sum = sum + x[i * dim + j]
            j = j + 1
        let mean = sum / dim
        let var_sum = 0
        j = 0
        for j < dim
            let d = x[i * dim + j] - mean
            var_sum = var_sum + d * d
            j = j + 1
        let variance = var_sum / dim
        let inv_std = 1024
        if variance > 0
            inv_std = norm_inv_sqrt(variance)
        j = 0
        for j < dim
            let normalized = (x[i * dim + j] - mean) * inv_std / 1024
            out.push(normalized * g[j] / 1024 + b[j])
            j = j + 1
        i = i + 1
    out

let norm_inv_sqrt(v) =
    if v <= 0
        1024
    else
        let x = 1024
        let i = 0
        for i < 4
            let x2 = x * x / 1024
            let correction = 3 * 1024 - v * x2 / 1024
            x = x * correction / 2 / 1024
            if x <= 0
                x = 1
                i = 4
            i = i + 1
        x

let layer_residual() =
    layer_new(LAYER_RESIDUAL, [], QTYPE_INT4, "residual")

let residual_forward(l, x, skip) =
    let n = len(x)
    let out = []
    let i = 0
    for i < n
        out.push(x[i] + skip[i])
        i = i + 1
    out

let model_new(config) =
    [[], config, "foda-v1"]

let m_layers(m) = m[0]
let m_config(m) = m[1]
let m_version(m) = m[2]

let cfg_vocab(c) = c[0]
let cfg_dim(c) = c[1]
let cfg_hidden(c) = c[2]
let cfg_n_layers(c) = c[3]
let cfg_n_heads(c) = c[4]
let cfg_max_seq(c) = c[5]
let cfg_qtype_main(c) = c[6]
let cfg_qtype_attn(c) = c[7]

let model_add_layer(m, layer) =
    let ls = m_layers(m)
    ls.push(layer)
    m[0] = ls
    m

let model_build(config) =
    let m = model_new(config)
    let vocab = cfg_vocab(config)
    let dim = cfg_dim(config)
    let hidden = cfg_hidden(config)
    let n_layers = cfg_n_layers(config)
    let embed_w = qtensor_new([], 128, 8, QTYPE_INT4, [vocab, dim])
    let embed = layer_embed(vocab, dim, embed_w)
    m = model_add_layer(m, embed)
    let i = 0
    for i < n_layers
        let w1 = qtensor_new([], 128, 8, QTYPE_INT4, [dim, hidden])
        let w2 = qtensor_new([], 128, 8, QTYPE_INT4, [hidden, dim])
        let b1 = qtensor_new([], 128, 8, QTYPE_INT4, [hidden])
        let b2 = qtensor_new([], 128, 8, QTYPE_INT4, [dim])
        let mlp = layer_mlp(dim, hidden, w1, w2, b1, b2)
        m = model_add_layer(m, mlp)
        let g = qtensor_new([], 1024, 0, QTYPE_F32, [dim])
        let b = qtensor_new([], 1024, 0, QTYPE_F32, [dim])
        let norm = layer_norm(dim, g, b)
        m = model_add_layer(m, norm)
        let resid = layer_residual()
        m = model_add_layer(m, resid)
        i = i + 1
    m

let FODA_MAGIC = "FODA"
let FODA_VERSION = 1

let foda_header(config) =
    [FODA_MAGIC, FODA_VERSION, config, []]

let foda_pack_weights(layers) =
    let blob = []
    let meta = []
    let offset = 0
    let i = 0
    let n = len(layers)
    for i < n
        let l = layers[i]
        let p = ly_params(l)
        let j = 0
        let k = len(p)
        for j < k
            if len(p[j]) == 5
                let qt = p[j]
                let data = qt_data(qt)
                let di = 0
                let dn = len(data)
                for di < dn
                    blob.push(data[di])
                    di = di + 1
                meta.push([i, j, offset, dn, qt_qtype(qt), qt_scale(qt), qt_zero(qt), qt_shape(qt)])
                offset = offset + dn
            j = j + 1
        i = i + 1
    [blob, meta, offset]

let foda_save(m) =
    let config = m_config(m)
    let header = foda_header(config)
    let packed = foda_pack_weights(m_layers(m))
    header[3] = packed[1]
    [header, packed[0], packed[2]]

let model_param_count(m) =
    let total = 0
    let ls = m_layers(m)
    let i = 0
    let n = len(ls)
    for i < n
        let p = ly_params(ls[i])
        let j = 0
        let k = len(p)
        for j < k
            if len(p[j]) == 5
                let qt = p[j]
                total = total + qt_numel(qt)
            j = j + 1
        i = i + 1
    total

let model_size_bytes(m) =
    let params = model_param_count(m)
    let bytes = 0
    let ls = m_layers(m)
    let i = 0
    let n = len(ls)
    for i < n
        let l = ls[i]
        if ly_qtype(l) == QTYPE_INT4
            bytes = bytes + params / 2
        else
            0
        if ly_qtype(l) == QTYPE_INT8
            bytes = bytes + params
        else
            0
        if ly_qtype(l) == QTYPE_INT16
            bytes = bytes + params * 2
        else
            bytes = bytes + params * 4
        i = i + 1
    bytes

let model_summary(m) =
    let config = m_config(m)
    let params = model_param_count(m)
    let size = model_size_bytes(m)
    [
        "version", m_version(m),
        "vocab", cfg_vocab(config),
        "dim", cfg_dim(config),
        "hidden", cfg_hidden(config),
        "n_layers", cfg_n_layers(config),
        "n_heads", cfg_n_heads(config),
        "max_seq", cfg_max_seq(config),
        "params", params,
        "size_bytes", size,
        "qtype_main", qtype_name(cfg_qtype_main(config)),
        "qtype_attn", qtype_name(cfg_qtype_attn(config))
    ]
