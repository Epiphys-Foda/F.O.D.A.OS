import "model.ψ"
let HEBB_LR_DEFAULT = 64
let HEBB_DECAY = 65520
let HEBB_CLAMP_MAX = 127
let HEBB_CLAMP_MIN = -128

let hebbian_carve(pre, post, w, lr, lr_scale) =
    let delta = pre * post
    delta = delta * lr / lr_scale
    let new_w = w + delta
    new_w = new_w * HEBB_DECAY / 65536
    if new_w > HEBB_CLAMP_MAX
        new_w = HEBB_CLAMP_MAX
    if new_w < HEBB_CLAMP_MIN
        new_w = HEBB_CLAMP_MIN
    new_w

let anti_hebbian_carve(pre, post, w, lr, lr_scale) =
    let delta = 0 - (pre * post)
    delta = delta * lr / lr_scale
    let new_w = w + delta
    new_w = new_w * HEBB_DECAY / 65536
    if new_w > HEBB_CLAMP_MAX
        new_w = HEBB_CLAMP_MAX
    if new_w < HEBB_CLAMP_MIN
        new_w = HEBB_CLAMP_MIN
    new_w

let oja_carve(pre, post, w, lr, lr_scale) =
    let term1 = pre * post
    let term2 = post * post * w / 128
    let delta = (term1 - term2) * lr / lr_scale
    let new_w = w + delta
    if new_w > HEBB_CLAMP_MAX
        new_w = HEBB_CLAMP_MAX
    if new_w < HEBB_CLAMP_MIN
        new_w = HEBB_CLAMP_MIN
    new_w

let CI_DIM = 16

let ci_mv_new() =
    let v = []
    let i = 0
    for i < CI_DIM
        v.push(0)
        i = i + 1
    v

let ci_mv_set(mv, idx, val) =
    mv[idx] = val
    mv

let ci_mv_get(mv, idx) = mv[idx]

let ci_wedge(a, b) =
    let r = ci_mv_new()
    let i = 0
    for i < 4
        let ai = a[i + 1]
        if ai != 0
            let j = i + 1
            for j < 4
                let bj = b[j + 1]
                if bj != 0
                    let biv_idx = 4 + ci_biv_index(i, j)
                    r[biv_idx] = r[biv_idx] + ai * bj
                j = j + 1
        i = i + 1
    r[0] = a[0] * b[0]
    r

let ci_biv_index(i, j) =
    if i == 0
        if j == 1
            0
        else
            0
        if j == 2
            1
        else
            2
    else
        0
    if i == 1
        if j == 2
            3
        else
            4
    else
        5

let ci_inner_product(a, b) =
    let s = 0
    let i = 0
    for i < CI_DIM
        s = s + a[i] * b[i]
        i = i + 1
    s

let ci_encode_tokens(tokens, embed_dim) =
    let mv = ci_mv_new()
    let n = len(tokens)
    let i = 0
    for i < n
        let t = tokens[i]
        let e0 = t % 256
        let e1 = (t / 256) % 256
        let e2 = (t / 65536) % 256
        let e3 = (t / 16777216) % 256
        let weight = 256 - (i * 256 / n)
        mv[1] = mv[1] + e0 * weight / 256
        mv[2] = mv[2] + e1 * weight / 256
        mv[3] = mv[3] + e2 * weight / 256
        mv[4] = mv[4] + e3 * weight / 256
        i = i + 1
    mv

let trainer_new(model, gpu_device) =
    [model, "oja", [], {}, gpu_device, [HEBB_LR_DEFAULT, 256, 0]]

let tr_model(t) = t[0]
let tr_optimizer(t) = t[1]
let tr_ci_store(t) = t[2]
let tr_symbols(t) = t[3]
let tr_gpu(t) = t[4]
let tr_config(t) = t[5]

let tr_set_optimizer(t, opt) =
    t[1] = opt
    t

let tr_add_symbol(t, sym) =
    let s = tr_symbols(t)
    s[sym] = 1
    t[3] = s
    t

let tr_is_symbol(t, token_id) =
    let s = tr_symbols(t)
    if s[token_id] == 1
        1
    else
        0

let tr_train_step(t, tokens, activations, lr, lr_scale) =
    let model = tr_model(t)
    let layers = m_layers(model)
    let symbols = tr_symbols(t)
    let updated = 0
    let i = 0
    let n = len(tokens)
    for i < n
        let tok = tokens[i]
        if symbols[tok] != 1
            let act = activations[i]
            let li = 0
            let nl = len(layers)
            for li < nl
                let l = layers[li]
                if ly_type(l) == 2
                    let p = ly_params(l)
                    let w1 = qt_data(p[2])
                    let dim = p[0]
                    let hidden = p[1]
                    let j = 0
                    for j < hidden
                        let k = 0
                        for k < dim
                            let pre = act[k]
                            let post = act[dim + j]
                            let old_w = w1[j * dim + k]
                            let new_w = oja_carve(pre, post, old_w, lr, lr_scale)
                            w1[j * dim + k] = new_w
                            updated = updated + 1
                            k = k + 1
                        j = j + 1
                li = li + 1
        i = i + 1
    let ci = tr_ci_store(t)
    let mv = ci_encode_tokens(tokens, 16)
    ci.push(mv)
    t[2] = ci
    [t, updated]

let tr_train_epoch(t, batches, lr, lr_scale) =
    let updated_total = 0
    let i = 0
    let n = len(batches)
    for i < n
        let batch = batches[i]
        let tokens = batch[0]
        let acts = batch[1]
        let result = tr_train_step(t, tokens, acts, lr, lr_scale)
        t = result[0]
        updated_total = updated_total + result[1]
        i = i + 1
    [t, updated_total]

let tr_train(t, dataset, epochs, lr, lr_scale) =
    let total_updates = 0
    let e = 0
    for e < epochs
        let result = tr_train_epoch(t, dataset, lr, lr_scale)
        t = result[0]
        total_updates = total_updates + result[1]
        e = e + 1
    [t, total_updates]

let qat_carve_weight(w_int8, grad_int32, lr, lr_scale) =
    let delta = grad_int32 * lr / lr_scale
    let new_w = w_int8 + delta
    if new_w > HEBB_CLAMP_MAX
        new_w = HEBB_CLAMP_MAX
    if new_w < HEBB_CLAMP_MIN
        new_w = HEBB_CLAMP_MIN
    new_w

let qat_int4_carve(w_int4, grad_int8, lr, lr_scale) =
    let delta = grad_int8 * lr / lr_scale / 16
    let new_w = w_int4 + delta
    if new_w > 7
        new_w = 7
    if new_w < -8
        new_w = -8
    new_w

let tr_stats(t) =
    let ci = tr_ci_store(t)
    [
        "optimizer", tr_optimizer(t),
        "ci_vectors", len(ci),
        "symbols", len(tr_symbols(t)),
        "gpu_device", tr_gpu(t),
        "params_total", model_param_count(tr_model(t))
    ]

let ci_retrieve(ci_store, query_mv, top_k) =
    let scores = []
    let i = 0
    let n = len(ci_store)
    for i < n
        let s = ci_inner_product(query_mv, ci_store[i])
        scores.push([s, i])
        i = i + 1
    scores = ci_sort_scores(scores)
    let result = []
    let k = 0
    for k < top_k && k < len(scores)
        result.push(scores[k])
        k = k + 1
    result

let ci_sort_scores(scores) =
    let n = len(scores)
    let i = 0
    for i < n - 1
        let j = 0
        for j < n - 1 - i
            if scores[j][0] < scores[j + 1][0]
                let tmp = scores[j]
                scores[j] = scores[j + 1]
                scores[j + 1] = tmp
            j = j + 1
        i = i + 1
    scores
