import "../../core/stdlib/gf65537.ψ"

let test_fp_zero() =
    let s = 0
    let raw_exp = (0 >> 23) & 255
    let raw_mant = 0 & 8388607
    if raw_exp == 0
        if raw_mant == 0
            s = 1
    s

let test_fp_one() =
    let bits = 0x3F800000
    let s = (bits >> 31) & 1
    let raw_exp = (bits >> 23) & 255
    let raw_mant = bits & 8388607
    let m = raw_mant + 8388608
    let e = raw_exp - 127 - 23
    let ok = 0
    if s == 0
        if m == 8388608
            if e == 0 - 23
                ok = 1
    ok

let test_fp_to_gf_zero() =
    let bits = 0
    let s = (bits >> 31) & 1
    let raw_exp = (bits >> 23) & 255
    let raw_mant = bits & 8388607
    let result = 0
    if raw_exp == 0
        if raw_mant == 0
            result = 1
    result

let test_bm_geometric() =
    let seq = []
    let i = 0
    for i < 8
        seq.push(gf_pow(2, i))
        i = i + 1

    let C = []
    let B = []
    let j = 0
    for j < 8
        C.push(0)
        B.push(0)
        j = j + 1
    C[0] = 1
    B[0] = 1

    let L = 0
    let b = 1
    let m = 1

    let n = 0
    for n < 8
        let d = seq[n]
        let ii = 1
        for ii <= L
            d = gf_add(d, gf_mul(C[ii], seq[n - ii]))
            ii = ii + 1

        if d != 0
            let t = []
            let jj = 0
            for jj < 8
                t.push(C[jj])
                jj = jj + 1

            let coeff = gf_div(d, b)
            let kk = 0
            for kk < 8
                if kk + m < 8
                    C[kk + m] = gf_sub(C[kk + m], gf_mul(coeff, B[kk]))
                kk = kk + 1

            let new_L = n + 1 - L
            if new_L > L
                L = new_L
                B = t
                b = d
                m = 1
            else
                m = m + 1
        else
            m = m + 1
        n = n + 1

    let ok = 0
    if L == 1
        ok = 1
    ok

let test_bm_fibonacci() =
    let seq = []
    let a = 1
    let b = 1
    let i = 0
    for i < 10
        seq.push(a)
        let c = gf_add(a, b)
        a = b
        b = c
        i = i + 1

    let C = []
    let B = []
    let j = 0
    for j < 10
        C.push(0)
        B.push(0)
        j = j + 1
    C[0] = 1
    B[0] = 1

    let L = 0
    let b_val = 1
    let m = 1

    let n = 0
    for n < 10
        let d = seq[n]
        let ii = 1
        for ii <= L
            d = gf_add(d, gf_mul(C[ii], seq[n - ii]))
            ii = ii + 1

        if d != 0
            let t = []
            let jj = 0
            for jj < 10
                t.push(C[jj])
                jj = jj + 1

            let coeff = gf_div(d, b_val)
            let kk = 0
            for kk < 10
                if kk + m < 10
                    C[kk + m] = gf_sub(C[kk + m], gf_mul(coeff, B[kk]))
                kk = kk + 1

            let new_L = n + 1 - L
            if new_L > L
                L = new_L
                B = t
                b_val = d
                m = 1
            else
                m = m + 1
        else
            m = m + 1
        n = n + 1

    let ok = 0
    if L == 2
        ok = 1
    ok

let test_residue_ssm() =
    let poles = [2, 3]
    let residues = [1, 1]
    let state = [1, 1]

    let input_val = 1
    let new_state = []
    let output = 0
    let k = 0
    for k < 2
        let z = poles[k]
        let r = residues[k]
        let h = state[k]
        let new_h = gf_add(gf_mul(z, h), gf_mul(r, input_val))
        new_state.push(new_h)
        output = gf_add(output, new_h)
        k = k + 1

    let ok = 0
    if output != 0
        ok = 1
    ok

let test_discriminant() =
    let a11 = gf_reduce(2)
    let a22 = gf_reduce(3)
    let a12 = 0
    let a21 = 0
    let tr_A = gf_add(a11, a22)
    let det_A = gf_sub(gf_mul(a11, a22), gf_mul(a12, a21))
    let tr_sq = gf_mul(tr_A, tr_A)
    let four_det = gf_mul(4, det_A)
    let delta = gf_sub(tr_sq, four_det)
    let leg = gf_legendre(delta)

    let mode = 0
    if delta == 0
        mode = 2
    else
        if leg == 1
            mode = 0
        else
            mode = 1

    let ok = 0
    if mode >= 0
        if mode <= 2
            ok = 1
    ok

let test_train_epoch() =
    let poles = [2, 3]
    let residues = [1, 1]
    let lr = gf_div(1, 100)

    let data = []
    let targets = []
    let i = 0
    for i < 10
        let x = gf_reduce(i + 1)
        let y = gf_div(100, x)
        data.push(x)
        targets.push(y)
        i = i + 1

    let total_loss = 0
    let t = 0
    for t < 10
        let x = data[t]
        let y_target = targets[t]

        let pred = 0
        let k = 0
        for k < 2
            let diff = gf_sub(x, poles[k])
            if diff != 0
                pred = gf_add(pred, gf_div(residues[k], diff))
            k = k + 1

        let error = gf_sub(pred, y_target)
        let loss = gf_mul(error, error)
        total_loss = gf_add(total_loss, loss)

        let k2 = 0
        for k2 < 2
            let z = poles[k2]
            let r = residues[k2]
            let diff = gf_sub(x, z)
            if diff != 0
                let inv_diff = gf_inv(diff)
                let inv_diff_sq = gf_mul(inv_diff, inv_diff)
                let grad_r = inv_diff
                let grad_z = gf_neg(gf_mul(r, inv_diff_sq))
                residues[k2] = gf_sub(r, gf_mul(lr, gf_mul(error, grad_r)))
                poles[k2] = gf_sub(z, gf_mul(lr, gf_mul(error, grad_z)))
            k2 = k2 + 1
        t = t + 1

    let ok = 0
    if total_loss >= 0
        ok = 1
    ok

let test_continuous_train() =
    let poles = [2, 3]
    let residues = [1, 1]
    let lr = gf_div(1, 100)

    let data = []
    let targets = []
    let i = 0
    for i < 10
        let x = gf_reduce(i + 1)
        let y = gf_pow(2, i)
        data.push(x)
        targets.push(y)
        i = i + 1

    let best_loss = 65537
    let epoch = 0
    for epoch < 20
        let total_loss = 0
        let t = 0
        for t < 10
            let x = data[t]
            let y_target = targets[t]

            let pred = 0
            let k = 0
            for k < 2
                let diff = gf_sub(x, poles[k])
                if diff != 0
                    pred = gf_add(pred, gf_div(residues[k], diff))
                k = k + 1

            let error = gf_sub(pred, y_target)
            let loss = gf_mul(error, error)
            total_loss = gf_add(total_loss, loss)

            let k2 = 0
            for k2 < 2
                let z = poles[k2]
                let r = residues[k2]
                let diff = gf_sub(x, z)
                if diff != 0
                    let inv_diff = gf_inv(diff)
                    let inv_diff_sq = gf_mul(inv_diff, inv_diff)
                    let grad_r = inv_diff
                    let grad_z = gf_neg(gf_mul(r, inv_diff_sq))
                    residues[k2] = gf_sub(r, gf_mul(lr, gf_mul(error, grad_r)))
                    poles[k2] = gf_sub(z, gf_mul(lr, gf_mul(error, grad_z)))
                k2 = k2 + 1
            t = t + 1

        if total_loss < best_loss
            best_loss = total_loss
        epoch = epoch + 1

    best_loss

let run_all_tests() =
    let t1 = test_fp_zero()
    let t2 = test_fp_one()
    let t3 = test_fp_to_gf_zero()
    let t4 = test_bm_geometric()
    let t5 = test_bm_fibonacci()
    let t6 = test_residue_ssm()
    let t7 = test_discriminant()
    let t8 = test_train_epoch()
    let t9 = test_continuous_train()

    let total = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8
    [t1, t2, t3, t4, t5, t6, t7, t8, total, t9]

let main() =
    let results = run_all_tests()
    let total_pass = results[8]
    let train_loss = results[9]
    gf_add(total_pass, gf_reduce(train_loss))
