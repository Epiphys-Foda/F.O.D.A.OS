let test5() =
    let pole = 2
    let residue = 1
    let lr = gf_div(1, 100)
    let x = 5
    let y_target = gf_div(100, 5)

    let diff = gf_sub(x, pole)
    let pred = gf_div(residue, diff)
    let error = gf_sub(pred, y_target)
    let loss = gf_mul(error, error)

    let inv_diff = gf_inv(diff)
    let inv_diff_sq = gf_mul(inv_diff, inv_diff)
    let grad_r = inv_diff
    let grad_z = gf_neg(gf_mul(residue, inv_diff_sq))
    let new_r = gf_sub(residue, gf_mul(lr, gf_mul(error, grad_r)))
    let new_z = gf_sub(pole, gf_mul(lr, gf_mul(error, grad_z)))

    loss

let test6() =
    let tr_A = gf_add(2, 3)
    let det_A = gf_mul(2, 3)
    let tr_sq = gf_mul(tr_A, tr_A)
    let four_det = gf_mul(4, det_A)
    let delta = gf_sub(tr_sq, four_det)
    let leg = gf_legendre(delta)
    leg

