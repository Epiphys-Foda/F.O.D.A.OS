let test3() =
    let seq = [1, 2, 4, 8, 16, 32, 64, 128]
    let seq_gf = []
    let i = 0
    for i < 8
        seq_gf.push(gf_reduce(seq[i]))
        i = i + 1

    let C = [1, 0, 0, 0, 0, 0, 0, 0]
    let B = [1, 0, 0, 0, 0, 0, 0, 0]
    let L = 0
    let b = 1
    let m = 1

    let n = 0
    for n < 8
        let d = seq_gf[n]
        let ii = 1
        for ii <= L
            d = gf_add(d, gf_mul(C[ii], seq_gf[n - ii]))
            ii = ii + 1

        if d != 0
            let coeff = gf_div(d, b)
            let kk = 0
            for kk < 8
                if kk + m < 8
                    C[kk + m] = gf_sub(C[kk + m], gf_mul(coeff, B[kk]))
                kk = kk + 1

            let new_L = n + 1 - L
            if new_L > L
                let j = 0
                for j < 8
                    B[j] = C[j]
                    j = j + 1
                L = new_L
                b = d
                m = 1
            else
                m = m + 1
        else
            m = m + 1
        n = n + 1

    L

