import "ck.ψ"
import "../../core/stdlib/numtheor.ψ"

let bad = [0]

let v5 = 5000
let r250 = 250
let i_led = small_div(v5, r250)
bad[0] = bad[0] + ck(i_led, 19, 21)

let rho = 168
let rwire = small_div(rho * 100, 100)
bad[0] = bad[0] + ck(rwire, 160, 175)

let p10 = small_div(10 * 10 * rwire, 10000)
bad[0] = bad[0] + ck_hi(p10, 3)
let p100 = small_div(100 * 100 * rwire, 10000)
bad[0] = bad[0] + ck(p100, 150, 185)

if p100 < 10 * p10
    bad[0] = bad[0] + 1

let r10 = 10
let series = r10 + r10
let par = small_div(r10 * r10, r10 + r10)
if series != 20
    bad[0] = bad[0] + 1
if par != 5
    bad[0] = bad[0] + 1
bad[0] = bad[0] + ck_hi(par, r10)

let vmains = 220000
let r_wet = 1000
let r_dry = 100000
let i_wet = small_div(vmains, r_wet)
let i_dry = small_div(vmains, r_dry)
bad[0] = bad[0] + ck(i_wet, 200, 240)
bad[0] = bad[0] + ck_hi(i_dry, 5)
if i_dry * 100 > i_wet
    bad[0] = bad[0] + 1

if 1827 < 1825
    bad[0] = bad[0] + 1
if 1827 > 1829
    bad[0] = bad[0] + 1
if 1841 < 1839
    bad[0] = bad[0] + 1
if 1841 > 1843
    bad[0] = bad[0] + 1

arr_get(arr_new_n(1), bad[0])
