import "ck.ψ"
import "../../core/stdlib/numtheor.ψ"

let bad = [0]

let r2 = isqrt(200000000)
bad[0] = bad[0] + ck(r2, 14100, 14200)

let nu_ch = 2900
bad[0] = bad[0] + ck(nu_ch, 2800, 3000)

let nu_cd = small_div(nu_ch * 10000, r2)
bad[0] = bad[0] + ck(nu_cd, 2000, 2150)
bad[0] = bad[0] + ck_hi(nu_cd, nu_ch)

let dzpe = small_div(425 * 19864, 1000)
bad[0] = bad[0] + ck(dzpe, 8000, 9000)

if 8442 < 8000
    bad[0] = bad[0] + 1

let kT = small_div(1381 * 298, 100)
bad[0] = bad[0] + ck(kT, 4000, 4200)

let exp1000 = small_div(dzpe * 1000, kT)
bad[0] = bad[0] + ck(exp1000, 1900, 2200)

let kcl = 7
bad[0] = bad[0] + ck(kcl, 6, 9)

let kmeas = 81
bad[0] = bad[0] + ck(kmeas, 70, 90)

bad[0] = bad[0] + ck_lo(kmeas, kcl)

let above = small_div(kmeas * 10, kcl)
bad[0] = bad[0] + ck(above, 80, 150)

let exp2 = 1549
bad[0] = bad[0] + ck(exp2, 1500, 1600)

let exp03 = small_div(exp2 * 3, 5)
bad[0] = bad[0] + ck(exp03, 900, 1000)
bad[0] = bad[0] + ck_hi(exp03, exp2)

let boost = 500
bad[0] = bad[0] + ck(boost, 100, 1000)

let log10s = 17
bad[0] = bad[0] + ck(log10s, 15, 23)

if 1989 < 1985
    bad[0] = bad[0] + 1
if 1989 > 1992
    bad[0] = bad[0] + 1
if 2002 < 2000
    bad[0] = bad[0] + 1
if 2002 > 2004
    bad[0] = bad[0] + 1

arr_get(arr_new_n(1), bad[0])
