import "ck.ψ"
import "../../core/stdlib/numtheor.ψ"

let bad = [0]

let dg = 305
bad[0] = bad[0] + ck(dg, 295, 315)

let atp_eV = small_div(dg * 1000, 96485)
bad[0] = bad[0] + ck(atp_eV, 2, 4)

let dg_live = 500
bad[0] = bad[0] + ck(dg_live, 450, 600)

let ring = 8
bad[0] = bad[0] + ck(ring, 8, 8)

let h_atp = small_div(ring * 100, 3)
bad[0] = bad[0] + ck(h_atp, 250, 290)

let pmf = 180
bad[0] = bad[0] + ck(pmf, 150, 200)

let h_ev = pmf / 10

let grad = small_div(h_atp * h_ev, 100)
bad[0] = bad[0] + ck(grad, 40, 55)
let demand = 32
bad[0] = bad[0] + ck_lo(grad, demand)

let rev = 100
bad[0] = bad[0] + ck(rev, 50, 400)
let rate = 3 * rev
bad[0] = bad[0] + ck(rate, 150, 1200)

let pool = 50
let flux = 65000
bad[0] = bad[0] + ck(pool, 40, 70)
bad[0] = bad[0] + ck(flux, 50000, 80000)

let recyc = small_div(flux, pool)
bad[0] = bad[0] + ck(recyc, 1000, 2000)

let c8 = 8
let c10 = 10
let c14 = 14
let c15 = 15
bad[0] = bad[0] + ck_lo(c14, c8)
bad[0] = bad[0] + ck_lo(c15, c14)

let eff = 75
bad[0] = bad[0] + ck(eff, 60, 90)
bad[0] = bad[0] + ck_lo(eff, 35)

if 1961 < 1958
    bad[0] = bad[0] + 1
if 1961 > 1964
    bad[0] = bad[0] + 1
if 1994 < 1992
    bad[0] = bad[0] + 1
if 1994 > 1996
    bad[0] = bad[0] + 1

arr_get(arr_new_n(1), bad[0])
