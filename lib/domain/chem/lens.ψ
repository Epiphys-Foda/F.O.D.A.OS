import "ck.ψ"
import "../../core/stdlib/numtheor.ψ"

let bad = [0]

let f = 100
bad[0] = bad[0] + ck(f, 95, 105)

let u1 = 200
let v1 = small_div(u1 * f, u1 - f)
if v1 != u1
    bad[0] = bad[0] + 1

let u2 = 150
let v2 = small_div(u2 * f, u2 - f)
bad[0] = bad[0] + ck(v2, 280, 320)

let u3 = 400
let v3 = small_div(u3 * f, u3 - f)
bad[0] = bad[0] + ck(v3, 125, 140)
bad[0] = bad[0] + ck_hi(v3, u3)

let u4 = 50
let v4m = small_div(u4 * f, f - u4)
let v4 = 0 - v4m
if v4 > 0 - 50
    bad[0] = bad[0] + 1
if v4 < 0 - 400
    bad[0] = bad[0] + 1

if 0 - v4 < u4
    bad[0] = bad[0] + 1

let f_eye = 17
let u_eye = 250
let v_eye = small_div(u_eye * f_eye, u_eye - f_eye)
bad[0] = bad[0] + ck(v_eye, 17, 20)

if 1608 < 1606
    bad[0] = bad[0] + 1
if 1608 > 1610
    bad[0] = bad[0] + 1

arr_get(arr_new_n(1), bad[0])
