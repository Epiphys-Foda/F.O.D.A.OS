import "ck.ψ"
import "../../core/stdlib/numtheor.ψ"

let bad = [0]

let mu_b = 93
bad[0] = bad[0] + ck(mu_b, 90, 96)
let mu_be = 579
bad[0] = bad[0] + ck(mu_be, 570, 585)

let lam = 589
bad[0] = bad[0] + ck(lam, 585, 592)
let q = small_div(lam * lam * mu_be, 1240)
let pm = small_div(q, 10000)
bad[0] = bad[0] + ck(pm, 14, 18)

let split = 2 * pm
let center = split - 2 * pm
bad[0] = bad[0] + ck(center, 0, 0)

let f_l = small_div(930, 66)
bad[0] = bad[0] + ck(f_l, 13, 15)
let f_esr = 2 * f_l
bad[0] = bad[0] + ck(f_esr, 27, 29)

if 1896 < 1894
    bad[0] = bad[0] + 1
if 1896 > 1898
    bad[0] = bad[0] + 1
if 1902 < 1900
    bad[0] = bad[0] + 1
if 1902 > 1904
    bad[0] = bad[0] + 1

arr_get(arr_new_n(1), bad[0])
