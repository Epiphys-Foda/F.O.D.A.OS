import "../../core/stdlib_lang2/gf_base.ψ"

let SUPRA_HOST_POLES = [1, 2, 3, 4, 5, 6, 7, 8]
let SUPRA_HOST_RESIDUES = [408, 350, 280, 520, 400, 320, 360, 380]

let psi_supra_host(host_idx) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(host_idx), gf_norm(SUPRA_HOST_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(SUPRA_HOST_RESIDUES[k], gf_inv(diff)))
        k = k + 1
    val

let SUPRA_ASM_POLES = [1, 2, 3, 4, 5, 6, 7, 8]
let SUPRA_ASM_RESIDUES = [0, 1000, 1800, 2500, 3200, 4000, 4500, 5000]

let psi_supra_assembly(n) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(n), gf_norm(SUPRA_ASM_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(SUPRA_ASM_RESIDUES[k], gf_inv(diff)))
        k = k + 1
    val

let SUPRA_MAC_POLES = [1, 2, 3, 4, 5, 6, 7, 8]
let SUPRA_MAC_RESIDUES = [20000, 10000, 1000, 100, 50, 20, 10, 5]

let psi_supra_machine(state_idx) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(state_idx), gf_norm(SUPRA_MAC_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(SUPRA_MAC_RESIDUES[k], gf_inv(diff)))
        k = k + 1
    val

let SUPRA_KA_BASE = 200
let SUPRA_KA_SCALE1 = 100
let SUPRA_KA_SCALE2 = 1000

let supra_fit_logKa(host_idx, n, state_idx) =
    let h_term = gf_div(psi_supra_host(host_idx), SUPRA_KA_SCALE1)
    let a_term = gf_div(psi_supra_assembly(n), SUPRA_KA_SCALE2)
    let m_term = gf_div(psi_supra_machine(state_idx), SUPRA_KA_SCALE1)
    gf_add(gf_add(gf_add(SUPRA_KA_BASE, h_term), a_term), m_term)

let SUPRA_DG_BASE = 5000
let SUPRA_DG_SCALE = 10

let supra_fit_dG_assembly(n, host_idx) =
    let a_term = psi_supra_assembly(n)
    let h_term = gf_div(psi_supra_host(host_idx), SUPRA_DG_SCALE)
    gf_sub(gf_sub(SUPRA_DG_BASE, a_term), h_term)

let SUPRA_K_BASE = 1000
let SUPRA_K_SCALE1 = 1000
let SUPRA_K_SCALE2 = 100

let supra_fit_log_k(state_idx, host_idx) =
    let m_term = gf_div(psi_supra_machine(state_idx), SUPRA_K_SCALE1)
    let h_term = gf_div(psi_supra_host(host_idx), SUPRA_K_SCALE2)
    gf_add(gf_add(SUPRA_K_BASE, m_term), h_term)

let supra_global_response(host_idx, n, state_idx) =
    let e1 = psi_supra_host(host_idx)
    let e2 = psi_supra_assembly(n)
    let e3 = psi_supra_machine(state_idx)
    gf_add(gf_add(gf_mul(e1, e1), gf_mul(e2, e2)), gf_mul(e3, e3))

