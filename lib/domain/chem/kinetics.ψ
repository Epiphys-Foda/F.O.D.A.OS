let ACTIVATION_T_POLES = [1444, 2166, 6014, 13228, 19846, 21650, 27665, 30066]
let PRE_EXP_FACTORS = [1000000, 50000, 10000, 1000, 100, 50, 10, 1]
let REACTION_LABELS = ["2NO+O2", "C2H4+H2", "H2+Cl2", "sucrose_hyd", "H2+I2", "2HI_decomp", "Haber_NH3", "ethanol_dehyd"]

let psi_activation(T) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(T + ACTIVATION_T_POLES[k]), gf_norm(T))
        let denom = gf_norm(T + ACTIVATION_T_POLES[k])
        if denom != 0
            val = gf_add(val, gf_mul(PRE_EXP_FACTORS[k], gf_inv(denom)))
        k = k + 1
    val

let TRANSITION_S_POLES = [-500, -300, -100, 0, 100, 300, 500, 700]
let TS_ENERGY_WEIGHTS = [10, 30, 50, 70, 60, 40, 20, 10]

let psi_transition_state(dS_x10) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(dS_x10), gf_norm(TRANSITION_S_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(TS_ENERGY_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let CATALYST_DE_POLES = [0, 100, 200, 300, 500, 700, 800, 1000]
let CATALYST_WEIGHTS = [10, 30, 50, 70, 90, 70, 50, 30]

let psi_catalysis(dEa_x10) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(dEa_x10), gf_norm(CATALYST_DE_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(CATALYST_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let kinetics_global_response(T, dS_x10, dEa_x10) =
    let e1 = psi_activation(T)
    let e2 = psi_transition_state(dS_x10)
    let e3 = psi_catalysis(dEa_x10)
    gf_add(gf_add(gf_mul(e1, e1), gf_mul(e2, e2)), gf_mul(e3, e3))

let arrhenius_monotonicity_test(T) =
    let v_low = psi_activation(T - 10)
    let v_high = psi_activation(T + 10)
    (v_high != v_low ? 1 : 0)

