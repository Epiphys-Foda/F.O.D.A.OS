let kmul(a0, b0) =
    let r = 0
    let a = a0
    let b = b0
    for b > 0
        if b % 2 == 1
            r = r + a
        a = a + a
        b = b / 2
    r

let arrhenius_kx1000(A, T, Ea_over_R) =
    if T + Ea_over_R == 0
        0
    else
        kmul(A, kmul(T, 1000) / (T + Ea_over_R))

let ORDER_ZERO = 0
let ORDER_FIRST = 1
let ORDER_SECOND = 2

let conc_zero_order(A0, k, t) =
    let c = A0 - kmul(k, t)
    (c < 0 ? 0 : c)

let conc_first_order_x1000(A0_x1000, k_x1000, t) =
    let denom = 1000 + kmul(k_x1000, t) / 1000
    if denom == 0
        0
    else
        kmul(A0_x1000, 1000) / denom

let conc_second_order_x1000(A0_x1000, k_x1000, t) =
    let denom = 1000 + kmul(kmul(k_x1000, A0_x1000), t) / 1000000
    if denom == 0
        0
    else
        kmul(A0_x1000, 1000) / denom

let half_life_first_order(k_x1000) =
    if k_x1000 == 0
        0
    else
        693000 / k_x1000

let half_life_second_order(k_x1000, A0_x1000) =
    let denom = kmul(k_x1000, A0_x1000) / 1000
    if denom == 0
        0
    else
        1000000 / denom

let catalytic_enhancement(T, Ea_over_R, Ea_cat_over_R) =
    if T + Ea_cat_over_R == 0
        0
    else
        kmul(T + Ea_over_R, 100) / (T + Ea_cat_over_R)

