let multi_path_rate_x1000(T, A_arr, Ea_arr, n) =
    let total = 0
    let i = 0
    for i < n
        let k = kmul(kmul(A_arr[i], T), 1000) / (T + Ea_arr[i])
        total = total + k
        i = i + 1
    total

