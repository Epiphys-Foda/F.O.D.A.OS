import "ck.ψ"
import "../../core/stdlib/numtheor.ψ"

let bad = [0]

let pi_pa = small_div(1000 * 8314 * 300, 1000)
bad[0] = bad[0] + ck(pi_pa, 2450000, 2540000)

let pi_atm = small_div(pi_pa * 10, 101325)
bad[0] = bad[0] + ck(pi_atm, 240, 252)

let saline = small_div(9000, 58)
bad[0] = bad[0] + ck(saline, 150, 160)

let osm = 2 * saline
bad[0] = bad[0] + ck(osm, 290, 320)

let pi_blood = small_div(300 * pi_atm, 1000)
bad[0] = bad[0] + ck(pi_blood, 70, 77)

let pi_sea = small_div(12 * pi_atm * 10, 100)
bad[0] = bad[0] + ck(pi_sea, 270, 310)

bad[0] = bad[0] + ck_lo(pi_sea, pi_blood)

let rbc = 80
bad[0] = bad[0] + ck(rbc, 75, 85)

if 1887 < 1885
    bad[0] = bad[0] + 1
if 1887 > 1889
    bad[0] = bad[0] + 1

arr_get(arr_new_n(1), bad[0])
