let smod_fast(x, m) =
    let cnt = 0
    let s = m
    for s <= x
        cnt = cnt + 1
        s = s + s
    let steps = arr_new_n(cnt)
    let k = 0
    let s2 = m
    for k < cnt
        let kx = k * 1
        steps[kx] = s2
        s2 = s2 + s2
        k = k + 1
    let i = cnt
    let r = x
    for i > 0
        let jx = i - 1
        let st = steps[jx]
        if r >= st
            r = r - st
        i = i - 1
    r

