let spectrum_create(spectype) = [[], 0, spectype]
let peak_create(wavenumber, intensity, assignment) = [wavenumber, intensity, assignment]
let spectrum_add_peak(spectrum, peak) =
    let peaks = spectrum[0]
    peaks.push(peak)
    [peaks, spectrum[1] + 1, spectrum[2]]
let ir_vibrational_frequency(k, mu) =
    gf_sqrt(gf_div(k, mu))
let ir_intensity(dipole_change, concentration) =
    gf_mul(gf_pow(dipole_change, 2), concentration)
let uv_transition_energy(n_initial, n_final) =
    gf_sub(gf_div(1, gf_pow(n_final, 2)), gf_div(1, gf_pow(n_initial, 2)))
let uv_wavelength(transition_energy) =
    gf_div(1, transition_energy)
let nmr_chemical_shift(electron_density, reference) =
    gf_sub(reference, electron_density)
let nmr_coupling_constant(n_bonds, dihedral) =
    let J = gf_div(10, n_bonds)
    if dihedral == 0
        gf_add(J, 5)
    else
        (dihedral == 90 ? 0 : gf_sub(J, 5))
let nmr_multiplicity(n_equivalent_neighbors) =
    n_equivalent_neighbors + 1
let ms_molecular_ion(molecular_weight) = molecular_weight
let ms_fragment(parent_mass, fragment_mass) =
    gf_sub(parent_mass, fragment_mass)
let ms_isotope_pattern(mass, n_carbons) =
    let pattern = []
    let i = 0
    for i <= n_carbons
        pattern.push(gf_div(gf_pow(n_carbons, i), gf_pow(100, i)))
        i = i + 1
    pattern
let spectrum_match(spec1, spec2, tolerance) =
    let peaks1 = spec1[0]
    let peaks2 = spec2[0]
    let matches = 0
    let i = 0
    let n = len(peaks1)
    for i < n
        let j = 0
        let m = len(peaks2)
        for j < m
            let diff = gf_sub(peaks1[i][0], peaks2[j][0])
            if diff < tolerance && diff > gf_neg(tolerance)
                matches = matches + 1
            j = j + 1
        i = i + 1
    matches
let field_spectro(data, n, z) =
    let val = 0
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        let diff = (z + 65537 - pole) % 65537
        val = gf_add(val, gf_mul(data[i], gf_inv(diff)))
        i = i + 1
    val

