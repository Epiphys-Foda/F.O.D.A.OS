let simul(a0, b0) = a0 * b0

let RYDBERG_CM = 109737
let ROT_CONST = 168576

let rydberg_line_cm(z, n1, n2) =
    simul(RYDBERG_CM, simul(z, z)) / simul(n1, n1) - simul(RYDBERG_CM, simul(z, z)) / simul(n2, n2)

let h_lyman_alpha() = rydberg_line_cm(1, 1, 2)
let h_balmer_alpha() = rydberg_line_cm(1, 2, 3)
let h_paschen_alpha() = rydberg_line_cm(1, 3, 4)
let he_plus_lyman_alpha() = rydberg_line_cm(2, 1, 2)

let rotational_b_x10000(mu_x100, r_x100) =
    let step1 = simul(168576, 10000) / simul(r_x100, r_x100)
    simul(step1, 100) / mu_x100
let hcl_rotational_b() = rotational_b_x10000(97, 127)

let rot_line_x10000(b_x10000, j) = simul(simul(2, b_x10000), j + 1)

let vib_isotope_ratio_x10000(m1a, m1b, m2a, m2b) =
    let num = simul(m1a, m1b) * (m2a + m2b)
    let den = simul(m2a, m2b) * (m1a + m1b)
    let q1 = simul(num, 10000) / den
    isqrt(simul(q1, 10000))

let dcl_predicted_from_hcl() = simul(2886, vib_isotope_ratio_x10000(1, 35, 2, 35)) / 10000

let MASS_RATIO_H = 1836
let MASS_RATIO_HE = 7294

let rydberg_reduced_cm(mass_ratio) =
    RYDBERG_CM - RYDBERG_CM / (mass_ratio + 1)

let R_H_CM = 109678

let rydberg_line_reduced_cm(z, mass_ratio, n1, n2) =
    let r_mu = rydberg_reduced_cm(mass_ratio)
    simul(r_mu, simul(z, z)) / simul(n1, n1) - simul(r_mu, simul(z, z)) / simul(n2, n2)

let h_lyman_alpha_reduced() = rydberg_line_reduced_cm(1, MASS_RATIO_H, 1, 2)
let h_balmer_alpha_reduced() = rydberg_line_reduced_cm(1, MASS_RATIO_H, 2, 3)
let h_paschen_alpha_reduced() = rydberg_line_reduced_cm(1, MASS_RATIO_H, 3, 4)
let he_plus_lyman_reduced() = rydberg_line_reduced_cm(2, MASS_RATIO_HE, 1, 2)

let reduced_mass_report() =
    let h_inf = h_lyman_alpha()
    let h_mu = h_lyman_alpha_reduced()
    let h_exp = 82259
    let he_inf = he_plus_lyman_alpha()
    let he_mu = he_plus_lyman_reduced()
    let he_exp = 329188
    let dev_h_inf = (h_inf - h_exp) * 1000 / h_exp
    let dev_h_mu = (h_mu - h_exp) * 1000 / h_exp
    let dev_he_inf = (he_inf - he_exp) * 1000 / he_exp
    let dev_he_mu = (he_mu - he_exp) * 1000 / he_exp
    [[h_inf, h_mu, h_exp, dev_h_inf, dev_h_mu],
     [he_inf, he_mu, he_exp, dev_he_inf, dev_he_mu]]

