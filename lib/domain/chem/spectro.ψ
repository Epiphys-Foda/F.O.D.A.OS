    let ratio = vib_isotope_ratio_x10000(1, 35, 2, 35)
    let t9 = ratio > 7165 && ratio < 7175
    let dcl = dcl_predicted_from_hcl()
    let t10 = dcl > 2050 && dcl < 2090
    let t11 = vib_isotope_ratio_x10000(1, 35, 2, 35) != 10000
    let t12 = isqrt(10000) == 100 && isqrt(20000) == 141
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9 + t10 + t11 + t12
    passed == 12

let spectro_verify_reduced_mass() =
    let t1 = rydberg_reduced_cm(MASS_RATIO_H) == 109678
    let t2 = h_lyman_alpha_reduced() == 82259
    let t3 = h_balmer_alpha_reduced() == 15233
    let t4 = h_paschen_alpha_reduced() == 5332
    let t5 = he_plus_lyman_reduced() == 329166
    let t6 = rydberg_reduced_cm(MASS_RATIO_H) < RYDBERG_CM
    let t7 = rydberg_reduced_cm(MASS_RATIO_HE) > rydberg_reduced_cm(MASS_RATIO_H)
    let r = reduced_mass_report()
    let h_row = r[0]
    let err_inf = h_row[0] - h_row[2]
    let err_mu = h_row[1] - h_row[2]
    if err_inf < 0
        err_inf = 0 - err_inf
    if err_mu < 0
        err_mu = 0 - err_mu
    let t8 = err_mu < err_inf
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8
    passed == 8

