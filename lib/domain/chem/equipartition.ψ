import "ck.ψ"
import "../../core/stdlib/numtheor.ψ"

let bad = [0]

let R = 8
bad[0] = bad[0] + ck(R, 7, 9)

let cv_mono = small_div(3 * R, 2)
bad[0] = bad[0] + ck(cv_mono, 10, 14)

let cv_di = small_div(5 * R, 2)
bad[0] = bad[0] + ck(cv_di, 18, 22)

let cp_di = cv_di + R
if cp_di != 28
    bad[0] = bad[0] + 1

let gam = small_div(cp_di * 10, cv_di)
bad[0] = bad[0] + ck(gam, 13, 15)

let gam_mono = small_div(5 * 100, 3 * 10)
let gam_di = small_div(7 * 100, 5 * 10)
bad[0] = bad[0] + ck_lo(gam_mono, gam_di)

if 1860 < 1858
    bad[0] = bad[0] + 1
if 1860 > 1862
    bad[0] = bad[0] + 1

arr_get(arr_new_n(1), bad[0])
