import "ck.ψ"
import "../../core/stdlib/numtheor.ψ"

let bad = [0]

let rk = 25813
bad[0] = bad[0] + ck(rk, 25800, 25830)

let r2 = small_div(rk, 2)
bad[0] = bad[0] + ck(r2, 12800, 13000)

let r4 = small_div(rk, 4)
bad[0] = bad[0] + ck(r4, 6400, 6500)

let half_check = small_div(r2, 2)
if half_check != r4
    bad[0] = bad[0] + 1

let r3f = rk * 3
bad[0] = bad[0] + ck(r3f, 77000, 78000)

bad[0] = bad[0] + ck_lo(r3f, r2)

let flat = 8
bad[0] = bad[0] + ck_hi(flat, 20)

if 1980 < 1978
    bad[0] = bad[0] + 1
if 1980 > 1982
    bad[0] = bad[0] + 1
if 1982 < 1980
    bad[0] = bad[0] + 1
if 1982 > 1984
    bad[0] = bad[0] + 1

arr_get(arr_new_n(1), bad[0])
