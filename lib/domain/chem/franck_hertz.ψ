import "../../core/stdlib/numtheor.ψ"

let bad = [0]

let dip1 = 49
let dip2 = 98
let dip3 = 147
bad[0] = bad[0] + ck(dip1, 45, 55)
let d2 = dip2 - 2 * dip1
bad[0] = bad[0] + ck(d2, 0, 0)
let d3 = dip3 - 3 * dip1
bad[0] = bad[0] + ck(d3, 0, 0)

let photon = small_div(124000, 254)
bad[0] = bad[0] + ck(photon, 480, 495)

let gap_elec = dip1 * 10
let agree = photon - gap_elec
bad[0] = bad[0] + ck(agree, -10, 10)

let ke_low = 40
bad[0] = bad[0] + ck_hi(ke_low, dip1)

if 1914 < 1912
    bad[0] = bad[0] + 1
if 1914 > 1916
    bad[0] = bad[0] + 1
if 1926 < 1924
    bad[0] = bad[0] + 1
if 1926 > 1928
    bad[0] = bad[0] + 1

