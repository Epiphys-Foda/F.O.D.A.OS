import "ck.ψ"
import "../../core/stdlib/numtheor.ψ"

let bad = [0]

let lam = 500
let L = 200
let d = 100
let dy = small_div(lam * L, d)
bad[0] = bad[0] + ck(dy, 800, 1200)

let d2 = 200
let dy2 = small_div(lam * L, d2)
bad[0] = bad[0] + ck_hi(dy2, dy)

let v_volt = 100
let v_root = isqrt(v_volt * 10000)
let lam_e = small_div(123, v_root / 100)
bad[0] = bad[0] + ck(lam_e, 10, 15)

if 1801 < 1799
    bad[0] = bad[0] + 1
if 1801 > 1803
    bad[0] = bad[0] + 1
if 1927 < 1925
    bad[0] = bad[0] + 1
if 1927 > 1929
    bad[0] = bad[0] + 1

arr_get(arr_new_n(1), bad[0])
