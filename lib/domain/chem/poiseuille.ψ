let eta = 3500
bad[0] = bad[0] + ck(eta, 3000, 4000)
bad[0] = bad[0] + ck_lo(eta, 1000)

let f = 2 * 2 * 2 * 2
if f != 16
    bad[0] = bad[0] + 1
let frac = small_div(100, f)
bad[0] = bad[0] + ck(frac, 5, 8)

let ar = small_div(2500, 5)
bad[0] = bad[0] + ck(ar, 450, 560)

let v_cap = small_div(4000, ar)
bad[0] = bad[0] + ck(v_cap, 6, 12)

let co = 5
bad[0] = bad[0] + ck(co, 4, 7)
bad[0] = bad[0] + ck_hi(v_cap, 4000)

if 1840 < 1838
    bad[0] = bad[0] + 1
if 1840 > 1842
    bad[0] = bad[0] + 1

arr_get(arr_new_n(1), bad[0])
