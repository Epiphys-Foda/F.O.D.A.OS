let bond_length_pm(Za, Zb, order) =
    let ra = cov_radius(Za)
    let rb = cov_radius(Zb)
    let base = ra + rb
    if order <= 1
        base
    else
        base - bimul(7, bimul(order - 1, base)) / 100

let HOMO_BOND_ENERGY = [436, 0, 0, 0, 0, 348, 163, 146, 159, 0, 0, 0, 0, 0, 0, 266, 243]

let homo_bond_energy(Z) = HOMO_BOND_ENERGY[Z - 1]

let PAULING_EN = [220, 0, 0, 0, 0, 255, 304, 344, 398, 0, 0, 0, 0, 0, 0, 258, 316]

let pauling_en_x100(Z) = PAULING_EN[Z - 1]

let bisqrt(n) =
    if n <= 0
        0
    else
        let lo = 0
        let hi = n + 1
        for lo < hi - 1
            let mid = (lo + hi) / 2
            if mid <= n / mid
                lo = mid
            else
                hi = mid
        lo

let bond_energy_hetero(Za, Zb) =
    let da = homo_bond_energy(Za)
    let db = homo_bond_energy(Zb)
    if da <= 0 || db <= 0
        0
    else
        let geo_mean = bisqrt(bimul(da, db))
        let dchi = pauling_en_x100(Za) - pauling_en_x100(Zb)
        if dchi < 0
            dchi = 0 - dchi
        let pauling_term = bimul(bimul(dchi, dchi), 9648) / 1000000
        geo_mean + pauling_term

let hybridization(n_sigma_bonds, n_lone_pairs) =
    let total = n_sigma_bonds + n_lone_pairs
    if total == 2
        1
    else
        if total == 3
            2
        else
            if total == 4
                3
            else
                0

let bond_polarity(el1_electroneg, el2_electroneg) =
    gf_sub(el1_electroneg, el2_electroneg)
let bond_is_polar(el1_electroneg, el2_electroneg) =
    (gf_sub(el1_electroneg, el2_electroneg) != 0 ? 1 : 0)

let field_bond(data, n, z) =
    let val = 0
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        let diff = (z + 65537 - pole) % 65537
        val = gf_add(val, gf_mul(data[i], gf_inv(diff)))
        i = i + 1
    val

