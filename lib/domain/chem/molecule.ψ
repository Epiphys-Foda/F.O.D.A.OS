let psi_atom(atom_z_list, n, z) =
    let val = 0
    let i = 0
    for i < n
        let diff = gf_sub(z, i)
        if diff != 0
            val = gf_add(val, gf_mul(gf_norm(atom_z_list[i]), gf_inv(diff)))
        i = i + 1
    val

let BOND_LENGTH_POLES = [109, 154, 120, 134, 96, 101, 136, 116, 100]
let BOND_ENERGY_RES = [4130, 3460, 8350, 6020, 4590, 3860, 3600, 7450, 4640]
let BOND_LABELS = ["C-H", "C-C", "C≡C", "C=C", "O-H", "N-H", "C-O", "C=O", "C-N"]

let psi_bond(r_x100) =
    let val = 0
    let k = 0
    for k < 9
        let diff = gf_sub(gf_norm(r_x100), gf_norm(BOND_LENGTH_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(BOND_ENERGY_RES[k], gf_inv(diff)))
        k = k + 1
    val

let BOND_ANGLE_POLES = [1045, 1070, 1095, 1200, 1800, 900, 1095, 1800]
let DIPOLE_MOMENTS = [185, 147, 0, 0, 0, 0, 60, 0]
let GEOM_LABELS = ["H₂O", "NH₃", "CH₄", "BF₃", "CO₂", "H₂S", "CH₃Cl", "C₂H₂"]

let psi_geometry(theta_x10) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(theta_x10), gf_norm(BOND_ANGLE_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(DIPOLE_MOMENTS[k], gf_inv(diff)))
        k = k + 1
    val

let molecule_global_response(atom_z_list, n_atoms, r_x100, theta_x10) =
    let e1 = psi_atom(atom_z_list, n_atoms, n_atoms / 2)
    let e2 = psi_bond(r_x100)
    let e3 = psi_geometry(theta_x10)
    gf_add(gf_add(gf_mul(e1, e1), gf_mul(e2, e2)), gf_mul(e3, e3))

let predict_bond_length(bond_label_idx) = BOND_LENGTH_POLES[bond_label_idx]

let predict_bond_angle(mol_label_idx) = BOND_ANGLE_POLES[mol_label_idx]

