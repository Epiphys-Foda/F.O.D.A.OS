let MOL_MAX_ATOMS = 256
let MOL_MAX_BONDS = 512

let mol_create() = [[], [], 0, 0]
let atom_create(id, element, x, y, z) = [id, element, x, y, z, 0]
let atom_set_charge(atom, charge) = [atom[0], atom[1], atom[2], atom[3], atom[4], charge]
let mol_add_atom(mol, atom) =
    let atoms = mol[0]
    atoms.push(atom)
    [atoms, mol[1], mol[2] + 1, mol[3]]
let bond_create(a1, a2, order) = [a1, a2, order, 1]
let mol_add_bond(mol, bond) =
    let bonds = mol[1]
    bonds.push(bond)
    [mol[0], bonds, mol[2], mol[3] + 1]
let mol_molecular_weight(mol, atomic_weights) =
    let atoms = mol[0]
    let total = 0
    let i = 0
    let n = mol[2]
    for i < n
        let el = atoms[i][1]
        total = gf_add(total, atomic_weights[el])
        i = i + 1
    total
let mol_formula(mol) =
    let atoms = mol[0]
    let counts = []
    let i = 0
    for i < 119
        counts.push(0)
        i = i + 1
    i = 0
    let n = mol[2]
    for i < n
        let el = atoms[i][1]
        counts[el] = counts[el] + 1
        i = i + 1
    counts
let mol_adjacency_matrix(mol) =
    let n = mol[2]
    let matrix = []
    let i = 0
    for i < n * n
        matrix.push(0)
        i = i + 1
    let bonds = mol[1]
    i = 0
    let m = mol[3]
    for i < m
        let bond = bonds[i]
        matrix[bond[0] * n + bond[1]] = bond[2]
        matrix[bond[1] * n + bond[0]] = bond[2]
        i = i + 1
    matrix
let mol_distance(atom1, atom2) =
    let dx = gf_sub(atom1[2], atom2[2])
    let dy = gf_sub(atom1[3], atom2[3])
    let dz = gf_sub(atom1[4], atom2[4])
    gf_add(gf_add(gf_mul(dx, dx), gf_mul(dy, dy)), gf_mul(dz, dz))
let field_mol(data, n, z) =
    let val = 0
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        let diff = (z + 65537 - pole) % 65537
        val = gf_add(val, gf_mul(data[i], gf_inv(diff)))
        i = i + 1
    val

