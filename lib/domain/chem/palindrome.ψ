let COMP = [0, 3, 4, 1, 2]
let bad = [0]
let seqEcoRI = [
    4, 3, 3, 1, 1, 2,
]
let errEcoRI = [0]
let i = 0
for i < 3
    let jx = i * 1
    let mir = 6 - 1 - jx
    let mc = COMP[seqEcoRI[mir]]
    let d = seqEcoRI[jx] - mc
    let ad =
        if d < 0
            0 - d
        else
            d
    if ad > 0
        errEcoRI[0] = errEcoRI[0] + 1
    i = i + 1
let dEcoRI = errEcoRI[0] - 0
bad[0] = bad[0] + dEcoRI * dEcoRI
let seqBamHI = [
    4, 4, 3, 1, 2, 2,
]
let errBamHI = [0]
let i = 0
for i < 3
    let jx = i * 1
    let mir = 6 - 1 - jx
    let mc = COMP[seqBamHI[mir]]
    let d = seqBamHI[jx] - mc
    let ad =
        if d < 0
            0 - d
        else
            d
    if ad > 0
        errBamHI[0] = errBamHI[0] + 1
    i = i + 1
let dBamHI = errBamHI[0] - 0
bad[0] = bad[0] + dBamHI * dBamHI
let seqctrl = [
    4, 3, 1, 1, 3, 2,
]
let errctrl = [0]
let i = 0
for i < 3
    let jx = i * 1
    let mir = 6 - 1 - jx
    let mc = COMP[seqctrl[mir]]
    let d = seqctrl[jx] - mc
    let ad =
        if d < 0
            0 - d
        else
            d
    if ad > 0
        errctrl[0] = errctrl[0] + 1
    i = i + 1
let dctrl = errctrl[0] - 2
bad[0] = bad[0] + dctrl * dctrl

arr_get(arr_new_n(1), bad[0])
