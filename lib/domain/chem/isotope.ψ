import "../../core/stdlib_lang2/gf_base.ψ"

let MAGIC_NUMBERS = [2, 8, 20, 28, 50, 82, 126]
let SHELL_CAPACITIES = [6, 12, 8, 22, 32, 44]

let nuclear_field(A) =
    let val = 0
    let k = 0
    for k < 6
        let d = A - MAGIC_NUMBERS[k]
        if d == 0
            val = gf_add(val, SHELL_CAPACITIES[k])
        else
            val = gf_add(val, gf_mul(SHELL_CAPACITIES[k], gf_inv(d)))
        k = k + 1
    val

let nuclear_shell_gap(A) =
    let val = 0
    let k = 0
    for k < 6
        let d = A - MAGIC_NUMBERS[k]
        if d != 0
            let dd = gf_mul(d, d)
            val = gf_sub(val, gf_mul(SHELL_CAPACITIES[k], gf_inv(dd)))
        k = k + 1
    val

let ho_shell_capacity(N) = (N + 1) * (N + 2) / 2 * 2 / 2 * 2
let ho_cumulative(N_max) =
    let total = 0
    let N = 0
    for N <= N_max
        total = total + (N + 1) * (N + 2)
        N = N + 1
    total

