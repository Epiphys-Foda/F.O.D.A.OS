let STABLE_A_TABLE = [1, 4, 7, 9, 11, 12, 14, 16, 20, 23, 24, 27, 28, 31, 32, 35, 40, 39, 40, 52, 56, 63, 64, 79, 107, 112, 132, 138, 184, 195, 197, 208, 209, 238]

