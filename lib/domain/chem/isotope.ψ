let nimul(a0, b0) =
    let r = 0
    let a = a0
    let b = b0
    for b > 0
        if b % 2 == 1
            r = r + a
        a = a + a
        b = b / 2
    r

let icbrt1000(n) =
    if n <= 0
        0
    else
        let target = nimul(n, 1000000)
        let lo = 0
        let hi = 100000
        for lo < hi
            let mid = (lo + hi + 1) / 2
            let q1 = target / mid
            let q2 = q1 / mid
            if mid <= q2
                lo = mid
            else
                hi = mid - 1
        lo

let weizsaecker_b_x100(A, Z) =
    let c100 = icbrt1000(A)
    if c100 == 0
        c100 = 100
    let vol = nimul(1575, A)
    let surf_term = nimul(nimul(1771, A), 100) / (nimul(c100, c100) / 100)
    let coul = nimul(nimul(71, nimul(Z, Z - 1)), 100) / c100
    let asym = nimul(2370, nimul(A - 2 * Z, A - 2 * Z)) / A
    vol - surf_term - coul - asym

let BINDING_ANCHOR_HE4_X100 = 707
let BINDING_ANCHOR_FE56_X100 = 879

let shell_gap_average() =
    let total = 0
    let k = 0
    for k < 6
        total = total + SHELL_CAPACITIES[k]
        k = k + 1
    total / 6

let shell_gap_at(k) = SHELL_CAPACITIES[k]

let enhancement_x100(k) =
    nimul(SHELL_CAPACITIES[k], 100) / shell_gap_average()

let relative_enhancement_126_vs_82_x1000() =
    nimul(SHELL_CAPACITIES[5], 1000) / SHELL_CAPACITIES[4]

let shell_correction_ratio_x100() =
    let g126 = nimul(SHELL_CAPACITIES[5], SHELL_CAPACITIES[5])
    let g82 = nimul(SHELL_CAPACITIES[4], SHELL_CAPACITIES[4])
    nimul(g126, 100) / g82

let z126_prediction_report() =
    let gap = shell_gap_at(5)
    let enh = enhancement_x100(5)
    let rel = relative_enhancement_126_vs_82_x1000()
    let corr = shell_correction_ratio_x100()
    [gap, enh, rel, corr]

let stability_profile_126() =
    let result = []
    let Z = 120
    for Z <= 132
        let field_val = nuclear_field(Z)
        let gap_val = nuclear_shell_gap(Z)
        result.push([Z, field_val, gap_val])
        Z = Z + 1
    result

let known_magic_enhancement_pb208() =
    let z_gap = shell_gap_at(4)
    let n_gap = shell_gap_at(5)
    nimul(nimul(z_gap, n_gap), 10000) / nimul(shell_gap_average(), shell_gap_average())

