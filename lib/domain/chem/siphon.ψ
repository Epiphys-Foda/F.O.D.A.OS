bad[0] = bad[0] + ck_hi(crest, crest_max)

let v_exit = isqrt(2 * 981 * 200 / 100)
bad[0] = bad[0] + ck(v_exit, 55, 70)

let area = 3
let q = area * v_exit
bad[0] = bad[0] + ck(q, 150, 220)

let surf = 100
let exit_h = 0
bad[0] = bad[0] + ck_hi(exit_h, surf)

let up = 1
let dn = 6
bad[0] = bad[0] + ck_lo(dn, up)

if 100 < 1
    bad[0] = bad[0] + 1

arr_get(arr_new_n(1), bad[0])
