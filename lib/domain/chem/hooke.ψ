import "ck.ψ"
import "../../core/stdlib/numtheor.ψ"

let bad = [0]

let k = 100
let x = 10
let F = small_div(k * x, 100)
if F != 10
    bad[0] = bad[0] + 1

let pe = small_div(k * x * x, 200)
bad[0] = bad[0] + ck(pe, 40, 60)

let t2 = small_div(4 * 987 * 100, k * 100)
let t = isqrt(t2 * 100)
bad[0] = bad[0] + ck(t, 50, 75)

let k_ser = small_div(k, 2)
if k_ser != 50
    bad[0] = bad[0] + 1

let k_par = 2 * k
if k_par != 200
    bad[0] = bad[0] + 1

bad[0] = bad[0] + ck_lo(k_par, k_ser)

let k_bond = 440
bad[0] = bad[0] + ck(k_bond, 400, 480)

if 1676 < 1674
    bad[0] = bad[0] + 1
if 1676 > 1678
    bad[0] = bad[0] + 1

arr_get(arr_new_n(1), bad[0])
