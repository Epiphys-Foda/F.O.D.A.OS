import "ck.ψ"
import "../../core/stdlib/numtheor.ψ"

let bad = [0]

let f_far = 18
bad[0] = bad[0] + ck(f_far, 17, 19)

let f_near = small_div(250 * 18, 268)
bad[0] = bad[0] + ck(f_near, 15, 17)

bad[0] = bad[0] + ck_hi(f_near, f_far)

let p_far = small_div(1000, f_far)
let p_near = small_div(1000, f_near)
bad[0] = bad[0] + ck(p_far, 53, 58)

let f_child = small_div(100 * 18, 118)
let p_child = small_div(1000, f_child)
bad[0] = bad[0] + ck(p_child, 60, 70)

let amp_c = p_child - p_far
bad[0] = bad[0] + ck(amp_c, 8, 15)

let amp_45 = 4
bad[0] = bad[0] + ck_hi(amp_45, amp_c)

let glasses = 2
bad[0] = bad[0] + ck(glasses, 1, 4)

if 1855 < 1853
    bad[0] = bad[0] + 1
if 1855 > 1857
    bad[0] = bad[0] + 1

arr_get(arr_new_n(1), bad[0])
