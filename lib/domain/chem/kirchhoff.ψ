import "ck.ψ"
import "../../core/stdlib/numtheor.ψ"

let bad = [0]

let v_bat = 12
let r1 = 4
let r2 = 8
let r_series = r1 + r2
if r_series != 12
    bad[0] = bad[0] + 1

let i_series = small_div(v_bat, r_series)
if i_series != 1
    bad[0] = bad[0] + 1

let v1 = i_series * r1
let v2 = i_series * r2
if v1 + v2 != v_bat
    bad[0] = bad[0] + 1

let r_eq = small_div(r1 * r1, r1 + r1)
if r_eq != 2
    bad[0] = bad[0] + 1

let i_par = small_div(v_bat, r_eq)
let i_br1 = small_div(v_bat, r1)
let i_br2 = small_div(v_bat, r1)
if i_br1 + i_br2 != i_par
    bad[0] = bad[0] + 1

bad[0] = bad[0] + ck_hi(r_eq, r1)

if 1845 < 1843
    bad[0] = bad[0] + 1
if 1845 > 1847
    bad[0] = bad[0] + 1

arr_get(arr_new_n(1), bad[0])
