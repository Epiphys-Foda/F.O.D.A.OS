import "ck.ψ"
import "../../core/stdlib/numtheor.ψ"

let bad = [0]

let rec = 38
bad[0] = bad[0] + ck(rec, 36, 40)

let dlc = 17
bad[0] = bad[0] + ck(dlc, 15, 20)

let slow = 17 * 4 * 100
let dayDev10 = small_div(864000 - slow * 10, 3600)
bad[0] = bad[0] + ck(dayDev10, 219, 224)

let coral = 400
bad[0] = bad[0] + ck(coral, 395, 405)

let yDev = coral * dayDev10
let yMod = 8766 * 10
let yDiff = yDev - yMod
bad[0] = bad[0] + ck_hi(yDiff, 877)
if 0 - 877 > yDiff
    bad[0] = bad[0] + 1

if 400 < 365
    bad[0] = bad[0] + 1

arr_get(arr_new_n(1), bad[0])
