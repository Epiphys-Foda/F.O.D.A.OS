let pen = 522
bad[0] = bad[0] + ck(pen, 480, 560)

let tc = small_div(ceil * 522, 1000)
bad[0] = bad[0] + ck(tc, 85, 115)

bad[0] = bad[0] + ck_hi(tc, ceil)

