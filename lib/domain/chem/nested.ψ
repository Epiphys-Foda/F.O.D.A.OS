let nested_three_layer_invariants(Z) =
    let shell_sum = 2 + 8 + 8 + 18 + 18 + 32 + 32
    let cfg = aufbau_config(Z)
    let fill_sum = 0
    let i = 0
    for i < len(cfg)
        fill_sum = fill_sum + cfg[i]
        i = i + 1
    let d3 = nested_psi3_data(Z)
    let res3 = d3[1]
    let n3 = d3[2]
    let so_sum = 0
    let k = 0
    for k < n3
        so_sum = so_sum + res3[k]
        k = k + 1
    let d2 = nested_psi2_data(Z)
    let n2 = d2[2]
    [shell_sum == 118, fill_sum == Z, so_sum == Z, n3 >= n2]

let nested_fractal_dimension_x1000(Z) =
    let n1 = 7
    let d2 = nested_psi2_data(Z)
    let n2 = d2[2]
    let d3 = nested_psi3_data(Z)
    let n3 = d3[2]
    let log2_n1 = 3 * 1000
    let log2_n2 = 0
    let tmp = n2
    for tmp > 0
        log2_n2 = log2_n2 + 1000
        tmp = tmp / 2
    let log2_n3 = 0
    let tmp3 = n3
    for tmp3 > 0
        log2_n3 = log2_n3 + 1000
        tmp3 = tmp3 / 2
    let r1 = (log2_n2 < 1000 ? 0 : imul(log2_n3, 1000) / log2_n2)
    let r2 = (log2_n1 < 1000 ? 0 : imul(log2_n2, 1000) / log2_n1)
    [r1, r2]

