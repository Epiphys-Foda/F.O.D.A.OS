let nested_rydberg_cm(z_nucleus, n1, n2) =
    imul(NESTED_RYDBERG_CM, imul(z_nucleus, z_nucleus)) / imul(n1, n1) - imul(NESTED_RYDBERG_CM, imul(z_nucleus, z_nucleus)) / imul(n2, n2)

