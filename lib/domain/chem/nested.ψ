let nested_psi1_second_deriv(Z) =
    let sum = 0
    let k = 0
    for k < 7
        let pole = NESTED_SHELL_POLES[k]
        let res = NESTED_SHELL_RESIDUES[k]
        let d = Z - pole
        if d != 0
            let d2 = imul(d, d)
            let d3 = imul(d2, d)
            sum = sum + 2 * res / d3
        k = k + 1
    sum

