    for i < n_orb
        let n_idx = AUFBAU_ORBITALS[i][0] - 1
        shells[n_idx] = shells[n_idx] + fills[i]
        i = i + 1
    let result = []
    let k = 0
    for k < 10
        if shells[k] > 0
            result.push(shells[k])
        k = k + 1
    result

