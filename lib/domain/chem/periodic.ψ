let orbital_capacity(l) = 4 * l + 2

let aufbau_config(Z) =
    let fills = []
    let remaining = Z
    let i = 0
    let n_orb = len(AUFBAU_ORBITALS)
    for i < n_orb
        let cap = orbital_capacity(AUFBAU_ORBITALS[i][1])
        let fill = cap
        if remaining < cap
            fill = remaining
        if remaining <= 0
            fill = 0
        fills.push(fill)
        remaining = remaining - fill
        i = i + 1
    fills

let aufbau_shells(Z) =
    let fills = aufbau_config(Z)
    let shells = []
