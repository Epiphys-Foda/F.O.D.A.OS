let residue_field_psi(Z) =
    let sum = 0
    let k = 0
    for k < 8
        let pole = CHEM_POLES[k]
        let res = CHEM_RESIDUES[k]
        let diff = Z - pole
        if diff == 0
            sum = sum + res * 100
        else
            sum = sum + gf_mul(res, gf_inv(gf_norm(diff)))
        k = k + 1
    sum

let residue_field_norm_sq(Z) = gf_mul(residue_field_psi(Z), residue_field_psi(Z))

let residue_field_deriv(Z) =
    let sum = 0
    let k = 0
    for k < 8
        let pole = CHEM_POLES[k]
        let res = CHEM_RESIDUES[k]
        let diff = Z - pole
        if diff != 0
            let inv_diff = gf_inv(gf_norm(diff))
            let term = gf_mul(gf_mul(res, inv_diff), inv_diff)
            sum = sum - term
        k = k + 1
    sum

let pmul_abs(x) =
