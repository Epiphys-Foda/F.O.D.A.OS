import "../../core/stdlib_lang2/gf_base.ψ"

let tmul(a0, b0) =
    let r = 0
    let a = a0
    let b = b0
    for b > 0
        if b % 2 == 1
            r = r + a
        a = a + a
        b = b / 2
    r

let WATER_T_MELT = 273
let WATER_T_BOIL = 373
let WATER_T_CRIT = 647
let WATER_DS_MELT = 22
let WATER_DS_BOIL = 109

let thermo_field(T, poles, residues, n) =
    let val = 0
    let k = 0
    for k < n
        let d = T - poles[k]
        if d == 0
            val = gf_add(val, residues[k])
        else
            val = gf_add(val, gf_mul(residues[k], gf_inv(gf_norm(d))))
        k = k + 1
    val

let WATER_POLES = [273, 373, 647]
let WATER_RESIDUES = [22, 109, 0]

let water_thermo_field(T) = thermo_field(T, WATER_POLES, WATER_RESIDUES, 3)

let water_cp_x100(T) =
    let val = 0
    let k = 0
    for k < 3
        let d = T - WATER_POLES[k]
        if d != 0
            let dd = gf_mul(gf_norm(d), gf_norm(d))
            val = gf_add(val, gf_mul(WATER_RESIDUES[k], gf_inv(dd)))
        k = k + 1
    gf_mod(val, 5000) + 7500

let phase_of(T) =
    if T < 273
        0
    else
        0
    if T < 373
        1
    else
        0
    if T < 647
        2
    else
        3

let phase_name(p) =
    if p == 0
        "Solid"
    else
        0
    if p == 1
        "Liquid"
    else
        0
    if p == 2
        "Gas"
    else
        "Supercritical"

let VAPOR_PRESSURE_T = [273, 283, 293, 303, 313, 323, 333, 343, 353, 363, 373]
let VAPOR_PRESSURE_P = [6, 12, 23, 42, 73, 123, 199, 311, 473, 699, 1013]

let vapor_pressure_x10(T) =
    if T <= 273
        6
    else
        0
    if T >= 373
        1013
    else
        let i = 0
        for i < 10 && VAPOR_PRESSURE_T[i + 1] < T
            i = i + 1
        let t0 = VAPOR_PRESSURE_T[i]
        let t1 = VAPOR_PRESSURE_T[i + 1]
        let p0 = VAPOR_PRESSURE_P[i]
        let p1 = VAPOR_PRESSURE_P[i + 1]
        p0 + tmul(p1 - p0, T - t0) / (t1 - t0)

let mix_entropy_x100(x_x1000) =
    if x_x1000 <= 0 || x_x1000 >= 1000
        0
    else
        tmul(2304, tmul(x_x1000, 1000 - x_x1000)) / 1000000

let ideal_gas_pressure_x100(n, T, V) =
    tmul(tmul(831, n), T) / V

