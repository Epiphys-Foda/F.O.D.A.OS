let VAPOR_POLES_T = [273, 283, 293, 303, 313, 323, 333, 373]
let VAPOR_ENTHALPIES = [2530, 2510, 2490, 2470, 2450, 2420, 2390, 2260]

let psi_vapor(T) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(T), gf_norm(VAPOR_POLES_T[k]))
        if diff != 0
            val = gf_add(val, gf_mul(VAPOR_ENTHALPIES[k], gf_inv(diff)))
        k = k + 1
    val

let MIX_POLES_X = [0, 250, 500, 750, 1000]
let MIX_WEIGHTS = [0, 576, 576, 576, 0]

let psi_mix_entropy(x_x1000) =
    let val = 0
    let k = 0
    for k < 5
        let diff = gf_sub(gf_norm(x_x1000), gf_norm(MIX_POLES_X[k]))
        if diff != 0
            val = gf_add(val, gf_mul(MIX_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let thermo_global_response(T, x_x1000) =
    let e1 = water_thermo_field(T)
    let e2 = psi_vapor(T)
    let e3 = psi_mix_entropy(x_x1000)
    gf_add(gf_add(gf_mul(e1, e1), gf_mul(e2, e2)), gf_mul(e3, e3))

let clausius_clapeyron_test(T) =
    let v_low = psi_vapor(T - 10)
    let v_high = psi_vapor(T + 10)
    (v_high != v_low ? 1 : 0)

let boltzmann_symmetry_test(x_x1000) =
    let v1 = psi_mix_entropy(x_x1000)
    let v2 = psi_mix_entropy(1000 - x_x1000)
    (v1 == v2 ? 1 : 0)

let nested_fractal_thermo_invariants() =
    let e1 = water_thermo_field(300)
    let e2 = psi_vapor(300)
    let e3 = psi_mix_entropy(500)
    let inv1 = 0
    if e1 != 0
        if e2 != 0
            if e3 != 0
                inv1 = 1
    let inv2 = 0
    if VAPOR_POLES_T[0] < VAPOR_POLES_T[1]
        if VAPOR_POLES_T[1] < VAPOR_POLES_T[7]
            inv2 = 1
    let inv3 = 0
    if VAPOR_ENTHALPIES[0] > VAPOR_ENTHALPIES[7]
        inv3 = 1
    let inv4 = boltzmann_symmetry_test(250)
    let inv5 = clausius_clapeyron_test(300)
    [inv1, inv2, inv3, inv4, inv5]

