let PORT_RET_POLES = [50, 75, 100, 125, 150, 175, 200, 225]
let PORT_RET_WEIGHTS = [50, 75, 100, 125, 150, 175, 200, 225]

let psi_port_ret(a_idx) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(a_idx), gf_norm(PORT_RET_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(PORT_RET_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let PORT_VOL_POLES = [50, 100, 150, 200, 250, 300, 350, 400]
let PORT_VOL_WEIGHTS = [25, 50, 75, 100, 125, 150, 175, 200]

let psi_port_vol(a_idx) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(a_idx), gf_norm(PORT_VOL_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(PORT_VOL_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let PORT_COV_POLES = [10, 20, 30, 40, 50, 60, 70, 80]
let PORT_COV_WEIGHTS = [5, 15, 25, 35, 45, 55, 65, 75]

let psi_port_cov(p_idx) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(p_idx), gf_norm(PORT_COV_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(PORT_COV_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let portfolio_global_response(a_idx, p_idx, c_idx) =
    let e1 = psi_port_ret(a_idx)
    let e2 = psi_port_vol(a_idx)
    let e3 = psi_port_cov(p_idx)
    gf_add(gf_add(gf_mul(e1, e1), gf_mul(e2, e2)), gf_mul(e3, e3))

let port_ret_monotonic_test() =
    let v1 = psi_port_ret(50)
    let v2 = psi_port_ret(225)
    (v1 != v2 ? 1 : 0)

let port_vol_monotonic_test() =
    let v1 = psi_port_vol(50)
    let v2 = psi_port_vol(400)
    (v1 != v2 ? 1 : 0)

let port_cov_monotonic_test() =
    let v1 = psi_port_cov(10)
    let v2 = psi_port_cov(80)
    (v1 != v2 ? 1 : 0)

let port_global_nonzero_test() =
    let g = portfolio_global_response(100, 30, 30)
    (g != 0 ? 1 : 0)

let port_efficient_frontier_test() =
    let mu_inc = 0
    if PORT_RET_WEIGHTS[0] < PORT_RET_WEIGHTS[7]
        mu_inc = 1
    let sigma_inc = 0
    if PORT_VOL_WEIGHTS[0] < PORT_VOL_WEIGHTS[7]
        sigma_inc = 1
    if mu_inc == 1
        (sigma_inc == 1 ? 1 : 0)
    else
        0

let port_diversification_test() =
    let v1 = portfolio_global_response(100, 30, 30)
    let v2 = portfolio_global_response(100, 30, 30)
    (v1 == v2 ? 1 : 0)

