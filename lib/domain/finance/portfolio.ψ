        inv3 = 1
    let inv4 = 0
    if PORT_COV_WEIGHTS[0] < PORT_COV_WEIGHTS[7]
        inv4 = 1
    let inv5 = 0
    if portfolio_global_response(100, 30, 30) != 0
        inv5 = 1
    [inv1, inv2, inv3, inv4, inv5]

