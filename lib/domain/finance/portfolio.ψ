let PORT_MAX_ASSETS = 256

let portfolio_create(assets) =
    let n = len(assets)
    let weights = []
    let i = 0
    for i < n
        weights.push(gf_div(1, n))
        i = i + 1
    [weights, assets, n]
let portfolio_return(portfolio) =
    let weights = portfolio[0]
    let assets = portfolio[1]
    let ret = 0
    let i = 0
    let n = portfolio[2]
    for i < n
        ret = gf_add(ret, gf_mul(weights[i], assets[i][1]))
        i = i + 1
    ret
let portfolio_variance(portfolio, cov_matrix) =
    let weights = portfolio[0]
    let n = portfolio[2]
    let variance = 0
    let i = 0
    for i < n
        let j = 0
        for j < n
            variance = gf_add(variance, gf_mul(gf_mul(weights[i], weights[j]), cov_matrix[i * n + j]))
            j = j + 1
        i = i + 1
    variance
let portfolio_volatility(portfolio, cov_matrix) = gf_sqrt(portfolio_variance(portfolio, cov_matrix))
let markowitz_optimize(assets, cov_matrix, target_return) =
    let n = len(assets)
    let weights = []
    let i = 0
    for i < n
        weights.push(gf_div(1, n))
        i = i + 1
    let iteration = 0
    for iteration < 100
        let current_return = 0
        i = 0
        for i < n
            current_return = gf_add(current_return, gf_mul(weights[i], assets[i][1]))
            i = i + 1
        let grad = []
        i = 0
        for i < n
            let g = 0
            let j = 0
            for j < n
                g = gf_add(g, gf_mul(cov_matrix[i * n + j], weights[j]))
                j = j + 1
            grad.push(g)
            i = i + 1
        i = 0
        for i < n
            weights[i] = gf_sub(weights[i], gf_mul(1, grad[i]))
            i = i + 1
        iteration = iteration + 1
    weights
let rebalance(portfolio, target_weights) =
    let n = portfolio[2]
    [target_weights, portfolio[1], n]
let efficient_frontier(assets, cov_matrix, n_points) =
    let frontier = []
    let i = 0
    for i < n_points
        let target = gf_div(i, n_points)
        let weights = markowitz_optimize(assets, cov_matrix, target)
        let port = [weights, assets, len(assets)]
        frontier.push([target, portfolio_volatility(port, cov_matrix)])
        i = i + 1
    frontier
let field_portfolio(data, n, z) =
    let val = 0
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        let diff = (z + 65537 - pole) % 65537
        val = gf_add(val, gf_mul(data[i], gf_inv(diff)))
        i = i + 1
    val

