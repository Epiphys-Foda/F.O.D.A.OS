let normal_cdf(x) =
    let result = gf_div(x, 10)
    result = gf_add(result, gf_div(1, 2))
    result
let d1(S, K, T, r, sigma) =
    let numerator = gf_add(gf_sub(gf_div(S, K), gf_mul(r, T)), gf_div(gf_mul(sigma, sigma), 2))
    gf_div(numerator, gf_mul(sigma, T))
let d2(d1_val, sigma, T) = gf_sub(d1_val, gf_mul(sigma, T))
let bs_call(S, K, T, r, sigma) =
    let d1_val = d1(S, K, T, r, sigma)
    let d2_val = d2(d1_val, sigma, T)
    gf_sub(gf_mul(S, normal_cdf(d1_val)), gf_mul(K, normal_cdf(d2_val)))
let bs_put(S, K, T, r, sigma) =
    let d1_val = d1(S, K, T, r, sigma)
    let d2_val = d2(d1_val, sigma, T)
    gf_sub(gf_mul(K, gf_sub(1, normal_cdf(d2_val))), gf_mul(S, gf_sub(1, normal_cdf(d1_val))))
let option_price(option) =
    if option[0] == OPT_CALL
        bs_call(option[1], option[2], option[3], option[4], option[5])
    else
        bs_put(option[1], option[2], option[3], option[4], option[5])
let greeks_delta(option) =
    let d1_val = d1(option[1], option[2], option[3], option[4], option[5])
    (option[0] == OPT_CALL ? normal_cdf(d1_val) : gf_sub(normal_cdf(d1_val), 1))
let greeks_gamma(option) =
    let d1_val = d1(option[1], option[2], option[3], option[4], option[5])
    gf_div(gf_pow(d1_val, 2), gf_mul(option[1], option[5]))
let greeks_theta(option) =
    gf_neg(gf_div(gf_mul(option[1], option[5]), 2))
let greeks_vega(option) = gf_mul(option[1], option[3])
let greeks_rho(option) =
    (option[0] == OPT_CALL ? gf_mul(option[2], option[3]) : gf_neg(gf_mul(option[2], option[3])))
let binomial_step(S, u, d, p) =
    let up = gf_mul(S, u)
    let down = gf_mul(S, d)
    gf_add(gf_mul(p, up), gf_mul(gf_sub(1, p), down))
let binomial_price(option, n_steps) =
    let u = gf_add(1, option[5])
    let d = gf_sub(1, option[5])
    let p = gf_div(gf_add(1, option[4]), 2)
    let prices = [option[1]]
    let i = 0
    for i < n_steps
        let new_prices = []
        let j = 0
        let m = len(prices)
        for j < m
            new_prices.push(gf_mul(prices[j], u))
            j = j + 1
        new_prices.push(gf_mul(prices[m - 1], d))
        prices = new_prices
        i = i + 1
    prices
let field_option(data, n, z) =
    let val = 0
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        let diff = (z + 65537 - pole) % 65537
        val = gf_add(val, gf_mul(data[i], gf_inv(diff)))
        i = i + 1
    val

