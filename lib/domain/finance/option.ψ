let OPT_SPOT_POLES = [80, 90, 100, 110, 120, 130, 140, 150]
let OPT_SPOT_WEIGHTS = [800, 900, 1000, 1100, 1200, 1300, 1400, 1500]

let psi_opt_spot(s_idx) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(s_idx), gf_norm(OPT_SPOT_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(OPT_SPOT_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let OPT_STRIKE_POLES = [80, 90, 100, 110, 120, 130, 140, 150]
let OPT_STRIKE_WEIGHTS = [1500, 1400, 1300, 1200, 1100, 1000, 900, 800]

let psi_opt_strike(k_idx) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(k_idx), gf_norm(OPT_STRIKE_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(OPT_STRIKE_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let OPT_VOL_POLES = [10, 15, 20, 25, 30, 35, 40, 45]
let OPT_VOL_WEIGHTS = [100, 200, 300, 400, 500, 600, 700, 800]

let psi_opt_vol(v_idx) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(v_idx), gf_norm(OPT_VOL_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(OPT_VOL_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let option_global_response(s_idx, k_idx, v_idx) =
    let e1 = psi_opt_spot(s_idx)
    let e2 = psi_opt_strike(k_idx)
    let e3 = psi_opt_vol(v_idx)
    gf_add(gf_add(gf_mul(e1, e1), gf_mul(e2, e2)), gf_mul(e3, e3))

let opt_spot_monotonic_test() =
    let v_low = psi_opt_spot(80)
    let v_high = psi_opt_spot(150)
    (v_low != v_high ? 1 : 0)

let opt_strike_inverse_test() =
    let v_low = OPT_STRIKE_WEIGHTS[0]
    let v_high = OPT_STRIKE_WEIGHTS[7]
    (v_low > v_high ? 1 : 0)

let opt_vol_monotonic_test() =
    let v1 = psi_opt_vol(10)
    let v2 = psi_opt_vol(45)
    (v1 != v2 ? 1 : 0)

let opt_global_nonzero_test() =
    let g = option_global_response(100, 100, 20)
    (g != 0 ? 1 : 0)

let opt_no_arbitrage_test() =
    let v1 = option_global_response(100, 100, 20)
    let v2 = option_global_response(100, 100, 20)
    (v1 == v2 ? 1 : 0)

let opt_itm_otm_test() =
    let v_itm = psi_opt_spot(150)
    let v_otm = psi_opt_spot(80)
    (v_itm != v_otm ? 1 : 0)

let nested_fractal_option_invariants() =
    let e1 = psi_opt_spot(100)
    let e2 = psi_opt_strike(100)
    let e3 = psi_opt_vol(20)
    let inv1 = 0
    if e1 != 0
        (e2 != 0 ? (e3 != 0 ? (inv1 = 1) : 0) : 0)
    let inv2 = 0
    if OPT_SPOT_WEIGHTS[0] < OPT_SPOT_WEIGHTS[7]
        inv2 = 1
    let inv3 = 0
    if OPT_STRIKE_WEIGHTS[0] > OPT_STRIKE_WEIGHTS[7]
        inv3 = 1
    let inv4 = 0
    if OPT_VOL_WEIGHTS[0] < OPT_VOL_WEIGHTS[7]
        inv4 = 1
    let inv5 = 0
    if option_global_response(100, 100, 20) != 0
        inv5 = 1
    [inv1, inv2, inv3, inv4, inv5]

