    b[1] = bids
    [trades, qty - remaining]

let vwap(trades) =
    let total_value = 0
    let total_qty = 0
    let i = 0
    let n = len(trades)
    for i < n
        let t = trades[i]
        total_value = total_value + t[0] * t[1]
        total_qty = total_qty + t[1]
        i = i + 1
    if total_qty == 0
        0
    else
        total_value / total_qty

let twap(prices_over_time) =
    let sum = 0
    let i = 0
    let n = len(prices_over_time)
    for i < n
        sum = sum + prices_over_time[i]
        i = i + 1
    if n == 0
        0
    else
        sum / n

let vwap_split(total_qty, volume_profile, num_slices) =
    let total_vol = 0
    let i = 0
    let n = len(volume_profile)
    for i < n
        total_vol = total_vol + volume_profile[i]
        i = i + 1
    if total_vol == 0
        let slices = []
        i = 0
        for i < num_slices
            slices.push(total_qty / num_slices)
            i = i + 1
        slices
    else
        let slices = []
        i = 0
        for i < num_slices
            slices.push(total_qty * volume_profile[i] / total_vol)
            i = i + 1
        slices

let clearing_new() =
    [[], 0]

let clearing_record(c, trade) =
    let trades = c[0]
    trades.push(trade)
    c[0] = trades
    c

let clearing_match_trades(c) =
    let trades = c[0]
    let positions = {}
    let i = 0
    let n = len(trades)
    for i < n
        let t = trades[i]
        let qty = t[1]
        let acct = t[3]
        let pos = positions[acct]
        if pos == 0
            pos = 0
        positions[acct] = pos + qty
        i = i + 1
    positions

let settlement_new(clearing_cycle_days) =
    [clearing_cycle_days, [], 0]

let settlement_record(s, trade, trade_date) =
    let settle_date = trade_date + s[0]
    let item = [s[2], trade, settle_date, 0]
    s[2] = s[2] + 1
    let pending = s[1]
    pending.push(item)
    s[1] = pending
    item[0]

let settlement_process(s, current_date) =
    let pending = s[1]
    let still_pending = []
    let settled = []
    let i = 0
    let n = len(pending)
    for i < n
        let item = pending[i]
        if item[2] <= current_date
            item[3] = 1
            settled.push(item)
        else
            still_pending.push(item)
        i = i + 1
    s[1] = still_pending
    settled
