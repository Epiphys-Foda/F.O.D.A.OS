let bf_field_encode(items, n) =
    let records = []
    let _i = 0
    for _i < n
        records.push([items[_i], items[_i]])
        _i = _i + 1
    domain_field_encode(records, n, 256, 1)

let bf_field_eval(poles, residues, z) = domain_field_eval(poles, residues, z)

let bf_field_bragg_verify(current, replay) = domain_bragg_verify(current[0], current[1], replay[0], replay[1])

