let lsm_default_tree() =
    [[], 0, [], LSM_DEFAULT_THRESHOLD, 0, []]

let lsm_memtable_insert(memtable, key, val, ts) =
    let new_mt = []
    let inserted = 0
    let i = 0
    let n = len(memtable)
    for i < n
        let entry = memtable[i]
        if entry[0] == key
            if inserted == 0
                new_mt.push([key, val, ts])
                inserted = 1
            else
                0
        if entry[0] > key
            if inserted == 0
                new_mt.push([key, val, ts])
                inserted = 1
            new_mt.push(entry)
        else
            new_mt.push(entry)
        i = i + 1
    if inserted == 0
        new_mt.push([key, val, ts])
    new_mt

let lsm_memtable_search(memtable, key) =
    let result = 0
    let i = 0
    let n = len(memtable)
    for i < n
        if memtable[i][0] == key
            result = memtable[i][1]
            i = n
        i = i + 1
    result

let lsm_sort_entries(entries) =
    let arr = []
    let i = 0
    let n = len(entries)
    for i < n
        arr.push(entries[i])
        i = i + 1
    i = 0
    for i < n
        let j = 0
        for j < n - 1 - i
            if arr[j][0] > arr[j + 1][0]
                let tmp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = tmp
            j = j + 1
        i = i + 1
    arr

let lsm_put(tree, key, value, ts) =
    let memtable = tree[0]
    let new_mt = lsm_memtable_insert(memtable, key, value, ts)
    let new_size = tree[1] + 1
    let log = tree[5]
    log.push(["put", key, value, ts])
    let new_tree = [new_mt, new_size, tree[2], tree[3], tree[4], log]
    if new_size >= tree[3]
        new_tree = lsm_flush(new_tree)
    new_tree

let lsm_flush(tree) =
    let memtable = tree[0]
    if len(memtable) == 0
        tree
    else
        let sst_id = tree[4] + 1
        let min_key = memtable[0][0]
        let max_key = memtable[len(memtable) - 1][0]
        let entries = []
        let i = 0
        let n = len(memtable)
        for i < n
            entries.push(memtable[i])
            i = i + 1
        let sstable = [sst_id, min_key, max_key, entries, n]
        let sstables = tree[2]
        sstables.push(sstable)
        [[], 0, sstables, tree[3], sst_id, tree[5]]

let lsm_get(tree, key) =
    let val = lsm_memtable_search(tree[0], key)
    if val != 0
        [tree, val]
    else
        let sstables = tree[2]
        let i = len(sstables) - 1
        let found = 0
        for i >= 0
            if found == 0
                let sst = sstables[i]
                if key >= sst[1]
                    if key <= sst[2]
                        let entries = sst[3]
                        let j = 0
                        let m = len(entries)
                        for j < m
                            if found == 0
                                if entries[j][0] == key
                                    val = entries[j][1]
                                    found = 1
                            j = j + 1
            i = i - 1
        [tree, val]

let lsm_compact(tree) =
    let sstables = tree[2]
    if len(sstables) <= 1
        tree
    else
        let all_entries = []
        let i = 0
        let n = len(sstables)
        for i < n
            let entries = sstables[i][3]
            let j = 0
            let m = len(entries)
            for j < m
                all_entries.push(entries[j])
                j = j + 1
            i = i + 1
        let sorted = lsm_sort_entries(all_entries)
        let merged = []
        let k = 0
        let total = len(sorted)
        for k < total
            let entry = sorted[k]
            let best_key = entry[0]
            let already = 0
            if len(merged) > 0
                if merged[len(merged) - 1][0] == best_key
                    already = 1
            if already == 0
                let best_ts = entry[2]
                let best_val = entry[1]
                let l = k + 1
                for l < total
                    if sorted[l][0] == best_key
                        if sorted[l][2] > best_ts
                            best_ts = sorted[l][2]
                            best_val = sorted[l][1]
                    l = l + 1
                merged.push([best_key, best_val, best_ts])
            k = k + 1
        let sst_id = tree[4] + 1
        let min_key = merged[0][0]
        let max_key = merged[len(merged) - 1][0]
        let new_sst = [sst_id, min_key, max_key, merged, len(merged)]
        [[], 0, [new_sst], tree[3], sst_id, tree[5]]

let lsm_bragg_verify(tree, ops_seq) =
    let ref_tree = lsm_default_tree()
    let i = 0
    let n = len(ops_seq)
    for i < n
        let op = ops_seq[i]
        ref_tree = lsm_put(ref_tree, op[0], op[1], i)
        i = i + 1
    let d1_tree = lsm_default_tree()
    i = 0
    for i < n
        let op = ops_seq[i]
        d1_tree = lsm_put(d1_tree, op[0], op[1], i)
        i = i + 1
    let consistent = 1
    i = 0
    for i < n
        let key = ops_seq[i][0]
        let r1 = lsm_get(ref_tree, key)
        let d1 = lsm_get(d1_tree, key)
        if r1[1] != d1[1]
            consistent = 0
        i = i + 1
    consistent

