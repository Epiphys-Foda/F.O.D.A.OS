let BPT_P = 65537
let BPT_DEFAULT_ORDER = 8
let BPT_POLE_SCALE = 256
let BPT_POLE_OFFSET = 1
let BPT_FRACTAL_N0 = 0
let BPT_FRACTAL_N1 = 1

let bpt_default_tree(order) =
    [[1, [], [], 0, 0], order, 0, 0, []]

let bpt_find_child(node, key) =
    let idx = 0
    let keys = node[1]
    let n = len(keys)
    let done = 0
    for idx < n
        if done == 0
            if keys[idx] > key
                done = 1
            else
                idx = idx + 1
    idx

let bpt_leaf_find_pos(keys, key) =
    let pos = 0
    let n = len(keys)
    let done = 0
    for pos < n
        if done == 0
            if keys[pos] >= key
                done = 1
            else
                pos = pos + 1
    pos

let bpt_leaf_insert(node, key, value, order) =
    let keys = node[1]
    let values = node[2]
    let pos = bpt_leaf_find_pos(keys, key)
    let new_keys = []
    let new_values = []
    let i = 0
    let n = len(keys)
    let updated = 0
    for i < n
        if i == pos
            if i < n
                if keys[i] == key
                    new_keys.push(key)
                    new_values.push(value)
                    i = i + 1
                    updated = 1
                else
                    new_keys.push(key)
                    new_values.push(value)
                    updated = 1
        if i < n
            new_keys.push(keys[i])
            new_values.push(values[i])
        i = i + 1
    if updated == 0
        new_keys.push(key)
        new_values.push(value)
    node[1] = new_keys
    node[2] = new_values
    if len(new_keys) > order
        bpt_leaf_split(node)
    else
        [0, 0, 0]

let bpt_leaf_split(node) =
    let keys = node[1]
    let values = node[2]
    let total = len(keys)
    let mid = total / 2
    let right_keys = []
    let right_values = []
    let j = mid
    for j < total
        right_keys.push(keys[j])
        right_values.push(values[j])
        j = j + 1
    let left_keys = []
    let left_values = []
    j = 0
    for j < mid
        left_keys.push(keys[j])
        left_values.push(values[j])
        j = j + 1
    node[1] = left_keys
    node[2] = left_values
    let right_node = [1, right_keys, right_values, node[3], node[4]]
    node[3] = right_node
    [right_keys[0], right_node, 1]

let bpt_internal_split(node) =
    let keys = node[1]
    let children = node[2]
    let total = len(keys)
    let mid = total / 2
    let up_key = keys[mid]
    let right_keys = []
    let right_children = []
    let j = mid + 1
    for j < total
        right_keys.push(keys[j])
        j = j + 1
    j = mid + 1
    for j <= total
        right_children.push(children[j])
        j = j + 1
    let left_keys = []
    let left_children = []
    j = 0
    for j < mid
        left_keys.push(keys[j])
        j = j + 1
    j = 0
    for j <= mid
        left_children.push(children[j])
        j = j + 1
    node[1] = left_keys
    node[2] = left_children
    let right_node = [0, right_keys, right_children, 0, node[4]]
    [up_key, right_node, 1]

let bpt_internal_insert(node, key, value, order) =
    let child_idx = bpt_find_child(node, key)
    let children = node[2]
    let child = children[child_idx]
    let result = bpt_insert_node(child, key, value, order)
    let did_split = result[2]
    if did_split == 1
        let split_key = result[0]
        let right_child = result[1]
        let keys = node[1]
        let new_keys = []
        let new_children = []
        let i = 0
        let n = len(keys)
        for i < child_idx
            new_keys.push(keys[i])
            new_children.push(children[i])
            i = i + 1
        new_keys.push(split_key)
        new_children.push(children[child_idx])
        new_children.push(right_child)
        i = child_idx
        for i < n
            new_keys.push(keys[i])
            new_children.push(children[i + 1])
            i = i + 1
        node[1] = new_keys
        node[2] = new_children
        if len(new_keys) > order
            bpt_internal_split(node)
        else
            [0, 0, 0]
    else
        [0, 0, 0]

let bpt_insert_node(node, key, value, order) =
    if node[0] == 1
        bpt_leaf_insert(node, key, value, order)
    else
        bpt_internal_insert(node, key, value, order)

let bpt_insert(tree, key, value) =
    let root = tree[0]
    let order = tree[1]
    let result = bpt_insert_node(root, key, value, order)
    let did_split = result[2]
    let log = tree[4]
    log.push(["insert", key, value])
    if did_split == 1
        let split_key = result[0]
        let right_node = result[1]
        let new_root = [0, [split_key], [root, right_node], 0, 0]
        [new_root, order, tree[2] + 1, tree[3] + 1, log]
    else
        [root, order, tree[2], tree[3] + 1, log]

let bpt_search(tree, key) =
    let node = tree[0]
    for node[0] == 0
        let idx = bpt_find_child(node, key)
        node = node[2][idx]
    let keys = node[1]
    let values = node[2]
    let i = 0
    let n = len(keys)
    let result = 0
    for i < n
        if keys[i] == key
            result = values[i]
            i = n
        i = i + 1
    result

let bpt_range_scan(tree, low, high) =
    let node = tree[0]
    for node[0] == 0
        let idx = bpt_find_child(node, low)
        node = node[2][idx]
    let result = []
    let done = 0
    for done == 0
        if node == 0
            done = 1
        else
            let keys = node[1]
            let values = node[2]
            let i = 0
            let n = len(keys)
            for i < n
                if keys[i] > high
                    done = 1
                    i = n
                else
                    0
                if keys[i] >= low
                    result.push([keys[i], values[i]])
                i = i + 1
            if done == 0
                node = node[3]
    result

let bpt_split_child(tree, parent_idx) =
    let root = tree[0]
    if root[0] == 1
        tree
    else
        let children = root[2]
        if parent_idx >= len(children)
            tree
        else
            let child = children[parent_idx]
            let result = 0
            if child[0] == 1
                result = bpt_leaf_split(child)
            else
                result = bpt_internal_split(child)
            if result[2] == 1
                let split_key = result[0]
                let right_child = result[1]
                let keys = root[1]
                let new_keys = []
                let new_children = []
                let i = 0
                let n = len(keys)
                for i < parent_idx
                    new_keys.push(keys[i])
                    new_children.push(children[i])
                    i = i + 1
                new_keys.push(split_key)
                new_children.push(children[parent_idx])
                new_children.push(right_child)
                i = parent_idx
                for i < n
                    new_keys.push(keys[i])
                    new_children.push(children[i + 1])
                    i = i + 1
                root[1] = new_keys
                root[2] = new_children
            tree

let bpt_bragg_verify(tree, ops_seq) =
    let ref_tree = bpt_default_tree(tree[1])
    let i = 0
    let n = len(ops_seq)
    for i < n
        ref_tree = bpt_insert(ref_tree, ops_seq[i][0], ops_seq[i][1])
        i = i + 1
    let d1_tree = bpt_default_tree(tree[1])
    i = 0
    for i < n
        d1_tree = bpt_insert(d1_tree, ops_seq[i][0], ops_seq[i][1])
        i = i + 1
    let consistent = 1
    i = 0
    for i < n
        let r1 = bpt_search(ref_tree, ops_seq[i][0])
        let d1 = bpt_search(d1_tree, ops_seq[i][0])
        if r1 != d1
            consistent = 0
        i = i + 1
    consistent

let bpt_gf_mod(x) = domain_gf_mod(x)
