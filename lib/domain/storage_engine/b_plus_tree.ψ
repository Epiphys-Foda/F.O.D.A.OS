let bpt_collect_leaves(node, depth, result) =
    if node[0] == 1
        let keys = node[1]
        let values = node[2]
        let i = 0
        let n = len(keys)
        for i < n
            result.push([keys[i], values[i], depth])
            i = i + 1
    else
        let children = node[2]
        let i = 0
        let n = len(children)
        for i < n
            bpt_collect_leaves(children[i], depth + 1, result)
            i = i + 1
    result

let bpt_field_encode(leaf_stream, n) =
    let records = []
    let _i = 0
    for _i < n
        records.push([leaf_stream[_i], leaf_stream[_i]])
        _i = _i + 1
    domain_field_encode(records, n, 1, 0)
let bpt_field_eval(poles, residues, z) = domain_field_eval(poles, residues, z)
let bpt_field_bragg_verify(tree, ops_seq) = domain_bragg_verify(tree[0], tree[1], ops_seq[0], ops_seq[1])
let bpt_test_basic() =
    let ok = 1
    let tree = bpt_default_tree(BPT_DEFAULT_ORDER)
    tree = bpt_insert(tree, 10, 100)
    tree = bpt_insert(tree, 20, 200)
    tree = bpt_insert(tree, 30, 300)
    if bpt_search(tree, 20) != 200
        ok = 0
    tree = bpt_insert(tree, 20, 999)
    if bpt_search(tree, 20) != 999
        ok = 0
    if bpt_search(tree, 99) != 0
        ok = 0
    let i = 0
    for i < 50
        tree = bpt_insert(tree, 100 + i, i)
        i = i + 1
    i = 0
    for i < 50
        if bpt_search(tree, 100 + i) != i
            ok = 0
        i = i + 1
    let range = bpt_range_scan(tree, 105, 115)
    if len(range) != 11
        ok = 0
    let ops = [[5, 50], [15, 150], [25, 250], [5, 55]]
    if bpt_bragg_verify(tree, ops) != 1
        ok = 0
    ok

let bpt_test_self() =
    let ok = bpt_test_basic()
    if ok == 1
        print("b_plus_tree: ALL PASS")
    else
        print("b_plus_tree: FAIL")
    ok

