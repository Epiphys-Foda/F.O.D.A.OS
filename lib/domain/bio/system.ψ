import "../../core/stdlib_lang2/gf_base.ψ"

let SYS_CIRC_POLES = [1, 2, 3, 4, 5, 6, 7, 8]
let SYS_CIRC_RESIDUES = [750, 1200, 800, 700, 1600, 5000, 600, 50]

let psi_sys_circ(param_idx) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(param_idx), gf_norm(SYS_CIRC_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(SYS_CIRC_RESIDUES[k], gf_inv(diff)))
        k = k + 1
    val

let SYS_RESP_POLES = [1, 2, 3, 4, 5, 6, 7, 8]
let SYS_RESP_RESIDUES = [140, 5000, 46000, 35000, 23000, 58000, 60000, 950]

