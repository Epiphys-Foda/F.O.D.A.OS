let DNA_A = 1
let DNA_T = 2
let DNA_G = 3
let DNA_C = 4
let DNA_U = 5

let dna_complement(base) =
    if base == DNA_A
        DNA_T
    else
        if base == DNA_T
            DNA_A
        else
            if base == DNA_G
                DNA_C
            else
                (base == DNA_C ? DNA_G : 0)
let dna_complement_strand(strand) =
    let result = []
    let i = 0
    let n = len(strand)
    for i < n
        result.push(dna_complement(strand[i]))
        i = i + 1
    result
let dna_transcribe(strand) =
    let result = []
    let i = 0
    let n = len(strand)
    for i < n
        (strand[i] == DNA_T ? result.push(DNA_U) : result.push(strand[i]))
        i = i + 1
    result
