let CODON_DEGENERACY = [3, 4, 6, 2, 2, 2, 2, 2, 4, 2, 3, 6, 2, 1, 2, 4, 6, 4, 1, 2, 4]

let codon_field_poles() =
    let poles = []
    let cum = 0
    let i = 0
    for i < 21
        cum = cum + CODON_DEGENERACY[i]
        poles.push(cum)
        i = i + 1
    poles

let genetic_code_field(codon_idx) =
    let poles = codon_field_poles()
    let val = 0
    let k = 0
    for k < 21
        let d = codon_idx - poles[k]
        if d == 0
            val = gf_add(val, CODON_DEGENERACY[k])
        else
            val = gf_add(val, gf_mul(CODON_DEGENERACY[k], gf_inv(gf_norm(d))))
        k = k + 1
    val

let genetic_code_fractal_invariants() =
    let deg_sum = 0
    let i = 0
    for i < 21
        deg_sum = deg_sum + CODON_DEGENERACY[i]
        i = i + 1
    let poles = codon_field_poles()
    let n_poles = len(poles)
    let monotone = 1
    let j = 0
    for j < 20
        if poles[j] >= poles[j + 1]
            monotone = 0
        j = j + 1
    let valid_deg = 1
    let k = 0
    for k < 21
        let d = CODON_DEGENERACY[k]
        if d != 1 && d != 2 && d != 3 && d != 4 && d != 6
            valid_deg = 0
        k = k + 1
    [deg_sum == 64, n_poles == 21, monotone == 1, valid_deg == 1]

let cross_domain_residue_invariants() =
    let chem_sum = 2 + 8 + 8 + 18 + 18 + 32 + 32
    let nuc_sum = 6 + 12 + 8 + 22 + 32 + 44
