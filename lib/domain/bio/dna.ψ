let codon_to_aa(codon) =
    let i0 = base_index(codon[0])
    let i1 = base_index(codon[1])
    let i2 = base_index(codon[2])
    CODON_TABLE[i0 * 16 + i1 * 4 + i2]

let rna_codon_to_aa(codon) =
    let c0 = (codon[0] == DNA_U ? DNA_T : codon[0])
    let c1 = (codon[1] == DNA_U ? DNA_T : codon[1])
    let c2 = (codon[2] == DNA_U ? DNA_T : codon[2])
    let i0 = base_index(c0)
    let i1 = base_index(c1)
    let i2 = base_index(c2)
    CODON_TABLE[i0 * 16 + i1 * 4 + i2]
let dna_translate(mrna) =
    let protein = []
    let i = 0
    let n = len(mrna)
    for i + 2 < n
        let codon = [mrna[i], mrna[i + 1], mrna[i + 2]]
        protein.push(codon_to_aa(codon))
        i = i + 3
    protein
let gc_content(strand) =
    let gc = 0
    let i = 0
    let n = len(strand)
    for i < n
        if strand[i] == DNA_G || strand[i] == DNA_C
            gc = gc + 1
        i = i + 1
    gf_div(gc, n)
let seq_align(seq1, seq2, match_score, mismatch_penalty, gap_penalty) =
    let n = len(seq1)
    let m = len(seq2)
    let score = []
    let i = 0
    for i < (n + 1) * (m + 1)
        score.push(0)
        i = i + 1
    i = 1
    for i <= n
        score[i * (m + 1)] = gf_mul(i, gap_penalty)
        i = i + 1
    i = 1
    for i <= m
        score[i] = gf_mul(i, gap_penalty)
        i = i + 1
    i = 1
    for i <= n
        let j = 1
        for j <= m
            let match_val = score[(i - 1) * (m + 1) + j - 1]
            if seq1[i - 1] == seq2[j - 1]
                match_val = gf_add(match_val, match_score)
            else
                match_val = gf_add(match_val, mismatch_penalty)
            let del = gf_add(score[(i - 1) * (m + 1) + j], gap_penalty)
            let ins = gf_add(score[i * (m + 1) + j - 1], gap_penalty)
            let best = match_val
            if del > best
                best = del
            if ins > best
                best = ins
            score[i * (m + 1) + j] = best
            j = j + 1
        i = i + 1
    score[n * (m + 1) + m]
let field_dna(data, n, z) =
    let val = 0
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        let diff = (z + 65537 - pole) % 65537
        val = gf_add(val, gf_mul(data[i], gf_inv(diff)))
        i = i + 1
    val

