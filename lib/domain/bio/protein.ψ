let protein_create(sequence) =
    let residues = []
    let i = 0
    let n = len(sequence)
    for i < n
        residues.push([i, sequence[i], 0, 0, 0, 0, 0])
        i = i + 1
    [residues, n, sequence]
let residue_set_coords(residue, x, y, z) = [residue[0], residue[1], x, y, z, residue[5], residue[6]]
let residue_set_angles(residue, phi, psi) = [residue[0], residue[1], residue[2], residue[3], residue[4], phi, psi]
let SS_HELIX = 1
let SS_SHEET = 2
let SS_COIL = 3
let secondary_structure(phi, psi) =
    if phi < 0 && psi > 0
        SS_HELIX
    else
        (phi < 0 && psi < 0 ? SS_SHEET : SS_COIL)
let protein_ss_assign(protein) =
    let residues = protein[0]
    let ss = []
    let i = 0
    let n = protein[1]
    for i < n
        let r = residues[i]
        ss.push(secondary_structure(r[5], r[6]))
        i = i + 1
    ss
let hp_energy(sequence, conformation) =
    let energy = 0
    let i = 0
    let n = len(sequence)
    for i < n
        let j = i + 2
        for j < n
            if sequence[i] == 0 && sequence[j] == 0
                let dx = gf_sub(conformation[i * 3], conformation[j * 3])
                let dy = gf_sub(conformation[i * 3 + 1], conformation[j * 3 + 1])
                let dz = gf_sub(conformation[i * 3 + 2], conformation[j * 3 + 2])
                let dist = gf_add(gf_add(gf_mul(dx, dx), gf_mul(dy, dy)), gf_mul(dz, dz))
                if dist == 1
                    energy = gf_sub(energy, 1)
            j = j + 1
        i = i + 1
    energy
let ramachandran_allowed(phi, psi) =
    if phi < 0 && psi > 0
        1
    else
        (phi < 0 && psi < 0 ? 1 : 0)
let docking_score(protein, ligand, position) =
    let score = 0
    let residues = protein[0]
    let i = 0
    let n = protein[1]
    for i < n
        let r = residues[i]
        let dx = gf_sub(r[2], position[0])
        let dy = gf_sub(r[3], position[1])
        let dz = gf_sub(r[4], position[2])
        let dist = gf_add(gf_add(gf_mul(dx, dx), gf_mul(dy, dy)), gf_mul(dz, dz))
        score = gf_add(score, gf_div(1, gf_add(dist, 1)))
        i = i + 1
    score
let field_protein(data, n, z) =
    let val = 0
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        let diff = (z + 65537 - pole) % 65537
        val = gf_add(val, gf_mul(data[i], gf_inv(diff)))
        i = i + 1
    val

