let psi_seq(sequence, z) =
    let val = 0
    let i = 0
    let n = len(sequence)
    for i < n
        let diff = gf_sub(z, i)
        if diff != 0
            val = gf_add(val, gf_mul(gf_norm(AA_HYDRO_X100[sequence[i]] * AA_RESIDUE_MASS[sequence[i]]), gf_inv(diff)))
        i = i + 1
    val

let psi_seq_energy(sequence) =
    let e = 0
    let i = 0
    let n = len(sequence)
    for i < n
        let v = psi_seq(sequence, i)
        e = gf_add(e, gf_mul(v, v))
        i = i + 1
    e

let SS_POLES_PHI_X100 = [-5700, -11900, -7500, 6000]
let SS_POLES_PSI_X100 = [-4700, 11300, 14500, 4100]
let SS_RESIDUES = [1, 1, 1, 1]
let SS_LABELS = [1, 2, 3, 1]

let psi_struct(phi_x100, psi_x100) =
    let best = [-1, 0]
    let val = 0
    let k = 0
    for k < 4
        let dphi_abs = phi_x100 - SS_POLES_PHI_X100[k]
        if dphi_abs < 0
            dphi_abs = -dphi_abs
        let dpsi_abs = psi_x100 - SS_POLES_PSI_X100[k]
        if dpsi_abs < 0
            dpsi_abs = -dpsi_abs
        let manhattan = dphi_abs + dpsi_abs
        if best[0] < 0 || manhattan < best[0]
            best = [manhattan, k]
        let dphi_gf = gf_sub(gf_norm(phi_x100), gf_norm(SS_POLES_PHI_X100[k]))
        let dpsi_gf = gf_sub(gf_norm(psi_x100), gf_norm(SS_POLES_PSI_X100[k]))
        let dist_gf = gf_add(gf_mul(dphi_gf, dphi_gf), gf_mul(dpsi_gf, dpsi_gf))
        if dist_gf != 0
            val = gf_add(val, gf_mul(SS_RESIDUES[k], gf_inv(dist_gf)))
        k = k + 1
    [SS_LABELS[best[1]], val]

let INTERACT_POLES = [200, 350, 450, 205]
let INTERACT_RESIDUES = [500, 100, 200, 800]

let psi_energy(r_x100) =
    let val = 0
    let k = 0
    for k < 4
        let diff = gf_sub(gf_norm(r_x100), gf_norm(INTERACT_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(INTERACT_RESIDUES[k], gf_inv(diff)))
        k = k + 1
    val

let protein_global_energy(sequence, conformations) =
    let e = 0
    e = gf_add(e, psi_seq_energy(sequence))
    let n = len(sequence)
    let i = 0
    for i < n
        let phi = conformations[i * 3 + 1]
        let psi = conformations[i * 3 + 2]
        let r2 = psi_struct(phi, psi)
        e = gf_add(e, r2[1])
        i = i + 1
    let j = 0
    let i2 = 0
    for i2 < n
        let j2 = i2 + 2
        for j2 < n
            let dx = conformations[i2 * 3] - conformations[j2 * 3]
            let dy = conformations[i2 * 3 + 1] - conformations[j2 * 3 + 1]
            let dz = conformations[i2 * 3 + 2] - conformations[j2 * 3 + 2]
            let r2 = dx * dx + dy * dy + dz * dz
            e = gf_add(e, psi_energy(r2))
            j2 = j2 + 1
        i2 = i2 + 1
    e

