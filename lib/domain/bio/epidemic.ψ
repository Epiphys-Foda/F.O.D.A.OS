let R0_POLES = [13, 20, 25, 30, 50, 70, 120, 180]
let R0_LABELS = ["seasonal_flu", "HIV", "COVID19", "SARS", "mumps", "smallpox", "polio", "measles"]
let TRANSMISSION_WEIGHTS = [10, 30, 50, 70, 60, 50, 80, 100]

let psi_R0(R0_x10) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(R0_x10), gf_norm(R0_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(TRANSMISSION_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let INCUBATION_POLES = [50, 25, 14, 10, 8, 7, 5, 3]
let INCUBATION_WEIGHTS = [80, 70, 60, 50, 40, 30, 20, 10]
let DISEASE_LABELS_INC = ["flu_2d", "covid_4d", "measles_7d", "chicpox_10d", "sars_12d", "ebola_14d", "hep_20d", "hiv_30d"]

let psi_incubation(sigma_x100) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(sigma_x100), gf_norm(INCUBATION_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(INCUBATION_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let RECOVERY_POLES = [143, 100, 71, 48, 33, 25, 17, 10]
let RECOVERY_WEIGHTS = [90, 80, 70, 60, 50, 40, 30, 20]

let psi_recovery(gamma_x1000) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(gamma_x1000), gf_norm(RECOVERY_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(RECOVERY_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let epidemic_global_response(R0_x10, sigma_x100, gamma_x1000) =
    let e1 = psi_R0(R0_x10)
    let e2 = psi_incubation(sigma_x100)
    let e3 = psi_recovery(gamma_x1000)
    gf_add(gf_add(gf_mul(e1, e1), gf_mul(e2, e2)), gf_mul(e3, e3))

let r0_threshold_test() =
    let v_below = psi_R0(10)
    let v_above = psi_R0(20)
    (v_above != v_below ? 1 : 0)

let incubation_inverse_test() =
    let v_short = psi_incubation(50)
    let v_long = psi_incubation(10)
    (v_short != v_long ? 1 : 0)

let recovery_inverse_test() =
    let v_short = psi_recovery(143)
    let v_long = psi_recovery(25)
    (v_short != v_long ? 1 : 0)

let nested_fractal_epidemic_invariants() =
    let e1 = psi_R0(25)
    let e2 = psi_incubation(25)
    let e3 = psi_recovery(100)
    let inv1 = 0
    if e1 != 0
        (e2 != 0 ? (e3 != 0 ? (inv1 = 1) : 0) : 0)
    let inv2 = 0
    if R0_POLES[0] < R0_POLES[3]
        (R0_POLES[3] < R0_POLES[7] ? (inv2 = 1) : 0)
    let inv3 = 0
    if INCUBATION_POLES[0] > INCUBATION_POLES[3]
        (INCUBATION_POLES[3] > INCUBATION_POLES[7] ? (inv3 = 1) : 0)
    let inv4 = 0
    if RECOVERY_POLES[0] > RECOVERY_POLES[3]
        (RECOVERY_POLES[3] > RECOVERY_POLES[7] ? (inv4 = 1) : 0)
    let inv5 = r0_threshold_test()
    [inv1, inv2, inv3, inv4, inv5]

