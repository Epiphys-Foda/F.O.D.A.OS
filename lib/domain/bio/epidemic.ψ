let EPI_MAX_NODES = 1024

let sir_create(S, I, R) = [S, I, R]
let sir_step(state, params) =
    let S = state[0]
    let I = state[1]
    let R = state[2]
    let beta = params[0]
    let gamma = params[1]
    let N = params[2]
    let new_S = gf_sub(S, gf_div(gf_mul(gf_mul(beta, S), I), N))
    let new_I = gf_add(gf_sub(I, gf_div(gf_mul(gf_mul(beta, S), I), N)), gf_neg(gf_mul(gamma, I)))
    let new_R = gf_add(R, gf_mul(gamma, I))
    [new_S, new_I, new_R]
let sir_run(initial, params, steps) =
    let state = initial
    let history = [state]
    let i = 0
    for i < steps
        state = sir_step(state, params)
        history.push(state)
        i = i + 1
    history
let seir_step(S, E, I, R, beta, sigma, gamma, N) =
    let new_S = gf_sub(S, gf_div(gf_mul(gf_mul(beta, S), I), N))
    let new_E = gf_add(gf_sub(gf_div(gf_mul(gf_mul(beta, S), I), N), gf_mul(sigma, E)), E)
    let new_I = gf_add(gf_sub(gf_mul(sigma, E), gf_mul(gamma, I)), I)
    let new_R = gf_add(R, gf_mul(gamma, I))
    [new_S, new_E, new_I, new_R]
let network_spread(adjacency, infected, beta, n_nodes) =
    let new_infected = []
    let i = 0
    for i < n_nodes
        new_infected.push(infected[i])
        i = i + 1
    i = 0
    for i < n_nodes
        if infected[i] == 0
            let neighbors_infected = 0
            let j = 0
            for j < n_nodes
                if adjacency[i * n_nodes + j] == 1 && infected[j] == 1
                    neighbors_infected = neighbors_infected + 1
                j = j + 1
            if neighbors_infected > 0 && beta > 0
                new_infected[i] = 1
        i = i + 1
    new_infected
let basic_reproduction_number(beta, gamma, N) = gf_div(gf_mul(beta, N), gamma)
let field_epidemic(data, n, z) =
    let val = 0
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        let diff = (z + 65537 - pole) % 65537
        val = gf_add(val, gf_mul(data[i], gf_inv(diff)))
        i = i + 1
    val

