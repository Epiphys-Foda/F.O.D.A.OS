let ORGAN_CO_BASE = 5000
let ORGAN_CO_SCALE = 1000

let organ_fit_cardiac_output(phase_idx) =
    let h_term = gf_div(psi_organ_heart(phase_idx), ORGAN_CO_SCALE)
    gf_add(ORGAN_CO_BASE, h_term)

let ORGAN_CLH_BASE = 800
let ORGAN_CLH_SCALE = 100

let organ_fit_hepatic_clearance(func_idx) =
    let l_term = gf_div(psi_organ_liver(func_idx), ORGAN_CLH_SCALE)
    gf_add(ORGAN_CLH_BASE, l_term)

let ORGAN_GFR_BASE = 12500
let ORGAN_GFR_SCALE = 100

let organ_fit_GFR(seg_idx) =
    let k_term = gf_div(psi_organ_kidney(seg_idx), ORGAN_GFR_SCALE)
    gf_add(ORGAN_GFR_BASE, k_term)

let ORGAN_CBF_BASE = 500
let ORGAN_CBF_SCALE = 100

let organ_fit_CBF(region_idx) =
    let b_term = gf_div(psi_organ_brain(region_idx), ORGAN_CBF_SCALE)
    gf_add(ORGAN_CBF_BASE, b_term)

let organ_global_response(phase_idx, func_idx, seg_idx, region_idx) =
    let e1 = psi_organ_heart(phase_idx)
    let e2 = psi_organ_liver(func_idx)
    let e3 = psi_organ_kidney(seg_idx)
    let e4 = psi_organ_brain(region_idx)
    gf_add(gf_add(gf_add(gf_mul(e1, e1), gf_mul(e2, e2)), gf_mul(e3, e3)), gf_mul(e4, e4))

