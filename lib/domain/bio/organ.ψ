let ORGAN_KIDNEY_POLES = [1, 2, 3, 4, 5, 6, 7, 8]
let ORGAN_KIDNEY_RESIDUES = [650, 100, 50, 150, 50, 20, 50, 0]

let psi_organ_kidney(seg_idx) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(seg_idx), gf_norm(ORGAN_KIDNEY_POLES[k]))
