import "../../core/stdlib_lang2/gf_base.ψ"

let ORGAN_HEART_POLES = [1, 2, 3, 4, 5, 6, 7, 8]
let ORGAN_HEART_RESIDUES = [100, 800, 1200, 1000, 500, 50, 80, 100]

let psi_organ_heart(phase_idx) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(phase_idx), gf_norm(ORGAN_HEART_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(ORGAN_HEART_RESIDUES[k], gf_inv(diff)))
        k = k + 1
    val

let ORGAN_LIVER_POLES = [1, 2, 3, 4, 5, 6, 7, 8]
let ORGAN_LIVER_RESIDUES = [800, 300, 100, 500, 200, 400, 150, 250]

let psi_organ_liver(func_idx) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(func_idx), gf_norm(ORGAN_LIVER_POLES[k]))
