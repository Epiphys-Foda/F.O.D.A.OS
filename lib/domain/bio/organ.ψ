let ORGAN_BRAIN_POLES = [1, 2, 3, 4, 5, 6, 7, 8]
let ORGAN_BRAIN_RESIDUES = [500, 480, 450, 520, 400, 350, 300, 450]

let psi_organ_brain(region_idx) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(region_idx), gf_norm(ORGAN_BRAIN_POLES[k]))
