let GENE_POLES = [0, 1, 3, 7, 15, 31, 63, 127]
let GENE_WEIGHTS = [2, 3, 5, 7, 11, 13, 17, 19]

let psi_genotype(g) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(g, GENE_POLES[k])
        if diff != 0
            val = gf_add(val, gf_mul(GENE_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let FIT_PEAKS = [0, 50, 100, 150, 200, 250, 300, 350]
let FIT_STRENGTHS = [10, 20, 30, 50, 50, 30, 20, 10]

let psi_fitness(f) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(f), gf_norm(FIT_PEAKS[k]))
        if diff != 0
            val = gf_add(val, gf_mul(FIT_STRENGTHS[k], gf_inv(diff)))
        k = k + 1
    val

let VAR_POLES = [10, 50, 100, 200, 400, 800, 1600, 3200]
let VAR_RATES = [1, 5, 10, 20, 40, 80, 160, 320]

let psi_gradient(var_) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(var_), gf_norm(VAR_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(VAR_RATES[k], gf_inv(diff)))
        k = k + 1
    val

let evolution_global_energy(genotype, fitness, variance) =
    let e1 = psi_genotype(genotype)
    let e2 = psi_fitness(fitness)
    let e3 = psi_gradient(variance)
    gf_add(gf_add(gf_mul(e1, e1), gf_mul(e2, e2)), gf_mul(e3, e3))

let fisher_fundamental_theorem(variance) =
    let v = psi_gradient(variance)
    (v != 0 ? 1 : 0)

let kimura_neutral_rate(mutation_rate_x1000, pop_size) =
    let fix_prob_x1000 = 1000 / (2 * pop_size)
    mutation_rate_x1000 * fix_prob_x1000 / 1000

let nested_fractal_evolution_invariants() =
    let e1 = psi_genotype(42)
    let e2 = psi_fitness(150)
    let e3 = psi_gradient(100)
    let inv1 = 0
    if e1 != 0
        (e2 != 0 ? (e3 != 0 ? (inv1 = 1) : 0) : 0)
    let inv2 = 0
    if GENE_POLES[0] < GENE_POLES[1]
        (GENE_POLES[1] < GENE_POLES[7] ? (inv2 = 1) : 0)
    let inv3 = 0
    if FIT_STRENGTHS[0] == FIT_STRENGTHS[7]
        (FIT_STRENGTHS[1] == FIT_STRENGTHS[6] ? (inv3 = 1) : 0)
    let inv4 = fisher_fundamental_theorem(100)
    let rate_small = kimura_neutral_rate(1000, 50)
    let rate_large = kimura_neutral_rate(1000, 200)
    let inv5 = 0
    if rate_small > rate_large
        inv5 = 1
    [inv1, inv2, inv3, inv4, inv5]

