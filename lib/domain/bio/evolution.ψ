let EVO_MAX_POP = 1024
let EVO_GENOME_LEN = 64

let individual_create(genome_len) =
    let genome = []
    let i = 0
    for i < genome_len
        genome.push(i % 4)
        i = i + 1
    [genome, 0, 0]
let population_create(size, genome_len) =
    let individuals = []
    let i = 0
    for i < size
        individuals.push(individual_create(genome_len))
        i = i + 1
    [individuals, size, 0]
let fitness_simple(individual) =
    let genome = individual[0]
    let fitness = 0
    let i = 0
    let n = len(genome)
    for i < n
        fitness = gf_add(fitness, genome[i])
        i = i + 1
    fitness
let population_evaluate(population) =
    let individuals = population[0]
    let new_individuals = []
    let i = 0
    let n = population[1]
    for i < n
        let ind = individuals[i]
        let fit = fitness_simple(ind)
        new_individuals.push([ind[0], fit, ind[2]])
        i = i + 1
    [new_individuals, n, population[2]]
let selection_tournament(population, k) =
    let individuals = population[0]
    let best = individuals[0]
    let i = 1
    for i < k && i < population[1]
        let ind = individuals[i]
        if ind[1] > best[1]
            best = ind
        i = i + 1
    best
let selection_roulette(population) =
    let individuals = population[0]
    let total_fitness = 0
    let i = 0
    let n = population[1]
    for i < n
        total_fitness = gf_add(total_fitness, individuals[i][1])
        i = i + 1
    let r = 42
    let cumulative = 0
    i = 0
    for i < n
        cumulative = gf_add(cumulative, individuals[i][1])
        if cumulative >= r
            individuals[i]
        i = i + 1
    individuals[0]
let crossover_one_point(parent1, parent2) =
    let n = parent1[0].len()
    let point = n / 2
    let child1_genome = []
    let child2_genome = []
    let i = 0
    for i < n
        if i < point
            child1_genome.push(parent1[0][i])
            child2_genome.push(parent2[0][i])
        else
            child1_genome.push(parent2[0][i])
            child2_genome.push(parent1[0][i])
        i = i + 1
    [[child1_genome, 0, 0], [child2_genome, 0, 0]]
let mutate(individual, rate) =
    let genome = individual[0]
    let i = 0
    let n = len(genome)
    for i < n
        if i % 100 < rate
            genome[i] = (genome[i] + 1) % 4
        i = i + 1
    [genome, individual[1], individual[2]]
let evolve_step(population) =
    let evaluated = population_evaluate(population)
    let new_individuals = []
    let i = 0
    let n = population[1]
    for i < n
        let parent1 = selection_tournament(evaluated, 4)
        let parent2 = selection_tournament(evaluated, 4)
        let children = crossover_one_point(parent1, parent2)
        new_individuals.push(mutate(children[0], 5))
        i = i + 1
    [new_individuals, n, population[2] + 1]
let evolve_run(population, generations) =
    let pop = population
    let i = 0
    for i < generations
        pop = evolve_step(pop)
        i = i + 1
    pop
let field_evolution(data, n, z) =
    let val = 0
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        let diff = (z + 65537 - pole) % 65537
        val = gf_add(val, gf_mul(data[i], gf_inv(diff)))
        i = i + 1
    val

