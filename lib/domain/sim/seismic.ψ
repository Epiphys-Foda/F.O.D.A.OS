import "../../core/stdlib_lang2/gf_base.ψ"

let SEISMIC_MAX_CELLS = 65536
let SEISMIC_P_WAVE = 6000
let SEISMIC_S_WAVE = 3500

let seismic_grid_create(nx, ny) =
    let cells = []
    let i = 0
    for i < nx * ny
        cells.push([0, 0, 0, 1, 1, 1])
        i = i + 1
    [cells, nx, ny, 1, 1]
let seismic_step(grid) =
    let cells = grid[0]
    let nx = grid[1]
    let ny = grid[2]
    let new_cells = []
    let i = 0
    for i < nx * ny
        new_cells.push(cells[i])
        i = i + 1
    i = 1
    for i < nx - 1
        let j = 1
        for j < ny - 1
            let idx = i * nx + j
            let c = cells[idx]
            let u = c[0]
            let v = c[1]
            let lap = gf_add(gf_sub(cells[idx + 1][0], gf_mul(2, u)), cells[idx - 1][0])
            lap = gf_add(lap, gf_add(gf_sub(cells[idx + nx][0], gf_mul(2, u)), cells[idx - nx][0]))
            let new_v = gf_add(v, gf_mul(c[3], lap))
            let new_u = gf_add(u, new_v)
            new_cells[idx] = [new_u, new_v, c[2], c[3], c[4], c[5]]
            j = j + 1
        i = i + 1
    [new_cells, nx, ny, grid[3], grid[4]]
let fault_slip(grid, i, j, slip) =
    let cells = grid[0]
    let nx = grid[1]
    let c = cells[i * nx + j]
    cells[i * nx + j] = [gf_add(c[0], slip), c[1], c[2], c[3], c[4], c[5]]
    [cells, nx, grid[2], grid[3], grid[4]]
let richter_magnitude(amplitude, distance) =
    gf_add(gf_div(amplitude, 100), gf_div(distance, 100))
let p_wave_arrival(distance) = gf_div(distance, SEISMIC_P_WAVE)
let s_wave_arrival(distance) = gf_div(distance, SEISMIC_S_WAVE)
let s_p_delay(distance) = gf_sub(s_wave_arrival(distance), p_wave_arrival(distance))
let field_seismic(data, n, z) =
    let val = 0
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        let diff = (z + 65537 - pole) % 65537
        val = gf_add(val, gf_mul(data[i], gf_inv(diff)))
        i = i + 1
    val

let seismic_verify() =
    let test_data = arr_new_n(3)
    test_data[0] = 100
    test_data[1] = 200
    test_data[2] = 300
    let result = field_seismic(test_data, 3, 500)
    let ok = 0
    (result != 0 ? (ok = 1) : (ok = 0))
    ok

