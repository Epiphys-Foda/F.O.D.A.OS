let THERMAL_K_POLES = [26, 60, 100, 170, 8000, 23700, 40100, 220000]
let THERMAL_K_WEIGHTS = [10, 20, 30, 40, 70, 80, 90, 100]
let MATERIAL_LABELS_K = ["air", "water", "glass", "concrete", "iron", "aluminum", "copper", "diamond"]

let psi_thermal_k(k_x100) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(k_x100), gf_norm(THERMAL_K_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(THERMAL_K_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let SPECIFIC_HEAT_POLES = [385, 449, 897, 2090, 4186, 830, 490, 510]
let SPECIFIC_HEAT_WEIGHTS = [10, 20, 30, 70, 100, 25, 30, 25]

let psi_specific_heat(c) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(c), gf_norm(SPECIFIC_HEAT_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(SPECIFIC_HEAT_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let DIFFUSIVITY_POLES = [14, 25, 230, 970, 1110, 13000, 2000, 6000]
let DIFFUSIVITY_WEIGHTS = [10, 15, 50, 70, 80, 100, 60, 30]

let psi_diffusivity(alpha) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(alpha), gf_norm(DIFFUSIVITY_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(DIFFUSIVITY_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let thermal_global_response(k_x100, c, alpha) =
    let e1 = psi_thermal_k(k_x100)
    let e2 = psi_specific_heat(c)
    let e3 = psi_diffusivity(alpha)
    gf_add(gf_add(gf_mul(e1, e1), gf_mul(e2, e2)), gf_mul(e3, e3))

let fourier_law_test() =
    let v_low_k = psi_thermal_k(60)
    let v_high_k = psi_thermal_k(40100)
    (v_low_k != v_high_k ? 1 : 0)

let dulong_petit_test() =
    let v_water = psi_specific_heat(4186)
    let v_metal = psi_specific_heat(449)
    (v_water != v_metal ? 1 : 0)

let diffusion_conservation_test() =
    let v_low_alpha = psi_diffusivity(14)
    let v_high_alpha = psi_diffusivity(13000)
    (v_low_alpha != v_high_alpha ? 1 : 0)

let nested_fractal_thermal_invariants() =
    let e1 = psi_thermal_k(8000)
    let e2 = psi_specific_heat(449)
    let e3 = psi_diffusivity(230)
    let inv1 = 0
    if e1 != 0
        (e2 != 0 ? (e3 != 0 ? (inv1 = 1) : 0) : 0)
    let inv2 = 0
    if THERMAL_K_POLES[0] < THERMAL_K_POLES[3]
        (THERMAL_K_POLES[3] < THERMAL_K_POLES[7] ? (inv2 = 1) : 0)
    let inv3 = 0
    if SPECIFIC_HEAT_POLES[4] == 4186
        (SPECIFIC_HEAT_WEIGHTS[4] == 100 ? (inv3 = 1) : 0)
    let inv4 = 0
    if DIFFUSIVITY_POLES[5] == 13000
        (DIFFUSIVITY_WEIGHTS[5] == 100 ? (inv4 = 1) : 0)
    let inv5 = fourier_law_test()
    [inv1, inv2, inv3, inv4, inv5]

