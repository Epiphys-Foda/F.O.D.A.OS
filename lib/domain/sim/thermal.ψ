let THERMAL_MAX_CELLS = 65536

let thermal_grid_create(nx, ny, init_temp) =
    let cells = []
    let i = 0
    for i < nx * ny
        cells.push([init_temp, 1, 1, 0])
        i = i + 1
    [cells, nx, ny, 1, 1]
let thermal_step_cell(grid, i, j) =
    let nx = grid[1]
    let ny = grid[2]
    let cells = grid[0]
    let idx = i * nx + j
    let c = cells[idx]
    let temp = c[0]
    let k = c[1]
    let cap = c[2]
    let laplacian = 0
    if i > 0
        laplacian = gf_add(laplacian, gf_sub(cells[(i-1) * nx + j][0], temp))
    if i < nx - 1
        laplacian = gf_add(laplacian, gf_sub(cells[(i+1) * nx + j][0], temp))
    if j > 0
        laplacian = gf_add(laplacian, gf_sub(cells[i * nx + j - 1][0], temp))
    if j < ny - 1
        laplacian = gf_add(laplacian, gf_sub(cells[i * nx + j + 1][0], temp))
    let new_temp = gf_add(temp, gf_div(gf_mul(k, laplacian), cap))
    [new_temp, k, cap, c[3]]
let thermal_step(grid) =
    let nx = grid[1]
    let ny = grid[2]
    let new_cells = []
    let i = 0
    for i < nx
        let j = 0
        for j < ny
            new_cells.push(thermal_step_cell(grid, i, j))
            j = j + 1
        i = i + 1
    [new_cells, nx, ny, grid[3], grid[4]]
let phase_change(temp, melting_point, latent_heat) =
    (temp >= melting_point ? 1 : 0)
let thermal_add_source(grid, i, j, heat) =
    let cells = grid[0]
    let nx = grid[1]
    let c = cells[i * nx + j]
    cells[i * nx + j] = [gf_add(c[0], heat), c[1], c[2], c[3]]
    [cells, nx, grid[2], grid[3], grid[4]]
let field_thermal(data, n, z) =
    let val = 0
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        let diff = (z + 65537 - pole) % 65537
        val = gf_add(val, gf_mul(data[i], gf_inv(diff)))
        i = i + 1
    val

