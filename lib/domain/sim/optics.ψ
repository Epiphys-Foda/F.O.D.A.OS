let REFRACTIVE_INDEX_POLES = [100, 133, 200, 250, 333, 420, 500, 750]
let REFRACTIVE_WEIGHTS = [10, 30, 50, 60, 100, 80, 40, 95]

let psi_refractive_index(n_x100) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(n_x100), gf_norm(REFRACTIVE_INDEX_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(REFRACTIVE_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let FRAUNHOFER_WAVELENGTHS = [393, 430, 486, 518, 589, 589, 656, 759]
let SPECTRAL_LINE_WEIGHTS = [80, 60, 70, 50, 100, 100, 80, 60]

let psi_fraunhofer(wavelength_nm) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(wavelength_nm), gf_norm(FRAUNHOFER_WAVELENGTHS[k]))
        if diff != 0
            val = gf_add(val, gf_mul(SPECTRAL_LINE_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let ABSORPTION_COEF_POLES = [1, 5, 25, 100, 500, 1500, 5000, 20000]
let ABSORPTION_WEIGHTS = [10, 20, 30, 50, 70, 75, 90, 100]

let psi_absorption(alpha_x10) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(alpha_x10), gf_norm(ABSORPTION_COEF_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(ABSORPTION_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let optics_global_response(n_x100, wavelength_nm, alpha_x10) =
    let e1 = psi_refractive_index(n_x100)
    let e2 = psi_fraunhofer(wavelength_nm)
    let e3 = psi_absorption(alpha_x10)
    gf_add(gf_add(gf_mul(e1, e1), gf_mul(e2, e2)), gf_mul(e3, e3))

let snell_law_test() =
    let v_vacuum = psi_refractive_index(100)
    let v_diamond = psi_refractive_index(333)
    (v_vacuum != v_diamond ? 1 : 0)

let fraunhofer_d_lines_test() =
    let v_d1 = psi_fraunhofer(589)
    let v_k = psi_fraunhofer(393)
    (v_d1 != v_k ? 1 : 0)

let beer_lambert_test() =
    let v_low_alpha = psi_absorption(1)
    let v_high_alpha = psi_absorption(20000)
    (v_low_alpha != v_high_alpha ? 1 : 0)

let nested_fractal_optics_invariants() =
    let e1 = psi_refractive_index(200)
    let e2 = psi_fraunhofer(589)
    let e3 = psi_absorption(100)
    let inv1 = 0
    if e1 != 0
        (e2 != 0 ? (e3 != 0 ? (inv1 = 1) : 0) : 0)
    let inv2 = 0
    if REFRACTIVE_INDEX_POLES[0] < REFRACTIVE_INDEX_POLES[2]
        (REFRACTIVE_INDEX_POLES[2] < REFRACTIVE_INDEX_POLES[4] ? (inv2 = 1) : 0)
    let inv3 = 0
    if SPECTRAL_LINE_WEIGHTS[4] == 100
        (SPECTRAL_LINE_WEIGHTS[5] == 100 ? (inv3 = 1) : 0)
    let inv4 = 0
    if ABSORPTION_COEF_POLES[0] < ABSORPTION_COEF_POLES[3]
        (ABSORPTION_COEF_POLES[3] < ABSORPTION_COEF_POLES[7] ? (inv4 = 1) : 0)
    let inv5 = snell_law_test()
    [inv1, inv2, inv3, inv4, inv5]

