let ray_create(ox, oy, oz, dx, dy, dz, wavelength) = [[ox, oy, oz], [dx, dy, dz], wavelength, 1000]
let ray_reflect(ray, normal) =
    let d = ray[1]
    let dot = gf_add(gf_add(gf_mul(d[0], normal[0]), gf_mul(d[1], normal[1])), gf_mul(d[2], normal[2]))
    let new_dx = gf_sub(d[0], gf_mul(2, gf_mul(dot, normal[0])))
    let new_dy = gf_sub(d[1], gf_mul(2, gf_mul(dot, normal[1])))
    let new_dz = gf_sub(d[2], gf_mul(2, gf_mul(dot, normal[2])))
    [ray[0], [new_dx, new_dy, new_dz], ray[2], ray[3]]
let ray_refract(ray, normal, n1, n2) =
    let d = ray[1]
    let dot = gf_add(gf_add(gf_mul(d[0], normal[0]), gf_mul(d[1], normal[1])), gf_mul(d[2], normal[2]))
    let eta = gf_div(n1, n2)
    let k = gf_sub(gf_mul(eta, eta), 1)
    k = gf_add(gf_mul(k, gf_mul(dot, dot)), 1)
    if k < 0
        ray
    let new_dx = gf_sub(gf_mul(eta, d[0]), gf_mul(gf_sub(gf_mul(eta, dot), gf_sqrt(k)), normal[0]))
    let new_dy = gf_sub(gf_mul(eta, d[1]), gf_mul(gf_sub(gf_mul(eta, dot), gf_sqrt(k)), normal[1]))
    let new_dz = gf_sub(gf_mul(eta, d[2]), gf_mul(gf_sub(gf_mul(eta, dot), gf_sqrt(k)), normal[2]))
    [ray[0], [new_dx, new_dy, new_dz], ray[2], ray[3]]
let ray_trace(ray, surfaces, max_bounces) =
    let r = ray
    let bounces = 0
    let path = [r[0]]
    for bounces < max_bounces
        let hit = 0
        let i = 0
        let n = len(surfaces)
        for i < n
            let s = surfaces[i]
            if s[0] == 1
                hit = i
            i = n
            i = i + 1
        if hit == 0
            path
        let surface = surfaces[hit]
        r = ray_reflect(r, surface[1])
        path.push(r[0])
        bounces = bounces + 1
    path
let thin_lens_equation(u, f) =
    if gf_sub(u, f) == 0
        65536
    gf_div(gf_mul(u, f), gf_sub(u, f))
let diffraction_grating(d, n, wavelength, angle) =
    gf_sub(gf_mul(n, wavelength), gf_mul(d, angle))
let interference(phase1, phase2) =
    gf_add(gf_pow(phase1, 2), gf_add(gf_pow(phase2, 2), gf_mul(2, gf_mul(phase1, phase2))))
let field_optics(data, n, z) =
    let val = 0
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        let diff = (z + 65537 - pole) % 65537
        val = gf_add(val, gf_mul(data[i], gf_inv(diff)))
        i = i + 1
    val

