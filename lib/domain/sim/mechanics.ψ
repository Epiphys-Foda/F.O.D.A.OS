let MECH_MAX_BODIES = 1024

let body_create(id, x, y, z, mass) = [id, x, y, z, 0, 0, 0, mass, gf_div(1, mass)]
let body_apply_force(body, fx, fy, fz, dt) =
    let vx = gf_add(body[4], gf_mul(gf_div(fx, body[7]), dt))
    let vy = gf_add(body[5], gf_mul(gf_div(fy, body[7]), dt))
    let vz = gf_add(body[6], gf_mul(gf_div(fz, body[7]), dt))
    [body[0], body[1], body[2], body[3], vx, vy, vz, body[7], body[8]]
let body_integrate(body, dt) =
    let x = gf_add(body[1], gf_mul(body[4], dt))
    let y = gf_add(body[2], gf_mul(body[5], dt))
    let z = gf_add(body[3], gf_mul(body[6], dt))
    [body[0], x, y, z, body[4], body[5], body[6], body[7], body[8]]
let constraint_create(a, b, rest_length, stiffness) = [a, b, rest_length, stiffness]
let constraint_solve(constraint, bodies) =
    let body_a = bodies[constraint.get(0)]
    let body_b = bodies[constraint.get(1)]
    let dx = gf_sub(body_b[1], body_a[1])
    let dy = gf_sub(body_b[2], body_a[2])
    let dz = gf_sub(body_b[3], body_a[3])
    let dist = gf_sqrt(gf_add(gf_add(gf_mul(dx, dx), gf_mul(dy, dy)), gf_mul(dz, dz)))
    if dist == 0
        bodies
    let diff = gf_sub(dist, constraint[2])
    let correction = gf_mul(gf_mul(diff, constraint[3]), gf_div(1, gf_add(body_a[8], body_b[8])))
    let nx = gf_div(dx, dist)
    let ny = gf_div(dy, dist)
    let nz = gf_div(dz, dist)
    bodies[constraint[0]] = [body_a[0], gf_add(body_a[1], gf_mul(correction, gf_mul(body_a[8], nx))), gf_add(body_a[2], gf_mul(correction, gf_mul(body_a[8], ny))), gf_add(body_a[3], gf_mul(correction, gf_mul(body_a[8], nz))), body_a[4], body_a[5], body_a[6], body_a[7], body_a[8]]
    bodies[constraint[1]] = [body_b[0], gf_sub(body_b[1], gf_mul(correction, gf_mul(body_b[8], nx))), gf_sub(body_b[2], gf_mul(correction, gf_mul(body_b[8], ny))), gf_sub(body_b[3], gf_mul(correction, gf_mul(body_b[8], nz))), body_b[4], body_b[5], body_b[6], body_b[7], body_b[8]]
    bodies
let body_collision(a, b) =
    let dx = gf_sub(a[1], b[1])
    let dy = gf_sub(a[2], b[2])
    let dz = gf_sub(a[3], b[3])
    let dist_sq = gf_add(gf_add(gf_mul(dx, dx), gf_mul(dy, dy)), gf_mul(dz, dz))
    let r_sum = 10
    (dist_sq < gf_mul(r_sum, r_sum) ? 1 : 0)
let field_mechanics(data, n, z) =
    let val = 0
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        let diff = (z + 65537 - pole) % 65537
        val = gf_add(val, gf_mul(data[i], gf_inv(diff)))
        i = i + 1
    val

