let YOUNGS_MODULUS_POLES = [1, 3, 70, 100, 200, 210, 400, 1050]
let YOUNGS_MODULUS_WEIGHTS = [10, 30, 50, 60, 80, 85, 70, 100]

let psi_youngs_modulus(E_GPa) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(E_GPa), gf_norm(YOUNGS_MODULUS_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(YOUNGS_MODULUS_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let POISSON_RATIO_POLES = [10, 28, 31, 33, 34, 42, 50, 20]
let POISSON_RATIO_WEIGHTS = [30, 40, 50, 50, 50, 60, 80, 40]

let psi_poisson(nu_x100) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(nu_x100), gf_norm(POISSON_RATIO_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(POISSON_RATIO_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let YIELD_STRENGTH_POLES = [30, 100, 210, 250, 350, 550, 880, 1400]
let YIELD_STRENGTH_WEIGHTS = [10, 30, 50, 55, 65, 80, 90, 100]

let psi_yield_strength(sigma_y) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(sigma_y), gf_norm(YIELD_STRENGTH_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(YIELD_STRENGTH_WEIGHTS[k], gf_inv(diff)))
        k = k + 1
    val

let mechanics_global_response(E_GPa, nu_x100, sigma_y) =
    let e1 = psi_youngs_modulus(E_GPa)
    let e2 = psi_poisson(nu_x100)
    let e3 = psi_yield_strength(sigma_y)
    gf_add(gf_add(gf_mul(e1, e1), gf_mul(e2, e2)), gf_mul(e3, e3))

let hooke_law_test() =
    let v_low_E = psi_youngs_modulus(1)
    let v_high_E = psi_youngs_modulus(1050)
    (v_low_E != v_high_E ? 1 : 0)

let poisson_incompressibility_test() =
    let v_rubber = psi_poisson(50)
    let v_concrete = psi_poisson(20)
    (v_rubber != v_concrete ? 1 : 0)

let tresca_yield_test() =
    let v_low_sigma = psi_yield_strength(30)
    let v_high_sigma = psi_yield_strength(1400)
    (v_low_sigma != v_high_sigma ? 1 : 0)

let nested_fractal_mechanics_invariants() =
    let e1 = psi_youngs_modulus(210)
    let e2 = psi_poisson(30)
    let e3 = psi_yield_strength(250)
    let inv1 = 0
    if e1 != 0
        (e2 != 0 ? (e3 != 0 ? (inv1 = 1) : 0) : 0)
    let inv2 = 0
    if YOUNGS_MODULUS_POLES[0] < YOUNGS_MODULUS_POLES[5]
        (YOUNGS_MODULUS_POLES[5] < YOUNGS_MODULUS_POLES[7] ? (inv2 = 1) : 0)
    let inv3 = 0
    if POISSON_RATIO_POLES[0] >= 0
        (POISSON_RATIO_POLES[6] <= 50 ? (inv3 = 1) : 0)
    let inv4 = 0
    if YIELD_STRENGTH_POLES[0] < YIELD_STRENGTH_POLES[3]
        (YIELD_STRENGTH_POLES[3] < YIELD_STRENGTH_POLES[7] ? (inv4 = 1) : 0)
    let inv5 = hooke_law_test()
    [inv1, inv2, inv3, inv4, inv5]

