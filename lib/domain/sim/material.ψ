let MATERIAL_MAX_ATOMS = 8192

let material_create(n_atoms, lattice_type) =
    let atoms = []
    let i = 0
    for i < n_atoms
        atoms.push([i, i % 10, i / 10, 0, 0, [0, 0, 0]])
        i = i + 1
    [atoms, n_atoms, [lattice_type, 1, 1, 1], [0, 0, 0]]
let lj_potential(r, epsilon, sigma) =
    let sr = gf_div(sigma, r)
    let sr6 = gf_pow(sr, 6)
    let sr12 = gf_mul(sr6, sr6)
    gf_mul(4, gf_mul(epsilon, gf_sub(sr12, sr6)))
let lj_force(r, epsilon, sigma) =
    let sr = gf_div(sigma, r)
    let sr6 = gf_pow(sr, 6)
    let sr12 = gf_mul(sr6, sr6)
    gf_mul(gf_mul(24, epsilon), gf_sub(gf_mul(2, sr12), sr6))
let stress_tensor(forces, area) =
    let stress = []
    let i = 0
    let n = len(forces)
    for i < n
        stress.push(gf_div(forces[i], area))
        i = i + 1
    stress
let strain_tensor(original, deformed) =
    gf_div(gf_sub(deformed, original), original)
let hooke_law(stress, youngs_modulus) =
    gf_div(stress, youngs_modulus)
let phase_transition(temp, critical_temp) =
    (temp > critical_temp ? 1 : 0)
let LATTICE_FCC = 1
let LATTICE_BCC = 2
let LATTICE_HCP = 3
let LATTICE_SC = 4
let lattice_vectors(kind, a) =
    if kind == LATTICE_FCC
        [[a, 0, 0], [0, a, 0], [0, 0, a]]
    else
        if kind == LATTICE_BCC
            [[a, 0, 0], [0, a, 0], [0, 0, a]]
        else
            [[a, 0, 0], [gf_div(a, 2), gf_div(gf_mul(a, 1732), 2000), 0], [0, 0, a]]
let field_material(data, n, z) =
    let val = 0
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        let diff = (z + 65537 - pole) % 65537
        val = gf_add(val, gf_mul(data[i], gf_inv(diff)))
        i = i + 1
    val

