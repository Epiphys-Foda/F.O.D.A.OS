]
let LATENT_HEATS = [130, 16, 15, 247, 397, 175, 280, 192]

let psi_phase(temp) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(temp), gf_norm(PHASE_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(LATENT_HEATS[k], gf_inv(diff)))
        k = k + 1
    val

let vrh_average(c11, c12, c44) =
    let voigt = (3 * c11 + 2 * (2 * c12 + 4 * c44)) / 5
    let reuss_inv = 1
    let vrh = voigt
    vrh

let material_global_response(strain, stress, temp) =
    let e1 = psi_strain(strain)
    let e2 = psi_stress(stress)
    let e3 = psi_phase(temp)
    gf_add(gf_add(gf_mul(e1, e1), gf_mul(e2, e2)), gf_mul(e3, e3))

let landau_phase_transition(temp, critical_temp) =
    let v = psi_phase(temp)
    let vc = psi_phase(critical_temp)
    (v > vc ? 1 : 0)

let nested_fractal_material_invariants() =
    let e1 = psi_strain(100)
    let e2 = psi_stress(50000)
    let e3 = psi_phase(500)
    let inv1 = 0
    if e1 != 0
        (e2 != 0 ? (e3 != 0 ? (inv1 = 1) : 0) : 0)
    let inv2 = 0
    if STRAIN_POLES[0] < STRAIN_POLES[1]
        (STRAIN_POLES[1] < STRAIN_POLES[7] ? (inv2 = 1) : 0)
    let inv3 = 0
    if STRESS_POLES[0] < STRESS_POLES[1]
        (STRESS_POLES[1] < STRESS_POLES[7] ? (inv3 = 1) : 0)
    let inv4 = 0
    if ELASTIC_C[4] == 16800
        inv4 = 1
    let inv5 = 0
    if PHASE_POLES[0] == 1085
        (PHASE_POLES[3] == 1538 ? (inv5 = 1) : 0)
    [inv1, inv2, inv3, inv4, inv5]

