let STRAIN_POLES = [0, 10, 50, 200, 500, 1000, 2000, 5000]
let ELASTIC_C = [11000, 11900, 12100, 7600, 16800, 16800, 16800, 16800]

let psi_strain(epsilon) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(epsilon), gf_norm(STRAIN_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(ELASTIC_C[k], gf_inv(diff)))
        k = k + 1
    val

let STRESS_POLES = [0, 7000, 22000, 70000, 220000, 700000, 2200000, 7000000]
let YOUNG_MODULI = [11000, 11000, 11000, 11000, 11000, 11000, 11000, 11000]

let psi_stress(sigma) =
    let val = 0
    let k = 0
    for k < 8
        let diff = gf_sub(gf_norm(sigma), gf_norm(STRESS_POLES[k]))
        if diff != 0
            val = gf_add(val, gf_mul(YOUNG_MODULI[k], gf_inv(diff)))
        k = k + 1
    val

let PHASE_POLES = [
    1085,
