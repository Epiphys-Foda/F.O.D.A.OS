import "../../core/stdlib_lang2/gf_base.ψ"

let FS_INDEX_HASH_SIZE = 4096

let ht_create(size) =
    let buckets = []
    let i = 0
    for i < size
        buckets.push(0)
        i = i + 1
    [buckets, size, 0]
let ht_hash(key, size) = gf_norm(key) % size
let ht_insert(ht, key, value) =
    let buckets = ht[0]
    let size = ht[1]
    let slot = ht_hash(key, size)
    buckets[slot] = [key, value, buckets[slot]]
    [buckets, size, ht[2] + 1]
let ht_lookup(ht, key) =
    let buckets = ht[0]
    let size = ht[1]
    let slot = ht_hash(key, size)
    let entry = buckets[slot]
    for entry != 0
        if entry[0] == key
            entry[1]
        entry = entry[2]
    0
let ht_remove(ht, key) =
    let buckets = ht[0]
    let size = ht[1]
    let slot = ht_hash(key, size)
    let entry = buckets[slot]
    if entry != 0 && entry[0] == key
        buckets[slot] = entry[2]
    [buckets, size, ht[2] - 1]
let bloom_create(size, n_hashes) =
    let bits = []
    let i = 0
    for i < size
        bits.push(0)
        i = i + 1
    [bits, size, n_hashes]
let bloom_hash(key, seed, size) = gf_norm(gf_mul(key, seed + 1)) % size
let bloom_add(bloom, key) =
    let bits = bloom[0]
    let size = bloom[1]
    let n_hashes = bloom[2]
    let i = 0
    for i < n_hashes
        let idx = bloom_hash(key, i, size)
        bits[idx] = 1
        i = i + 1
    [bits, size, n_hashes]
let bloom_contains(bloom, key) =
    let bits = bloom[0]
    let size = bloom[1]
    let n_hashes = bloom[2]
    let i = 0
    for i < n_hashes
        let idx = bloom_hash(key, i, size)
        if bits[idx] == 0
            0
        i = i + 1
    1
let inverted_index_add(index, term, doc_id) =
    let postings = index[term]
    if postings == 0
        postings = []
    postings.push(doc_id)
    index[term] = postings
    index
let inverted_index_search(index, term) =
    let postings = index[term]
    (postings == 0 ? [] : postings)
let fsindex_field_lookup(poles, residues, n, query_z) =
    let val = 0
    let i = 0
    for i < n
        let diff = (query_z + 65537 - poles[i]) % 65537
        let inv_diff = gf_inv(diff)
        val = gf_add(val, gf_mul(residues[i], inv_diff))
        i = i + 1
    val

let fsindex_verify() =
    let ht = ht_create(16)
    let h1 = ht_insert(ht, 100, 200)
    let found = ht_lookup(h1, 100)
    let bloom = bloom_create(64, 3)
    let b1 = bloom_add(bloom, 42)
    let contains = bloom_contains(b1, 42)
    let ok = 0
    (found == 200 && contains == 1 ? (ok = 1) : (ok = 0))
    ok

