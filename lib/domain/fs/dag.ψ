import "../../core/stdlib_lang2/gf_base.ψ"

let DAG_MAX_NODES = 65536
let DAG_MAX_EDGES = 262144

let dag_create() = [[], [], 0]
let dag_node_create(id, parents, content_hash, timestamp) = [id, parents, content_hash, timestamp]
let dag_add_node(dag, node) =
    let nodes = dag[0]
    let heads = dag[1]
    nodes.push(node)
    let new_heads = []
    let i = 0
    let n = len(heads)
    for i < n
        let h = heads[i]
        let is_parent = 0
        let j = 0
        let m = node[1].len()
        for j < m
            if node[1][j] == h
                is_parent = 1
            j = j + 1
        if is_parent == 0
            new_heads.push(h)
        i = i + 1
    new_heads.push(node[0])
    [nodes, new_heads, dag[2] + 1]
let dag_topo_sort(dag) =
    let nodes = dag[0]
    let n = len(nodes)
    let visited = []
    let i = 0
    for i < n
        visited.push(0)
        i = i + 1
    let order = []
    i = 0
    for i < n
        if visited[i] == 0
            let node = nodes[i]
            let j = 0
            let m = node[1].len()
            for j < m
                let parent_idx = node[1][j]
                if visited[parent_idx] == 0
                    visited.set(parent_idx, 1)
                    order.push(parent_idx)
                j = j + 1
            visited[i] = 1
            order.push(i)
        i = i + 1
    order
let dag_lca(dag, a, b) =
    let nodes = dag[0]
    let ancestors_a = [a]
    let ancestors_b = [b]
    let i = 0
    for i < len(ancestors_a)
        let node = nodes[ancestors_a.get(i)]
        let j = 0
        let m = node[1].len()
        for j < m
            ancestors_a.push(node[1][j])
            j = j + 1
        i = i + 1
    i = 0
    for i < len(ancestors_b)
        let node = nodes[ancestors_b.get(i)]
        let j = 0
        let m = node[1].len()
        for j < m
            ancestors_b.push(node[1][j])
            j = j + 1
        i = i + 1
    let lca = 0
    i = 0
    for i < len(ancestors_a)
        let j = 0
        for j < len(ancestors_b)
            if ancestors_a[i] == ancestors_b[j]
                lca = ancestors_a[i]
            j = j + 1
        i = i + 1
    lca
let dag_merge(dag, parents, content_hash, timestamp) =
    let id = dag[2]
    let node = dag_node_create(id, parents, content_hash, timestamp)
    dag_add_node(dag, node)
let dag_snapshot(dag, name) = [name, dag[1], dag[2]]
let dag_field_hash(content, n) =
    let poles = arr_new_n(n)
    let residues = arr_new_n(n)
    let hash = 0
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        poles[i] = pole
        residues[i] = content[i]
        hash = gf_add(hash, gf_mul(content[i], gf_pow(3, i)))
        i = i + 1
    hash

let dag_merkle_root(hashes, n) =
    let current = hashes
    let len = n
    for len > 1
        let next_len = (len + 1) / 2
        let next = arr_new_n(next_len)
        let i = 0
        for i < next_len
            let a = current[i * 2]
            let b = 0
            (i * 2 + 1 < len ? (b = current[i * 2 + 1]) : (b = 0))
            next[i] = gf_add(gf_mul(a, 31), gf_mul(b, 37))
            i = i + 1
        current = next
        len = next_len
    current[0]

let dag_verify() =
    let dag = dag_create()
    let n1 = dag_node_create(0, [], 100, 1)
    let d1 = dag_add_node(dag, n1)
    let n2 = dag_node_create(1, [0], 200, 2)
    let d2 = dag_add_node(d1, n2)
    let heads = d2[1]
    let ok = 0
    (len(heads) == 1 ? (ok = 1) : (ok = 0))
    ok

