let FS_MAX_INODES = 65536
let FS_BLOCK_SIZE = 4096
let FS_MAX_BLOCKS = 1048576

let inode_create(id, mode, parent, name) = [id, mode, 0, [], parent, name]
let inode_is_dir(inode) =
    (inode[1] / 256 == 1 ? 1 : 0)
let inode_is_file(inode) =
    (inode[1] / 256 == 2 ? 1 : 0)
let inode_add_block(inode, block_id) =
    let blocks = inode[3]
    blocks.push(block_id)
    [inode[0], inode[1], inode[2], blocks, inode[4], inode[5]]
let inode_set_size(inode, size) = [inode[0], inode[1], size, inode[3], inode[4], inode[5]]
let dir_create(inode) = [inode, []]
let dir_add_entry(dir, name, inode_id) =
    let entries = dir[1]
    entries.push([name, inode_id])
    [dir[0], entries]
let dir_lookup(dir, name) =
    let entries = dir[1]
    let i = 0
    let n = len(entries)
    for i < n
        let entry = entries[i]
        if entry[0] == name
            entry[1]
        i = i + 1
    0
let dir_remove_entry(dir, name) =
    let entries = dir[1]
    let new_entries = []
    let i = 0
    let n = len(entries)
    for i < n
        let entry = entries[i]
        if entry[0] != name
            new_entries.push(entry)
        i = i + 1
    [dir[0], new_entries]
let fs_read(inode, blocks, offset, length) =
    let data = []
    let block_idx = offset / FS_BLOCK_SIZE
    let block_offset = offset % FS_BLOCK_SIZE
    let remaining = length
    let result = []
    let inode_blocks = inode[3]
    for remaining > 0 && block_idx < len(inode_blocks)
        let block = blocks[inode_blocks.get(block_idx)]
        let to_read = FS_BLOCK_SIZE - block_offset
        if to_read > remaining
            to_read = remaining
        let i = block_offset
        for i < block_offset + to_read
            result.push(block[i])
            i = i + 1
        remaining = remaining - to_read
        block_idx = block_idx + 1
        block_offset = 0
    result
let fs_write(inode, blocks, offset, data) =
    let block_idx = offset / FS_BLOCK_SIZE
    let block_offset = offset % FS_BLOCK_SIZE
    let inode_blocks = inode[3]
    let i = 0
    let n = len(data)
    for i < n
        let block = blocks[inode_blocks.get(block_idx)]
        block[block_offset] = data[i]
        blocks[inode_blocks[block_idx]] = block
        block_offset = block_offset + 1
        if block_offset >= FS_BLOCK_SIZE
            block_idx = block_idx + 1
        block_offset = 0
        i = i + 1
    [blocks, inode_set_size(inode, offset + n)]
let sb_create() = [0x464F4441, FS_MAX_INODES, FS_MAX_BLOCKS, [], []]
let sb_alloc_inode(sb) =
    let free = sb[3]
    if len(free) > 0
        let id = free[0]
        id
    else
        sb[1] - len(free)
let sb_alloc_block(sb) =
    let free = sb[4]
    if len(free) > 0
        let id = free[0]
        id
    else
        sb[2] - len(free)
let fs_field_encode_inode(inode, n) =
    let poles = arr_new_n(n)
    let residues = arr_new_n(n)
    let i = 0
    for i < n
        poles[i] = 127 + i * 1000
        residues[i] = inode[i % 6]
        i = i + 1
    [poles, residues]

