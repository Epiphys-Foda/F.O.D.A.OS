let md_render_plaintext(ast) =
    let sb = []
    md_render_plaintext_node(ast, sb)
    md_str_join(sb, "")

let md_walk(ast, visitor_fn) =
    visitor_fn(ast)
    let children = md_children(ast)
    let i = 0
    let n = len(children)
    for i < n
        md_walk(children[i], visitor_fn)
        i = i + 1

let md_ast_sig(ast) =
    let sb = []
    md_render_html_node(ast, sb)
    md_str_join(sb, "|")

let md_bragg_verify(parser, samples) =
    let ok = 1
    let i = 0
    let n = len(samples)
    for i < n
        let text = samples[i]
        let p1 = md_default_parser()
        p1 = md_parse(p1, text)
        let sig_d1 = md_ast_sig(md_parser_ast(p1))
        let p2 = md_default_parser()
        p2 = md_parse(p2, text)
        let sig_r1 = md_ast_sig(md_parser_ast(p2))
        if sig_d1 != sig_r1
            ok = 0
            i = n
        i = i + 1
    [ok, n]

let md_test_basic() =
    let ok = 1
    let p = md_default_parser()
    p = md_parse(p, "# Heading\n\nParagraph\n\n- item1\n- item2\n")
    let children = md_children(md_parser_ast(p))
    if len(children) != 3
        ok = 0
    let samples = ["# Test\n\nHello", "## A\n\nB\nC", "- x\n- y\n"]
    if md_bragg_verify(p, samples)[0] != 1
        ok = 0
    ok

let md_test_self() =
    let ok = md_test_basic()
    if ok == 1
        print("markdown: ALL PASS")
    else
        print("markdown: FAIL")
    ok

