let ks_node_count(s) =
    kg_node_count(s)

let ks_edge_count(s) =
    let out_e = kg_out_edges(s)
    let keys = keys_of(out_e)
    let count = 0
    let i = 0
    let n = len(keys)
    for i < n
        let lst = out_e[keys[i]]
        if lst != 0
            count = count + len(lst)
        i = i + 1
    count

let ks_dump(s) =
    let nodes = kg_nodes(s)
    let ids = keys_of(nodes)
    let sb = []
    sb.push("KnowledgeGraph:\n")
    sb.push("  Nodes: " + str(len(ids)) + "\n")
    let i = 0
    let n = len(ids)
    for i < n
        let id = ids[i]
        let node = nodes[id]
        sb.push("  [")
        sb.push(str(id))
        sb.push("] ")
        sb.push(kn_type_name(kn_type(node)))
        sb.push(": ")
        sb.push(kn_title(node))
        sb.push("\n")
        i = i + 1
    sb.push("  Edges: " + str(ks_edge_count(s)) + "\n")
    kg_str_join(sb)
