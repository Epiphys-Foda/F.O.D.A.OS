import "../domain_field.ψ"

let KG_P = 65537

let KG_NT_CONCEPT   = 1
let KG_NT_FACT       = 2
let KG_NT_PROCEDURE  = 3
let KG_NT_RELATION   = 4

let KG_INFINITY = 65536

let KG_PR_ITERATIONS  = 20
let KG_PR_DAMPING     = 46160

let KG_LPA_ITERATIONS = 10

let KG_HASH_INIT = 34567
let KG_HASH_MUL  = 31

let kg_hash_ints(data) =
    let h = KG_HASH_INIT
    let i = 0
    let n = len(data)
    for i < n
        h = (h * KG_HASH_MUL + data[i]) % KG_P
        h = (h * h + data[i]) % KG_P
        i = i + 1
    h

let kg_gf_inv(a) = domain_gf_inv(a)

let kg_gf_mul(a, b) = domain_gf_mul(a, b)

let kg_str_join(parts) =
    let result = ""
    let i = 0
    let n = len(parts)
    for i < n
        result = result + parts[i]
        i = i + 1
    result

let kn_new(id, title, content, node_type) =
    [id, title, content, node_type]

let kn_id(n) = n[0]
let kn_title(n) = n[1]
let kn_content(n) = n[2]
let kn_type(n) = n[3]

let kn_set_title(n, title) =
    n[1] = title
    n

let kn_set_content(n, content) =
    n[2] = content
    n

let kn_type_name(node_type) =
    if node_type == KG_NT_CONCEPT
        "concept"
    else
        0
    if node_type == KG_NT_FACT
        "fact"
    else
        0
    if node_type == KG_NT_PROCEDURE
        "procedure"
    else
        0
    if node_type == KG_NT_RELATION
        "relationship"
    else
        "unknown"

let ke_new(source, target, relation_type, weight) =
    [source, target, relation_type, weight]

let ke_source(e) = e[0]
let ke_target(e) = e[1]
let ke_relation(e) = e[2]
let ke_weight(e) = e[3]

let ke_set_weight(e, w) =
    e[3] = w
    e

let kg_new() =
    [{}, {}, {}, 0]

let kg_nodes(g) = g[0]
let kg_out_edges(g) = g[1]
let kg_in_edges(g) = g[2]
let kg_next_id(g) = g[3]

let kg_alloc_id(g) =
    let id = g[3]
    g[3] = id + 1
    id

let kg_add_knode(g, id, title, content, node_type) =
    let node = kn_new(id, title, content, node_type)
    let nodes = kg_nodes(g)
    nodes[id] = node
    let out_e = kg_out_edges(g)
    out_e[id] = []
    let in_e = kg_in_edges(g)
    in_e[id] = []
    node

let kg_get_node(g, id) =
    kg_nodes(g)[id]

let kg_add_kedge(g, source, target, relation_type, weight) =
    let edge = ke_new(source, target, relation_type, weight)
    let out_e = kg_out_edges(g)
    let src_list = out_e[source]
    if src_list == 0
        src_list = []
    src_list.push(edge)
    out_e[source] = src_list
    let in_e = kg_in_edges(g)
    let tgt_list = in_e[target]
    if tgt_list == 0
        tgt_list = []
    tgt_list.push(edge)
    in_e[target] = tgt_list
    edge

let kg_out_neighbors(g, node_id) =
    let out_e = kg_out_edges(g)
    let lst = out_e[node_id]
    if lst == 0
        []
    else
        let result = []
        let i = 0
        let n = len(lst)
        for i < n
            result.push(ke_target(lst[i]))
            i = i + 1
        result

let kg_in_neighbors(g, node_id) =
    let in_e = kg_in_edges(g)
    let lst = in_e[node_id]
    if lst == 0
        []
    else
        let result = []
        let i = 0
        let n = len(lst)
        for i < n
            result.push(ke_source(lst[i]))
            i = i + 1
        result

let kg_out_neighbors_by_relation(g, node_id, relation_type) =
    let out_e = kg_out_edges(g)
    let lst = out_e[node_id]
