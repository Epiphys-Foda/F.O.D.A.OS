let kg_node_count(g) =
    len(keys_of(kg_nodes(g)))

let kg_pagerank(g, iterations, damping) =
    let nodes = kg_nodes(g)
    let ids = keys_of(nodes)
    let n = len(ids)
    let pr = {}
    if n == 0
        pr
    else
        let inv_n = kg_gf_inv(n)
        let i = 0
        for i < n
            pr[ids[i]] = inv_n
            i = i + 1
        let base_factor = KG_P - damping
        let base_rank = kg_gf_mul(base_factor, inv_n)
        let it = 0
        for it < iterations
            let new_pr = {}
            i = 0
            for i < n
                let id = ids[i]
                let rank = base_rank
                let in_n = kg_in_neighbors(g, id)
                let j = 0
                let m = len(in_n)
                for j < m
                    let src = in_n[j]
                    let out_n = kg_out_neighbors(g, src)
                    let out_deg = len(out_n)
                    if out_deg > 0
                        let inv_deg = kg_gf_inv(out_deg)
                        let contrib = kg_gf_mul(kg_gf_mul(damping, pr[src]), inv_deg)
                        rank = (rank + contrib) % KG_P
                    j = j + 1
                new_pr[id] = rank
                i = i + 1
            i = 0
            for i < n
                pr[ids[i]] = new_pr[ids[i]]
                i = i + 1
            it = it + 1
        pr

let kg_rank_nodes(g, iterations, damping) =
    let pr = kg_pagerank(g, iterations, damping)
    let ids = keys_of(pr)
    let entries = []
    let i = 0
    let n = len(ids)
    for i < n
        let id = ids[i]
        entries.push([id, pr[id]])
        i = i + 1
    i = 0
    for i < n
        let max_idx = i
        let j = i + 1
        for j < n
            if entries[j][1] > entries[max_idx][1]
                max_idx = j
            j = j + 1
        if max_idx != i
            let tmp = entries[i]
            entries[i] = entries[max_idx]
            entries[max_idx] = tmp
        i = i + 1
    entries

let kg_bfs_path(g, from_id, to_id) =
    if from_id == to_id
        [from_id]
    else
        let visited = {}
        visited[from_id] = 1
        let prev = {}
        let queue = [from_id]
        let head_idx = 0
        let found = 0
        for head_idx < len(queue)
            if found == 1
                head_idx = len(queue)
            else
                let node = queue[head_idx]
                if node == to_id
                    found = 1
                else
                    let neighbors = kg_out_neighbors(g, node)
                    let i = 0
                    let n = len(neighbors)
                    for i < n
                        let nb = neighbors[i]
                        if visited[nb] == 0
                            visited[nb] = 1
                            prev[nb] = node
                            queue.push(nb)
                        i = i + 1
                head_idx = head_idx + 1
        if visited[to_id] == 0
            0
        else
            let path = [to_id]
            let cur = to_id
            for cur != from_id
                cur = prev[cur]
                path.push(cur)
            let reversed = []
            let i = len(path) - 1
            for i >= 0
                reversed.push(path[i])
                i = i - 1
            reversed

let kg_dijkstra_path(g, from_id, to_id) =
    if from_id == to_id
        [from_id]
    else
        let nodes = kg_nodes(g)
        let ids = keys_of(nodes)
        let n = len(ids)
        let dist = {}
        let prev = {}
        let visited = {}
        let i = 0
        for i < n
            dist[ids[i]] = KG_INFINITY
            visited[ids[i]] = 0
            i = i + 1
        dist[from_id] = 0
        let done = 0
        for done == 0
            let min_dist = KG_INFINITY
            let min_id = -1
            i = 0
            for i < n
                let id = ids[i]
                if visited[id] == 0
                    let d = dist[id]
                    if d < min_dist
                        min_dist = d
                        min_id = id
                i = i + 1
            if min_id == -1
                done = 1
            else
                0
            if min_id == to_id
                visited[min_id] = 1
                done = 1
            else
                visited[min_id] = 1
                let out_e = kg_out_edges(g)
                let edges = out_e[min_id]
                if edges != 0
                    let j = 0
                    let m = len(edges)
                    for j < m
                        let e = edges[j]
                        let tgt = ke_target(e)
                        let w = ke_weight(e)
                        let new_dist = min_dist + w
                        if new_dist >= KG_P
                            new_dist = new_dist - KG_P
                        if visited[tgt] == 0
                            let old_dist = dist[tgt]
                            if new_dist < old_dist
                                dist[tgt] = new_dist
                                prev[tgt] = min_id
                        j = j + 1
        if dist[to_id] == KG_INFINITY
            0
        else
            let path = [to_id]
            let cur = to_id
            for cur != from_id
                cur = prev[cur]
                path.push(cur)
            let reversed = []
            let i2 = len(path) - 1
            for i2 >= 0
                reversed.push(path[i2])
                i2 = i2 - 1
            reversed

let kg_shortest_path(g, from_id, to_id, use_weight) =
    if use_weight == 1
        kg_dijkstra_path(g, from_id, to_id)
    else
        kg_bfs_path(g, from_id, to_id)

let kg_community_lpa(g, iterations) =
    let nodes = kg_nodes(g)
    let ids = keys_of(nodes)
    let n = len(ids)
    let labels = {}
    let i = 0
    for i < n
        labels[ids[i]] = ids[i]
        i = i + 1
    let it = 0
    for it < iterations
        i = 0
        for i < n
            let id = ids[i]
            let neighbors = kg_out_neighbors(g, id)
            let label_counts = {}
            let j = 0
            let m = len(neighbors)
            for j < m
                let nb = neighbors[j]
                let nb_label = labels[nb]
                let cnt = label_counts[nb_label]
                if cnt == 0
                    label_counts[nb_label] = 1
                else
                    label_counts[nb_label] = cnt + 1
                j = j + 1
            let lkeys = keys_of(label_counts)
            let best_label = labels[id]
            let best_count = 0
            let k = 0
            let kl = len(lkeys)
            for k < kl
                let lk = lkeys[k]
                let lc = label_counts[lk]
                if lc > best_count
                    best_count = lc
                    best_label = lk
                k = k + 1
            labels[id] = best_label
            i = i + 1
        it = it + 1
    labels

let kg_communities(g, iterations) =
    let labels = kg_community_lpa(g, iterations)
    let ids = keys_of(labels)
    let result = {}
    let i = 0
    let n = len(ids)
    for i < n
        let id = ids[i]
        let label = labels[id]
        let lst = result[label]
        if lst == 0
            result[label] = [id]
        else
            lst.push(id)
        i = i + 1
    result

let kg_search_by_keyword(g, keyword) =
    let nodes = kg_nodes(g)
    let ids = keys_of(nodes)
    let result = []
    let i = 0
    let n = len(ids)
    for i < n
        let id = ids[i]
        let node = nodes[id]
        if str_contains(kn_title(node), keyword) == 1
            result.push(id)
        else
            0
        if str_contains(kn_content(node), keyword) == 1
            result.push(id)
        i = i + 1
    result

let kg_search_by_type(g, node_type) =
    let nodes = kg_nodes(g)
    let ids = keys_of(nodes)
    let result = []
    let i = 0
    let n = len(ids)
    for i < n
        let id = ids[i]
        let node = nodes[id]
        if kn_type(node) == node_type
            result.push(id)
        i = i + 1
    result

let kg_neighbors(g, node_id, max_depth) =
    let visited = {}
    visited[node_id] = 1
    let queue = [[node_id, 0]]
    let result = []
    let head_idx = 0
    for head_idx < len(queue)
        let head = queue[head_idx]
        let node = head[0]
        let depth = head[1]
        if depth > 0
            result.push(node)
        if depth < max_depth
            let neighbors = kg_out_neighbors(g, node)
            let i = 0
            let n = len(neighbors)
            for i < n
                let nb = neighbors[i]
                if visited[nb] == 0
                    visited[nb] = 1
                    queue.push([nb, depth + 1])
                i = i + 1
        head_idx = head_idx + 1
    result

let kg_node_relations(g, node_id) =
    let out_e = kg_out_edges(g)
    let lst = out_e[node_id]
    if lst == 0
        []
    else
        let result = []
        let i = 0
        let n = len(lst)
        for i < n
            let e = lst[i]
            result.push([ke_relation(e), ke_target(e), ke_weight(e)])
            i = i + 1
        result

let kg_bfs_relation(g, start, relation_type, max_depth) =
    let visited = {}
    visited[start] = 1
    let queue = [[start, 0]]
    let result = []
    let head_idx = 0
    for head_idx < len(queue)
        let head = queue[head_idx]
        let node = head[0]
        let depth = head[1]
        if depth < max_depth
            let neighbors = kg_out_neighbors_by_relation(g, node, relation_type)
            let i = 0
            let n = len(neighbors)
            for i < n
                let nb = neighbors[i]
                if visited[nb] == 0
                    visited[nb] = 1
                    result.push(nb)
                    queue.push([nb, depth + 1])
                i = i + 1
        head_idx = head_idx + 1
    result

let kg_transitive_closure(g, relation_type, max_depth) =
    let nodes = kg_nodes(g)
    let ids = keys_of(nodes)
    let closure = []
    let i = 0
    let n = len(ids)
    for i < n
        let start = ids[i]
        let reachable = kg_bfs_relation(g, start, relation_type, max_depth)
        let j = 0
        let m = len(reachable)
        for j < m
            closure.push({source: start, target: reachable[j]})
            j = j + 1
        i = i + 1
    closure

let kg_can_reach(g, from_id, to_id, relation_type, max_depth) =
    let reachable = kg_bfs_relation(g, from_id, relation_type, max_depth)
    let found = 0
    let i = 0
    let n = len(reachable)
    for i < n
        if reachable[i] == to_id
            found = 1
            i = n
        else
            i = i + 1
    found

let kg_infer_path(g, from_id, to_id, relation_type, max_depth) =
    if from_id == to_id
        [from_id]
    else
        let visited = {}
        visited[from_id] = 1
        let prev = {}
        let queue = [[from_id, 0]]
        let head_idx = 0
        let found = 0
        for head_idx < len(queue)
            if found == 1
                head_idx = len(queue)
            else
                let head = queue[head_idx]
                let node = head[0]
                let depth = head[1]
                if node == to_id
                    found = 1
                else
                    0
                if depth < max_depth
                    let neighbors = kg_out_neighbors_by_relation(g, node, relation_type)
                    let i = 0
                    let n = len(neighbors)
                    for i < n
                        let nb = neighbors[i]
                        if visited[nb] == 0
                            visited[nb] = 1
                            prev[nb] = node
                            queue.push([nb, depth + 1])
                        i = i + 1
                head_idx = head_idx + 1
        if visited[to_id] == 0
            0
        else
            let path = [to_id]
            let cur = to_id
            for cur != from_id
                cur = prev[cur]
                path.push(cur)
            let reversed = []
            let i = len(path) - 1
            for i >= 0
                reversed.push(path[i])
                i = i - 1
            reversed

