let entry_new(value, ttl_ms) =
    let expire = 0
    if ttl_ms > 0
        expire = ttl_ms
    [value, expire, 0]

let entry_value(e) = e[0]
let entry_expire(e) = e[1]
let entry_access(e) = e[2]

let entry_set_value(e, v) =
    e[0] = v
    e

let entry_touch(e, access_counter) =
    e[2] = access_counter
    e

let entry_is_expired(e, current_time) =
    let exp = entry_expire(e)
    if exp == 0
        0
    else
        0
    if exp > current_time
        0
    else
        1

let cache_new(max_size) =
    [{}, {}, {}, {}, {}, 0, max_size, 0]

let cache_kv(c) = c[0]
let cache_lists(c) = c[1]
let cache_hashes(c) = c[2]
let cache_sets(c) = c[3]
let cache_zsets(c) = c[4]
let cache_counter(c) = c[5]
let cache_max(c) = c[6]

let cache_next_access(c) =
    c[5] = c[5] + 1
    c[5]

let cache_set(c, key, value, ttl) =
    let kv = cache_kv(c)
    let entry = entry_new(value, ttl)
    entry = entry_touch(entry, cache_next_access(c))
    kv[key] = entry
    c[0] = kv
    if cache_max(c) > 0
        let keys = keys_of(kv)
        if len(keys) > cache_max(c)
            let min_key = keys[0]
            let min_access = entry_access(kv[keys[0]])
            let i = 1
            let n = len(keys)
            for i < n
                let a = entry_access(kv[keys[i]])
                if a < min_access
                    min_access = a
                    min_key = keys[i]
                i = i + 1
            kv[min_key] = 0
            c[0] = kv
    c

let cache_get(c, key, current_time) =
    let kv = cache_kv(c)
    let entry = kv[key]
    if entry == 0
        0
    else
        if entry_is_expired(entry, current_time) == 1
            kv[key] = 0
            c[0] = kv
            0
        else
            entry = entry_touch(entry, cache_next_access(c))
            kv[key] = entry
            c[0] = kv
            entry_value(entry)

let cache_del(c, key) =
    let kv = cache_kv(c)
    kv[key] = 0
    c[0] = kv
    c

let cache_incr(c, key) =
    let kv = cache_kv(c)
    let entry = kv[key]
    let new_val = 0
    if entry == 0
        new_val = 1
        entry = entry_new(new_val, 0)
    else
        new_val = entry_value(entry) + 1
        entry = entry_set_value(entry, new_val)
    entry = entry_touch(entry, cache_next_access(c))
    kv[key] = entry
    c[0] = kv
    new_val

let cache_decr(c, key) =
    let kv = cache_kv(c)
    let entry = kv[key]
    let new_val = 0
    if entry == 0
        new_val = -1
        entry = entry_new(new_val, 0)
    else
        new_val = entry_value(entry) - 1
        entry = entry_set_value(entry, new_val)
    entry = entry_touch(entry, cache_next_access(c))
    kv[key] = entry
    c[0] = kv
    new_val

let cache_lpush(c, key, value) =
    let lists = cache_lists(c)
    let lst = lists[key]
    if lst == 0
        lst = []
    let new_lst = [value]
    let i = 0
    let n = len(lst)
    for i < n
        new_lst.push(lst[i])
        i = i + 1
    lists[key] = new_lst
    c[1] = lists
    len(new_lst)

let cache_rpush(c, key, value) =
    let lists = cache_lists(c)
    let lst = lists[key]
    if lst == 0
        lst = []
    lst.push(value)
    lists[key] = lst
    c[1] = lists
    len(lst)

let cache_lpop(c, key) =
    let lists = cache_lists(c)
    let lst = lists[key]
    if lst == 0
        0
    else
        0
    if len(lst) == 0
        0
    else
        let val = lst[0]
        let new_lst = []
        let i = 1
        let n = len(lst)
        for i < n
            new_lst.push(lst[i])
            i = i + 1
        lists[key] = new_lst
        c[1] = lists
        val

let cache_rpop(c, key) =
    let lists = cache_lists(c)
    let lst = lists[key]
    if lst == 0
        0
    else
        0
    if len(lst) == 0
        0
    else
        let val = lst[len(lst) - 1]
        lst.pop()
        lists[key] = lst
        c[1] = lists
        val

let cache_lrange(c, key, start, stop) =
    let lists = cache_lists(c)
    let lst = lists[key]
    if lst == 0
        []
    else
        let n = len(lst)
        let s = start
        let e = stop
        if s < 0
            s = n + s
        if e < 0
            e = n + e
        if s < 0
            s = 0
        if e >= n
            e = n - 1
        let result = []
        let i = s
        for i <= e
            result.push(lst[i])
            i = i + 1
        result

