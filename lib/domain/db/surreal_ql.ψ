let sq_lq_id(l)           = l[0]
let sq_lq_ast(l)          = l[1]
let sq_lq_subs(l)         = l[2]
let sq_lq_results(l)      = l[3]
let sq_lq_stats(l)        = l[4]

let sq_lq_set_subs(l, s) =
    l[2] = s
    l
let sq_lq_set_results(l, r) =
    l[3] = r
    l
let sq_lq_set_stats(l, s) =
    l[4] = s
    l

let sq_lq_add_subscriber(l, sub_id) =
    let subs = sq_lq_subs(l)
    subs.push(sub_id)
    l = sq_lq_set_subs(l, subs)
    l

let sq_lq_remove_subscriber(l, sub_id) =
    let subs = sq_lq_subs(l)
    let new_subs = []
    let i = 0
    let n = len(subs)
    for i < n
        if subs[i] != sub_id
            new_subs.push(subs[i])
        i = i + 1
    l = sq_lq_set_subs(l, new_subs)
    l

let sq_lq_push(l, new_results, now_ts) =
    let old = sq_lq_results(l)
    let changes = 0
    if len(old) != len(new_results)
        changes = 1
    else
        let i = 0
        for i < len(old)
            if old[i] != new_results[i]
                changes = 1
                i = len(old)
            i = i + 1
    l = sq_lq_set_results(l, new_results)
    let st = sq_lq_stats(l)
    st[0] = st[0] + 1
    if changes == 1
        st[1] = st[1] + len(sq_lq_subs(l))
        st[2] = st[2] + 1
    l = sq_lq_set_stats(l, st)
    [l, changes]

let sq_store_new() =
    [{}, [], {}, [], [0, 0, 0, 0, 0]]

let sq_st_tables(s)       = s[0]
let sq_st_edges(s)        = s[1]
let sq_st_live(s)         = s[2]
let sq_st_log(s)          = s[3]
let sq_st_stats(s)        = s[4]

let sq_st_set_tables(s, t) =
    s[0] = t
    s
let sq_st_set_edges(s, e) =
    s[1] = e
    s
let sq_st_set_live(s, l) =
    s[2] = l
    s
let sq_st_set_log(s, l) =
    s[3] = l
    s
let sq_st_set_stats(s, st) =
    s[4] = st
    s

let sq_st_log_append(s, ts, op, detail) =
    let log = sq_st_log(s)
    log.push([ts, op, detail])
    s = sq_st_set_log(s, log)
    s

let sq_st_stats_inc(s, idx) =
    let st = sq_st_stats(s)
    st[idx] = st[idx] + 1
    s = sq_st_set_stats(s, st)
    s

let sq_st_create(s, table, now_ts) =
    let tables = sq_st_tables(s)
    if tables[table] == 0
        tables[table] = []
    s = sq_st_set_tables(s, tables)
    s = sq_st_stats_inc(s, 1)
    s = sq_st_log_append(s, now_ts, "create", table)
    s

let sq_st_insert(s, table, record_id, fields, now_ts) =
    let tables = sq_st_tables(s)
    let records = tables[table]
    if records == 0
        records = []
    records.push([record_id, fields])
    tables[table] = records
    s = sq_st_set_tables(s, tables)
    s = sq_st_stats_inc(s, 2)
    s = sq_st_log_append(s, now_ts, "insert", [table, record_id])
    s = sq_st_notify_live(s, table, now_ts)
    s

let sq_st_select(s, table, where_pred) =
    let tables = sq_st_tables(s)
    let records = tables[table]
    if records == 0
        records = []
    let result = records
    if where_pred != 0
        result = []
        let i = 0
        let n = len(records)
        for i < n
            let rec = records[i]
            let fields = rec[1]
            let val = fields[where_pred[0]]
            if val == 0
                val = 0
            let match_ = 0
            if where_pred[1] == "="
                if val == where_pred[2]
                    match_ = 1
                else
                    0
            if where_pred[1] == ">"
                if val > where_pred[2]
                    match_ = 1
                else
                    0
            if where_pred[1] == "<"
                if val < where_pred[2]
                    match_ = 1
            if match_ == 1
                result.push(rec)
            i = i + 1
    s = sq_st_stats_inc(s, 0)
    s = sq_st_log_append(s, 0, "select", table)
    [s, result]

let sq_st_update(s, table, record_id, new_fields, now_ts) =
    let tables = sq_st_tables(s)
    let records = tables[table]
    if records != 0
        let i = 0
        let n = len(records)
        for i < n
            if records[i][0] == record_id
                let rec = records[i]
                let fields = rec[1]
                let keys = keys_of(new_fields)
                let j = 0
                let m = len(keys)
                for j < m
                    fields[keys[j]] = new_fields[keys[j]]
                    j = j + 1
                rec[1] = fields
                records[i] = rec
                j = n
            i = i + 1
        tables[table] = records
        s = sq_st_set_tables(s, tables)
    s = sq_st_stats_inc(s, 3)
    s = sq_st_log_append(s, now_ts, "update", [table, record_id])
    s = sq_st_notify_live(s, table, now_ts)
    s

let sq_st_delete(s, table, record_id, now_ts) =
    let tables = sq_st_tables(s)
    let records = tables[table]
    if records != 0
        let new_records = []
        let i = 0
        let n = len(records)
        for i < n
            if records[i][0] != record_id
                new_records.push(records[i])
            i = i + 1
        tables[table] = new_records
        s = sq_st_set_tables(s, tables)
    s = sq_st_stats_inc(s, 4)
    s = sq_st_log_append(s, now_ts, "delete", [table, record_id])
    s = sq_st_notify_live(s, table, now_ts)
    s

let sq_st_relate(s, from_id, edge_type, to_id, props, now_ts) =
    let edges = sq_st_edges(s)
    edges.push([from_id, edge_type, to_id, props])
    s = sq_st_set_edges(s, edges)
    s = sq_st_log_append(s, now_ts, "relate", [from_id, edge_type, to_id])
    s

let sq_st_fetch(s, from_id, edge_type, direction) =
    let edges = sq_st_edges(s)
    let result = []
    let i = 0
    let n = len(edges)
    for i < n
        let edge = edges[i]
        let match_ = 0
        if direction == 1
            if edge[0] == from_id && edge[1] == edge_type
                match_ = 1
            else
                0
            if edge[2] == from_id && edge[1] == edge_type
                match_ = 1
        if match_ == 1
            if direction == 1
                result.push(edge[2])
            else
                result.push(edge[0])
        i = i + 1
    [s, result]

let sq_st_notify_live(s, table, now_ts) =
    let lives = sq_st_live(s)
    let keys = keys_of(lives)
    let i = 0
    let n = len(keys)
    for i < n
        let lq = lives[keys[i]]
        let sel_r = sq_st_select(s, table, 0)
        let new_results = sel_r[1]
        let push_r = sq_lq_push(lq, new_results, now_ts)
        lq = push_r[0]
        lives[keys[i]] = lq
        i = i + 1
    s = sq_st_set_live(s, lives)
    s

let sq_st_bragg_verify(s) =
    let st = sq_st_stats(s)
    let log = sq_st_log(s)
    let ok = 1
    let total_ops = st[0] + st[1] + st[2] + st[3] + st[4]
    ok = total_ops == len(log)
    [ok, total_ops, len(log)]

