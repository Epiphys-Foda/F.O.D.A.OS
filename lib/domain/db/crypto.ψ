import "auth.ψ"

import "../../core/stdlib_lang2/gf_base.ψ"

let CRYPTO_KEY_SIZE = 32
let CRYPTO_BLOCK_SIZE = 16
let CRYPTO_ROUNDS = 16

let crypto_keystream(key, counter, length) =
    let stream = []
    let i = 0
    for i < length
        let val = gf_add(gf_mul(key, counter + i), gf_pow(key, 2))
        stream.push(gf_norm(val))
        i = i + 1
    stream
let crypto_encrypt(plaintext, key, counter) =
    let n = len(plaintext)
    let stream = crypto_keystream(key, counter, n)
    let ciphertext = []
    let i = 0
    for i < n
        ciphertext.push(gf_add(plaintext[i], stream[i]))
        i = i + 1
    ciphertext
let crypto_decrypt(ciphertext, key, counter) =
    let n = len(ciphertext)
    let stream = crypto_keystream(key, counter, n)
    let plaintext = []
    let i = 0
    for i < n
        plaintext.push(gf_sub(ciphertext[i], stream[i]))
        i = i + 1
    plaintext
let crypto_sbox(x) = gf_pow(x, 3)
let crypto_sbox_inv(x) = gf_pow(x, 21846)
let crypto_round(state, round_key) =
    let n = len(state)
    let out = []
    let i = 0
    for i < n
        out.push(gf_add(crypto_sbox(state[i]), round_key))
        i = i + 1
    out
let crypto_round_inv(state, round_key) =
    let n = len(state)
    let out = []
    let i = 0
    for i < n
        out.push(crypto_sbox_inv(gf_sub(state[i], round_key)))
        i = i + 1
    out
let crypto_kdf(master, salt, iterations) =
    let key = master
    let i = 0
    for i < iterations
        key = auth_hash([key, salt], i)
        i = i + 1
    key
let crypto_mac(message, key) =
    let mac = key
    let i = 0
    let n = len(message)
    for i < n
        mac = gf_add(gf_mul(mac, 257), message[i])
        i = i + 1
    gf_pow(mac, 2)
let crypto_verify_mac(message, key, expected_mac) =
    (crypto_mac(message, key) == expected_mac ? 1 : 0)
let crypto_field_encrypt(plaintext, key, n) =
    let poles = arr_new_n(n)
    let residues = arr_new_n(n)
    let i = 0
    for i < n
        poles[i] = 127 + i * 1000
        residues[i] = gf_add(plaintext[i], key)
        i = i + 1
    [poles, residues]

let crypto_field_decrypt(poles, residues, key, n) =
    let plaintext = arr_new_n(n)
    let i = 0
    for i < n
        plaintext[i] = gf_sub(residues[i], key)
        i = i + 1
    plaintext

let crypto_verify() =
    let pt = arr_new_n(3)
    pt[0] = 100
    pt[1] = 200
    pt[2] = 300
    let ct = crypto_encrypt(pt, 42, 1)
    let dt = crypto_decrypt(ct, 42, 1)
    let ok = 1
    let i = 0
    for i < 3
        if dt[i] != pt[i]
            ok = 0
        i = i + 1
    ok

