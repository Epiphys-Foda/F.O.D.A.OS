let rk_mulmod(a, b, p) =
    let r = 0
    let x = a % p
    let y = b
    for y > 0
        if y % 2 == 1
            r = (r + x) % p
        x = (x + x) % p
        y = y / 2
    r

let rk_powmod(base, exp, p) =
    let r = 1
    let b = base % p
    let e = exp
    for e > 0
        if e % 2 == 1
            r = rk_mulmod(r, b, p)
        b = rk_mulmod(b, b, p)
        e = e / 2
    r

let rk_inv(a, p) = rk_powmod(a, p - 2, p)

let rk_norm(a, p) =
    if a < 0
        (a % p + p) % p
    else
        a % p

