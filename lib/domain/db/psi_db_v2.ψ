let rk_scan(db, pred, arg) =
    let cnt = 0
    let sum = 0
    let rk = db[6]
    let lv = db[8]
    let i = 0
    for i < db[0]
        if lv[i] == 1
            let take = 0
            if pred == RK_EQ
                if rk[i] == arg
                    take = 1
            if pred == RK_NEQ
                if rk[i] != arg
                    take = 1
            if pred == RK_LT
                if rk[i] < arg
                    take = 1
            if pred == RK_GT
                if rk[i] > arg
                    take = 1
            if pred == RK_LE
                if rk[i] <= arg
                    take = 1
            if pred == RK_GE
                if rk[i] >= arg
                    take = 1
            if take == 1
                cnt = cnt + 1
                sum = (sum + rk[i]) % RK_P1
        i = i + 1
    [cnt, sum]

