        rk_wal_add(db, RK_OP_PUT, key, val, ver)
    else
        let s = rk_slot(db, key)
        let i = 0
        let j = 0 - 1
        let free = 0 - 1
        let done = 0
        for done == 0
            let t = (s + i) % cap
            if lv[t] == LV_VIRGIN
                if free < 0
                    free = t
                done = 1
            else
