let TX_CO_INIT = 0
let TX_CO_PREPARING = 1
let TX_CO_PREPARED = 2
let TX_CO_COMMITTING = 3
let TX_CO_COMMITTED = 4
let TX_CO_ABORTING = 5
let TX_CO_ABORTED = 6

let TX_PAR_IDLE = 0
let TX_PAR_PREPARING = 1
let TX_PAR_PREPARED = 2
let TX_PAR_COMMITTED = 3
let TX_PAR_ABORTED = 4

let participant_new(id) =
    [id, "", TX_PAR_IDLE, 0, 0]

let par_id(p) = p[0]
let par_url(p) = p[1]
let par_state(p) = p[2]
let par_last_resp(p) = p[3]
let par_can_commit(p) = p[4]

let par_set_state(p, state) =
    p[2] = state
    p

let par_set_can_commit(p, can) =
    p[4] = can
    p

let par_set_last_resp(p, time) =
    p[3] = time
    p

let coordinator_new(tx_id, timeout) =
    [tx_id, [], TX_CO_INIT, [], 0, timeout]

let co_tx_id(c) = c[0]
let co_participants(c) = c[1]
let co_state(c) = c[2]
let co_log(c) = c[3]
let co_start(c) = c[4]
let co_timeout(c) = c[5]

let co_set_state(c, state) =
    c[2] = state
    c

let co_add_participant(c, p) =
    let parts = co_participants(c)
    parts.push(p)
    c[1] = parts
    c

let co_log_append(c, entry) =
    let log = co_log(c)
    log.push(entry)
    c[3] = log
    c

let phase1_prepare(c, current_time) =
    co_set_state(c, TX_CO_PREPARING)
    co_log_append(c, ["prepare_start", current_time])
    let parts = co_participants(c)
    let all_yes = 1
    let i = 0
    let n = len(parts)
    for i < n
        let p = parts[i]
        par_set_state(p, TX_PAR_PREPARING)
        par_set_can_commit(p, 1)
        par_set_last_resp(p, current_time)
        if par_can_commit(p) == 0
            all_yes = 0
            i = n
        par_set_state(p, TX_PAR_PREPARED)
        i = i + 1
    if all_yes == 1
        co_set_state(c, TX_CO_PREPARED)
        co_log_append(c, ["prepare_done", current_time, "all_yes"])
        1
    else
        co_set_state(c, TX_CO_ABORTING)
        co_log_append(c, ["prepare_done", current_time, "some_no"])
        0

let phase2_commit(c, current_time) =
    co_set_state(c, TX_CO_COMMITTING)
    co_log_append(c, ["commit_start", current_time])
    let parts = co_participants(c)
    let i = 0
    let n = len(parts)
    for i < n
        par_set_state(parts[i], TX_PAR_COMMITTED)
        i = i + 1
    co_set_state(c, TX_CO_COMMITTED)
    co_log_append(c, ["commit_done", current_time])
    1

let phase2_abort(c, current_time) =
    co_set_state(c, TX_CO_ABORTING)
    co_log_append(c, ["abort_start", current_time])
    let parts = co_participants(c)
    let i = 0
    let n = len(parts)
    for i < n
        par_set_state(parts[i], TX_PAR_ABORTED)
        i = i + 1
    co_set_state(c, TX_CO_ABORTED)
    co_log_append(c, ["abort_done", current_time])
    0

let two_phase_commit(c, current_time) =
    let prepare_ok = phase1_prepare(c, current_time)
    if prepare_ok == 1
        phase2_commit(c, current_time)
    else
        phase2_abort(c, current_time)

let check_timeout(c, current_time) =
    let elapsed = current_time - co_start(c)
    if elapsed > co_timeout(c)
        if co_state(c) == TX_CO_PREPARING
            phase2_abort(c, current_time)
            1
        else
            0
    else
        0

let tcc_participant_new(id, try_fn, confirm_fn, cancel_fn) =
    [id, try_fn, confirm_fn, cancel_fn, 0, 0]

let tcc_par_id(p) = p[0]
let tcc_par_try(p) = p[1]
let tcc_par_confirm(p) = p[2]
let tcc_par_cancel(p) = p[3]
let tcc_par_state(p) = p[4]
let tcc_par_result(p) = p[5]

let tcc_try(participants) =
    let all_ok = 1
    let tried = []
    let i = 0
    let n = len(participants)
    for i < n
        let p = participants[i]
        p[4] = 1
        p[5] = 1
        tried.push(p)
        if p[5] == 0
            all_ok = 0
            i = n
        i = i + 1
    [all_ok, tried]

let tcc_confirm(participants) =
    let all_ok = 1
    let i = 0
    let n = len(participants)
    for i < n
        let p = participants[i]
        if p[4] == 1
            p[4] = 2
        i = i + 1
    all_ok

let tcc_cancel(participants) =
    let i = 0
    let n = len(participants)
    for i < n
        let p = participants[i]
        if p[4] == 1
            p[4] = 3
        i = i + 1
    1

let tcc_execute(participants) =
    let try_result = tcc_try(participants)
    if try_result[0] == 1
        tcc_confirm(participants)
        1
    else
        tcc_cancel(try_result[1])
        0

let idempotency_new() =
    {}

let idem_check(store, tx_id, op) =
    let key = tx_id * 65537 + op
    let result = store[key]
    if result == 0
        0
    else
        result

let idem_record(store, tx_id, op, result) =
    let key = tx_id * 65537 + op
    store[key] = result
    store

let recover_from_log(c) =
    let log = co_log(c)
    let last_state = TX_CO_INIT
    let i = 0
    let n = len(log)
    for i < n
        let entry = log[i]
        let event = entry[0]
        if event == "prepare_start"
            last_state = TX_CO_PREPARING
        else
            0
        if event == "prepare_done"
            if entry[2] == "all_yes"
                last_state = TX_CO_PREPARED
            else
                last_state = TX_CO_ABORTING
        else
            0
        if event == "commit_start"
            last_state = TX_CO_COMMITTING
        else
            0
        if event == "commit_done"
            last_state = TX_CO_COMMITTED
        else
            0
        if event == "abort_start"
            last_state = TX_CO_ABORTING
        else
            0
        if event == "abort_done"
            last_state = TX_CO_ABORTED
        i = i + 1
    if last_state == TX_CO_PREPARED
        co_set_state(c, TX_CO_COMMITTING)
        1
    else
        0
    if last_state == TX_CO_ABORTING
        co_set_state(c, TX_CO_ABORTING)
        2
    else
        co_set_state(c, last_state)
        0

