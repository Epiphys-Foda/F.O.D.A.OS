let field_index_build(keys, values, n, poles, residues) =
    let i = 0
    for i < n
        poles[i] = 127 + i * 1000
        residues[i] = values[i]
        i = i + 1

let field_index_query(poles, residues, n, key) =
    let z = key
    let val = 0
    let j = 0
    for j < n
        let diff = (z + 65537 - poles[j]) % 65537
        let inv_diff = gf_inv(diff)
        val = gf_add(val, gf_mul(residues[j], inv_diff))
        j = j + 1
    val

