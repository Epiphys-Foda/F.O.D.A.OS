let spatial_index_put(grid, x, y, value, grid_size) =
    let cell = (gf_norm(x) % grid_size) * grid_size + (gf_norm(y) % grid_size)
    let bucket = grid[cell]
    bucket.push([x, y, value])
    grid[cell] = bucket
    grid
