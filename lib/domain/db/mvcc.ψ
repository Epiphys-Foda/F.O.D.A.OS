    let ok7 = 1
    tx3 = tx_commit(tx3)
    if mvcc_tx_status(tx3) != 1
        ok7 = 0
    status_map[2] = 1

    let ok8 = 1
    let tx4 = tx_begin_mvcc(table, ISO_READ_COMMITTED)
    let new_v = mvcc_select(table, tx4, "alice", status_map)
    if new_v == 0
        ok8 = 0
    let new_data = ver_data(new_v)
    if new_data["age"] != 31
