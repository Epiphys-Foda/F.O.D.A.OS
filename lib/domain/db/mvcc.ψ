        ok4 = 0

    let ok5 = 1
    let tx3 = tx_begin_mvcc(table, ISO_READ_COMMITTED)
    let updated = mvcc_update(table, tx3, "alice", {name: "alice", age: 31}, status_map)
    if updated == 0
        ok5 = 0
    if ver_xmin(updated) != 2
