    let n = len(after_keys)
    for i < n
        if after_keys[i] == "alice"
            still_exists = 1
        i = i + 1
    if still_exists != 1
        ok11 = 0

    let ok12 = 1
    if tx_isolation_name(tx1) != "read_committed"
        ok12 = 0
    if tx_isolation_name(tx2) != "repeatable_read"
        ok12 = 0

    let all_ok = ok1 * ok2 * ok3 * ok4 * ok5 * ok6 * ok7 * ok8 * ok9 * ok10 * ok11 * ok12
