import "../domain_field.ψ"

let DW_TYPE_INT = 0
let DW_TYPE_STRING = 1
let DW_TYPE_FLOAT = 2
let DW_TYPE_BOOL = 3

let DW_DEFAULT_MAX_COLUMNS = 64
let DW_DEFAULT_MAX_ROWS = 1024

let dw_schema_new() = [[], 0, []]

let dw_schema_columns(s) = s[0]
let dw_schema_pk(s) = s[1]
let dw_schema_indexes(s) = s[2]

let dw_schema_set_columns(s, c) = [c, s[1], s[2]]
let dw_schema_set_pk(s, p) = [s[0], p, s[2]]
let dw_schema_set_indexes(s, i) = [s[0], s[1], i]

let dw_schema_add_column(s, name, kind) =
    let cols = dw_schema_columns(s)
    cols.push([name, kind])
    dw_schema_set_columns(s, cols)

let dw_table_new(name, is_dimension) =
    [name, dw_schema_new(), [], is_dimension, {}]

let dw_table_name(t) = t[0]
let dw_table_schema(t) = t[1]
let dw_table_rows(t) = t[2]
let dw_table_is_dimension(t) = t[3]
let dw_table_indexes(t) = t[4]

let dw_table_set_schema(t, s) = [t[0], s, t[2], t[3], t[4]]
let dw_table_set_rows(t, r) = [t[0], t[1], r, t[3], t[4]]
let dw_table_set_indexes(t, i) = [t[0], t[1], t[2], t[3], i]

let dw_table_add_column(t, name, kind) =
    let schema = dw_table_schema(t)
    schema = dw_schema_add_column(schema, name, kind)
    dw_table_set_schema(t, schema)

let dw_table_insert(t, row) =
    let rows = dw_table_rows(t)
    rows.push(row)
    let indexes = dw_table_indexes(t)
    let idx_cols = dw_schema_indexes(dw_table_schema(t))
    let i = 0
    let n = len(idx_cols)
    for i < n
        let col_idx = idx_cols[i]
        let key = col_idx * 65536 + row[col_idx]
        indexes[key] = len(rows) - 1
        i = i + 1
    let t2 = dw_table_set_rows(t, rows)
    t2 = dw_table_set_indexes(t2, indexes)
    t2

let dw_table_scan(t, filter) =
    let rows = dw_table_rows(t)
    let result = []
    let i = 0
    let n = len(rows)
    for i < n
        let row = rows[i]
        let matches = 1
        if filter != 0
            if row[filter[0]] != filter[1]
                matches = 0
        if matches == 1
            result.push(row)
        i = i + 1
    result

let dw_table_aggregate(t, group_col, agg_col, agg_type) =
    let rows = dw_table_rows(t)
    let groups = {}
    let i = 0
    let n = len(rows)
    for i < n
        let row = rows[i]
        let key = row[group_col]
        let val = 0
        if agg_type == 0
            val = row[agg_col]
        else
            if agg_type == 1
                val = 1
            else
                if agg_type == 2
                    val = row[agg_col]
        let cur = groups[key]
        if cur == 0
            if agg_type == 2
                groups[key] = [val, 1]
            else
                groups[key] = val
        else
            if agg_type == 2
                groups[key] = [cur[0] + val, cur[1] + 1]
            else
                groups[key] = cur + val
        i = i + 1
    let keys = keys_of(groups)
    let result = []
    i = 0
    let nk = len(keys)
    for i < nk
        let k = keys[i]
        let v = groups[k]
        if agg_type == 2
            v = v[0] / v[1]
        result.push([k, v])
        i = i + 1
    result

let dw_table_join(fact, dim, fact_key_col, dim_pk_col) =
    let fact_rows = dw_table_rows(fact)
    let dim_rows = dw_table_rows(dim)
    let dim_dict = {}
    let i = 0
    let n = len(dim_rows)
    for i < n
        dim_dict[dim_rows[i][dim_pk_col]] = dim_rows[i]
        i = i + 1
    let result = []
    i = 0
    n = len(fact_rows)
    for i < n
        let fact_row = fact_rows[i]
        let dim_row = dim_dict[fact_row[fact_key_col]]
        if dim_row != 0
            result.push([fact_row, dim_row])
        i = i + 1
    result

let dw_new() = [{}, {}, []]

let dw_tables(dw) = dw[0]
let dw_views(dw) = dw[1]
let dw_etl_log(dw) = dw[2]

let dw_set_tables(dw, t) = [t, dw[1], dw[2]]
let dw_set_views(dw, v) = [dw[0], v, dw[2]]
let dw_set_etl_log(dw, l) = [dw[0], dw[1], l]

let dw_create_table(dw, table) =
    let tables = dw_tables(dw)
    tables[dw_table_name(table)] = table
    dw_set_tables(dw, tables)

let dw_get_table(dw, name) =
    let tables = dw_tables(dw)
    tables[name]

let dw_bragg_verify_aggregate(t, group_col, agg_col, agg_type, expected) =
    let result = dw_table_aggregate(t, group_col, agg_col, agg_type)
    let i = 0
    let n = len(result)
    let pass = 1
    for i < n
        let found = 0
        let j = 0
        let m = len(expected)
        for j < m
            if expected[j][0] == result[i][0]
                if expected[j][1] == result[i][1]
                    found = 1
                    j = m
                else
                    j = m + 1
            j = j + 1
        if found == 0
            pass = 0
            i = n
        i = i + 1
    pass

let dw_bragg_verify_join(fact, dim, fact_key_col, dim_pk_col, expected_count) =
    let result = dw_table_join(fact, dim, fact_key_col, dim_pk_col)
    if len(result) == expected_count
        1
    else
        0

let dw_self_test() =
    let results = []

    let fact = dw_table_new("sales", 0)
    fact = dw_table_add_column(fact, "id", DW_TYPE_INT)
    fact = dw_table_add_column(fact, "product_id", DW_TYPE_INT)
    fact = dw_table_add_column(fact, "amount", DW_TYPE_INT)
    fact = dw_table_insert(fact, [1, 100, 500])
    fact = dw_table_insert(fact, [2, 101, 300])
    fact = dw_table_insert(fact, [3, 100, 200])
    results.push(len(dw_table_rows(fact)) == 3)

    let dim = dw_table_new("products", 1)
    dim = dw_table_add_column(dim, "id", DW_TYPE_INT)
    dim = dw_table_add_column(dim, "name", DW_TYPE_STRING)
    dim = dw_table_insert(dim, [100, "Widget"])
    dim = dw_table_insert(dim, [101, "Gadget"])

    let agg_result = dw_table_aggregate(fact, 1, 2, 0)
    let expected = [[100, 700], [101, 300]]
    results.push(dw_bragg_verify_aggregate(fact, 1, 2, 0, expected))

    let join_result = dw_table_join(fact, dim, 1, 0)
    results.push(len(join_result) == 3)

    results.push(dw_bragg_verify_join(fact, dim, 1, 0, 3))

    let count_result = dw_table_aggregate(fact, 1, 2, 1)
    results.push(len(count_result) == 2)

    results

