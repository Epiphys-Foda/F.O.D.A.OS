let pc_pages(pc) = pc[0]
let pc_max(pc) = pc[1]
let pc_hits(pc) = pc[2]

let pc_get(pc, key) =
    let pages = pc_pages(pc)
    let page = pages[key]
    if page == 0
        0
    else
        pc[2] = pc[2] + 1
        page

let pc_put(pc, key, data) =
    let pages = pc_pages(pc)
    pages[key] = data
    if pc_max(pc) > 0
        if len(keys_of(pages)) > pc_max(pc)
            let keys = keys_of(pages)
            pages[keys[0]] = 0
    pc[0] = pages
    pc

let pc_invalidate(pc, key) =
    let pages = pc_pages(pc)
    pages[key] = 0
    pc[0] = pages
    pc
