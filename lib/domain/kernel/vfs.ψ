let vfs_path_split(path) =
    let parts = []
    let current = ""
    let i = 1
    let n = len(path)
    for i < n
        let c = path[i]
        if c == "/"
            if current != ""
                parts.push(current)
                current = ""
            else
                0
            current = current + c
        i = i + 1
    if current != ""
        parts.push(current)
    parts

let vfs_resolve_path(v, path) =
    if path == "/" || path == ""
        vfs_get_inode(v, vfs_root_id(v))
    else
        let parts = vfs_path_split(path)
        let current = vfs_get_inode(v, vfs_root_id(v))
        let i = 0
        let n = len(parts)
        let found = current
        let ok = 1
        for i < n
            if ino_is_dir(current) == 1
                let child_id = ino_get_child(current, parts[i])
                if child_id == 0
                    ok = 0
                    i = n
                else
                    current = vfs_get_inode(v, child_id)
                    if current == 0
                        ok = 0
                        i = n
                    else
                        found = current
            else
                ok = 0
                i = n
            i = i + 1
        if ok == 1
            found
        else
            0

let vfs_create(v, parent_path, name) =
    let parent = vfs_resolve_path(v, parent_path)
    if parent == 0
        0
    else
        if ino_is_dir(parent) == 0
            0
        else
            let id = vfs_alloc_inode_id(v)
            let new_node = vfs_inode_new(id, name, 0)
            new_node[5] = ino_id(parent)
            let inodes = vfs_inodes(v)
            inodes[id] = new_node
            parent = ino_add_child(parent, name, id)
            inodes[ino_id(parent)] = parent
            v[0] = inodes
            new_node

