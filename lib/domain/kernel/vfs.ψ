let vfs_open(v, path, mode) =
    let node = vfs_resolve_path(v, path)
    if node == 0
        if mode == 1 || mode == 2
            let parent_path = str_slice_to(path, str_rfind(path, "/"))
            let name = str_slice_from(path, str_rfind(path, "/") + 1)
            node = vfs_create(v, parent_path, name)
            if node == 0
                return -1
            else
                0
            return -1
    let fd_num = len(keys_of(vfs_fds(v)))
    let handle = [fd_num, ino_id(node), 0, mode, 0]
    let fds = vfs_fds(v)
    fds[fd_num] = handle
    v[3] = fds
    fd_num

let str_rfind(s, ch) =
    let i = len(s) - 1
    let found = -1
    for i >= 0
        if s[i] == ch
            found = i
            i = -1
        i = i - 1
    found

let vfs_fd_read(v, fd_num, count) =
    let fds = vfs_fds(v)
    let handle = fds[fd_num]
    if handle == 0
        []
    else
        let inode = vfs_get_inode(v, handle[1])
        let offset = handle[2]
        let data = ino_data(inode)
        let result = []
        let i = 0
        for i < count
            if offset + i < len(data)
                result.push(data[offset + i])
            i = i + 1
        handle[2] = offset + len(result)
        fds[fd_num] = handle
        v[3] = fds
        result

let vfs_fd_write(v, fd_num, data) =
    let fds = vfs_fds(v)
    let handle = fds[fd_num]
    if handle == 0
        0
    else
        let inode = vfs_get_inode(v, handle[1])
        let offset = handle[2]
        let old_data = ino_data(inode)
        let new_data = []
        let i = 0
        let n = len(old_data)
        for i < n
            new_data.push(old_data[i])
            i = i + 1
        i = 0
        let dn = len(data)
        for i < dn
            if offset + i < len(new_data)
                new_data[offset + i] = data[i]
            else
                new_data.push(data[i])
            i = i + 1
        inode = ino_set_data(inode, new_data)
        let inodes = vfs_inodes(v)
        inodes[handle[1]] = inode
        v[0] = inodes
        handle[2] = offset + len(data)
        fds[fd_num] = handle
        v[3] = fds
        len(data)

let vfs_close(v, fd_num) =
    let fds = vfs_fds(v)
    let existed = 0
    if fds[fd_num] != 0
        existed = 1
    fds[fd_num] = 0
    v[3] = fds
    existed

let vfs_lseek(v, fd_num, offset, whence) =
    let fds = vfs_fds(v)
    let handle = fds[fd_num]
    if handle == 0
        -1
    else
        let inode = vfs_get_inode(v, handle[1])
        let new_offset = offset
        if whence == 1
            new_offset = handle[2] + offset
        else
            0
        if whence == 2
            new_offset = ino_size(inode) + offset
        handle[2] = new_offset
        fds[fd_num] = handle
        v[3] = fds
        new_offset

