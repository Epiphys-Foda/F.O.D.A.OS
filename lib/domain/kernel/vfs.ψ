let vfs_find_mount(v, path) =
    let mounts = vfs_mounts(v)
    let keys = keys_of(mounts)
    let best = ""
    let i = 0
    let n = len(keys)
    for i < n
        let k = keys[i]
        if str_starts_with(path, k) == 1
            if len(k) > len(best)
                best = k
        i = i + 1
    if best == ""
        0
    else
        [best, mounts[best]]

