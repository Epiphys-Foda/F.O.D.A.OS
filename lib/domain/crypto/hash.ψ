import "../../core/stdlib_lang2/gf_base.ψ"

let HASH_BLOCK_SIZE = 64
let HASH_OUTPUT_SIZE = 32
let HASH_INIT_VALUE  = 0x12345678
let HASH_MULTIPLIER  = 31

let hash_simple(data) =
    let h = HASH_INIT_VALUE
    let i = 0
    let n = len(data)
    for i < n
        h = gf_add(gf_mul(h, HASH_MULTIPLIER), data[i])
        h = gf_add(h, gf_pow(h, 2))
        i = i + 1
    h
let hash_double(data) = gf_pow(hash_simple(data), 2)
let hash_triple(data) = hash_simple([hash_double(data)])
let merkle_leaf(data) = hash_simple(data)
let merkle_parent(left, right) = hash_simple([left, right])
let merkle_tree_build(leaves) =
    let tree = [leaves]
    let current = leaves
    for len(current) > 1
        let next = []
        let i = 0
        let n = len(current)
        for i < n
            if i + 1 < n
                next.push(merkle_parent(current[i], current[i + 1]))
            else
                next.push(merkle_parent(current[i], 0))
            i = i + 2
        tree.push(next)
        current = next
    tree
let merkle_root(tree) =
    let top = tree[tree.len() - 1]
    (len(top) > 0 ? top[0] : 0)
let merkle_proof(tree, index) =
    let proof = []
    let level = 0
    let idx = index
    for level < len(tree) - 1
        let current_level = tree[level]
        let sibling_idx = 0
        (idx % 2 == 0 ? (sibling_idx = idx + 1) : (sibling_idx = idx - 1))
        if sibling_idx < len(current_level)
            proof.push([current_level[sibling_idx], idx % 2])
        else
            proof.push([0, idx % 2])
        idx = idx / 2
        level = level + 1
    proof
let merkle_verify(root, leaf, proof, index) =
    let current = leaf
    let i = 0
    let n = len(proof)
    for i < n
        let sibling = proof[i][0]
        let is_right = proof[i][1]
        if is_right == 0
            current = merkle_parent(current, sibling)
        else
            current = merkle_parent(sibling, current)
        i = i + 1
    (current == root ? 1 : 0)
let hash_commit(value, randomness) = hash_simple([value, randomness])
let hash_open(commitment, value, randomness) =
    (hash_commit(value, randomness) == commitment ? 1 : 0)
let field_hash(data, n, z) =
    let val = 0
    let i = 0
    for i < n
        let pole = 127 + i * 1000
        let diff = (z + 65537 - pole) % 65537
        val = gf_add(val, gf_mul(data[i], gf_inv(diff)))
        i = i + 1
    val

