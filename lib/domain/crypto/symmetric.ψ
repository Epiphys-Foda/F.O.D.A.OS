import "../domain_field.ψ"

let CRYPTO_P = 65537
let BLOCK_SIZE = 4

let sbox_generate(key) =
    let sbox = {}
    let k1 = (key % 256) + 1
    let k2 = (key / 256) + 1
    let i = 0
    for i < 256
        let inv = gf_inv(i + 1)
        let sub = gf_mul(inv % CRYPTO_P, k1)
        sub = gf_add(sub % CRYPTO_P, k2)
        sbox[i] = sub % 256
        i = i + 1
    sbox

let sbox_inverse(sbox) =
    let inv = {}
    let keys = keys_of(sbox)
    let i = 0
    let n = len(keys)
    for i < n
        let k = keys[i]
        inv[sbox[k]] = k
        i = i + 1
    inv

let sbox_lookup(sbox, val) =
    let idx = val % 256
    let v = sbox[idx]
    if v == 0
        idx
    else
        v

let key_schedule(master_key, rounds) =
    let keys = []
    let seed = master_key % CRYPTO_P
    let i = 0
    for i < rounds
        let round_key = []
        let j = 0
        for j < BLOCK_SIZE
            seed = gf_mul(seed + i * 31 + j * 17, 56187) % CRYPTO_P
            round_key.push(seed % 256)
            j = j + 1
        keys.push(round_key)
        i = i + 1
    keys

let block_encrypt(plain_block, sbox, round_keys, rounds) =
    let state = plain_block
    let i = 0
    for i < rounds
        let j = 0
        for j < BLOCK_SIZE
            state[j] = sbox_lookup(sbox, state[j])
            j = j + 1
        if BLOCK_SIZE > 1
            let first = state[0]
            j = 0
            for j < BLOCK_SIZE - 1
                state[j] = state[j + 1]
                j = j + 1
            state[BLOCK_SIZE - 1] = first
        if BLOCK_SIZE >= 2
            let a = state[0]
            let b = state[1]
            state[0] = gf_mul(gf_add(a, b), 3)
            state[1] = gf_mul(gf_sub(a, b), 5)
        let rk = round_keys[i]
        j = 0
        for j < BLOCK_SIZE
            state[j] = gf_add(state[j] % CRYPTO_P, rk[j]) % 256
            j = j + 1
        i = i + 1
    state

let block_decrypt(cipher_block, sbox_inv, round_keys, rounds) =
    let state = cipher_block
    let i = rounds - 1
    for i >= 0
        let rk = round_keys[i]
        let j = 0
        for j < BLOCK_SIZE
            state[j] = gf_sub(state[j] % CRYPTO_P, rk[j]) % 256
            j = j + 1
        if BLOCK_SIZE >= 2
            let a = state[0]
            let b = state[1]
            let inv3 = gf_inv(3)
            let inv5 = gf_inv(5)
            let sum = gf_mul(gf_add(a, b), inv3)
            let diff = gf_mul(gf_sub(a, b), inv5)
            state[0] = (sum + diff) / 2
            state[1] = (sum - diff) / 2
        if BLOCK_SIZE > 1
            let last = state[BLOCK_SIZE - 1]
            j = BLOCK_SIZE - 1
            for j > 0
                state[j] = state[j - 1]
                j = j - 1
            state[0] = last
        j = 0
        for j < BLOCK_SIZE
            state[j] = sbox_lookup(sbox_inv, state[j])
            j = j + 1
        i = i - 1
    state

let ecb_encrypt(plaintext, sbox, round_keys, rounds) =
    let cipher = []
    let i = 0
    let n = len(plaintext)
    for i < n
        let block = []
        let j = 0
        for j < BLOCK_SIZE
            if i + j < n
                block.push(plaintext[i + j])
            else
                block.push(0)
            j = j + 1
        let enc = block_encrypt(block, sbox, round_keys, rounds)
        j = 0
        for j < BLOCK_SIZE
            cipher.push(enc[j])
            j = j + 1
        i = i + BLOCK_SIZE
    cipher

let ecb_decrypt(ciphertext, sbox_inv, round_keys, rounds) =
    let plain = []
    let i = 0
    let n = len(ciphertext)
    for i < n
        let block = []
        let j = 0
        for j < BLOCK_SIZE
            block.push(ciphertext[i + j])
            j = j + 1
        let dec = block_decrypt(block, sbox_inv, round_keys, rounds)
        j = 0
        for j < BLOCK_SIZE
            plain.push(dec[j])
            j = j + 1
        i = i + BLOCK_SIZE
    plain

let cbc_encrypt(plaintext, iv, sbox, round_keys, rounds) =
    let cipher = []
    let prev = iv
    let i = 0
    let n = len(plaintext)
    for i < n
        let block = []
        let j = 0
        for j < BLOCK_SIZE
            let pt = 0
            if i + j < n
                pt = plaintext[i + j]
            block.push(gf_add(pt, prev[j]))
            j = j + 1
        let enc = block_encrypt(block, sbox, round_keys, rounds)
        j = 0
        for j < BLOCK_SIZE
            cipher.push(enc[j])
            prev[j] = enc[j]
            j = j + 1
        i = i + BLOCK_SIZE
    cipher

let cbc_decrypt(ciphertext, iv, sbox_inv, round_keys, rounds) =
    let plain = []
    let prev = iv
    let i = 0
    let n = len(ciphertext)
    for i < n
        let block = []
        let j = 0
        for j < BLOCK_SIZE
            block.push(ciphertext[i + j])
            j = j + 1
        let dec = block_decrypt(block, sbox_inv, round_keys, rounds)
        j = 0
        for j < BLOCK_SIZE
            plain.push(gf_sub(dec[j], prev[j]))
            prev[j] = ciphertext[i + j]
            j = j + 1
        i = i + BLOCK_SIZE
    plain

let ctr_encrypt(plaintext, nonce, sbox, round_keys, rounds, counter_start) =
    let cipher = []
    let counter = counter_start
    let i = 0
    let n = len(plaintext)
    for i < n
        let ctr_block = [nonce, counter, 0, 0]
        let keystream = block_encrypt(ctr_block, sbox, round_keys, rounds)
        let j = 0
        for j < BLOCK_SIZE
            if i + j < n
                cipher.push(gf_add(plaintext[i + j], keystream[j]))
            j = j + 1
        counter = counter + 1
        i = i + BLOCK_SIZE
    cipher

let ctr_decrypt(ciphertext, nonce, sbox, round_keys, rounds, counter_start) =
    ctr_encrypt(ciphertext, nonce, sbox, round_keys, rounds, counter_start)

let hmac_compute(key, message, hash_fn) =
    let block_size = 64
    let k = key
    if len(key) > block_size
        k = hash_fn(key)
    let ipad = []
    let opad = []
    let i = 0
    for i < block_size
        ipad.push(0x36)
        opad.append(0x5C)
        i = i + 1
    let k_ipad = []
    let k_opad = []
    i = 0
    let kl = len(k)
    for i < block_size
        let ki = 0
        if i < kl
            ki = k[i]
        k_ipad.push(gf_add(ki, ipad[i]))
        k_opad.push(gf_add(ki, opad[i]))
        i = i + 1
    let inner_input = k_ipad + message
    let inner_hash = hash_fn(inner_input)
    let outer_input = k_opad + inner_hash
    hash_fn(outer_input)

let pbkdf2(password, salt, iterations, dk_len) =
    let derived = []
    let i = 0
    for i < dk_len
        let u = password + salt + i
        let j = 0
        for j < iterations
            let h = 0
            let k = 0
            let n = len(u)
            for k < n
                h = (h * 31 + u[k]) % CRYPTO_P
                k = k + 1
            u = [h]
            j = j + 1
        derived.push(u[0] % 256)
        i = i + 1
    derived
