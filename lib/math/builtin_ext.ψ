let range_step(start, end, step) =
    let result = []
    let i = start
    if step > 0
        for i < end
            result.push(i)
            i = i + step
    else
        0
    if step < 0
        for i > end
            result.push(i)
            i = i + step
    result

let amm_sqrt(a, p) =
    tonelli(a, p)

let amm_kth_root(a, k, p) =
    let amod = a - (a / p) * p
    if amod == 0
        0
    else
        let pm1 = p - 1
        let g = k
        let h = pm1
        for h != 0
            let t = g - (g / h) * h
            g = h
            h = t
        if g == 1
            let e = mod_inv(k, pm1)
            if e < 0
                e = e + pm1
            mod_pow(amod, e, p)
        else
            if k == 2
                tonelli(amod, p)
            else
                0

let amm_all_roots(a, k, p) =
    let r = amm_kth_root(a, k, p)
    if r == 0
        []
    else
        let roots = []
        roots.push(r)
        if k == 2
            if r != p - r
                roots.push(p - r)
        roots

