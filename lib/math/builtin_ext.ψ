let match_str(value, patterns, results, default_val) =
    let n = len(patterns)
    let i = 0
    let found = 0
    let result = default_val
    for i < n && found == 0
        if str_eq(value, patterns[i])
            result = results[i]
            found = 1
        i = i + 1
    result

let match_int(value, patterns, results, default_val) =
    let n = len(patterns)
    let i = 0
    let found = 0
    let result = default_val
    for i < n && found == 0
        if value == patterns[i]
            result = results[i]
            found = 1
        i = i + 1
    result

let factorial_tc(n) =
    let result = 1
    let i = n
    for i > 1
        result = result * i
        i = i - 1
    result

let fibonacci_tc(n) =
    if n == 0
        0
    else
        0
    if n == 1
        1
    else
        let prev = 0
        let curr = 1
        let i = 2
        for i <= n
            let next = prev + curr
            prev = curr
            curr = next
            i = i + 1
        curr

