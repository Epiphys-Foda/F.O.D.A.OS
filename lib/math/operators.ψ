let P = 65537

let gf_add(a, b) = domain_gf_add(a, b)
let gf_sub(a, b) = domain_gf_sub(a, b)
let gf_neg(a) = domain_gf_neg(a)
let gf_mul(a, b) = domain_gf_mul(a, b)
let gf_pow(base, exp) = domain_gf_pow(base, exp)
let gf_inv(a) = domain_gf_inv(a)
let gf_div(a, b) = domain_gf_div(a, b)

let prime_make(z, r, n) = [z, r, n]

let op_add(f1, f2) =
    let out = []
    let i = 0
    for i < len(f1)
        out.push(f1[i])
        i = i + 1
    let j = 0
    for j < len(f2)
        let p2 = f2[j]
        let found = 0
        let k = 0
        for k < len(out)
            let pk = out[k]
            if pk[0] == p2[0]
                if pk[2] == p2[2]
                    out[k] = prime_make(pk[0], (pk[1] + p2[1]) % P, pk[2])
                    found = 1
            k = k + 1
        if found == 0
            out.push(p2)
        j = j + 1
    out

let op_mul(f1, f2) =
    let out = []
    let i = 0
    for i < len(f1)
        let p1 = f1[i]
        let j = 0
        for j < len(f2)
            let p2 = f2[j]
            out.push(prime_make(gf_add(p1[0], p2[0]), gf_mul(p1[1], p2[1]), p1[2] + p2[2] - 1))
            j = j + 1
        i = i + 1
    out

let op_compose(outer, inner_field, z0) =
    let out = []
    let i = 0
    for i < len(outer)
        let p = outer[i]
        let new_z = 0
        let total = 0
        let j = 0
        for j < len(inner_field)
            let q = inner_field[j]
            let dz = gf_sub(z0, q[0])
            if dz == 0
                total = (total + q[1]) % P
            if dz != 0
                total = (total + gf_mul(q[1], gf_pow(gf_inv(dz), q[2]))) % P
            j = j + 1
        out.push(prime_make(total, p[1], p[2]))
        i = i + 1
    out

let op_equal(f1, f2) =
    let ok = 1
    if len(f1) != len(f2)
        ok = 0
    let i = 0
    for i < len(f1)
        if i < len(f2)
            if f1[i][0] != f2[i][0]
                ok = 0
            if f1[i][1] != f2[i][1]
                ok = 0
            if f1[i][2] != f2[i][2]
                ok = 0
        i = i + 1
    ok

let op_integrate(field) =
    let out = []
    let i = 0
    for i < len(field)
        let p = field[i]
        if p[2] > 1
            out.push(prime_make(p[0], gf_div(p[1], gf_neg(p[2] - 1)), p[2] - 1))
        i = i + 1
    out

let op_differentiate(field) =
    let out = []
    let i = 0
    for i < len(field)
        let p = field[i]
        let order = p[2]
        if order < 1
            order = 1
        out.push(prime_make(p[0], p[1] * gf_neg(order) % P, order + 1))
        i = i + 1
    out

let delta_n(field, n) =
    let result = field
    let i = 0
    for i < n
        result = op_differentiate(result)
        i = i + 1
    result

let nabla_n(field, n) =
    let result = field
    let i = 0
    for i < n
        result = op_integrate(result)
        i = i + 1
    result

let spectral(field, k) = delta_n(field, k)

