let verify_int_diff_inverse() =
    let f = [prime_make(10, 3, 1), prime_make(20, 7, 1)]
    let df = op_differentiate(f)
    let idf = op_integrate(df)
    op_equal(f, idf)

let verify_diff_linear() =
    let f = [prime_make(10, 3, 1)]
    let g = [prime_make(20, 7, 1)]
    let lhs = op_differentiate(op_add(f, g))
    let rhs = op_add(op_differentiate(f), op_differentiate(g))
    op_equal(lhs, rhs)

let verify_spectral() =
    let f = [prime_make(5, 2, 1)]
    let e0 = spectral(f, 0)
    let e1 = spectral(f, 1)
    let ok = 0
    if op_equal(e0, f) == 1
        if e1[0][2] == 2
            ok = 1
    ok

let verify_operators() =
    let r1 = verify_int_diff_inverse()
    let r2 = verify_diff_linear()
    let r3 = verify_spectral()
    r1 * r2 * r3
