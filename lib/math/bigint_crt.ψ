let crt_parse_literal(s) =
    let result = crt_zero()
    let n = len(s)
    let i = 0
    let chunk = 0
    let chunk_len = 0
    for i < n
        let c = s[i]
        if c >= 48 && c <= 57
            chunk = chunk * 10 + (c - 48)
            chunk_len = chunk_len + 1
            if chunk_len == 9
                let ten9 = crt_from_int(1000000000)
                result = crt_add(crt_mul(result, ten9), crt_from_int(chunk))
                chunk = 0
                chunk_len = 0
        i = i + 1
    if chunk_len > 0
        let pow10 = crt_from_int(1)
        let j = 0
        for j < chunk_len
            pow10 = crt_mul(pow10, crt_from_int(10))
            j = j + 1
        result = crt_add(crt_mul(result, pow10), crt_from_int(chunk))
    result

