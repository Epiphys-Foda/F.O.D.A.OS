let CRT_P0 = 65537
let CRT_P1 = 131071
let CRT_P2 = 786433
let CRT_P3 = 1376257

let _crt_mod(a, p) =
    let r = a - (a / p) * p
    r

let _crt_addmod(a, b, p) =
    let s = a + b
    _crt_mod(s, p)

let _crt_submod(a, b, p) =
    if a >= b
        a - b
    else
        a + p - b

let _crt_mulmod(a, b, p) =
    _crt_mod(a * b, p)

let _crt_powmod(base, exp, p) =
    let acc = 1
    let b = _crt_mod(base, p)
    let e = exp
    for e > 0
        if _crt_mod(e, 2) == 1
            acc = _crt_mulmod(acc, b, p)
        b = _crt_mulmod(b, b, p)
        e = e / 2
    acc

let _crt_invmod(a, p) =
    _crt_powmod(a, p - 2, p)

let crt_from_int(n) =
    if n < 0
        [0, 0, 0, 0]
    else
        [
            _crt_mod(n, CRT_P0),
            _crt_mod(n, CRT_P1),
            _crt_mod(n, CRT_P2),
            _crt_mod(n, CRT_P3)
        ]

let crt_zero() = [0, 0, 0, 0]

let crt_one() = [1, 1, 1, 1]

let crt_is_zero(a) =
    a[0] == 0 && a[1] == 0 && a[2] == 0 && a[3] == 0

let crt_is_one(a) =
    a[0] == 1 && a[1] == 1 && a[2] == 1 && a[3] == 1

let crt_add(a, b) =
    [
        _crt_addmod(a[0], b[0], CRT_P0),
        _crt_addmod(a[1], b[1], CRT_P1),
        _crt_addmod(a[2], b[2], CRT_P2),
        _crt_addmod(a[3], b[3], CRT_P3)
    ]

let crt_sub(a, b) =
    [
        _crt_submod(a[0], b[0], CRT_P0),
        _crt_submod(a[1], b[1], CRT_P1),
        _crt_submod(a[2], b[2], CRT_P2),
        _crt_submod(a[3], b[3], CRT_P3)
    ]

let crt_mul(a, b) =
