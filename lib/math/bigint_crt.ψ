        _crt_mulmod(a[2], b[2], CRT_P2),
        _crt_mulmod(a[3], b[3], CRT_P3)
    ]

let crt_neg(a) =
    [
        _crt_submod(0, a[0], CRT_P0),
        _crt_submod(0, a[1], CRT_P1),
        _crt_submod(0, a[2], CRT_P2),
        _crt_submod(0, a[3], CRT_P3)
    ]

let _garner2(r0, r1, p0, p1) =
    let t = _crt_submod(r1, _crt_mod(r0, p1), p1)
    let k = _crt_mulmod(t, _crt_invmod(p0, p1), p1)
    r0 + p0 * k

let crt_to_bi(a) =
    let r01 = _garner2(a[0], a[1], CRT_P0, CRT_P1)
    let m01 = CRT_P0 * CRT_P1
    let t2 = _crt_submod(a[2], _crt_mod(r01, CRT_P2), CRT_P2)
    let k2 = _crt_mulmod(t2, _crt_invmod(m01, CRT_P2), CRT_P2)
    let r012 = r01 + m01 * k2
    let m012 = m01 * CRT_P2
    let t3 = _crt_submod(a[3], _crt_mod(r012, CRT_P3), CRT_P3)
    let k3 = _crt_mulmod(t3, _crt_invmod(m012, CRT_P3), CRT_P3)
    let bi_r012 = bi_from_int(r012)
    let bi_m012 = bi_from_int(m012)
    let bi_k3 = bi_from_int(k3)
    let bi_prod = bi_mul(bi_m012, bi_k3)
    bi_add(bi_r012, bi_prod)

let crt_to_int(a) =
    bi_to_int(crt_to_bi(a))

let crt_to_str(a) =
    if crt_is_zero(a)
        "0"
    else
        bi_to_str(crt_to_bi(a))

let crt_cmp(a, b) =
    let va = crt_to_int(a)
    let vb = crt_to_int(b)
    if va >= 0 && vb >= 0
        if va > vb
            1
        else
            0
        if va < vb
            0 - 1
        else
            0
    else
        if a[0] == b[0] && a[1] == b[1] && a[2] == b[2] && a[3] == b[3]
            0
        else
            0 - 1

