let crt8_to_bi(a) =
    let t1 = _crt_submod(a[1], _crt_mod(a[0], CRT_P1), CRT_P1)
    let k1 = _crt_mulmod(t1, _crt_invmod(CRT_P0, CRT_P1), CRT_P1)
    let r01 = a[0] + CRT_P0 * k1
    let m01 = CRT_P0 * CRT_P1
    let t2 = _crt_submod(a[2], _crt_mod(r01, CRT_P2), CRT_P2)
    let k2 = _crt_mulmod(t2, _crt_invmod(m01, CRT_P2), CRT_P2)
    let r012 = r01 + m01 * k2
    let m012 = m01 * CRT_P2
    let t3 = _crt_submod(a[3], _crt_mod(r012, CRT_P3), CRT_P3)
    let k3 = _crt_mulmod(t3, _crt_invmod(m012, CRT_P3), CRT_P3)
    let bi_r = bi_add(bi_from_int(r012), bi_mul_small(bi_from_int(m012), k3))
    let bi_m = bi_mul_small(bi_from_int(m012), CRT_P3)
    let t4 = _crt_submod(a[4], bi_mod_small(bi_r, CRT_P4), CRT_P4)
    let k4 = _crt_mulmod(t4, _crt_invmod(bi_mod_small(bi_m, CRT_P4), CRT_P4), CRT_P4)
    bi_r = bi_add(bi_r, bi_mul_small(bi_m, k4))
    bi_m = bi_mul_small(bi_m, CRT_P4)
    let t5 = _crt_submod(a[5], bi_mod_small(bi_r, CRT_P5), CRT_P5)
    let k5 = _crt_mulmod(t5, _crt_invmod(bi_mod_small(bi_m, CRT_P5), CRT_P5), CRT_P5)
    bi_r = bi_add(bi_r, bi_mul_small(bi_m, k5))
    bi_m = bi_mul_small(bi_m, CRT_P5)
    let t6 = _crt_submod(a[6], bi_mod_small(bi_r, CRT_P6), CRT_P6)
    let k6 = _crt_mulmod(t6, _crt_invmod(bi_mod_small(bi_m, CRT_P6), CRT_P6), CRT_P6)
    bi_r = bi_add(bi_r, bi_mul_small(bi_m, k6))
    bi_m = bi_mul_small(bi_m, CRT_P6)
    let t7 = _crt_submod(a[7], bi_mod_small(bi_r, CRT_P7), CRT_P7)
    let k7 = _crt_mulmod(t7, _crt_invmod(bi_mod_small(bi_m, CRT_P7), CRT_P7), CRT_P7)
    bi_r = bi_add(bi_r, bi_mul_small(bi_m, k7))
    bi_r

