let gf_inv_mod(a) =
    let b = gf_canon(a)
    if b == 0
        0
    else
        let r = 1
        let e = 65535
        for e > 0
            if e % 2 == 1
                r = gf_canon(r * b)
            b = gf_canon(b * b)
            e = e / 2
        r

let gf_poly_trim(p) =
    let n = len(p)
    let end = n
    let done = 0
    for done == 0
        if end == 0
            done = 1
        else if p[end - 1] != 0
            done = 1
        else
            end = end - 1
    if end == 0
        arr_new()
    else
        let r = arr_new_n(end)
        let i = 0
        for i < end
            r[i] = p[i]
            i = i + 1
        r

let gf_poly_add(a, b) =
    let n = len(a)
    let m = len(b)
    let sz = n
    if m > n
        sz = m
    let r = arr_new_n(sz)
    let i = 0
    for i < n
        r[i] = gf_canon(a[i])
        i = i + 1
    let j = 0
    for j < m
        let bv = gf_canon(b[j])
        if j < sz
            r[j] = gf_canon(r[j] + bv)
        else
            r[j] = bv
        j = j + 1
    gf_poly_trim(r)

let gf_poly_mul(a, b) =
    let n = len(a)
    let m = len(b)
    if n == 0
        arr_new()
    else if m == 0
        arr_new()
    else
        let sz = n + m - 1
        let r = arr_new_n(sz)
        let i = 0
        for i < n
            let j = 0
            for j < m
                let av = gf_canon(a[i])
                let bv = gf_canon(b[j])
                r[i + j] = gf_canon(r[i + j] + av * bv)
                j = j + 1
            i = i + 1
        gf_poly_trim(r)

let gf_poly_eval(p, x) =
    let n = len(p)
    let r = 0
    let i = n - 1
    for i >= 0
        r = gf_canon(r * gf_canon(x) + gf_canon(p[i]))
        i = i - 1
    r

let gf_poly_deriv(p) =
    let n = len(p)
    if n <= 1
        arr_new()
    else
        let r = arr_new_n(n - 1)
        let i = 1
        for i < n
            let coef = gf_canon(p[i])
            r[i - 1] = gf_canon(i * coef)
            i = i + 1
        gf_poly_trim(r)

let gf_poly_integrate(p) =
    let n = len(p)
    if n == 0
        arr_new()
    else
        let r = arr_new_n(n + 1)
        r[0] = 0
        let i = 0
        for i < n
            let inv = gf_inv_mod(i + 1)
            r[i + 1] = gf_canon(gf_canon(p[i]) * inv)
            i = i + 1
        gf_poly_trim(r)

let gf_poly_divmod(a, b) =
    let db = len(b) - 1
    let da = len(a) - 1
    if db < 0
        [arr_new(), arr_new()]
    else if da < db
        [a, arr_new()]
    else
        let q = arr_new_n(da - db + 1)
        let r = arr_new_n(da + 1)
        let i = 0
        for i <= da
            r[i] = gf_canon(a[i])
            i = i + 1
        let inv_lead = gf_inv_mod(b[db])
        let k = da
        for k >= db
            let coef = gf_canon(r[k] * inv_lead)
            q[k - db] = coef
            let j = 0
            for j <= db
                r[k - db + j] = gf_canon(r[k - db + j] - coef * b[j])
                j = j + 1
            k = k - 1
        let qt = gf_poly_trim(q)
        let rt = gf_poly_trim(r)
        [qt, rt]

let gf_poly_gcd(a, b) =
    let bb = gf_poly_trim(b)
    if len(bb) == 0
        gf_poly_trim(a)
    else
        let dm = gf_poly_divmod(a, bb)
        gf_poly_gcd(bb, dm[1])

