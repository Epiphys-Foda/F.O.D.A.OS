let gf_poly_interp(xs, ys) =
    let n = len(xs)
    let r = arr_new_n(n)
    let i = 0
    for i < n
        let li = arr_new_n(1)
        li[0] = 1
        let denom = 1
        let j = 0
        for j < n
            if j != i
                let term = arr_new_n(2)
                term[0] = gf_canon(0 - xs[j])
                term[1] = 1
                li = gf_poly_mul(li, term)
                denom = gf_canon(denom * gf_canon(xs[i] - xs[j]))
            j = j + 1
        let scale = gf_canon(gf_inv_mod(denom) * ys[i])
        let k = 0
        for k < len(li)
            li[k] = gf_canon(li[k] * scale)
            k = k + 1
        r = gf_poly_add(r, li)
        i = i + 1
    r

