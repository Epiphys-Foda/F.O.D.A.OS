let sn_int(v) = [0, crt_from_int(v), 0]

let sn_rat(n, d) = sn_normalize([1, crt_from_int(n), crt_from_int(d)])

let sn_zero() = [0, crt_zero(), 0]
let sn_one() = [0, crt_one(), 0]

let sn_bigint(bi) = [2, bi, 0]

let sn_is_zero(a) =
    if a[0] == 0
        crt_is_zero(a[1])
    else
        crt_is_zero(a[1])

let sn_is_one(a) =
    if a[0] == 0
        crt_is_one(a[1])
    else
        0

let sn_normalize(a) =
    if a[0] == 0 || a[0] == 2 || a[0] == 3 || a[0] == 5
        a
    else
        let g = crt_gcd_bi(a[1], a[2])
        if bi_is_one(g)
            a
        else
            let num = crt_div_bi(a[1], g)
            let den = crt_div_bi(a[2], g)
            if a[0] == 4
                [4, num, den]
            else
                [1, num, den]

let sn_add(a, b) =
    if a[0] == 3 && b[0] == 3
        let sum = sn_add([0, a[1], 0], [0, b[1], 0])
        if sum[0] == 0
            [3, sum[1], 0]
        else
            0
        if sum[0] == 2
            [5, sum[1], 0]
        else
            sum
    else
        0
    if a[0] == 3 && b[0] == 0
        sn_sub([0, b[1], 0], [0, a[1], 0])
    else
        0
    if a[0] == 0 && b[0] == 3
        sn_sub([0, a[1], 0], [0, b[1], 0])
    else
        0
    if a[0] == 2 && b[0] == 2
        [2, bi_add(a[1], b[1]), 0]
    else
        0
    if a[0] == 2 && b[0] == 0
        [2, bi_add(a[1], crt_to_bi(b[1])), 0]
    else
        0
    if a[0] == 0 && b[0] == 2
        [2, bi_add(crt_to_bi(a[1]), b[1]), 0]
    else
        0
    if a[0] == 0 && b[0] == 0
        [0, crt_add(a[1], b[1]), 0]
    else
        0
    if a[0] == 1 && b[0] == 1
        let n1d2 = crt_mul(a[1], b[2])
        let n2d1 = crt_mul(b[1], a[2])
        let d1d2 = crt_mul(a[2], b[2])
        sn_normalize([1, crt_add(n1d2, n2d1), d1d2])
    else
        0
    if a[0] == 0 && b[0] == 1
        let iden = crt_mul(a[1], b[2])
        sn_normalize([1, crt_add(iden, b[1]), b[2]])
    else
        0
    if a[0] == 1 && b[0] == 0
        let iden = crt_mul(b[1], a[2])
        sn_normalize([1, crt_add(a[1], iden), a[2]])
    else
        [0, crt_add(a[1], b[1]), 0]

let sn_sub(a, b) =
    if a[0] == 2 && b[0] == 2
        let cmp = bi_cmp(a[1], b[1])
        if cmp >= 0
            [2, bi_sub(a[1], b[1]), 0]
        else
            [5, bi_sub(b[1], a[1]), 0]
    else
        0
    if a[0] == 0 && b[0] == 0
        let cmp = crt_cmp(a[1], b[1])
        if cmp >= 0
            [0, crt_sub(a[1], b[1]), 0]
        else
            [3, crt_sub(b[1], a[1]), 0]
    else
        0
    if a[0] == 1 && b[0] == 1
        let n1d2 = crt_mul(a[1], b[2])
        let n2d1 = crt_mul(b[1], a[2])
        let d1d2 = crt_mul(a[2], b[2])
        let cmp = crt_cmp(n1d2, n2d1)
        if cmp >= 0
            sn_normalize([1, crt_sub(n1d2, n2d1), d1d2])
        else
            sn_normalize([4, crt_sub(n2d1, n1d2), d1d2])
    else
        0
    if a[0] == 0 && b[0] == 1
        let iden = crt_mul(a[1], b[2])
        let cmp = crt_cmp(iden, b[1])
        if cmp >= 0
            sn_normalize([1, crt_sub(iden, b[1]), b[2]])
        else
            sn_normalize([4, crt_sub(b[1], iden), b[2]])
    else
        0
    if a[0] == 1 && b[0] == 0
        let iden = crt_mul(b[1], a[2])
        let cmp = crt_cmp(a[1], iden)
        if cmp >= 0
            sn_normalize([1, crt_sub(a[1], iden), a[2]])
        else
            sn_normalize([4, crt_sub(iden, a[1]), a[2]])
    else
        [0, crt_sub(a[1], b[1]), 0]

let sn_mul(a, b) =
    if a[0] == 2 && b[0] == 2
        [2, bi_mul(a[1], b[1]), 0]
    else
        0
    if a[0] == 2 && b[0] == 0
        [2, bi_mul(a[1], crt_to_bi(b[1])), 0]
    else
        0
    if a[0] == 0 && b[0] == 2
        [2, bi_mul(crt_to_bi(a[1]), b[1]), 0]
    else
        0
    if a[0] == 0 && b[0] == 0
        [0, crt_mul(a[1], b[1]), 0]
    else
        0
    if a[0] == 1 && b[0] == 1
        sn_normalize([1, crt_mul(a[1], b[1]), crt_mul(a[2], b[2])])
    else
        0
    if a[0] == 0 && b[0] == 1
        sn_normalize([1, crt_mul(a[1], b[1]), b[2]])
    else
        0
    if a[0] == 1 && b[0] == 0
        sn_normalize([1, crt_mul(a[1], b[1]), a[2]])
    else
        [0, crt_mul(a[1], b[1]), 0]

let sn_div(a, b) =
    if a[0] == 0 && b[0] == 0
        sn_normalize([1, a[1], b[1]])
    else
        0
    if a[0] == 1 && b[0] == 1
        sn_normalize([1, crt_mul(a[1], b[2]), crt_mul(a[2], b[1])])
    else
        0
    if a[0] == 0 && b[0] == 1
        sn_normalize([1, crt_mul(a[1], b[2]), b[1]])
    else
        0
    if a[0] == 1 && b[0] == 0
        sn_normalize([1, a[1], crt_mul(a[2], b[1])])
    else
        sn_normalize([1, a[1], b[1]])

let sn_to_q64(a) =
    if a[0] == 0
        crt_to_int(a[1])
    else
        0
    if a[0] == 1
        let n = crt_to_int(a[1])
        let d = crt_to_int(a[2])
        if d == 0
            0
        else
            n / d
    else
        crt_to_int(a[1])

let sn_to_str(a) =
    if a[0] == 0
        crt_to_str(a[1])
    else
        0
    if a[0] == 1
        let n_str = crt_to_str(a[1])
        let d_str = crt_to_str(a[2])
        let d_val = crt_to_int(a[2])
        if d_val == 1
            n_str
        else
            0
        if d_val == 0
            "inf"
        else
            n_str + "/" + d_str
    else
        0
    if a[0] == 2
        bi_to_str(a[1])
    else
        0
    if a[0] == 3
        "-" + crt_to_str(a[1])
    else
        0
    if a[0] == 4
        let n_str = crt_to_str(a[1])
        let d_str = crt_to_str(a[2])
        let d_val = crt_to_int(a[2])
        if d_val == 1
            "-" + n_str
        else
            0
        if d_val == 0
            "-inf"
        else
            "-" + n_str + "/" + d_str
    else
        0
    if a[0] == 5
        "-" + bi_to_str(a[1])
    else
        crt_to_str(a[1])

let sn_print(a) =
    print_str(sn_to_str(a))

let sn_cmp(a, b) =
    let a_neg = a[0] == 3 || a[0] == 4 || a[0] == 5
    let b_neg = b[0] == 3 || b[0] == 4 || b[0] == 5
    if a_neg && !b_neg
        0 - 1
    else
        0
    if !a_neg && b_neg
        1
    else
        0
    if a_neg && b_neg
        let abs_a = (a[0] == 3 ? [0, a[1], 0] : (a[0] == 5 ? [2, a[1], 0] : [1, a[1], a[2]]))
        let abs_b = (b[0] == 3 ? [0, b[1], 0] : (b[0] == 5 ? [2, b[1], 0] : [1, b[1], b[2]]))
        let c = sn_cmp(abs_a, abs_b)
        if c > 0
            0 - 1
        else
            0
        if c < 0
            1
        else
            0
    else
        0
    if a[0] == 0 && b[0] == 0
        crt_cmp(a[1], b[1])
    else
        0
    if a[0] == 1 && b[0] == 1
        let lhs = crt_mul(a[1], b[2])
        let rhs = crt_mul(b[1], a[2])
        crt_cmp(lhs, rhs)
    else
        0
    if a[0] == 0 && b[0] == 1
        let lhs = crt_mul(a[1], b[2])
        crt_cmp(lhs, b[1])
    else
        0
    if a[0] == 1 && b[0] == 0
        let rhs = crt_mul(b[1], a[2])
        crt_cmp(a[1], rhs)
    else
        crt_cmp(a[1], b[1])

let sn_parse_decimal(s) =
    let n = len(s)
    let i = 0
    let int_part = 0
    let dec_part = 0
    let dec_digits = 0
    let has_dot = 0
    for i < n && has_dot == 0
        let c = s[i]
        if c == 46
            has_dot = 1
        else
            int_part = int_part * 10 + (c - 48)
        i = i + 1
    for i < n
        let c = s[i]
        dec_part = dec_part * 10 + (c - 48)
        dec_digits = dec_digits + 1
        i = i + 1
    let den = 1
    let k = 0
    for k < dec_digits
        den = den * 10
        k = k + 1
    let num = int_part * den + dec_part
    sn_rat(num, den)

let sn_decimal(int_part, dec_part, dec_digits) =
    let den = 1
    let k = 0
    for k < dec_digits
        den = den * 10
        k = k + 1
    let num = int_part * den + dec_part
    sn_rat(num, den)

let sn_pow(base, exp) =
    if exp == 0
        sn_one()
    else
        0
    if exp == 1
        base
    else
        let result = sn_one()
        let b = base
        let e = exp
        for e > 0
            if e - (e / 2) * 2 == 1
                result = sn_mul(result, b)
            b = sn_mul(b, b)
            e = e / 2
        result

let sn_isqrt(a) =
    if sn_cmp(a, sn_one()) <= 0
        a
    else
        let x = sn_div(a, sn_int(2))
        let prev = sn_zero()
        for sn_cmp(x, prev) != 0
            prev = x
            let ax = sn_div(a, x)
            let sum = sn_add(x, ax)
            x = sn_div(sum, sn_int(2))
        x

let sn_neg(a) =
    if a[0] == 0
        sn_sub(sn_zero(), a)
    else
        sn_sub(sn_zero(), a)

let sn_abs(a) =
    a

let sn_factorial(n) =
    if n <= 1
        sn_one()
    else
        let result = bi_one()
        let i = 2
        for i <= n
            result = bi_mul_small(result, i)
            i = i + 1
        sn_bigint(result)

let sn_fibonacci(n) =
    if n == 0
        sn_zero()
    else
        0
    if n == 1
        sn_one()
    else
        let prev = bi_zero()
        let curr = bi_one()
        let i = 2
        for i <= n
            let next = bi_add(prev, curr)
            prev = curr
            curr = next
            i = i + 1
        sn_bigint(curr)

let sn_gcd(a, b) =
    if a[0] == 0 && b[0] == 0
        let g = crt_gcd_bi(a[1], b[1])
        [0, crt_from_bi(g), 0]
    else
        sn_one()

let sn_lcm(a, b) =
    if a[0] == 0 && b[0] == 0
        let g = crt_gcd_bi(a[1], b[1])
        let prod = crt_mul(a[1], b[1])
        [0, crt_div_bi(prod, g), 0]
    else
        sn_one()

