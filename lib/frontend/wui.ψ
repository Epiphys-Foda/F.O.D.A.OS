    0

let ui_input(u, id, x, y, iw, buf) =
    let st = u[3]
    let fb = u[0]
    let w = u[1]
    let h = u[2]
    let fg = u[4]
    let th = u[14]
    let mx = st[0]
    let my = st[1]
    let down = st[2]
    let cap = (iw - 6) // 4
    let hovered = ui_hover(u, x, y, iw, 14)
    if (down == 1) & (hovered == 1)
      arr_set(st, 13, id)
    if (down == 1) & (hovered == 0)
      if st[13] == id
        arr_set(st, 13, 0)
    let focused = st[13] == id
    arr_set(st, 14, 0)
    if focused == 1
      let caret = buf[0]
      let ln = buf[1]
      let head = st[11]
      let tail = st[12]
      for head < tail
        let key = st[16 + (head & 63)]
        head = head + 1
        if key == 8
          if caret > 0
            let j = caret - 1
            for j < ln - 1
              arr_set(buf, 2 + j, buf[3 + j])
              j = j + 1
            ln = ln - 1
            caret = caret - 1
        else
          if key == 46
            if caret < ln
              let j2 = caret
              for j2 < ln - 1
                arr_set(buf, 2 + j2, buf[3 + j2])
                j2 = j2 + 1
              ln = ln - 1
          else
            if key == 37
              if caret > 0
                caret = caret - 1
            else
              if key == 39
                if caret < ln
                  caret = caret + 1
              else
                if key == 13
                  arr_set(st, 14, 1)
                else
                  if (key >= 32) & (key < 127)
                    if ln < cap
                      let j3 = ln
                      for j3 > caret
                        arr_set(buf, 2 + j3, buf[1 + j3])
                        j3 = j3 - 1
                      arr_set(buf, 2 + caret, key)
                      ln = ln + 1
                      caret = caret + 1
      arr_set(buf, 0, caret)
      arr_set(buf, 1, ln)
      arr_set(st, 11, head)
    fill_rect(fb, w, h, x, y, iw, 14, th[2])
    fill_rect(fb, w, h, x + 1, y + 1, iw - 2, 12, th[9])
    let j = 0
    for j < buf[1]
      blit_char(fb, w, h, x + 3 + j * 4, y + 4, buf[2 + j], th[6], fg)
      j = j + 1
    if focused == 1
      fill_rect(fb, w, h, x + 3 + buf[0] * 4, y + 3, 1, 8, th[6])
    st[14]

