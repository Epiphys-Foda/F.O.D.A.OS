let int_str(n, out) =
    let v = n
    let len = 0
    for v > 0
      arr_set(out, len, 48 + (v - (v // 10) * 10))
      len = len + 1
      v = v // 10
    if len == 0
      arr_set(out, 0, 48)
      len = 1
    let i = 0
    for i < len // 2
      let t = out[i]
      arr_set(out, i, out[len - 1 - i])
      arr_set(out, len - 1 - i, t)
      i = i + 1
    len

