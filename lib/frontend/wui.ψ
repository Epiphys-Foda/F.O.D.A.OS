let ui_select(u, id, x, y, bw, opts, on, vals, vi) =
    let st = u[3]
    let fb = u[0]
    let w = u[1]
    let h = u[2]
    let fg = u[4]
    let th = u[14]
    let mx = st[0]
    let my = st[1]
    let down = st[2]
    let bh = 14
    let open = vals[vi + 1]
    let hovered = ui_hover(u, x, y, bw, 14)
    if (hovered == 1) & (st[3] == 0)
      arr_set(st, 3, id)
    let ishot = st[3] == id
    if (down == 1) & (hovered == 1)
      if st[4] == 0
        arr_set(st, 4, id)
    let isact = st[4] == id
    if down == 0
      if isact == 1
        if hovered == 1
          arr_set(vals, vi + 1, 1 - open)
      if st[4] == id
        arr_set(st, 4, 0)
    let col = isact * th[5] + (1 - isact) * (ishot * th[4] + (1 - ishot) * th[3])
    fill_rect(fb, w, h, x, y, bw, bh, col)
    let sel = vals[vi]
    blit_text(fb, w, h, x + 3, y + 4, opts[sel], th[6], fg)
    blit_text(fb, w, h, x + bw - 8, y + 4, "v", th[6], fg)
    if open == 1
      let i = 0
      for i < on
        let oy = y + bh + 1 + i * (bh + 1)
        let ohov = ui_hover(u, x, oy, bw, 14)
        if (ohov == 1) & (st[3] == 0)
          arr_set(st, 3, id + 1 + i)
        let ohot = st[3] == (id + 1 + i)
        let ocol = ohot * th[4] + (1 - ohot) * th[1]
        fill_rect(fb, w, h, x, oy, bw, bh, ocol)
        blit_text(fb, w, h, x + 3, oy + 4, opts[i], th[6], fg)
        if (down == 1) & (ohov == 1)
          if st[4] == 0
            arr_set(st, 4, id + 1 + i)
        if down == 0
          if st[4] == (id + 1 + i)
            if ohov == 1
              arr_set(vals, vi, i)
              arr_set(vals, vi + 1, 0)
            arr_set(st, 4, 0)
        i = i + 1
      if down == 0
        if st[4] == 0
          arr_set(vals, vi + 1, 0)
    vals[vi]

