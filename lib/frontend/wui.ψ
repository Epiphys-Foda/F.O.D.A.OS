let ui_scroll_end(u) =
    let fb = u[0]
    let w = u[1]
    let h = u[2]
    let th = u[14]
    let st = u[3]
    let vx = u[16]
    let vy = u[17]
    let vw = u[18]
    let vh = u[19]
    let ch = u[22]
    let vals = u[25]
    let vi = u[26]
    let off = vals[vi]
    let mx = st[0]
    let my = st[1]
    let down = st[2]
    let drag = (down == 1) & ((mx >= vx + vw - 6) & (mx < vx + vw)) & ((my >= vy) & (my < vy + vh))
    if (drag == 1) & (ch > vh)
      let noff = (my - vy) * ch // vh
      let c1 = noff < 0
      let c2 = noff > ch - vh
      let nc = c1 * 0 + (1 - c1) * (c2 * (ch - vh) + (1 - c2) * noff)
      arr_set(vals, vi, nc)
      off = nc
    else
      0
    let inside = ((mx >= vx) & (mx < vx + vw)) & ((my >= vy) & (my < vy + vh))
    if inside == 1
      let rd = st[11]
      let tail = st[12]
      let wr = rd
      for rd < tail
        let key = st[16 + (rd & 63)]
        rd = rd + 1
        if key == 38
          off = off - 12
        else
          if key == 40
            off = off + 12
          else
            arr_set(st, 16 + (wr & 63), key)
            wr = wr + 1
      arr_set(st, 12, wr)
    else
      0
    let c3 = off < 0
    let c4 = off > ch - vh
    let maxoff = ch - vh
    if maxoff < 0
      maxoff = 0
    let c5 = off > maxoff
    off = c3 * 0 + (1 - c3) * (c5 * maxoff + (1 - c5) * off)
    arr_set(vals, vi, off)
    fill_rect(fb, w, h, vx, vy - off, vw - 6, off, th[0])
    let below = ch - off - vh
    if below > 0
      fill_rect(fb, w, h, vx, vy + vh, vw - 6, below, th[0])
    else
      0
    let thh = vh * vh // ch
    if thh < 8
      thh = 8
    else
      0
    let ty = vy + off * vh // ch
    fill_rect(fb, w, h, vx + vw - 6, ty, 6, thh, th[8])
    arr_set(u, 5, u[20])
    arr_set(u, 6, u[21])
    arr_set(u, 32, u[36])
    arr_set(u, 33, u[37])
    arr_set(u, 34, u[38])
    arr_set(u, 35, u[39])
    arr_set(u, 23, 0)
    0

