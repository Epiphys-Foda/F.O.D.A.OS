    let t = arr_new_n(12)
    let len = int_str(n, t)
    let i = 0
    for i < len
      blit_char(fb, w, h, x + i * 4, y, t[i], th[6], fg)
      i = i + 1
    len * 4

let ui_curve(u, id, x, y, cw, ch, data, dn, color) =
    let fb = u[0]
    let w = u[1]
    let h = u[2]
    let th = u[14]
    fill_rect(fb, w, h, x, y, cw, ch, th[2])
    fill_rect(fb, w, h, x + 1, y + 1, cw - 2, ch - 2, th[1])
    let mn = data[0]
    let mx = data[0]
    let i = 1
    for i < dn
      if data[i] < mn
        mn = data[i]
      if data[i] > mx
        mx = data[i]
      i = i + 1
    let range = mx - mn
    if range < 1
      range = 1
    let span = dn - 1
    if span < 1
      span = 1
    let ix = 0
    let px = 0
    let py = 0
    for ix < dn
      let sx = x + 2 + (ix * (cw - 4)) // span
      let sy = y + 2 + ((data[ix] - mn) * (ch - 4)) // range
      if ix == 0
        px = sx
        py = sy
      else
        draw_line_seg(fb, w, h, px, py, sx, sy, color)
        px = sx
        py = sy
      ix = ix + 1
    0

