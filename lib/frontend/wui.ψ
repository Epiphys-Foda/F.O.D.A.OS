let ui_hover(u, x, y, w, h) =
    let st = u[3]
    let mx = st[0]
    let my = st[1]
    let inrect = ((mx >= x) & (mx < x + w)) & ((my >= y) & (my < y + h))
    let gate = 1
    if u[34] != 0
      gate = ((mx >= u[32]) & (mx < u[32] + u[34])) & ((my >= u[33]) & (my < u[33] + u[35]))
    inrect * gate

