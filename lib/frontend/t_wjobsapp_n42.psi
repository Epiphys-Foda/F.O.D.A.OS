import "wblit.ψ"
import "wui.ψ"
import "win_shell.ψ"

let mk_job(label, prog, state, seq) =
    {label: label, prog: prog, state: state, seq: seq}

let do_step(vals, jobs) =
    let sel = vals.get(2)
    let j = jobs.get(sel)
    let pr = j.prog
    let np = pr + 25
    if np >= 100
      j.set("prog", 100)
      j.set("state", 2)
    else
      j.set("prog", np)
      j.set("state", 1)
    0

let apply_sort(vals, jobs) =
    let cnt = vals.get(3)
    let mode = vals.get(6)
    let pass = 0
    for pass < cnt
      let k = 0
      for k < cnt - 1
        let a = jobs.get(k)
        let b = jobs.get(k + 1)
        let swap = 0
        if (mode == 1) & (a.prog < b.prog)
          swap = 1
        if (mode == 2) & (a.prog > b.prog)
          swap = 1
        if (mode == 0) & (a.seq > b.seq)
          swap = 1
        if swap == 1
          jobs.set(k, b)
          jobs.set(k + 1, a)
        k = k + 1
      pass = pass + 1
    0

let init(w, h) =
    let st = arr_new_n(96)
    let fb = arr_new_n(w * h)
    arr_set(st, 6, fb)
    arr_set(st, 9, font_glyphs())
    arr_set(st, 5, ui_ctx(st, fb, w, h, st[9]))
    let vals = arr_new_n(8)
    vals.set(3, 4)
    vals.set(4, 5)
    vals.set(6, 0)
    arr_set(st, 15, vals)
    let tabl = arr_new_n(3)
    tabl.set(0, "ALL")
    tabl.set(1, "RUN")
    tabl.set(2, "DONE")
    arr_set(st, 81, tabl)
    let jobs = arr_new_n(8)
    jobs.set(0, mk_job("alpha", 0, 0, 1))
    jobs.set(1, mk_job("beta", 40, 1, 2))
    jobs.set(2, mk_job("gamma", 100, 2, 3))
    jobs.set(3, mk_job("delta", 0, 0, 4))
    arr_set(st, 80, jobs)
    st

let frame(st) =
    let u = st[5]
    let vals = st[15]
    let jobs = st[80]
    let tabl = st[81]
    ui_begin(u)
    let th = u[14]
    fill_rect(u[0], u[1], u[2], 0, 0, u[1], u[2], th[0])
    blit_text(u[0], u[1], u[2], 10, 12, "TRAIN JOBS", th[6], u[4])
    let slab = "SORT"
    if vals.get(6) == 1
      slab = "SORT-D"
    if vals.get(6) == 2
      slab = "SORT-U"
    let so_hit = ui_button(u, 34, 150, 8, 44, 16, slab)
    if so_hit == 1
      vals.set(6, vals.get(6) + 1)
      if vals.get(6) == 3
        vals.set(6, 0)
      apply_sort(vals, jobs)
      vals.set(1, vals.get(2) * 36)
    ui_tabs(u, 7, 200, 10, 36, 16, tabl, 3, vals, 0)
    let cnt = vals.get(3)
    ui_scroll_begin(u, 8, 36, 304, 170, cnt * 36 + 8, vals, 1)
    let i = 0
    for i < cnt
      let j = jobs.get(i)
      let stj = j.state
      let f = vals.get(0)
      let show = 0
      if f == 0
        show = 1
      else
        if f == stj
          show = 1
      if show == 1
        let ry = 44 + i * 36 - vals.get(1)
        let hit = ui_button(u, 100 + i, 12, ry, 262, 30, j.label)
        if hit == 1
          vals.set(2, i)
        let pw = j.prog * 236 // 100
        fill_rect(u[0], u[1], u[2], 20, ry + 22, 236, 4, th[7])
        fill_rect(u[0], u[1], u[2], 20, ry + 22, pw, 4, th[8])
        let x_hit = ui_button(u, 200 + i, 278, ry + 9, 16, 12, "x")
        if x_hit == 1
          let k = i
          for k < cnt - 1
            jobs.set(k, jobs.get(k + 1))
            k = k + 1
          vals.set(3, cnt - 1)
          if vals.get(2) >= cnt - 1
            vals.set(2, cnt - 2)
      i = i + 1
    ui_scroll_end(u)
    let s_hit = ui_button(u, 30, 8, 212, 70, 22, "STEP")
    if s_hit == 1
      do_step(vals, jobs)
    let sel = jobs.get(vals.get(2))
    let plbl = "RUN"
    if sel.state == 1
      plbl = "PAUSE"
    if sel.state == 0
      blit_text(u[0], u[1], u[2], 92, 218, "QUEUED", th[6], u[4])
    else
      if sel.state == 1
        blit_text(u[0], u[1], u[2], 92, 218, "RUNNING", th[6], u[4])
      else
        blit_text(u[0], u[1], u[2], 92, 218, "DONE", th[6], u[4])
    blit_num(u, 164, 218, sel.prog)
    let r_hit = ui_button(u, 31, 200, 212, 50, 22, "RESET")
    if r_hit == 1
      sel.set("prog", 0)
      sel.set("state", 0)
    let p_hit = ui_button(u, 32, 258, 212, 54, 22, plbl)
    if p_hit == 1
      if sel.state == 1
        sel.set("state", 0)
      else
        if sel.state == 0
          sel.set("state", 1)
    let a_hit = ui_button(u, 33, 86, 212, 70, 22, "+ADD")
    if a_hit == 1
      if vals.get(3) < 8
        let buf = arr_new_n(12)
        let blen = int_str(vals.get(4), buf)
        let lab = arr_new_n(blen + 1)
        lab.set(0, blen)
        let q = 0
        for q < blen
          lab.set(q + 1, buf.get(q))
          q = q + 1
        jobs.set(vals.get(3), mk_job(lab, 0, 0, vals.get(4)))
        vals.set(4, vals.get(4) + 1)
        vals.set(3, vals.get(3) + 1)
    present_size(u[1], u[2])
    present(u[0], u[1] * u[2])
    0
