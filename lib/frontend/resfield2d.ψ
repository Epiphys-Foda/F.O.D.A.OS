let rf_pmpow(b, e) =
    let result = 1
    let base = b % 65537
    let ee = e
    for ee > 0
      if (ee & 1) == 1
        result = (result * base) % 65537
      else
        ee = ee
      base = (base * base) % 65537
      ee = ee >> 1
    result

let rf_pole_prep(pa, pb) =
    let out = arr_new_n(2)
    arr_set(out, 0, ((pa + 256 * pb) % 65537 + 65537) % 65537)
    arr_set(out, 1, ((pa - 256 * pb) % 65537 + 65537) % 65537)
    out

let rf_pixel(zx, zy, n, pa, pb, pr, pu, pv) =
    let zu = ((zx + 256 * zy) % 65537 + 65537) % 65537
    let zv = ((zx - 256 * zy) % 65537 + 65537) % 65537
    let su = 0
    let sv = 0
    let sing = 0
    let n1 = 0
    let n2 = 0
    let k = 0
    for k < n
      let dx = zx - pa[k]
      let dy = zy - pb[k]
      let du = ((zu - pu[k]) % 65537 + 65537) % 65537
      let dv = ((zv - pv[k]) % 65537 + 65537) % 65537
      let z1 = du == 0
      let z2 = dv == 0
      let zs = z1 + z2
      let p1 = rf_pmpow(du, 65535)
      let p2 = rf_pmpow(dv, 65535)
      if zs > 0
        sing = 1
      else
        if pr[k] == 1
          su = (su + p1) % 65537
          sv = (sv + p2) % 65537
        else
          su = (su + 65537 - p1) % 65537
          sv = (sv + 65537 - p2) % 65537
      if k == 0
        n1 = dx * dx + dy * dy
        n2 = dx * dx + dy * dy
      else
        n1 = dx * dx + dy * dy
        n2 = dx * dx + dy * dy
      k = k + 1
    let out = arr_new_n(5)
    arr_set(out, 0, su)
    arr_set(out, 1, sv)
    arr_set(out, 2, n1)
    arr_set(out, 3, n2)
    arr_set(out, 4, sing)
    out

let rf_band(dist) =
    let thr = [30, 100, 400, 1600, 6400, 25600, 40000, 80000, 110000]
    let b = 8
    let i = 8
    let done = 0
    for done == 0
      if dist < thr[i]
        b = i
        i = i - 1
        if i < 0
          done = 1
        else
          i = i
      else
        done = 1
    b

let rf_color888(su, sv, d, sing, pal) =
    let b = rf_band(d)
    let tint = su & 3
    let c = pal[b]
    let r8 = (c >> 11) << 3
    let g8 = ((c >> 5) & 63) << 2
    let b8 = (c & 31) << 3
    let r9 = r8 + ((tint * ((255 - r8) >> 4)) >> 2)
    let g9 = g8 + ((tint * ((255 - g8) >> 4)) >> 2)
    let b9 = b8 + ((tint * ((255 - b8) >> 4)) >> 2)
    let wsel = sing * 255
    let r10 = r9 + ((wsel * (255 - r9)) >> 8)
    let g10 = g9 + ((wsel * (255 - g9)) >> 8)
    let b10 = b9 + ((wsel * (255 - b9)) >> 8)
    (r10 << 24) + (g10 << 16) + (b10 << 8) + 255
