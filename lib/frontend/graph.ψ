import "fb.ψ"

let g_GD() = [7,5,5,5,7, 2,6,2,2,7, 7,1,7,4,7, 7,1,7,1,7, 5,5,7,1,1, 7,4,7,1,7, 7,4,7,5,7, 7,1,2,2,2, 7,5,7,5,7, 7,5,7,1,7]

let g_digit(fb, d, x, y, c) =
    let gd = g_GD()
    let base = d * 5
    let ry = 0
    for ry < 5
      let row = gd[base + ry]
      let cx = 0
      for cx < 3
        if ((row >> (2 - cx)) & 1) == 1
          fb_set(fb, x + cx, y + ry, c)
        else
          0
        cx = cx + 1
      ry = ry + 1
    fb

let g_num3(fb, v, x, y, c) =
    g_digit(fb, (v / 100) % 10, x, y, c)
    g_digit(fb, (v / 10) % 10, x + 4, y, c)
    g_digit(fb, v % 10, x + 8, y, c)

let g_node(fb, x, y, wd, ht, id, bc, fc) =
    fb_rect(fb, x, y, wd, ht, bc)
    fb_rect(fb, x, y, wd, 1, fc)
    fb_rect(fb, x, y + ht - 1, wd, 1, fc)
    fb_rect(fb, x, y, 1, ht, fc)
    fb_rect(fb, x + wd - 1, y, 1, ht, fc)
    g_num3(fb, id, x + 2, y + 2, fc)
    fb

let g_wire(fb, x1, y1, x2, y2, c) =
    let xm = (x1 + x2) / 2
    fb_line(fb, x1, y1, xm, y1, c)
    fb_line(fb, xm, y1, xm, y2, c)
    fb_line(fb, xm, y2, x2, y2, c)
    fb

let g_port(fb, x, y, c) =
    fb_rect(fb, x - 1, y - 1, 3, 3, c)

let g_link(fb, e, nodes, wc, pc, u, plc) =
    let oi = e[0] * 5
    let ii = e[3] * 5
    let x1 = nodes[oi] + e[1]
    let y1 = nodes[oi + 1] + e[2]
    let x2 = nodes[ii] + e[4]
    let y2 = nodes[ii + 1] + e[5]
    g_wire(fb, x1, y1, x2, y2, wc)
    g_port(fb, x1, y1, pc)
    g_port(fb, x2, y2, pc)
    g_pulse(fb, x1, y1, x2, y2, u, plc)
    fb

let g_hit(nodes, n, mx, my) =
    let found = 0 - 1
    let i = 0
    for i < n
      let x = nodes[i * 5]
      let y = nodes[i * 5 + 1]
      let nw = nodes[i * 5 + 2]
      let nh = nodes[i * 5 + 3]
      if (mx >= x) && (my >= y) && (mx < x + nw) && (my < y + nh)
        found = i
      else
        0
      i = i + 1
    found

let g_handle_event(ev, nodes, edges, ne, wd, ht, sel, gx, gy, pending) =
    let h = g_hit(nodes, 5, ev[2], ev[3])
    let hit_o = 0 - 1
    let i = 0
    for i < 5
      let ox = nodes[i * 5] + nodes[i * 5 + 2]
      let oy = nodes[i * 5 + 1] + nodes[i * 5 + 3] / 2
      if (ev[2] >= ox - 4) && (ev[2] <= ox + 4) && (ev[3] >= oy - 4) && (ev[3] <= oy + 4)
        hit_o = i
      else
        0
      i = i + 1
    let hit_i = 0 - 1
    let j = 0
    for j < 5
      let ix = nodes[j * 5]
      let iy = nodes[j * 5 + 1] + nodes[j * 5 + 3] / 2
      if (ev[2] >= ix - 5) && (ev[2] <= ix + 5) && (ev[3] >= iy - 5) && (ev[3] <= iy + 5)
        hit_i = j
      else
        0
      j = j + 1
    let dup = 0
    let k = 0
    for k < ne
      if (edges[k * 6] == pending) && (edges[k * 6 + 3] == hit_i)
        dup = 1
      else
        0
      k = k + 1
    let nox = 0
    let noy = 18
    if pending >= 0
      nox = nodes[pending * 5 + 2]
      noy = nodes[pending * 5 + 3] / 2
    else
      0
    let nix = 0
    let niy = 18
    if hit_i >= 0
      nix = nodes[hit_i * 5 + 3] / 2
    else
      0
    let ns = sel
    let ngx = gx
    let ngy = gy
    let np = pending
    let ne2 = ne
    let pvx = ev[2]
    let pvy = ev[3]
    let snw = 80
    let snh = 40
    if ns >= 0
      snw = nodes[ns * 5 + 2]
      snh = nodes[ns * 5 + 3]
    else
      0
    let tx = ev[2] - ngx
    let ty = ev[3] - ngy
    let cx = tx * (tx > 0)
    let cx2 = cx + ((wd - snw) - cx) * (cx > wd - snw)
    let cy = ty * (ty > 0)
    let cy2 = cy + ((ht - snh) - cy) * (cy > ht - snh)
    if ev[0] == 3
      if hit_o >= 0
        np = hit_o
        ns = 0 - 1
      else
        np = 0 - 1
        ns = h
        if ns >= 0
          ngx = ev[2] - nodes[ns * 5]
          ngy = ev[3] - nodes[ns * 5 + 1]
        else
          0
    else
      0
    if ev[0] == 2
      if np >= 0
        pvx = ev[2]
        pvy = ev[3]
      else
        0
      if (ev[1] & 1) == 1
        if ns >= 0
          arr_set(nodes, ns * 5, cx2)
          arr_set(nodes, ns * 5 + 1, cy2)
        else
          0
      else
        0
    else
      0
    if ev[0] == 4
      if np >= 0
        if hit_i >= 0
          if hit_i != np
            if dup == 0
              if ne2 < 12
                arr_set(edges, ne2 * 6, np)
                arr_set(edges, ne2 * 6 + 1, nox)
                arr_set(edges, ne2 * 6 + 2, noy)
                arr_set(edges, ne2 * 6 + 3, hit_i)
                arr_set(edges, ne2 * 6 + 4, nix)
                arr_set(edges, ne2 * 6 + 5, niy)
                ne2 = ne2 + 1
              else
                0
            else
              0
          else
            0
        else
          0
      else
        0
      if hit_i >= 0
        np = 0 - 1
      else
        0
    else
      0
    [ns, ngx, ngy, np, pvx, pvy, ne2]

let g_pulse(fb, x1, y1, x2, y2, u, c) =
    let xm = (x1 + x2) / 2
    let a1 = xm - x1
    let l1 = a1 * (1 - 2 * (a1 < 0))
    let a2 = y2 - y1
    let l2 = a2 * (1 - 2 * (a2 < 0))
    let a3 = x2 - xm
    let l3 = a3 * (1 - 2 * (a3 < 0))
    let total = l1 + l2 + l3
    let d = (u * total) / 255
    let d2 = d - l1
    let c2 = d2 > 0
    let m1 = d - d2 * c2
    let d3 = d2 - l2
    let c3 = d3 > 0
    let m2 = d2 - d3 * c3
    let d4 = d3 - l3
    let c4 = d4 > 0
    let m3 = d3 - d4 * c4
    let sa = 1 - c2
    let sb = c2 * (1 - c3)
    let sc = c2 * c3
    let px = (x1 + (1 - 2 * (xm < x1)) * m1) * sa + xm * sb + (xm + (1 - 2 * (x2 < xm)) * m3) * sc
    let py = y1 * sa + (y1 + (1 - 2 * (y2 < y1)) * m2) * sb + y2 * sc
    fb_rect(fb, px - 1, py - 1, 3, 3, c)
    fb
