let wire_toggle(wires, cnt, src, dst) =
    let n = cnt[0]
    let hit = 0 - 1
    let k = 0
    for k < n
      if hit < 0
        if (wires[k * 2] == src) & (wires[k * 2 + 1] == dst)
          hit = k
      k = k + 1
    if hit >= 0
      let j = hit
      for j < n - 1
        arr_set(wires, j * 2, wires[(j + 1) * 2])
        arr_set(wires, j * 2 + 1, wires[(j + 1) * 2 + 1])
        j = j + 1
      arr_set(cnt, 0, n - 1)
    else
      if n < cnt[1]
        arr_set(wires, n * 2, src)
        arr_set(wires, n * 2 + 1, dst)
        arr_set(cnt, 0, n + 1)
    0

let graph_eval(nodes_n, wires, cnt, nodeval, tmp) =
    let wn = cnt[0]
    let pass = 0
    for pass < wn
      let i = 0
      for i < nodes_n
        arr_set(tmp, i, 0)
        i = i + 1
      let k = 0
      for k < wn
        arr_set(tmp, wires[k * 2 + 1], tmp[wires[k * 2 + 1]] + nodeval[wires[k * 2]])
        k = k + 1
      let k2 = 0
      for k2 < wn
        arr_set(nodeval, wires[k2 * 2 + 1], tmp[wires[k2 * 2 + 1]])
        k2 = k2 + 1
      pass = pass + 1
    0

let graph_eval2(nodes_n, kinds, wires, cnt, nodeval, tmp) =
    let wn = cnt[0]
    let pass = 0
    for pass < wn
      let i = 0
      for i < nodes_n
        let d = i
        let kid = kinds[d]
        let ident = 0
        if kid == 2
          ident = 1
        else
          0
        arr_set(tmp, i, ident)
        i = i + 1
      let k = 0
      for k < wn
        let s = wires[k * 2]
        let d2 = wires[k * 2 + 1]
        if kinds[d2] == 2
          arr_set(tmp, d2, tmp[d2] * nodeval[s])
        else
          arr_set(tmp, d2, tmp[d2] + nodeval[s])
        k = k + 1
      let k2 = 0
      for k2 < wn
        arr_set(nodeval, wires[k2 * 2 + 1], tmp[wires[k2 * 2 + 1]])
        k2 = k2 + 1
      pass = pass + 1
    0

let kind_next(k) =
    let r = 1
    if k == 1
      r = 2
    else
