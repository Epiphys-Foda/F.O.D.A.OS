    r

let gc_num(out, pos, n) =
    let v = n
    let len = 0
    for v > 0
      arr_set(out, pos + len, 48 + (v - (v // 10) * 10))
      len = len + 1
      v = v // 10
    if len == 0
      arr_set(out, pos, 48)
      len = 1
    let i = 0
    for i < len // 2
      let t = out[pos + i]
      arr_set(out, pos + i, out[pos + len - 1 - i])
      arr_set(out, pos + len - 1 - i, t)
      i = i + 1
    pos + len

let gc_s(out, pos, s) =
    let n = len(s)
    let i = 0
    for i < n
      arr_set(out, pos + i, s[i])
      i = i + 1
    pos + n

let graph_code(nodes_n, kinds, srcvals, wires, cnt, defd, ps, out) =
    let wn = cnt[0]
    let i = 0
    for i < nodes_n
      arr_set(defd, i, 0)
      i = i + 1
    let pos = 0
    let pass = 0
    for pass < nodes_n
      let i2 = 0
      for i2 < nodes_n
        if defd[i2] == 0
          if kinds[i2] == 0
            pos = gc_s(out, pos, "let v")
            pos = gc_num(out, pos, i2)
            pos = gc_s(out, pos, " = ")
            pos = gc_num(out, pos, srcvals[i2])
            arr_set(out, pos, 10)
            pos = pos + 1
            arr_set(defd, i2, 1)
          else
            let m = 0
            let ok = 1
            let k = 0
            for k < wn
              if wires[k * 2 + 1] == i2
                arr_set(ps, m, wires[k * 2])
                m = m + 1
                if defd[wires[k * 2]] == 0
                  ok = 0
              k = k + 1
            if (m > 0) & (ok == 1)
              pos = gc_s(out, pos, "let v")
              pos = gc_num(out, pos, i2)
              pos = gc_s(out, pos, " = ")
              let kk = 0
              for kk < m
                pos = gc_s(out, pos, "v")
                pos = gc_num(out, pos, ps[kk])
                if kk < m - 1
                  if kinds[i2] == 2
                    pos = gc_s(out, pos, " * ")
                  else
                    pos = gc_s(out, pos, " + ")
                else
                  0
                kk = kk + 1
              arr_set(out, pos, 10)
              pos = pos + 1
              arr_set(defd, i2, 1)
            else
              0
        else
          0
        i2 = i2 + 1
      pass = pass + 1
    pos