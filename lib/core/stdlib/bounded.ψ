let is_bounded(value, bound) =
    if bound == 0
        0
    else
        0
    if value < bound
        1
    else
        0

let cyclic_order(p) = p - 1

let _gcd(a, b) =
    if b == 0
        a
    else
        _gcd(b, a % b)

let lcm(a, b) =
    if a == 0
        0
    else
        0
    if b == 0
        0
    else
        let g = _gcd(a, b)
        (a / g) * b

let _multi_period(moduli, i, acc) =
    if i >= len(moduli)
        acc
    else
        let pi = moduli[i]
        let order = cyclic_order(pi)
        _multi_period(moduli, i + 1, lcm(acc, order))

let cyclic_period_multi(moduli) =
    if len(moduli) == 0
        1
    else
        _multi_period(moduli, 1, cyclic_order(moduli[0]))

let is_finite_domain(k_max) =
    if k_max <= 3
        1
    else
        0

let bounded_check(k_max, moduli) =
    let finite = is_finite_domain(k_max)
    let period = cyclic_period_multi(moduli)
    if finite && (period > 0)
        1
    else
        0

let _all_finite_loop(trace, i) =
    if i >= len(trace)
        1
    else
        if is_finite_domain(trace[i]) == 0
            0
        else
            _all_finite_loop(trace, i + 1)

let trace_bounded(trace) = _all_finite_loop(trace, 0)

let bounded_verify() =
    let ok1 = is_bounded(100, 1000) == 1
    let ok2 = is_bounded(1000, 100) == 0
    let ok3 = cyclic_order(65537) == 65536
    let ok4 = _gcd(12, 18) == 6
    let ok5 = lcm(4, 6) == 12
    let moduli_small = [7, 13]
    let period_small = cyclic_period_multi(moduli_small)
    let ok6 = period_small == 12
    let ok7 = is_finite_domain(3) == 1
    let ok8 = is_finite_domain(4) == 0
    let ok9 = bounded_check(2, moduli_small) == 1
    let ok10 = trace_bounded([0, 1, 2, 1, 0]) == 1
    if ok1 && ok2 && ok3 && ok4 && ok5 && ok6 && ok7 && ok8 && ok9 && ok10
        1
    else
        0

let main() = bounded_verify()
