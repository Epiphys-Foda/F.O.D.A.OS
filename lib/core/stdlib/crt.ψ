let crt_egcd(a, b) =
    let old_r = a
    let r = b
    let old_s = 1
    let s = 0
    let old_t = 0
    let t = 1
    for r != 0
      let q = old_r / r
      let tmp_r = old_r - q * r
      old_r = r
      r = tmp_r
      let tmp_s = old_s - q * s
      old_s = s
      s = tmp_s
      let tmp_t = old_t - q * t
      old_t = t
      t = tmp_t
    if old_r < 0
      old_r = 0 - old_r
    [old_r, old_s, old_t]

let crt_inv(a, m) =
    let e = crt_egcd(a, m)
    if e[0] != 1
      0
    else
      let x = e[1]
      if x < 0
        x + m
      else
        x

let crt_pair(r1, m1, r2, m2) =
    let m12 = m1 * m2
    let diff = r2 - r1
    let diff_m = if diff < 0
      let q = (0 - diff) / m2
      diff + (q + 1) * m2
    else
      diff
    let m1_mod = if m1 >= m2
      m1 - (m1 / m2) * m2
    else
      m1
    let inv = crt_inv(m1_mod, m2)
    let k = (diff_m * inv) % m2
    let x = r1 + m1 * k
    if x >= m12
      x - m12
    else
      x

let crt_apply(list) =
    let x = list[0][0]
    let m = list[0][1]
    let i = 1
    for i < len(list)
      let r = list[i][0]
      let mi = list[i][1]
      x = crt_pair(x, m, r, mi)
      m = m * mi
      i = i + 1
    x

