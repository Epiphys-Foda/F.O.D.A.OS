let ri_uleb128(n) =
    let result = arr_new()
    let val = n
    let done = 0
    for done == 0
        let byte = val & 127
        val = val >> 7
        if val == 0
            result = arr_push(result, byte)
            done = 1
        else
            result = arr_push(result, byte | 128)
    result

let ri_to_wasm(table) =
    let wasm = arr_new()
    let i = 0
    for i < table.len()
        let entry = table[i]
        let op = entry[0]
        let op1 = entry[1]
        let op2 = entry[2]

        if op == OP_PUSH_INT
            wasm = arr_push(wasm, WASM_I32_CONST)
            let leb = ri_uleb128(op1)
            let j = 0
            for j < leb.len()
                wasm = arr_push(wasm, leb[j])
                j = j + 1

        else
            0
        if op == OP_LOAD_VAR
            wasm = arr_push(wasm, WASM_LOCAL_GET)
            let leb = ri_uleb128(op1)
            let j = 0
            for j < leb.len()
                wasm = arr_push(wasm, leb[j])
                j = j + 1

        else
            0
        if op == OP_ALU_BINOP
            wasm = arr_push(wasm, ri_binop_to_wasm(op1))

        else
            0
        if op == OP_LET_BIND || op == OP_ASSIGN
            wasm = arr_push(wasm, WASM_LOCAL_SET)
            let leb = ri_uleb128(op1)
            let j = 0
            for j < leb.len()
                wasm = arr_push(wasm, leb[j])
                j = j + 1

        else
            0
        if op == OP_CALL
            wasm = arr_push(wasm, WASM_CALL)
            let leb = ri_uleb128(op1)
            let j = 0
            for j < leb.len()
                wasm = arr_push(wasm, leb[j])
                j = j + 1

        else
            0
        if op == OP_PRINT || op == OP_SEQ
            wasm = arr_push(wasm, WASM_DROP)

        i = i + 1
    wasm

let compile_ast_to_wasm(ast) =
    let empty_var_map = arr_new()
    let phase1 = ast_to_residue(ast, empty_var_map)
    let residue_table = phase1[0]
    let optimized = ri_optimize(residue_table)
    let wasm_bytes = ri_to_wasm(optimized)
    wasm_bytes

let ri_stats(table) =
    let counts = arr_new_n(27)
    let i = 0
    for i < table.len()
        let op = table[i][0]
        if op < 27
            counts[op] = counts[op] + 1
        i = i + 1
    counts
