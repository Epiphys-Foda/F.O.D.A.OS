let bs_create(n) =
    let num_words = (n + 31) / 32
    let words = arr_new_n(num_words)
    let result = arr_new()
    result = arr_push(result, words)
    result = arr_push(result, n)
    result

let bs_word_index(bit) = bit / 32
let bs_bit_offset(bit) = bit % 32

let bs_set(bs, bit) =
    let words = bs[0]
    let wi = bit / 32
    let bo = bit % 32
    let mask = 1
    let i = 0
    for i < bo
        mask = mask * 2
        i = i + 1
    words[wi] = words[wi] | mask
    bs[0] = words
    bs

let bs_clear(bs, bit) =
    let words = bs[0]
    let wi = bit / 32
    let bo = bit % 32
    let mask = 1
    let i = 0
    for i < bo
        mask = mask * 2
        i = i + 1
    words[wi] = words[wi] & (0 - 1 - mask)
    bs[0] = words
    bs

let bs_test(bs, bit) =
    let words = bs[0]
    let wi = bit / 32
    let bo = bit % 32
    let word = words[wi]
    let shifted = word
    let i = 0
    for i < bo
        shifted = shifted / 2
        i = i + 1
    shifted % 2

let bs_flip(bs, bit) =
    if bs_test(bs, bit) == 1
        bs_clear(bs, bit)
    else
        bs_set(bs, bit)

let bs_set_all(bs) =
    let words = bs[0]
    let n = words.len()
    let i = 0
    for i < n
        words[i] = 0 - 1
        i = i + 1
    bs[0] = words
    bs

let bs_clear_all(bs) =
    let words = bs[0]
    let n = words.len()
    let i = 0
    for i < n
        words[i] = 0
        i = i + 1
    bs[0] = words
    bs

let bs_popcount(bs) =
    let words = bs[0]
    let n = words.len()
    let count = 0
    let i = 0
    for i < n
        let w = words[i]
        for w != 0
            count = count + (w % 2)
            w = w / 2
        i = i + 1
    count

let bs_find_first(bs) =
    let words = bs[0]
    let n = words.len()
    let i = 0
    for i < n
        let w = words[i]
        if w != 0
            let bit = 0
            for w % 2 == 0
                w = w / 2
                bit = bit + 1
            return i * 32 + bit
        i = i + 1
    0 - 1

let bs_find_last(bs) =
    let words = bs[0]
    let n = words.len()
    let i = n - 1
    for i >= 0
        let w = words[i]
        if w != 0
            let bit = 31
            let mask = 1
            let j = 0
            for j < 31
                mask = mask * 2
                j = j + 1
            for bit >= 0
                if (w & mask) != 0
                    return i * 32 + bit
                mask = mask / 2
                bit = bit - 1
        i = i - 1
    0 - 1

let bs_and(a, b) =
    let words_a = a[0]
    let words_b = b[0]
    let n = words_a.len()
    let result_words = arr_new_n(n)
    let i = 0
    for i < n
        result_words[i] = words_a[i] & words_b[i]
        i = i + 1
    let result = arr_new()
    result = arr_push(result, result_words)
    result = arr_push(result, a[1])
    result

let bs_or(a, b) =
    let words_a = a[0]
    let words_b = b[0]
    let n = words_a.len()
    let result_words = arr_new_n(n)
    let i = 0
    for i < n
        result_words[i] = words_a[i] | words_b[i]
        i = i + 1
    let result = arr_new()
    result = arr_push(result, result_words)
    result = arr_push(result, a[1])
    result

let bs_xor(a, b) =
    let words_a = a[0]
    let words_b = b[0]
    let n = words_a.len()
    let result_words = arr_new_n(n)
    let i = 0
    for i < n
        result_words[i] = words_a[i] ^ words_b[i]
        i = i + 1
    let result = arr_new()
    result = arr_push(result, result_words)
    result = arr_push(result, a[1])
    result

let bs_not(bs) =
    let words = bs[0]
    let n = words.len()
    let result_words = arr_new_n(n)
    let i = 0
    for i < n
        result_words[i] = 0 - 1 - words[i]
        i = i + 1
    let result = arr_new()
    result = arr_push(result, result_words)
    result = arr_push(result, bs[1])
    result

let bs_is_empty(bs) =
    bs_popcount(bs) == 0

let bs_is_full(bs) =
    bs_popcount(bs) == bs[1]

let bs_count(bs) = bs_popcount(bs)

let bs_size(bs) = bs[1]

let bs_clone(bs) =
    let words = bs[0]
    let n = words.len()
    let new_words = arr_new_n(n)
    let i = 0
    for i < n
        new_words[i] = words[i]
        i = i + 1
    let result = arr_new()
    result = arr_push(result, new_words)
    result = arr_push(result, bs[1])
    result

let bs_to_array(bs) =
    let result = arr_new()
    let n = bs[1]
    let i = 0
    for i < n
        if bs_test(bs, i) == 1
            result = arr_push(result, i)
        i = i + 1
    result

let bs_from_array(indices, size) =
    let bs = bs_create(size)
    let n = indices.len()
    let i = 0
    for i < n
        bs = bs_set(bs, indices[i])
        i = i + 1
    bs

