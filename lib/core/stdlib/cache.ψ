let ttl_create(ttl) =
    let cache = arr_new()
    cache = arr_push(cache, arr_new())
    cache = arr_push(cache, arr_new())
    cache = arr_push(cache, arr_new())
    cache = arr_push(cache, ttl)
    cache = arr_push(cache, 0)
    cache

let ttl_tick(cache, delta) =
    cache[4] = cache[4] + delta
    cache

let ttl_put(cache, key, value) =
    let keys = cache[0]
    let values = cache[1]
    let timestamps = cache[2]
    let current_time = cache[4]
    let n = keys.len()
    let found = 0 - 1
    let i = 0
    for i < n
        if keys[i] == key
            found = i
        i = i + 1
    if found >= 0
        values[found] = value
        timestamps[found] = current_time
    else
        keys = arr_push(keys, key)
        values = arr_push(values, value)
        timestamps = arr_push(timestamps, current_time)
        cache[0] = keys
        cache[1] = values
        cache[2] = timestamps
    cache

let ttl_get(cache, key) =
    let keys = cache[0]
    let values = cache[1]
    let timestamps = cache[2]
    let ttl = cache[3]
    let current_time = cache[4]
    let n = keys.len()
    let i = 0
    for i < n
        if keys[i] == key
            if current_time - timestamps[i] <= ttl
                return values[i]
            return 0 - 1
        i = i + 1
    0 - 1

let ttl_cleanup(cache) =
    let keys = cache[0]
    let values = cache[1]
    let timestamps = cache[2]
    let ttl = cache[3]
    let current_time = cache[4]
    let new_keys = arr_new()
    let new_values = arr_new()
    let new_timestamps = arr_new()
    let n = keys.len()
    let i = 0
    for i < n
        if current_time - timestamps[i] <= ttl
            new_keys = arr_push(new_keys, keys[i])
            new_values = arr_push(new_values, values[i])
            new_timestamps = arr_push(new_timestamps, timestamps[i])
        i = i + 1
    cache[0] = new_keys
    cache[1] = new_values
    cache[2] = new_timestamps
    cache

