let clu_a2_step(xp, xc) = (1 + xc) / xp

let clu_a2_seq_impl(xp, xc, n, k, acc) =
    if k >= n
        acc
    else
      let nx = (1 + xc) / xp
      clu_a2_seq_impl(xc, nx, n, k + 1, acc.push(nx))

let clu_a2_seq(x0, x1, n) = clu_a2_seq_impl(x0, x1, n, 2, [x0, x1])

let clu_a1_step(xp, xc) = (xc * xc + 1) / xp

let clu_a1_seq_impl(xp, xc, n, k, acc) =
    if k >= n
        acc
    else
      let nx = (xc * xc + 1) / xp
      clu_a1_seq_impl(xc, nx, n, k + 1, acc.push(nx))

let clu_a1_seq(x0, x1, n) = clu_a1_seq_impl(x0, x1, n, 2, [x0, x1])

let clu_fib_impl(a, b, k, n) =
    if k >= 2 * n - 1
        b
    else
        clu_fib_impl(b, a + b, k + 1, n)

let clu_fib_odd(n) = clu_fib_impl(1, 1, 2, n)

let clu_markov_check(x, y, z) = x * x + y * y + z * z == 3 * x * y * z

let clu_check_a2_rel_impl(s, i, end, ok) =
    if i < end
      let lhs = s[i + 1] * s[i - 1]
      let rhs = 1 + s[i]
      if lhs != rhs
          false
      else
          clu_check_a2_rel_impl(s, i + 1, end, ok)
    else
        ok

let clu_all_true_impl(results, i, n, ok) =
    if i < n
      let v = results[i]
      if v == false
          false
      else
          clu_all_true_impl(results, i + 1, n, ok)
    else
        ok

let clu_all_true(results) = clu_all_true_impl(results, 0, len(results), true)

