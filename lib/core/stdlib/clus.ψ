let clu_inv(a, p) =
    if a == 0
        0
    else
      clu_pow_mod(a, p - 2, p)

let clu_pow_mod_impl(base, exp, p, acc) =
    if exp > 0
        let new_acc = if exp - (exp / 2) * 2 == 1
            let r = acc * base
            r - r / p * p
        else
            acc
        let r2 = base * base
        let new_base = r2 - r2 / p * p
        clu_pow_mod_impl(new_base, exp / 2, p, new_acc)
    else
        acc
let clu_pow_mod(base, exp, p) = clu_pow_mod_impl(base, exp, p, 1)

let clu_a2_gf_impl(p, n, k, xp, xc, acc) =
    if k > n
        acc
    else
      let inv_xp = clu_inv(xp, p)
      let nx = ((1 + xc) * inv_xp) - ((1 + xc) * inv_xp) / p * p
      clu_a2_gf_impl(p, n, k + 1, xc, nx, acc.push(nx))

let clu_a2_gf(p, n) = clu_a2_gf_impl(p, n, 2, 1, 1, [1, 1])

let clu_a1_gf_impl(p, n, k, xp, xc, acc) =
    if k > n
        acc
    else
      let inv_xp = clu_inv(xp, p)
      let num = xc * xc + 1
      let nx_raw = num * inv_xp
      let nx = nx_raw - nx_raw / p * p
      clu_a1_gf_impl(p, n, k + 1, xc, nx, acc.push(nx))

let clu_a1_gf(p, n) = clu_a1_gf_impl(p, n, 2, 1, 1, [1, 1])

let clu_a1_period_impl(p, limit, k, xp, xc) =
    if k > limit
        0
    else
      let inv_xp = clu_inv(xp, p)
      let num = xc * xc + 1
      let nx_raw = num * inv_xp
      let nx = nx_raw - nx_raw / p * p
      if xc == 1 && nx == 1
          k - 1
      else
          0
      if nx == 0
          0
      else
          clu_a1_period_impl(p, limit, k + 1, xc, nx)

let clu_a1_period(p, limit) = clu_a1_period_impl(p, limit, 2, 1, 1)

