let time_days_in_month(year, month) =
    if month == 1 || month == 3 || month == 5 || month == 7 || month == 8 || month == 10 || month == 12
        31
    else
        0
    if month == 4 || month == 6 || month == 9 || month == 11
        30
    else
        0
    if month == 2
        let leap = 0
        if year % 4 == 0
            leap = 1
        if year % 100 == 0
            leap = 0
        if year % 400 == 0
            leap = 1
        (leap == 1 ? 29 : 28)

let time_is_leap_year(year) =
    let leap = 0
    if year % 4 == 0
        leap = 1
    if year % 100 == 0
        leap = 0
    if year % 400 == 0
        leap = 1
    leap

let time_day_of_year(year, month, day) =
    let doy = day
    let m = 1
    for m < month
        doy = doy + time_days_in_month(year, m)
        m = m + 1
    doy

let time_date_to_days(year, month, day) =
    let days = 0
    let y = 1970
    for y < year
        if time_is_leap_year(y) == 1
            days = days + 366
        else
            days = days + 365
        y = y + 1
    days = days + time_day_of_year(year, month, day) - 1
    days

let time_days_to_date(days) =
    let remaining = days
    let year = 1970
    let year_days = 365
    if time_is_leap_year(year) == 1
        year_days = 366
    for remaining >= year_days
        remaining = remaining - year_days
        year = year + 1
        year_days = 365
        if time_is_leap_year(year) == 1
            year_days = 366
    let month = 1
    let month_days = time_days_in_month(year, month)
    for remaining >= month_days
        remaining = remaining - month_days
        month = month + 1
        month_days = time_days_in_month(year, month)
    let result = arr_new()
    result = arr_push(result, year)
    result = arr_push(result, month)
    result = arr_push(result, remaining + 1)
    result

let time_day_of_week(year, month, day) =
    let y = year
    let m = month
    if m < 3
        m = m + 12
        y = y - 1
    let k = y % 100
    let j = y / 100
    let h = day + (13 * (m + 1)) / 5 + k + k / 4 + j / 4 + 5 * j
    h % 7

let time_add_days(year, month, day, n) =
    let days = time_date_to_days(year, month, day) + n
    time_days_to_date(days)

let time_sub_days(year, month, day, n) =
    let days = time_date_to_days(year, month, day) - n
    time_days_to_date(days)

let time_days_between(y1, m1, d1, y2, m2, d2) =
    let days1 = time_date_to_days(y1, m1, d1)
    let days2 = time_date_to_days(y2, m2, d2)
    days2 - days1

let time_is_valid_date(year, month, day) =
    if year < 1
        return 0
    if month < 1 || month > 12
        return 0
    if day < 1 || day > time_days_in_month(year, month)
        return 0
    1

let time_week_number(year, month, day) =
    let doy = time_day_of_year(year, month, day)
    let dow = time_day_of_week(year, month, day)
    (doy - dow + 10) / 7

let time_quarter(month) =
    (month - 1) / 3 + 1

let time_is_weekend(year, month, day) =
    let dow = time_day_of_week(year, month, day)
    (dow == 0 || dow == 6 ? 1 : 0)

let time_format_duration(seconds) =
    let s = seconds
    if s < 0
        s = 0 - s
    let hours = s / 3600
    s = s % 3600
    let minutes = s / 60
    s = s % 60
    let result = ""
    if hours > 0
        result = result + hours + "h "
    if minutes > 0 || hours > 0
        result = result + minutes + "m "
    result = result + s + "s"
    result

let time_format_hms(seconds) =
    let s = seconds
    if s < 0
        s = 0 - s
    let hours = s / 3600
    s = s % 3600
    let minutes = s / 60
    s = s % 60
    let result = ""
    if hours < 10
        result = result + "0"
    result = result + hours + ":"
    if minutes < 10
        result = result + "0"
    result = result + minutes + ":"
    if s < 10
        result = result + "0"
    result = result + s
    result

