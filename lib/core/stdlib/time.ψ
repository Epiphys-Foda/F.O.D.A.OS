let time_format_date(year, month, day) =
    let result = "" + year + "-"
    if month < 10
        result = result + "0"
    result = result + month + "-"
    if day < 10
        result = result + "0"
    result = result + day
    result

let time_epoch_to_date(epoch) =
    let days = epoch / 86400
    time_days_to_date(days)

let time_date_to_epoch(year, month, day, hour, minute, second) =
    let days = time_date_to_days(year, month, day)
    days * 86400 + hour * 3600 + minute * 60 + second

let time_age(birth_year, birth_month, birth_day, now_year, now_month, now_day) =
    let age = now_year - birth_year
    if now_month < birth_month || (now_month == birth_month && now_day < birth_day)
        age = age - 1
    age

