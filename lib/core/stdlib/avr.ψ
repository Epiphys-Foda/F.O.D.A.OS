    let code = avr_compile(ast)
    avr_exec(code, 0)

let av_test_fn_add() =
    let ast = ["seq", ["fn", "add", ["a", "b"], ["binop", "+", ["var", "a"], ["var", "b"]]], ["let", "r", ["call", "add", [["lit", 17], ["lit", 25]]]]]
    let code = avr_compile(ast)
    avr_exec(code, 0)

let av_test_nested_fn() =
    let ast = ["seq", ["fn", "sq", ["x"], ["binop", "*", ["var", "x"], ["var", "x"]]], ["let", "r", ["call", "sq", [["lit", 7]]]]]
    let code = avr_compile(ast)
    avr_exec(code, 0)

let av_test_negative() =
    let ast = ["seq", ["let", "a", ["binop", "-", ["lit", 0], ["lit", 5]]]]
    let code = avr_compile(ast)
    avr_exec(code, 0)

let av_test_bitwise() =
    let ast = ["seq", ["let", "a", ["binop", "&", ["lit", 12], ["lit", 10]]]]
    let code = avr_compile(ast)
    avr_exec(code, 0)

let av_test_shift() =
    let ast = ["seq", ["let", "a", ["binop", "<<", ["lit", 1], ["lit", 4]]]]
    let code = avr_compile(ast)
    avr_exec(code, 0)

let av_run_all_tests() =
    let results = []
    results = results.push(["add", av_test_add(), 7])
    results = results.push(["sub", av_test_sub(), 7])
    results = results.push(["mul", av_test_mul(), 42])
    results = results.push(["div", av_test_div(), 42])
    results = results.push(["mod", av_test_mod(), 1])
    results = results.push(["var_ref", av_test_var_ref(), 11])
    results = results.push(["chain", av_test_chain(), 5])
    results = results.push(["if_true", av_test_if_true(), 10])
    results = results.push(["if_false", av_test_if_false(), 20])
    results = results.push(["for_loop", av_test_for_loop(), 10])
    results = results.push(["for_loop_10", av_test_for_loop_10(), 45])
    results = results.push(["fn_call", av_test_fn_call(), 42])
    results = results.push(["fn_add", av_test_fn_add(), 42])
    results = results.push(["nested_fn", av_test_nested_fn(), 49])
    results = results.push(["negative", av_test_negative(), -5])
    results = results.push(["bitwise", av_test_bitwise(), 8])
    results = results.push(["shift", av_test_shift(), 16])
    let pass = 0
    let fail = 0
    let i = 0
    for i < len(results)
      let name = results[i][0]
      let got = results[i][1]
      let want = results[i][2]
      if got == want
        pass = pass + 1
      else
        fail = fail + 1
      i = i + 1
    [pass, fail, results]
