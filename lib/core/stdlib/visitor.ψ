let true VIS_COUNT = [0]
let true VIS_DEPTH = [0]
let true VIS_CUR = [0]
let true VIS_VARS = [[]]
let true VIS_ENV = [0]

let visitor_new(kind) =
    [kind]

let visitor_default(node) =
    0

let ast_visit_children(kind, node) =
    let i = 2
    for i < node.len()
        if node[i].len() > 0
            visitor_dispatch(kind, node[i])
        i = i + 1

let visitor_visit(visitor, node) =
    visitor_dispatch(visitor[0], node)

let visitor_dispatch(kind, node) =
    if kind == 1
        visitor_count(node)
    else
        if kind == 2
            visitor_depth(node)
        else
            if kind == 3
                visitor_eval(node)
            else
                if kind == 4
                    visitor_to_string(node)
                else
                    if kind == 5
                        visitor_collect_vars(node)
                    else
                        visitor_default(node)

let visitor_count(node) =
    VIS_COUNT[0] = VIS_COUNT[0] + 1
    if node[0] == "add"
        ast_visit_children(1, node)
    else
        if node[0] == "mul"
            ast_visit_children(1, node)
        else
            0

let visitor_depth(node) =
    if node[0] == "num"
        if VIS_CUR[0] > VIS_DEPTH[0]
            VIS_DEPTH[0] = VIS_CUR[0]
        else
            0
    else
        if node[0] == "var"
            if VIS_CUR[0] > VIS_DEPTH[0]
                VIS_DEPTH[0] = VIS_CUR[0]
            else
                0
        else
            if node[0] == "add"
                VIS_CUR[0] = VIS_CUR[0] + 1
                ast_visit_children(2, node)
                VIS_CUR[0] = VIS_CUR[0] - 1
            else
                if node[0] == "mul"
                    VIS_CUR[0] = VIS_CUR[0] + 1
                    ast_visit_children(2, node)
                    VIS_CUR[0] = VIS_CUR[0] - 1
                else
                    0

let visitor_eval(node) =
    if node[0] == "num"
        node[1]
    else
        if node[0] == "var"
            let env = VIS_ENV[0]
            let hit = arr_get(env, node[1])
            if hit[0] == 1
                hit[1]
            else
                0
        else
            if node[0] == "add"
                visitor_eval(node[1]) + visitor_eval(node[2])
            else
                if node[0] == "mul"
                    visitor_eval(node[1]) * visitor_eval(node[2]) / 1000
                else
                    0

let visitor_to_string(node) =
    if node[0] == "num"
        to_str(node[1])
    else
        if node[0] == "var"
            node[1]
        else
            if node[0] == "add"
                str_concat(str_concat(str_concat("(", visitor_to_string(node[1])), " + "), str_concat(visitor_to_string(node[2]), ")"))
            else
                if node[0] == "mul"
                    str_concat(str_concat(str_concat("(", visitor_to_string(node[1])), " * "), str_concat(visitor_to_string(node[2]), ")"))
                else
                    ""

let visitor_collect_vars(node) =
    if node[0] == "var"
        VIS_VARS[0] = arr_concat(VIS_VARS[0], [node[1]])
    else
        if node[0] == "add"
            ast_visit_children(5, node)
        else
            if node[0] == "mul"
                ast_visit_children(5, node)
            else
                0

let ast_count_nodes() =
    VIS_COUNT[0] = 0
    [1]
let ast_depth() =
    VIS_DEPTH[0] = 0
    VIS_CUR[0] = 0
    [2]
let ast_eval(env) =
    VIS_ENV[0] = env
    [3]
let ast_to_string() =
    [4]
let ast_collect_vars() =
    VIS_VARS[0] = []
    [5]

let main() =
    let ast = ["mul", ["add", ["var", "x"], ["num", 3]], ["var", "y"]]
    visitor_visit(ast_count_nodes(), ast)
    print(VIS_COUNT[0])
    visitor_visit(ast_depth(), ast)
    print(VIS_DEPTH[0])
    visitor_visit(ast_collect_vars(), ast)
    print(VIS_VARS[0].len())
    0
