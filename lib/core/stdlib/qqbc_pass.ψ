import "qqbc_micro.ψ"

let pass_constant_fold(micro_seq) =
    let n = len(micro_seq)
    if n == 7
      let t1 = micro_seq[0]
      let a = micro_seq[1]
      let t2 = micro_seq[2]
      let b = micro_seq[3]
      let op = micro_seq[4]
      let emit = micro_seq[5]
      let end = micro_seq[6]
      let is_pattern = t1 == 16 && t2 == 16 && emit == 17 && end == 255
      if is_pattern
        let foldable = op == 10 || op == 11 || op == 12 || op == 22 || op == 30 || op == 31 || op == 50 || op == 51 || op == 52 || op == 60 || op == 61 || op == 62 || op == 40
        if foldable
          let result = micro_eval(op, [a, b])
          [16, result, 17, 255]
        else
            0
      else
          0
    else
      0
    micro_seq

