let qs_sqrt2() =
    let r = 0
    let i = 1
    let done = false
    for !done
      if i < 65537
        let sq = qc_mul(i, i)
        if sq == 2
          r = i
          done = true
        else
          0
        if done == false
          i = i + 1
        else
            0
      else
        done = true
    r

let qs_h_gf() =
    let r = qs_sqrt2()
    let inv_r = qc_inv(r)
    [[inv_r, inv_r], [inv_r, 65537 - inv_r]]

let qs_state_n(n) =
    let state = [1]
    let i = 0
    let done = false
    for !done
      if i < n
        let doubled = state
        let j = 0
        let jd = false
        for !jd
          if j < len(doubled)
            doubled = [doubled.slice(0, j), 0, doubled.slice(j + 1, len(doubled))].flat()
            j = j + 1
          else
            jd = true
        state = [state, doubled].flat()
        i = i + 1
      else
        done = true
    state

let qs_measure_det(state) =
    let best = 0
    let best_val = -1
    let i = 0
    let n = len(state)
    let done = false
    for !done
      if i < n
        let a = state[i]
        let amp = qc_mul(a, a)
        if amp > best_val
          best_val = amp
          best = i
        else
          0
        i = i + 1
      else
        done = true
    best

let qs_grover_iter(state, target) =
    let s = state
    let oi = 0
    let od = false
    for !od
      if oi < 2
        if oi == target
          s = [s.slice(0, oi), 65537 - s[oi], s.slice(oi + 1, 2)].flat()
        else
          0
        oi = oi + 1
      else
        od = true
        0
      0
    let mean = qc_mul(s[0] + s[1], qc_inv(2))
    let d0 = (qc_mul(2, mean) - s[0] + 65537) % 65537
    let d1 = (qc_mul(2, mean) - s[1] + 65537) % 65537
    [d0, d1]

let qs_grover1(target) =
    let state = qs_h_gf_apply([1, 0])
    let k = 0
    let done = false
    for !done
      if k < 1
        state = qs_grover_iter(state, target)
        k = k + 1
      else
        done = true
    qs_measure_det(state)

let qs_h_gf_apply(state) =
    let h = qs_h_gf()
    qs_apply1(h, state)

let qs_hh4() = [[1, 1, 1, 1], [1, 65536, 1, 65536], [1, 1, 65536, 65536], [1, 65536, 65536, 1]]

let qs_matvec4(m, v) =
    let out = []
    let i = 0
    let idone = false
    for !idone
      if i < 4
        let acc = 0
        let j = 0
        let jdone = false
        for !jdone
          if j < 4
            let a = m[i][j]
            let b = v[j]
            acc = acc + qc_mul(a, b)
            j = j + 1
          else
            jdone = true
        out = out.push(acc % 65537)
        i = i + 1
      else
        idone = true
    out

let qs_grover2_iter(state, target) =
    let s = state
    let oi = 0
    let od = false
    for !od
      if oi < 4
        if oi == target
          s = [s.slice(0, oi), (65537 - s[oi]) % 65537, s.slice(oi + 1, 4)].flat()
        else
          0
        oi = oi + 1
      else
        od = true
    let h4 = qs_hh4()
    let w = qs_matvec4(h4, s)
    let z = [w[0], (65537 - w[1]) % 65537, (65537 - w[2]) % 65537, (65537 - w[3]) % 65537]
    qs_matvec4(h4, z)

let qs_grover2(target) =
    let out = qs_grover2_iter([1, 1, 1, 1], target)
    qs_measure_det(out)

let qs_verify_gf() =
    let results = []
    let r = qs_sqrt2()
    results = results.push(qc_mul(r, r) == 2)
    results = results.push(r > 0 && r < 65537)
    let h = qs_h_gf()
    let h0 = qs_h_gf_apply([1, 0])
    results = results.push(h0[0] == h0[1])
    results = results.push(h0[0] == qc_inv(r))
    let hh = qs_h_gf_apply(qs_h_gf_apply([1, 0]))
    let expect = (qc_mul(2, qc_mul(qc_inv(r), qc_inv(r)))) % 65537
    results = results.push(hh[0] == expect)
    results = results.push(qs_grover1(0) == 0)
    results = results.push(qs_grover1(1) == 1)
    let st3 = qs_state_n(3)
    results = results.push(len(st3) == 8)
    results

