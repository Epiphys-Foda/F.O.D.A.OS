let qs_grover_n_step(a, b, n) =
    let p2 = if n == 0
      1
    else
      if n == 1
        2
      else
        if n == 2
          4
        else
          if n == 3
            8
          else
            if n == 4
              16
            else
              if n == 5
                32
              else
                if n == 6
                  64
                else
                  if n == 7
                    128
                  else
                    if n == 8
                      256
                    else
                      if n == 9
                        512
                      else
                        if n == 10
                          1024
                        else
                          if n == 11
                            2048
                          else
                            if n == 12
                              4096
                            else
                              if n == 13
                                8192
                              else
                                if n == 14
                                  16384
                                else
                                  if n == 15
                                    32768
                                  else
                                    65536
    let p2n1 = (p2 * 2) % 65537
    let alpha = (p2 - 2) % 65537
    let beta = (p2n1 - 2) % 65537
    let a2 = (alpha * a + beta * b) % 65537
    let b2 = ((0 - 2) * a + alpha * b) % 65537
    [a2, b2]

let qs_grover_n_orbit(n, iters) =
    let a = 1
    let b = 1
    let i = 0
    let done = false
    for !done
      if i < iters
        let st = qs_grover_n_step(a, b, n)
        a = st[0]
        b = st[1]
        i = i + 1
      else
        done = true
    [a, b]

let qs_grover_n_hit(n, iters) =
    let st = qs_grover_n_orbit(n, iters)
    let a2 = qc_mul(st[0], st[0])
    let b2 = qc_mul(st[1], st[1])
    a2 > b2

