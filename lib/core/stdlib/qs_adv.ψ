let qs_grover3(target, iters) =
    let state = [1, 1, 1, 1, 1, 1, 1, 1]
    let i = 0
    let done = false
    for !done
      if i < iters
        state = qs_grover3_iter(state, target)
        i = i + 1
      else
        done = true
    state

let qs_grover3_hit(target, iters) =
    let st = qs_grover3(target, iters)
    let best = qs_measure_det(st)
    let a2 = qc_mul(st[target], st[target])
    let b2 = qc_mul(st[0], st[0])
    best == target && a2 >= b2

