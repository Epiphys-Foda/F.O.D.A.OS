let qs_grover3_iter(state, target) =
    let s = state
    let oi = 0
    let od = false
    for !od
      if oi < 8
        if oi == target
          s = [s.slice(0, oi), (65537 - s[oi]) % 65537, s.slice(oi + 1, 8)].flat()
        else
          0
        oi = oi + 1
      else
        od = true
    let h8 = qs_hh8()
    let w = qs_matvec8(h8, s)
    let z = w
    z = [w[0], (65537 - w[1]) % 65537, (65537 - w[2]) % 65537, (65537 - w[3]) % 65537, (65537 - w[4]) % 65537, (65537 - w[5]) % 65537, (65537 - w[6]) % 65537, (65537 - w[7]) % 65537]
