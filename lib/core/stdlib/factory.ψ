let factory_register(registry, type_name, constructor) =
    registry[type_name] = constructor

let factory_create(registry, type_name, params) =
    let constructor = registry[type_name]
    if constructor != 0
        constructor(params)
    else
        0

let factory_unregister(registry, type_name) =
    registry[type_name] = 0

