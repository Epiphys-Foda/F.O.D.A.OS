let doc_entry_make(name, kind, sig, desc) =
    let e = arr_new_n(4)
    e[0] = name
    e[1] = kind
    e[2] = sig
    e[3] = desc
    e

let DOC_FN = 0
let DOC_LET = 1
let DOC_MODULE = 2
let DOC_TYPE = 3
let DOC_CONST = 4

let doc_extract(source) =
    let entries = arr_new()
    let n = source.len()
    let i = 0
    let current_comment = arr_new()
    let in_comment = 0
    for i < n
        let c = source[i]
        if c == 47 && i + 1 < n && source[i + 1] == 47
            in_comment = 1
            i = i + 2
            for i < n && source[i] != 10
                current_comment = arr_push(current_comment, source[i])
                i = i + 1
        else
            if c == 10
                in_comment = 0
                if i + 4 < n && source[i + 1] == 108 && source[i + 2] == 101 && source[i + 3] == 116 && source[i + 4] == 32
                    let name_start = i + 5
                    let name_end = name_start
                    for name_end < n && source[name_end] != 40 && source[name_end] != 32 && source[name_end] != 61
                        name_end = name_end + 1
                    if current_comment.len() > 0
                        let entry = doc_entry_make(0, DOC_FN, 0, current_comment)
                        entries = arr_push(entries, entry)
                    current_comment = arr_new()
                i = i + 1
            else
                if in_comment == 0
                    current_comment = arr_new()
                i = i + 1
    entries
let doc_to_html(entries, title) =
    let html = arr_new()
    let append_str(s) =
        let j = 0
        for j < s.len()
            html = arr_push(html, s[j])
            j = j + 1
    append_str("<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<title>")
    append_str(title)
    append_str("</title>\n</head>\n<body>\n<h1>")
    append_str(title)
    append_str("</h1>\n")
    let i = 0
    for i < entries.len()
        let e = entries[i]
        append_str("<div>\n<h2>")
        if e[0] != 0
            append_str(e[0])
        append_str("</h2>\n<p>")
        if e[3] != 0
            append_str(e[3])
        append_str("</p>\n</div>\n")
        i = i + 1
    append_str("</body>\n</html>\n")
    html

let doc_to_markdown(entries, title) =
    let md = arr_new()
    let append_str(s) =
        let j = 0
        for j < s.len()
            md = arr_push(md, s[j])
            j = j + 1
    append_str("# ")
    append_str(title)
    append_str("\n\n")
    let i = 0
    for i < entries.len()
        let e = entries[i]
        append_str("## ")
        if e[0] != 0
            append_str(e[0])
        append_str("\n\n")
        if e[3] != 0
            append_str(e[3])
        append_str("\n\n")
        i = i + 1
    md

let doc_summary(entries) =
    let summary = arr_new_n(5)
    let i = 0
    for i < 5
        summary[i] = 0
        i = i + 1
    let i = 0
    for i < entries.len()
        let kind = entries[i][1]
        if kind < 5
            summary[kind] = summary[kind] + 1
        i = i + 1
    summary
