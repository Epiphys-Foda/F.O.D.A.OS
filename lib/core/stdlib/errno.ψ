let SUCCESS = 0
let E_TIMEOUT = -1
let E_CONFLICT = -2
let E_OVERFLOW = -3
let E_NOT_FOUND = -4
let E_FORMAT = -5
let E_PERMISSION = -6
let E_MEMORY = -7
let E_IO = -8
let E_INVALID = -9

let errno_class(code) =
    if code == 0
        0
    if code < 0
        1
    2

let errno_ok(code) = code == 0

let errno_err(code) = code < 0

let errno_warn(code) = code > 0

let errno_message_idx(code) =
    if code == 0
        0
    if code == -1
        1
    if code == -2
        2
    if code == -3
        3
    if code == -4
        4
    if code == -5
        5
    if code == -6
        6
    if code == -7
        7
    if code == -8
        8
    if code == -9
        9
    10

let errno_wrap(code) =
    if code < 0
        code
    0

let errno_chain(prev, cur) =
    if prev < 0
        prev
    cur

let test_errno() =
        print(errno_class(0))
        print(errno_class(-4))
        print(errno_class(5))

        print(errno_ok(0))
        print(errno_ok(-1))
        print(errno_err(-3))
        print(errno_err(0))
        print(errno_warn(7))

        print(errno_message_idx(0))
        print(errno_message_idx(-1))
        print(errno_message_idx(-9))
        print(errno_message_idx(-99))

        print(errno_wrap(0))
        print(errno_wrap(-5))
        print(errno_wrap(3))

        print(errno_chain(0, -4))
        print(errno_chain(-2, 0))
        print(errno_chain(-1, -3))

        let step1 = errno_chain(0, -4)
        let step2 = errno_chain(step1, 0)
        print(step2)

        0

    test_errno()
