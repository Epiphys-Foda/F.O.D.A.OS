let binary_entropy(p) =
    if p == 0 || p == 1000
        0
    else
        let scale = 1000
        let term1 = p * log2_approx(p) / scale
        let q = scale - p
        let term2 = q * log2_approx(q) / scale
        -(term1 + term2)

