let log2_approx(x) =
    if x <= 0
        -999999
    else
        0
    if x == 1
        0
    else
        let result = 0
        let val = x
        for val >= 2
            val = val / 2
            result = result + 1
        let t = val - 1
        let ln2 = 693147
        let scale = 1000000
        let t_scaled = t * scale
        let series = t_scaled
        let t2 = t_scaled * t_scaled / scale
        series = series - t2 / 2
        let t3 = t2 * t_scaled / scale
        series = series + t3 / 3
        let t4 = t3 * t_scaled / scale
        series = series - t4 / 4
        result * scale + series * scale / ln2

let shannon_entropy(probs) =
    let entropy = 0
    let scale = 1000
    let i = 0
    for i < probs.len()
        let p = probs[i]
        if p > 0
            let log_p = log2_approx(p)
            entropy = entropy - p * log_p / scale
        i = i + 1
    entropy

let kl_divergence(p, q) =
    let result = 0
    let scale = 1000
    let i = 0
    for i < p.len()
        if p[i] > 0 && q[i] > 0
            let log_ratio = log2_approx(p[i] * scale / q[i])
            result = result + p[i] * log_ratio / scale
        i = i + 1
    result

let cross_entropy(p, q) =
    let result = 0
    let scale = 1000
    let i = 0
    for i < p.len()
        if q[i] > 0
            let log_q = log2_approx(q[i])
            result = result - p[i] * log_q / scale
        i = i + 1
    result

