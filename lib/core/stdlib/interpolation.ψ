let lagrange_basis(xs, i, x) =
    let result = 1
    let n = xs.len()
    let j = 0
    for j < n
        if j != i
            result = result * (x - xs[j]) / (xs[i] - xs[j])
        j = j + 1
    result

let lagrange_interp(xs, ys, x) =
    let result = 0
    let n = xs.len()
    let i = 0
    for i < n
        result = result + ys[i] * lagrange_basis(xs, i, x)
        i = i + 1
    result

let newton_divided_diff(xs, ys) =
    let n = xs.len()
    let table = []
    let i = 0
    for i < n
        table = arr_concat(table, [[ys[i]]])
        i = i + 1
    let j = 1
    for j < n
        let i = 0
        for i < n - j
            let dd = (table[i + 1][j - 1] - table[i][j - 1]) / (xs[i + j] - xs[i])
            table[i] = arr_concat(table[i], [dd])
            i = i + 1
        j = j + 1
    table

let newton_interp(xs, ys, x) =
    let table = newton_divided_diff(xs, ys)
    let n = xs.len()
    let result = table[0][n - 1]
    let i = n - 2
    for i >= 0
        result = result * (x - xs[i]) + table[0][i]
        i = i - 1
    result

let linear_interp(xs, ys, x) =
    let n = xs.len()
    if x <= xs[0]
        ys[0]
    else
        0
    if x >= xs[n - 1]
        ys[n - 1]
    else
        let i = 0
        for i < n - 1 && xs[i + 1] < x
            i = i + 1
        let t = (x - xs[i]) / (xs[i + 1] - xs[i])
        ys[i] + t * (ys[i + 1] - ys[i])

let neville_interp(xs, ys, x) =
    let n = xs.len()
    let p = []
    let i = 0
    for i < n
        p = arr_concat(p, [ys[i]])
        i = i + 1
    let k = 1
    for k < n
        let i = 0
        for i < n - k
            p[i] = ((x - xs[i + k]) * p[i] + (xs[i] - x) * p[i + 1]) / (xs[i] - xs[i + k])
            i = i + 1
        k = k + 1
    p[0]

let cubic_hermite_interp(x0, x1, y0, y1, dy0, dy1, x) =
    let h = x1 - x0
    let t = (x - x0) / h
    let t2 = t * t
    let t3 = t2 * t
    let h00 = 2 * t3 - 3 * t2 + 1
    let h10 = t3 - 2 * t2 + t
    let h01 = -2 * t3 + 3 * t2
    let h11 = t3 - t2
    h00 * y0 + h10 * h * dy0 + h01 * y1 + h11 * h * dy1

let piecewise_linear(xs, ys, queries) =
    let result = []
    let i = 0
    for i < queries.len()
        result = arr_concat(result, [linear_interp(xs, ys, queries[i])])
        i = i + 1
    result

