    results = results.push(["fn_call", df_test_fn_call(), 42])
    results = results.push(["fn_add", df_test_fn_add(), 42])
    results = results.push(["nested_fn", df_test_nested_fn(), 49])
    results = results.push(["negative", df_test_negative(), -5])
    results = results.push(["bitwise", df_test_bitwise(), 8])
    results = results.push(["shift", df_test_shift(), 16])
    let pass = 0
    let fail = 0
    let i = 0
    for i < len(results)
      let name = results[i][0]
      let got = results[i][1]
      let want = results[i][2]
      if got == want
        pass = pass + 1
      else
