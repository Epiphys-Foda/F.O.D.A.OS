let md_consistency(md) =
    let results = []
    let ops = md_project_ops(md)
    let pes = md_project_pes(md)
    results = results.push(len(ops) == 5)
    results = results.push(ops[0].micro == op_micro(1))
    results = results.push(ops[1].micro == op_micro(2))
    results = results.push(ops[4].micro == op_micro(5))
    results = results.push(pes[0].pe == op_pe_type(1))
    results = results.push(pes[2].pe == op_pe_type(3))
    results = results.push(pes[4].pe == op_pe_type(5))
    results

