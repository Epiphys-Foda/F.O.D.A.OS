let md_project_ops(md) =
    let result = []
    let i = 0
    let n = md.node_count
    let done = false
    let micro = -1
    for !done
      if i < 5
        micro = -1
        let node = md.nodes[i]
        let ei = 0
        let en = len(md.edges)
        let ed = false
        for !ed
          if ei < en
            let e = md.edges[ei]
            if e.src_node == i && e.dst_node >= 13
              micro = md.nodes[e.dst_node].opcode
            else
              0
            ei = ei + 1
          else
            ed = true
        result = result.push({ opcode: node.opcode, micro: micro })
        i = i + 1
      else
        done = true
    result

let md_project_pes(md) =
    let result = []
    let i = 0
    let done = false
    let pe = -1
    for !done
      if i < 5
        pe = -1
        let ei = 0
        let en = len(md.edges)
        let ed = false
        for !ed
          if ei < en
            let e = md.edges[ei]
            if e.src_node == i && e.dst_node >= 5 && e.dst_node <= 12
              pe = md.nodes[e.dst_node].pe_type
            else
              0
            ei = ei + 1
          else
            ed = true
        result = result.push({ opcode: md.nodes[i].opcode, pe: pe })
        i = i + 1
      else
        done = true
    result

