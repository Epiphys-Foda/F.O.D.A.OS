let nm_dist(v, c) =
    if v >= c
      if v - c > 32768
        65537 - (v - c)
      else
        v - c
    else
      if v - c + 65537 > 32768
        65537 - (v - c + 65537)
      else
        v - c + 65537

let nm_qam_demodulate(X) =
    let out = []
    let i = 0
    let done = false
    for !done
      if i < len(X)
        let v = X[i]
        let d0 = nm_dist(v, 1)
        let d1 = nm_dist(v, 65536)
        let d2 = nm_dist(v, 65281)
        let d3 = nm_dist(v, 256)
        let idx = (d0 <= d1 && d0 <= d2 && d0 <= d3 ? 0 : (d1 <= d2 && d1 <= d3 ? 1 : (d2 <= d3 ? 2 : 3)))
        out = out.push(idx / 2)
        out = out.push(idx % 2)
        i = i + 1
      else
        done = true
    out

