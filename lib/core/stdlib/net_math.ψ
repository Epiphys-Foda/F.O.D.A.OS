let nm_sync_rx(frame, seq) =
    let best_k = 0
    let best_v = 0
    let k = 0
    let done = false
    for !done
      if k <= len(frame) - 16
        let acc = 0
        let j = 0
        let jdone = false
        for !jdone
          if j < 16
            let same = frame[k + j] == seq[j]
            if same
              acc = acc + 1
            else
              acc = acc - 1
            j = j + 1
          else
            jdone = true
        if acc > best_v
          best_v = acc
          best_k = k
        else
          0
        k = k + 1
      else
        done = true
    [best_k, best_v]

