let io_int_to_str(n) =
    if n == 0
        return "0"
    let neg = 0
    let val = n
    if n < 0
        neg = 1
        val = 0 - n
    let digits = arr_new()
    for val > 0
        digits = arr_push(digits, val % 10)
        val = val / 10
    let result = ""
    if neg == 1
        result = "-"
    let i = digits.len() - 1
    for i >= 0
        let d = digits[i]
        if d == 0
            result = result + "0"
        else
            0
        if d == 1
            result = result + "1"
        else
            0
        if d == 2
            result = result + "2"
        else
            0
        if d == 3
            result = result + "3"
        else
            0
        if d == 4
            result = result + "4"
        else
            0
        if d == 5
            result = result + "5"
        else
            0
        if d == 6
            result = result + "6"
        else
            0
        if d == 7
            result = result + "7"
        else
            0
        if d == 8
            result = result + "8"
        else
            result = result + "9"
        i = i - 1
    result

let io_float_to_str(f) =
    let int_part = f / 65536
    let frac_part = f % 65536
    if frac_part < 0
        frac_part = 0 - frac_part
    let result = io_int_to_str(int_part)
    result = result + "."
    let scale = 10000
    let frac_digits = (frac_part * scale) / 65536
    let leading = 0
    let temp = frac_digits
    let ndigits = 0
    for temp > 0
        ndigits = ndigits + 1
        temp = temp / 10
    let zeros = 4 - ndigits
    let z = 0
    for z < zeros
        result = result + "0"
        z = z + 1
    if frac_digits > 0
        result = result + io_int_to_str(frac_digits)
    result

let io_pad_left(s, width) =
    let result = s
    for result.len() < width
        result = " " + result
    result

let io_pad_right(s, width) =
    let result = s
    for result.len() < width
        result = result + " "
    result

let io_repeat(s, n) =
    let result = ""
    let i = 0
    for i < n
        result = result + s
        i = i + 1
    result

let io_format_table(headers, rows) =
    let ncols = headers.len()
    let widths = arr_new_n(ncols)
    let c = 0
    for c < ncols
        let h = headers[c]
        widths[c] = h.len()
        c = c + 1
    let r = 0
    let nrows = rows.len()
    for r < nrows
        let row = rows[r]
        c = 0
        for c < ncols
            let cell = row[c]
            let celllen = cell.len()
            if celllen > widths[c]
                widths[c] = celllen
            c = c + 1
        r = r + 1
    let sep = ""
    c = 0
    for c < ncols
        sep = sep + "+" + io_repeat("-", widths[c] + 2)
        c = c + 1
    sep = sep + "+"
    let header_line = ""
    c = 0
    for c < ncols
        header_line = header_line + "| " + io_pad_right(headers[c], widths[c]) + " "
        c = c + 1
    header_line = header_line + "|"
    let result = sep + "\n" + header_line + "\n" + sep + "\n"
    r = 0
    for r < nrows
        let row = rows[r]
        let line = ""
        c = 0
        for c < ncols
            line = line + "| " + io_pad_right(row[c], widths[c]) + " "
            c = c + 1
        line = line + "|"
        result = result + line + "\n"
        r = r + 1
    result = result + sep
    result

let io_progress_bar(current, total, width) =
    let pct = (current * 100) / total
    let filled = (current * width) / total
    let bar = "["
    let i = 0
    for i < filled
        bar = bar + "#"
        i = i + 1
    for i < width
        bar = bar + "-"
        i = i + 1
    bar = bar + "] " + io_int_to_str(pct) + "%"
    bar

let io_hex_dump(data) =
    let result = ""
    let offset = 0
    let n = data.len()
    for offset < n
        let hex_part = io_pad_left(io_int_to_str(offset), 8) + ": "
        let ascii_part = " |"
        let i = 0
        for i < 16 && offset + i < n
            let byte = data[offset + i]
            let hi = byte / 16
            let lo = byte % 16
            hex_part = hex_part + "0123456789abcdef"[hi]
            hex_part = hex_part + "0123456789abcdef"[lo]
            hex_part = hex_part + " "
            if byte >= 32 && byte < 127
                ascii_part = ascii_part + " "[0]
            else
                ascii_part = ascii_part + "."
            i = i + 1
        for i < 16
            hex_part = hex_part + "   "
            i = i + 1
        ascii_part = ascii_part + "|"
        result = result + hex_part + ascii_part + "\n"
        offset = offset + 16
    result

let io_indent(s, level) =
    let prefix = io_repeat("  ", level)
    prefix + s

let io_join(arr, sep) =
    let n = arr.len()
    if n == 0
        return ""
    let result = arr[0]
    let i = 1
    for i < n
        result = result + sep + arr[i]
        i = i + 1
    result

let io_split(s, ch) =
    let result = arr_new()
    let current = ""
    let i = 0
    let n = s.len()
    for i < n
        let c = s[i]
        if c == ch
            result = arr_push(result, current)
            current = ""
        else
            current = current + c
        i = i + 1
    result = arr_push(result, current)
    result

