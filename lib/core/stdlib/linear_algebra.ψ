let la_mat_identity(n) =
    let result = arr_new()
    let i = 0
    for i < n
        let row = arr_new()
        let j = 0
        for j < n
            if j == i
                row = arr_push(row, 1)
            else
                row = arr_push(row, 0)
            j = j + 1
        result = arr_push(result, row)
        i = i + 1
    result

let la_mat_add(a, b) =
    let rows = a.len()
