let la_vec_dot(a, b) =
    let n = a.len()
    let result = 0
    let i = 0
    for i < n
        result = result + a[i] * b[i]
        i = i + 1
    result

let la_vec_cross(a, b) =
    let result = arr_new()
    result = arr_push(result, a[1] * b[2] - a[2] * b[1])
    result = arr_push(result, a[2] * b[0] - a[0] * b[2])
    result = arr_push(result, a[0] * b[1] - a[1] * b[0])
    result

let la_vec_norm_sq(v) = la_vec_dot(v, v)

