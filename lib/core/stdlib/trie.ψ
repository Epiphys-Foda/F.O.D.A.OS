let trie_node_create() =
    let node = arr_new()
    node = arr_push(node, arr_new_n(256))
    node = arr_push(node, 0)
    node = arr_push(node, 0)
    node

let trie_create() = trie_node_create()

let trie_insert(root, key, value) =
    let node = root
    let n = key.len()
    let i = 0
    for i < n
        let c = key[i]
        let children = node[0]
        if children[c] == 0
            children[c] = trie_node_create()
            node[0] = children
        let new_children = node[0]
        node = new_children[c]
        i = i + 1
    node[1] = 1
    node[2] = value
    root

let trie_search(root, key) =
    let node = root
    let n = key.len()
    let i = 0
    for i < n
        let c = key[i]
        let children = node[0]
        if children[c] == 0
            return 0 - 1
        node = children[c]
        i = i + 1
    if node[1] == 1
        return node[2]
    0 - 1

let trie_contains(root, key) =
    let result = trie_search(root, key)
    result != 0 - 1

let trie_has_prefix(root, prefix) =
    let node = root
    let n = prefix.len()
    let i = 0
    for i < n
        let c = prefix[i]
        let children = node[0]
        if children[c] == 0
            return 0
        node = children[c]
        i = i + 1
    1

let trie_count_prefix(root, prefix) =
    let node = root
    let n = prefix.len()
    let i = 0
    for i < n
        let c = prefix[i]
        let children = node[0]
        if children[c] == 0
            return 0
        node = children[c]
        i = i + 1
    let count = 0
    if node[1] == 1
        count = 1
    let children = node[0]
    let j = 0
    for j < 256
        if children[j] != 0
            let child = children[j]
            count = count + trie_count_node(child)
        j = j + 1
    count

let trie_count_node(node) =
    let count = 0
    if node[1] == 1
        count = 1
    let children = node[0]
    let j = 0
    for j < 256
        if children[j] != 0
            let child = children[j]
            count = count + trie_count_node(child)
        j = j + 1
    count

let trie_autocomplete_count(root, prefix) =
    trie_count_prefix(root, prefix)

let trie_longest_common_prefix(root, key) =
    let node = root
    let n = key.len()
    let lcp = 0
    let i = 0
    for i < n
        let c = key[i]
        let children = node[0]
        if children[c] == 0
            return lcp
        node = children[c]
        lcp = lcp + 1
        i = i + 1
    lcp

let trie_delete(root, key) =
    let node = root
    let n = key.len()
    let i = 0
    for i < n
        let c = key[i]
        let children = node[0]
        if children[c] == 0
            return root
        node = children[c]
        i = i + 1
    node[1] = 0
    node[2] = 0
    root

let trie_is_empty(root) =
    let children = root[0]
    let j = 0
    for j < 256
        if children[j] != 0
            return 0
        j = j + 1
    root[1] == 0

let trie_insert_word(root, word) =
    trie_insert(root, word, 1)

let trie_insert_batch(root, words) =
    let n = words.len()
    let i = 0
    for i < n
        root = trie_insert_word(root, words[i])
        i = i + 1
    root

let trie_search_all(root, keys) =
    let results = arr_new()
    let n = keys.len()
    let i = 0
    for i < n
        results = arr_push(results, trie_contains(root, keys[i]))
        i = i + 1
    results

let main() =
    let trie = trie_create()
    trie = trie_insert_word(trie, "hello")
    trie = trie_insert_word(trie, "help")
    trie = trie_insert_word(trie, "world")
    print(trie_contains(trie, "hello"))
    print(trie_contains(trie, "help"))
