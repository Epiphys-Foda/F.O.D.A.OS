let TOKEN_TYPE_UNKNOWN     = 0
let TOKEN_TYPE_GF_ELEMENT  = 1
let TOKEN_TYPE_CL_MULTI    = 2
let TOKEN_TYPE_HOMO_COORD  = 3
let TOKEN_TYPE_FREQ_SPEC   = 4

let DAG_DEFAULT_FIFO_DEPTH = 4
let DAG_DEFAULT_FUSION_GROUP = -1
let DAG_DEFAULT_SCHEDULE_HINT = 0

let dag_create() =
    { nodes: [], edges: [], node_count: 0, edge_count: 0, root: -1 }

let dag_add_node(dag, opcode, pe_type) =
    let node_id = dag.node_count
    let node =
      { node_id: node_id, opcode: opcode, pe_type: pe_type, in_ports: [], out_ports: [], fusion_group: DAG_DEFAULT_FUSION_GROUP, schedule_hint: DAG_DEFAULT_SCHEDULE_HINT, attrs: {} }
    let new_nodes = dag.nodes.push(node)
    let new_root = dag.root
    if opcode == 17
      new_root = node_id
    else
      0
    { nodes: new_nodes, edges: dag.edges, node_count: node_id + 1, edge_count: dag.edge_count, root: new_root }

let dag_add_node_v13_1(dag, opcode, pe_type, fusion_group, schedule_hint) =
    let node_id = dag.node_count
    let node =
