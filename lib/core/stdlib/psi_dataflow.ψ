let dag_max_pe_type(dag) =
    let max_pe = 0
    let i = 0
    let done = false
    for !done
      if i < dag.node_count
        let node = dag.nodes[i]
        if node.pe_type > max_pe
          max_pe = node.pe_type
        else
          0
        i = i + 1
      else
        done = true
    max_pe

let PDAG_MAGIC = [80, 68, 65, 71]
let PDAG_VERSION = 1

let dag_serialize(dag) =
    let out = PDAG_MAGIC
    out = out.push(PDAG_VERSION)
    let nc = dag.node_count
    out = out.push(nc - (nc / 256) * 256)
    out = out.push(nc / 256)
    out = out.push(dag.edge_count)
    let i = 0
    let n_done = false
    for !n_done
      if i < dag.node_count
        let node = dag.nodes[i]
        let in_deg = 0
        let j = 0
        let e_done = false
        for !e_done
          if j < dag.edge_count
            let e = dag.edges[j]
            if e.dst_node == node.node_id
              in_deg = in_deg + 1
            else
              0
            j = j + 1
          else
            e_done = true
        out = out.push(node.node_id)
        out = out.push(node.opcode)
        out = out.push(node.pe_type)
        out = out.push(in_deg)
        i = i + 1
      else
        n_done = true
        0
      0
    let k = 0
    let ed_done = false
    for !ed_done
      if k < dag.edge_count
        let e = dag.edges[k]
        out = out.push(e.src_node)
        out = out.push(e.src_port)
        out = out.push(e.dst_node)
        out = out.push(e.dst_port)
        k = k + 1
      else
        ed_done = true
    out

let dag_serialize_hex(dag) = dag_serialize(dag)

let dag_summary(dag) =
    let pe_dist = []
    let pe_init = [0, 0, 0, 0, 0, 0, 0]
    let i = 0
    let done = false
    for !done
      if i < dag.node_count
        let node = dag.nodes[i]
        let idx = (node.pe_type <= 5 ? node.pe_type - 1 : (node.pe_type == 16 ? 5 : 6))
        let old = pe_init[idx]
        pe_init = [pe_init.slice(0, idx), [old + 1], pe_init.slice(idx + 1, len(pe_init))].flat()
        i = i + 1
      else
        done = true
        0
      0
      { node_count: dag.node_count, edge_count: dag.edge_count, root: dag.root, max_pe_type: dag_max_pe_type(dag), pe_gfmul: pe_init[0], pe_clifford: pe_init[1], pe_ntt: pe_init[2], pe_born: pe_init[3], pe_hebbian: pe_init[4], pe_token: pe_init[5], pe_emit: pe_init[6] }

let dag_dump(dag) =
    let out = []
    let i = 0
    let done = false
    for !done
      if i < dag.node_count
        let node = dag.nodes[i]
        let row = [node.node_id, node.opcode, node.pe_type]
        out = out.push(row)
        i = i + 1
      else
        done = true
    out
