let linear_spline(xs, ys, x) =
    let n = xs.len()
    if x <= xs[0]
        ys[0]
    else
        0
    if x >= xs[n - 1]
        ys[n - 1]
    else
        let i = 0
        for i < n - 1 && xs[i + 1] < x
            i = i + 1
        let t = (x - xs[i]) * 1000 / (xs[i + 1] - xs[i])
        ys[i] + t * (ys[i + 1] - ys[i]) / 1000

let cubic_spline_coefficients(xs, ys) =
    let n = xs.len()
    let h = []
    let i = 0
    for i < n - 1
        h = arr_concat(h, [xs[i + 1] - xs[i]])
        i = i + 1
    let rhs = []
    let i = 0
    for i < n
        rhs = arr_concat(rhs, [0])
        i = i + 1
    let i = 1
    for i < n - 1
        rhs[i] = 6 * ((ys[i + 1] - ys[i]) / h[i] - (ys[i] - ys[i - 1]) / h[i - 1])
        i = i + 1
    let c = []
    let i = 0
    for i < n
        c = arr_concat(c, [0])
        i = i + 1
    let i = 1
    for i < n - 1
        c[i] = h[i] / (2 * (h[i - 1] + h[i]))
        i = i + 1
    let d = []
    let i = 0
    for i < n
        d = arr_concat(d, [rhs[i]])
        i = i + 1
    let i = 1
    for i < n - 1
        let denom = 2 * (h[i - 1] + h[i]) - h[i - 1] * c[i - 1]
        c[i] = h[i] / denom
        d[i] = (d[i] - h[i - 1] * d[i - 1] / (2 * (h[i - 1] + h[i]))) * 1000 / denom
        i = i + 1
    let m = []
    let i = 0
    for i < n
        m = arr_concat(m, [0])
        i = i + 1
    let i = n - 2
    for i >= 1
        m[i] = d[i] - c[i] * m[i + 1] / 1000
        i = i - 1
    m

let cubic_spline_eval(xs, ys, m, x) =
    let n = xs.len()
    if x <= xs[0]
        ys[0]
    else
        0
    if x >= xs[n - 1]
        ys[n - 1]
    else
        let i = 0
        for i < n - 1 && xs[i + 1] < x
            i = i + 1
        let h = xs[i + 1] - xs[i]
        let t = (x - xs[i])
        let a = (xs[i + 1] - x) / h
        let b = t / h
        a * ys[i] + b * ys[i + 1] + ((a * a * a - a) * m[i] + (b * b * b - b) * m[i + 1]) * h * h / 6

let catmull_rom(p0, p1, p2, p3, t) =
    let t2 = t * t / 1000
    let t3 = t2 * t / 1000
    let v = 500 * p1
    v = v + 500 * t * (p2 - p0) / 1000
    v = v + 500 * t2 * (2 * p0 - 5 * p1 + 4 * p2 - p3) / 1000
    v = v + 500 * t3 * (-p0 + 3 * p1 - 3 * p2 + p3) / 1000
    v

let quadratic_spline(xs, ys, x) =
    let n = xs.len()
    if x <= xs[0]
        ys[0]
    else
        0
    if x >= xs[n - 1]
        ys[n - 1]
    else
        let i = 0
        for i < n - 1 && xs[i + 1] < x
            i = i + 1
        if i == 0
            i = 1
        if i >= n - 1
            i = n - 2
        let x0 = xs[i - 1]
        let x1 = xs[i]
        let x2 = xs[i + 1]
        let y0 = ys[i - 1]
        let y1 = ys[i]
        let y2 = ys[i + 1]
        let l0 = (x - x1) * (x - x2) / ((x0 - x1) * (x0 - x2))
        let l1 = (x - x0) * (x - x2) / ((x1 - x0) * (x1 - x2))
        let l2 = (x - x0) * (x - x1) / ((x2 - x0) * (x2 - x1))
        l0 * y0 + l1 * y1 + l2 * y2

let bspline_basis(i, k, t, knots) =
    if k == 0
        if t >= knots[i] && t < knots[i + 1]
            1
        else
            0
    else
        let denom1 = knots[i + k] - knots[i]
        let denom2 = knots[i + k + 1] - knots[i + 1]
        let term1 = 0
        if denom1 != 0
            term1 = (t - knots[i]) * bspline_basis(i, k - 1, t, knots) / denom1
        let term2 = 0
        if denom2 != 0
            term2 = (knots[i + k + 1] - t) * bspline_basis(i + 1, k - 1, t, knots) / denom2
        term1 + term2

