let FP_SCALE = 65536
let FP_MASK = 65535

let fp_bit_add(a, b) =
    let sum = a ^ b
    let carry = (a & b) << 1
    let s = sum
    let c = carry
    for c != 0
        let ns = s ^ c
        c = (s & c) << 1
        s = ns
    s

let fp_bit_sub(a, b) = fp_bit_add(a, fp_bit_add(a ^ a ^ -1, 1))

let fp_bit_mul(a, b) =
    let result = 0
    let x = a
    let y = b
    for y != 0
        if (y & 1) == 1
            result = fp_bit_add(result, x)
        x = x << 1
        y = y >> 1
    result

let fp_from_int(n) = fp_bit_mul(n, FP_SCALE)

let fp_make(num, den) =
    if den == 0
        0
    else
        fp_bit_mul(num, FP_SCALE) / den

let fp_add(a, b) = fp_bit_add(a, b)

let fp_sub(a, b) = fp_bit_sub(a, b)

let fp_mul(a, b) = fp_bit_mul(a, b) / FP_SCALE

let fp_div(a, b) =
    if b == 0
        0
    else
        fp_bit_mul(a, FP_SCALE) / b

let fp_neg(a) = fp_bit_sub(0, a)

let fp_cmp(a, b) = fp_bit_sub(a, b)
let fp_eq(a, b) =
    (fp_bit_sub(a, b) == 0 ? 1 : 0)

let fp_to_str(a) =
    let int_part = a / FP_SCALE
    let frac_part = a & FP_MASK
    let s = arr_new()
    if int_part < 0
        s = arr_push(s, 45)
        int_part = fp_bit_sub(0, int_part)
    if int_part == 0
        s = arr_push(s, 48)
    else
        let tmp = arr_new()
        let n = int_part
        for n > 0
            tmp = arr_push(tmp, fp_bit_add(48, n % 10))
            n = n / 10
        let i = fp_bit_sub(tmp.len(), 1)
        for i >= 0
            s = arr_push(s, tmp[i])
            i = fp_bit_sub(i, 1)
    s = arr_push(s, 46)
    let f = frac_part
    let i = 0
    for i < 6
        f = fp_bit_mul(f, 10)
        let digit = f / FP_SCALE
        s = arr_push(s, fp_bit_add(48, digit))
        f = f & FP_MASK
        i = fp_bit_add(i, 1)
    s

let fp_zero() = 0
let fp_one() = FP_SCALE
let fp_half() = 32768
let fp_pi() = fp_make(314159, 100000)
let fp_e() = fp_make(271828, 100000)
let fp_sqrt2() = fp_make(141421, 100000)
let fp_inv_sqrt2() = fp_make(70711, 100000)
