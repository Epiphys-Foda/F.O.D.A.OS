let fmt_digit_char(d) =
    (d < 10 ? d + 48 : d + 55)

let fmt_int(n) =
    if n == 0
        return "0"
    let neg = 0
    let val = n
    if n < 0
        neg = 1
        val = 0 - n
    let digits = arr_new()
    for val > 0
        digits = arr_push(digits, val % 10)
        val = val / 10
    let result = ""
    if neg == 1
        result = "-"
    let i = digits.len() - 1
    for i >= 0
        result = result + fmt_digit_char(digits[i])
        i = i - 1
    result

let fmt_hex(n) =
    if n == 0
        return "0"
    let val = n
    if n < 0
        val = 0 - n
    let digits = arr_new()
    for val > 0
        digits = arr_push(digits, val % 16)
        val = val / 16
    let result = ""
    let i = digits.len() - 1
    for i >= 0
        let d = digits[i]
        if d < 10
            result = result + (d + 48)
        else
            result = result + (d + 87)
        i = i - 1
    result

let fmt_binary(n) =
    if n == 0
        return "0"
    let val = n
    if n < 0
        val = 0 - n
    let digits = arr_new()
    for val > 0
        digits = arr_push(digits, val % 2)
        val = val / 2
    let result = ""
    let i = digits.len() - 1
    for i >= 0
        if digits[i] == 0
            result = result + "0"
        else
            result = result + "1"
        i = i - 1
    result

let fmt_octal(n) =
    if n == 0
        return "0"
    let val = n
    if n < 0
        val = 0 - n
    let digits = arr_new()
    for val > 0
        digits = arr_push(digits, val % 8)
        val = val / 8
    let result = ""
    let i = digits.len() - 1
    for i >= 0
        result = result + (digits[i] + 48)
        i = i - 1
    result

let fmt_float(f) =
    let int_part = f / 65536
    let frac_part = f % 65536
    if frac_part < 0
        frac_part = 0 - frac_part
    let result = fmt_int(int_part)
    result = result + "."
    let frac_digits = (frac_part * 10000) / 65536
    if frac_digits == 0
        result = result + "0000"
    else
        let temp = frac_digits
        let ndigits = 0
        for temp > 0
            ndigits = ndigits + 1
            temp = temp / 10
        let zeros = 4 - ndigits
        let z = 0
        for z < zeros
            result = result + "0"
            z = z + 1
        result = result + fmt_int(frac_digits)
    result

let fmt_pad_left(s, width, pad_char) =
    let result = s
    for result.len() < width
        result = pad_char + result
    result

let fmt_pad_right(s, width, pad_char) =
    let result = s
    for result.len() < width
        result = result + pad_char
    result

let fmt_center(s, width) =
    let n = s.len()
    if n >= width
        return s
    let total = width - n
    let left = total / 2
    let right = total - left
    let result = ""
    let i = 0
    for i < left
        result = result + " "
        i = i + 1
    result = result + s
    i = 0
    for i < right
        result = result + " "
        i = i + 1
    result

let fmt_truncate(s, max_len) =
    let n = s.len()
    if n <= max_len
        return s
    let result = ""
    let i = 0
    for i < max_len - 3
        result = result + s[i]
        i = i + 1
    result + "..."

let fmt_int_commas(n) =
    if n == 0
        return "0"
    let neg = 0
    let val = n
    if n < 0
        neg = 1
        val = 0 - n
    let digits = arr_new()
    for val > 0
        digits = arr_push(digits, val % 10)
        val = val / 10
    let result = ""
    if neg == 1
        result = "-"
    let n_digits = digits.len()
    let i = n_digits - 1
    let count = 0
    for i >= 0
        result = result + fmt_digit_char(digits[i])
        count = count + 1
        if count % 3 == 0 && i > 0
            result = result + ","
        i = i - 1
    result

let fmt_percent(num, denom, decimals) =
    let pct = (num * 10000) / denom
    let int_part = pct / 100
    let frac_part = pct % 100
    let result = fmt_int(int_part) + "."
    if frac_part < 10
        result = result + "0"
    result = result + fmt_int(frac_part) + "%"
    result

let fmt_bytes(n) =
    if n < 1024
        return fmt_int(n) + " B"
    if n < 1048576
        return fmt_int(n / 1024) + " KB"
    if n < 1073741824
        return fmt_int(n / 1048576) + " MB"
    fmt_int(n / 1073741824) + " GB"

let fmt_table_row(cells, widths) =
    let result = "|"
    let n = cells.len()
    let i = 0
    for i < n
        result = result + " " + fmt_pad_right(cells[i], widths[i], " ") + " |"
        i = i + 1
    result

let fmt_table_sep(widths) =
    let result = "+"
    let n = widths.len()
    let i = 0
    for i < n
        let w = widths[i]
        let j = 0
        for j < w + 2
            result = result + "-"
            j = j + 1
        result = result + "+"
        i = i + 1
    result

let fmt_template(template, keys, values) =
    let result = ""
    let n = template.len()
    let i = 0
    for i < n
        let c = template[i]
        if c == 123 && i + 1 < n
            let j = i + 1
            for j < n && template[j] != 125
                j = j + 1
            if j < n
                let key = ""
                let k = i + 1
                for k < j
                    key = key + template[k]
                    k = k + 1
                let found = 0 - 1
                let m = keys.len()
                let idx = 0
                for idx < m
                    if keys[idx] == key
                        found = idx
                    idx = idx + 1
                if found >= 0
                    result = result + values[found]
                i = j + 1
            else
                result = result + c
                i = i + 1
        else
            result = result + c
            i = i + 1
    result

let fmt_bar_chart(labels, values, max_width) =
    let n = labels.len()
    let max_val = 0
    let i = 0
    for i < n
        if values[i] > max_val
            max_val = values[i]
        i = i + 1
    let result = ""
    i = 0
    for i < n
        let bar_len = (values[i] * max_width) / max_val
        let bar = ""
        let j = 0
        for j < bar_len
            bar = bar + "#"
            j = j + 1
        result = result + fmt_pad_right(labels[i], 10, " ") + " |" + bar + "\n"
        i = i + 1
    result

let main() =
    print(fmt_int(42))
    print(fmt_int(0 - 123))
    print(fmt_hex(255))
    print(fmt_binary(10))
    print(fmt_int_commas(1234567))
    print(fmt_bytes(1048576))
    print(fmt_percent(3, 4, 2))
    0
