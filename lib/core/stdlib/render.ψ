let render_demo() =
    let blue = gfx_pack_rgb(30, 60, 120)
    let red = gfx_pack_rgb(120, 50, 50)
    let white = gfx_pack_rgb(127, 127, 127)
    let green = gfx_pack_rgb(50, 220, 80)
    let s0 = render_create()
    let s1 = render_clear(s0, blue)
    let s2 = render_rect(s1, 1, 1, 3, 3, red)
    let s3 = render_line(s2, 0, 0, 7, 7, white)
    let s4 = render_line(s3, 7, 0, 0, 7, white)
    let s5 = render_point(s4, 4, 4, green)
    let s6 = render_frame_end(s5)
    let rt = render_roundtrip(s6)
    let fb = render_execute(s6, 8, 8)
    let sum = render_summary(s6)
    [render_count(s6), sum[0], rt[0], rt[1], len(fb)]

let render_demo_poles() =
    let poles0 = render_pole_set_create()
    let poles1 = render_pole_set_add(poles0, 1, 1, 1)
    let poles2 = render_pole_set_add(poles1, 6, 1, 1)
    let poles3 = render_pole_set_add(poles2, 3, 6, 1)
    let w_in = render_winding(poles3, 3, 3)
    let w_out = render_winding(poles3, 0, 0)
    let yellow = gfx_pack_rgb(127, 220, 50)
    let s0 = render_create()
    let s1 = render_clear(s0, gfx_pack_rgb(0, 0, 0))
    let s2 = render_contour(s1, yellow)
    let s3 = render_frame_end(s2)
    let fb = render_execute_with_poles(s3, 8, 8, poles3, yellow)
    let pole_count = render_pole_set_count(poles3)
    let stream_count = render_count(s3)
    let yellow_count = 0
    let i = 0
    for i < len(fb)
      if fb[i] == yellow
        yellow_count = yellow_count + 1
      else
        0
      i = i + 1
    [pole_count, stream_count, w_in, w_out, yellow_count]

