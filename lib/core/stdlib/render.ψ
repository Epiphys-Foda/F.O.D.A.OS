import "gfx.ψ"
import "psibinary.ψ"
let R_POINT       = 200
let R_RECT        = 201
let R_LINE        = 202
let R_GRADIENT_V  = 203
let R_GRADIENT_H  = 204
let R_CLEAR       = 205
let R_POLE        = 206
let R_CONTOUR     = 207
let R_CLIP        = 208
let R_FRAME_END   = 209

let render_create() = []

let render_insert(stream, op_id, args) = stream.push([op_id, args])

let render_count(stream) = len(stream)

let render_is_empty(stream) = len(stream) == 0

let render_query_by_op(stream, target_op_id) =
    let result = []
    for node in stream
      if node[0] == target_op_id
        result = result.push(node)
      else
        0
    result

let render_point(stream, x, y, color) = stream.push([R_POINT, [x, y, color]])

let render_rect(stream, x, y, w, h, color) = stream.push([R_RECT, [x, y, w, h, color]])

let render_line(stream, x0, y0, x1, y1, color) = stream.push([R_LINE, [x0, y0, x1, y1, color]])

let render_gradient_v(stream, top_color, bot_color) = stream.push([R_GRADIENT_V, [top_color, bot_color]])

let render_gradient_h(stream, left_color, right_color) = stream.push([R_GRADIENT_H, [left_color, right_color]])

let render_clear(stream, color) = stream.push([R_CLEAR, [color]])

let render_pole(stream, px, py, residue) = stream.push([R_POLE, [px, py, residue]])

let render_contour(stream, color) = stream.push([R_CONTOUR, [color]])

let render_clip(stream, x, y, w, h) = stream.push([R_CLIP, [x, y, w, h]])

let render_frame_end(stream) = stream.push([R_FRAME_END, []])

let render_pole_set_create() = []

let render_pole_set_add(poles, px, py, residue) = poles.push([px, py, residue])

let render_pole_set_count(poles) = len(poles)

let render_pole_set_from_stream(stream) =
    let poles = []
    for node in stream
      if node[0] == R_POLE
        let a = node[1]
        poles = poles.push([a[0], a[1], a[2]])
      else
        0
    poles

let render_winding(poles, px, py) =
    let inside = 0
    let n = len(poles)
    let i = 0
    let j = n - 1
    for i < n
      let pi = poles[i]
      let pj = poles[j]
      let xi = pi[0]
      let yi = pi[1]
      let xj = pj[0]
      let yj = pj[1]
      let cond_y = ((yi > py) != (yj > py))
      if cond_y
        let dy = yj - yi
        let dx = xj - xi
        let x_at_py = dx * (py - yi) / dy + xi
        if px < x_at_py
          inside = 1 - inside
        else
            0
      else
        0
      j = i
      i = i + 1
    inside

let render_coverage(poles, px, py) =
    let w = render_winding(poles, px, py)
    if w == 0
      0
    else
      if w > 0
        255
      else
        0 - 255 * w

let render_distance_to_segment(px, py, x0, y0, x1, y1) =
    let dx = x1 - x0
    let dy = y1 - y0
    let l2 = dx * dx + dy * dy
    if l2 == 0
      let ex = px - x0
      let ey = py - y0
      ex * ex + ey * ey
    else
      let t_num = (px - x0) * dx + (py - y0) * dy
      let cross = (px - x0) * dy - (py - y0) * dx
      if t_num < 0
        let ex = px - x0
        let ey = py - y0
        ex * ex + ey * ey
      else
        if t_num > l2
          let ex = px - x1
          let ey = py - y1
          ex * ex + ey * ey
        else
          (cross * cross) / l2

let render_clip_contains(cx, cy, cw, ch, x, y) =
    (x >= cx) && (x < cx + cw) && (y >= cy) && (y < cy + ch)

let render_set_pixel_clipped(fb, w, cx, cy, cw, ch, x, y, color) =
    if render_clip_contains(cx, cy, cw, ch, x, y)
      gfx_set_pixel(fb, w, x, y, color)
    else
      fb

let render_fill_rect_clipped(fb, w, h, cx, cy, cw, ch, x, y, rw, rh, color) =
    let x0 = x
    let y0 = y
    let x1 = x + rw
    let y1 = y + rh
    if x0 < cx
      x0 = cx
    else
      0
    if y0 < cy
      y0 = cy
    else
      0
    if x1 > cx + cw
      x1 = cx + cw
    else
      0
    if y1 > cy + ch
      y1 = cy + ch
    else
      0
    let fb2 = fb
    let py = y0
    for py < y1
      let px = x0
      for px < x1
        if (px >= 0) && (px < w) && (py >= 0) && (py < h)
          fb2 = gfx_set_pixel(fb2, w, px, py, color)
        else
          0
        px = px + 1
      py = py + 1
    fb2

let render_draw_line_clipped(fb, w, cx, cy, cw, ch, x0, y0, x1, y1, color) =
    let x = x0
    let y = y0
    let dx = x1 - x0
    let dy = y1 - y0
    if dx < 0
      dx = 0 - dx
    else
      0
    if dy < 0
      dy = 0 - dy
    else
      0
    let sx = 1
    if x0 > x1
      sx = 0 - 1
    else
      0
    let sy = 1
    if y0 > y1
      sy = 0 - 1
    else
      0
    let err = dx - dy
    let done = 0
    for done == 0
      fb = render_set_pixel_clipped(fb, w, cx, cy, cw, ch, x, y, color)
      if (x == x1) && (y == y1)
        done = 1
      else
        0
      let e2 = 2 * err
      if e2 > (0 - dy)
        err = err - dy
        x = x + sx
      else
        0
      if e2 < dx
        err = err + dx
        y = y + sy
      else
        0
    fb

let render_gradient_v_clipped(fb, w, h, cx, cy, cw, ch, top_color, bot_color) =
    let tr = top_color / 16777216
    let tg = (top_color / 65536) - (tr * 256)
    let tb = (top_color / 256) - (top_color / 65536) * 256
    let br = bot_color / 16777216
    let bg = (bot_color / 65536) - (br * 256)
    let bb = (bot_color / 256) - (bot_color / 65536) * 256
    let dr = br - tr
    let dg = bg - tg
    let db = bb - tb
    let fb2 = fb
    let y = cy
    for y < cy + ch
      let r = tr + (dr * y / h)
      let g = tg + (dg * y / h)
      let b = tb + (db * y / h)
      let c = gfx_pack_rgb(r, g, b)
      let x = cx
      for x < cx + cw
        if (x < w) && (y < h)
          fb2 = gfx_set_pixel(fb2, w, x, y, c)
        else
          0
        x = x + 1
      y = y + 1
    fb2

let render_gradient_h_clipped(fb, w, h, cx, cy, cw, ch, left_color, right_color) =
    let lr = left_color / 16777216
    let lg = (left_color / 65536) - (lr * 256)
    let lb = (left_color / 256) - (left_color / 65536) * 256
    let rr = right_color / 16777216
    let rg = (right_color / 65536) - (rr * 256)
    let rb = (right_color / 256) - (right_color / 65536) * 256
    let dr = rr - lr
    let dg = rg - lg
    let db = rb - lb
    let fb2 = fb
    let x = cx
    for x < cx + cw
      let r = lr + (dr * x / w)
      let g = lg + (dg * x / w)
      let b = lb + (db * x / w)
      let c = gfx_pack_rgb(r, g, b)
      let y = cy
      for y < cy + ch
        if (x < w) && (y < h)
          fb2 = gfx_set_pixel(fb2, w, x, y, c)
        else
          0
        y = y + 1
      x = x + 1
    fb2

let render_execute(stream, w, h) =
    let fb = gfx_create(w, h)
    let i = 0
    let n = len(stream)
    let done = false
    let cx = 0
    let cy = 0
    let cw = w
    let ch = h
    for done == false
      if i < n
        let node = stream[i]
        let op = node[0]
        let a = node[1]
        if op == R_CLEAR
          fb = gfx_fill_rect(fb, w, h, 0, 0, w, h, a[0])
        else
          0
        if op == R_GRADIENT_V
          fb = render_gradient_v_clipped(fb, w, h, cx, cy, cw, ch, a[0], a[1])
        else
          0
        if op == R_GRADIENT_H
          fb = render_gradient_h_clipped(fb, w, h, cx, cy, cw, ch, a[0], a[1])
        else
          0
        if op == R_POINT
          fb = render_set_pixel_clipped(fb, w, cx, cy, cw, ch, a[0], a[1], a[2])
        else
          0
        if op == R_RECT
          fb = render_fill_rect_clipped(fb, w, h, cx, cy, cw, ch, a[0], a[1], a[2], a[3], a[4])
        else
          0
        if op == R_LINE
          fb = render_draw_line_clipped(fb, w, cx, cy, cw, ch, a[0], a[1], a[2], a[3], a[4])
        else
          0
        if op == R_CLIP
          cx = a[0]
          cy = a[1]
          cw = a[2]
          ch = a[3]
        else
          0
        i = i + 1
      else
        done = true
    fb

let render_fill_polygon(fb, w, h, poles, color) =
    let fb2 = fb
    let y = 0
    for y < h
      let x = 0
      for x < w
        let w_num = render_winding(poles, x, y)
        if w_num != 0
          fb2 = gfx_set_pixel(fb2, w, x, y, color)
        else
          0
        x = x + 1
      y = y + 1
    fb2

let render_execute_with_poles(stream, w, h, poles, contour_color) =
    let fb = gfx_create(w, h)
    let i = 0
    let n = len(stream)
    let done = false
    let cx = 0
    let cy = 0
    let cw = w
    let ch = h
    for done == false
      if i < n
        let node = stream[i]
        let op = node[0]
        let a = node[1]
        if op == R_CLEAR
          fb = gfx_fill_rect(fb, w, h, 0, 0, w, h, a[0])
        else
          0
        if op == R_GRADIENT_V
          fb = render_gradient_v_clipped(fb, w, h, cx, cy, cw, ch, a[0], a[1])
        else
          0
        if op == R_GRADIENT_H
          fb = render_gradient_h_clipped(fb, w, h, cx, cy, cw, ch, a[0], a[1])
        else
          0
        if op == R_POINT
          fb = render_set_pixel_clipped(fb, w, cx, cy, cw, ch, a[0], a[1], a[2])
        else
          0
        if op == R_RECT
          fb = render_fill_rect_clipped(fb, w, h, cx, cy, cw, ch, a[0], a[1], a[2], a[3], a[4])
        else
          0
        if op == R_LINE
          fb = render_draw_line_clipped(fb, w, cx, cy, cw, ch, a[0], a[1], a[2], a[3], a[4])
        else
          0
        if op == R_CONTOUR
          fb = render_fill_polygon(fb, w, h, poles, a[0])
        else
          0
        if op == R_CLIP
          cx = a[0]
          cy = a[1]
          cw = a[2]
          ch = a[3]
        else
          0
        i = i + 1
      else
        done = true
    fb

let render_demo_clip() =
    let s0 = render_create()
    let s1 = render_clear(s0, gfx_pack_rgb(0, 0, 127))
    let s2 = render_clip(s1, 0, 0, 4, 8)
    let s3 = render_rect(s2, 0, 0, 8, 8, gfx_pack_rgb(127, 0, 0))
    let fb = render_execute(s3, 8, 8)
    let ok1 = gfx_get_pixel(fb, 8, 0, 0) == gfx_pack_rgb(127, 0, 0)
    let ok2 = gfx_get_pixel(fb, 8, 7, 0) == gfx_pack_rgb(0, 0, 127)
    [fb, ok1 && ok2]

let render_demo_gradient_h() =
    let s0 = render_create()
    let s1 = render_gradient_h(s0, gfx_pack_rgb(127, 0, 0), gfx_pack_rgb(0, 0, 127))
    let fb = render_execute(s1, 8, 8)
    let cl = gfx_get_pixel(fb, 8, 0, 0)
    let cr = gfx_get_pixel(fb, 8, 7, 0)
    let rl = cl / 16777216
    let bl = (cl / 256) - (cl / 65536) * 256
    let rr = cr / 16777216
    let br = (cr / 256) - (cr / 65536) * 256
    [fb, (rl > rr) && (bl < br)]

let render_serialize(stream) =
    let nodes = []
    let i = 0
    for i < len(stream)
      nodes = nodes.push({ op_id: stream[i][0], args: stream[i][1] })
      i = i + 1
    psibin_serialize(nodes)

let render_deserialize(buf) =
    let r = psibin_deserialize(buf)
    let ns = r.nodes
    let out = []
    let i = 0
    for i < len(ns)
      out = out.push([ns[i].op_id, ns[i].args])
      i = i + 1
    out

let render_roundtrip(stream) =
    let buf = render_serialize(stream)
    let nodes = render_deserialize(buf)
    let a = []
    let b = []
    let i = 0
    for i < len(stream)
      a = a.push({ op_id: stream[i][0], args: stream[i][1] })
      b = b.push({ op_id: nodes[i][0], args: nodes[i][1] })
      i = i + 1
    let ok = psibin_nodes_equal(a, b)
    [ok, len(buf), len(nodes)]

let render_store_bytes(stream) = render_serialize(stream).len()

let render_summary(stream) =
    let point_c = 0
    let rect_c = 0
    let line_c = 0
    let grad_v_c = 0
    let grad_h_c = 0
    let clear_c = 0
    let pole_c = 0
    let contour_c = 0
    let clip_c = 0
    let frame_end_c = 0
    for node in stream
      let op = node[0]
      if op == R_POINT
        point_c = point_c + 1
      else
        0
      if op == R_RECT
        rect_c = rect_c + 1
      else
        0
      if op == R_LINE
        line_c = line_c + 1
      else
        0
      if op == R_GRADIENT_V
        grad_v_c = grad_v_c + 1
      else
        0
      if op == R_GRADIENT_H
        grad_h_c = grad_h_c + 1
      else
        0
      if op == R_CLEAR
        clear_c = clear_c + 1
      else
        0
      if op == R_POLE
        pole_c = pole_c + 1
      else
        0
      if op == R_CONTOUR
        contour_c = contour_c + 1
      else
        0
      if op == R_CLIP
        clip_c = clip_c + 1
      else
        0
      if op == R_FRAME_END
        frame_end_c = frame_end_c + 1
      else
        0
    [len(stream), point_c, rect_c, line_c, grad_v_c, grad_h_c, clear_c, pole_c, contour_c, clip_c, frame_end_c]

