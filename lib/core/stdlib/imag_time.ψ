let it_relax(x, num, den) = x * num / den

let it_evolve_impl(x, num, den, n) =
    if n > 0
      it_evolve_impl(it_relax(x, num, den), num, den, n - 1)
    else
        x

let it_evolve(x, num, den, n) = it_evolve_impl(x, num, den, n)

let it_monotone_impl(x, num, den, n) =
    if n > 0
      let nx = it_relax(x, num, den)
      if nx < x
        it_monotone_impl(nx, num, den, n - 1)
      else
          false
    else
        true

let it_monotone(x, num, den, n) = it_monotone_impl(x, num, den, n)

let it_converges(x, num, den) = it_evolve(x, num, den, 20) == 0

let it_wick_dual() = it_monotone(1000, 1, 2, 8)

let it_pow(scale, i, order) =
    if order == 0
        scale
    else
        0
    if order == 1
        scale / i
    else
        scale / (i * i)

let it_mem_impl(seq, order, scale, idx, acc) =
    if idx < len(seq)
      let w = it_pow(scale, idx + 1, order)
      let acc2 = acc + seq[idx] * w
      it_mem_impl(seq, order, scale, idx + 1, acc2)
    else
        acc

let it_mem(seq, order, scale) = it_mem_impl(seq, order, scale, 0, 0)

let it_mem_uniform() = it_mem([1, 2, 3], 0, 10) == 60

let it_mem_harmonic() = it_mem([1, 2, 3], 1, 10) == 29

let it_mem_near() = it_mem([1, 2, 3], 2, 10) == 17

let it_long_memory() = it_mem([100, 0, 0, 0, 0], 1, 10) > 0

let it_autocorr_impl(seq, lag, idx, acc) =
    if idx < len(seq) - lag
      let acc2 = acc + seq[idx] * seq[idx + lag]
      it_autocorr_impl(seq, lag, idx + 1, acc2)
    else
        acc

let it_autocorr(seq, lag) = it_autocorr_impl(seq, lag, 0, 0)

let it_rigid(seq, period) = it_autocorr(seq, period) >= it_autocorr(seq, period - 1) && it_autocorr(seq, period) >= it_autocorr(seq, period + 1)

let it_rigid_ok() = it_rigid([1, 2, 1, 2, 1, 2], 2)

let it_autocorr_peak() = it_autocorr([3, 1, 3, 1, 3, 1], 2) > it_autocorr([3, 1, 3, 1, 3, 1], 1)

