let coroutine_new(fn_, initial_state) =
    [fn_, initial_state, 0, 0]

let coroutine_resume(coro, input) =
    if coro[2] == 1
        [1, 0]
    else
        let fn_ = coro[0]
        let state = coro[1]
        let result = fn_(state, input)
        coro[1] = result[0]
        coro[2] = result[1]
        coro[3] = result[2]
        [coro[2], coro[3]]

let coroutine_done(coro) =
    coro[2]

let coroutine_value(coro) =
    coro[3]

let generator_range(start, end, step) =
    let state = [start, end, step]
    let fn_(s, input) =
        let current = s[0]
        let end_val = s[1]
        let step_val = s[2]
        if current >= end_val
            [s, 1, 0]
        else
            let new_state = [current + step_val, end_val, step_val]
            [new_state, 0, current]
    coroutine_new(fn_, state)

let generator_map(gen_fn, transform) =
    let fn_(s, input) =
        let inner = s[0]
        let result = coroutine_resume(inner, input)
        if result[0] == 1
            [s, 1, 0]
        else
            let transformed = transform(result[1])
            [[inner], 0, transformed]
    coroutine_new(fn_, [gen_fn])

let generator_filter(gen_fn, predicate) =
    let fn_(s, input) =
        let inner = s[0]
        let done = 0
        let value = 0
        for done == 0
            let result = coroutine_resume(inner, input)
            if result[0] == 1
                done = 1
                value = 0
            else
                0
            if predicate(result[1]) != 0
                done = 1
                value = result[1]
        [[inner], done, value]
    coroutine_new(fn_, [gen_fn])

let generator_take(gen_fn, n) =
    let state = [gen_fn, n]
    let fn_(s, input) =
        let inner = s[0]
        let remaining = s[1]
        if remaining <= 0
            [s, 1, 0]
        else
            let result = coroutine_resume(inner, input)
            if result[0] == 1
                [s, 1, 0]
            else
                [[inner, remaining - 1], 0, result[1]]
    coroutine_new(fn_, state)

let generator_collect(gen_fn, max_items) =
    let result = []
    let coro = gen_fn
    let count = 0
    let done = 0
    for done == 0 && count < max_items
        let r = coroutine_resume(coro, 0)
        if r[0] == 1
            done = 1
        else
            result = arr_concat(result, [r[1]])
            count = count + 1
    result

let generator_sum(gen_fn, max_items) =
    let total = 0
    let coro = gen_fn
    let count = 0
    let done = 0
    for done == 0 && count < max_items
        let r = coroutine_resume(coro, 0)
        if r[0] == 1
            done = 1
        else
            total = total + r[1]
            count = count + 1
    total

let pipeline_apply(transform_id, current) =
    current
let pipeline(source, transform_ids) =
    let current = source
    let i = 0
    for i < transform_ids.len()
        current = pipeline_apply(transform_ids[i], current)
        i = i + 1
    current

