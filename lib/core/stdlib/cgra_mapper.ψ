import "qqbc.ψ"
let CGRA_DEFAULT_FIFO_DEPTH = 4

let cgra_create() =
    { pe_array: [], interconnect: [], pe_count: 0, fifo_count: 0, grid_w: 0, grid_h: 0 }

let cgra_pe_role(opcode) =
    if opcode == 16
        "source"
    else
      if opcode == 17
          "sink"
      else
        "compute"

let dag_to_cgra(dag) =
    let pe_array = []
    let interconnect = []
    let fifo_count = 0

    let i = 0
    let n_done = false
    for !n_done
      if i < dag.node_count
        let node = dag.nodes[i]
        let pe =
          { pe_id: node.node_id, pe_type: node.pe_type, opcode: node.opcode, in_fifos: [], out_fifos: [], role: cgra_pe_role(node.opcode) }
        pe_array = pe_array.push(pe)
        i = i + 1
      else
        n_done = true
        0
      0

    let j = 0
    let e_done = false
    for !e_done
      if j < dag.edge_count
        let e = dag.edges[j]
        let fifo =
          { fifo_id: j, src_pe: e.src_node, src_port: e.src_port, dst_pe: e.dst_node, dst_port: e.dst_port, depth: CGRA_DEFAULT_FIFO_DEPTH }
        interconnect = interconnect.push(fifo)
        fifo_count = fifo_count + 1
        let pe_arr2 = pe_array
        let src_pe = pe_arr2[e.src_node]
        let new_out = src_pe.out_fifos
        new_out = new_out.push(j)
        let src_pe2 =
          { pe_id: src_pe.pe_id, pe_type: src_pe.pe_type, opcode: src_pe.opcode, in_fifos: src_pe.in_fifos, out_fifos: new_out, role: src_pe.role }
        pe_arr2 = arr_set(pe_arr2, e.src_node, src_pe2)
        let pe_arr3 = pe_arr2
        let dst_pe = pe_arr3[e.dst_node]
        let new_in = dst_pe.in_fifos
        new_in = new_in.push(j)
        let dst_pe2 =
          { pe_id: dst_pe.pe_id, pe_type: dst_pe.pe_type, opcode: dst_pe.opcode, in_fifos: new_in, out_fifos: dst_pe.out_fifos, role: dst_pe.role }
        pe_arr3 = arr_set(pe_arr3, e.dst_node, dst_pe2)
        pe_array = pe_arr3
        j = j + 1
      else
        e_done = true
        0
      0

    let gw = dag.node_count
    let gh = 1

      { pe_array: pe_array, interconnect: interconnect, pe_count: dag.node_count, fifo_count: fifo_count, grid_w: gw, grid_h: gh }

let cgra_pe_count(config) = config.pe_count

let cgra_fifo_count(config) = config.fifo_count

let cgra_get_pe(config, pe_id) =
    if pe_id < 0
      null
    else
      if pe_id < config.pe_count
        config.pe_array[pe_id]
      else
        null

let cgra_grid_size(config) = [config.grid_w, config.grid_h]

let cgra_pe_type_dist(config) =
    let dist = [0, 0, 0, 0, 0, 0, 0]
    let i = 0
    let done = false
    for !done
      if i < config.pe_count
        let pe = config.pe_array[i]
        let idx = (pe.pe_type <= 5 ? pe.pe_type - 1 : (pe.pe_type == 16 ? 5 : 6))
        let old = dist[idx]
        dist = arr_set(dist, idx, old + 1)
        i = i + 1
      else
        done = true
    dist

let CGRA_MAGIC = [67, 71, 82, 65]
let CGRA_VERSION = 1

let cgra_serialize(config) =
    let out = CGRA_MAGIC
    out = out.push(CGRA_VERSION)
    let pc = config.pe_count
    out = out.push(pc - (pc / 256) * 256)
    out = out.push(pc / 256)
    let fc = config.fifo_count
    out = out.push(fc - (fc / 256) * 256)
    out = out.push(fc / 256)
    out = out.push(config.grid_w + config.grid_h * 16)
    let i = 0
    let p_done = false
    for !p_done
      if i < config.pe_count
        let pe = config.pe_array[i]
        let role_byte = (pe.role == "source" ? 0 : (pe.role == "compute" ? 1 : 2))
        out = out.push(pe.pe_id)
        out = out.push(pe.pe_type)
        out = out.push(pe.opcode)
        out = out.push(role_byte)
        i = i + 1
      else
        p_done = true
        0
      0
    let j = 0
    let f_done = false
    for !f_done
      if j < config.fifo_count
        let f = config.interconnect[j]
        out = out.push(f.fifo_id)
        out = out.push(f.src_pe)
        out = out.push(f.src_port)
        out = out.push(f.dst_pe)
        out = out.push(f.dst_port)
        out = out.push(f.depth)
        j = j + 1
      else
        f_done = true
    out

let cgra_summary(config) =
    let dist = cgra_pe_type_dist(config)
      { pe_count: config.pe_count, fifo_count: config.fifo_count, grid_w: config.grid_w, grid_h: config.grid_h, pe_gfmul: dist[0], pe_clifford: dist[1], pe_ntt: dist[2], pe_born: dist[3], pe_hebbian: dist[4], pe_token: dist[5], pe_emit: dist[6] }

