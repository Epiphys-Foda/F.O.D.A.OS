let cgra_simulate(config, qqbc) =
    let token_values = []
    let pc = 0
    let t_done = false
    for !t_done
      if pc < len(qqbc)
        let op = qqbc[pc]
        pc = pc + 1
        if op == 16
          let v = qqbc[pc]
          pc = pc + 1
          token_values = token_values.push(v)
        else
            0
      else
        t_done = true
        0
      0

    let pe_outputs = []
    let k = 0
    let init_done = false
    for !init_done
      if k < config.pe_count
        pe_outputs = pe_outputs.push(0)
        k = k + 1
      else
        init_done = true
        0
      0

    let token_idx = 0
    let i = 0
    let p_done = false
    let result = 0
    for !p_done
      if i < config.pe_count
        let pe = config.pe_array[i]
        if pe.role == "source"
          if token_idx < len(token_values)
            let v = token_values[token_idx]
            pe_outputs = arr_set(pe_outputs, pe.pe_id, v)
            token_idx = token_idx + 1
          else
              0
        else
          0
        if pe.role == "compute"
          let args = []
          let j = 0
          let a_done = false
          for !a_done
            if j < pe.len(in_fifos)
              let fifo_id = pe.in_fifos[j]
              let fifo = config.interconnect[fifo_id]
              let src_val = pe_outputs[fifo.src_pe]
              args = args.push(src_val)
              j = j + 1
            else
              a_done = true
              0
            0
          let res = qq_eval(pe.opcode, args)
          pe_outputs = arr_set(pe_outputs, pe.pe_id, res)
        else
          0
        if pe.role == "sink"
          if pe.len(in_fifos) >= 1
            let fifo_id = pe.in_fifos[0]
            let fifo = config.interconnect[fifo_id]
            result = pe_outputs[fifo.src_pe]
          else
              0
        else
          0
        i = i + 1
      else
        p_done = true
    result
