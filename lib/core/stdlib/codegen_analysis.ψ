let wasm_verify_magic(bytes) = ((bytes == wasm_magic()) ? (1) : (0))

let wasm_verify_version(bytes) = ((bytes == wasm_version()) ? (1) : (0))

let wasm_verify_section(section_id, size, content) =
    if section_id < 1 || section_id > 12
        0
    if size != arr_len(content)
        0
    1

let wasm_verify_function_signature(sig) =
    let n = arr_len(sig)
    if n < 2
        0
    let param_count = arr_get(sig, 0)
    let result_count = arr_get(sig, 1)
    if param_count + 2 != n
        0
    1

let wasm_stack_balance_check(ops) =
    let n = arr_len(ops)
    _wasm_sb_acc(ops, n, 0, 0)
let _wasm_sb_acc(ops, n, i, depth) =
    if i >= n
        ((depth == 0) ? (1) : (0))
    if depth < 0
        0
    let op = arr_get(ops, i)
    let new_depth = depth + 1
    _wasm_sb_acc(ops, n, i + 1, new_depth)

let wasm_size_analyze(wasm_bytes) =
    let v = arr_new_n(12)
    _wasm_size_acc(wasm_bytes, v, 0, arr_len(wasm_bytes))
    v
let _wasm_size_acc(bytes, v, i, n) =
    if i >= n
        v
    let section_id = arr_get(bytes, i)
    if section_id >= 1 && section_id <= 12
      let cur = arr_get(v, section_id - 1)
      arr_set(v, section_id - 1, cur + 1)
    _wasm_size_acc(bytes, v, i + 1, n)

let compile_time_model(source_size, pass_count, opt_level) =
    let a = 1
    let b = 100
    let c = 1
    let lex_parse = gf_mul(a, source_size)
    let pass_overhead = gf_mul(b, pass_count)
    let opt_time = gf_mul(gf_mul(gf_mul(c, source_size), pass_count), opt_level)
    gf_add(gf_add(lex_parse, pass_overhead), opt_time)

let compile_time_predict(source_size, pass_count) =
    let ops = compile_time_model(source_size, pass_count, 1)
    ops / 1000000

let compile_time_complexity_class(n) =
    if n <= 100
        0
    if n <= 1000
        2
    if n <= 10000
        2
    2

let compile_time_upper_bound(source_size, pass_count) =
    gf_mul(gf_mul(source_size, pass_count), 65537)
