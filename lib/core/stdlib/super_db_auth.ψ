let rf_dba_role(role) = role

let rf_dba_can(role, op) =
    let allowed = 0
    if role == 2
      allowed = 1
    else
      if role == 1
        if op == 0 || op == 1 || op == 2 || op == 3
          allowed = 1
        else
            0
      else
        if op == 0 || op == 2
          allowed = 1
        else
          0
    allowed

let rf_dba_guard(role, op) =
    let allowed = rf_dba_can(role, op)
    [allowed, op]

let rf_dba_audit(role, op) =
    let a = rf_dba_can(role, op)
    let code = (a == 1 ? 1 : 0)
    [role, op, code]

let rf_dba_demo() =
    let anon_read = rf_dba_can(0, 0)
    let anon_write = rf_dba_can(0, 1)
    let admin_write = rf_dba_can(2, 1)
    [anon_read, anon_write, admin_write]

let rf_dba_test() =
    let t1 = rf_dba_role(1) == 1
    let t2 = rf_dba_can(0, 0) == 1 && rf_dba_can(0, 1) == 0
    let t3 = rf_dba_can(1, 1) == 1 && rf_dba_can(1, 4) == 0
    let t4 = rf_dba_can(2, 5) == 1
    let g1 = rf_dba_guard(0, 1)
    let t5 = g1[0] == 0
    let a1 = rf_dba_audit(0, 1)
    let t6 = a1[0] == 0 && a1[1] == 1 && a1[2] == 0
    let demo = rf_dba_demo()
    let t7 = demo[0] == 1 && demo[1] == 0 && demo[2] == 1
    t1 && t2 && t3 && t4 && t5 && t6 && t7
