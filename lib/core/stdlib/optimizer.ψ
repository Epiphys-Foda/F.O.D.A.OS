let opt_dead_code(table) =
    let used = arr_new_n(256)
    let i = 0
    for i < table.len()
        let entry = table[i]
        if entry[0] == 3
            let idx = entry[1]
            if idx < 256
                used[idx] = 1
        if entry[0] == 18
            let idx = entry[1]
            if idx < 256
                used[idx] = 1
        i = i + 1
    let result = arr_new()
    let i = 0
    for i < table.len()
        let entry = table[i]
        if entry[0] == 12 || entry[0] == 13
            let idx = entry[1]
            if idx < 256 && used[idx] == 1
                result = arr_push(result, entry)
            else
                0
            result = arr_push(result, entry)
        i = i + 1
    result

let opt_const_fold(table) =
    let result = arr_new()
    let i = 0
    for i < table.len()
        if i + 2 < table.len()
            let e0 = table[i]
            let e1 = table[i + 1]
            let e2 = table[i + 2]
            if e0[0] == 0 && e1[0] == 0 && e2[0] == 5
                let a = e0[1]
                let b = e1[1]
                let op = e2[1]
                let folded = 0
                let did_fold = 0
                if op == 43
                    folded = a + b
                    did_fold = 1
                else
                    0
                if op == 45
                    folded = a - b
                    did_fold = 1
                else
                    0
                if op == 42
                    folded = a * b
                    did_fold = 1
                else
                    0
                if op == 47
                    if b != 0
                        folded = a / b
                        did_fold = 1
                    else
                        0
                if op == 37
                    if b != 0
                        folded = a % b
                        did_fold = 1
                    else
                        0
                if op == 13
                    (a == b ? (folded = 1) : (folded = 0))
                    did_fold = 1
                else
                        0
                if op == 14
                    (a != b ? (folded = 1) : (folded = 0))
                    did_fold = 1
                else
                        0
                if op == 60
                    (a < b ? (folded = 1) : (folded = 0))
                    did_fold = 1
                else
                        0
                if op == 62
                    (a > b ? (folded = 1) : (folded = 0))
                    did_fold = 1
                if did_fold == 1
                    let folded_entry = arr_new_n(3)
                    folded_entry[0] = 0
                    folded_entry[1] = folded
                    folded_entry[2] = 0
                    result = arr_push(result, folded_entry)
                    i = i + 3
                else
                    result = arr_push(result, e0)
                    i = i + 1
            else
                result = arr_push(result, table[i])
                i = i + 1
    result

let opt_cse(table) =
    let result = arr_new()
    let i = 0
    for i < table.len()
        if i + 3 < table.len()
            let e0 = table[i]
            let e1 = table[i + 1]
            let e2 = table[i + 2]
            let e3 = table[i + 3]
            if e0[0] == 0 && e1[0] == 0 && e2[0] == 5 && e3[0] == 0
                if i + 6 < table.len()
                    let e4 = table[i + 4]
                    let e5 = table[i + 5]
                    let e6 = table[i + 6]
                    if e4[0] == 0 && e4[1] == e0[1] && e5[0] == 0 && e5[1] == e1[1] && e6[0] == 5 && e6[1] == e2[1]
                        result = arr_push(result, e0)
                        result = arr_push(result, e1)
                        result = arr_push(result, e2)
                        i = i + 7
                    else
                        result = arr_push(result, e0)
                        i = i + 1
                else
                    result = arr_push(result, e0)
                    i = i + 1
            else
                result = arr_push(result, e0)
                i = i + 1
        else
            result = arr_push(result, table[i])
            i = i + 1
    result

let opt_strength_reduction(table) =
    let result = arr_new()
    let i = 0
    for i < table.len()
        if i + 1 < table.len()
            let e0 = table[i]
            let e1 = table[i + 1]
            if e0[0] == 0 && e0[1] == 2 && e1[0] == 5 && e1[1] == 42
                let shift_entry = arr_new_n(3)
                shift_entry[0] = 5
                shift_entry[1] = 17
                shift_entry[2] = 0
                let push_one = arr_new_n(3)
                push_one[0] = 0
                push_one[1] = 1
                push_one[2] = 0
                result = arr_push(result, push_one)
                result = arr_push(result, shift_entry)
                i = i + 2
            else
                0
            if e0[0] == 0 && e0[1] == 2 && e1[0] == 5 && e1[1] == 47
                let shift_entry = arr_new_n(3)
                shift_entry[0] = 5
                shift_entry[1] = 18
                shift_entry[2] = 0
                let push_one = arr_new_n(3)
                push_one[0] = 0
                push_one[1] = 1
                push_one[2] = 0
                result = arr_push(result, push_one)
                result = arr_push(result, shift_entry)
                i = i + 2
            else
                result = arr_push(result, e0)
                i = i + 1
        else
            result = arr_push(result, table[i])
            i = i + 1
    result

let opt_run_all(table) =
    let t1 = opt_dead_code(table)
    let t2 = opt_const_fold(t1)
    let t3 = opt_strength_reduction(t2)
    let t4 = opt_cse(t3)
    let t5 = opt_loop_unroll(t4, 4)
    t5

