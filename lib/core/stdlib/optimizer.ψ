let opt_loop_unroll(table, max_unroll) =
    let result = arr_new()
    let i = 0
    for i < table.len()
        let entry = table[i]
        if i + 2 < table.len()
            let e0 = table[i]
            let e1 = table[i + 1]
            let e2 = table[i + 2]
            if e0[0] == 0 && e1[0] == 0 && e2[0] == 9
                let lo = e0[1]
                let hi = e1[1]
                let count = hi - lo
                if count >= 0 && count <= max_unroll
                    let body_start = i + 3
                    let body_end = body_start
                    for body_end < table.len() && table[body_end][0] != 17
                        body_end = body_end + 1
                    let u = 0
                    for u < count
                        let j = body_start
                        for j < body_end
                            result = arr_push(result, table[j])
                            j = j + 1
                        u = u + 1
                    i = body_end
                else
                    result = arr_push(result, entry)
                    i = i + 1
            else
                result = arr_push(result, entry)
                i = i + 1
        else
            result = arr_push(result, entry)
            i = i + 1
    result

