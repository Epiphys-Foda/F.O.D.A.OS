let uleb128(value) =
    let result = []
    let v = value
    let done = false
    for !done
      let v2 = v / 128
      let byte = v - v2 * 128
      if v2 == 0
        result = result.push(byte)
        done = true
      else
        result = result.push(byte + 128)
        v = v2
    result

let sleb128(value) =
    let result = []
    let v = value
    let done = false
    for !done
      let v2 = v / 128
      let byte = v - v2 * 128
      let sign_bit = byte
      let stop_positive = (v2 == 0) && (sign_bit < 64)
      let stop_negative = (v2 == -1) && (sign_bit >= 64)
      if stop_positive || stop_negative
        result = result.push(sign_bit)
        done = true
      else
        result = result.push(sign_bit + 128)
        v = v2
    result

let wasm_section(id, payload) = [[id], uleb128(len(payload)), payload].flat()

let wasm_type_section() =
    let sig = [96, 2, 127, 127, 1, 127]
    let payload = [[1], sig].flat()
    wasm_section(1, payload)

let wasm_function_section() =
    let payload = [1, 0]
    wasm_section(3, payload)

let wasm_export_section(name) =
    let name_bytes = str_bytes(name)
    let name_len = uleb128(len(name_bytes))
    let one_export = [name_len, name_bytes, [0, 0]].flat()
    let payload = [[1], one_export].flat()
    wasm_section(7, payload)

let arc_gf_mul_wasm() = [
      WASM_LOCAL_GET, 0,
      WASM_LOCAL_GET, 1,
      WASM_I32_MUL,
      WASM_I32_CONST,
      sleb128(65537),
      WASM_I32_REM_U,
      WASM_END
    ].flat()

