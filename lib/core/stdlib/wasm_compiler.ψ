let emit_i32_load(align, offset) = [
      WASM_I32_LOAD,
      uleb128(align),
      uleb128(offset)
    ].flat()

let emit_i32_store(align, offset) = [
      WASM_I32_STORE,
      uleb128(align),
      uleb128(offset)
    ].flat()

let arc_hebbian_mem_wasm() =
    let part1 = [
      WASM_I32_CONST, 0,
      WASM_I32_CONST, 0,
      emit_i32_load(2, 0),
      WASM_LOCAL_GET, 0,
      WASM_LOCAL_GET, 1,
      WASM_I32_MUL,
      WASM_I32_ADD
    ].flat()
    let part2 = [
      emit_i32_store(2, 0),
      WASM_I32_CONST, 0,
      emit_i32_load(2, 0),
      WASM_END
    ].flat()
    [part1, part2].flat()

let wasm_code_section(body_bytes) =
    let local_decl = [0]
    let func_body = [local_decl, body_bytes].flat()
    let func_size = uleb128(len(func_body))
    let one_func = [func_size, func_body].flat()
    let payload = [[1], one_func].flat()
    wasm_section(10, payload)

let wasm_memory_section() =
    let payload = [[1], uleb128(0), uleb128(130)].flat()
    wasm_section(5, payload)

let build_wasm_module(op_body, export_name) =
    let magic = [0, 97, 115, 109]
    let version = [1, 0, 0, 0]
    let type_sec = wasm_type_section()
    let func_sec = wasm_function_section()
    let mem_sec = wasm_memory_section()
    let export_sec = wasm_export_section(export_name)
    let code_sec = wasm_code_section(op_body)
    [magic, version, type_sec, func_sec, mem_sec, export_sec, code_sec].flat()

let compile_gf_mul_wasm() = build_wasm_module(arc_gf_mul_wasm(), "gf_mul")

let compile_clifford_wasm() = build_wasm_module(arc_clifford_wasm(), "clifford")

