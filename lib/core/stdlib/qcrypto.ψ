let gcr_keygen(p, q) =
    let n = p * q
    let phi = (p - 1) * (q - 1)
    let e = 17
    let d = opt_inv(e, phi)
    [n, e, d]

let gcr_encrypt(msg, e, n) = opt_mod_pow(msg, e, n)
let gcr_decrypt(ct, d, n) = opt_mod_pow(ct, d, n)
