let _is_pow2_acc(x) =
    if x == 1
        1
    else
        0
    if x % 2 != 0
        0
    else
        _is_pow2_acc(x / 2)
let is_pow2(x) =
    if x <= 0
        0
    else
        _is_pow2_acc(x)

let _is_prime_loop(n, d) =
    if d * d > n
        1
    else
        0
    if n % d == 0
        0
    else
        _is_prime_loop(n, d + 2)
let is_prime(n) =
    if n < 2
        0
    else
        0
    if n == 2
        1
    else
        0
    if (n & 1) == 0
        0
    else
        _is_prime_loop(n, 3)

