import "quantum_circuit.ψ"

let re_apply(op, args) =
    if op == 1
      qc_mul(args[0], args[1])
    else
      if op == 2
        let a2 = args[0]
        let b2 = args[1]
        let and2 = a2 & b2
        let or2 = a2 + b2 - and2
        let xor2 = or2 - and2
        xor2 & or2
      else
        if op == 3
          let a3 = args[0]
          let b3 = args[1]
          let s3 = a3 + b3
          let d3 = a3 - b3
          let and3 = s3 & d3
          s3 + d3 - and3
        else
          if op == 4
            (args[0] != 0 ? args[1] : args[2])
          else
                0
            if op == 5
              args[0] + args[1]
            else
              0

let re_eval_rec(tree) =
    let op = tree[0]
    if op == 0
      tree[1]
    else
      if op == 1 || op == 2 || op == 3
        let l = re_eval_rec(tree[1])
        let r = re_eval_rec(tree[2])
        re_apply(op, [l, r])
      else
        if op == 4
          let c = re_eval_rec(tree[1])
          let t = re_eval_rec(tree[2])
          let e = re_eval_rec(tree[3])
          re_apply(4, [c, t, e])
        else
          if op == 5
            let a = re_eval_rec(tree[1])
            let b = re_eval_rec(tree[2])
            re_apply(5, [a, b])
          else
            0

let re_eval(tree) = re_eval_rec(tree)

let re_fold(tree) =
    let op = tree[0]
    if op == 0
      tree
    else
      let l = re_fold(tree[1])
      let r = re_fold(tree[2])
      let lv = (l[0] == 0 ? l[1] : -999999)
      let rv = (r[0] == 0 ? r[1] : -999999)
      if lv != -999999 && rv != -999999
        [0, re_apply(op, [lv, rv])]
      else
        tree

let re_verify() =
    let results = []
    results = results.push(re_apply(1, [7, 11]) == 77)
    results = results.push(re_apply(2, [3, 5]) == 6)
    results = results.push(re_apply(3, [7, 3]) == 14)
    results = results.push(re_apply(4, [1, 10, 20]) == 10)
    results = results.push(re_apply(4, [0, 10, 20]) == 20)
    results = results.push(re_apply(5, [5, 3]) == 8)
    results = results.push(re_eval([3, [1, [0, 7], [0, 11]], [0, 3]]) == 90)
    let folded = re_fold([1, [0, 3], [0, 5]])
    results = results.push(folded[0] == 0 && folded[1] == 15)
    results
