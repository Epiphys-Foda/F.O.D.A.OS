let rf_db_q_state(records) =
    let out = []
    let i = 0
    let done = false
    for !done
      if i < len(records)
        out = out.push(records[i])
        i = i + 1
      else
        done = true
    out

let rf_db_q_h(state, i) =
    let out = []
    let j = 0
    let done = false
    for !done
      if j < len(state)
        if j == i || j == (i ^ 1)
          out = out.push(state[j])
        else
          out = out.push(state[j])
        j = j + 1
      else
        done = true
        0
    let a = state[i]
    let b = state[i ^ 1]
    let s = a + b
    let d = a - b
    let nv0 = s * 2040 - (s * 2040 / 65537) * 65537
    let nv1raw = d * 2040
    let nv1 = nv1raw - (nv1raw / 65537) * 65537
    let nv1f = (nv1 < 0 ? nv1 + 65537 : nv1)
    if i < (i ^ 1)
      out = rf_db_arr_set(out, i, nv0)
      out = rf_db_arr_set(out, i ^ 1, nv1f)
    else
      out = rf_db_arr_set(out, i ^ 1, nv0)
      out = rf_db_arr_set(out, i, nv1f)
    out

let rf_db_q_bell_a(a) =
    let m = a * 2040
    m - (m / 65537) * 65537

let rf_db_q_bell_b(b) = rf_db_q_bell_a(b)

let rf_db_q_grover_a(a, b, n) =
    let p2 = rf_db_mod_pow(2, n % 32, 65537)
    let alpha = (p2 - 2) % 65537
    let beta = (p2 * 2 - 2) % 65537
    let r = (rf_db_mul(alpha, a) + rf_db_mul(beta, b)) % 65537
    (r < 0 ? r + 65537 : r)

let rf_db_q_grover_b(a, b, n) =
    let p2 = rf_db_mod_pow(2, n % 32, 65537)
    let alpha = (p2 - 2) % 65537
    let r = (0 - 2 * a + rf_db_mul(alpha, b)) % 65537
    (r < 0 ? r + 65537 : r)

let rf_db_q_grover_query(n, k) =
    let a = 1
    let b = 1
    let i = 0
    let done = false
    for !done
      if i < k
        let na = rf_db_q_grover_a(a, b, n)
        let nb = rf_db_q_grover_b(a, b, n)
        a = na
        b = nb
        i = i + 1
      else
        done = true
    [a, b]

let rf_db_q_qft8(signal) =
    let out = []
    let j = 0
    let done = false
    for !done
      if j < 8
        let acc = 0
        let k = 0
        let kdone = false
        for !kdone
          if k < 8
            let w = rf_db_mod_pow(16, (j * k) % 8, 65537)
            let term = rf_db_mul(signal[k], w)
            acc = acc + term - (term / 65537) * 65537
            k = k + 1
          else
            kdone = true
        let val = acc * 1020
        out = out.push(val - (val / 65537) * 65537)
        j = j + 1
      else
        done = true
    out

