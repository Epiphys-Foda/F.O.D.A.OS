let _cp8_dfs_cycle(graph, n, node, visited, on_stack) =
    if arr_get(on_stack, node) != 0
        1
    if arr_get(visited, node) != 0
        0
    arr_set(visited, node, 1)
    arr_set(on_stack, node, 1)
    let has_cycle = _cp8_dfs_scan_neighbors(graph, n, node, 0, visited, on_stack)
    arr_set(on_stack, node, 0)
    has_cycle
let _cp8_dfs_scan_neighbors(graph, n, node, j, visited, on_stack) =
    if j >= n
        0
    if mat_get(graph, node, j) != 0
      if _cp8_dfs_cycle(graph, n, j, visited, on_stack) == 1
          1
    _cp8_dfs_scan_neighbors(graph, n, node, j + 1, visited, on_stack)
let _cp8_init_visited(arr, i, n) =
    if i >= n
        arr
    arr_set(arr, i, 0)
    _cp8_init_visited(arr, i + 1, n)
let _cp8_detect_acc(graph, n, i, visited) =
    if i >= n
        0
    if arr_get(visited, i) == 0
      let on_stack = _cp8_init_visited(arr_new_n(n), 0, n)
      if _cp8_dfs_cycle(graph, n, i, visited, on_stack) == 1
          1
    _cp8_detect_acc(graph, n, i + 1, visited)
let cp8_deadlock_detect(resource_graph) =
    let n = mat_rows(resource_graph)
    let visited = _cp8_init_visited(arr_new_n(n), 0, n)
    _cp8_detect_acc(resource_graph, n, 0, visited)

