let cc4_attention_weights(Q, K, d_sqrt_inv) =
    let n = arr_len(Q)
    let weights = arr_new_n(n)
    _cc4_aw_acc(Q, K, d_sqrt_inv, n, 0, weights)
    weights
let _cc4_aw_acc(Q, K, d_sqrt_inv, n, i, weights) =
    if i >= n
        weights
    let q = arr_get(Q, i)
    let k = arr_get(K, i)
    let qk = gf_mul(q, k)
    let exponent = gf_mul(qk, d_sqrt_inv)
    let w = gf_pow(3, exponent)
    arr_set(weights, i, w)
    _cc4_aw_acc(Q, K, d_sqrt_inv, n, i + 1, weights)

let cc5_positional_encoding(pos, dim, i) = gf_pow(3, gf_mul(pos, i))

let _cc8_mean_acc(f_vals, i, n, acc) =
    if i >= n
        acc
    _cc8_mean_acc(f_vals, i + 1, n, gf_add(acc, arr_get(f_vals, i)))
let cc8_finite_expectation(f_vals) =
    let n = arr_len(f_vals)
    let sum = _cc8_mean_acc(f_vals, 0, n, 0)
    gf_div(sum, n)

let cc10_log_barrier(x) = gf_pow(3, gf_neg(gf_mul(x, x)))

let cc12_gf_sample(mu, sigma, k) = gf_add(mu, gf_mul(sigma, k))

let _cc13_count_le(samples, x, i, n, count) =
      if i >= n
          count
      if arr_get(samples, i) <= x
        _cc13_count_le(samples, x, i + 1, n, count + 1)
      else
        _cc13_count_le(samples, x, i + 1, n, count)
let cc13_normal_cdf(samples, x) =
    let n = arr_len(samples)
    let count = _cc13_count_le(samples, x, 0, n, 0)
    gf_div(count, n)

let _cc14_hadamard_acc(v, n, y, x, acc) =
    if x >= n
        acc
    let xy = x & y
    let coef = (((xy & 1) == 1) ? (65536) : (1))
    let term = gf_mul(arr_get(v, x), coef)
    _cc14_hadamard_acc(v, n, y, x + 1, gf_add(acc, term))
let cc14_hadamard(v, y) =
    let n = arr_len(v)
    _cc14_hadamard_acc(v, n, y, 0, 0)

