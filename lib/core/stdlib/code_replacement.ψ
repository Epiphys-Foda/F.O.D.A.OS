let _cp5_build_matrix_row(transfer_fn_id, i, n, j, row) =
    if j >= n
        row
    let next_state = host_call(transfer_fn_id, i, j)
    arr_set(row, j, next_state)
    _cp5_build_matrix_row(transfer_fn_id, i, n, j + 1, row)
let _cp5_build_matrix_acc(transfer_fn_id, i, n, M) =
    if i >= n
        M
    let row = arr_new_n(n)
    _cp5_build_matrix_row(transfer_fn_id, i, n, 0, row)
    arr_set(M, i, row)
    _cp5_build_matrix_acc(transfer_fn_id, i + 1, n, M)
let cp5_lookup_to_matrix(transfer_fn_id, n) =
    let M = arr_new_n(n)
    _cp5_build_matrix_acc(transfer_fn_id, 0, n, M)
    M

let cp6_symbol_hash(s_arr, n) =
    _cp6_hash_acc(s_arr, n, 0, 0)
let _cp6_hash_acc(s_arr, n, i, acc) =
    if i >= n
        acc
    let c = arr_get(s_arr, i)
    _cp6_hash_acc(s_arr, n, i + 1, gf_add(gf_mul(acc, 256), c))
let cp6_symbol_eq(s1, s2, n) =
    let h1 = cp6_symbol_hash(s1, n)
    let h2 = cp6_symbol_hash(s2, n)
    ((h1 == h2) ? (1) : (0))

