let sort_quick_helper(arr, lo, hi) =
    if lo >= hi
        return arr
    let pivot = arr[hi]
    let i = lo - 1
    let j = lo
    for j < hi
        if arr[j] < pivot
            i = i + 1
            let tmp = arr[i]
            arr[i] = arr[j]
            arr[j] = tmp
        j = j + 1
    i = i + 1
    let tmp = arr[i]
    arr[i] = arr[hi]
    arr[hi] = tmp
    arr = sort_quick_helper(arr, lo, i - 1)
    arr = sort_quick_helper(arr, i + 1, hi)
    arr

