let sort_heap_sift_down(arr, start, end) =
    let root = start
    for root * 2 + 1 <= end
        let child = root * 2 + 1
        if child + 1 <= end && arr[child] < arr[child + 1]
            child = child + 1
        if arr[root] < arr[child]
            let tmp = arr[root]
            arr[root] = arr[child]
            arr[child] = tmp
            root = child
        else
            root = end + 1
    arr

let sort_heap(arr) =
    let n = arr.len()
    if n <= 1
        return arr
    let result = arr_new()
    let i = 0
    for i < n
        result = arr_push(result, arr[i])
        i = i + 1
    i = n / 2 - 1
    for i >= 0
        result = sort_heap_sift_down(result, i, n - 1)
        i = i - 1
    i = n - 1
    for i > 0
        let tmp = result[0]
        result[0] = result[i]
        result[i] = tmp
        result = sort_heap_sift_down(result, 0, i - 1)
        i = i - 1
    result

