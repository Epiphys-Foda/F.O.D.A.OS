    for i < n
        let val = data[i]
        let found = 0 - 1
        let j = 0
        let m = dict.len()
        for j < m
            if dict[j] == val
                found = j
            j = j + 1
        if found < 0
            dict = arr_push(dict, val)
        i = i + 1
    dict

