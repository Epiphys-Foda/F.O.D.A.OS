    bloom = bloom_insert(bloom, 42)
    bloom = bloom_insert(bloom, 100)
    bloom = bloom_insert(bloom, 200)
    print(bloom_contains(bloom, 42))
    print(bloom_contains(bloom, 100))
    print(bloom_contains(bloom, 999))
