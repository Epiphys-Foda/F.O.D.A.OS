import "gfx.ψ"

let rf_rd3_field(poles3, px, py, pz) =
    let acc = 0
    let i = 0
    let done = false
    for !done
      if i + 3 < len(poles3)
        let dx = px - poles3[i]
        let dy = py - poles3[i + 1]
        let dz = pz - poles3[i + 2]
        let r = poles3[i + 3]
        let d2 = dx * dx + dy * dy + dz * dz
        let den = (d2 == 0 ? 1 : d2)
        let term = r * 1000 / den
        acc = acc + term - (term / 65537) * 65537
        i = i + 4
      else
        done = true
    acc

let rf_rd3_render(poles3, w, h, cam_z) =
    let fb = gfx_create(w, h)
    let i = 0
    let done = false
    for !done
      if i < w
        let j = 0
        let jdone = false
        for !jdone
          if j < h
            let sx = i - w / 2
            let sy = j - h / 2
            let v = rf_rd3_field(poles3, sx, sy, cam_z)
            if v > 100
              fb = gfx_set_pixel(fb, w, i, j, gfx_pack_rgb(255, 255, 255))
            else
              if v > 20
                fb = gfx_set_pixel(fb, w, i, j, gfx_pack_rgb(200, 200, 255))
              else
                0
            j = j + 1
          else
            jdone = true
        i = i + 1
      else
        done = true
    fb

let rf_rd3_gcd(A, B, eps) =
    let hit = 0
    let i = 0
    let done = false
    for !done
      if i + 3 < len(A)
        let j = 0
        let jdone = false
        for !jdone
          if j + 3 < len(B)
            let dx = A[i] - B[j]
            let dy = A[i + 1] - B[j + 1]
            let dz = A[i + 2] - B[j + 2]
            let d2 = dx * dx + dy * dy + dz * dz
            if d2 < eps * eps
              hit = hit + 1
            else
              0
            j = j + 4
          else
            jdone = true
        i = i + 4
      else
        done = true
    hit

let rf_rd3_light(poles3, px, py, pz, lx, ly, lz) =
    let acc = 0
    let i = 0
    let done = false
    for !done
      if i + 3 < len(poles3)
        let dx = px - poles3[i]
        let dy = py - poles3[i + 1]
        let dz = pz - poles3[i + 2]
        let ldx = lx - px
        let ldy = ly - py
        let ldz = lz - pz
        let r = poles3[i + 3]
        let d2 = dx * dx + dy * dy + dz * dz
        let den = (d2 == 0 ? 1 : d2)
        let dir = ldx * dx + ldy * dy + ldz * dz
        let term = r * dir / den
        acc = acc + term - (term / 65537) * 65537
        i = i + 4
      else
        done = true
    acc

let rf_rd3_robot(poles3, px, py, pz, step) =
    let x = px
    let y = py
    let z = pz
    let i = 0
    let done = false
    for !done
      if i < step
        let cur = rf_rd3_field(poles3, x, y, z)
        let ex = rf_rd3_field(poles3, x + 1, y, z)
        let ey = rf_rd3_field(poles3, x, y + 1, z)
        let ez = rf_rd3_field(poles3, x, y, z + 1)
        let wx = rf_rd3_field(poles3, x - 1, y, z)
        let wy = rf_rd3_field(poles3, x, y - 1, z)
        let wz = rf_rd3_field(poles3, x, y, z - 1)
        if ex > cur
          x = x + 1
        else
          if ey > cur
            y = y + 1
          else
            if ez > cur
              z = z + 1
            else
              if wx > cur
                x = x - 1
              else
                if wy > cur
                  y = y - 1
                else
                  if wz > cur
                    z = z - 1
                  else
                    0
        i = i + 1
      else
        done = true
    [x, y, z]

let rf_rd3_sphere() = [0, 0, 0, 100]

let rf_rd3_verify() =
    let sphere = rf_rd3_sphere()
    let t1 = rf_rd3_field(sphere, 0, 0, 0) > rf_rd3_field(sphere, 10, 10, 10)
    let fb = rf_rd3_render(sphere, 16, 16, 3)
    let t2 = gfx_get_pixel(fb, 16, 8, 8) == gfx_pack_rgb(255, 255, 255)
    let t3 = rf_rd3_gcd([0, 0, 0, 100], [1, 0, 0, 100], 2) > 0
    let t4 = rf_rd3_gcd([0, 0, 0, 100], [50, 50, 50, 100], 2) == 0
    let robot_end = rf_rd3_robot(sphere, 5, 0, 0, 3)
    let t5 = rf_rd3_field(sphere, robot_end[0], robot_end[1], robot_end[2]) > rf_rd3_field(sphere, 5, 0, 0)
    t1 && t2 && t3 && t4 && t5
