    results = results.push(["add", bp_test_add(), 7])
    results = results.push(["sub", bp_test_sub(), 7])
    results = results.push(["mul", bp_test_mul(), 42])
    results = results.push(["div", bp_test_div(), 42])
    results = results.push(["mod", bp_test_mod(), 1])
    results = results.push(["var_ref", bp_test_var_ref(), 11])
    results = results.push(["chain", bp_test_chain(), 5])
    results = results.push(["if_true", bp_test_if_true(), 10])
    results = results.push(["if_false", bp_test_if_false(), 20])
    results = results.push(["for_loop", bp_test_for_loop(), 10])
    results = results.push(["for_loop_10", bp_test_for_loop_10(), 45])
    results = results.push(["fn_call", bp_test_fn_call(), 42])
    results = results.push(["fn_add", bp_test_fn_add(), 42])
    results = results.push(["nested_fn", bp_test_nested_fn(), 49])
    results = results.push(["negative", bp_test_negative(), -5])
    results = results.push(["bitwise", bp_test_bitwise(), 8])
    results = results.push(["shift", bp_test_shift(), 16])
    let pass = 0
    let fail = 0
    let i = 0
    for i < len(results)
      if results[i][1] == results[i][2]
        pass = pass + 1
      else
        fail = fail + 1
      i = i + 1
    [pass, fail, results]
