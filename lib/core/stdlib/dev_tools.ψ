let lsp_completion(symbols, prefix) =
    let matches = arr_new()
    _lsp_completion_acc(symbols, prefix, matches, arr_len(symbols), 0)
    matches
let _lsp_completion_acc(symbols, prefix, matches, n, i) =
    if i >= n
        matches
    let sym = arr_get(symbols, i)
    if sym >= prefix
      arr_push(matches, sym)
    _lsp_completion_acc(symbols, prefix, matches, n, i + 1)

let lsp_hover(symbol_id, doc_table) =
    let n = arr_len(doc_table)
    _lsp_hover_acc(doc_table, symbol_id, n, 0)
let _lsp_hover_acc(doc_table, symbol_id, n, i) =
    if i >= n
        0 - 1
    let entry = arr_get(doc_table, i)
    if arr_get(entry, 0) == symbol_id
      arr_get(entry, 1)
    _lsp_hover_acc(doc_table, symbol_id, n, i + 1)

let lsp_goto_definition(symbol_id, def_table) =
    let n = arr_len(def_table)
    _lsp_def_acc(def_table, symbol_id, n, 0)
let _lsp_def_acc(def_table, symbol_id, n, i) =
    if i >= n
        0 - 1
    let entry = arr_get(def_table, i)
    if arr_get(entry, 0) == symbol_id
      entry
    _lsp_def_acc(def_table, symbol_id, n, i + 1)

let lsp_find_references(symbol_id, ref_table) =
    let refs = arr_new()
    _lsp_refs_acc(ref_table, symbol_id, refs, arr_len(ref_table), 0)
    refs
let _lsp_refs_acc(ref_table, symbol_id, refs, n, i) =
    if i >= n
        refs
    let entry = arr_get(ref_table, i)
    if arr_get(entry, 0) == symbol_id
      arr_push(refs, entry)
    _lsp_refs_acc(ref_table, symbol_id, refs, n, i + 1)

let lsp_rename(old_id, new_id, ref_table) =
    let n = arr_len(ref_table)
    _lsp_rename_acc(ref_table, old_id, new_id, n, 0, 0)
let _lsp_rename_acc(ref_table, old_id, new_id, n, i, count) =
      if i >= n
          count
      let entry = arr_get(ref_table, i)
      if arr_get(entry, 0) == old_id
        arr_set(entry, 0, new_id)
        _lsp_rename_acc(ref_table, old_id, new_id, n, i + 1, count + 1)
      else
        _lsp_rename_acc(ref_table, old_id, new_id, n, i + 1, count)

let lsp_diagnostic(errors) =
    let diags = arr_new()
    _lsp_diag_acc(errors, diags, arr_len(errors), 0)
    diags
let _lsp_diag_acc(errors, diags, n, i) =
    if i >= n
        diags
    let err = arr_get(errors, i)
    let v = arr_new_n(4)
    arr_set(v, 0, 2)
    arr_set(v, 1, arr_get(err, 0))
    arr_set(v, 2, arr_get(err, 1))
    arr_set(v, 3, arr_get(err, 2))
    arr_push(diags, v)
    _lsp_diag_acc(errors, diags, n, i + 1)

let lsp_handle_request(req, symbol_table, doc_table, def_table, ref_table) =
    let method = lsp_request_method(req)
    let params = lsp_request_params(req)
    if method == LSP_METHOD_COMPLETION
      lsp_response_make(1, lsp_completion(symbol_table, params))
    if method == LSP_METHOD_HOVER
      lsp_response_make(1, lsp_hover(params, doc_table))
    if method == LSP_METHOD_DEFINITION
      lsp_response_make(1, lsp_goto_definition(params, def_table))
    if method == LSP_METHOD_REFERENCES
      lsp_response_make(1, lsp_find_references(params, ref_table))
    lsp_response_make(0, 0)

