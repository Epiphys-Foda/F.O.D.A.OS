    v

let incremental_find_affected(ctx, changed_file) =
    let deps = arr_get(ctx, 0)
    let affected = arr_new()
    arr_push(affected, changed_file)
    _incremental_aff_acc(deps, changed_file, affected, arr_len(deps), 0)
    affected
let _incremental_aff_acc(deps, file, affected, n, i) =
      if i >= n
          affected
      let dep = arr_get(deps, i)
      if arr_get(dep, 1) == file
        let dependent = arr_get(dep, 0)
        arr_push(affected, dependent)
        _incremental_aff_acc(deps, dependent, affected, n, i + 1)
      else
        _incremental_aff_acc(deps, file, affected, n, i + 1)

let incremental_check_hash(ctx, file_id, new_hash) =
    let hashes = arr_get(ctx, 1)
    if file_id >= arr_len(hashes)
        1
    let old_hash = arr_get(hashes, file_id)
    ((old_hash != new_hash) ? (1) : (0))

let incremental_update_hash(ctx, file_id, new_hash) =
    let hashes = arr_get(ctx, 1)
    arr_set(hashes, file_id, new_hash)
    ctx

let incremental_estimate_savings(affected_count, total_count) =
    if affected_count == 0
        total_count
    total_count / affected_count

