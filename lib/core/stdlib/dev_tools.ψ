let source_map_make(entries) = entries

let source_map_lookup(map, wasm_offset) =
    let n = arr_len(map)
    _source_map_acc(map, wasm_offset, n, 0)
let _source_map_acc(map, offset, n, i) =
    if i >= n
        0 - 1
    let entry = arr_get(map, i)
    if arr_get(entry, 0) == offset
      entry
    _source_map_acc(map, offset, n, i + 1)

let source_map_reverse_lookup(map, file_id, line) =
    let n = arr_len(map)
    _source_map_rev_acc(map, file_id, line, n, 0)
let _source_map_rev_acc(map, file_id, line, n, i) =
    if i >= n
        0 - 1
    let entry = arr_get(map, i)
    if arr_get(entry, 1) == file_id && arr_get(entry, 2) == line
      entry
    _source_map_rev_acc(map, file_id, line, n, i + 1)

let source_map_build(wasm_sections, ast) =
    let n = arr_len(ast)
    let map = arr_new()
    _source_map_build_acc(wasm_sections, ast, map, n, 0, 0)
    map
let _source_map_build_acc(wasm, ast, map, n, i, offset) =
    if i >= n
        map
    let node = arr_get(ast, i)
    let entry = source_map_entry_make(offset, arr_get(node, 0), arr_get(node, 1), arr_get(node, 2))
    arr_push(map, entry)
    let next_offset = offset + 4
    _source_map_build_acc(wasm, ast, map, n, i + 1, next_offset)

let incremental_make(file_deps, file_hashes) =
    let v = arr_new_n(2)
    arr_set(v, 0, file_deps)
