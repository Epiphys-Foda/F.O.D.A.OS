let vscode_response_make(success, result, error_msg_id) =
    let v = arr_new_n(3)
    arr_set(v, 0, success)
    arr_set(v, 1, result)
    arr_set(v, 2, error_msg_id)
    v

let vscode_handle_command(cmd, compile_fn_id) =
    let cmd_id = vscode_command_id(cmd)
    let args = vscode_command_args(cmd)
    if cmd_id == VSCODE_CMD_COMPILE
      let result = host_call(compile_fn_id, args, 0)
      if result < 0
        vscode_response_make(0, 0, 0 - result)
      vscode_response_make(1, result, 0)
    if cmd_id == VSCODE_CMD_RUN
      vscode_response_make(1, 0, 0)
    if cmd_id == VSCODE_CMD_FORMAT
      vscode_response_make(1, args, 0)
    vscode_response_make(0, 0, 99)

