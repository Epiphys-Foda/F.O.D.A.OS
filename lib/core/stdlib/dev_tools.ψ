let ts_incremental_parse(old_tree, edit) =
    let affected = arr_new()
    let ranges = ts_tree_ranges(old_tree)
    let n = arr_len(ranges)
    _ts_incr_acc(ranges, edit, affected, n, 0)
    affected
let _ts_incr_acc(ranges, edit, affected, n, i) =
    if i >= n
        affected
    let range = arr_get(ranges, i)
    let start = arr_get(range, 0)
    let end = arr_get(range, 1)
    let edit_start = arr_get(edit, 0)
    let edit_old_end = arr_get(edit, 1)
    if start <= edit_old_end && end >= edit_start
      arr_push(affected, range)
    _ts_incr_acc(ranges, edit, affected, n, i + 1)

let ts_estimate_savings(affected_count, total_count) =
    if affected_count == 0
        total_count
    total_count / affected_count

