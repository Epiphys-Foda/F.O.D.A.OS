let timer_new() = arr_new_n(0)
let timer_start(t, stage_id) =
    let entry = arr_new_n(4)
    arr_set(entry, 0, stage_id)
    arr_set(entry, 1, host_call(2, 0, 0))
    arr_set(entry, 2, 0)
    arr_set(entry, 3, 0)
    arr_push(t, entry)
    t
let timer_end(t, stage_id) =
    _timer_end_acc(t, stage_id, host_call(2, 0, 0), 0, arr_len(t))
let _timer_end_acc(t, stage_id, end_time, i, n) =
    if i >= n
        t
    let entry = arr_get(t, i)
    if arr_get(entry, 0) == stage_id
      let start = arr_get(entry, 1)
      arr_set(entry, 2, end_time)
      arr_set(entry, 3, end_time - start)
      t
    _timer_end_acc(t, stage_id, end_time, i + 1, n)
let timer_elapsed(t, stage_id) =
    _timer_elapsed_acc(t, stage_id, 0, arr_len(t))
let _timer_elapsed_acc(t, stage_id, i, n) =
    if i >= n
        0
    let entry = arr_get(t, i)
    if arr_get(entry, 0) == stage_id
      arr_get(entry, 3)
    _timer_elapsed_acc(t, stage_id, i + 1, n)
let timer_print(t) =
    _timer_print_acc(t, 0, arr_len(t))
let _timer_print_acc(t, i, n) =
    if i >= n
        0
    let entry = arr_get(t, i)
    print("  stage ")
    print(arr_get(entry, 0))
    print(": ")
    print(arr_get(entry, 3))
    print(" ms")
    _timer_print_acc(t, i + 1, n)

