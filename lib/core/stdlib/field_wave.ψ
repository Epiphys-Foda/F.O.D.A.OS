let fw_evolve(poles, x, y, t) =
    let acc = 0
    let z = fw_z(x, y)
    let k = 0
    let done = false
    for !done
      if k < len(poles)
        let xk = poles[k]
        let yk = poles[k + 1]
        let rk = poles[k + 2]
        let phase = opt_mod_pow(64, (t * k) % 16, 65537)
        let zk = fw_z(xk, yk)
        let dz = (z - zk) % 65537
        let dz_p = dz < 0 ? dz + 65537 : dz
        if dz_p != 0
          let inv = fw_inv(dz_p)
          let term = (rk * phase) % 65537
          let term2 = (term * inv) % 65537
          let s = acc + term2
          if s >= 65537
            acc = s - 65537
          else
            acc = s
        else
          0
        k = k + 3
      else
        done = true
    acc

