import "opt.ψ"
let fw_z(x, y) = (x + y * 65281) % 65537

let fw_inv(z) = opt_mod_pow(z, 65535, 65537)

let fw_field(poles, x, y) =
    let acc = 0
    let i = 0
    let done = false
    for !done
      if i < len(poles)
        let xk = poles[i]
        let yk = poles[i + 1]
        let rk = poles[i + 2]
        let zk = fw_z(xk, yk)
        let z = fw_z(x, y)
        let dz = (z - zk) % 65537
        let dz_p = dz < 0 ? dz + 65537 : dz
        if dz_p != 0
          let term = (rk * fw_inv(dz_p)) % 65537
          let s = acc + term
          if s >= 65537
            acc = s - 65537
          else
            acc = s
        else
          0
        i = i + 3
      else
        done = true
    acc

let fw_intensity(v) =
    if v > 32768
      65537 - v
    else
      v

let fw_poles_two(d) = [0 - d, 0, 1, d, 0, 1]

let fw_slit(n, a) =
    let out = []
    let i = 0
    let done = false
    for !done
      if i < n
        let y = (0 - a) + (2 * a * i) / (n - 1)
        out = out.push(0)
        out = out.push(y)
        out = out.push(1)
        i = i + 1
      else
        done = true
    out

let fw_line(poles, y, x0, x1, n) =
    let out = []
    let i = 0
    let done = false
    for !done
      if i < n
        let x = x0 + (x1 - x0) * i / (n - 1)
        let v = fw_field(poles, x, y)
        out = out.push(fw_intensity(v))
        i = i + 1
      else
        done = true
    out

let fw_grayscale(v, levels) = (v * levels) / 65537

