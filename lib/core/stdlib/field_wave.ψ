let fw_cdiv(a, b) =
    let ar = a[0]
    let ai = a[1]
    let br = b[0]
    let bi = b[1]
    let den = (br * br + bi * bi) % 65537
    let dinv = fw_inv(den)
    let re = ((ar * br + ai * bi) * dinv) % 65537
    let im = ((ai * br - ar * bi) * dinv) % 65537
    [re, im]

let fw_cmul(a, b) =
    let ar = a[0]
    let ai = a[1]
    let br = b[0]
    let bi = b[1]
    [((ar * br - ai * bi) % 65537 + 65537) % 65537, (ar * bi + ai * br) % 65537]

let fw_cadd(a, b) = [(a[0] + b[0]) % 65537, (a[1] + b[1]) % 65537]

let fw_field2(poles, x, y) =
    let acc = [0, 0]
    let k = 0
    let done = false
    for !done
      if k < len(poles)
        let xk = poles[k]
        let yk = poles[k + 1]
        let rk = poles[k + 2]
        let dz = [(x - xk) % 65537, (y - yk) % 65537]
        if dz[0] != 0 || dz[1] != 0
          let term = fw_cdiv([rk, 0], dz)
          acc = fw_cadd(acc, term)
        else
          0
        k = k + 3
      else
        done = true
    acc

let fw_norm2(z) = (z[0] * z[0] + z[1] * z[1]) % 65537

let fw_cabs(z) =
    let n = fw_norm2(z)
    let is_qr = opt_mod_pow(n, 32768, 65537) == 1
    if !is_qr
      0
    else
      n

