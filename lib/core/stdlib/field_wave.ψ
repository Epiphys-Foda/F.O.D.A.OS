      if t2 < 16
        if fw_evolve(p2, 2, 0, t2) != fw_evolve(p2, 2, 0, 0)
          evolves = true
        else
          0
        t2 = t2 + 1
      else
        done2 = true
    results = results.push(evolves)
    let total = true
    let i = 0
    let done3 = false
    for !done3
      if i < len(results)
        let v = results[i]
        if v == false
          total = false
        else
          0
        i = i + 1
      else
        done3 = true
    results = results.push(total)
    results

let fw_measure(poles, t, x0, x1, n) =
    let best_x = x0
    let best_v = 0
    let i = 0
    let done = false
    for !done
      if i < n
        let x = x0 + (x1 - x0) * i / (n - 1)
        let v = fw_intensity(fw_evolve(poles, x, 0, t))
        if v > best_v
          best_v = v
          best_x = x
        else
          0
        i = i + 1
      else
        done = true
    [best_x, best_v]

let fw_reason(poles, t_max, x0, x1, n) =
    let out = []
    let t = 0
    let done = false
    for !done
      if t <= t_max
        let m = fw_measure(poles, t, x0, x1, n)
        out = out.push(m[0])
        t = t + 1
      else
        done = true
    out

