let sh_gcd(a, b) =
    let x = a
    let y = b
    for y != 0
      let t = x % y
      x = y
      y = t
    x

let sh_mulmod(a, b, m) =
    let r = 0
    let x = a % m
    let y = b
    for y > 0
      let odd = y % 2 == 1
      if odd
        r = (r + x) % m
      else
        0
      x = (x + x) % m
      y = y / 2
    r

let sh_mod_pow(a, b, n) =
    let base = a
    let exp = b
    let acc = 1
    for exp > 0
      let odd = exp % 2 == 1
      if odd
        acc = sh_mulmod(acc, base, n)
      else
        0
      base = sh_mulmod(base, base, n)
      exp = exp / 2
    acc

let sh_order(a, n) =
    let k = 1
    let v = a % n
    for v != 1 && k < n
      v = (v * a) % n
      k = k + 1
    if v == 1
      k
    else
      0

let sh_try_factor(n, a) =
    let r = sh_order(a, n)
    let r_even = r != 0 && r % 2 == 0
    if !r_even
      []
    else
      let half = sh_mod_pow(a, r / 2, n)
      let is_trivial = half == 1 || half == n - 1
      if is_trivial
        []
      else
        let d = sh_gcd(half - 1, n)
        let ok_d = d > 1 && d < n
        if ok_d
          [d, n / d]
        else
          []

let sh_factor(n) =
    let a = 2
    let result = []
    for a < n && len(result) == 0
      result = sh_try_factor(n, a)
      a = a + 1
    result

