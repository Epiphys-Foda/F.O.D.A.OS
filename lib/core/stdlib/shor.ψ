let sh_ntt_l(sig, L, w, p) =
    let out = []
    let wtbl = [1]
    let wi = 1
    let wdone = false
    for !wdone
      if wi < L
        let prev = wtbl[wi - 1]
        wtbl = wtbl.push(sh_mulmod(prev, w, p))
        wi = wi + 1
      else
        wdone = true
    let k = 0
    let kdone = false
    for !kdone
      if k < L
        let acc = 0
        let i = 0
        let idone = false
        for !idone
          if i < L
            let e = (k * i) % L
            let term = sh_mulmod(sig[i], wtbl[e], p)
            acc = acc + term
            i = i + 1
          else
            idone = true
        out = out.push(acc % p)
        k = k + 1
      else
        kdone = true
    out

let sh_zero_mode(a, n, L, w, p) =
    let seq = []
    let i = 0
    let done = false
    for !done
      if i < L
        seq = seq.push(sh_mod_pow(a, i, n))
        i = i + 1
      else
        done = true
    let x = sh_ntt_l(seq, L, w, p)
    let nz = 0
    let k = 1
    let kdone = false
    for !kdone
      if k < L
        if x[k] != 0
          if nz == 0
            nz = k
          else
              0
        else
          0
        k = k + 1
      else
        kdone = true
    if nz == 0
      1
    else
      let cand = L / nz
      let ok = L % nz == 0 && sh_mod_pow(a, cand, n) == 1
      if ok
        sh_min_order(a, n, cand)
      else
        0

let sh_min_order(a, n, max) =
    let d = 1
    let found = 0
    let done = false
    for !done
      if d <= max
        if found == 0
          if sh_mod_pow(a, d, n) == 1
            found = d
          else
              0
        else
          0
        d = d + 1
      else
        done = true
    found

let sh_qpe_order(a, n) =
    let r1 = sh_zero_mode(a, n, 16, 64, 65537)
    if r1 > 0
      r1
    else
      let r2 = sh_zero_mode(a, n, 24, 729835, 786433)
      if r2 > 0
        r2
      else
        let r5 = sh_zero_mode(a, n, 40, 36643, 70001)
        if r5 > 0
          r5
        else
          sh_zero_mode(a, n, 56, 61781, 65633)

let sh_qpe_factor(n) =
    let a = 2
    let result = []
    let done = false
    for !done
      if a < n && len(result) == 0
        let r = sh_qpe_order(a, n)
        let r_even = r != 0 && r % 2 == 0
        if r_even
          let half = sh_mod_pow(a, r / 2, n)
          let ok = half != 1 && half != n - 1
          if ok
            let d = sh_gcd(half - 1, n)
            if d > 1 && d < n
              result = [d, n / d]
            else
                0
          else
              0
        else
          0
        a = a + 1
      else
        done = true
    result

