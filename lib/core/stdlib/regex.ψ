let re_find_all(text, pattern) =
    let positions = arr_new()
    let tlen = text.len()
    let plen = pattern.len()
    let ppos = 0
    if plen > 0 && pattern[0] == 94
        ppos = 1
    let pos = 0
    for pos <= tlen
        let r = re_match_here(text, pos, pattern, ppos)
        if r >= 0
            positions = arr_push(positions, pos)
            (r > pos ? (pos = r) : (pos = pos + 1))
        else
                0
            pos = pos + 1
    positions

let re_replace_first(text, pattern, replacement) =
    let pos = re_find(text, pattern)
    if pos < 0
        return text
    let plen = pattern.len()
    let ppos = 0
    if plen > 0 && pattern[0] == 94
        ppos = 1
    let end = re_match_here(text, pos, pattern, ppos)
    let result = ""
    let i = 0
    for i < pos
        result = result + text[i]
        i = i + 1
    result = result + replacement
    i = end
    for i < text.len()
        result = result + text[i]
        i = i + 1
    result

let re_count(text, pattern) =
    let positions = re_find_all(text, pattern)
    positions.len()

let re_glob(text, pattern) =
    let tlen = text.len()
    let plen = pattern.len()
    let dp = arr_new_n((tlen + 1) * (plen + 1))
    let idx_0_0 = 0
    dp[idx_0_0] = 1
    let j = 1
    for j <= plen
        if pattern[j - 1] == 42
            let idx = j
            dp[idx] = dp[j - 1]
        j = j + 1
    let i = 1
    for i <= tlen
        j = 1
        for j <= plen
            let idx = i * (plen + 1) + j
            if pattern[j - 1] == 42
                let idx1 = i * (plen + 1) + j - 1
                let idx2 = (i - 1) * (plen + 1) + j
                if dp[idx1] == 1 || dp[idx2] == 1
                    dp[idx] = 1
                else if pattern[j - 1] == 63
                let idx3 = (i - 1) * (plen + 1) + j - 1
                dp[idx] = dp[idx3]
            else
                let idx4 = (i - 1) * (plen + 1) + j - 1
                if text[i - 1] == pattern[j - 1]
                    dp[idx] = dp[idx4]
            j = j + 1
        i = i + 1
    dp[tlen * (plen + 1) + plen]

