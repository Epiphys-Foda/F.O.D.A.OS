let re_match_char(c, pattern) =
    c == pattern

let re_match_any(c) =
    c != 10 && c != 13

let re_match_class(c, class_str) =
    let n = class_str.len()
    let i = 0
    let negate = 0
    if n > 0 && class_str[0] == 94
        negate = 1
        i = 1
    let found = 0
    for i < n
        if i + 2 < n && class_str[i + 1] == 45
            if c >= class_str[i] && c <= class_str[i + 2]
                found = 1
            i = i + 3
        else
            if c == class_str[i]
                found = 1
            i = i + 1
    (negate == 1 ? 1 - found : found)

let re_match_here(text, pos, pattern, ppos) =
    let tlen = text.len()
    let plen = pattern.len()
    if ppos >= plen
        return pos
    let pc = pattern[ppos]
    if pc == 36
        if pos == tlen
            return pos
        return 0 - 1
    if ppos + 1 < plen && pattern[ppos + 1] == 42
        return re_match_star(text, pos, pattern, ppos)
    if ppos + 1 < plen && pattern[ppos + 1] == 43
        if pos >= tlen
            return 0 - 1
        if pc == 46
            if re_match_any(text[pos]) == 0
                return 0 - 1
            else if pc != text[pos]
            return 0 - 1
        return re_match_star(text, pos + 1, pattern, ppos)
    if ppos + 1 < plen && pattern[ppos + 1] == 63
        if pos < tlen
            let match_ = 0
            if pc == 46
                match_ = re_match_any(text[pos])
            else
                0
            if pc == text[pos]
                match_ = 1
            if match_ == 1
                let r = re_match_here(text, pos + 1, pattern, ppos + 2)
                if r >= 0
                    return r
        return re_match_here(text, pos, pattern, ppos + 2)
    if pos >= tlen
        return 0 - 1
    if pc == 46
        if re_match_any(text[pos]) == 0
            return 0 - 1
        else if pc != text[pos]
        return 0 - 1
    re_match_here(text, pos + 1, pattern, ppos + 1)

let re_match_star(text, pos, pattern, ppos) =
    let tlen = text.len()
    let pc = pattern[ppos]
    let current = pos
    for current < tlen
        let match_ = 0
        if pc == 46
            match_ = re_match_any(text[current])
        else
            0
        if pc == text[current]
            match_ = 1
        if match_ == 0
            current = tlen
        else
            current = current + 1
    for current >= pos
        let r = re_match_here(text, current, pattern, ppos + 2)
        if r >= 0
            return r
        current = current - 1
    0 - 1

