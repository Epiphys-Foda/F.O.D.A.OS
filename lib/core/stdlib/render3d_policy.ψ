import "render3d_robot.ψ"
import "render3d_train.ψ"

let rf_rdp_round(env, sx, sy, sz, tx, ty, tz, steps) = rf_rdr_train(env, sx, sy, sz, tx, ty, tz, steps)

let rf_rdp_benchmark(env, sx, sy, sz, tx, ty, tz, rounds, max_steps) =
    let wins = 0
    let total_steps = 0
    let i = 0
    let done = false
    for !done
      if i < rounds
        let r = rf_rdp_round(env, sx, sy, sz, tx, ty, tz, max_steps)
        wins = wins + r[0]
        total_steps = total_steps + r[1]
        i = i + 1
      else
        done = true
    [wins, total_steps]

let rf_rdp_evolve(env, sx, sy, sz, tx, ty, tz, rounds, eta) =
    let cur_env = env
    let i = 0
    let done = false
    for !done
      if i < rounds
        let traj = rf_rdt_episode(cur_env, sx, sy, sz, tx, ty, tz, 10)
        cur_env = rf_rdt_learn(cur_env, traj, eta)
        i = i + 1
      else
        done = true
    cur_env

let rf_rdp_learned_metric(env0, env1, traj) =
    let e0 = rf_rdr_path_energy(env0, traj)
    let e1 = rf_rdr_path_energy(env1, traj)
    e1 - e0

let rf_rdp_frame_stream(robots, targets) =
    let out = []
    out = out.push(251)
    out = out.push(len(robots))
    let i = 0
    let done = false
    for !done
      if i < len(robots)
        out = out.push(robots[i])
        i = i + 1
      else
        done = true
    out = out.push(len(targets))
    i = 0
    done = false
    for !done
      if i < len(targets)
        out = out.push(targets[i])
        i = i + 1
      else
        done = true
    out

let rf_rdp_animation_stream(robots, targets, frames) =
    let out = []
    out = out.push(252)
    out = out.push(frames)
    let f = 0
    let done = false
    for !done
      if f < frames
        out = out.push(251)
        out = out.push(3)
        out = out.push(robots[0] + f)
        out = out.push(robots[1])
        out = out.push(robots[2])
        out = out.push(3)
        out = out.push(targets[0])
        out = out.push(targets[1])
        out = out.push(targets[2])
        f = f + 1
      else
        done = true
    out

let rf_rdp_verify() =
    let env = [0, 0, 0, 100]
    let r1 = rf_rdp_round(env, 5, 0, 0, 0, 0, 0, 20)
    let t1 = r1[0] == 1
    let bm = rf_rdp_benchmark(env, 5, 0, 0, 0, 0, 0, 3, 20)
    let t2 = bm[0] >= 1
    let ev = rf_rdp_evolve(env, 5, 0, 0, 0, 0, 0, 2, 5)
    let t3 = len(ev) > len(env)
    let traj = rf_rdt_episode(env, 5, 0, 0, 0, 0, 0, 8)
    let t4 = rf_rdp_learned_metric(env, ev, traj) != 0
    let fs = rf_rdp_frame_stream([5, 0, 0], [0, 0, 0])
    let t5 = fs[0] == 251 && fs[1] == 3
    let as = rf_rdp_animation_stream([5, 0, 0], [0, 0, 0], 2)
    let t6 = as[0] == 252 && as[1] == 2
    t1 && t2 && t3 && t4 && t5 && t6
