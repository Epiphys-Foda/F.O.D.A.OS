let _select_loop(idx, best_idx, best_bits, bits_needed, v2_needed, v3_needed) =
    if idx >= 4
        best_idx
    else
        let v2 = pool_v2(idx)
        let v3 = pool_v3(idx)
        let bp = pool_bits(idx)
        let ok = (v2 >= v2_needed) && (v3 >= v3_needed) && (bp >= bits_needed)
        if ok
            if best_idx < 0
                _select_loop(idx + 1, idx, bp, bits_needed, v2_needed, v3_needed)
            else
                0
            if bp < best_bits
                _select_loop(idx + 1, idx, bp, bits_needed, v2_needed, v3_needed)
            else
                _select_loop(idx + 1, best_idx, best_bits, bits_needed, v2_needed, v3_needed)
        else
            _select_loop(idx + 1, best_idx, best_bits, bits_needed, v2_needed, v3_needed)

let select_domain(bits_needed, v2_needed, v3_needed) =
    _select_loop(0, -1, 999, bits_needed, v2_needed, v3_needed)

let pool_ntt_root(idx, k) =
    let p = pool_p(idx)
    let g = pool_g(idx)
    let exp = pool_pm1(idx) >> k
    gf_pow_p(g, exp, p)

let pool_cubic_root(idx) =
    let p = pool_p(idx)
    let g = pool_g(idx)
    let exp = pool_pm1(idx) / 3
    gf_pow_p(g, exp, p)

