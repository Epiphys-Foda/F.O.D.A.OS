let val2(n) =
    if n == 0
        0
    else
        0
    if (n % 2) != 0
        0
    else
        1 + val2(n / 2)

let val3(n) =
    if n == 0
        0
    else
        0
    if (n % 3) != 0
        0
    else
        1 + val3(n / 3)

let bits_of(n) =
    if n <= 1
        1
    else
        1 + bits_of(n / 2)

let gf_reduce_p(x, p) =
    if x < 0
        let r = x % p
        if r < 0
            r + p
        else
            r
    else
        0
    if x >= p
        x % p
    else
        x

let gf_add_p(a, b, p) =
    let s = a + b
    if s >= p
        s - p
    else
        s

let gf_sub_p(a, b, p) =
    let d = a - b
    if d < 0
        d + p
    else
        d

let gf_neg_p(a, p) =
    if a == 0
        0
    else
        p - a

let _gf_mul_loop_p(x, y, p, result) =
    if y <= 0
        result
    else
        let s = result + x
        let ns = s
        if s >= p
            ns = s - p
        let next_result = result
        if (y & 1) == 1
            next_result = ns
        let d = x + x
        let next_x = d
        if d >= p
            next_x = d - p
        _gf_mul_loop_p(next_x, y >> 1, p, next_result)

let gf_mul_p(a, b, p) =
    let ar = gf_reduce_p(a, p)
    let br = gf_reduce_p(b, p)
    if ar == 0
        0
    else
        0
    if br == 0
        0
    else
        0
    if ar == 1
        br
    else
        0
    if br == 1
        ar
    else
        _gf_mul_loop_p(ar, br, p, 0)

let gf_pow_p(base, exp, p) =
    if exp <= 0
        1
    else
        0
    if (exp & 1) == 1
        gf_mul_p(base, gf_pow_p(base, exp - 1, p), p)
    else
        let half = gf_pow_p(base, exp >> 1, p)
        gf_mul_p(half, half, p)

let gf_inv_p(a, p) =
    if a == 0
        0
    else
        gf_pow_p(a, p - 2, p)

let gf_div_p(a, b, p) =
    if b == 0
        0
    else
        gf_mul_p(a, gf_inv_p(b, p), p)

