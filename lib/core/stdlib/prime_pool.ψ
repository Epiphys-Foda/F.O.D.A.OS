let prime_pool_verify() =
    let ok1 = (pool_p(0) == 65537) && (pool_p(1) == 131071) && (pool_p(2) == 786433) && (pool_p(3) == 1376257)
    let ok2 = (val2(pool_pm1(0)) == pool_v2(0)) && (val2(pool_pm1(1)) == pool_v2(1)) && (val2(pool_pm1(2)) == pool_v2(2)) && (val2(pool_pm1(3)) == pool_v2(3))
    let ok3 = (val3(pool_pm1(0)) == pool_v3(0)) && (val3(pool_pm1(1)) == pool_v3(1)) && (val3(pool_pm1(2)) == pool_v3(2)) && (val3(pool_pm1(3)) == pool_v3(3))
    let ok4 = (pool_bits(0) == 17) && (pool_bits(1) == 17) && (pool_bits(2) == 20) && (pool_bits(3) == 21)
    let p0 = 65537
    let ok5 = (gf_mul_p(256, 256, p0) == 65536) && (gf_inv_p(2, p0) == 32769) && (gf_add_p(32768, 32768, p0) == 65536)
    let ok6 = select_domain(16, 16, 0) == 0
    let ok7 = select_domain(18, 18, 0) == 2
    let ok8 = select_domain(17, 1, 1) == 1
    let r0 = gf_pow_p(pool_g(0), pool_pm1(0), pool_p(0))
    let ok9 = r0 == 1
    let w0 = pool_ntt_root(0, 3)
    let w0_8 = gf_pow_p(w0, 8, p0)
    let ok10 = w0_8 == 1
    if ok1 && ok2 && ok3 && ok4 && ok5 && ok6 && ok7 && ok8 && ok9 && ok10
        1
    else
        0

let main() = prime_pool_verify()
