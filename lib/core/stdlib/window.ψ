let normalize(window) =
    let peak = 0
    let i = 0
    for i < window.len()
        let v = (window[i] < 0 ? -window[i] : window[i])
        if v > peak
            peak = v
        i = i + 1
    if peak == 0
        window
    else
        let result = []
        let i = 0
        for i < window.len()
            result = arr_concat(result, [window[i] * 1000 / peak])
            i = i + 1
        result

let apply_window(signal, window) =
    let result = []
    let i = 0
    for i < signal.len()
        result = arr_concat(result, [signal[i] * window[i] / 1000])
        i = i + 1
    result

