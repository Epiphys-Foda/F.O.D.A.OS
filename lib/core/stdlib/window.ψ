let hamming(n) =
    let result = []
    let i = 0
    for i < n
        let x2 = 2 * 314159 * i / ((n - 1) * 100000)
        let cos_val = 1000 - x2 * x2 / 2000
        let w = 540 - 460 * cos_val / 1000
        result = arr_concat(result, [w])
        i = i + 1
    result

let blackman(n) =
    let result = []
    let i = 0
    for i < n
        let x2 = 2 * 314159 * i / ((n - 1) * 100000)
        let cos1 = 1000 - x2 * x2 / 2000
        let x4 = 4 * 314159 * i / ((n - 1) * 100000)
        let cos2 = 1000 - x4 * x4 / 2000
        let w = 420 - 500 * cos1 / 1000 + 80 * cos2 / 1000
        result = arr_concat(result, [w])
        i = i + 1
    result

let triangular(n) =
    let result = []
    let i = 0
    for i < n
        let w = 2 * i * 1000 / (n - 1)
        if w > 1000
            w = 2000 - w
        result = arr_concat(result, [w])
        i = i + 1
    result

let rectangular(n) =
    let result = []
    let i = 0
    for i < n
        result = arr_concat(result, [1000])
        i = i + 1
    result

let gaussian(n, sigma) =
    let result = []
    let center = n / 2
    let i = 0
    for i < n
        let d = i - center
        let arg = d * d * 1000000 / (2 * sigma * sigma / 1000)
        let exp_val = 1000
        if arg < 1000
            exp_val = 1000 - arg
            let arg2 = arg * arg / 1000
            exp_val = exp_val + arg2 / 2
            let arg3 = arg2 * arg / 1000
            exp_val = exp_val - arg3 / 6
        if exp_val < 0
            exp_val = 0
        result = arr_concat(result, [exp_val])
        i = i + 1
    result

let kaiser(n, beta) =
    let result = []
    let i = 0
    for i < n
        let t = 2 * i / n - 1
        let t2 = t * t / 1000
        let arg2 = 1000 - t2
        if arg2 < 0
            result = arr_concat(result, [0])
        else
            let w = 1000 - t2 * 500 / 1000
            result = arr_concat(result, [w])
        i = i + 1
    result

let flat_top(n) =
    let result = []
    let a0 = 215
    let a1 = 416
