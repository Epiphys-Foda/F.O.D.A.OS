let deopt_new(reason, frame) =
    [reason, frame]

let spec_guard(expected, actual) =
    (expected == actual ? 1 : 0)

let ir_new() =
    [[], 0]

let ir_add(ir, op, args) =
    let id = ir[1]
    ir[0] = arr_concat(ir[0], [[id, op, args]])
    ir[1] = ir[1] + 1
    id

let ir_get(ir, id) =
    ir[0][id]

let ir_count(ir) =
    ir[1]

