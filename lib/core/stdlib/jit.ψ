let bytecode_new() =
    [[], 0]

let bytecode_emit(bc, opcode, operand) =
    bc[0] = arr_concat(bc[0], [[opcode, operand]])
    bc[1] = bc[1] + 1

let bytecode_emit_op(bc, opcode) =
    bytecode_emit(bc, opcode, 0)

let bytecode_size(bc) =
    bc[1]

let bytecode_get(bc, index) =
    bc[0][index]

let inline_cache_new() =
    [0, 0, 0]

let inline_cache_record(cache, shape) =
    if cache[0] == 0
        cache[0] = shape
        cache[1] = 1
    else
        0
    if cache[0] == shape
        cache[1] = cache[1] + 1
    else
        cache[1] = 0

let inline_cache_hit(cache, shape) =
    cache[0] == shape && cache[1] > 0

let tier_new(threshold, compiler) =
    [threshold, compiler, 0, 0]

let tier_record_call(tier) =
    tier[2] = tier[2] + 1
    if tier[2] >= tier[0] && tier[3] == 0
        tier[3] = 1
        1
    else
        0

let tier_should_compile(tier) =
    tier[2] >= tier[0] && tier[3] == 0

let tier_is_compiled(tier) =
    tier[3]

let profiler_new() =
    [{}, {}, []]

let profiler_record(prof, method, time) =
    let count = prof[0][method]
    if count == 0
        count = 1
    else
        count = count + 1
    prof[0][method] = count
    let total_time = prof[1][method]
    if total_time == 0
        total_time = time
    else
        total_time = total_time + time
    prof[1][method] = total_time

