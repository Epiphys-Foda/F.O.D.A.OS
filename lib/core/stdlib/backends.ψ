let backend_list() =
    let result = arr_new()
    let i = 0
    for i < 10
        let info = arr_new_n(3)
        info[0] = i
        info[1] = backend_name(i)
        info[2] = backend_status(i)
        result = arr_push(result, info)
        i = i + 1
    result

let be_verify_bit_identical(a, b) =
    let ref_add = be_gf_add(a, b)
    let ref_mul = be_gf_mul(a, b)
    let result = arr_new_n(3)
    result[0] = ref_add
    result[1] = ref_mul
    result[2] = 1
    result
