let X86_ADD_EAX = 1
let X86_IMUL_EAX = 105
let X86_MOV_EAX = 184
let X86_RET = 195
let X86_PUSH = 80
let X86_POP = 88

let be_x86_emit_int(val) =
    let code = arr_new()
    code = arr_push(code, X86_MOV_EAX)
    code = arr_push(code, val & 255)
    code = arr_push(code, (val >> 8) & 255)
    code = arr_push(code, (val >> 16) & 255)
    code = arr_push(code, (val >> 24) & 255)
    code

let be_x86_emit_add() =
    let code = arr_new()
    code = arr_push(code, X86_ADD_EAX)
    code

