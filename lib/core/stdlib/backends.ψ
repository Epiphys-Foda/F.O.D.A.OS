let BE_P = 65537

let be_gf_add(a, b) =
    let s = a + b
    (s >= BE_P ? s - BE_P : s)

let be_gf_sub(a, b) =
    let d = a - b
    (d < 0 ? d + BE_P : d)

let be_gf_mul(a, b) = (a * b) % BE_P

