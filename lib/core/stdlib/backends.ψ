    code = arr_push(code, X86_RET)
    code

let be_arm64_emit_int(val) =
    let code = arr_new()
    let lo = (val & 65535) << 5
    code = arr_push(code, lo & 255)
    code = arr_push(code, (lo >> 8) & 255)
    code = arr_push(code, 128)
    code = arr_push(code, 210)
    code

