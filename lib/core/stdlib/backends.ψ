let be_riscv_emit_int(val) =
    let code = arr_new()
    let imm12 = val & 4095
    let instr_lo = imm12 << 20
    code = arr_push(code, instr_lo & 255)
    code = arr_push(code, (instr_lo >> 8) & 255)
    code = arr_push(code, (instr_lo >> 16) & 255)
    code = arr_push(code, (instr_lo >> 24) & 255)
    code

