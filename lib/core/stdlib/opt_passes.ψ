let _dce_unfold_else(stmts, new_stmts, next_i, n, block, j, block_n) =
    if j >= block_n
      _dce_stmts_acc(stmts, new_stmts, next_i, n, 0)
    _dce_unfold_else(stmts, arr_push(new_stmts, arr_get(block, j)), next_i, n, block, j + 1, block_n)

