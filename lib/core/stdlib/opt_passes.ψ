let _is_power_of_2(n) =
    if n <= 0
        0 - 1
    if n == 1
        0
    _pow2_acc(n, 0)
let _pow2_acc(n, k) =
    if n == 1
        k
    if (n & 1) == 1
        0 - 1
    _pow2_acc(n >> 1, k + 1)

let opt_strength_reduce_expr(node) =
    if node == 0
        0
    let t = node[0]
    if t == 3
        let op = node[1]
        let left = opt_strength_reduce_expr(node[2])
        let right = opt_strength_reduce_expr(node[3])
        if op == 42
            if right[0] == 0
                let k = _is_power_of_2(right[1])
                if k >= 1
                    let shift_node = arr_new_n(4)
                    shift_node[0] = 3
                    shift_node[1] = 60
                    shift_node[2] = left
                    shift_node[3] = mk_int(k)
                    shift_node
                if right[1] == 1
                    left
                if right[1] == 0
                    mk_int(0)
        if op == 47
            if right[0] == 0
                let k = _is_power_of_2(right[1])
                if k >= 1
                    let shift_node = arr_new_n(4)
                    shift_node[0] = 3
                    shift_node[1] = 62
                    shift_node[2] = left
                    shift_node[3] = mk_int(k)
                    shift_node
        if op == 43 || op == 45
            if right[0] == 0
                if right[1] == 0
                    left
        if op == 45
            if left[0] == 2
                if right[0] == 2
                    if str_equal(left[1], right[1]) == 1
                        mk_int(0)
        let new_node = arr_new_n(4)
        new_node[0] = 3
        new_node[1] = op
        new_node[2] = left
        new_node[3] = right
        new_node
    if t == 1
        _sr_call_args(node, node[1], node[2], arr_new(), 0, arr_len(node[2]))
    if t == 12
        let cond = opt_strength_reduce_expr(node[1])
        let then_n = opt_strength_reduce_expr(node[2])
        let els_n = opt_strength_reduce_expr(node[3])
        let new_node = arr_new_n(4)
        new_node[0] = 12
        new_node[1] = cond
        new_node[2] = then_n
        new_node[3] = els_n
        new_node
    node
let _sr_call_args(orig, name, args, new_args, i, n) =
    if i >= n
