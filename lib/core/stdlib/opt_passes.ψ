let opt_deforest_expr(node) =
    if node == 0
        0
    let t = node[0]
    if t == 1
      let name = node[1]
      let args = node[2]

      if str_equal(name, "arr_map") == 1
        if arr_len(args) == 2
          let inner = arr_get(args, 1)
          if inner[0] == 1
            if str_equal(inner[1], "arr_map") == 1
              let f_name = arr_get(args, 0)[1]
              let g_name = arr_get(inner[2], 0)[1]
              let xs = arr_get(inner[2], 1)
              let new_args = arr_new_n(2)
              let f_var = arr_new_n(2)
              f_var[0] = 2
              f_var[1] = str_append(f_name, str_append("_", g_name))
              arr_set(new_args, 0, f_var)
              arr_set(new_args, 1, xs)
              let new_node = arr_new_n(3)
              new_node[0] = 1
              new_node[1] = "arr_map"
              new_node[2] = new_args
              new_node

      if str_equal(name, "arr_len") == 1
        if arr_len(args) == 1
          let inner = arr_get(args, 0)
          if inner[0] == 1
            if str_equal(inner[1], "arr_map") == 1
              let xs = arr_get(inner[2], 1)
              let new_args = arr_new_n(1)
              arr_set(new_args, 0, xs)
              let new_node = arr_new_n(3)
              new_node[0] = 1
              new_node[1] = "arr_len"
              new_node[2] = new_args
              new_node
    node

