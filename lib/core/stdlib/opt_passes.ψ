let opt_gf_rewrite_expr(node) =
    if node == 0
        0
    let t = node[0]
    if t == 3
      let op = node[1]
      let left = opt_gf_rewrite_expr(node[2])
      let right = opt_gf_rewrite_expr(node[3])

      if op == 42
        if right[0] == 0
          if right[1] == 1
              left
          if right[1] == 0
              mk_int(0)
      if op == 43 || op == 45
        if right[0] == 0
          if right[1] == 0
              left
      if op == 42
        if left[0] == 2
          if right[0] == 2
            if str_equal(left[1], right[1]) == 1
              let args = arr_new_n(1)
              arr_set(args, 0, left)
              let call = arr_new_n(3)
              call[0] = 1
              call[1] = "math_sqr"
              call[2] = args
              call

      let new_node = arr_new_n(4)
      new_node[0] = 3
      new_node[1] = op
      new_node[2] = left
      new_node[3] = right
      new_node
    if t == 1
      let name = node[1]
      if str_equal(name, "gf_mul") == 1
        let args = node[2]
        if arr_len(args) == 2
          let right = arr_get(args, 1)
          if right[0] == 0
            if right[1] == 1
                arr_get(args, 0)
            if right[1] == 0
                mk_int(0)
      _gf_rewrite_call_args(node, name, node[2], arr_new(), 0, arr_len(node[2]))
    node

