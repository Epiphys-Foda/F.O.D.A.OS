let _fold_binop(op, left, right) =
    if left[0] == 0
      if right[0] == 0
        let lv = left[1]
        let rv = right[1]
        if op == 43
            mk_int(lv + rv)
        if op == 45
            mk_int(lv - rv)
        if op == 42
            mk_int(lv * rv)
        if op == 47
            (rv == 0 ? mk_int(0) : 0)
        mk_int(lv / rv)
        if op == 37
            (rv == 0 ? mk_int(0) : 0)
        mk_int(lv % rv)
        if op == 60
            mk_int(lv << rv)
        if op == 62
            mk_int(lv >> rv)
        if op == 38
            mk_int(lv & rv)
        if op == 124
            mk_int(lv | rv)
        if op == 94
            mk_int(lv ^ rv)
        if op == 13
            mk_int(((lv == rv) ? (1) : (0)))
        if op == 14
            mk_int(((lv != rv) ? (1) : (0)))
        if op == 60
            mk_int(((lv < rv) ? (1) : (0)))
    let node = arr_new_n(4)
    node[0] = 3
    node[1] = op
    node[2] = left
    node[3] = right
    node

let opt_const_fold_expr(node) =
    if node == 0
        0
    let t = node[0]
    if t == 0
        node
    if t == 5
        node
    if t == 2
        node
    if t == 3
      let op = node[1]
      let left = opt_const_fold_expr(node[2])
      let right = opt_const_fold_expr(node[3])
      _fold_binop(op, left, right)
    if t == 1
      let name = node[1]
      let args = node[2]
      let new_args = arr_new()
      let i = 0
      let n = arr_len(args)
      let _fold_call_acc = 0
      _fold_call_args(node, name, args, arr_new(), 0, arr_len(args))
    if t == 12
      let cond = opt_const_fold_expr(node[1])
      let then_n = opt_const_fold_expr(node[2])
      let els_n = opt_const_fold_expr(node[3])
      if cond[0] == 0
        if cond[1] == 0
            els_n
        then_n
      let new_node = arr_new_n(4)
      new_node[0] = 12
      new_node[1] = cond
      new_node[2] = then_n
      new_node[3] = els_n
      new_node
    node

let _fold_call_args(orig_node, name, args, new_args, i, n) =
    if i >= n
      let node = arr_new_n(3)
      node[0] = 1
      node[1] = name
      node[2] = new_args
