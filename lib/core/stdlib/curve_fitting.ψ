let power_fit(xs, ys) =
    let log_xs = []
    let log_ys = []
    let i = 0
    for i < xs.len()
        if xs[i] > 0 && ys[i] > 0
            let x = xs[i]
            let lx = 0
            for x > 1
                x = x / 2
                lx = lx + 1
            log_xs = arr_concat(log_xs, [lx])
            let y = ys[i]
            let ly = 0
            for y > 1
                y = y / 2
                ly = ly + 1
            log_ys = arr_concat(log_ys, [ly])
        else
            log_xs = arr_concat(log_xs, [0])
            log_ys = arr_concat(log_ys, [0])
        i = i + 1
    let lr = linear_regression(log_xs, log_ys)
    [lr[0], lr[1]]

let moving_average(data, window) =
    let result = []
    let i = 0
    for i < data.len()
        let sum = 0
        let count = 0
        let j = i - window / 2
        for j <= i + window / 2
            if j >= 0 && j < data.len()
                sum = sum + data[j]
                count = count + 1
            j = j + 1
        result = arr_concat(result, [sum / count])
        i = i + 1
    result

let weighted_least_squares(xs, ys, weights) =
    let sw = 0
    let swx = 0
    let swy = 0
    let swxy = 0
    let swx2 = 0
    let i = 0
    for i < xs.len()
        let w = weights[i]
        sw = sw + w
        swx = swx + w * xs[i]
        swy = swy + w * ys[i]
        swxy = swxy + w * xs[i] * ys[i]
        swx2 = swx2 + w * xs[i] * xs[i]
        i = i + 1
    let denom = sw * swx2 - swx * swx
    if denom == 0
        [0, 0]
    else
        let b = (sw * swxy - swx * swy) / denom
        let a = (swy - b * swx) / sw
        [a, b]

