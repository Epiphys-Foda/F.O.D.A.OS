let save_lexer_arc(input_str, path) =
    let code = build_lexer_code()
    let bytes = str_bytes(input_str)
    let terminated = bytes.push(0)
    let full_code = [code, terminated].flat()
    arc_save(full_code, 0, path)

let run_lexer(input_str) =
    let code = build_lexer_code()
    let bytes = str_bytes(input_str)
    let terminated = bytes.push(0)
    let full_code = [code, terminated].flat()
    arc_exec(full_code, 0, 0)
