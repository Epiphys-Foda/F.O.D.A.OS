      let ed = false
      for !ed
        if ei < en
          let e = dag.edges[ei]
          let s = e.src_node
          let t = e.dst_node
          let cand = depth[s] + 1
          if cand > depth[t]
            depth = [depth.slice(0, t).push(cand).flat(), depth.slice(t + 1, len(depth))].flat()
            changed = true
          else
            0
          ei = ei + 1
        else
          ed = true
          0
        0
    let mx = 0
    let mi = 0
    let mn = len(depth)
    let md = false
    for !md
      if mi < mn
        if depth[mi] > mx
          mx = depth[mi]
        else
          0
        mi = mi + 1
      else
        md = true
    mx

let sched_parallelism_profile(dag) =
    let depth = sched_depth_arr(dag)
    let max_depth = sched_critical_path(dag)
    let profile = []
    let k = 1
    let done = false
    for !done
      if k <= max_depth
        let layer = sched_layer_nodes(dag, depth, k)
        profile = profile.push(len(layer))
        k = k + 1
      else
        done = true
    profile

