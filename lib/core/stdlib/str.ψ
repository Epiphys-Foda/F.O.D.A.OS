

import "arr.ψ"

let str_len(s) = arr_len(s)
let str_get(s, i) = arr_get(s, i)
let str_slice_from(s, start) = arr_slice_from(s, start)
let str_slice_to(s, end) = arr_slice_to(s, end)
let str_slice(s, start, end) = sa_slice(s, start, end)
let str_reverse(s) = arr_reverse(s)
let str_append(s1, s2) = arr_concat(s1, s2)
let str_from_char(c) =
    let s = arr_new_n(1)
    arr_set(s, 0, c)
    s

let _str_to_int_acc(s, i, n, result, started, neg) =
    if i >= n
        result * ((neg != 0) ? (0 - 1) : 1)
    else
        let c = arr_get(s, i)
        if started
            if c >= 48 && c <= 57
                _str_to_int_acc(s, i + 1, n, result * 10 + c - 48, 1, neg)
            else
                result * ((neg != 0) ? (0 - 1) : 1)
        else
            if c == 32
                _str_to_int_acc(s, i + 1, n, 0, 0, 0)
            else
                if c == 45
                    _str_to_int_acc(s, i + 1, n, 0, 1, 1)
                else
                    if c == 43
                        _str_to_int_acc(s, i + 1, n, 0, 1, 0)
                    else
                        if c >= 48 && c <= 57
                            _str_to_int_acc(s, i + 1, n, result * 10 + c - 48, 1, 0)
                        else
                            0
let str_to_int(s) = _str_to_int_acc(s, 0, arr_len(s), 0, 0, 0)

let str_contains(s, sub) =
    (str_find(s, sub) != -1 ? 1 : 0)

let _str_match_at(s, sub, i, m, offset) =
    if i >= m
        1
    else
        if arr_get(s, offset + i) != arr_get(sub, i)
            0
        else
            _str_match_at(s, sub, i + 1, m, offset)
let str_starts_with(s, prefix) =
    let m = arr_len(prefix)
    if m > arr_len(s)
        0
    else
        _str_match_at(s, prefix, 0, m, 0)
let str_ends_with(s, suffix) =
    let n = arr_len(s)
    let m = arr_len(suffix)
    if m > n
        0
    else
        _str_match_at(s, suffix, 0, m, n - m)

let _str_case_acc(src, dst, i, n, to_upper) =
    if i >= n
        dst
    else
        let c = arr_get(src, i)
        let nc = (to_upper == 1 ? (c >= 97 && c <= 122 ? c - 32 : c) : (c >= 65 && c <= 90 ? c + 32 : c))
        arr_set(dst, i, nc)
        _str_case_acc(src, dst, i + 1, n, to_upper)
let str_to_lower(s) = _str_case_acc(s, arr_new_n(arr_len(s)), 0, arr_len(s), 0)
let str_to_upper(s) = _str_case_acc(s, arr_new_n(arr_len(s)), 0, arr_len(s), 1)

let _str_is_space(c) = (c == 32 || c == 9 || c == 10 || c == 13) ? 1 : 0
let str_equal(s1, s2) = arr_equal(s1, s2)
let str_char_at(s, i) = arr_get(s, i)
let str_is_digit(c) =
    (c >= 48 && c <= 57 ? 1 : 0)
let str_is_alpha(c) =
    ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) ? 1 : 0)
let str_is_space(c) = _str_is_space(c)
let str_chars(s) = sa_slice(s, 0, arr_len(s))

let str_capitalize(s) =
    let n = arr_len(s)
    if n == 0
        s
    else
        let c = arr_get(s, 0)
        let upper_c = (c >= 97 && c <= 122) ? (c - 32) : c
        let head = arr_new_n(1)
        arr_set(head, 0, upper_c)
        arr_concat(head, sa_slice(s, 1, n))

let str_layer_id() = 79
let str_module_count() = 28

let test_str_layer() =
    let s1 = str_from_char(49)
    let s1b = str_from_char(50)
    let s1c = str_from_char(51)
    let s1d = str_from_char(52)
    let s1e = str_from_char(53)
    let s = str_append(str_append(str_append(str_append(s1, s1b), s1c), s1d), s1e)
    assert_eq(str_len(s), 5)
    assert_eq(str_get(s, 0), 49)
    assert_eq(str_get(s, 4), 53)
    assert_eq(str_to_int(s), 12345)
    let neg_s = str_append(str_from_char(45), s)
    assert_eq(str_to_int(neg_s), -12345)
    let sf = str_slice_from(s, 2)
    assert_eq(str_len(sf), 3)
    assert_eq(str_get(sf, 0), 51)
    let st = str_slice_to(s, 3)
    assert_eq(str_len(st), 3)
    assert_eq(str_get(st, 0), 49)
    let ss = str_slice(s, 1, 4)
    assert_eq(str_len(ss), 3)
    assert_eq(str_get(ss, 0), 50)
    let rev = str_reverse(s)
    assert_eq(str_len(rev), 5)
    assert_eq(str_get(rev, 0), 53)
    assert_eq(str_get(rev, 4), 49)
    let sub = str_slice(s, 1, 4)
    assert_eq(str_find(s, sub), 1)
    assert_eq(str_contains(s, sub), 1)
    let nope = str_from_char(57)
    assert_eq(str_find(s, nope), -1)
    assert_eq(str_contains(s, nope), 0)
    assert_eq(str_starts_with(s, str_slice_to(s, 2)), 1)
    assert_eq(str_ends_with(s, str_slice_from(s, 3)), 1)
    assert_eq(str_starts_with(s, str_from_char(57)), 0)
    let upper = str_from_char(65)
    let lower = str_to_lower(upper)
    assert_eq(str_get(lower, 0), 97)
    let upper_back = str_to_upper(lower)
    assert_eq(str_get(upper_back, 0), 65)
    let spaces = str_from_char(32)
    let padded = str_append(str_append(spaces, s), spaces)
    let trimmed = str_trim(padded)
    assert_eq(str_len(trimmed), 5)
    assert_eq(str_get(trimmed, 0), 49)
    let old_sub = str_slice(s, 1, 3)
    let new_sub = str_from_char(88)
    let replaced = str_replace(s, old_sub, new_sub)
    assert_eq(str_len(replaced), 4)
    assert_eq(str_get(replaced, 0), 49)
    assert_eq(str_get(replaced, 1), 88)
    assert_eq(str_get(replaced, 2), 52)
    assert_eq(str_get(replaced, 3), 53)
    let sep = str_from_char(50)
    let parts = str_split(s, sep)
    assert_eq(arr_len(parts), 2)
    let p0 = arr_get(parts, 0)
    assert_eq(str_len(p0), 1)
    assert_eq(str_get(p0, 0), 49)
    let p1 = arr_get(parts, 1)
    assert_eq(str_len(p1), 3)
    assert_eq(str_get(p1, 0), 51)
    let joined = str_join(parts, str_from_char(45))
    assert_eq(str_len(joined), 5)
    assert_eq(str_get(joined, 0), 49)
    assert_eq(str_get(joined, 1), 45)
    assert_eq(str_get(joined, 2), 51)
    assert_eq(str_equal(s, str_append(s, str_from_char(0))), 0)
    assert_eq(str_equal(s, arr_copy(s)), 1)
    assert_eq(str_char_at(s, 0), 49)
    assert_eq(str_is_digit(49), 1)
    assert_eq(str_is_digit(65), 0)
    assert_eq(str_is_alpha(65), 1)
    assert_eq(str_is_alpha(97), 1)
    assert_eq(str_is_alpha(48), 0)
    assert_eq(str_is_space(32), 1)
    assert_eq(str_is_space(48), 0)
    assert_eq(str_layer_id(), 79)
    assert_eq(str_module_count(), 24)
    0

