let opt_omega_pows(w, L, p) =
    let tbl = [1]
    let i = 1
    let done = false
    for !done
      if i < L
        let prev = tbl[i - 1]
        tbl = tbl.push((prev * w) % p)
        i = i + 1
      else
        done = true
    tbl

