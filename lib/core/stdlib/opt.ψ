    let k = 0
    let kdone = false
    for !kdone
      if k < 8
        let acc = 0
        let i = 0
        let idone = false
        for !idone
          if i < 8
            let e = (k * i) % 8
            let term = (sig[i] * wtbl[e]) % p
            acc = acc + term
            i = i + 1
          else
            idone = true
        out = out.push(acc % p)
        k = k + 1
      else
        kdone = true
    out

