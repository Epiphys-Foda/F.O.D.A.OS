let opt_mod_pow(a, b, p) =
    let base = a
    let exp = b
    let acc = 1
    let done = false
    for !done
      if exp > 0
        if exp % 2 == 1
          acc = (acc * base) % p
        else
          0
        base = (base * base) % p
        exp = exp / 2
      else
        done = true
    acc

let opt_gcd(a, b) =
    let x = a
    let y = b
    let done = false
    for !done
      if y != 0
        let t = x % y
        x = y
        y = t
      else
        done = true
    if x < 0
      0 - x
    else
      x

let opt_inv(a, m) =
    let old_r = a
    let r = m
    let old_s = 1
    let s = 0
    let done = false
    for !done
      if r != 0
        let q = old_r / r
        let tr = old_r - q * r
        old_r = r
        r = tr
        let ts = old_s - q * s
        old_s = s
        s = ts
      else
        done = true
    if old_r == 1
      if old_s < 0
        old_s + m
      else
        old_s
    else
      0

let opt_dist(v, c, p) =
    if v >= c
      if v - c > (p - 1) / 2
        p - (v - c)
      else
        v - c
    else
      if v - c + p > (p - 1) / 2
        p - (v - c + p)
      else
        v - c + p

