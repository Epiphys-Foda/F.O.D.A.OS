let opt_barrett_k(p) =
    if p == 65537
      34
    else
      if p == 786433
        40
      else
        if p == 1376257
          42
        else
          0

let opt_barrett_mul(a, b, p) =
    let mu = opt_barrett_mu(p)
    let k = opt_barrett_k(p)
    let x = a * b
    let q = (x * mu) / opt_pow2k(k)
    let r = x - q * p
    if r >= p
      r - p
    else
      r

