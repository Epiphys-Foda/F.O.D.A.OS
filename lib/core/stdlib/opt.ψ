              if m % d == 0
                m = m / d
                cnt = cnt + 1
              else
                cd = true
            if cnt >= 2
              square = true
            else
              0
            k = k + 1
          else
            0
          d = d + 1
        else
          done = true
      if m > 1
        k = k + 1
