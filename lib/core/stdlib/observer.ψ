let run_fp() =
    let subject = [[], 0]
    let i = 0
    for i < 4
        subject[0] = arr_push(subject[0], i + 1)
        i = i + 1
    let collector = [0]
    let acc = 7
    let k = 0
    for k < 16
        let event_val = k * 3
        let m = 0
        for m < len(subject[0])
            obs_dispatch(subject[0][m], event_val, collector)
            m = m + 1
        acc = (acc + (event_val + 2) * (k + 1)) % P
        k = k + 1
    (acc + collector[0]) % P

let v_det() =
    let f1 = run_fp()
    let f2 = run_fp()
    let a = 1
    if f1 != f2
        a = 0
    if f1 == 0
        a = 0
    a

