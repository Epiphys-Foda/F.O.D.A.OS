let emitter_on(emitter, event_id, handler_id) =
    emitter[0] = arr_push(emitter[0], event_id)
    emitter[1] = arr_push(emitter[1], handler_id)
    emitter

let emitter_emit(emitter, event_id, data, collector) =
    let n = len(emitter[0])
    let count = 0
    let i = 0
    for i < n
        if emitter[0][i] == event_id
            obs_dispatch(emitter[1][i], data, collector)
            count = count + 1
        i = i + 1
    count

let v_emitter() =
    let em = [[], []]
    em = emitter_on(em, 1, 1)
    em = emitter_on(em, 1, 3)
    em = emitter_on(em, 2, 2)
    let col1 = [0]
