let v_unsub() =
    let subject = [[], 0]
    let i = 0
    for i < 3
        subject[0] = arr_concat(subject[0], [i + 1])
        i = i + 1
    let new_obs = []
    let j = 0
    for j < 3
        if j != 1
            new_obs = arr_concat(new_obs, [subject[0][j]])
        j = j + 1
    subject[0] = new_obs
    let a = 1
    if len(subject[0]) != 2
        a = 0
    let collector = [0]
    let m = 0
    for m < 2
        obs_dispatch(subject[0][m], 7, collector)
        m = m + 1
    if collector[0] != 7
