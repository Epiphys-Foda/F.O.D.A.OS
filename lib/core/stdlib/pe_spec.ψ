  { pe: 2, name: "PE_LUT", x86: [89, 58, 72, 247, 208, 80], wasm: [65, 127, 115], wgsl: "~vA", quantum: "ORACLE", qubits: 8, backend: "simd", fuse: "-" },
  { pe: 3, name: "PE_FFT", x86: [89, 58, 72, 137, 194, 72, 1, 194, 72, 41, 193, 72, 9, 200, 80], wasm: [33, 8, 33, 9, 32, 8, 32, 9, 106, 32, 8, 32, 9, 107, 114], wgsl: "(vA + vB) | (vA - vB)", quantum: "QFT", qubits: 8, backend: "gpu", fuse: "FFT+ADD→1004" },
  { pe: 4, name: "PE_FIFO", x86: [89, 58, 80, 80], wasm: [], wgsl: "vA", quantum: "REG_CHAIN", qubits: 1, backend: "io", fuse: "FIFO+ROUTE→1005" },
  { pe: 5, name: "PE_ROUTE", x86: [89, 58, 80, 80], wasm: [], wgsl: "vA", quantum: "SWAP_NET", qubits: 2, backend: "io", fuse: "FIFO+ROUTE→1005" },
  { pe: 6, name: "PE_ALU", x86: [89, 58, 72, 1, 200, 80], wasm: [106], wgsl: "vA + vB", quantum: "ALU_Q", qubits: 3, backend: "simd", fuse: "LT+ADD→1003" },
  { pe: 16, name: "PE_TOKEN", x86: [104], wasm: [65], wgsl: "IMMu", quantum: "PREPARE", qubits: 8, backend: "io", fuse: "-" },
  { pe: 17, name: "PE_EMIT", x86: [144], wasm: [], wgsl: "result = vA", quantum: "MEASURE", qubits: 1, backend: "io", fuse: "-" }
]

let pe_spec(pe_type) =
    let found = null
    let i = 0
    let n = len(PE_SPEC_TABLE)
    let done = false
    for !done
      if i < n
        let row = PE_SPEC_TABLE[i]
        if row.pe == pe_type
          found = row
          done = true
        else
          i = i + 1
      else
        done = true
    found

let pe_x86(pe_type) =
    let row = pe_spec(pe_type)
    (row == null ? [] : row.x86)

let pe_wasm(pe_type) =
    let row = pe_spec(pe_type)
    (row == null ? [] : row.wasm)

let pe_wgsl(pe_type, out, a, b) =
    let row = pe_spec(pe_type)
    if row == null
      ""
    else
      let t = row.wgsl
      let v = "v".concat(str(out))
      let a2 = "v".concat(str(a))
      let b2 = "v".concat(str(b))
      "let ".concat(v).concat(" = ").concat(t).concat(";")

let pe_quantum(pe_type) =
    let row = pe_spec(pe_type)
    (row == null ? "UNKNOWN" : row.quantum)

let pe_qubits(pe_type) =
    let row = pe_spec(pe_type)
    (row == null ? 0 : row.qubits)

let pe_backend(pe_type) =
    let row = pe_spec(pe_type)
    (row == null ? "unknown" : row.backend)

let pe_spec_count() = len(PE_SPEC_TABLE)
