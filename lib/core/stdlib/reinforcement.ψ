let q_table_new(n_states, n_actions) =
    let q = []
    let i = 0
    for i < n_states * n_actions
        q = arr_concat(q, [0])
        i = i + 1
    q

let q_learning_update(q, state, action, reward, next_state, alpha, gamma, n_actions) =
    let max_next = 0
    let a = 0
    for a < n_actions
        if q[next_state * n_actions + a] > max_next
            max_next = q[next_state * n_actions + a]
        a = a + 1
    let current = q[state * n_actions + action]
    let td_error = reward + gamma * max_next / 1000 - current
    q[state * n_actions + action] = current + alpha * td_error / 1000
    q

let sarsa_update(q, state, action, reward, next_state, next_action, alpha, gamma) =
    let current = q[state * n_actions + action]
    let next_q = q[next_state * n_actions + next_action]
    let td_error = reward + gamma * next_q / 1000 - current
    q[state * n_actions + action] = current + alpha * td_error / 1000
    q

let epsilon_greedy(q, state, n_actions, epsilon, seed) =
    let s = (seed * 1103515245 + 12345) % 2147483648
    let action = 0
    if s % 1000 < epsilon
        s = (s * 1103515245 + 12345) % 2147483648
        action = s % n_actions
    else
        let best_val = -999999999
        let a = 0
        for a < n_actions
            let val = q[state * n_actions + a]
            if val > best_val
                best_val = val
                action = a
            a = a + 1
    [action, s]

let td_lambda_update(q, eligibility, state, action, reward, next_state, alpha, gamma, lambda_val, n_actions) =
    let i = 0
    for i < eligibility.len()
        eligibility[i] = gamma * lambda_val * eligibility[i] / 1000000
        i = i + 1
    eligibility[state * n_actions + action] = eligibility[state * n_actions + action] + 1
    let max_next = 0
    let a = 0
    for a < n_actions
        if q[next_state * n_actions + a] > max_next
            max_next = q[next_state * n_actions + a]
        a = a + 1
    let td_error = reward + gamma * max_next / 1000 - q[state * n_actions + action]
    let i = 0
    for i < q.len()
        q[i] = q[i] + alpha * td_error * eligibility[i] / 1000000
        i = i + 1
    [q, eligibility]

let policy_evaluation(transitions, rewards, gamma, n_states, n_actions, max_iter) =
    let values = []
    let i = 0
    for i < n_states
        values = arr_concat(values, [0])
        i = i + 1
    let iter = 0
    for iter < max_iter
        let new_values = []
        let s = 0
        for s < n_states
            let v = rewards[s]
            let s2 = 0
            for s2 < n_states
                v = v + gamma * transitions[s * n_states + s2] * values[s2] / 1000000
                s2 = s2 + 1
            new_values = arr_concat(new_values, [v])
            s = s + 1
        values = new_values
        iter = iter + 1
    values

let sarsa_episode(q, env_step, n_states, n_actions, alpha, gamma, epsilon, max_steps, seed) =
    let s = seed
    let state = 0
    let sel = epsilon_greedy(q, state, n_actions, epsilon, s)
    let action = sel[0]
    s = sel[1]
    let step = 0
    for step < max_steps
        let env_result = env_step(state, action)
        let next_state = env_result[0]
        let reward = env_result[1]
        let done = env_result[2]
        let next_sel = epsilon_greedy(q, next_state, n_actions, epsilon, s)
        let next_action = next_sel[0]
        s = next_sel[1]
        q = sarsa_update(q, state, action, reward, next_state, next_action, alpha, gamma)
        state = next_state
        action = next_action
        if done
            step = max_steps
        step = step + 1
    [q, s]

