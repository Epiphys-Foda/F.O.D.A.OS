let _op_dump_all_acc(table, i, n, out) =
    if i >= n
        out
    let spec = arr_get(table, i)
    let row = [spec.id, spec.name, spec.symbol]
    _op_dump_all_acc(table, i + 1, n, arr_push(out, row))

