let _op_find_by_id_acc(table, op_id, i, n) =
    let r = if i >= n
        null
    else
        let spec = arr_get(table, i)
        if spec.id == op_id
            spec
        else
            _op_find_by_id_acc(table, op_id, i + 1, n)
    r
let op_find_by_id(op_id) =
      let found = _op_find_by_id_acc(OPS, op_id, 0, arr_len(OPS))
      if found != null
        found
      else
        _op_find_by_id_acc(QUANTUM_OPS, op_id, 0, arr_len(QUANTUM_OPS))

let _op_find_by_name_acc(table, name, i, n) =
    let r = if i >= n
        null
    else
        let spec = arr_get(table, i)
        if spec.name == name
            spec
        else
            _op_find_by_name_acc(table, name, i + 1, n)
    r
let op_find_by_name(name) =
    _op_find_by_name_acc(OPS, name, 0, arr_len(OPS))

let op_find_quantum(name) =
    _op_find_by_name_acc(QUANTUM_OPS, name, 0, arr_len(QUANTUM_OPS))

let _op_filter_cat_acc(table, cat, i, n, out) =
    let r = if i >= n
        out
    else
        let spec = arr_get(table, i)
        let new_out = ((spec.category == cat) ? (arr_push(out, spec)) : (out))
        _op_filter_cat_acc(table, cat, i + 1, n, new_out)
    r
let op_filter_by_category(cat) =
    _op_filter_cat_acc(OPS, cat, 0, arr_len(OPS), [])

let _op_count_acc(table, i, n, acc) =
    let r = if i >= n
        acc
    else
        _op_count_acc(table, i + 1, n, acc + 1)
    r
let op_count() =
    let n1 = _op_count_acc(OPS, 0, arr_len(OPS), 0)
    let n2 = _op_count_acc(QUANTUM_OPS, 0, arr_len(QUANTUM_OPS), 0)
    n1 + n2

let op_arity(op_id) =
    let spec = op_find_by_id(op_id)
    (spec == null ? 0 - 1 : spec.arity)

let op_name(op_id) =
    let spec = op_find_by_id(op_id)
    (spec == null ? "?" : spec.name)

let op_symbol(op_id) =
