let _op_spec_find_idx(table, opcode) =
    let n = arr_len(table)
    let found = 0 - 1
    let i = 0
    for found == 0 - 1 && i < n
        let row = arr_get(table, i)
        if row.op == opcode
            found = i
        i = i + 1
    found

let _op_spec_row(table, opcode) =
    let i = _op_spec_find_idx(table, opcode)
    (i == 0 - 1 ? null : arr_get(table, i))

let op_micro(opcode) =
    let row = _op_spec_row(OP_SPEC_TABLE, opcode)
    (row == null ? 0 : row.micro)

let op_micros(opcode) =
    let row = _op_spec_row(OP_SPEC_TABLE, opcode)
    (row == null ? [] : row.micros)

let op_sig(opcode) =
    let row = _op_spec_row(OP_SPEC_TABLE, opcode)
