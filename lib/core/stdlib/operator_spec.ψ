let op_is_structural(op_id) =
    let spec = op_find_by_id(op_id)
    (spec == null ? 0 : ((spec.category == "struct") ? (1) : (0)))

let op_is_quantum_expansion(op_id) = ((op_id < 0 && op_id >= 0 - 5) ? (1) : (0))

