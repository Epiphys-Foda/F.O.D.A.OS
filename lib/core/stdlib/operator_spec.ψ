let op_eval(op_id, args) =
      if op_id == 65
        arr_get(args, 0)
      else
          if op_id == 32
            arr_get(args, 0)
          else
              if op_id == 106
                arr_get(args, 0) + arr_get(args, 1)
              else
                  if op_id == 107
                    arr_get(args, 0) - arr_get(args, 1)
                  else
                      if op_id == 108
                        arr_get(args, 0) * arr_get(args, 1)
                      else
                          if op_id == 109
                            let b = arr_get(args, 1)
                            if b == 0
                                0
                            else
                              let a = arr_get(args, 0)
                              a / b
                          else
                              if op_id == 111
                                let b = arr_get(args, 1)
                                if b == 0
                                    0
                                else
                                  let a = arr_get(args, 0)
                                  a - (a / b) * b
                              else
                                  if op_id == 113
                                    bit_and(arr_get(args, 0), arr_get(args, 1))
                                  else
                                      if op_id == 114
                                        bit_or(arr_get(args, 0), arr_get(args, 1))
                                      else
                                          if op_id == 115
                                            bit_xor(arr_get(args, 0), arr_get(args, 1))
                                          else
                                              if op_id == 116
                                                let c = arr_get(args, 1)
                                                bit_shl(arr_get(args, 0), c - (c / 32) * 32)
                                              else
                                                  if op_id == 117
                                                    let c = arr_get(args, 1)
                                                    bit_shr_s(arr_get(args, 0), c - (c / 32) * 32)
                                                  else
                                                      if op_id == 118
                                                        let c = arr_get(args, 1)
                                                        bit_shr_u(arr_get(args, 0), c - (c / 32) * 32)
                                                      else
                                                          if op_id == 70
                                                            ((arr_get(args, 0) == arr_get(args, 1)) ? (1) : (0))
                                                          else
                                                              if op_id == 71
                                                                ((arr_get(args, 0) != arr_get(args, 1)) ? (1) : (0))
                                                              else
                                                                  if op_id == 72
                                                                    ((arr_get(args, 0) < arr_get(args, 1)) ? (1) : (0))
                                                                  else
                                                                      if op_id == 74
                                                                        ((arr_get(args, 0) > arr_get(args, 1)) ? (1) : (0))
                                                                      else
                                                                          if op_id == 76
