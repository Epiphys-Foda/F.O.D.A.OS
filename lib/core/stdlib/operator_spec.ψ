let op_spec_count() = arr_len(OP_SPEC_TABLE)

let op_optimize(opcode, a, b) =
    if opcode == 1 && b == 1
        a
    if opcode == 1 && a == 1
        b
    if opcode == 3 && a == b
        0
    0 - 1

let _op_spec_arity(op_id) =
    let row = _op_spec_row(OP_SPEC_TABLE, op_id)
    (row == null ? 0 - 1 : row.arity)

