let _sin_quadrant(deg) =
    if deg <= MATH_DEG_Q1
        [1, deg]
    else
        if deg <= MATH_DEG_Q2
            [1, MATH_DEG_Q2 - deg]
        else
            if deg <= MATH_DEG_Q3
                [0 - 1, deg - MATH_DEG_Q2]
            else
                [0 - 1, MATH_DEG_FULL - deg]
let math_sin(deg) =
    let d = math_mod(math_mod(deg, MATH_DEG_FULL) + MATH_DEG_FULL, MATH_DEG_FULL)
    let q = _sin_quadrant(d)
    let sign = arr_get(q, 0)
    let abs_deg = arr_get(q, 1)
    sign * _sin_approx(abs_deg)
