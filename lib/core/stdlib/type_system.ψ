let lin_make(value) =
    let v = arr_new_n(2)
    arr_set(v, 0, value)
    arr_set(v, 1, 0)
    v

let lin_use(lv) =
    let count = arr_get(lv, 1)
    if count != 0
      0 - 1
    let value = arr_get(lv, 0)
    arr_set(lv, 1, 1)
    value

let lin_check_consumed(lv) = ((arr_get(lv, 1) != 0) ? (1) : (0))

let lin_dup_check(lvs) = _lin_dup_acc(lvs, 0, arr_len(lvs), 0)
let _lin_dup_acc(lvs, i, n, state) =
      if i >= n
          state
      let lv = arr_get(lvs, i)
      let consumed = lin_check_consumed(lv)
      if consumed == 0
        _lin_dup_acc(lvs, i + 1, n, ((state == 2) ? (2) : (1)))
      else
        _lin_dup_acc(lvs, i + 1, n, state)

