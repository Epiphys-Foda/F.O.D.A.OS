let dep_type_make(type_id, dim) =
    let v = arr_new_n(2)
    arr_set(v, 0, type_id)
    arr_set(v, 1, dim)
    v

let dep_type_id(t) = arr_get(t, 0)

let dep_type_dim(t) = arr_get(t, 1)

let DEP_TYPE_INT  = 0
let DEP_TYPE_ARR  = 1
let DEP_TYPE_VEC  = 2
let DEP_TYPE_MAT  = 3
let DEP_TYPE_FN   = 4

let dep_type_check(t, value) =
    let tid = dep_type_id(t)
    let dim = dep_type_dim(t)
    if tid == DEP_TYPE_INT
      1
    if tid == DEP_TYPE_ARR
      ((arr_len(value) == dim) ? (1) : (0))
    if tid == DEP_TYPE_VEC
      ((arr_len(value) == dim) ? (1) : (0))
    if tid == DEP_TYPE_MAT
      let rows = arr_len(value)
      ((rows > 0) ? (1) : (0))
    if tid == DEP_TYPE_FN
      1
    0

