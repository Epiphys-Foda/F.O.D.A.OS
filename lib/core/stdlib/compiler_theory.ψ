let SC7_DEFAULT_INLINE_THRESHOLD = 5

let sc7_inline_decision(body_size, threshold) = ((body_size <= threshold) ? (1) : (0))

let sc7_inline_benefit(body_size, call_overhead) = gf_sub(call_overhead, body_size)

let sc7_should_inline(body_size, call_overhead) = ((sc7_inline_benefit(body_size, call_overhead) > 0) ? (1) : (0))

let sc7_recursive_inline_check(call_depth) = ((call_depth == 0) ? (1) : (0))

let sc7_global_inline_optimal(sizes, overheads) =
    let n = arr_len(sizes)
    _sc7_global_acc(sizes, overheads, n, 0, 0)
let _sc7_global_acc(sizes, overheads, n, i, count) =
    if i >= n
        count
    let size = arr_get(sizes, i)
    let oh = arr_get(overheads, i)
    let new_count = ((sc7_should_inline(size, oh) == 1) ? (count + 1) : (count))
    _sc7_global_acc(sizes, overheads, n, i + 1, new_count)

let sc7_inline_proof_terminates() = 1

let sc7_inline_size_bound(n_funcs, max_body) = gf_mul(n_funcs, max_body)

let sc8_regex_make_empty() = 1

let sc8_regex_make_char(c) = c

let sc8_regex_union(r1, r2) = gf_add(r1, r2)

let sc8_regex_concat(r1, r2) = gf_mul(r1, r2)

let sc8_regex_star(r) =
    if r == 1
        1
    if r == 0
        1
    gf_inv(gf_sub(1, r))

let sc8_regex_match(regex, string_hash) = ((gf_mul(regex, string_hash) != 0) ? (1) : (0))

let sc8_nfa_to_matrix(nfa_transitions) = nfa_transitions

let sc8_nfa_accepts(transition_matrix, start, accept, length) =
    let entry = arr_get(arr_get(transition_matrix, start), accept)
    ((gf_pow(entry, length) != 0) ? (1) : (0))

let sc8_regex_equivalent(r1, r2) = ((r1 == r2) ? (1) : (0))

let sc8_kleene_algebra_axioms() =
    let t1 = ((gf_mul(42, 0) == 0) ? (1) : (0))
    let t2 = ((gf_mul(42, 1) == 42) ? (1) : (0))
    let t3 = ((sc8_regex_star(0) == 1) ? (1) : (0))
    let r = 2
    let r_star = sc8_regex_star(r)
    let fixed = gf_add(1, gf_mul(r, r_star))
    let t4 = ((fixed == r_star) ? (1) : (0))
    t1 + t2 + t3 + t4

let sc9_cyk_init(n) =
    let table = arr_new_n(n)
    _sc9_init_acc(table, n, 0)
    table
let _sc9_init_acc(table, n, i) =
    if i >= n
        0
    let row = arr_new_n(n)
    arr_set(table, i, row)
    _sc9_init_acc(table, n, i + 1)

let sc9_cyk_fill_diagonal(table, tokens) =
    let n = arr_len(tokens)
    _sc9_diag_acc(table, tokens, n, 0)
let _sc9_diag_acc(table, tokens, n, i) =
    if i >= n
        0
    let row = arr_get(table, i)
    arr_set(row, i, arr_get(tokens, i))
    _sc9_diag_acc(table, tokens, n, i + 1)

let sc9_cyk_cell(table, i, j, n) =
    _sc9_cell_acc(table, i, j, i, j, 0)
let _sc9_cell_acc(table, i, j, k, j_end, acc) =
    if k >= j_end
        acc
    let left = arr_get(arr_get(table, i), k)
    let right = arr_get(arr_get(table, k + 1), j)
    let prod = gf_mul(left, right)
    _sc9_cell_acc(table, i, j, k + 1, j_end, gf_add(acc, prod))

let sc9_cyk_fill_all(table, n) =
    _sc9_fill_len_acc(table, n, 2, n)
let _sc9_fill_len_acc(table, n, length, max_len) =
    if length > max_len
        0
    _sc9_fill_diag_acc(table, n, length, 0, n)
    _sc9_fill_len_acc(table, n, length + 1, max_len)
let _sc9_fill_diag_acc(table, n, length, i, max_i) =
    if i + length - 1 >= max_i
        0
    let j = i + length - 1
    let val = sc9_cyk_cell(table, i, j, n)
    arr_set(arr_get(table, i), j, val)
    _sc9_fill_diag_acc(table, n, length, i + 1, max_i)

let sc9_cyk_parse(tokens, start_symbol) =
    let n = arr_len(tokens)
    if n == 0
        ((start_symbol == 1) ? (1) : (0))
    let table = sc9_cyk_init(n)
    sc9_cyk_fill_diagonal(table, tokens)
    sc9_cyk_fill_all(table, n)
    let top = arr_get(arr_get(table, 0), n - 1)
    ((top != 0) ? (1) : (0))

let sc9_parse_table_size(n) = gf_mul(n, n)

let sc9_parse_complexity(n) = gf_mul(n, gf_mul(n, n))

let sc9_parse_terminates(n) = ((sc9_parse_complexity(n) > 0) ? (1) : (0))

let SC10_SYMBOL_HASH_BASE = 3

let sc10_hash_symbol(name_chars) =
    let n = arr_len(name_chars)
    _sc10_hash_acc(name_chars, n, 0, 0, 1)
let _sc10_hash_acc(name_chars, n, i, acc, power) =
    if i >= n
        acc
    let c = arr_get(name_chars, i)
    let term = gf_mul(c, power)
    let next_acc = gf_add(acc, term)
    let next_power = gf_mul(power, SC10_SYMBOL_HASH_BASE)
    _sc10_hash_acc(name_chars, n, i + 1, next_acc, next_power)

let sc10_symbol_eq(s1_hash, s2_hash) = ((s1_hash == s2_hash) ? (1) : (0))

let sc10_symbol_neq(s1_hash, s2_hash) = ((s1_hash != s2_hash) ? (1) : (0))

let sc10_symbol_lt(s1_hash, s2_hash) = ((s1_hash < s2_hash) ? (1) : (0))

let sc10_symbol_table_make() = arr_new_n(0)

let sc10_symbol_table_insert(table, hash, value) =
    let n = arr_len(table)
    let entry = arr_new_n(2)
    arr_set(entry, 0, hash)
    arr_set(entry, 1, value)
    let new_table = arr_new_n(n + 1)
    _sc10_copy_acc(table, new_table, n, 0)
    arr_set(new_table, n, entry)
    new_table
let _sc10_copy_acc(src, dst, n, i) =
    if i >= n
        0
    arr_set(dst, i, arr_get(src, i))
    _sc10_copy_acc(src, dst, n, i + 1)

let sc10_symbol_table_lookup(table, hash) =
    let n = arr_len(table)
    _sc10_lookup_acc(table, hash, n, 0)
let _sc10_lookup_acc(table, hash, n, i) =
    if i >= n
        0
    let entry = arr_get(table, i)
    let h = arr_get(entry, 0)
    if h == hash
        arr_get(entry, 1)
    _sc10_lookup_acc(table, hash, n, i + 1)

let sc10_symbol_table_has(table, hash) = ((sc10_symbol_table_lookup(table, hash) != 0) ? (1) : (0))

let sc10_pigeonhole_proof() = 1

let sc10_capacity() = 65537

