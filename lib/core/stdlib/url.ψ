let url_parse(s) =
    let n = s.len()
    let result = arr_new()
    result = arr_push(result, "")
    result = arr_push(result, "")
    result = arr_push(result, 0)
    result = arr_push(result, "")
    result = arr_push(result, "")
    result = arr_push(result, "")
    let pos = 0
    let scheme = ""
    let i = 0
    for i < n && s[i] != 58
        scheme = scheme + s[i]
        i = i + 1
    if i < n && s[i] == 58
        result[0] = scheme
        pos = i + 1
        if pos + 1 < n && s[pos] == 47 && s[pos + 1] == 47
            pos = pos + 2
    let host = ""
    let port = 0
    let has_port = 0
    for pos < n
        let c = s[pos]
        if c == 58
            has_port = 1
            pos = pos + 1
            let port_str = ""
            for pos < n && s[pos] != 47 && s[pos] != 63 && s[pos] != 35
                port_str = port_str + s[pos]
                pos = pos + 1
            port = 0
            let ps_len = port_str.len()
            let pi = 0
            for pi < ps_len
                port = port * 10 + (port_str[pi] - 48)
                pi = pi + 1
            pos = n
        else
            if c == 47 || c == 63 || c == 35
                pos = n
            else
                host = host + c
                pos = pos + 1
    result[1] = host
    if has_port == 1
        result[2] = port
    else
        if result[0] == "https"
            result[2] = 443
        else
            0
        if result[0] == "http"
            result[2] = 80
    result

let url_build(scheme, host, port, path, query, fragment) =
    let result = scheme + "://" + host
    if port != 0 && port != 80 && port != 443
        result = result + ":" + port
    if path != ""
        result = result + path
    if query != ""
        result = result + "?" + query
    if fragment != ""
        result = result + "#" + fragment
    result

let url_parse_query(query) =
    let pairs = arr_new()
    let n = query.len()
    let i = 0
    for i < n
        let key = ""
        let val = ""
        for i < n && query[i] != 61 && query[i] != 38
            key = key + query[i]
            i = i + 1
        if i < n && query[i] == 61
            i = i + 1
            for i < n && query[i] != 38
                val = val + query[i]
                i = i + 1
        let pair = arr_new()
        pair = arr_push(pair, key)
        pair = arr_push(pair, val)
        pairs = arr_push(pairs, pair)
        if i < n && query[i] == 38
            i = i + 1
    pairs

let url_build_query(pairs) =
    let result = ""
    let n = pairs.len()
    let i = 0
    for i < n
        if i > 0
            result = result + "&"
        let pair = pairs[i]
        result = result + pair[0] + "=" + pair[1]
        i = i + 1
    result

let url_get_param(pairs, key) =
    let n = pairs.len()
    let i = 0
    for i < n
        let pair = pairs[i]
        if pair[0] == key
            return pair[1]
        i = i + 1
    ""

let url_normalize_path(path) =
    let segments = arr_new()
    let n = path.len()
    let i = 0
    for i < n
        let seg = ""
        for i < n && path[i] != 47
            seg = seg + path[i]
            i = i + 1
        if seg != "" && seg != "."
            if seg == ".."
                let sn = segments.len()
                if sn > 0
                    let new_segs = arr_new()
                    let j = 0
                    for j < sn - 1
                        new_segs = arr_push(new_segs, segments[j])
                        j = j + 1
                    segments = new_segs
                else
                    0
                segments = arr_push(segments, seg)
        if i < n
            i = i + 1
    let result = "/"
    let sn = segments.len()
    i = 0
    for i < sn
        result = result + segments[i]
        if i < sn - 1
            result = result + "/"
        i = i + 1
    result

let url_join_path(base, path) =
    let result = base
    if result.len() > 0
        let last = result[result.len() - 1]
        if last != 47 && path.len() > 0 && path[0] != 47
            result = result + "/"
    result = result + path
    url_normalize_path(result)

let url_encode(s) =
    let hexchars = "0123456789ABCDEF"
    let result = ""
    let n = s.len()
    let i = 0
    for i < n
        let c = s[i]
        let safe = 0
        if c >= 65 && c <= 90
            safe = 1
        else
            0
        if c >= 97 && c <= 122
            safe = 1
        else
            0
        if c >= 48 && c <= 57
            safe = 1
        else
            0
        if c == 45 || c == 95 || c == 46 || c == 126
            safe = 1
        if safe == 1
            result = result + c
        else
            result = result + "%" + hexchars[c / 16] + hexchars[c % 16]
        i = i + 1
    result

let url_decode(s) =
    let result = ""
    let n = s.len()
    let i = 0
    for i < n
        let c = s[i]
        if c == 37 && i + 2 < n
            let hi = s[i + 1]
            let lo = s[i + 2]
            let val = 0
            if hi >= 48 && hi <= 57
                val = (hi - 48) * 16
            else
                0
            if hi >= 65 && hi <= 70
                val = (hi - 55) * 16
            else
                0
            if hi >= 97 && hi <= 102
                val = (hi - 87) * 16
            if lo >= 48 && lo <= 57
                val = val + lo - 48
            else
                0
            if lo >= 65 && lo <= 70
                val = val + lo - 55
            else
                0
            if lo >= 97 && lo <= 102
                val = val + lo - 87
            result = result + val
            i = i + 3
        else
            result = result + c
            i = i + 1
    result

let url_is_valid(s) =
    let n = s.len()
    if n < 7
        return 0
    let has_scheme = 0
    let i = 0
    for i < n
        if s[i] == 58
            has_scheme = 1
        i = i + 1
    has_scheme

