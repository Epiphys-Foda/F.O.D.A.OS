let fn_group_by(arr) =
    let n = arr.len()
    let values = arr_new()
    let counts = arr_new()
    let i = 0
    for i < n
        let v = arr[i]
        let found = 0 - 1
        let j = 0
        let m = values.len()
        for j < m
            if values[j] == v
                found = j
            j = j + 1
        if found >= 0
            counts[found] = counts[found] + 1
        else
            values = arr_push(values, v)
            counts = arr_push(counts, 1)
        i = i + 1
    let result = arr_new()
    i = 0
    let m = values.len()
    for i < m
        let pair = arr_new()
        pair = arr_push(pair, values[i])
        pair = arr_push(pair, counts[i])
        result = arr_push(result, pair)
        i = i + 1
    result

let fn_slice(arr, start, end) =
    let result = arr_new()
    let i = start
    for i < end && i < arr.len()
        result = arr_push(result, arr[i])
        i = i + 1
    result

let fn_concat(a, b) =
    let result = arr_new()
