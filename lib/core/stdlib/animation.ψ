let ease_linear(t) =
    t

let ease_in_quad(t) =
    t * t / 1000

let ease_out_quad(t) =
    1000 - (1000 - t) * (1000 - t) / 1000

let ease_in_out_quad(t) =
    if t < 500
        2 * t * t / 1000
    else
        1000 - 2 * (1000 - t) * (1000 - t) / 1000

let ease_in_cubic(t) =
    t * t * t / 1000000

let ease_out_cubic(t) =
    let f = 1000 - t
    1000 - f * f * f / 1000000

let ease_in_out_cubic(t) =
    if t < 500
        4 * t * t * t / 1000000
    else
        let f = 2000 - 2 * t
        1000 - f * f * f / 2000000

let ease_in_quart(t) =
    t * t * t * t / 1000000000

let ease_out_quart(t) =
    let f = 1000 - t
    1000 - f * f * f * f / 1000000000

let ease_in_out_quart(t) =
    if t < 500
        8 * t * t * t * t / 1000000000
    else
        let f = 2000 - 2 * t
        1000 - f * f * f * f / 200000000

let ease_in_elastic(t) =
    if t == 0
        0
    else
        0
    if t == 1000
        1000
    else
        t * t * t / 1000000

let ease_out_elastic(t) =
    if t == 0
        0
    else
        0
    if t == 1000
        1000
    else
        1000 - ease_in_elastic(1000 - t)

let ease_in_back(t) =
    let C = 1700
    t * t * ((C + 1000) * t / 1000 - C) / 1000

let ease_out_back(t) =
    let C = 1700
    let f = t - 1000
    1000 + f * f * ((C + 1000) * f / 1000 + C) / 1000

let ease_out_bounce(t) =
    let n1 = 750
    let tt = t
    if tt < 364
        n1 * tt * tt / 1000000
    else
        0
    if tt < 728
        tt = tt - 545
        n1 * tt * tt / 1000000 + 750
    else
        0
    if tt < 909
        tt = tt - 818
        n1 * tt * tt / 1000000 + 937
    else
        tt = tt - 955
        n1 * tt * tt / 1000000 + 984

let ease_in_bounce(t) =
    1000 - ease_out_bounce(1000 - t)

let ease_in_out_bounce(t) =
    if t < 500
        ease_in_bounce(2 * t) / 2
    else
        500 + ease_out_bounce(2 * t - 1000) / 2

let lerp(a, b, t) =
    a + t * (b - a) / 1000

let clamp(x, lo, hi) =
    (x < lo ? lo : ((x > hi ? hi : x)))

let smoothstep(edge0, edge1, x) =
    let t = clamp((x - edge0) * 1000 / (edge1 - edge0), 0, 1000)
    t * t * (3 * 1000 - 2 * t) / 1000000

let smootherstep(edge0, edge1, x) =
    let t = clamp((x - edge0) * 1000 / (edge1 - edge0), 0, 1000)
    t * t * t * (t * (6 * t - 15) + 10) / 1000000000

let keyframe_interp(keyframes, time) =
    if time <= keyframes[0][0]
        keyframes[0][1]
    else
        0
    if time >= keyframes[keyframes.len() - 1][0]
        keyframes[keyframes.len() - 1][1]
    else
        let i = 0
        for i < keyframes.len() - 1 && keyframes[i + 1][0] < time
            i = i + 1
        let t = (time - keyframes[i][0]) * 1000 / (keyframes[i + 1][0] - keyframes[i][0])
        lerp(keyframes[i][1], keyframes[i + 1][1], t)

