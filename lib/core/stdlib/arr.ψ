

let arr_len(arr) = len(arr)
let sa_slice(arr, start, end) =
    let n = arr_len(arr)
    let s = _clamp(start, 0, n)
    let e = _clamp(end, 0, n)
    let sub_n = (s > e) ? 0 : (e - s)
    let full = host_call(35, arr, s)
    host_call(36, full, sub_n)

let sa_swap(arr, i, j) =
    let n = arr_len(arr)
    if i >= n
        arr
    if j >= n
        arr
    let vi = arr_get(arr, i)
    let vj = arr_get(arr, j)
    arr_set(arr, i, vj)
    arr_set(arr, j, vi)
    arr

let _sa_fill_acc(arr, val, i, n) =
    if i >= n
        arr
    arr_set(arr, i, val)
    _sa_fill_acc(arr, val, i + 1, n)
let sa_fill(arr, val) = _sa_fill_acc(arr, val, 0, arr_len(arr))

let _sa_range_acc(dst, base, i, n) =
    if i >= n
        dst
    arr_set(dst, i, base + i)
    _sa_range_acc(dst, base, i + 1, n)
let sa_range(n) = _sa_range_acc(arr_new_n(n), 0, 0, n)
let sa_range2(lo, hi) =
    let n = ((hi > lo) ? (hi - lo) : (0))
    _sa_range_acc(arr_new_n(n), lo, 0, n)

let sa_layer_id() = 79
let sa_module_count() = 24

let test_sa_layer() =
    let a = arr_new_n(3)
    arr_set(a, 0, 10)
    arr_set(a, 1, 20)
    arr_set(a, 2, 30)

    let c = sa_copy(a)
    assert_eq(arr_get(c, 0), 10)
    assert_eq(arr_get(c, 2), 30)
    assert_eq(arr_len(c), 3)
    assert_eq(sa_sum(a), 60)
    assert_eq(sa_min(a), 10)
    assert_eq(sa_max(a), 30)
    assert_eq(sa_index(a, 20), 1)
    assert_eq(sa_index(a, 99), -1)
    assert_eq(sa_contains(a, 30), 1)
    assert_eq(sa_contains(a, 99), 0)
    assert_eq(sa_count(a, 10), 1)

    let s1 = sa_slice_from(a, 1)
    assert_eq(arr_len(s1), 2)
    assert_eq(arr_get(s1, 0), 20)
    let s2 = sa_slice_to(a, 2)
    assert_eq(arr_len(s2), 2)
    assert_eq(arr_get(s2, 0), 10)
    let s3 = sa_slice(a, 1, 3)
    assert_eq(arr_len(s3), 2)
    assert_eq(arr_get(s3, 0), 20)

    let r = sa_reverse(a)
    assert_eq(arr_get(r, 0), 30)
    assert_eq(arr_get(r, 2), 10)
    let cat = sa_concat(a, r)
    assert_eq(arr_len(cat), 6)
    assert_eq(arr_get(cat, 0), 10)
    assert_eq(arr_get(cat, 3), 30)

    let z = sa_zip(a, r)
    assert_eq(arr_len(z), 6)
    assert_eq(arr_get(z, 0), 10)
    assert_eq(arr_get(z, 1), 30)

    assert_eq(arr_len(sa_take(a, 2)), 2)
    assert_eq(arr_get(sa_take(a, 2), 1), 20)
    assert_eq(arr_len(sa_drop(a, 1)), 2)
    assert_eq(arr_get(sa_drop(a, 1), 0), 20)

    let rg = sa_range(3)
    assert_eq(arr_len(rg), 3)
    assert_eq(arr_get(rg, 0), 0)
    assert_eq(arr_get(rg, 2), 2)
    let rg2 = sa_range2(5, 8)
    assert_eq(arr_len(rg2), 3)
    assert_eq(arr_get(rg2, 0), 5)
    assert_eq(arr_get(rg2, 2), 7)

    let sw = sa_copy(a)
    sa_swap(sw, 0, 2)
    assert_eq(arr_get(sw, 0), 30)
    assert_eq(arr_get(sw, 2), 10)

    let fl = arr_new_n(2)
    sa_fill(fl, 42)
    assert_eq(arr_get(fl, 0), 42)
    assert_eq(arr_get(fl, 1), 42)

    let unsorted = arr_new_n(3)
    arr_set(unsorted, 0, 30)
    arr_set(unsorted, 1, 10)
    arr_set(unsorted, 2, 20)
    let sa = sa_copy(unsorted)
    sa_sort_asc(sa)
    assert_eq(arr_get(sa, 0), 10)
    assert_eq(arr_get(sa, 1), 20)
    assert_eq(arr_get(sa, 2), 30)
    let sd = sa_copy(unsorted)
    sa_sort_desc(sd)
    assert_eq(arr_get(sd, 0), 30)
    assert_eq(arr_get(sd, 1), 20)
    assert_eq(arr_get(sd, 2), 10)

    assert_eq(sa_equal(a, c), 1)
    let diff = arr_new_n(3)
    arr_set(diff, 0, 1)
    assert_eq(sa_equal(a, diff), 0)

    let p = arr_new_n(3)
    arr_set(p, 0, 2)
    arr_set(p, 1, 3)
    arr_set(p, 2, 4)
    assert_eq(sa_product(p), 24)
    assert_eq(sa_avg(p), 3)

    assert_eq(sa_layer_id(), 79)
    assert_eq(sa_module_count(), 24)
    0
