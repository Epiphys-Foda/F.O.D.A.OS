    let done = false
    for !done
      if i + 2 < len(db)
        let rk = db[i + 2]
        if rk >= threshold
          out = out.push(db[i])
          out = out.push(db[i + 1])
          out = out.push(rk)
        else
          0
        i = i + 3
      else
        done = true
    out

let rf_db_carve(db, zx, zy, delta) = rf_db_insert(db, zx, zy, delta)

let rf_db_decay(db, factor) =
    let out = []
    let i = 0
    let done = false
    for !done
      if i + 2 < len(db)
        let zx = db[i]
        let zy = db[i + 1]
        let rk = db[i + 2]
        let new_r = rf_db_mul(rk, factor)
        out = out.push(zx)
        out = out.push(zy)
        out = out.push(new_r)
        i = i + 3
      else
        done = true
    out

