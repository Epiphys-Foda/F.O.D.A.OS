let rf_db_shard(db, k) =
    let shards = []
    let i = 0
    let done0 = false
    for !done0
      if i < k
        shards = shards.push([])
        i = i + 1
      else
        done0 = true
    let j = 0
    let done1 = false
    for !done1
      if j + 2 < len(db)
        let shard_idx = (j / 3) % k
        let target = shards[shard_idx]
        let t1 = target.push(db[j])
        let t2 = t1.push(db[j + 1])
        let t3 = t2.push(db[j + 2])
        shards = rf_db_arr_set(shards, shard_idx, t3)
        j = j + 3
      else
        done1 = true
    shards

