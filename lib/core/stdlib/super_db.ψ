let rf_db_half_inv = 32769

let rf_db_window(db, k) =
    let n_poles = rf_db_count(db)
    let take = (k < n_poles ? k : n_poles)
    let start = (n_poles - take) * 3
    let out = []
    let i = start
    let done = false
    for !done
      if i < len(db)
        out = out.push(db[i])
        i = i + 1
      else
        done = true
    out

let rf_db_hot_poles(db, threshold) =
    let out = []
