let rf_db_cgl_detect(seq) =
    let n = len(seq)
    if n < 4
    else
      0
    let tortoise = seq[0]
    let hare = seq[1]
    let found = false
    let i = 0
    let done = false
    for !done
      if i < n - 1
        tortoise = seq[i]
        if i * 2 + 1 < n
          hare = seq[i * 2 + 1]
          if tortoise == hare && i > 0
            found = true
            done = true
          else
              0
        else
          done = true
        i = i + 1
      else
        done = true
    found

let rf_db_cgl_break(seq) =
    let out = []
    let i = 0
    let done0 = false
    for !done0
      if i < len(seq)
        let v = seq[i]
        let seen = false
        let j = 0
        let done1 = false
        for !done1
          if j < len(out)
            if out[j] == v
              seen = true
              done1 = true
            else
              0
            j = j + 1
          else
            done1 = true
        if !seen
          out = out.push(v)
        else
          0
        i = i + 1
      else
        done0 = true
    out

let rf_db_cgl_report(seq) =
    let has_cycle = rf_db_cgl_detect(seq)
    let broken = rf_db_cgl_break(seq)
    let n = len(seq)
    let m = len(broken)
    let head = if has_cycle
      "CGL: cycle=TRUE"
    else
      "CGL: cycle=FALSE"
    head + " len=" + str(n) + " unique=" + str(m)

