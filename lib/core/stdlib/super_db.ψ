let rf_db_mulmod(a, b, p) =
    let r = 0
    let x = a % p
    let y = b
    let done = false
    for !done
      if y > 0
        if y % 2 == 1
          r = (r + x) % p
        else
          0
        x = (x + x) % p
        y = y / 2
      else
        done = true
    r

let rf_db_mul(a, b) = rf_db_mulmod(a, b, 65537)

let rf_db_mod_pow(a, b, p) =
    let base = a
    let exp = b
    let acc = 1
    let done = false
    for !done
      if exp > 0
        if exp % 2 == 1
          acc = rf_db_mulmod(acc, base, p)
        else
          0
        base = rf_db_mulmod(base, base, p)
        exp = exp / 2
      else
        done = true
    acc

let rf_db_inv(z) = rf_db_mod_pow(z, 65535, 65537)

let rf_db_z(x, y) = (x + rf_db_mul(y, 65281)) % 65537

let rf_db_field(db, x, y) =
    let acc = 0
    let i = 0
    let done = false
    for !done
      if i + 2 < len(db)
        let xk = db[i]
        let yk = db[i + 1]
        let rk = db[i + 2]
        let zk = rf_db_z(xk, yk)
        let z = rf_db_z(x, y)
        let dz = (z - zk) % 65537
        let dz_p = (dz < 0 ? dz + 65537 : dz)
        if dz_p != 0
          let term = rf_db_mul(rk, rf_db_inv(dz_p))
          let s = acc + term
          if s >= 65537
            acc = s - 65537
          else
            acc = s
        i = i + 3
      else
        done = true
    acc

let rf_db_create() = []

let rf_db_count(db) = len(db) / 3

let rf_db_is_empty(db) = len(db) == 0

let rf_db_insert(db, zx, zy, r) =
    let i = 0
    let hit_idx = -1
    let done = false
    for !done
      if i + 2 < len(db)
        if db[i] == zx && db[i + 1] == zy
          hit_idx = i + 2
          done = true
        else
          i = i + 3
      else
        done = true
    if hit_idx >= 0
      rf_db_set(db, hit_idx, (db[hit_idx] + r) % 65537)
    else
      rf_db_append3(db, zx, zy, r)

let rf_db_probe(db, x, y) = rf_db_field(db, x, y)

let rf_db_set(db, idx, val) =
    let out = []
    let i = 0
    let done = false
    for !done
      if i < len(db)
        if i == idx
          out = out.push(val)
        else
          out = out.push(db[i])
        i = i + 1
      else
        done = true
    out

let rf_db_append3(db, a, b, c) =
    let t1 = db.push(a)
    let t2 = t1.push(b)
    t2.push(c)

let rf_db_in_rect(px, py, cx, cy, w, h) =
    (px > cx - w / 2) && (px < cx + w / 2) && (py > cy - h / 2) && (py < cy + h / 2)

let rf_db_residue_sum(db, cx, cy, w, h) =
    let sum = 0
    let i = 0
    let done = false
    for !done
      if i + 2 < len(db)
        let xk = db[i]
        let yk = db[i + 1]
        let rk = db[i + 2]
        if rf_db_in_rect(xk, yk, cx, cy, w, h)
          let s = sum + rk
          if s >= 65537
            sum = s - 65537
          else
            sum = s
        else
          0
        i = i + 3
      else
        done = true
    sum

let rf_db_count_poles_in(db, cx, cy, w, h) =
    let count = 0
    let i = 0
    let done = false
    for !done
      if i + 2 < len(db)
        let xk = db[i]
        let yk = db[i + 1]
        if rf_db_in_rect(xk, yk, cx, cy, w, h)
          count = count + 1
        else
          0
        i = i + 3
      else
        done = true
    count

let rf_db_select(db, cx, cy, w, h) =
    let out = []
    let i = 0
    let done = false
    for !done
      if i + 2 < len(db)
