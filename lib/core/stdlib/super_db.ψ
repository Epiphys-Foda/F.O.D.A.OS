let rf_db_delta_frame(old_db, new_db) =
    let delta_poles = []
    let i = 0
    let done0 = false
    for !done0
      if i + 2 < len(new_db)
        let zx = new_db[i]
        let zy = new_db[i + 1]
        let r_new = new_db[i + 2]
        let r_old = 0
        let found = false
        let j = 0
        let done1 = false
        for !done1
          if j + 2 < len(old_db)
            if old_db[j] == zx && old_db[j + 1] == zy
              r_old = old_db[j + 2]
              found = true
              done1 = true
            else
              j = j + 3
          else
            done1 = true
        if !found || r_old != r_new
          delta_poles = delta_poles.push(zx)
          delta_poles = delta_poles.push(zy)
          delta_poles = delta_poles.push(r_new)
        else
          0
        i = i + 3
      else
        done0 = true
    let payload = rf_db_to_bytes(delta_poles)
    let plen = len(payload)
    let b0 = rf_db_psi_msg_delta_field * 32
    let b2 = plen % 256
    let b3 = plen / 256
    let frame = []
    frame = frame.push(b0)
    frame = frame.push(0)
    frame = frame.push(b2)
    frame = frame.push(b3)
    let k = 0
    let done2 = false
    for !done2
      if k < plen
        frame = frame.push(payload[k])
        k = k + 1
      else
        done2 = true
    frame

let rf_db_apply_delta(old_db, frame) =
    let b0 = frame[0]
    let msg_type = b0 / 32
    let plen = frame[2] + frame[3] * 256
    let payload = []
    let i = 0
    let done = false
    for !done
      if i < plen
        payload = payload.push(frame[4 + i])
        i = i + 1
      else
        done = true
    if msg_type == rf_db_psi_msg_delta_field
      let delta_db = rf_db_from_bytes(payload)
      let out = old_db
      let j = 0
      let done2 = false
      for !done2
        if j + 2 < len(delta_db)
          out = rf_db_insert(out, delta_db[j], delta_db[j + 1], delta_db[j + 2])
          j = j + 3
        else
          done2 = true
      out
    else
      old_db

