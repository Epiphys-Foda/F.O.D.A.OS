    let done_outer = false
    for !done_outer
      let found = false
      let s = 0
      let done_s = false
      for !done_s
        if s < len(shards)
          let shard = shards[s]
          let base = round * 3
          if base + 2 < len(shard)
            out = out.push(shard[base])
            out = out.push(shard[base + 1])
            out = out.push(shard[base + 2])
            found = true
          else
            0
          s = s + 1
        else
          done_s = true
      if !found
        done_outer = true
      else
        round = round + 1
    out

