let rf_db_gf_to_le4(gf) =
    let b0 = gf % 256
    let b1 = (gf / 256) % 256
    let b2 = (gf / 65536) % 256
    [b0, b1, b2, 0]

let rf_db_le4_to_gf(bytes, off) =
    let b0 = bytes[off]
    let b1 = bytes[off + 1]
    let b2 = bytes[off + 2]
    b0 + b1 * 256 + b2 * 65536

let rf_db_checksum(db) =
    let acc = 0
    let i = 0
    let done = false
    for !done
      if i < len(db)
        let s = acc + db[i]
        if s >= 65537
          acc = s - 65537
        else
          acc = s
        i = i + 1
      else
        done = true
    acc

let rf_db_to_bytes(db) =
    let n_poles = rf_db_count(db)
    let out = [80, 83, 73, 68]
    out = out.push(n_poles % 256)
    out = out.push((n_poles / 256) % 256)
    out = out.push((n_poles / 65536) % 256)
    out = out.push(0)
    let i = 0
    let done1 = false
    for !done1
      if i < len(db)
        let bs = rf_db_gf_to_le4(db[i])
        out = out.push(bs[0])
        out = out.push(bs[1])
        out = out.push(bs[2])
        out = out.push(bs[3])
        i = i + 1
      else
        done1 = true
    let cksum = rf_db_checksum(db)
    let cs = rf_db_gf_to_le4(cksum)
    out = out.push(cs[0])
    out = out.push(cs[1])
    out = out.push(cs[2])
    out = out.push(cs[3])
    out

let rf_db_from_bytes(bytes) =
    let m0 = bytes[0]
    let m1 = bytes[1]
    let m2 = bytes[2]
    let m3 = bytes[3]
    let magic_ok = (m0 == 80) && (m1 == 83) && (m2 == 73) && (m3 == 68)
    if !magic_ok
      []
    else
      let n_poles = rf_db_le4_to_gf(bytes, 4)
      let db = []
      let i = 0
      let off = 8
      let done1 = false
      for !done1
        if i < n_poles * 3
          let gf = rf_db_le4_to_gf(bytes, off)
          db = db.push(gf)
          off = off + 4
          i = i + 1
        else
          done1 = true
      let stored_cksum = rf_db_le4_to_gf(bytes, off)
      let actual_cksum = rf_db_checksum(db)
      if stored_cksum != actual_cksum
        []
      else
        db

let rf_db_equal(db1, db2) =
    let n1 = len(db1)
    let n2 = len(db2)
    if n1 != n2
      false
    else
      let ok = true
      let i = 0
      let done = false
      for !done
        if i < n1
          if db1[i] != db2[i]
            ok = false
            done = true
          else
            i = i + 1
        else
          done = true
      ok

let rf_db_wal_create() =
    let w = []
    w = w.push(80)
    w = w.push(83)
    w = w.push(87)
    w = w.push(76)
    w

let rf_db_wal_append(wal, op, zx, zy, r) =
    let bs_op = rf_db_gf_to_le4(op)
    let bs_zx = rf_db_gf_to_le4(zx)
    let bs_zy = rf_db_gf_to_le4(zy)
    let bs_r = rf_db_gf_to_le4(r)
    let w = wal
    w = w.push(bs_op[0])
    w = w.push(bs_op[1])
    w = w.push(bs_op[2])
    w = w.push(bs_op[3])
    w = w.push(bs_zx[0])
    w = w.push(bs_zx[1])
    w = w.push(bs_zx[2])
    w = w.push(bs_zx[3])
    w = w.push(bs_zy[0])
    w = w.push(bs_zy[1])
    w = w.push(bs_zy[2])
    w = w.push(bs_zy[3])
    w = w.push(bs_r[0])
    w = w.push(bs_r[1])
    w = w.push(bs_r[2])
    w = w.push(bs_r[3])
    w

let rf_db_wal_apply(db, op, zx, zy, r) =
    if op == 1
      rf_db_insert(db, zx, zy, r)
    else
      if op == 2
        rf_db_forget(db, zx, zy)
      else
        db

let rf_db_wal_replay(wal) =
    let m0 = wal[0]
    let m1 = wal[1]
    let m2 = wal[2]
    let m3 = wal[3]
    let magic_ok = (m0 == 80) && (m1 == 83) && (m2 == 87) && (m3 == 76)
    if !magic_ok
      []
    else
      let db = rf_db_create()
      let off = 4
      let done = false
      for !done
        if off + 16 <= len(wal)
          let op = rf_db_le4_to_gf(wal, off)
          let zx = rf_db_le4_to_gf(wal, off + 4)
          let zy = rf_db_le4_to_gf(wal, off + 8)
          let r = rf_db_le4_to_gf(wal, off + 12)
          db = rf_db_wal_apply(db, op, zx, zy, r)
          off = off + 16
        else
          done = true
      db

let rf_db_load_bytes(path) =
    let n = host_call(2, path, 0)
    let bytes = []
    let i = 0
    let done = false
    for !done
      if i < n
        bytes = bytes.push(host_call(4, i, 0))
        i = i + 1
      else
        done = true
    bytes

let rf_db_save(db, path) =
    let bytes = rf_db_to_bytes(db)
    host_call(101, path, bytes)

let rf_db_load(path) =
    let bytes = rf_db_load_bytes(path)
    rf_db_from_bytes(bytes)

let rf_db_wal_save(wal, path) = host_call(101, path, wal)

let rf_db_wal_load(path) = rf_db_load_bytes(path)

let rf_db_restore(snap_db, wal) =
    let m0 = wal[0]
    let m1 = wal[1]
    let m2 = wal[2]
    let m3 = wal[3]
    let magic_ok = (m0 == 80) && (m1 == 83) && (m2 == 87) && (m3 == 76)
    let out_db = snap_db
    let off = 4
    let done = false
    if magic_ok
      for !done
        if off + 16 <= len(wal)
          let op = rf_db_le4_to_gf(wal, off)
          let zx = rf_db_le4_to_gf(wal, off + 4)
          let zy = rf_db_le4_to_gf(wal, off + 8)
          let r = rf_db_le4_to_gf(wal, off + 12)
          out_db = rf_db_wal_apply(out_db, op, zx, zy, r)
          off = off + 16
        else
          done = true
    else
      0
    out_db

