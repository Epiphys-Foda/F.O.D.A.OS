        let yk = db[i + 1]
        let rk = db[i + 2]
        if rf_db_in_rect(xk, yk, cx, cy, w, h)
          out = out.push(xk)
          out = out.push(yk)
          out = out.push(rk)
        else
          0
        i = i + 3
      else
        done = true
    out

let rf_db_join(db1, db2) =
    let out = []
    let i = 0
    let done1 = false
    for !done1
      if i + 2 < len(db1)
        let zx = db1[i]
        let zy = db1[i + 1]
        let r1 = db1[i + 2]
        let j = 0
        let found_r2 = 0
        let has_match = false
        let done2 = false
        for !done2
          if j + 2 < len(db2)
            if db2[j] == zx && db2[j + 1] == zy
              found_r2 = db2[j + 2]
              has_match = true
              done2 = true
            else
              j = j + 3
          else
            done2 = true
        if has_match
          out = out.push(zx)
          out = out.push(zy)
          out = out.push((r1 + found_r2) % 65537)
        else
          0
        i = i + 3
      else
        done1 = true
    out

let rf_db_forget(db, zx, zy) =
    let out = []
    let i = 0
    let done = false
    for !done
      if i + 2 < len(db)
        if db[i] == zx && db[i + 1] == zy
        else
          out = out.push(db[i])
          out = out.push(db[i + 1])
          out = out.push(db[i + 2])
          0
        i = i + 3
      else
        done = true
    out

