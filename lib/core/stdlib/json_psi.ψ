let js_skip_ws(s, i) =
    let j = i
    for j < len(s) && s.slice(j, j + 1) == " "
      j = j + 1
    j

let js_number(s, i) =
    let j = i
    let neg = 0
    if s.slice(j, j + 1) == "-"
      neg = 1
      j = j + 1
    else
      0
    let val = 0
    let go = 1
    for go == 1
      if j < len(s)
        let d = s.slice(j, j + 1)
        if d == "0"
          val = val * 10
          j = j + 1
        else
          if d == "1"
            val = val * 10 + 1
            j = j + 1
            0
          else
            if d == "2"
              val = val * 10 + 2
              j = j + 1
              0
            else
              if d == "3"
                val = val * 10 + 3
                j = j + 1
                0
              else
                if d == "4"
                  val = val * 10 + 4
                  j = j + 1
                  0
                else
                  if d == "5"
                    val = val * 10 + 5
                    j = j + 1
                    0
                  else
                    if d == "6"
                      val = val * 10 + 6
                      j = j + 1
                      0
                    else
                      if d == "7"
                        val = val * 10 + 7
                        j = j + 1
                        0
                      else
                        if d == "8"
                          val = val * 10 + 8
                          j = j + 1
                          0
                        else
                          if d == "9"
                            val = val * 10 + 9
                            j = j + 1
                            0
                          else
                            go = 0
      else
        go = 0
    if neg == 1
      [["int", 0 - val], j]
    else
      [["int", val], j]

let js_string(s, i) =
    let j = i
    let out = ""
    let done = 0
    for done == 0
      if j >= len(s)
        done = 1
      else
        let c = s.slice(j, j + 1)
        if c == "\""
          done = 1
        else
          out = str_concat(out, c)
          j = j + 1
    [["str", out], j + 1]

let js_value_scalar(s, i) =
    let j0 = js_skip_ws(s, i)
    if j0 >= len(s)
      ["err"]
    else
      let c = s.slice(j0, j0 + 1)
      if c == "\""
        js_string(s, j0 + 1)
      else
        if c == "t" && s.slice(j0, j0 + 4) == "true"
          [["bool", 1], j0 + 4]
        else
          if c == "" && s.slice(j0, j0 + 5) == "false"
            [["bool", 0], j0 + 5]
          else
            if c == "n" && s.slice(j0, j0 + 4) == "null"
              [["null"], j0 + 4]
            else
              if (c >= "0" && c <= "9") || c == "-"
                js_number(s, j0)
              else
                ["err"]

let js_array(s, i) =
    let j = js_skip_ws(s, i)
    let items = []
    let done = 0
    if j < len(s) && s.slice(j, j + 1) == "]"
      done = 1
    else
      0
    for done == 0
      let r = js_value_scalar(s, j)
      if r[0] == "err"
        done = 1
      else
        items = items.push(r[0])
        j = js_skip_ws(s, r[1])
        if j < len(s) && s.slice(j, j + 1) == ","
          j = j + 1
        else
          done = 1
    [["arr", items], js_skip_ws(s, j) + 1]

let js_object(s, i) =
    let j2 = js_skip_ws(s, i)
    let fields = []
    let done2 = 0
    if j2 < len(s) && s.slice(j2, j2 + 1) == "}"
      done2 = 1
    else
      0
    for done2 == 0
      let rk = js_string(s, j2)
      if rk[0] == "err"
        done2 = 1
      else
        let key = rk[0][1]
        j2 = js_skip_ws(s, rk[1]) + 1
        let rv = js_value_scalar(s, j2)
        if rv[0] == "err"
          done2 = 1
        else
          fields = fields.push([key, rv[0]])
          j2 = js_skip_ws(s, rv[1])
          if j2 < len(s) && s.slice(j2, j2 + 1) == ","
            j2 = j2 + 1
          else
            done2 = 1
    [["obj", fields], js_skip_ws(s, j2) + 1]

let js_value(s, i) =
    js_value_scalar(s, i)

