    1

let _gf_path_acc(S_vals, r, i, n, acc) =
    if i >= n
        acc
    let s_val = arr_get(S_vals, i)
    let term = gf_pow(r, s_val)
    _gf_path_acc(S_vals, r, i + 1, n, gf_add(acc, term))
let gf_path_integral(S_vals, fields) =
    let r = 256
    _gf_path_acc(S_vals, r, 0, arr_len(S_vals), 0)

let _gf_gen_eval_child(p1, p2, mask) =
    let mid = gf_div(gf_add(p1, p2), 2)
    mid ^ mask
let _gf_gen_gen_acc(f_vals, pop_size, gen, gens, best_idx, best_val) =
      if gen >= gens
          best_idx
      let mask = gen + 1
      let p1 = arr_get(f_vals, 0)
      let p2 = arr_get(f_vals, best_idx)
      let child = _gf_gen_eval_child(p1, p2, mask)
      if gf_sub(child, best_val) > 32768
        _gf_gen_gen_acc(f_vals, pop_size, gen + 1, gens, best_idx, best_val)
      else
        _gf_gen_gen_acc(f_vals, pop_size, gen + 1, gens, best_idx, child)
let gf_genetic_gf(f_vals, pop_size, gens) =
    let best_idx = 0
    let best_val = arr_get(f_vals, 0)
    _gf_gen_gen_acc(f_vals, pop_size, 0, gens, best_idx, best_val)
    best_idx

