let convergence_rate(f_id, x0, n) =
    let result = _conv_rate_acc(f_id, x0, n, 0, 0)
    result
let _conv_rate_acc(f_id, x, n, i, total_diff) =
    if i >= n
        total_diff
    let next = host_call(f_id, x, 0)
    let diff = gf_sub(next, x)
    _conv_rate_acc(f_id, next, n, i + 1, gf_add(total_diff, diff))

let convergence_test(f_id, x0) = sb2_prove_termination(f_id, x0)

let monotonicity_check(f_id, x0, n) = _mono_acc(f_id, x0, n, 0)
let _mono_acc(f_id, x, n, i) =
    if i >= n
        1
    let next = host_call(f_id, x, 0)
    if next < x
        0
    _mono_acc(f_id, next, n, i + 1)
