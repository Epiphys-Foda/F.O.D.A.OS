let sc2_pass_terminate(pass_fn_id, ast, max_steps) =
    _sc2_pass_acc(pass_fn_id, ast, max_steps, 0)
let _sc2_pass_acc(pass_fn_id, prev, max, count) =
    if count >= max
      let v = arr_new_n(2)
      arr_set(v, 0, count)
      arr_set(v, 1, prev)
      v
    let next = host_call(pass_fn_id, prev, 0)
    if ast_equal(next, prev)
      let v = arr_new_n(2)
      arr_set(v, 0, count + 1)
      arr_set(v, 1, next)
      v
    _sc2_pass_acc(pass_fn_id, next, max, count + 1)

let ast_equal(a, b) = ((a == b) ? (1) : (0))

let sc2_upper_bound() = 65537

let sc2_prove_pass_terminates(pass_fn_id, ast) =
    let max = sc2_upper_bound()
    let result = sc2_pass_terminate(pass_fn_id, ast, max)
    let steps = arr_get(result, 0)
    let fixed = arr_get(result, 1)
    let next = host_call(pass_fn_id, fixed, 0)
    ((ast_equal(next, fixed) == 1) ? (1) : (0))

let sc2_pass_steps_estimate(pass_fn_id, ast) =
    let max = sc2_upper_bound()
    let result = sc2_pass_terminate(pass_fn_id, ast, max)
    arr_get(result, 0)

let sc3_compose(pass1_id, pass2_id, ast) =
    let max = sc2_upper_bound()
    let r1 = sc2_pass_terminate(pass1_id, ast, max)
    let steps1 = arr_get(r1, 0)
    let ast1 = arr_get(r1, 1)
    let r2 = sc2_pass_terminate(pass2_id, ast1, max)
    let steps2 = arr_get(r2, 0)
    let ast2 = arr_get(r2, 1)
    let total = gf_add(steps1, steps2)
    let v = arr_new_n(2)
    arr_set(v, 0, total)
    arr_set(v, 1, ast2)
    v

let sc3_commute_check(pass1_id, pass2_id, ast) =
    let r12 = sc3_compose(pass1_id, pass2_id, ast)
    let r21 = sc3_compose(pass2_id, pass1_id, ast)
    let ast12 = arr_get(r12, 1)
    let ast21 = arr_get(r21, 1)
    ((ast_equal(ast12, ast21) == 1) ? (1) : (0))

let sc3_compose_n(pass_ids, ast) =
    let n = arr_len(pass_ids)
    _sc3_compose_n_acc(pass_ids, ast, n, 0, 0)
let _sc3_compose_n_acc(pass_ids, ast, n, i, total_steps) =
    if i >= n
      let v = arr_new_n(2)
      arr_set(v, 0, total_steps)
      arr_set(v, 1, ast)
      v
    let pass_id = arr_get(pass_ids, i)
    let max = sc2_upper_bound()
    let r = sc2_pass_terminate(pass_id, ast, max)
    let steps = arr_get(r, 0)
    let new_ast = arr_get(r, 1)
    _sc3_compose_n_acc(pass_ids, new_ast, n, i + 1, gf_add(total_steps, steps))

let sc3_pipeline_optimal(pass_ids, ast) =
    let n = arr_len(pass_ids)
    let sorted = _sc3_sort_by_steps(pass_ids, ast, n)
    sc3_compose_n(sorted, ast)

let _sc3_sort_by_steps(pass_ids, ast, n) = pass_ids

let pf9_compile_time_bound(source_size, pass_count) =
    let p = 65537
    let c = 1
    gf_mul(gf_mul(gf_mul(c, source_size), pass_count), p)

let pf9_pass_time(pass_id, ast_size) = gf_mul(ast_size, 65537)

let pf9_optimization_time(ast_size, pass_count) = pf9_compile_time_bound(ast_size, pass_count)

let pf9_codegen_time(ast_size) = ast_size

let pf9_total_time(source_size, pass_count) =
    let lex_time = source_size
    let parse_time = source_size
    let opt_time = pf9_optimization_time(source_size, pass_count)
    let codegen_time = pf9_codegen_time(source_size)
    gf_add(gf_add(gf_add(lex_time, parse_time), opt_time), codegen_time)

let pf9_predict_compile_time(source_size, pass_count) =
    let total_ops = pf9_total_time(source_size, pass_count)
    total_ops / 1000000

let prove_by_induction(predicate_fn_id, base_case, max_n) =
    let base_ok = host_call(predicate_fn_id, base_case, 0)
    if base_ok == 0
        0
    _induction_acc(predicate_fn_id, base_case, max_n, base_case)
let _induction_acc(pred, current, max_n, last) =
    if current >= max_n
        1
    let next_ok = host_call(pred, current + 1, 0)
    if next_ok == 0
        0
    _induction_acc(pred, current + 1, max_n, next_ok)

let prove_by_contradiction(assumption_fn_id, contradiction_fn_id, x) =
    let assume = host_call(assumption_fn_id, x, 0)
    let contra = host_call(contradiction_fn_id, x, 0)
    ((assume != 0 && contra != 0) ? (1) : (0))

let prove_by_exhaustion(predicate_fn_id, n) = _exhaust_acc(predicate_fn_id, n, 0)
let _exhaust_acc(pred, n, i) =
    if i >= n
        1
    let ok = host_call(pred, i, 0)
    if ok == 0
        0
    _exhaust_acc(pred, n, i + 1)

