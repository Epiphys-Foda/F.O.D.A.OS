let sb2_iterate_until_fixed(f_id, x0, max_steps) =
    _sb2_iter_acc(f_id, x0, x0, max_steps, 0)
let _sb2_iter_acc(f_id, prev, x0, max, count) =
    if count >= max
      let v = arr_new_n(2)
      arr_set(v, 0, count)
      arr_set(v, 1, prev)
      v
    let next = host_call(f_id, prev, 0)
    if next == prev
      let v = arr_new_n(2)
      arr_set(v, 0, count + 1)
      arr_set(v, 1, next)
      v
    _sb2_iter_acc(f_id, next, x0, max, count + 1)

let sb2_termination_bound(p) = 2 * p

let sb2_prove_termination(f_id, x0) =
    let max = sb2_termination_bound(65537)
    let result = sb2_iterate_until_fixed(f_id, x0, max)
    let steps = arr_get(result, 0)
    let fixed = arr_get(result, 1)
    let next = host_call(f_id, fixed, 0)
    ((next == fixed) ? (1) : (0))

let sb2_cycle_length(f_id, x0) =
    let max = sb2_termination_bound(65537)
    let result = sb2_iterate_until_fixed(f_id, x0, max)
    let steps = arr_get(result, 0)
    let fixed = arr_get(result, 1)
    if steps >= max
      _sb2_cycle_acc(f_id, fixed, fixed, 0, 1)
    1
let _sb2_cycle_acc(f_id, start, current, count, max) =
    if count >= max
        count
    let next = host_call(f_id, current, 0)
    if next == start
        count + 1
    _sb2_cycle_acc(f_id, start, next, count + 1, max)

