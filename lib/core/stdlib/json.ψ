let json_serialize(v) =
    let tag = v[0]
    if tag == 0
        "null"
    else
        0
    if tag == 1
        (v[1] == 0 ? "false" : "true")
    else
            0
    if tag == 2
        let n = v[1]
        if n < 0
            "-" + "0"
        else
            "0"
    else
        0
    if tag == 3
        "\"" + v[1] + "\""
    else
        0
    if tag == 4
        let elements = v[1]
        let result = "["
        let n = elements.len()
        let i = 0
        for i < n
            if i > 0
                result = result + ","
            result = result + json_serialize(elements[i])
            i = i + 1
        result = result + "]"
        result
    if tag == 5
        let pairs = v[1]
        let result = str_concat(str_concat("", chr(123)), "")
        let n = pairs.len()
        let i = 0
        for i < n
            if i > 0
                result = result + ","
            let pair = pairs[i]
            result = result + "\"" + pair[0] + "\":" + json_serialize(pair[1])
            i = i + 1
        result = result + "}"
        result

let json_skip_whitespace(s, pos) =
    let p = pos
    let n = s.len()
    for p < n
        let c = s[p]
        if c == 32 || c == 9 || c == 10 || c == 13
            p = p + 1
        else
            p = n
    p

let json_parse_number(s, pos) =
    let p = pos
    let n = s.len()
    let neg = 0
    if p < n && s[p] == 45
        neg = 1
        p = p + 1
    let val = 0
    for p < n
        let c = s[p]
        if c >= 48 && c <= 57
            val = val * 10 + (c - 48)
            p = p + 1
        else
            p = n
    if neg == 1
        val = 0 - val
    let result = arr_new()
    result = arr_push(result, val)
    result = arr_push(result, p)
    result

let json_build_object(keys, values) =
    let pairs = arr_new()
    let i = 0
    let n = keys.len()
    for i < n
        let pair = arr_new()
        pair = arr_push(pair, keys[i])
        pair = arr_push(pair, values[i])
        pairs = arr_push(pairs, pair)
        i = i + 1
    json_object(pairs)

let json_build_array(items) = json_array(items)

let json_pretty(v, indent) =
    let pad = ""
    let i = 0
    for i < indent
        pad = pad + "  "
        i = i + 1
    let tag = v[0]
    if tag == 0
        "null"
    else
        0
    if tag == 1
        (v[1] == 0 ? "false" : "true")
    else
            0
    if tag == 2
        "0"
    else
        0
    if tag == 3
        "\"" + v[1] + "\""
    else
        0
    if tag == 4
        let elements = v[1]
        let n = elements.len()
        if n == 0
            return "[]"
        let result = "[\n"
        let i = 0
        for i < n
            result = result + pad + "  " + json_pretty(elements[i], indent + 1)
            if i < n - 1
                result = result + ","
            result = result + "\n"
            i = i + 1
        result = result + pad + "]"
        result
    if tag == 5
        let pairs = v[1]
        let n = pairs.len()
        if n == 0
            return str_concat(str_concat("", chr(123)), "}")
        let result = str_concat(str_concat("", chr(123)), "\n")
        let i = 0
        for i < n
            let pair = pairs[i]
            result = result + pad + "  \"" + pair[0] + "\": " + json_pretty(pair[1], indent + 1)
            if i < n - 1
                result = result + ","
            result = result + "\n"
            i = i + 1
        result = result + pad + "}"
        result

