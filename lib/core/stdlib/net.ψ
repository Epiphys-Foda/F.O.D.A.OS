let url_encode(s) =
    let result = ""
    let i = 0
    for i < s.len()
        let c = str_char_at(s, i)
        if c == " "
            result = str_append(result, "%20")
        else
            0
        if c == "/"
            result = str_append(result, "%2F")
        else
            0
        if c == "?"
            result = str_append(result, "%3F")
        else
            0
        if c == "&"
            result = str_append(result, "%26")
        else
            0
        if c == "="
            result = str_append(result, "%3D")
        else
            result = str_append(result, str_from_char(c))
        i = i + 1
    result

let url_decode(s) =
    let result = ""
    let i = 0
    for i < s.len()
        let c = str_char_at(s, i)
        if c == "%" && i + 2 < s.len()
            let hex = str_substring(s, i + 1, 2)
            if hex == "20"
                result = str_append(result, " ")
            else
                0
            if hex == "2F"
                result = str_append(result, "/")
            else
                0
            if hex == "3F"
                result = str_append(result, "?")
            else
                0
            if hex == "26"
                result = str_append(result, "&")
            else
                0
            if hex == "3D"
                result = str_append(result, "=")
            else
                result = str_append(result, str_from_char(c))
            i = i + 2
        else
            result = str_append(result, str_from_char(c))
        i = i + 1
    result

let query_string_parse(qs) =
    let result = []
    let pairs = str_split(qs, "&")
    let i = 0
    for i < pairs.len()
        let kv = str_split(pairs[i], "=")
        result = arr_concat(result, [kv[0]])
        if kv.len() > 1
            result = arr_concat(result, [kv[1]])
        else
            result = arr_concat(result, [""])
        i = i + 1
    result

