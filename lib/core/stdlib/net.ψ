import "str.ψ"

let url_parse(url) =
    let protocol = ""
    let host = ""
    let port = 80
    let path = "/"
    let colon_slash = str_find(url, "://")
    if colon_slash >= 0
        protocol = str_substring(url, 0, colon_slash)
        let rest = str_substring(url, colon_slash + 3, url.len() - colon_slash - 3)
        let colon = str_find(rest, ":")
        let slash = str_find(rest, "/")
        if colon >= 0 && (slash < 0 || colon < slash)
            host = str_substring(rest, 0, colon)
            let after_colon = str_substring(rest, colon + 1, rest.len() - colon - 1)
            let slash2 = str_find(after_colon, "/")
            if slash2 >= 0
                port = str_to_int(str_substring(after_colon, 0, slash2))
                path = str_substring(after_colon, slash2, after_colon.len() - slash2)
            else
                port = str_to_int(after_colon)
        else
            0
        if slash >= 0
            host = str_substring(rest, 0, slash)
            path = str_substring(rest, slash, rest.len() - slash)
        else
            host = rest
    [protocol, host, port, path]

