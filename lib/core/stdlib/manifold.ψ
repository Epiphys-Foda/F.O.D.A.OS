let exponential_map(tangent, point, t) =
    let result = []
    let i = 0
    for i < point.len()
        result = arr_concat(result, [point[i] + t * tangent[i] / 1000])
        i = i + 1
    result

let volume_element(metric, n) =
    if n == 2
        let det = metric[0] * metric[3] / 1000 - metric[1] * metric[2] / 1000
        isqrt(det * 1000)
    else
        1000

