let base_double(x) = x * 2
let base_inc(x) = x + 1
let base_square(x) = x * x

let DEC_LOG = 1
let DEC_MEMO = 2
let DEC_RETRY = 3

let base_apply(base_id, x) =
    let r = 0
    if base_id == 1
        r = base_double(x)
    if base_id == 2
        r = base_inc(x)
    if base_id == 3
        r = base_square(x)
    r

let decorator_log(base_id, x, log, idx) =
    let result = base_apply(base_id, x)
    log[idx] = result
    result

let memoized_call(cache_keys, cache_vals, hits, base_id, x) =
    let n = len(cache_keys)
    let found = 0 - 1
    let i = 0
    for i < n
        if found < 0
            if cache_keys[i] == base_id * 100000 + x
                found = i
        i = i + 1
    let r = 0
    if found >= 0
        r = cache_vals[found]
        hits[0] = hits[0] + 1
    if found < 0
        r = base_apply(base_id, x)
        cache_keys[n] = base_id * 100000 + x
        cache_vals[n] = r
    r

let retry_call(base_id, x, max_retries) =
    let attempts = 0
    let result = 0
    let success = 0
    for attempts < max_retries
        if success == 0
            result = base_apply(base_id, x)
            if result != 0
                success = 1
        attempts = attempts + 1
    result

let compose2(outer_id, inner_id, x) =
    base_apply(outer_id, base_apply(inner_id, x))

