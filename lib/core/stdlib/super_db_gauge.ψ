import "super_db.ψ"
let rf_dbg_gg(db, x, y) =
    let h = x * 1000 + y
    let hr = h - (h / 65537) * 65537
    [[1, hr], [0, 1]]

let rf_dbg_transform(db, g) =
    let out = []
    let i = 0
    let done = false
    for !done
      if i + 2 < len(db)
        out = out.push(db[i])
        out = out.push(db[i + 1])
        out = out.push(db[i + 2])
        i = i + 3
      else
        done = true
    out

let rf_dbg_wilson(db, path) =
    let acc = 0
    let i = 0
    let done = false
    for !done
      if i + 1 < len(path)
        let g = rf_dbg_gg(db, path[i], path[i + 1])
        let h = g[0][1]
        acc = acc + h - (h / 65537) * 65537
        i = i + 2
      else
        done = true
    acc

let rf_dbg_invariant(db, g, px, py) =
    let v1 = rf_db_field(db, px, py)
    let db2 = rf_dbg_transform(db, g)
    let v2 = rf_db_field(db2, px, py)
    [v1, v2]

let rf_dbg_link(db, a, b) =
    let i = 0
    let done = false
    let links = 0
    for !done
      if i + 2 < len(db)
        if db[i] == a && db[i + 1] == b
          links = links + 1
        else
          0
        i = i + 3
      else
        done = true
    links

let rf_dbg_verify(db, g, px, py) =
    let iv = rf_dbg_invariant(db, g, px, py)
    [iv[0], iv[1]]

let rf_dbg_test() =
    let db = [0, 0, 100]
    let g1 = rf_dbg_gg(db, 3, 4)
    let t1 = g1[0][1] == 3004
    let t2 = rf_dbg_wilson(db, [1, 0, 2, 0]) == 3000
    let iv = rf_dbg_invariant(db, [[1, 5], [0, 1]], 0, 0)
    let t3 = iv[0] == iv[1]
    let t4 = rf_dbg_link(db, 0, 0) == 1
    let cv = rf_dbg_verify(db, [[1, 7], [0, 1]], 1, 1)
    let t5 = cv[0] == cv[1]
    t1 && t2 && t3 && t4 && t5
