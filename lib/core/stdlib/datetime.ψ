let days_in_month(year, month) =
    if month == 1 || month == 3 || month == 5 || month == 7 || month == 8 || month == 10 || month == 12
        31
    else
        0
    if month == 4 || month == 6 || month == 9 || month == 11
        30
    else
        0
    if month == 2
        (is_leap_year(year) ? 29 : 28)
    else
            0
        0

let is_leap_year(year) =
    (year % 4 == 0 && year % 100 != 0) || year % 400 == 0

let day_of_year(year, month, day) =
    let doy = day
    let m = 1
    for m < month
        doy = doy + days_in_month(year, m)
        m = m + 1
    doy

let day_of_week(year, month, day) =
    let y = year
    let m = month
    if m < 3
        m = m + 12
        y = y - 1
    let k = y % 100
    let j = y / 100
    let h = (day + 13 * (m + 1) / 5 + k + k / 4 + j / 4 + 5 * j) % 7
    (h + 6) % 7

let date_to_days(year, month, day) =
    let days = 0
    let y = 1
    for y < year
        if is_leap_year(y)
            days = days + 366
        else
            days = days + 365
        y = y + 1
    days + day_of_year(year, month, day) - 1

let days_to_date(days) =
    let remaining = days
    let year = 1
    let days_in_year = 365
    if is_leap_year(year)
        days_in_year = 366
    for remaining >= days_in_year
        remaining = remaining - days_in_year
        year = year + 1
        days_in_year = 365
        if is_leap_year(year)
            days_in_year = 366
    let month = 1
    let dim = days_in_month(year, month)
    for remaining >= dim
        remaining = remaining - dim
        month = month + 1
        dim = days_in_month(year, month)
    [year, month, remaining + 1]

let date_add_days(year, month, day, n) =
    days_to_date(date_to_days(year, month, day) + n)

let date_diff(y1, m1, d1, y2, m2, d2) =
    date_to_days(y1, m1, d1) - date_to_days(y2, m2, d2)

let week_of_year(year, month, day) =
    let doy = day_of_year(year, month, day)
    let wday = day_of_week(year, 1, 1)
    (doy + wday - 1) / 7 + 1

let is_weekend(year, month, day) =
    let wday = day_of_week(year, month, day)
    wday == 0 || wday == 6

let time_to_seconds(hours, minutes, seconds) =
    hours * 3600 + minutes * 60 + seconds

let seconds_to_time(total) =
    let hours = total / 3600
    let remaining = total % 3600
    let minutes = remaining / 60
    let seconds = remaining % 60
    [hours, minutes, seconds]

let timestamp_now() =
    host_call(60)

let format_date(year, month, day) =
    str_concat(str(year), str_concat("-", str_concat(str(month), str_concat("-", str(day)))))

let format_time(hours, minutes, seconds) =
    str_concat(str(hours), str_concat(":", str_concat(str(minutes), str_concat(":", str(seconds)))))

