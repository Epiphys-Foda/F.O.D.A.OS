let qec_encode3(b) = [b, b, b]

let qec_xor(a, b) =
    if a == b
      0
    else
      1

let qec_flip(code, i) =
    let c = [code[0], code[1], code[2]]
    if i == 0
      c = [qec_xor(c[0], 1), c[1], c[2]]
    if i == 1
      c = [c[0], qec_xor(c[1], 1), c[2]]
    if i == 2
      c = [c[0], c[1], qec_xor(c[2], 1)]
    c

let qec_syndrome(code) =
    let s0 = qec_xor(code[0], code[1])
    let s1 = qec_xor(code[1], code[2])
    [s0, s1]

let qec_correct(code) =
    let s = qec_syndrome(code)
    let s0 = s[0]
    let s1 = s[1]
    if s0 == 1 && s1 == 1
      qec_flip(code, 1)
    else
      if s0 == 1
        qec_flip(code, 0)
      else
        if s1 == 1
          qec_flip(code, 2)
        else
          code

let qec_decode(code) =
    let sum = code[0] + code[1] + code[2]
    if sum >= 2
      1
    else
      0

