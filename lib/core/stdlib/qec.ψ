let qec_z3_state(b) =
    if b == 0
      [1, 1, 1, 1, 1, 1, 1, 1]
    else
      [1, 65536, 65536, 1, 65536, 1, 1, 65536]

let qec_bit(j, i) =
    if i == 0
      (j / 4) % 2 == 1
    else
      if i == 1
        (j / 2) % 2 == 1
      else
        j % 2 == 1

let qec_z3_apply(state, i) =
    let out = []
    let j = 0
    let done = false
    for !done
      if j < 8
        if qec_bit(j, i)
          out = out.push((65537 - state[j]) % 65537)
        else
          out = out.push(state[j])
        j = j + 1
      else
        done = true
    out

let qec_z3_measure(state) =
    let h8 = qs_hh8()
    let cb = qs_matvec8(h8, state)
    let idx = qs_measure_det(cb)
    let b0 = idx / 4
    let b1 = (idx / 2) % 2
    let b2 = idx % 2
    [b0, b1, b2]

