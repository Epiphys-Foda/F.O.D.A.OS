let qq_lower_to_micro(qq_opcode) =
    if qq_opcode == QQ_GFMUL
        10
    else
      if qq_opcode == QQ_CLIFFORD
          22
      else
        if qq_opcode == QQ_NTT
            30
        else
          if qq_opcode == QQ_BORN
              40
          else
            if qq_opcode == QQ_HEBBIAN
                50
            else
              if qq_opcode == QQ_TOKEN
                  16
              else
                if qq_opcode == QQ_EMIT
                    17
                else
                  if qq_opcode == QQ_END
                      255
                  else
                      0

let qq_layer1_name(qq_opcode) =
    let micro_op = qq_lower_to_micro(qq_opcode)
    if micro_op == 10
        "MUL_GF"
    else
      if micro_op == 22
          "PROD_CL"
      else
        if micro_op == 30
            "FFT_FWD"
        else
          if micro_op == 40
              "PROJ_HOM"
          else
            if micro_op == 50
                "DIFF_FWD"
            else
              if micro_op == 16
                  "TOKEN"
              else
                if micro_op == 17
                    "EMIT"
                else
                  if micro_op == 255
                      "END"
                  else
                      "?"
