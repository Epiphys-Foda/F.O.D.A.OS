let vj_jump(x, y, z, dir) =
    if dir == 0
      3 * y * z - x
    else
      if dir == 1
        3 * x * z - y
      else
        3 * x * y - z

let vj_markov_check(x, y, z) = x * x + y * y + z * z == 3 * x * y * z

let vj_sort3(a, b, c) =
    let x = a
    let y = b
    let z = c
    if x > y
      let t = x
      x = y
      y = t
    else
      0
    if y > z
      let t = y
      y = z
      z = t
    else
      0
    if x > y
      let t = x
      x = y
      y = t
    else
      0
    [x, y, z]

let vj_in_seen(seen, t) =
    let found = false
    let i = 0
    let done = false
    for !done
      if i < len(seen)
        let s = seen[i]
        if s[0] == t[0] && s[1] == t[1] && s[2] == t[2]
          found = true
        else
          0
        i = i + 1
      else
        done = true
    found

let vj_markov_tree(depth) =
    let queue = [[1, 1, 1]]
    let seen = [[1, 1, 1]]
    let out = [[1, 1, 1]]
    let d = 0
    let done = false
    for !done
      if d < depth
        let next = []
        let i = 0
        let idone = false
        for !idone
          if i < len(queue)
            let t = queue[i]
            let j = 0
            let jdone = false
            for !jdone
              if j < 3
                let nv = vj_jump(t[0], t[1], t[2], j)
                if nv > 0
                  let cand = j == 0 ? vj_sort3(nv, t[1], t[2]) : (j == 1 ? vj_sort3(t[0], nv, t[2]) : vj_sort3(t[0], t[1], nv))
                  if !vj_in_seen(seen, cand)
                    seen = seen.push(cand)
                    next = next.push(cand)
                    out = out.push(cand)
                j = j + 1
              else
                jdone = true
            i = i + 1
          else
            idone = true
        queue = next
        d = d + 1
      else
        done = true
    out

let vj_markov_nums(depth) =
    let tree = vj_markov_tree(depth)
    let nums = []
    let i = 0
    let done = false
    for !done
      if i < len(tree)
        let t = tree[i]
        let j = 0
        let jdone = false
        for !jdone
          if j < 3
            let v = t[j]
            if !vj_in_nums(nums, v)
              nums = nums.push(v)
            else
              0
            j = j + 1
          else
            jdone = true
        i = i + 1
      else
        done = true
    vj_sort_nums(nums)

let vj_in_nums(nums, v) =
    let found = false
    let i = 0
    let done = false
    for !done
      if i < len(nums)
        if nums[i] == v
          found = true
        else
          0
        i = i + 1
      else
        done = true
    found

let vj_sort_nums(nums) =
    let out = []
    let i = 0
    let done = false
    for !done
      if i < len(nums)
        let v = nums[i]
        let ins = false
        let j = 0
        let jdone = false
        for !jdone
          if j < len(out)
            if !ins
              if v < out[j]
                out = [out.slice(0, j), v, out.slice(j, len(out))].flat()
                ins = true
              else
                  0
            else
              0
            j = j + 1
          else
            jdone = true
        if !ins
          out = out.push(v)
        else
          0
        i = i + 1
      else
        done = true
    out

let vj_verify() =
