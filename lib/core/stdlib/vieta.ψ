          has_29 = true
        else
          0
        if t[0] == 1 && t[1] == 5 && t[2] == 13
          has_13 = true
        else
          0
        i = i + 1
      else
        done = true
    results = results.push(has_29)
    results = results.push(has_13)
    let all_ok = true
    let i2 = 0
    let done2 = false
    for !done2
      if i2 < len(tree)
        let t = tree[i2]
        if !vj_markov_check(t[0], t[1], t[2])
          all_ok = false
        else
          0
        i2 = i2 + 1
      else
        done2 = true
    results = results.push(all_ok)
    let nums = vj_markov_nums(3)
    let has_seq = true
    if !vj_in_nums(nums, 1)
      has_seq = false
    else
      0
    if !vj_in_nums(nums, 2)
      has_seq = false
    else
      0
    if !vj_in_nums(nums, 5)
      has_seq = false
    else
      0
    if !vj_in_nums(nums, 13)
      has_seq = false
    else
      0
    if !vj_in_nums(nums, 29)
      has_seq = false
    else
      0
    results = results.push(has_seq)
    let total = true
    let i3 = 0
    let done3 = false
    for !done3
      if i3 < len(results)
        let v = results[i3]
        if v == false
          total = false
        else
          0
        i3 = i3 + 1
      else
        done3 = true
    results = results.push(total)
