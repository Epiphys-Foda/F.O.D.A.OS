let rel32_bytes(v) =
    let u = v
    if u < 0
      u = u + 4294967296
    else
      0
    let b0 = u - (u / 256) * 256
    let v1 = u / 256
    let b1 = v1 - (v1 / 256) * 256
    let v2 = v1 / 256
    let b2 = v2 - (v2 / 256) * 256
    let b3 = v2 / 256
    [b0, b1, b2, b3]

let aot_patch(x86_code, patch_pos, target) =
    let tb = rel32_bytes(target)
    [x86_code.slice(0, patch_pos), tb, x86_code.slice(patch_pos + 4, len(x86_code))].flat()

let aot_sort_patches(ps) =
    let sp = []
    let rem = ps
    for len(rem) > 0
      let best = 0
      let bj = 1
      for bj < len(rem)
        if rem[bj][0] < rem[best][0]
          best = bj
        else
          0
        bj = bj + 1
      sp = sp.push(rem[best])
      rem = [rem.slice(0, best), rem.slice(best + 1, len(rem))].flat()
    sp

let aot_apply_patches(code, patches) =
    let c = code
    if len(patches) > 0
      let sp = aot_sort_patches(patches)
      let parts = []
      let prev = 0
      let pi = 0
      for pi < len(sp)
        let p = sp[pi]
        let pos = p[0]
        parts = parts.push(c.slice(prev, pos))
        parts = parts.push(rel32_bytes(p[1]))
        prev = pos + 4
        pi = pi + 1
      parts = parts.push(c.slice(prev, len(c)))
      c = parts.flat()
    else
      0
    c

let aot_br(x86_code, label_idx, block_starts, loop_heads) =
    if label_idx != 0
      [x86_code, block_starts]
    else
      if len(loop_heads) > 0
        let head = loop_heads[loop_heads.len() - 1]
        let seg = [X86_JMP_REL32, 0, 0, 0, 0].flat()
        let code2 = [x86_code, seg].flat()
        let patch_pos = len(code2) - 4
        let target = head - (patch_pos + 4)
        [aot_patch(code2, patch_pos, target), block_starts]
      else
        [x86_code, block_starts]

let aot_br_if(x86_code, label_idx, loop_heads, block_depth, exit_patches) =
    let seg = [X86_POP_RAX, X86_TEST_RAX_RAX, X86_JNZ_REL32, 0, 0, 0, 0].flat()
    let code2 = [x86_code, seg].flat()
    if label_idx == 1
      [code2, exit_patches.push([len(code2) - 4, block_depth])]
    else
      if len(loop_heads) > 0
        let head = loop_heads[loop_heads.len() - 1]
        let patch_pos = len(code2) - 4
        let target = head - (patch_pos + 4)
        [aot_patch(code2, patch_pos, target), exit_patches]
      else
        [code2, exit_patches]

let imm32_bytes(v) =
    let u = v
    if u < 0
      u = u + 4294967296
    else
      0
    let b0 = u - (u / 256) * 256
    let v1 = u / 256
    let b1 = v1 - (v1 / 256) * 256
    let v2 = v1 / 256
    let b2 = v2 - (v2 / 256) * 256
    let b3 = v2 / 256
    [104, b0, b1, b2, b3]

let imm32_bytesslice(v, lo, hi) =
    let b = imm32_bytes(v)
    let out = []
    let k = lo
    let d = false
    for !d
      if k < hi
        out = out.push(b[k])
        k = k + 1
      else
        d = true
    out

