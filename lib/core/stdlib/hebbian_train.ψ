let H_DEFAULT_EPSILON = 0.01

let H_DEFAULT_LAMBDA = 0.001

let H_INFER_FORWARD_ID = 100

let h_c_mul(a, b) =
    let re = a[0] * b[0] - a[1] * b[1]
    let im = a[0] * b[1] + a[1] * b[0]
    [re, im]

let h_c_conj(a) = [a[0], 0.0 - a[1]]

let h_c_im(a) = a[1] + 0.0

let h_c_add(a, b) = [a[0] + b[0], a[1] + b[1]]

let h_c_sub(a, b) = [a[0] - b[0], a[1] - b[1]]

let h_c_scale(a, s) = [a[0] * s, a[1] * s]

let train_init(model) = host_obj_store(model)

let train_infer(model_id, input_id) = host_call(H_INFER_FORWARD_ID, model_id, input_id)

let train_hebbian_update(model, input, output, target, epsilon, lambda) =
    let new_model = []
    let j = 0
    let n = len(model)
    for j < n
      let m = model[j]
      let inp = input[j]
      let out = output[j]
      let tgt = target[j]
      let im_phase_diff = inp[0] * out[1] - inp[1] * out[0]
      let err_im = tgt[1] - out[1]
      let theta_j = m[1] + 0.0
      let sin_theta = theta_j
      let d_theta = epsilon * (im_phase_diff + err_im) - lambda * sin_theta
      let new_node = [m[0], m[1] + d_theta]
      new_model = new_model.push(new_node)
      j = j + 1
    new_model

let train_loop(model, data, targets, epochs, epsilon, lambda) =
    let m = model
    let epoch = 0
    for epoch < epochs
      let i = 0
      let n_samples = len(data)
      for i < n_samples
        let x = data[i]
        let target = targets[i]
        let y = []
        let k = 0
        let dim = len(m)
        for k < dim
          let yk = h_c_mul(m[k], x[k])
          y = y.push(yk)
          k = k + 1
          0
        m = train_hebbian_update(m, x, y, target, epsilon, lambda)
        i = i + 1
      epoch = epoch + 1
    m

