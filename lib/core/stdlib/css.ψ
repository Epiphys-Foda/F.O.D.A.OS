let css_syndrome(code, H) =
    let out = []
    let r = 0
    let done = false
    for !done
      if r < len(H)
        let row = H[r]
        let acc = 0
        let j = 0
        let jdone = false
        for !jdone
          if j < len(row)
            acc = qec_xor(acc, code[row.get(j)])
            j = j + 1
          else
            jdone = true
        out = out.push(acc)
        r = r + 1
      else
        done = true
    out

let css_build_table(H, n) =
