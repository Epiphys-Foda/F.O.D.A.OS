let imm32_bytes(v) =
    let u = v
    let b0 = u - (u / 256) * 256
    let u1 = u / 256
    let b1 = u1 - (u1 / 256) * 256
    let u2 = u1 / 256
    let b2 = u2 - (u2 / 256) * 256
    let b3 = u2 / 256
    [b0, b1, b2, b3]

let qbc_push_local(idx) =
    if idx == 0
      X86_PUSH_R9
    else
      if idx == 1
        X86_PUSH_R10
      else
        if idx == 2
          X86_PUSH_R11
        else
          if idx == 3
            X86_PUSH_R12
          else
            if idx == 4
              X86_PUSH_R13
            else
              if idx == 5
                X86_PUSH_R14
              else
                X86_PUSH_R15

let qbc_pop_local(idx) =
    if idx == 0
      X86_POP_R9
    else
      if idx == 1
        X86_POP_R10
      else
        if idx == 2
          X86_POP_R11
        else
          if idx == 3
            X86_POP_R12
          else
            if idx == 4
              X86_POP_R13
            else
              if idx == 5
                X86_POP_R14
              else
                X86_POP_R15

let rel32_bytes(v) =
    let u = v
    let b0 = u - (u / 256) * 256
    let u1 = u / 256
    let b1 = u1 - (u1 / 256) * 256
    let u2 = u1 / 256
    let b2 = u2 - (u2 / 256) * 256
    let b3 = u2 / 256
    [b0, b1, b2, b3]

let aot_patch(x86_code, patch_pos, target) =
    let tb = rel32_bytes(target)
    [x86_code.slice(0, patch_pos), tb, x86_code.slice(patch_pos + 4, len(x86_code))].flat()

let qbc_to_x86_64(qbc) =
