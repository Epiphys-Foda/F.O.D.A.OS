    (seed * 1103515245 + 12345) % 2147483648 % max

let tournament_selection(population, fitnesses, k, seed) =
    let best_idx = 0
    let best_fit = -999999999
    let s = seed
    let i = 0
    for i < k
        s = (s * 1103515245 + 12345) % 2147483648
        let idx = s % population.len()
        if fitnesses[idx] > best_fit
            best_fit = fitnesses[idx]
            best_idx = idx
        i = i + 1
    [best_idx, s]

let roulette_selection(fitnesses, seed) =
    let total = 0
    let i = 0
    for i < fitnesses.len()
        total = total + fitnesses[i]
        i = i + 1
    if total == 0
        [0, seed]
    else
        let s = (seed * 1103515245 + 12345) % 2147483648
        let r = s % total
        let cumsum = 0
        let idx = 0
        let i = 0
        for i < fitnesses.len()
            cumsum = cumsum + fitnesses[i]
            if cumsum >= r
                idx = i
                i = fitnesses.len()
            i = i + 1
        [idx, s]

