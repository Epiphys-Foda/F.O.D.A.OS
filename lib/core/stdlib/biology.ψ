import "str.ψ"

let dna_complement(base) =
    if base == "A"
        "T"
    else
        0
    if base == "T"
        "A"
    else
        0
    if base == "G"
        "C"
    else
        0
    if base == "C"
        "G"
    else
        base

let dna_reverse_complement(sequence) =
    let result = ""
    let i = sequence.len() - 1
    for i >= 0
        let base = str_char_at(sequence, i)
        let comp = dna_complement(base)
        result = str_append(result, comp)
        i = i - 1
    result

let gc_content(sequence) =
    let gc_count = 0
    let i = 0
    for i < sequence.len()
        let base = str_char_at(sequence, i)
        if base == "G" || base == "C"
            gc_count = gc_count + 1
        i = i + 1
    gc_count * 1000 / sequence.len()

let dna_to_rna(sequence) =
    let result = ""
    let i = 0
    for i < sequence.len()
        let base = str_char_at(sequence, i)
        if base == "T"
            result = str_append(result, "U")
        else
            result = str_append(result, base)
        i = i + 1
    result

let codon_to_amino(codon) =
    if codon == "ATG"
        "M"
    else
        0
    if codon == "TAA" || codon == "TAG" || codon == "TGA"
        "*"
    else
        0
    if codon == "GCT" || codon == "GCC" || codon == "GCA" || codon == "GCG"
        "A"
    else
        0
    if codon == "TGT" || codon == "TGC"
