let _kmax_loop(trace, i, best) =
    if i >= len(trace)
        best
    else
        let k = trace[i]
        let new_best = best
        if k > best
            new_best = k
        _kmax_loop(trace, i + 1, new_best)

let trace_k_max(trace) = _kmax_loop(trace, 0, 0)

let _gears_loop(trace, i, count) =
    if i >= len(trace) - 1
        count
    else
        let k1 = trace[i]
        let k2 = trace[i + 1]
        let new_count = count
        if k1 != k2
            new_count = count + 1
        _gears_loop(trace, i + 1, new_count)

let trace_gears(trace) = _gears_loop(trace, 0, 0)

let _abs_diff(a, b) =
    if a >= b
        a - b
    else
        b - a

let _tv_loop(trace, i, total) =
    if i >= len(trace) - 1
        total
    else
        let k1 = trace[i]
        let k2 = trace[i + 1]
        _tv_loop(trace, i + 1, total + _abs_diff(k1, k2))

let trace_tv(trace) = _tv_loop(trace, 0, 0)

let _flatten_loop(trace, i, result, prev, has_prev) =
    if i >= len(trace)
        result
    else
        let k = trace[i]
        let skip = has_prev && (prev == k)
        if skip
            _flatten_loop(trace, i + 1, result, k, 1)
        else
            _flatten_loop(trace, i + 1, result.push(k), k, 1)

let trace_flatten(trace) =
    if len(trace) == 0
        []
    else
        let first = trace[0]
        _flatten_loop(trace, 1, [first], first, 1)

let _count_k(trace, i, k, count) =
    if i >= len(trace)
        count
    else
        let new_count = count
        if trace[i] == k
            new_count = count + 1
        _count_k(trace, i + 1, k, new_count)

let _max_count_loop(trace, k, best) =
    if k > 3
        best
    else
        let c = _count_k(trace, 0, k, 0)
        let new_best = best
        if c > best
            new_best = c
        _max_count_loop(trace, k + 1, new_best)

let trace_parallelism(trace) = _max_count_loop(trace, 0, 0)

let trace_summary(trace) =
    [trace_k_max(trace), trace_gears(trace), trace_tv(trace), trace_parallelism(trace)]

let gear_trace_verify() =
    let trace1 = [0, 0, 1, 1, 1, 2, 2, 1, 1]
    let trace2 = [0, 1, 2, 3]
    let trace3 = [1, 1, 1, 1]
    let trace4 = [0, 1, 0, 1, 0, 1]
    let ok1 = trace_k_max(trace1) == 2
    let ok2 = trace_k_max(trace2) == 3
    let ok3 = trace_gears(trace1) == 3
    let ok4 = trace_gears(trace3) == 0
    let ok5 = trace_tv(trace2) == 3
    let ok6 = trace_tv(trace4) == 5
    let flat1 = trace_flatten(trace1)
    let ok7 = (len(flat1) == 4) && (flat1[0] == 0) && (flat1[1] == 1) && (flat1[2] == 2) && (flat1[3] == 1)
    let ok8 = trace_parallelism(trace1) == 5
    let sum2 = trace_summary(trace2)
    let ok9 = (sum2[0] == 3) && (sum2[1] == 3) && (sum2[2] == 3) && (sum2[3] == 1)
    let ok10 = trace_gears(trace1) == trace_gears(trace_flatten(trace1))
    if ok1 && ok2 && ok3 && ok4 && ok5 && ok6 && ok7 && ok8 && ok9 && ok10
        1
    else
        0

let main() = gear_trace_verify()
