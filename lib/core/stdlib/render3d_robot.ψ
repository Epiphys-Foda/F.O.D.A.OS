import "render3d.ψ"

let rf_rdr_ik(env, sx, sy, sz, tx, ty, tz, max_steps) =
    let x = sx
    let y = sy
    let z = sz
    let i = 0
    let done = false
    for !done
      if i < max_steps
        let dx = tx - x
        let dy = ty - y
        let dz = tz - z
        let dist2 = dx * dx + dy * dy + dz * dz
        if dist2 > 4
          if dx > 0
            x = x + 1
          else
            if dx < 0
              x = x - 1
            else
              0
          if dy > 0
            y = y + 1
          else
            if dy < 0
              y = y - 1
            else
              0
          if dz > 0
            z = z + 1
          else
            if dz < 0
              z = z - 1
            else
                0
        else
          done = true
        i = i + 1
      else
        done = true
    [x, y, z]

let rf_rdr_train(env, sx, sy, sz, tx, ty, tz, max_steps) =
    let x = sx
    let y = sy
    let z = sz
    let steps = 0
    let reached = 0
    let done = false
    for !done
      if steps < max_steps
        let dx = tx - x
        let dy = ty - y
        let dz = tz - z
        let dist2 = dx * dx + dy * dy + dz * dz
        if dist2 <= 4
          reached = 1
          done = true
        else
          if dx > 0
              (x = x + 1)
          else
              (dx < 0 ? (x = x - 1) : 0)
          if dy > 0
              (y = y + 1)
          else
              (dy < 0 ? (y = y - 1) : 0)
          if dz > 0
              (z = z + 1)
          else
              (dz < 0 ? (z = z - 1) : 0)
          steps = steps + 1
      else
              0
        done = true
    [reached, steps]

let rf_rdr_reward(env, x, y, z, tx, ty, tz) =
    let dx = tx - x
    let dy = ty - y
    let dz = tz - z
    let dist2 = dx * dx + dy * dy + dz * dz
    let den = (dist2 == 0 ? 1 : dist2)
    100000 / den

let rf_rdr_avoid(env, obs, x, y, z, step) =
    let px = x
    let py = y
    let pz = z
    let i = 0
    let done = false
    for !done
      if i < step
        let hit = rf_rd3_gcd([[px, py, pz, 1]], obs, 2)
        if hit > 0
          let cur = rf_rd3_field(env, px, py, pz)
          let ex = rf_rd3_field(env, px + 2, py, pz)
          let ey = rf_rd3_field(env, px, py + 2, pz)
          let ez = rf_rd3_field(env, px, py, pz + 2)
          if ex > cur
            px = px + 2
          else
            if ey > cur
              py = py + 2
            else
              if ez > cur
                pz = pz + 2
              else
                px = px + 2
        else
          px = px + 1
        i = i + 1
      else
        done = true
    [px, py, pz]

let rf_rdr_multi(env, robots, targets, steps) =
    let out = []
    let i = 0
    let done = false
    for !done
      if i + 2 < len(robots) && i + 2 < len(targets)
        let end = rf_rdr_ik(env, robots[i], robots[i + 1], robots[i + 2], targets[i], targets[i + 1], targets[i + 2], steps)
        out = out.push(end[0])
        out = out.push(end[1])
        out = out.push(end[2])
        i = i + 3
      else
        done = true
    out

let rf_rdr_path_energy(env, path) =
    let acc = 0
    let i = 0
    let done = false
    for !done
      if i + 2 < len(path)
        let v = rf_rd3_field(env, path[i], path[i + 1], path[i + 2])
        acc = acc + v - (v / 65537) * 65537
        i = i + 3
      else
        done = true
    acc

let rf_rdr_verify() =
    let env = [0, 0, 0, 100]
    let ik = rf_rdr_ik(env, 5, 0, 0, 0, 0, 0, 10)
    let t1 = ik[0] <= 1 && ik[1] == 0
    let tr = rf_rdr_train(env, 5, 0, 0, 0, 0, 0, 20)
    let t2 = tr[0] == 1
    let t3 = rf_rdr_reward(env, 1, 0, 0, 0, 0, 0) > rf_rdr_reward(env, 20, 0, 0, 0, 0, 0)
    let av = rf_rdr_avoid(env, [3, 0, 0, 1], 3, 0, 0, 2)
    let t4 = av[0] != 3 || av[1] != 0
    let multi = rf_rdr_multi(env, [5, 0, 0, 5, 5, 0], [0, 0, 0, 0, 0, 0], 10)
    let t5 = len(multi) == 6
    let t6 = rf_rdr_path_energy(env, [1, 0, 0, 2, 0, 0]) >= 0
    t1 && t2 && t3 && t4 && t5 && t6
