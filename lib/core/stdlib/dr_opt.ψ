let dro_ws_util(dag, workers) =
    let depth = sched_depth_arr(dag)
    let mx = sched_critical_path(dag)
    let idle_total = 0
    let layer = 1
    let done = false
    for !done
      if layer <= mx
        let layer_nodes = sched_layer_nodes(dag, depth, layer)
        let width = len(layer_nodes)
        let idle = workers > width ? workers - width : 0
        idle_total = idle_total + idle
        layer = layer + 1
      else
          done = true
    [mx, idle_total]

