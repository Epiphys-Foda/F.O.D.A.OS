import "../stdlib/gf65537.ψ"

let kraus_channel(kraus_ops, rho, n_ops) =
    let result = 0
    for k in 0..n_ops
        let k_op = kraus_ops[k]
        let k_dag = k_op
        result = gf_add(result, gf_mul(gf_mul(k_op, rho), k_dag))
    result

let kraus_completeness(kraus_ops, n_ops) =
    let sum = 0
    for k in 0..n_ops
        sum = gf_add(sum, gf_mul(kraus_ops[k], kraus_ops[k]))
    (sum == 1 ? 1 : 0)

let depolarizing_channel(rho, p_depol) =
    let inv2 = 32769
    let one_minus_p = gf_sub(1, p_depol)
    gf_add(gf_mul(one_minus_p, rho), gf_mul(p_depol, inv2))

let depolarizing_iterated(rho, p_depol, n_steps) =
    let one_minus_p = gf_sub(1, p_depol)
    let one_minus_p_n = gf_pow(one_minus_p, n_steps)
    let p_total = gf_sub(1, one_minus_p_n)
    depolarizing_channel(rho, p_total)

let amplitude_damping_kraus(gamma) =
    let one_minus_gamma = gf_sub(1, gamma)
    let sqrt_1mg = gf_sqrt(one_minus_gamma)
    let sqrt_gamma = gf_sqrt(gamma)
    [
        [[1, 0], [0, sqrt_1mg]],
        [[0, sqrt_gamma], [0, 0]]
    ]

let amplitude_damping_evolve(rho_11, gamma, t, r_base) =
    let decay = gf_inv(gf_pow(r_base, gf_mul(gamma, t)))
    gf_mul(rho_11, decay)

let amplitude_damping_steady_state() =
    [[1, 0], [0, 0]]

let phase_damping_kraus(gamma) =
    let sqrt_1mg = gf_sqrt(gf_sub(1, gamma))
    let sqrt_gamma = gf_sqrt(gamma)
    [
        [[1, 0], [0, sqrt_1mg]],
        [[0, 0], [0, sqrt_gamma]]
    ]

let phase_damping_evolve(rho_01, gamma, t, r_base) =
    let decay = gf_inv(gf_pow(r_base, gf_mul(gamma, t)))
    gf_mul(rho_01, decay)

let decoherence_time(gamma) =
    gf_inv(gamma)

let lindblad_generator(h, rho, l_ops, n_ops) =
    let dissipator = 0
    for k in 0..n_ops
        let l_k = l_ops[k]
        let l_dag = l_k
        let l_dag_l = gf_mul(l_dag, l_k)
        dissipator = gf_add(dissipator, 0)
    dissipator

let lindblad_step(h, rho, l_ops, n_ops) =
    let gen = lindblad_generator(h, rho, l_ops, n_ops)
    gf_add(rho, gen)

let lindblad_evolve(h, rho0, l_ops, n_ops, t_max) =
    let rho = rho0
    for t in 0..t_max
        rho = lindblad_step(h, rho, l_ops, n_ops)
    rho

let gksl_to_kraus(h, l_ops, n_ops) =
    let k0 = 1
    for k in 0..n_ops
        let l_dag_l = gf_mul(l_ops[k], l_ops[k])
        k0 = gf_sub(k0, gf_div(l_dag_l, 2))
    let kraus = [k0] * (n_ops + 1)
    for k in 0..n_ops
        kraus[k + 1] = l_ops[k]
    kraus

let non_markovian_evolve(rho0, memory_kernel, t_max) =
    let rho_history = [rho0] * t_max
    for t in 1..t_max
        let rho_t = 0
        for s in 0..t
            rho_t = gf_add(rho_t, gf_mul(memory_kernel[t][s], rho_history[s]))
        rho_history[t] = rho_t
    rho_history[t_max - 1]

let memory_kernel_exponential(alpha, t, s, r_base) =
    let dt = gf_sub(t, s)
    gf_inv(gf_pow(r_base, gf_mul(alpha, dt)))

let markovian_limit(l_generator, t, s) =
        if t == s
            l_generator
        else
            0

let is_non_markovian(trace_distance_t, trace_distance_t_plus_1) =
    (trace_distance_t_plus_1 > trace_distance_t ? 1 : 0)

let quantum_trajectory_step(psi, kraus_ops, k_choice) =
    let k_k = kraus_ops[k_choice]
    gf_mul(k_k, psi)

let quantum_trajectory(psi0, kraus_ops, k_choices, t_max) =
    let psi = psi0
    for t in 0..t_max
        psi = quantum_trajectory_step(psi, kraus_ops, k_choice[t])
    psi

let jump_probability(psi, k_k) =
    let amp = gf_mul(k_k, psi)
    gf_mul(amp, amp)

let quantum_zeno_survival(gamma, tau, n_measurements, r_base) =
    let exponent = gf_mul(gf_mul(gf_mul(n_measurements, gamma), tau), tau)
    gf_inv(gf_pow(r_base, exponent))

let zeno_time(h_squared, h_mean_squared) =
    let variance = gf_sub(h_squared, h_mean_squared)
    gf_inv(gf_sqrt(variance))

let zeno_condition(n_measurements, tau, threshold) =
    let n_tau_sq = gf_mul(n_measurements, gf_mul(tau, tau))
    (n_tau_sq < threshold ? 1 : 0)

let quantum_darwin_redundancy(n_env_copies, delta) =
    n_env_copies

let mutual_information_algebraic(rank_s, rank_f, rank_sf) =
    gf_sub(gf_add(rank_s, rank_f), rank_sf)

let darwin_spectrum(n_env_copies, delta_values) =
    let spectrum = [0] * len(delta_values)
    for i in 0..len(delta_values)
        spectrum[i] = quantum_darwin_redundancy(n_env_copies, delta_values[i])
    spectrum

let pointer_states(decoherence_op) =
    decoherence_op

let collision_model_step(rho_s, rho_env, u_collision) =
    let rho_se = gf_mul(rho_s, rho_env)
    let u_rho_u = gf_mul(gf_mul(u_collision, rho_se), u_collision)
    u_rho_u

let collision_model(rho_s0, rho_env, u_collision, n_steps) =
    let rho = rho_s0
    for n in 0..n_steps
        rho = collision_model_step(rho, rho_env, u_collision)
    rho

let relax_to_equilibrium(rho, rho_eq, gamma, t, r_base) =
    let diff = gf_sub(rho, rho_eq)
    let decay = gf_inv(gf_pow(r_base, gf_mul(gamma, t)))
    gf_add(rho_eq, gf_mul(diff, decay))

let relaxation_time(gamma) =
    gf_inv(gamma)

let reached_equilibrium(rho_t, rho_eq) =
    (rho_t == rho_eq ? 1 : 0)
