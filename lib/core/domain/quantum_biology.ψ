let mat_vec_mul(mat, vec) =
    let n = len(vec)
    let result = [0] * n
    for i in 0..n
        let s = 0
        for j in 0..n
            s = gf_add(s, gf_mul(mat[i][j], vec[j]))
        result[i] = s
    result

let exciton_step(hamiltonian, psi) =
    mat_vec_mul(hamiltonian, psi)

let exciton_evolve(hamiltonian, psi0, t) =
        if t <= 0
            psi0
        else
            exciton_evolve(hamiltonian, exciton_step(hamiltonian, psi0), t - 1)

let transfer_efficiency(hamiltonian, psi0, t_max) =
    let eta = 0
    let psi = psi0
    for t in 0..t_max
        let amp = psi[6]
        let prob = gf_mul(amp, amp)
        eta = gf_add(eta, prob)
        psi = exciton_step(hamiltonian, psi)
    eta

let radical_pair_hamiltonian(j_coupling, a_hyperfine, b_hyperfine, b_field) =
    let inv4 = 49153
    let three_inv4 = gf_mul(3, inv4)

    let inv2 = 32769
    let j4 = gf_mul(j_coupling, inv4)
    let neg_j4 = gf_neg(j4)
    let gb2 = gf_mul(b_field, inv2)
    let neg_gb2 = gf_neg(gb2)
    let ab2 = gf_mul(gf_add(a_hyperfine, b_hyperfine), inv2)
    let neg_ab2 = gf_neg(ab2)
    let amb2 = gf_mul(gf_sub(a_hyperfine, b_hyperfine), inv2)
    let bma2 = gf_mul(gf_sub(b_hyperfine, a_hyperfine), inv2)

    [
        [gf_add(gf_add(j4, gb2), ab2), 0, 0, 0],
        [0, gf_add(gf_add(neg_j4, gb2), amb2), 0, 0],
        [0, 0, gf_add(gf_add(neg_j4, neg_gb2), bma2), 0],
        [0, 0, 0, gf_add(gf_add(j4, neg_gb2), neg_ab2)]
    ]

let singlet_yield(hamiltonian, rho_ss_0, k_s, t_max) =
    let phi_s = 0
    let rho_ss = rho_ss_0
    for t in 0..t_max
        phi_s = gf_add(phi_s, gf_mul(k_s, rho_ss))
        rho_ss = gf_mul(hamiltonian[1][1], rho_ss)
    phi_s

let compass_response(b_field, j_coupling, a_hyperfine, b_hyperfine, k_s, t_max) =
    let h = radical_pair_hamiltonian(j_coupling, a_hyperfine, b_hyperfine, b_field)
    singlet_yield(h, 1, k_s, t_max)

let tunneling_rate(r_base, barrier_width) =
    gf_inv(gf_pow(r_base, barrier_width))

let frequency_mismatch(omega_receptor, omega_molecule) =
    gf_sub(omega_receptor, omega_molecule)

let olfactory_response(omega_receptor, omega_molecule, r_base, barrier_width, threshold) =
    let gamma = tunneling_rate(r_base, barrier_width)
    let delta = frequency_mismatch(omega_receptor, omega_molecule)
    let delta_abs = (delta > 32768 ? gf_neg(delta) : delta)
    let is_match = (delta_abs < threshold ? 1 : 0)
    gf_mul(gamma, is_match)

let odor_identification(odor_freqs, receptor_freqs, r_base, barrier_width, threshold) =
    let n_receptors = len(receptor_freqs)
    let response = [0] * n_receptors
    for i in 0..n_receptors
        let max_resp = 0
        for j in 0..len(odor_freqs)
            let resp = olfactory_response(receptor_freqs[i], odor_freqs[j], r_base, barrier_width, threshold)
            if resp > max_resp
                max_resp = resp
        response[i] = max_resp
    response

let enzyme_tunneling_rate(r_base, distance, mass_factor) =
    let exponent = gf_mul(distance, mass_factor)
    gf_inv(gf_pow(r_base, exponent))

let kinetic_isotope_effect(r_base, distance, mass_h, mass_d) =
    let k_h = enzyme_tunneling_rate(r_base, distance, mass_h)
    let k_d = enzyme_tunneling_rate(r_base, distance, mass_d)
    gf_div(k_h, k_d)

let enzyme_rate(arrhenius_a, activation_energy, temperature, r_base) =
    let exp_arg = gf_div(activation_energy, temperature)
    gf_mul(arrhenius_a, gf_inv(gf_pow(r_base, exp_arg)))

