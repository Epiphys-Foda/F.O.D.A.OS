let coin_operator() =
    let inv_sqrt2 = gf_inv(4080)
    [
        [inv_sqrt2, inv_sqrt2],
        [inv_sqrt2, gf_neg(inv_sqrt2)]
    ]

let shift_operator(position, direction) =
        if direction == 0
            gf_sub(position, 1)
        else
            gf_add(position, 1)

let quantum_walk_step(coin_op, positions, amplitudes) =
    let n = len(positions)
    let new_pos = [0] * n
    let new_amp = [0] * n
    for i in 0..n
        let amp_l = gf_add(gf_mul(coin_op[0][0], amplitudes[i]), gf_mul(coin_op[0][1], amplitudes[i]))
        let amp_r = gf_add(gf_mul(coin_op[1][0], amplitudes[i]), gf_mul(coin_op[1][1], amplitudes[i]))
        new_pos[2*i] = shift_operator(positions[i], 0)
        new_pos[2*i + 1] = shift_operator(positions[i], 1)
        new_amp[2*i] = amp_l
        new_amp[2*i + 1] = amp_r
    [new_pos, new_amp]

let quantum_walk_search_probability(target_position, positions, amplitudes) =
    let n = len(positions)
    let prob = 0
    for i in 0..n
        if positions[i] == target_position
            prob = gf_add(prob, gf_mul(amplitudes[i], amplitudes[i]))
    prob

let kraus_channel(kraus_ops, rho) =
    let n = len(kraus_ops)
    let result = 0
    for k in 0..n
        let k_op = kraus_ops[k]
        let k_dag = k_op
        result = gf_add(result, gf_mul(gf_mul(k_op, rho), k_dag))
    result

let decoherence_factor(r_base, gamma, t) =
    let exponent = gf_mul(gamma, t)
    gf_inv(gf_pow(r_base, exponent))

let quantum_zeno_survival(r_base, gamma, tau, n_measurements) =
    let exponent = gf_mul(gf_mul(gamma, tau), n_measurements)
    gf_inv(gf_pow(r_base, exponent))

let optimal_noise_level(hamiltonian, psi0, t_max, r_base) =
    let best_gamma = 0
    let best_efficiency = 0
    for gamma in 1..100
        let eta = transfer_efficiency(hamiltonian, psi0, t_max)
        let decoh = decoherence_factor(r_base, gamma, t_max)
        let eta_noisy = gf_mul(eta, decoh)
        if eta_noisy > best_efficiency
            best_efficiency = eta_noisy
            best_gamma = gamma
    best_gamma

