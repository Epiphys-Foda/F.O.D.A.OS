let huckel_h2(alpha, beta) =
    [[alpha, beta], [beta, alpha]]

let huckel_ethylene(alpha, beta) =
    [[alpha, beta], [beta, alpha]]

let _huckel_benzene_loop(alpha, beta, n, i, rows) =
        if i >= n
            rows
        else
            let row = _huckel_benzeli_row(alpha, beta, n, i, 0, [])
            _huckel_benzene_loop(alpha, beta, n, i + 1, arr_concat(rows, [row]))
let _huckel_benzeli_row(alpha, beta, n, i, j, row) =
        if j >= n
            row
        else
            let val = if i == j
                alpha
            else
                0
            if (i + 1) % n == j || (j + 1) % n == i
                beta
            else
                0
            _huckel_benzeli_row(alpha, beta, n, i, j + 1, arr_concat(row, [val]))
let huckel_benzene(alpha, beta) =
    _huckel_benzene_loop(alpha, beta, 6, 0, [])

let huckel_cyclopentadienyl(alpha, beta) =
    _huckel_benzene_loop(alpha, beta, 5, 0, [])

let huckel_butadiene(alpha, beta) =
    [[alpha, beta, 0, 0],
     [beta, alpha, beta, 0],
     [0, beta, alpha, beta],
     [0, 0, beta, alpha]]

let huckel_h2_eigenvalues(alpha, beta) =
    let e_bonding = gf_add(alpha, beta)
    let e_antibonding = gf_sub(alpha, beta)
    [e_bonding, e_antibonding]

let huckel_benzene_eigenvalues(alpha, beta) =
    let two_beta = gf_mul(2, beta)
    let e1 = gf_add(alpha, two_beta)
    let e2 = gf_add(alpha, beta)
    let e3 = gf_sub(alpha, beta)
    let e4 = gf_sub(alpha, two_beta)
    [e1, e2, e2, e3, e3, e4]

let huckel_butadiene_eigenvalues(alpha, beta) =
    let e1 = [alpha, beta]
    let e2 = [gf_sub(alpha, beta), beta]
    let e3 = [gf_add(alpha, beta), gf_neg(beta)]
    let e4 = [alpha, gf_neg(beta)]
    [e1, e2, e3, e4]

let huckel_cyclopentadienyl_eigenvalues(alpha, beta) =
    let two_beta = gf_mul(2, beta)
    let e1 = gf_add(alpha, two_beta)
    let inv2 = gf_inv(2)
    let half_beta = gf_mul(beta, inv2)
    let e2_real = gf_add(alpha, half_beta)
    let e2_imag = half_beta
    let e2 = [e2_real, e2_imag]
    let e3 = [e2_real, gf_neg(half_beta)]
    [e1, e2, e2, e3, e3]

let huckel_h2_total_energy(alpha, beta) =
    let evals = huckel_h2_eigenvalues(alpha, beta)
    gf_mul(2, evals[0])

let huckel_benzene_total_energy(alpha, beta) =
    let six_alpha = gf_mul(6, alpha)
    let eight_beta = gf_mul(8, beta)
    gf_add(six_alpha, eight_beta)

let huckel_benzene_delocalization_energy(beta) =
