let fock_h2(h, k, g1111, g1122, g1212, d11, d12, d22) =
    let g11 = gf_add(gf_mul(d11, g1111), gf_mul(d22, g1122))
    let g22 = gf_add(gf_mul(d22, g1111), gf_mul(d11, g1122))
    let two_g1212 = gf_mul(2, g1212)
    let g12_coeff = gf_sub(two_g1212, g1122)
    let g12 = gf_mul(d12, g12_coeff)
    let f11 = gf_add(h, g11)
    let f12 = gf_add(k, g12)
    let f22 = gf_add(h, g22)
    [[f11, f12], [f12, f22]]

let scf_h2_eigenvalues(f11, f12, f22, s) =
    let s_sq = gf_mul(s, s)
    let a = gf_sub(1, s_sq)
    let two_f12_s = gf_mul(gf_mul(2, f12), s)
    let b = gf_sub(two_f12_s, gf_add(f11, f22))
    let f11_f22 = gf_mul(f11, f22)
    let f12_sq = gf_mul(f12, f12)
    let c = gf_sub(f11_f22, f12_sq)
    let b_sq = gf_mul(b, b)
    let four_ac = gf_mul(gf_mul(4, a), c)
    let delta = gf_sub(b_sq, four_ac)
    [a, b, c, delta]

let scf_extract_eigenvalues(a, b, delta) =
    let legendre = gf_legendre(delta)
    let neg_b = gf_neg(b)
    let inv_2a = gf_inv(gf_mul(2, a))
    if legendre == 1
        let sqrt_delta = gf_sqrt(delta)
        let e1 = gf_mul(gf_add(neg_b, sqrt_delta), inv_2a)
        let e2 = gf_mul(gf_sub(neg_b, sqrt_delta), inv_2a)
        [e1, e2, 1]
    else
        0
    if legendre == 0
        let e = gf_mul(neg_b, inv_2a)
        [e, e, 0]
    else
        let real_part = gf_mul(neg_b, inv_2a)
        let imag_part = inv_2a
        [real_part, imag_part, 65536]

let scf_h2_step(h, k, g1111, g1122, g1212, s, d11, d12, d22) =
    let F = fock_h2(h, k, g1111, g1122, g1212, d11, d12, d22)
    let f11 = F[0][0]
    let f12 = F[0][1]
    let f22 = F[1][1]
    let coeffs = scf_h2_eigenvalues(f11, f12, f22, s)
    let a = coeffs[0]
    let b = coeffs[1]
    let delta = coeffs[3]
    let evals = scf_extract_eigenvalues(a, b, delta)
    [f11, f12, f22, evals[0], evals[1], evals[2]]

let mulliken_charge_h2(d11, s11, z_h) =
    let pop = gf_mul(d11, s11)
    gf_sub(z_h, pop)

let bond_order_h2(d12, s) =
    let two_d12_s = gf_mul(gf_mul(2, d12), s)
    two_d12_s

