let bond_polarity(chi_a, chi_b) =
    let diff = gf_sub(chi_a, chi_b)
    let sum = gf_add(chi_a, chi_b)
    gf_div(diff, sum)

let polarity_class(chi_a, chi_b) =
    let diff = gf_sub(chi_a, chi_b)
    let abs_diff = (diff > 32768 ? gf_neg(diff) : diff)
    if abs_diff < 5
        0
    else
        0
    if abs_diff < 15
        1
    else
        0
    if abs_diff < 30
        2
    else
        0
    if abs_diff < 50
        3
    else
        4

let rhf_total_energy(occupied_evals, n_occupied) =
    _rhf_energy_loop(occupied_evals, n_occupied, 0, 0)
let _rhf_energy_loop(evals, n, i, acc) =
        if i >= n
            gf_mul(2, acc)
        else
            _rhf_energy_loop(evals, n, i + 1, gf_add(acc, evals[i]))

let h2_mo_coefficients() =
    let inv_sqrt2 = 2040
    let neg_inv_sqrt2 = gf_neg(2040)
    let bonding = [inv_sqrt2, inv_sqrt2]
    let antibonding = [inv_sqrt2, neg_inv_sqrt2]
    [bonding, antibonding]

let ethylene_mo_coefficients() =
    h2_mo_coefficients()

let verify_orthogonality_h2() =
    let mos = h2_mo_coefficients()
    let c1 = mos[0]
    let c2 = mos[1]
    let dot = gf_add(gf_mul(c1[0], c2[0]), gf_mul(c1[1], c2[1]))
    dot

let verify_normalization_h2() =
    let mos = h2_mo_coefficients()
    let c1 = mos[0]
    let norm = gf_add(gf_mul(c1[0], c1[0]), gf_mul(c1[1], c1[1]))
    norm

let bond_type(double_bond_order) =
    if double_bond_order < 1
        0
    else
        0
    if double_bond_order < 3
        1
    else
        0
    if double_bond_order < 5
        2
    else
        0
    if double_bond_order < 7
        3
    else
        4

let reaction_energy(e_products, e_reactants) =
    gf_sub(e_products, e_reactants)

let is_exothermic(delta_e) =
    delta_e > 32768

let is_closed_shell(n_electrons) =
    n_electrons % 2 == 0

let is_stable(homo_lumo_gap, delocalization_energy) =
    let gap_stable = homo_lumo_gap > 32768
    let deloc_stable = delocalization_energy > 32768
    if gap_stable && deloc_stable
        1
    else
        0
    if gap_stable
        2
    else
        0

let vibrational_frequency_sq(force_const, reduced_mass) =
    gf_div(force_const, reduced_mass)

let vibrational_frequency(force_const, reduced_mass) =
    let omega_sq = vibrational_frequency_sq(force_const, reduced_mass)
    let legendre = gf_legendre(omega_sq)
    if legendre == 1
        let omega = gf_sqrt(omega_sq)
        [omega, 1]
    else
        0
    if legendre == 0
        [0, 0]
    else
        [omega_sq, 65536]

let partition_function(energies, degeneracies, n, r) =
    _pf_loop(energies, degeneracies, n, r, 0, 0)
let _pf_loop(energies, degeneracies, n, r, i, acc) =
        if i >= n
            acc
        else
            let boltzmann = gf_pow(r, energies[i])
            let term = gf_mul(degeneracies[i], boltzmann)
            _pf_loop(energies, degeneracies, n, r, i + 1, gf_add(acc, term))

let internal_energy(energies, occupations, n) =
    _ue_loop(energies, occupations, n, 0, 0)
let _ue_loop(energies, occ, n, i, acc) =
        if i >= n
            acc
        else
            let term = gf_mul(occ[i], energies[i])
            _ue_loop(energies, occ, n, i + 1, gf_add(acc, term))

let transition_energy(e_initial, e_final) =
    gf_sub(e_final, e_initial)

let h2_first_excitation(beta) =
    gf_neg(gf_mul(2, beta))

let benzene_pi_pi_star(beta) =
