let transition_allowed(sym_initial, sym_final) =
        let g_to_u = sym_initial == 1 && sym_final == 0
        let u_to_g = sym_initial == 0 && sym_final == 1
        if g_to_u || u_to_g
            1
        else
            0

let charge_transfer(q_a_complex, q_a_free) =
    gf_sub(q_a_complex, q_a_free)

let h2_energy_levels(alpha, beta) =
    let e_bonding = gf_add(alpha, beta)
    let e_antibonding = gf_sub(alpha, beta)
    [[e_bonding, 2], [e_antibonding, 0]]

let benzene_energy_levels(alpha, beta) =
    let two_beta = gf_mul(2, beta)
    [[gf_add(alpha, two_beta), 2],
     [gf_add(alpha, beta), 2],
     [gf_add(alpha, beta), 2],
     [gf_sub(alpha, beta), 0],
     [gf_sub(alpha, beta), 0],
     [gf_sub(alpha, two_beta), 0]]
