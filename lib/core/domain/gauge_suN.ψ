import "../stdlib/gf65537.ψ"

let _su3_sqrt3_search(x) =
    if x >= 65537
      0
    else
        0
    if (x * x) % 65537 == 3
      x
    else
      _su3_sqrt3_search(x + 1)
let SU3_SQRT3 = _su3_sqrt3_search(2)
let SU3_HALF = 32769
let SU3_SQRT3_HALF = (SU3_SQRT3 * SU3_HALF) % 65537

let su3_fabc(a, b, c) =
    if a == 1
      if b == 2
        (c == 3 ? 1 : 0)
      else
            0
      if b == 4
        (c == 7 ? SU3_HALF : 0)
      else
            0
      if b == 5
        (c == 6 ? 65537 - SU3_HALF : 0)
      else
            0
        0
    else
          0
    if a == 2
      if b == 4
        (c == 6 ? SU3_HALF : 0)
      else
            0
      if b == 5
        (c == 7 ? SU3_HALF : 0)
      else
            0
        0
    else
          0
    if a == 3
      if b == 4
        (c == 5 ? SU3_HALF : 0)
      else
            0
      if b == 6
        (c == 7 ? 65537 - SU3_HALF : 0)
      else
            0
        0
    else
          0
    if a == 4
      if b == 5
        (c == 8 ? SU3_SQRT3_HALF : 0)
      else
            0
        0
    else
          0
    if a == 6
      if b == 7
        (c == 8 ? SU3_SQRT3_HALF : 0)
      else
            0
        0
    else
          0
      0

let su3_fabc_full(a, b, c) =
      let direct = su3_fabc(a, b, c)
      if direct != 0
        direct
      else
        let swap = su3_fabc(b, a, c)
        if swap != 0
          65537 - swap
        else
          0

let _jacobi_sum(a, b, c, e, d, acc) =
      if d > 8
        acc
      else
        let term1 = gfmul(su3_fabc_full(a, b, d), su3_fabc_full(d, c, e))
        let term2 = gfmul(su3_fabc_full(b, c, d), su3_fabc_full(d, a, e))
        let term3 = gfmul(su3_fabc_full(c, a, d), su3_fabc_full(d, b, e))
        let s = (term1 + term2 + term3) % 65537
        _jacobi_sum(a, b, c, e, d + 1, (acc + s) % 65537)
let jacobi_check(a, b, c, e) =
    let s = _jacobi_sum(a, b, c, e, 1, 0)
    (s == 0 ? 1 : 0)

let wilson_loop_1x1(theta, n) =
    let trace = 1
    _wilson_trace_sum(theta, n, 0, trace)
let _wilson_trace_sum(theta, n, a, acc) =
      if a >= n
        acc
      else
        let t = theta[a]
        let t2 = gfmul(t, t)
        let contrib = gfmul(t2, SU3_HALF)
        _wilson_trace_sum(theta, n, a + 1, (acc + contrib) % 65537)

let _gauge_action_sum(f_field, n, i, acc) =
      if i >= n
        acc
      else
        let f = f_field[i]
        let f2 = gfmul(f, f)
        _gauge_action_sum(f_field, n, i + 1, (acc + f2) % 65537)
let gauge_action(f_field, n) = _gauge_action_sum(f_field, n, 0, 0)

let test_gauge_su3() =
    assert_eq(su3_fabc(1, 2, 3), 1)
    assert_eq(su3_fabc(1, 2, 4), 0)
    assert_eq(su3_fabc_full(2, 1, 3), 65537 - 1)
    assert_eq(jacobi_check(1, 2, 3, 4), 1)
    assert_eq(jacobi_check(1, 4, 5, 8), 1)
    0
