let hasse_weil_zeta_elliptic(a, b, t) =
        let a_p = elliptic_a_p(a, b)
        let disc = gf_sub(gf_mul(a_p, a_p), gf_mul(4, 65537))
        let leg = gf_legendre(disc)
        if leg == 1
            let sqrt_disc = gf_sqrt(disc)
            let alpha = gf_div(gf_add(a_p, sqrt_disc), 2)
            let beta = gf_div(gf_sub(a_p, sqrt_disc), 2)
            let num = gf_mul(gf_sub(1, gf_mul(alpha, t)), gf_sub(1, gf_mul(beta, t)))
            let den = gf_mul(gf_sub(1, t), gf_sub(1, gf_mul(65537, t)))
            gf_div(num, den)
        else
            let num = gf_add(gf_sub(1, gf_mul(a_p, t)), gf_mul(65537, gf_mul(t, t)))
            let den = gf_mul(gf_sub(1, t), gf_sub(1, gf_mul(65537, t)))
            gf_div(num, den)

