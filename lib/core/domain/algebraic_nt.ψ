let fermat_search(n, search_range) =
    _fermat_loop(n, search_range, 1, 1, 1)
let _fermat_loop(n, range, x, y, z) =
    if x > range
        0
    else
        0
    if y > range
        _fermat_loop(n, range, x + 1, 1, 1)
    else
        0
    if z > range
        _fermat_loop(n, range, x, y + 1, 1)
    else
        let xn = gf_pow(x, n)
        let yn = gf_pow(y, n)
        let zn = gf_pow(z, n)
        if gf_add(xn, yn) == zn
            1
        else
            _fermat_loop(n, range, x, y, z + 1)

let fermat_modular_obstruction(n, search_range) =
        if fermat_search(n, search_range) == 0
            1
        else
            0

