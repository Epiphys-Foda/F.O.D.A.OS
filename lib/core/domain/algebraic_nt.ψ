let p_adic_valuation(n, p_prime) =
    _padic_v_loop(n, p_prime, 0)
let _padic_v_loop(n, p_prime, acc) =
        if n % p_prime != 0
            acc
        else
            _padic_v_loop(n / p_prime, p_prime, acc + 1)

let p_adic_norm(n, p_prime) =
    let v = p_adic_valuation(n, p_prime)
    gf_pow(gf_inv(p_prime), v)

