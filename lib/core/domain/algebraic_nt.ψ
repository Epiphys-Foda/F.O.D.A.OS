let legendre_symbol(a, p_prime) =
        if a % p_prime == 0
            0
        else
            let leg = gf_legendre(a % p_prime)
            (leg == 1 ? 1 : 65536)

let quadratic_reciprocity(p1, p2) =
    let leg_p1_p2 = legendre_symbol(p1, p2)
    let leg_p2_p1 = legendre_symbol(p2, p1)
    let exp = gf_mul(gf_div(gf_sub(p1, 1), 2), gf_div(gf_sub(p2, 1), 2))
    let sign = (exp % 2 == 0) ? 1 : 65536
    let lhs = gf_mul(leg_p1_p2, leg_p2_p1)
    (lhs == sign ? 1 : 0)

let supplement_minus_one(p_prime) =
    let leg = legendre_symbol(65536, p_prime)
    let exp = gf_div(gf_sub(p_prime, 1), 2)
    let sign = (exp % 2 == 0) ? 1 : 65536
    (leg == sign ? 1 : 0)

let supplement_two(p_prime) =
    let leg = legendre_symbol(2, p_prime)
    let exp = gf_div(gf_sub(gf_mul(p_prime, p_prime), 1), 8)
    let sign = (exp % 2 == 0) ? 1 : 65536
    (leg == sign ? 1 : 0)

let dirichlet_character(n, q) =
        if n % q == 0
            0
        else
            let leg = gf_legendre(n % q)
            (leg == 1 ? 1 : 65536)

let dirichlet_l_function(s, q) =
    let exp = gf_sub(65536, s)
    _dirichlet_l_sum(exp, q, 1, 0)
let _dirichlet_l_sum(exp, q, n, acc) =
        if n >= 65537
            acc
        else
            let chi = dirichlet_character(n, q)
            let term = gf_mul(chi, gf_pow(n, exp))
            _dirichlet_l_sum(exp, q, n + 1, gf_add(acc, term))

let dirichlet_l_euler_product(s, q, cutoff) =
    let exp = gf_sub(65536, s)
    _euler_product_loop(exp, q, cutoff, 2, 1)
let _euler_product_loop(exp, q, cutoff, p_prime, acc) =
        if p_prime > cutoff
            acc
        else
            let chi_p = dirichlet_character(p_prime, q)
            let p_pow = gf_pow(p_prime, exp)
            let factor_inv = gf_sub(1, gf_mul(chi_p, p_pow))
            let factor = gf_inv(factor_inv)
            _euler_product_loop(exp, q, cutoff, p_prime + 1, gf_mul(acc, factor))

