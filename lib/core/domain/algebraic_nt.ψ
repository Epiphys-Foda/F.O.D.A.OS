let frobenius(x, p_base) =
    gf_pow(x, p_base)

let frobenius_power(x, p_base, k) =
    _frob_pow_loop(x, p_base, k, x)
let _frob_pow_loop(x, p_base, k, acc) =
        if k == 0
            acc
        else
            _frob_pow_loop(x, p_base, k - 1, gf_pow(acc, p_base))

