let l_functional_equation_check(s, q) =
        let l_s = dirichlet_l_function(s, q)
        let l_1_minus_s = dirichlet_l_function(gf_sub(1, s), q)
        if l_1_minus_s == 0
            (l_s == 0 ? 1 : 0)
        else
                0
            gf_div(l_s, l_1_minus_s)

let elliptic_discriminant(a, b) =
    let four_a3 = gf_mul(4, gf_pow(a, 3))
    let twenty_seven_b2 = gf_mul(27, gf_mul(b, b))
    gf_neg(gf_mul(16, gf_add(four_a3, twenty_seven_b2)))

let elliptic_nonsingular(a, b) =
    (elliptic_discriminant(a, b) == 0 ? 0 : 1)

let elliptic_curve_point_count(a, b) =
    _ec_count_loop(a, b, 0, 0)
let _ec_count_loop(a, b, x, acc) =
        if x >= 65537
            gf_add(gf_add(65537, 1), acc)
        else
            let x3 = gf_mul(gf_mul(x, x), x)
            let rhs = gf_add(gf_add(x3, gf_mul(a, x)), b)
            let leg = gf_legendre(rhs)
            let contribution = (leg == 1) ? 2 : ((leg == 0) ? 1 : 0)
            _ec_count_loop(a, b, x + 1, gf_add(acc, contribution))

let hasse_bound_check(a, b) =
    let n_points = elliptic_curve_point_count(a, b)
    let t = gf_sub(gf_add(65537, 1), n_points)
    let t_abs = (t < 32768) ? t : gf_neg(t)
    (t_abs <= 512 ? 1 : 0)

let ec_add(x1, y1, x2, y2, a) =
    if x1 == x2 && y1 == gf_neg(y2)
        [0, 0]
    else
        0
    if x1 == x2 && y1 == y2
        let lambda = gf_div(gf_add(gf_mul(3, gf_mul(x1, x1)), a), gf_mul(2, y1))
        let x3 = gf_sub(gf_sub(gf_mul(lambda, lambda), x1), x2)
        let y3 = gf_sub(gf_mul(lambda, gf_sub(x1, x3)), y1)
        [x3, y3]
    else
        let lambda = gf_div(gf_sub(y2, y1), gf_sub(x2, x1))
        let x3 = gf_sub(gf_sub(gf_mul(lambda, lambda), x1), x2)
        let y3 = gf_sub(gf_mul(lambda, gf_sub(x1, x3)), y1)
        [x3, y3]

let ec_scalar_mul(x, y, n, a) =
    _ec_mul_loop(x, y, n, a, 0, 0, 0)
let _ec_mul_loop(x, y, n, a, rx, ry, bit) =
        if n == 0
            [rx, ry]
        else
            let new_rx = rx
            let new_ry = ry
            if n & 1 == 1
                let added = ec_add(rx, ry, x, y, a)
                _ec_mul_loop(x, y, n >> 1, a, added[0], added[1], bit + 1)
            else
                _ec_mul_loop(x, y, n >> 1, a, new_rx, new_ry, bit + 1)

let elliptic_a_p(a, b) =
    let n_points = elliptic_curve_point_count(a, b)
    gf_sub(gf_add(65537, 1), n_points)

let elliptic_l_function(a, b, s, cutoff) =
    let a_p = elliptic_a_p(a, b)
    let exp_s = gf_sub(65536, s)
    let exp_2s = gf_sub(65536, gf_mul(2, s))
    _ec_l_function_loop(a_p, exp_s, exp_2s, cutoff, 2, 1)
let _ec_l_function_loop(a_p, exp_s, exp_2s, cutoff, p_prime, acc) =
        if p_prime > cutoff
            acc
        else
            let p_inv_s = gf_pow(p_prime, exp_s)
            let p_inv_2s = gf_pow(p_prime, exp_2s)
            let p_term = gf_mul(p_prime, p_inv_2s)
            let factor_inv = gf_add(gf_sub(1, gf_mul(a_p, p_inv_s)), p_term)
            let factor = gf_inv(factor_inv)
            _ec_l_function_loop(a_p, exp_s, exp_2s, cutoff, p_prime + 1, gf_mul(acc, factor))

let bsd_conjecture_check(a, b, cutoff) =
