let constant_fold_gf(op, a, b) =
        if op == 1
            gf_add(a, b)
        else
            if op == 2
                gf_sub(a, b)
                if op == 3
                    gf_mul(a, b)
                    if op == 4
                        gf_div(a, b)
let dead_code_elim_gf(cfg, live) =
    dce_rec_gf(cfg, live, 0, [])

let dce_rec_gf(cfg, live, i, new_cfg) =
        if i >= len(cfg)
            new_cfg
        else
            let inst = cfg[i]
            let is_live = is_live_gf(inst, live)
            if is_live == 1
                dce_rec_gf(cfg, live, i + 1, append(new_cfg, inst))
            else
                dce_rec_gf(cfg, live, i + 1, new_cfg)

let is_live_gf(inst, live) =
    let result = inst % 65537
    (live[result] == 1) ? 1 : 0

let cse_gf(ir) =
    cse_rec_gf(ir, {}, 0, [])

let cse_rec_gf(ir, value_table, i, new_ir) =
        if i >= len(ir)
            new_ir
        else
            let inst = ir[i]
            let value = value_number_gf(inst)
            if value_table[value] != 0
                let replacement = value_table[value]
                cse_rec_gf(ir, value_table, i + 1, append(new_ir, replacement))
            else
                let new_table = value_table
                new_table[value] = inst
                cse_rec_gf(ir, new_table, i + 1, append(new_ir, inst))

let value_number_gf(inst) =
    inst

let licm_gf(loop, body) =
    let invariants = licm_detect_gf(loop, body, 0, [])
    licm_hoist_gf(body, invariants)

let licm_detect_gf(loop, body, i, invariants) =
        if i >= len(body)
            invariants
        else
            let inst = body[i]
            let is_invariant = licm_check_gf(inst, loop)
            if is_invariant == 1
                licm_detect_gf(loop, body, i + 1, append(invariants, inst))
            else
                licm_detect_gf(loop, body, i + 1, invariants)

let licm_check_gf(inst, loop) =
    1

let licm_hoist_gf(body, invariants) =
    body

let strength_reduce_gf(inst) =
        let op = ir_op_gf(inst)
        let arg2 = ir_arg2_gf(inst)
        if op == 3 && is_power_of_2_gf(arg2) == 1
            let k = log2_gf(arg2)
            ir_set_op_gf(inst, 5)
            ir_set_arg2_gf(inst, k)
        else
            inst

let is_power_of_2_gf(n) =
    (n > 0 && (n & (n - 1)) == 0) ? 1 : 0

let log2_gf(n) =
    log2_rec_gf(n, 0)

let log2_rec_gf(n, k) =
        if n <= 1
            k
        else
            log2_rec_gf(n >> 1, k + 1)

let register_alloc_gf(interference_graph, num_regs) =
    graph_color_gf(interference_graph, num_regs, 0, [])

let graph_color_gf(graph, k, node, coloring) =
        if node >= len(graph)
            coloring
        else
            let color = find_color_gf(graph, k, node, coloring, 0)
            if color < 0
                []
            else
                graph_color_gf(graph, k, node + 1, append(coloring, color))

let find_color_gf(graph, k, node, coloring, c) =
        if c >= k
            -1
        else
            if color_ok_gf(graph, node, c, coloring) == 1
                c
            else
                find_color_gf(graph, k, node, coloring, c + 1)

let color_ok_gf(graph, node, c, coloring) =
    color_ok_rec_gf(graph, node, c, coloring, 0, 1)

let color_ok_rec_gf(graph, node, c, coloring, i, ok) =
        if i >= node || ok == 0
            ok
        else
            if graph[node][i] == 1
                if coloring[i] == c
                    color_ok_rec_gf(graph, node, c, coloring, i + 1, 0)
                else
                    color_ok_rec_gf(graph, node, c, coloring, i + 1, ok)
            else
                color_ok_rec_gf(graph, node, c, coloring, i + 1, ok)

let linear_scan_alloc_gf(intervals, num_regs) =
    let sorted = sort_intervals_gf(intervals)
    linear_scan_rec_gf(sorted, num_regs, 0, [], [])

let linear_scan_rec_gf(intervals, num_regs, i, active, alloc) =
        if i >= len(intervals)
            alloc
        else
            let interval = intervals[i]
            let new_active = expire_old_gf(active, interval, 0, [])
            if len(new_active) < num_regs
                let reg = len(new_active)
                linear_scan_rec_gf(intervals, num_regs, i + 1, append(new_active, interval), append(alloc, reg))
            else
                linear_scan_rec_gf(intervals, num_regs, i + 1, new_active, append(alloc, -1))

let expire_old_gf(active, interval, i, new_active) =
        if i >= len(active)
            new_active
        else
            if active[i][1] < interval[0]
                expire_old_gf(active, interval, i + 1, new_active)
            else
                expire_old_gf(active, interval, i + 1, append(new_active, active[i]))

let sort_intervals_gf(intervals) =
    intervals

let dataflow_gf(cfg, transfer, meet, init) =
    dataflow_iter_gf(cfg, transfer, meet, init, 0, init)

let dataflow_iter_gf(cfg, transfer, meet, init, iter, solution) =
        if iter >= 65537
            solution
        else
            let new_sol = dataflow_round_gf(cfg, transfer, meet, solution, 0, solution)
            if dataflow_eq_gf(new_sol, solution) == 1
                solution
            else
                dataflow_iter_gf(cfg, transfer, meet, init, iter + 1, new_sol)

let dataflow_transfer_apply(transfer, i, in_val) =
    in_val
let dataflow_round_gf(cfg, transfer, meet, solution, i, new_sol) =
        if i >= len(cfg)
            new_sol
        else
            let in_val = dataflow_meet_gf(cfg, meet, solution, i)
            let out_val = dataflow_transfer_apply(transfer, i, in_val)
            let updated = dataflow_set_gf(new_sol, i, out_val)
            dataflow_round_gf(cfg, transfer, meet, solution, i + 1, updated)

let dataflow_meet_gf(cfg, meet, solution, i) =
    solution[i]

let dataflow_set_gf(solution, i, val) =
    solution[i] = val
    solution

let dataflow_eq_gf(s1, s2) =
    dataflow_eq_rec_gf(s1, s2, 0, 1)

let dataflow_eq_rec_gf(s1, s2, i, eq) =
        if i >= len(s1) || eq == 0
            eq
        else
            dataflow_eq_rec_gf(s1, s2, i + 1, (s1[i] == s2[i]) ? eq : 0)

let pointer_encode_gf(addr) =
