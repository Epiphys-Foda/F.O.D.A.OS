            let node = ast[i]
            let node_type = ast_node_type_gf(node)
            let type_ok = type_check_node_gf(node, node_type, env)
            type_check_rec_gf(ast, env, i + 1, gf_mul(ok, type_ok))

let type_check_node_gf(node, node_type, env) =
    let expected = env[node_type]
    (node_type == expected) ? 1 : 0

let subtype_gf(t1, t2) =
