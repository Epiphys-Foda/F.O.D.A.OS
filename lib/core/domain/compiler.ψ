let instruction_schedule_gf(instructions, dep_graph) =
    schedule_rec_gf(instructions, dep_graph, 0, [], [])

let schedule_rec_gf(instructions, dep_graph, i, scheduled, order) =
        if i >= len(instructions)
            order
        else
            let ready = deps_satisfied_gf(instructions[i], dep_graph, scheduled)
            if ready == 1
                schedule_rec_gf(instructions, dep_graph, i + 1, append(scheduled, i), append(order, instructions[i]))
            else
                schedule_rec_gf(instructions, dep_graph, i + 1, scheduled, order)

let deps_satisfied_gf(inst, dep_graph, scheduled) =
    deps_satisfied_rec_gf(dep_graph[inst], scheduled, 0, 1)

let deps_satisfied_rec_gf(deps, scheduled, i, ok) =
        if i >= len(deps) || ok == 0
            ok
        else
            let is_scheduled = contains_gf(scheduled, deps[i])
            deps_satisfied_rec_gf(deps, scheduled, i + 1, gf_mul(ok, is_scheduled))

let compile_gf(source) =
    let tokens = lexer_gf(lex_table, 0, source)
    let ast = lr1_parse_gf(action_table, goto_table, tokens)
    let type_ok = type_check_gf(ast, type_env)
    let ir = ir_gen_gf(ast)
    let ssa = ssa_construct_gf(ir)
    let opt = optimize_gf(ssa)
    let allocated = register_alloc_gf(interference_graph, num_regs)
    let target = instruction_select_gf(opt)
    let scheduled = instruction_schedule_gf(target, dep_graph)
    scheduled

let optimize_gf(ir) =
    let folded = optimize_pass_gf(ir, "const_fold")
    let dce = optimize_pass_gf(folded, "dce")
    let cse = optimize_pass_gf(dce, "cse")
    let licm = optimize_pass_gf(cse, "licm")
    let reduced = optimize_pass_gf(licm, "strength_reduce")
    reduced

let optimize_pass_gf(ir, pass_name) =
        if pass_name == "const_fold"
            optimize_const_fold_rec_gf(ir, 0, [])
        else
            if pass_name == "dce"
                dead_code_elim_gf(ir, live_set)
                if pass_name == "cse"
                    cse_gf(ir)
                    if pass_name == "licm"
                        licm_gf(loop, ir)
                        if pass_name == "strength_reduce"
                            optimize_strength_rec_gf(ir, 0, [])
                        else
                            ir

let optimize_const_fold_rec_gf(ir, i, new_ir) =
        if i >= len(ir)
            new_ir
        else
            let inst = ir[i]
            let op = ir_op_gf(inst)
            let arg1 = ir_arg1_gf(inst)
            let arg2 = ir_arg2_gf(inst)
            if is_constant_gf(arg1) == 1 && is_constant_gf(arg2) == 1
                let folded = constant_fold_gf(op, arg1, arg2)
                optimize_const_fold_rec_gf(ir, i + 1, append(new_ir, folded))
            else
                optimize_const_fold_rec_gf(ir, i + 1, append(new_ir, inst))

let optimize_strength_rec_gf(ir, i, new_ir) =
        if i >= len(ir)
            new_ir
        else
            let reduced = strength_reduce_gf(ir[i])
            optimize_strength_rec_gf(ir, i + 1, append(new_ir, reduced))

let ast_node_type_gf(node) =
    gf_div(node, 65537)

let ir_op_gf(inst) =
    gf_div(inst, gf_mul(65537, gf_mul(65537, 65537)))

let ir_arg1_gf(inst) =
    let rem = inst % gf_mul(65537, gf_mul(65537, 65537))
    gf_div(rem, gf_mul(65537, 65537))

let ir_arg2_gf(inst) =
    let rem = inst % gf_mul(65537, gf_mul(65537, 65537))
    let rem2 = rem % gf_mul(65537, 65537)
    gf_div(rem2, 65537)

let ir_set_op_gf(inst, op) =
    inst

let ir_set_arg2_gf(inst, arg2) =
    inst

let is_constant_gf(val) =
    1

let pop_n_gf(stack, n) =
    pop_n_rec_gf(stack, n, 0)

let pop_n_rec_gf(stack, n, i) =
        if i >= n
            stack
        else
            let s = pop_gf(stack)
            pop_n_rec_gf(s, n, i + 1)

let pop_gf(stack) =
    stack[len(stack) - 1] = -1
    stack

