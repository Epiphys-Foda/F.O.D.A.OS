let token_encode_gf(token_type, token_value) =
    gf_add(gf_mul(token_type, 256), token_value)

let token_type_gf(token) =
    gf_div(token, 256)

let token_value_gf(token) =
    token % 256

let lexer_gf(T, q0, source) =
    lexer_rec_gf(T, q0, source, 0, [])

let lexer_rec_gf(T, q, source, i, tokens) =
        if i >= len(source)
            tokens
        else
            let c = char_encode_gf(source[i])
            let q_next = gf_mul(T[c], q)
            let is_accept = (q_next % 256 == 0) ? 1 : 0
            if is_accept == 1
                let tok = token_encode_gf(q_next, i)
                lexer_rec_gf(T, q0, source, i + 1, append(tokens, tok))
            else
                lexer_rec_gf(T, q_next, source, i + 1, tokens)

let char_encode_gf(c) =
    c

let ast_node_gf(node_type, child_index) =
    gf_add(gf_mul(node_type, 65537), child_index)

let ll1_parse_gf(parse_table, grammar, tokens) =
    ll1_parse_rec_gf(parse_table, grammar, tokens, 0, [0], 0, [])

let ll1_parse_rec_gf(table, grammar, tokens, pos, stack, node_id, ast) =
        if len(stack) == 0
            ast
        else
            if pos >= len(tokens)
                ast
            else
                let top = stack[len(stack) - 1]
                let tok = tokens[pos]
                let action = table[top][tok]
                if action == 0
                    ast
                else
                    if action < 1000
                        let new_stack = push_gf(stack, tok)
                        ll1_parse_rec_gf(table, grammar, tokens, pos + 1, new_stack, node_id, ast)
                    else
                        let prod = grammar[action]
                        let pop_count = prod[0]
                        let lhs = prod[1]
                        let new_stack = pop_n_gf(stack, pop_count)
                        let new_stack2 = push_gf(new_stack, lhs)
                        let new_ast = append(ast, ast_node_gf(lhs, node_id))
                        ll1_parse_rec_gf(table, grammar, tokens, pos, new_stack2, node_id + 1, new_ast)

let lr1_parse_gf(action_table, goto_table, tokens) =
    lr1_parse_rec_gf(action_table, goto_table, tokens, 0, [0], 0, [])

let lr1_parse_rec_gf(action, goto, tokens, pos, stack, node_id, ast) =
        if pos >= len(tokens)
            ast
        else
            let state = stack[len(stack) - 1]
            let tok = tokens[pos]
            let act = action[state][tok]
            if act == 0
                ast
            else
                if act < 10000
                    let new_stack = push_gf(push_gf(stack, tok), act)
                    lr1_parse_rec_gf(action, goto, tokens, pos + 1, new_stack, node_id, ast)
                    if act == 99999
                        ast
                    else
                        let prod_id = act - 10000
                        let prod = production_gf(prod_id)
                        let pop_count = prod[0]
                        let lhs = prod[1]
                        let new_stack = pop_n_gf(stack, 2 * pop_count)
                        let prev_state = new_stack[len(new_stack) - 1]
                        let next_state = goto[prev_state][lhs]
                        let new_stack2 = push_gf(push_gf(new_stack, lhs), next_state)
                        let new_ast = append(ast, ast_node_gf(lhs, node_id))
                        lr1_parse_rec_gf(action, goto, tokens, pos, new_stack2, node_id + 1, new_ast)

let production_gf(prod_id) =
    [2, prod_id]

