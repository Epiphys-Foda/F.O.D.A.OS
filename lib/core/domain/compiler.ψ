let ir_encode_gf(op, arg1, arg2, result) =
    gf_add(gf_add(gf_add(
        gf_mul(op, gf_mul(65537, gf_mul(65537, 65537))),
        gf_mul(arg1, gf_mul(65537, 65537))),
        gf_mul(arg2, 65537)),
        result)

let ir_gen_gf(ast) =
    ir_gen_rec_gf(ast, 0, [], 0)

let ir_gen_rec_gf(ast, i, ir, temp_counter) =
        if i >= len(ast)
            ir
        else
            let node = ast[i]
            let node_type = ast_node_type_gf(node)
            let (new_ir, new_temp) = ir_gen_node_gf(node, node_type, ir, temp_counter)
            ir_gen_rec_gf(ast, i + 1, new_ir, new_temp)

let ir_gen_node_gf(node, node_type, ir, temp) =
    let op = node_type
    let arg1 = temp
    let arg2 = temp + 1
    let result = temp + 2
    let new_ir = append(ir, ir_encode_gf(op, arg1, arg2, result))
    [new_ir, temp + 3]

