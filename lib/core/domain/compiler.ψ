let must_alias_gf(p1, p2, alias_set) =
    (alias_set[p1] == alias_set[p2]) ? 1 : 0

let abstract_interp_gf(program) =
    concrete_interp_gf(program)

let concrete_interp_gf(program) =
    concrete_interp_rec_gf(program, 0, {}, 0)

let concrete_interp_rec_gf(program, pc, env, step) =
        if pc >= len(program) || step >= 65537
            env
        else
            let inst = program[pc]
            let (new_pc, new_env) = exec_inst_gf(inst, pc, env)
            concrete_interp_rec_gf(program, new_pc, new_env, step + 1)

let exec_inst_gf(inst, pc, env) =
    [pc + 1, env]

let instruction_select_gf(ir_tree) =
    inst_select_rec_gf(ir_tree, 0, [])

let inst_select_rec_gf(ir_tree, i, instructions) =
        if i >= len(ir_tree)
            instructions
