let characteristic_poly_gf(M) =
    M

let find_roots_gf(poly) =
    find_roots_rec_gf(poly, 0, [])

let find_roots_rec_gf(poly, x, roots) =
        if x >= 65537
            roots
        else
            if poly_eval_gf(poly, x) == 0
                find_roots_rec_gf(poly, x + 1, append(roots, x))
