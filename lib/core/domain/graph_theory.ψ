let laplacian_gf(adj) =
    let n = len(adj)
    laplacian_rec_gf(adj, n, 0, [])

let laplacian_rec_gf(adj, n, i, L) =
        if i >= n
            L
        else
            let row = laplacian_row_gf(adj, n, i)
            laplacian_rec_gf(adj, n, i + 1, append(L, row))

let laplacian_row_gf(adj, n, i) =
    laplacian_row_rec_gf(adj, n, i, 0, [])

let laplacian_row_rec_gf(adj, n, i, j, row) =
        if j >= n
            row
        else
            if i == j
                row[ j] = degree_gf(adj, i)
                laplacian_row_rec_gf(adj, n, i, j + 1, row)
            else
                let row = vec_set_gf(row, j, gf_sub(0, adj[i][j]))
                laplacian_row_rec_gf(adj, n, i, j + 1, row)

let degree_gf(adj, v) =
    degree_rec_gf(adj, v, 0, 0)

let degree_rec_gf(adj, v, j, count) =
        if j >= len(adj)
            count
        else
            degree_rec_gf(adj, v, j + 1, gf_add(count, adj[v][j]))

let graph_ntt_spectrum_gf(adj) =
    let n = len(adj)
    ntt_spectrum_rec_gf(adj, n, 0, [])

let ntt_spectrum_rec_gf(adj, n, k, spectrum) =
        if k >= n
            spectrum
        else
            let omega = 4096
            let lambda_k = ntt_eigenvalue_gf(adj, omega, k, n)
            ntt_spectrum_rec_gf(adj, n, k + 1, append(spectrum, lambda_k))

let ntt_eigenvalue_gf(adj, omega, k, n) =
    ntt_eigenvalue_rec_gf(adj, omega, k, n, 0, 0, 0)

let ntt_eigenvalue_rec_gf(adj, omega, k, n, i, j, acc) =
        if i >= n
            acc
        else
            if j >= n
                ntt_eigenvalue_rec_gf(adj, omega, k, n, i + 1, 0, acc)
            else
                let phase = gf_pow(omega, gf_mul(k, gf_sub(j, i)))
                let term = gf_mul(adj[i][j], phase)
                ntt_eigenvalue_rec_gf(adj, omega, k, n, i, j + 1, gf_add(acc, term))

let graph_isomorphic_gf(adj1, adj2) =
        let n = len(adj1)
        if len(adj2) != n
            0
        else
            iso_search_gf(adj1, adj2, n, 0, identity_perm_gf(n))

let iso_search_gf(adj1, adj2, n, i, perm) =
        if i >= n
            check_isomorphism_gf(adj1, adj2, perm)
        else
            iso_try_perm_gf(adj1, adj2, n, i, perm, 0, 0)

let iso_try_perm_gf(adj1, adj2, n, i, perm, j, found) =
        if j >= n || found == 1
            found
        else
            let new_perm = perm
            let new_perm = vec_set_gf(new_perm, i, j)
            iso_try_perm_gf(adj1, adj2, n, i, perm, j + 1, iso_search_gf(adj1, adj2, n, i + 1, new_perm))

let check_isomorphism_gf(adj1, adj2, perm) =
    check_iso_rec_gf(adj1, adj2, perm, 0, 0, 1)

let check_iso_rec_gf(adj1, adj2, perm, i, j, valid) =
        if i >= len(adj1) || valid == 0
            valid
        else
            if j >= len(adj1)
                check_iso_rec_gf(adj1, adj2, perm, i + 1, 0, valid)
            else
                if adj1[i][j] != adj2[perm[i]][perm[j]]
                    check_iso_rec_gf(adj1, adj2, perm, i, j + 1, 0)
                else
                    check_iso_rec_gf(adj1, adj2, perm, i, j + 1, valid)

let identity_perm_gf(n) =
    identity_perm_rec_gf(n, 0, [])

let identity_perm_rec_gf(n, i, perm) =
        if i >= n
            perm
        else
            identity_perm_rec_gf(n, i + 1, append(perm, i))

let hamilton_path_gf(adj) =
    let n = len(adj)
    hamilton_search_gf(adj, n, 0, [0], 1)

let hamilton_search_gf(adj, n, current, path, visited) =
        if len(path) == n
            1
        else
            hamilton_try_next_gf(adj, n, current, path, visited, 0, 0)

let hamilton_try_next_gf(adj, n, current, path, visited, next, found) =
        if next >= n || found == 1
            found
        else
            if adj[current][next] == 1 && !visited_bit_gf(visited, next)
                let new_path = append(path, next)
                let new_visited = set_visited_bit_gf(visited, next)
                hamilton_try_next_gf(adj, n, current, path, visited, next + 1, hamilton_search_gf(adj, n, next, new_path, new_visited))
            else
                hamilton_try_next_gf(adj, n, current, path, visited, next + 1, found)

let visited_bit_gf(visited, v) =
    (visited >> v) & 1

let set_visited_bit_gf(visited, v) =
    visited | (1 << v)

let cayley_gf(n) =
    gf_pow(n, n - 2)

let mst_gf(adj, weights) =
    let edges = sort_edges_by_weight_gf(adj, weights)
    mst_kruskal_gf(edges, len(adj), 0, [], 0)

let sort_edges_by_weight_gf(adj, weights) =
    edges_list_gf(adj, weights)

let edges_list_gf(adj, weights) =
    edges_list_rec_gf(adj, weights, 0, 0, [])

let edges_list_rec_gf(adj, weights, i, j, edges) =
        if i >= len(adj)
            edges
        else
            if j >= len(adj)
                edges_list_rec_gf(adj, weights, i + 1, 0, edges)
                if adj[i][j] == 1 && i < j
                    edges_list_rec_gf(adj, weights, i, j + 1, append(edges, [i, j, weights[i][j]]))
                else
                    edges_list_rec_gf(adj, weights, i, j + 1, edges)

let mst_kruskal_gf(edges, n, i, mst, total_weight) =
        if i >= len(edges) || len(mst) == n - 1
            [mst, total_weight]
        else
            let e = edges[i]
            if find_uf_gf(e[0]) != find_uf_gf(e[1])
                union_uf_gf(e[0], e[1])
                mst_kruskal_gf(edges, n, i + 1, append(mst, e), gf_add(total_weight, e[2]))
            else
                mst_kruskal_gf(edges, n, i + 1, mst, total_weight)

let find_uf_gf(x) =
    x

let union_uf_gf(x, y) =
    0

let shortest_path_gf(adj, weights, source, target) =
    let n = len(adj)
    let dist = init_dist_gf(n, source)
    let visited = zero_vec_gf(n)
    dijkstra_gf(adj, weights, dist, visited, n, target)

let init_dist_gf(n, source) =
    init_dist_rec_gf(n, source, 0, [])

let init_dist_rec_gf(n, source, i, dist) =
        if i >= n
            dist
        else
            if i == source
                init_dist_rec_gf(n, source, i + 1, append(dist, 0))
            else
                init_dist_rec_gf(n, source, i + 1, append(dist, 65536))

let dijkstra_gf(adj, weights, dist, visited, n, target) =
        let u = find_min_unvisited_gf(dist, visited, n)
        if u < 0 || u == target
            dist[target]
        else
            let new_visited = visited
            let new_visited = vec_set_gf(new_visited, u, 1)
            let new_dist = relax_neighbors_gf(adj, weights, dist, u, n)
            dijkstra_gf(adj, weights, new_dist, new_visited, n, target)

let find_min_unvisited_gf(dist, visited, n) =
    find_min_rec_gf(dist, visited, n, 0, -1, 65536)

let find_min_rec_gf(dist, visited, n, i, best, best_dist) =
        if i >= n
            best
        else
            if visited[i] == 0 && dist[i] < best_dist
                find_min_rec_gf(dist, visited, n, i + 1, i, dist[i])
            else
                find_min_rec_gf(dist, visited, n, i + 1, best, best_dist)

let relax_neighbors_gf(adj, weights, dist, u, n) =
    relax_rec_gf(adj, weights, dist, u, n, 0, dist)

let relax_rec_gf(adj, weights, dist, u, n, v, new_dist) =
        if v >= n
            new_dist
        else
            if adj[u][v] == 1
                let alt = gf_add(dist[u], weights[u][v])
                if alt < new_dist[v]
                    let new_dist = vec_set_gf(new_dist, v, alt)
                relax_rec_gf(adj, weights, dist, u, n, v + 1, new_dist)
            else
                relax_rec_gf(adj, weights, dist, u, n, v + 1, new_dist)

