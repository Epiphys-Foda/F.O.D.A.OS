let connected_components_gf(adj) =
    let n = len(adj)
    let parent = identity_perm_gf(n)
    components_union_gf(adj, parent, n, 0, 0)

let components_union_gf(adj, parent, n, i, j) =
        if i >= n
            count_components_gf(parent, n)
        else
            if j >= n
                components_union_gf(adj, parent, n, i + 1, 0)
                if adj[i][j] == 1
                    union_uf_gf(i, j)
                    components_union_gf(adj, parent, n, i, j + 1)
                else
                    components_union_gf(adj, parent, n, i, j + 1)

let count_components_gf(parent, n) =
    count_components_rec_gf(parent, n, 0, 0)

let count_components_rec_gf(parent, n, i, count) =
