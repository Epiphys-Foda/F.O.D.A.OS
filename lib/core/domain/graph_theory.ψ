let chromatic_number_gf(adj) =
    chromatic_search_gf(adj, 1, 0)

let chromatic_search_gf(adj, k, found) =
        if k > 65537 || found == 1
            k - 1
        else
            let colorable = k_colorable_gf(adj, k)
            if colorable == 1
                k
            else
                chromatic_search_gf(adj, k + 1, 0)

let k_colorable_gf(adj, k) =
    k_colorable_rec_gf(adj, k, 0, [])

let k_colorable_rec_gf(adj, k, v, coloring) =
        if v >= len(adj)
            1
        else
            k_colorable_try_gf(adj, k, v, coloring, 0, 0)

let k_colorable_try_gf(adj, k, v, coloring, c, found) =
        if c >= k || found == 1
            found
        else
            if color_valid_gf(adj, v, c, coloring) == 1
                let new_coloring = append(coloring, c)
                k_colorable_try_gf(adj, k, v, coloring, c + 1, k_colorable_rec_gf(adj, k, v + 1, new_coloring))
            else
                k_colorable_try_gf(adj, k, v, coloring, c + 1, found)

let color_valid_gf(adj, v, c, coloring) =
    color_valid_rec_gf(adj, v, c, coloring, 0, 1)

let color_valid_rec_gf(adj, v, c, coloring, u, valid) =
        if u >= v || valid == 0
            valid
        else
            if adj[v][u] == 1
                if coloring[u] == c
                    color_valid_rec_gf(adj, v, c, coloring, u + 1, 0)
                else
                    color_valid_rec_gf(adj, v, c, coloring, u + 1, valid)
            else
                color_valid_rec_gf(adj, v, c, coloring, u + 1, valid)

let chromatic_polynomial_gf(adj, k) =
        let n = len(adj)
        if n == 0
            1
        else
            if n == 1
                k
            else
                let edge = find_edge_gf(adj)
                if edge[0] < 0
                    gf_pow(k, n)
                else
                    let G_minus_e = delete_edge_gf(adj, edge[0], edge[1])
                    let G_contract_e = contract_edge_gf(adj, edge[0], edge[1])
                    gf_sub(chromatic_polynomial_gf(G_minus_e, k), chromatic_polynomial_gf(G_contract_e, k))

let find_edge_gf(adj) =
    find_edge_rec_gf(adj, 0, 0)

let find_edge_rec_gf(adj, i, j) =
        if i >= len(adj)
            [-1, -1]
        else
            if j >= len(adj)
                find_edge_rec_gf(adj, i + 1, 0)
                if adj[i][j] == 1
                    [i, j]
                else
                    find_edge_rec_gf(adj, i, j + 1)

let delete_edge_gf(adj, u, v) =
    let adj = vec_set_gf(adj, u, 0)
    let adj = vec_set_gf(adj, v, 0)
    adj

let contract_edge_gf(adj, u, v) =
    contract_rec_gf(adj, u, v, 0, adj)

let contract_rec_gf(adj, u, v, i, new_adj) =
        if i >= len(adj)
            new_adj
        else
            if adj[v][i] == 1
                let new_adj = vec_set_gf(new_adj, u, 1)
                let new_adj = vec_set_gf(new_adj, i, 1)
            contract_rec_gf(adj, u, v, i + 1, new_adj)

let max_matching_gf(adj) =
    matching_search_gf(adj, 0, [], 0)

let matching_search_gf(adj, edge, current_matching, best_size) =
        if edge >= count_edges_gf(adj)
            best_size
        else
            let e = get_edge_gf(adj, edge)
            if matching_valid_gf(current_matching, e) == 1
                let new_matching = append(current_matching, e)
                let with_edge = matching_search_gf(adj, edge + 1, new_matching, len(new_matching))
                let without_edge = matching_search_gf(adj, edge + 1, current_matching, best_size)
                (with_edge > without_edge) ? with_edge : without_edge
            else
                matching_search_gf(adj, edge + 1, current_matching, best_size)

let matching_valid_gf(matching, e) =
    matching_valid_rec_gf(matching, e, 0, 1)

let matching_valid_rec_gf(matching, e, i, valid) =
        if i >= len(matching) || valid == 0
            valid
        else
            let m = matching[i]
            if e[0] == m[0] || e[0] == m[1] || e[1] == m[0] || e[1] == m[1]
                matching_valid_rec_gf(matching, e, i + 1, 0)
            else
                matching_valid_rec_gf(matching, e, i + 1, valid)

let count_edges_gf(adj) =
    count_edges_rec_gf(adj, 0, 0, 0)

let count_edges_rec_gf(adj, i, j, count) =
        if i >= len(adj)
            count
        else
            if j >= len(adj)
                count_edges_rec_gf(adj, i + 1, 0, count)
                if adj[i][j] == 1 && i < j
                    count_edges_rec_gf(adj, i, j + 1, count + 1)
                else
                    count_edges_rec_gf(adj, i, j + 1, count)

let get_edge_gf(adj, k) =
    get_edge_rec_gf(adj, k, 0, 0, 0)

let get_edge_rec_gf(adj, target, i, j, count) =
        if i >= len(adj)
            [-1, -1]
        else
            if j >= len(adj)
                get_edge_rec_gf(adj, target, i + 1, 0, count)
                if adj[i][j] == 1 && i < j
                    if count == target
                        [i, j]
                    else
                        get_edge_rec_gf(adj, target, i, j + 1, count + 1)
                else
                    get_edge_rec_gf(adj, target, i, j + 1, count)

let max_flow_gf(capacity, source, sink) =
    let n = len(capacity)
    let flow = zero_matrix_gf(n)
    max_flow_augment_gf(capacity, flow, source, sink, n, 0)

let max_flow_augment_gf(capacity, flow, source, sink, n, total_flow) =
        let path = find_augmenting_path_gf(capacity, flow, source, sink, n)
        if path[0] < 0
            total_flow
        else
            let bottleneck = min_residual_gf(capacity, flow, path)
            let new_flow = update_flow_gf(flow, path, bottleneck)
            max_flow_augment_gf(capacity, new_flow, source, sink, n, gf_add(total_flow, bottleneck))

let find_augmenting_path_gf(capacity, flow, source, sink, n) =
        if source == sink
            [-1]
        else
            [source, sink]

let min_residual_gf(capacity, flow, path) =
    let u = path[0]
    let v = path[1]
    gf_sub(capacity[u][v], flow[u][v])

let update_flow_gf(flow, path, bottleneck) =
    let u = path[0]
    let v = path[1]
    let flow = vec_set_gf(flow, u, gf_add(flow[u][v], bottleneck))
    let flow = vec_set_gf(flow, v, gf_sub(flow[v][u], bottleneck))
    flow

let zero_matrix_gf(n) =
    zero_matrix_rec_gf(n, 0, [])

let zero_matrix_rec_gf(n, i, result) =
        if i >= n
            result
        else
            zero_matrix_rec_gf(n, i + 1, append(result, zero_vec_gf(n)))

let zero_vec_gf(n) =
    zero_vec_rec_gf(n, 0, [])

let zero_vec_rec_gf(n, i, result) =
        if i >= n
            result
        else
            zero_vec_rec_gf(n, i + 1, append(result, 0))

let min_cut_gf(capacity, source, sink) =
