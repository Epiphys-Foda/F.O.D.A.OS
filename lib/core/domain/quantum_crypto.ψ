let shamir_share(secret, coefficients, t, n) =
    _shamir_share_loop(secret, coefficients, t, n, 1, [])
let _shamir_share_loop(secret, coeffs, t, n, i, shares) =
        if i > n
            shares
        else
            let f_i = _shamir_eval_poly(secret, coeffs, t, i)
            _shamir_share_loop(secret, coeffs, t, n, i + 1, arr_concat(shares, [[i, f_i]]))
let _shamir_eval_poly(secret, coeffs, t, x) =
    _shamir_poly_loop(secret, coeffs, t, x, 1, secret)
let _shamir_poly_loop(secret, coeffs, t, x, k, acc) =
        if k >= t
            acc
        else
            let x_pow = gf_pow(x, k)
            let term = gf_mul(coeffs[k - 1], x_pow)
            _shamir_poly_loop(secret, coeffs, t, x, k + 1, gf_add(acc, term))

let shamir_reconstruct(shares, t) =
    _shamir_lagrange(shares, t, 0, 0)
let _shamir_lagrange(shares, t, i, acc) =
        if i >= t
            acc
        else
            let x_i = shares[i][0]
            let y_i = shares[i][1]
            let lagrange_coeff = _lagrange_basis(shares, t, i, 0)
            let term = gf_mul(y_i, lagrange_coeff)
            _shamir_lagrange(shares, t, i + 1, gf_add(acc, term))
let _lagrange_basis(shares, t, i, j) =
    _lagrange_loop(shares, t, i, 0, 1)
let _lagrange_loop(shares, t, i, j, acc) =
    if j >= t
        acc
    else
        0
    if j == i
        _lagrange_loop(shares, t, i, j + 1, acc)
    else
        let x_i = shares[i][0]
        let x_j = shares[j][0]
        let numerator = gf_neg(x_j)
        let denominator = gf_sub(x_i, x_j)
        let factor = gf_div(numerator, denominator)
        _lagrange_loop(shares, t, i, j + 1, gf_mul(acc, factor))

