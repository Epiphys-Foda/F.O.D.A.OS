let algebraic_hash(message, r_param, n) =
    _hash_loop(message, r_param, n, 0, 0)
let _hash_loop(msg, r, n, i, acc) =
        if i >= n
            acc
        else
            let term = gf_mul(msg[i], gf_pow(r, i))
            _hash_loop(msg, r, n, i + 1, gf_add(acc, term))

let quantum_sign(message, private_key, r_param, n) =
    let h = algebraic_hash(message, r_param, n)
    gf_add(h, private_key)

let quantum_verify(message, signature, public_key, r_param, n) =
    let h = algebraic_hash(message, r_param, n)
    let computed_key = gf_sub(signature, h)
    (computed_key == public_key ? 1 : 0)

