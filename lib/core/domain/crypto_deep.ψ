let shamir_share_gf(secret, n, t) =
    let poly = shamir_poly_gf(secret, t)
    shamir_shares_rec_gf(poly, n, 1, [])

let shamir_poly_gf(secret, t) =
    shamir_poly_rec_gf(secret, t, 1, [secret])

let shamir_poly_rec_gf(secret, t, i, poly) =
        if i >= t
            poly
        else
            let coeff = gf_add(secret, i)
            shamir_poly_rec_gf(secret, t, i + 1, append(poly, coeff))

let shamir_shares_rec_gf(poly, n, i, shares) =
        if i > n
            shares
        else
            let s_i = poly_eval_gf(poly, i)
            shamir_shares_rec_gf(poly, n, i + 1, append(shares, s_i))

let shamir_reconstruct_gf(shares, indices) =
    shamir_reconstruct_rec_gf(shares, indices, 0, 0)

let shamir_reconstruct_rec_gf(shares, indices, i, secret) =
        if i >= len(shares)
            secret
        else
            let lagrange = lagrange_basis_gf(indices, i, 0)
            let term = gf_mul(shares[i], lagrange)
            shamir_reconstruct_rec_gf(shares, indices, i + 1, gf_add(secret, term))

let lagrange_basis_gf(indices, i, j) =
    lagrange_basis_rec_gf(indices, i, j, 0, 1, 1)

let lagrange_basis_rec_gf(indices, i, j, num, num_acc, den_acc) =
        if j >= len(indices)
            gf_div(num_acc, den_acc)
        else
            if j == i
                lagrange_basis_rec_gf(indices, i, j + 1, num, num_acc, den_acc)
            else
                let new_num = gf_mul(num_acc, gf_sub(0, indices[j]))
                let new_den = gf_mul(den_acc, gf_sub(indices[i], indices[j]))
                lagrange_basis_rec_gf(indices, i, j + 1, num, new_num, new_den)

let mpc_add_gf(shares1, shares2) =
    mpc_add_rec_gf(shares1, shares2, 0, [])

let mpc_add_rec_gf(shares1, shares2, i, result) =
        if i >= len(shares1)
            result
        else
            let sum = gf_add(shares1[i], shares2[i])
            mpc_add_rec_gf(shares1, shares2, i + 1, append(result, sum))

let mpc_mul_gf(shares1, shares2, beaver_triple) =
    let a = beaver_triple[0]
    let b = beaver_triple[1]
    let c = beaver_triple[2]
    let d = gf_sub(shares1[0], a)
    let e = gf_sub(shares2[0], b)
    gf_add(gf_add(gf_add(c, gf_mul(d, b)), gf_mul(e, a)), gf_mul(d, e))

