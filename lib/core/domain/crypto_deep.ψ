let lattice_element_gf(basis, coeffs) =
    lattice_element_rec_gf(basis, coeffs, 0, 0)

let lattice_element_rec_gf(basis, coeffs, i, acc) =
        if i >= len(basis)
            acc
        else
            let term = gf_mul(coeffs[i], basis[i])
            lattice_element_rec_gf(basis, coeffs, i + 1, gf_add(acc, term))

let svp_gf(basis) =
    svp_search_gf(basis, 1, 65537, 0)

let svp_search_gf(basis, c, best_norm, best_vec) =
        if c >= 65537
            best_vec
        else
            let v = lattice_element_gf(basis, [c])
            let norm = gf_norm_gf(v)
            if norm > 0 && norm < best_norm
                svp_search_gf(basis, c + 1, norm, v)
            else
                svp_search_gf(basis, c + 1, best_norm, best_vec)

let bdd_gf(basis, target) =
    bdd_search_gf(basis, target, 0, 65537, 0)

let bdd_search_gf(basis, target, c, best_dist, best_vec) =
        if c >= 65537
            best_vec
        else
            let v = lattice_element_gf(basis, [c])
            let dist = gf_norm_gf(gf_sub(v, target))
            if dist < best_dist
                bdd_search_gf(basis, target, c + 1, dist, v)
            else
                bdd_search_gf(basis, target, c + 1, best_dist, best_vec)

