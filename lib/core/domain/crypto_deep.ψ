let brute_force_gf(ciphertext, encrypt_fn) =
    brute_force_rec_gf(ciphertext, encrypt_fn, 0, 0)

let brute_force_rec_gf(ciphertext, encrypt_fn, key, found) =
        if key >= 65537 || found != 0
            found
        else
            let test = encrypt_fn(key)
            if test == ciphertext
                key
            else
                brute_force_rec_gf(ciphertext, encrypt_fn, key + 1, found)

