let lamport_sign_gf(key, message) =
    let bit = message % 2
    (bit == 0) ? key[0] : key[1]

let lamport_verify_gf(key, message, signature) =
    let bit = message % 2
    let expected = (bit == 0) ? key[0] : key[1]
    (signature == expected) ? 1 : 0

let wots_sign_gf(key, message, w) =
    let m_chunks = wots_chunk_gf(message, w)
    wots_sign_rec_gf(key, m_chunks, w, 0, [])

let wots_sign_rec_gf(key, chunks, w, i, signature) =
        if i >= len(chunks)
            signature
        else
            let sig_i = gf_pow(key[i], chunks[i])
            wots_sign_rec_gf(key, chunks, w, i + 1, append(signature, sig_i))

let wots_chunk_gf(message, w) =
    [message % 4, (message / 4) % 4]

