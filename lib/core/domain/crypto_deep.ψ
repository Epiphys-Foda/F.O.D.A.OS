let mq_system_gf(coeffs, vars) =
    let quadratic = mq_quadratic_gf(coeffs[0], vars)
    let linear = mq_linear_gf(coeffs[1], vars)
    gf_add(gf_add(quadratic, linear), coeffs[2])

let mq_quadratic_gf(A, vars) =
