let gram_schmidt_gf(basis) =
    gram_schmidt_rec_gf(basis, 0, [])

let gram_schmidt_rec_gf(basis, i, orthogonal) =
        if i >= len(basis)
            orthogonal
        else
            let b_i = basis[i]
            let projected = project_onto_all_gf(b_i, orthogonal, 0, b_i)
            gram_schmidt_rec_gf(basis, i + 1, append(orthogonal, projected))

let project_onto_all_gf(v, orthogonal, i, result) =
        if i >= len(orthogonal)
            result
        else
            let o = orthogonal[i]
            let proj_coeff = gf_div(gf_mul(v, o), gf_mul(o, o))
            let proj = gf_mul(proj_coeff, o)
            project_onto_all_gf(v, orthogonal, i + 1, gf_sub(result, proj))

let ntru_encrypt_gf(h, r, m, n) =
    let rh = poly_mul_mod_gf(r, h, n)
    poly_add_mod_gf(rh, m, n)

let ntru_decrypt_gf(f, fp, e, n) =
    let a = poly_mul_mod_gf(f, e, n)
    poly_mul_mod_gf(fp, a, n)

let poly_mul_mod_gf(a, b, n) =
    poly_mul_mod_rec_gf(a, b, n, 0, poly_zero_gf(n))

let poly_mul_mod_rec_gf(a, b, n, i, result) =
        if i >= len(a)
            result
        else
            let updated = poly_mul_shift_gf(result, b, a[i], i, n)
            poly_mul_mod_rec_gf(a, b, n, i + 1, updated)

let poly_mul_shift_gf(result, b, coeff, shift, n) =
    poly_mul_shift_rec_gf(result, b, coeff, shift, n, 0, result)

let poly_mul_shift_rec_gf(result, b, coeff, shift, n, j, acc) =
        if j >= len(b)
            acc
        else
            let idx = (shift + j) % n
            let term = gf_mul(coeff, b[j])
            let new_acc = acc
            new_acc[idx] = gf_add(new_acc[idx], term)
            poly_mul_shift_rec_gf(result, b, coeff, shift, n, j + 1, new_acc)

let poly_add_mod_gf(a, b, n) =
    poly_add_mod_rec_gf(a, b, n, 0, poly_zero_gf(n))

let poly_add_mod_rec_gf(a, b, n, i, result) =
        if i >= n
            result
        else
            let ai = (i < len(a)) ? a[i] : 0
            let bi = (i < len(b)) ? b[i] : 0
            result[i] = gf_add(ai, bi)
            poly_add_mod_rec_gf(a, b, n, i + 1, result)

let poly_zero_gf(n) =
    poly_zero_rec_gf(n, 0, [])

let poly_zero_rec_gf(n, i, result) =
        if i >= n
            result
        else
            poly_zero_rec_gf(n, i + 1, append(result, 0))

