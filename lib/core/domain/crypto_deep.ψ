let fhe_eval_gf(circuit, enc_inputs) =
    fhe_eval_rec_gf(circuit, enc_inputs, 0, [])

let fhe_eval_rec_gf(circuit, inputs, i, eval_stack) =
        if i >= len(circuit)
            eval_stack[0]
        else
            let gate = circuit[i]
            let result = fhe_eval_gate_gf(gate, eval_stack, inputs)
            fhe_eval_rec_gf(circuit, inputs, i + 1, push_gf(eval_stack, result))

let fhe_eval_gate_gf(gate, stack, inputs) =
        if gate == 1
            let a = stack[len(stack) - 1]
            let b = stack[len(stack) - 2]
            fhe_add_gf(a, b)
        else
            if gate == 2
                let a = stack[len(stack) - 1]
                let b = stack[len(stack) - 2]
                fhe_mul_gf(a, b)
            else
                inputs[gate - 3]

