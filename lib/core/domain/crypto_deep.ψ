let lwe_encrypt_gf(s, a, e, m) =
    let as_prod = gf_mul(a, s)
    let as_e = gf_add(as_prod, e)
    gf_add(as_e, m)

let lwe_decrypt_gf(s, a, b) =
    let as_prod = gf_mul(a, s)
    gf_sub(b, as_prod)

