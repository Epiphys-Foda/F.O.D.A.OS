let mq_quadratic_rec_gf(A, vars, i, j, acc) =
        if i >= len(vars)
            acc
        else
            if j >= len(vars)
                mq_quadratic_rec_gf(A, vars, i + 1, 0, acc)
            else
                let term = gf_mul(A[i][j], gf_mul(vars[i], vars[j]))
                mq_quadratic_rec_gf(A, vars, i, j + 1, gf_add(acc, term))

let mq_linear_gf(b, vars) =
