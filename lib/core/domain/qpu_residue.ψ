import "../stdlib/gf65537.ψ"
import "./residue_plate.ψ"

let QPU_INV_SQRT = 2040
let QPU_I_UNIT   = 256
let QPU_E_IPI4   = 65521
let QPU_NEG_ONE  = 65536
let QPU_Z_BASE0  = 1
let QPU_Z_BASE1  = 2
let QPU_N_QUBIT  = 2

let qpu_state_new(alpha, beta) =
    let plate = plate_new(QPU_N_QUBIT)
    plate_add_pole(plate, QPU_Z_BASE0, alpha)
    plate_add_pole(plate, QPU_Z_BASE1, beta)
    plate

let qpu_state_zero() = qpu_state_new(1, 0)

let qpu_state_one() = qpu_state_new(0, 1)

let qpu_state_plus() = qpu_state_new(QPU_INV_SQRT, QPU_INV_SQRT)

let qpu_state_minus() = qpu_state_new(QPU_INV_SQRT, gf_sub(0, QPU_INV_SQRT))

let qpu_amplitude_0(plate) = plate_get_r(plate, 0)

let qpu_amplitude_1(plate) = plate_get_r(plate, 1)

let qpu_wave_function(plate, z) = plate_eval(plate, z)

let qpu_norm(plate) =
    let a = plate_get_r(plate, 0)
    let b = plate_get_r(plate, 1)
    let a2 = gf_mul(a, a)
    let b2 = gf_mul(b, b)
    gf_add(a2, b2)

let qpu_h(plate) =
    let a = plate_get_r(plate, 0)
    let b = plate_get_r(plate, 1)
    let sum = gf_add(a, b)
    let diff = gf_sub(a, b)
    let new_a = gf_mul(sum, QPU_INV_SQRT)
    let new_b = gf_mul(diff, QPU_INV_SQRT)
    arr_set(plate, 2, new_a)
    arr_set(plate, 4, new_b)
    plate

let qpu_s(plate) =
    let b = plate_get_r(plate, 1)
    let new_b = gf_mul(QPU_I_UNIT, b)
    arr_set(plate, 4, new_b)
    plate

let qpu_t(plate) =
    let b = plate_get_r(plate, 1)
    let new_b = gf_mul(QPU_E_IPI4, b)
    arr_set(plate, 4, new_b)
    plate

let qpu_x(plate) =
    let a = plate_get_r(plate, 0)
    let b = plate_get_r(plate, 1)
    arr_set(plate, 2, b)
    arr_set(plate, 4, a)
    plate

let qpu_z(plate) =
    let b = plate_get_r(plate, 1)
    let new_b = gf_mul(QPU_NEG_ONE, b)
    arr_set(plate, 4, new_b)
    plate

let qpu_y(plate) =
    let a = plate_get_r(plate, 0)
    let b = plate_get_r(plate, 1)
    let new_a = gf_neg(gf_mul(QPU_I_UNIT, b))
    let new_b = gf_mul(QPU_I_UNIT, a)
    arr_set(plate, 2, new_a)
    arr_set(plate, 4, new_b)
    plate

let qpu_h_squared(plate) =
    qpu_h(plate)
    qpu_h(plate)
    plate

let qpu_s_pow4_impl(plate, count) =
      if count < 4
        qpu_s(plate)
        qpu_s_pow4_impl(plate, count + 1)
      else
        plate

let qpu_s_pow4(plate) = qpu_s_pow4_impl(plate, 0)

let qpu_t_pow8_impl(plate, count) =
      if count < 8
        qpu_t(plate)
        qpu_t_pow8_impl(plate, count + 1)
      else
        plate

let qpu_t_pow8(plate) = qpu_t_pow8_impl(plate, 0)

let qpu_x_squared(plate) =
    qpu_x(plate)
    qpu_x(plate)
    plate

let qpu_z_squared(plate) =
    qpu_z(plate)
    qpu_z(plate)
    plate

let qpu_measure_impl(plate, idx, n, max_val, max_idx) =
      if idx < n
        let r = plate_get_r(plate, idx)
        let r2 = gf_mul(r, r)
        let is_greater = (r2 > max_val)
        let new_max_val = ((is_greater) ? (r2) : (max_val))
        let new_max_idx = ((is_greater) ? (idx) : (max_idx))
        qpu_measure_impl(plate, idx + 1, n, new_max_val, new_max_idx)
      else
        max_idx

let qpu_measure(plate) =
    let n = plate_size(plate)
    qpu_measure_impl(plate, 0, n, 0, 0)

let qpu_bragg(plate, z) = plate_bragg(plate, z)

let qpu_norm_check(plate) = (qpu_norm(plate) == 1)

let qpu_zero_norm_state() = qpu_state_new(1, QPU_I_UNIT)

let qpu_zero_norm_check() = qpu_norm(qpu_zero_norm_state())

