let qpu_state_fill_impl(plate, amp_arr, k, dim) =
      if k < dim
        let a = arr_get(amp_arr, k)
        plate_add_pole(plate, k + 1, a)
        qpu_state_fill_impl(plate, amp_arr, k + 1, dim)
      else
        plate

let qpu_state_new_n(amp_arr, n) =
    let dim = 1 << n
    let plate = plate_new(dim)
    qpu_state_fill_impl(plate, amp_arr, 0, dim)
    plate

let qpu_state_basis_impl(plate, k_target, i, dim) =
      if i < dim
        let a = (i == k_target) ? 1 : 0
        plate_add_pole(plate, i + 1, a)
        qpu_state_basis_impl(plate, k_target, i + 1, dim)
      else
        plate

let qpu_state_basis(k_target, n) =
    let dim = 1 << n
    let plate = plate_new(dim)
    qpu_state_basis_impl(plate, k_target, 0, dim)
    plate

let qpu_state_zeros(n) = qpu_state_basis(0, n)

let qpu_state_amplitude_k(plate, k) = plate_get_r(plate, k)

let qpu_state_n_qubits_impl(n_poles, count) =
      if n_poles > 1
        qpu_state_n_qubits_impl(n_poles >> 1, count + 1)
      else
        count

let qpu_state_n_qubits(plate) =
    let n_poles = plate_size(plate)
    qpu_state_n_qubits_impl(n_poles, 0)

let qpu_h_on_impl(plate, q, k, dim) =
      if k < dim
        let bit_q = (k >> q) & 1
        let process = (bit_q == 0)
        let partner = k | (1 << q)
        let a = plate_get_r(plate, k)
        let b = plate_get_r(plate, partner)
        let sum = gf_add(a, b)
        let diff = gf_sub(a, b)
        let cand_a = gf_mul(sum, QPU_INV_SQRT)
        let cand_b = gf_mul(diff, QPU_INV_SQRT)
        let new_a = ((process) ? (cand_a) : (a))
        let new_b = ((process) ? (cand_b) : (b))
        arr_set(plate, 2 * k + 2, new_a)
        arr_set(plate, 2 * partner + 2, new_b)
        qpu_h_on_impl(plate, q, k + 1, dim)
      else
        plate

let qpu_h_on(plate, q) =
    let n = qpu_state_n_qubits(plate)
    let dim = 1 << n
    qpu_h_on_impl(plate, q, 0, dim)

let qpu_x_on_impl(plate, q, k, dim) =
      if k < dim
        let bit_q = (k >> q) & 1
        let process = (bit_q == 0)
        let partner = k | (1 << q)
        let a = plate_get_r(plate, k)
        let b = plate_get_r(plate, partner)
        let new_a = ((process) ? (b) : (a))
        let new_b = ((process) ? (a) : (b))
        arr_set(plate, 2 * k + 2, new_a)
        arr_set(plate, 2 * partner + 2, new_b)
        qpu_x_on_impl(plate, q, k + 1, dim)
      else
        plate

let qpu_x_on(plate, q) =
    let n = qpu_state_n_qubits(plate)
    let dim = 1 << n
    qpu_x_on_impl(plate, q, 0, dim)

let qpu_z_on_impl(plate, q, k, dim) =
      if k < dim
        let bit_q = (k >> q) & 1
        let negate = (bit_q == 1)
        let r = plate_get_r(plate, k)
        let neg_r = gf_neg(r)
        let new_r = ((negate) ? (neg_r) : (r))
        arr_set(plate, 2 * k + 2, new_r)
        qpu_z_on_impl(plate, q, k + 1, dim)
      else
        plate

let qpu_z_on(plate, q) =
    let n = qpu_state_n_qubits(plate)
    let dim = 1 << n
    qpu_z_on_impl(plate, q, 0, dim)

let qpu_cnot_impl(plate, c, t, k, dim) =
      if k < dim
        let bit_c = (k >> c) & 1
        let process = (bit_c == 1)
        let mask = 1 << t
        let partner = (k | mask) - (k & mask)
        let can_swap = (k < partner)
        let do_swap = ((process) ? (can_swap) : (0))
        let a = plate_get_r(plate, k)
        let b = plate_get_r(plate, partner)
        let new_a = ((do_swap) ? (b) : (a))
        let new_b = ((do_swap) ? (a) : (b))
        arr_set(plate, 2 * k + 2, new_a)
        arr_set(plate, 2 * partner + 2, new_b)
        qpu_cnot_impl(plate, c, t, k + 1, dim)
      else
        plate

let qpu_cnot(plate, c, t) =
    let n = qpu_state_n_qubits(plate)
    let dim = 1 << n
    qpu_cnot_impl(plate, c, t, 0, dim)

let qpu_measure_n(plate) =
    let n = plate_size(plate)
    qpu_measure_impl(plate, 0, n, 0, 0)

let qpu_norm_n_impl(plate, k, dim, acc) =
      if k < dim
        let r = plate_get_r(plate, k)
        let r2 = gf_mul(r, r)
        let new_acc = gf_add(acc, r2)
        qpu_norm_n_impl(plate, k + 1, dim, new_acc)
      else
        acc

let qpu_norm_n(plate) =
    let n = plate_size(plate)
    qpu_norm_n_impl(plate, 0, n, 0)

let qpu_norm_n_check(plate) = (qpu_norm_n(plate) == 1)

let qpu_state_bell_phi_plus() =
    let plate = plate_new(4)
    plate_add_pole(plate, 1, QPU_INV_SQRT)
    plate_add_pole(plate, 2, 0)
    plate_add_pole(plate, 3, 0)
    plate_add_pole(plate, 4, QPU_INV_SQRT)
    plate

let qpu_state_bell_phi_minus() =
    let plate = plate_new(4)
    plate_add_pole(plate, 1, QPU_INV_SQRT)
    plate_add_pole(plate, 2, 0)
    plate_add_pole(plate, 3, 0)
    plate_add_pole(plate, 4, gf_sub(0, QPU_INV_SQRT))
    plate

let qpu_state_bell_psi_plus() =
    let plate = plate_new(4)
    plate_add_pole(plate, 1, 0)
    plate_add_pole(plate, 2, QPU_INV_SQRT)
    plate_add_pole(plate, 3, QPU_INV_SQRT)
    plate_add_pole(plate, 4, 0)
    plate

let qpu_state_bell_psi_minus() =
    let plate = plate_new(4)
    plate_add_pole(plate, 1, 0)
    plate_add_pole(plate, 2, QPU_INV_SQRT)
    plate_add_pole(plate, 3, gf_sub(0, QPU_INV_SQRT))
    plate_add_pole(plate, 4, 0)
    plate

let qpu_make_bell_circuit() =
    let plate = qpu_state_zeros(2)
    qpu_h_on(plate, 0)
    qpu_cnot(plate, 0, 1)
    plate
