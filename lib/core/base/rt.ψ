let heap_create(capacity) = [[], [], 0, capacity]
let heap_alloc(heap, kind, size) =
    if heap[2] >= heap[3]
        [0, heap]
    let id = heap[2]
    let data = []
    let i = 0
    for i < size
        data.push(0)
        i = i + 1
    let obj = [id, kind, data, 1, 0]
    let objects = heap[0]
    objects.push(obj)
    [id, [objects, heap[1], heap[2] + 1, heap[3]]]
let heap_get(heap, id) =
    let objects = heap[0]
    (id < len(objects) ? objects[id] : [0, 0, [], 0, 0])
let heap_set(heap, id, obj) =
    let objects = heap[0]
    objects[id] = obj
    [objects, heap[1], heap[2], heap[3]]

let obj_retain(obj) = [obj[0], obj[1], obj[2], obj[3] + 1, obj[4]]
let obj_release(obj) = [obj[0], obj[1], obj[2], obj[3] - 1, obj[4]]
let obj_should_free(obj) =
    (obj[3] == 0 ? 1 : 0)

let gc_mark(heap, root_set) =
    let objects = heap[0]
    let i = 0
    let n = len(root_set)
    for i < n
        let obj = heap_get(heap, root_set[i])
        objects[root_set[i]] = [obj[0], obj[1], obj[2], obj[3], 1]
        i = i + 1
    [objects, heap[1], heap[2], heap[3]]
let gc_sweep(heap) =
    let objects = heap[0]
    let new_objects = []
    let count = 0
    let i = 0
    let n = len(objects)
    for i < n
        let obj = objects[i]
        if obj[4] == 1
            new_objects.push([obj[0], obj[1], obj[2], obj[3], 0])
            count = count + 1
        i = i + 1
    [new_objects, [], count, heap[3]]
let gc_collect(heap, root_set) =
    let marked = gc_mark(heap, root_set)
    gc_sweep(marked)

let frame_create(function, n_locals) =
    let locals = []
    let i = 0
    for i < n_locals
        locals.push(0)
        i = i + 1
    [function, 0, locals, []]
let frame_local_get(frame, idx) = frame[2][idx]
let frame_local_set(frame, idx, value) =
    let locals = frame[2]
    locals[idx] = value
    [frame[0], frame[1], locals, frame[3]]

