let field_evolve(ops_type, ops_data, n, max_steps) =
    let steps = 0
    let converged = 0
    for steps < max_steps
        let changed = field_step(ops_type, ops_data, n)
        if changed == 0
            converged = 1
            steps = max_steps
        steps = steps + 1
    let stack = arr_new_n(n)
    let sp = 0
    let i = 0
    for i < n
        let t = ops_type[i]
        if t == 0
            stack[sp] = ops_data[i]
            sp = sp + 1
        if t == 1
            if sp >= 2
                let b = stack[sp - 1]
                let a = stack[sp - 2]
                sp = sp - 2
                stack[sp] = (a * b) % P
                sp = sp + 1
        if t == 2
            if sp >= 2
                let b = stack[sp - 1]
                let a = stack[sp - 2]
