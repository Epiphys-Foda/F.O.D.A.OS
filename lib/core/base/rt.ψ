                stack[sp] = (a + b) % P
                sp = sp + 1
        if t == 3
            if sp >= 1
                stack[sp - 1] = (stack[sp - 1] * 3) % P
        if t == 4
            if sp >= 1
                let a = stack[sp - 1]
                if a > 32768
                    stack[sp - 1] = 0
