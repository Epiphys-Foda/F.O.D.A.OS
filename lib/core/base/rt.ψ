    out[1] = steps
    out[2] = converged
    out

let residue_theorem_global(residues, n) =
    let sum = 0
    let i = 0
    for i < n
        sum = (sum + residues[i]) % P
        i = i + 1
    sum

let field_energy(residues, n) =
    let e = 0
    let i = 0
    for i < n
        let r = residues[i]
        e = (e + r * r) % P
        i = i + 1
    e

let field_gradient(poles, residues, n, k) =
    let grad = 0
    let z_k = poles[k]
    let r_k = residues[k]
    let j = 0
    for j < n
        if j != k
            let diff = (z_k + P - poles[j]) % P
            let inv_diff = gf_inv(diff)
            let inv_diff2 = (inv_diff * inv_diff) % P
            grad = (grad + r_k * inv_diff2) % P
        j = j + 1
    grad

let field_flow(poles, residues, n, eta) =
    let new_poles = arr_new_n(n)
    let i = 0
    for i < n
        let grad = field_gradient(poles, residues, n, i)
        let new_z = (poles[i] + eta * grad) % P
        new_poles[i] = new_z
        i = i + 1
    new_poles

let field_fixed_point(data1, data2, n) =
    let ok = 1
    let i = 0
    for i < n
        if data1[i] != data2[i]
            ok = 0
        i = i + 1
    ok

