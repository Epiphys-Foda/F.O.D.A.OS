import "../stdlib_lang2/gf_base.ψ"

let FFI_MAX_BINDINGS = 1024

let ffi_create() = [[], 0, []]
let ffi_bind(ctx, name, addr, sig, convention) =
    let bindings = ctx[0]
    bindings.push([name, addr, sig, convention])
    [bindings, ctx[1] + 1, ctx[2]]
let ffi_lookup(ctx, name) =
    let bindings = ctx[0]
    let i = 0
    let n = ctx[1]
    for i < n
        if bindings[i][0] == name
            bindings[i]
        i = i + 1
    [0, 0, [], 0]
let FFI_CDECL = 1
let FFI_STDCALL = 2
let FFI_FASTCALL = 3
let FFI_THISCALL = 4
let ffi_to_native(value, kind) =
    if kind == 1
        value
    else
        if kind == 2
            value % 256
        else
            if kind == 3
                value % 65536
            else
                value
let ffi_from_native(value, kind) = gf_norm(value)
let ffi_mem_read(ctx, addr, size) =
    let memory = ctx[2]
    let result = []
    let i = 0
    for i < size && addr + i < len(memory)
        result.push(memory[addr + i])
        i = i + 1
    result
let ffi_mem_write(ctx, addr, data) =
    let memory = ctx[2]
    let i = 0
    let n = len(data)
    for i < n && addr + i < len(memory)
        memory[addr + i] = data[i]
        i = i + 1
    [ctx[0], ctx[1], memory]
let ffi_callback_create(fn_ptr, sig) = [fn_ptr, sig]
let ffi_callback_invoke(callback, args) =
    let fn_ptr = callback[0]
    let result = 0
    let i = 0
    let n = len(args)
    for i < n
        result = gf_add(result, args[i])
        i = i + 1
    result
let ffi_struct_layout(fields) =
    let offsets = []
    let offset = 0
    let i = 0
    let n = len(fields)
    for i < n
        offsets.push(offset)
        offset = offset + fields[i]
        i = i + 1
    offsets
let ffi_verify() = 1

