let backend_native(z, args) = alu(z, args)

let bit_wasm_dispatch(z, a, b) =
    if z == OP_ADD
        host_call(10, a, b)
    else
        0
    if z == OP_SUB
        host_call(11, a, b)
    else
        0
    if z == OP_MUL
        host_call(12, a, b)
    else
        0
    if z == OP_INV
        host_call(13, a, 0)
    else
        0
    if z == OP_POW
        host_call(14, a, b)
    else
        0
    if z == OP_NEG
        host_call(11, 0, a)
    else
        0
    if z == OP_DIV
        host_call(12, a, host_call(13, b, 0))
    else
        0
    if z == OP_OPLUS
        host_call(10, a, b)
    else
        0
    if z == OP_ODOT
        host_call(12, a, b)
