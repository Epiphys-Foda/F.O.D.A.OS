let bit_alg_add(a, b) = (a + b) % P
let bit_alg_sub(a, b) = (a + P - b % P) % P
let bit_alg_neg(a) = (P - a % P) % P
let bit_alg_mul(a, b) =
    let result = 0
    let aa = a % P
    let bb = b % P
    for bb > 0
        if bb % 2 == 1
            result = (result + aa) % P
        aa = (aa + aa) % P
        bb = bb / 2
    result

let bit_alg_pow(base, exp) =
    let r = 1
    let b = base % P
    let e = exp
    for e > 0
        if e % 2 == 1
            r = bit_alg_mul(r, b)
        b = bit_alg_mul(b, b)
        e = e / 2
    r

let bit_alg_inv(a) =
    (a == 0 ? 0 : bit_alg_pow(a, P - 2))

let bit_alg_div(a, b) = bit_alg_mul(a, bit_alg_inv(b))

let field_eval_impl(field, z0) =
    let total = 0
    let i = 0
    for i < len(field)
        let p = field[i]
        let dz = bit_alg_sub(z0, p[0])
        if dz == 0
            total = (total + p[1]) % P
        if dz != 0
            let inv_dz = bit_alg_inv(dz)
            let inv_dz_n = bit_alg_pow(inv_dz, p[2])
            total = (total + bit_alg_mul(p[1], inv_dz_n)) % P
        i = i + 1
    total

let field_diff_impl(field) =
    let out = []
    let i = 0
    for i < len(field)
        let p = field[i]
        let order = p[2]
        if order < 1
            order = 1
        let new_r = bit_alg_mul(p[1], bit_alg_neg(order))
        out.push([p[0], new_r, order + 1])
        i = i + 1
    out

let field_int_impl(field) =
    let out = []
    let i = 0
    for i < len(field)
        let p = field[i]
        if p[2] > 1
            let new_r = bit_alg_div(p[1], bit_alg_neg(p[2] - 1))
            out.push([p[0], new_r, p[2] - 1])
        i = i + 1
    out

let field_equal_impl(f1, f2) =
    let ok = 1
    if len(f1) != len(f2)
        ok = 0
    let i = 0
    for i < len(f1)
        if i < len(f2)
            if f1[i][0] != f2[i][0]
                ok = 0
            if f1[i][1] != f2[i][1]
                ok = 0
            if f1[i][2] != f2[i][2]
                ok = 0
        i = i + 1
    ok

let recur_k_impl(coeffs, init, n) =
    let k = len(coeffs)
    if n < k
        init[n]
    else
        let state = []
        let i = 0
        for i < k
            state.push(init[i])
            i = i + 1
        let j = k
        for j <= n
            let next = 0
            let c = 0
            for c < k
                next = (next + coeffs[c] * state[k - 1 - c]) % P
                c = c + 1
            let s = 1
            for s < k
                state[s - 1] = state[s]
                s = s + 1
            state[k - 1] = next
            j = j + 1
        state[k - 1]

let gcd_impl(a, b) =
    let x = a
    let y = b
    for y != 0
        let t = x % y
        x = y
        y = t
    x

let is_prime_impl(n) =
    if n < 2
        0
    else
        if n == 2
            1
        else
            if n % 2 == 0
                0
            else
                let r = 1
                let i = 3
                for i * i <= n
                    if n % i == 0
                        r = 0
                    i = i + 2
                r

let alu(z, r) =
    if z == OP_ADD
        bit_alg_add(r[0], r[1])
    else
        0
    if z == OP_SUB
        bit_alg_sub(r[0], r[1])
    else
        0
    if z == OP_MUL
        bit_alg_mul(r[0], r[1])
    else
        0
    if z == OP_INV
        bit_alg_inv(r[0])
    else
        0
    if z == OP_DIV
        bit_alg_div(r[0], r[1])
    else
        0
    if z == OP_POW
        bit_alg_pow(r[0], r[1])
    else
        0
    if z == OP_NEG
        bit_alg_neg(r[0])
    else
        0
    if z == OP_EQ
        (r[0] == r[1] ? 1 : 0)
    else
        0
    if z == OP_LT
        (r[0] < r[1] ? 1 : 0)
    else
        0
    if z == OP_PRIME_MAKE
        [r[0], r[1], r[2]]
    else
        0
    if z == OP_PRIME_Z
        r[0][0]
    else
        0
    if z == OP_PRIME_R
        r[0][1]
    else
        0
    if z == OP_PRIME_N
        r[0][2]
    else
        0
    if z == OP_FIELD_EVAL
        field_eval_impl(r[0], r[1])
    else
        0
    if z == OP_FIELD_DIFF
        field_diff_impl(r[0])
    else
        0
    if z == OP_FIELD_INT
        field_int_impl(r[0])
    else
        0
    if z == OP_FIELD_EQUAL
        field_equal_impl(r[0], r[1])
    else
        0
    if z == OP_RECUR_K
        recur_k_impl(r[0], r[1], r[2])
    else
        0
    if z == OP_GCD
        gcd_impl(r[0], r[1])
    else
        0
    if z == OP_IS_PRIME
        is_prime_impl(r[0])
    else
        0
    if z == OP_FIB
        recur_k_impl([1, 1], [0, 1], r[0])
    else
        0
    if z == OP_TRIBONACCI
        recur_k_impl([1, 1, 1], [0, 0, 1], r[0])
    else
        0
    if z == OP_OPLUS
        bit_alg_add(r[0], r[1])
    else
        0
    if z == OP_ODOT
        bit_alg_mul(r[0], r[1])
    else
        0
    if z == OP_COMPOSE
        bit_alg_mul(r[0], r[1])
    else
        0
    if z == OP_NTT
        r[0]
    else
        0
    if z == OP_BORN
        bit_alg_mul(r[0], r[0])
    else
        0
    if z == OP_HEBBIAN
        bit_alg_add(r[0], r[1])
    else
        0

