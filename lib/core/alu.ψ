    if z == OP_HEBBIAN
        host_call(10, a, b)
    else
        0

let backend_wasm(z, args) =
    bit_wasm_dispatch(z, args[0], args[1])

let alu_exec(z, args, backend) =
    if backend == 0
        backend_native(z, args)
    else
        0
    if backend == 1
        backend_wasm(z, args)
    else
        backend_native(z, args)

let alu_execute_residue(entries) =
    let stack = []
    let i = 0
    let n = len(entries)
    let done = 0
    let retval = 0
    for i < n
        let entry = entries[i]
        let z = entry[0]
        let r = entry[1]
        let arity = entry[2]
        if z == 0
            stack.push(r)
        else
            0
        if z == 2
            stack.push(r)
        else
            0
        if z == 3
            stack.push(r)
        else
            0
        if z == 5
            let b = stack[len(stack) - 1]
            stack.pop()
            let a = stack[len(stack) - 1]
            stack.pop()
            if r == "+"
                stack.push(bit_alg_add(a, b))
            else
                0
            if r == "-"
                stack.push(bit_alg_sub(a, b))
            else
                0
            if r == "*"
                stack.push(bit_alg_mul(a, b))
            else
                0
            if r == "/"
                stack.push(bit_alg_div(a, b))
            else
                stack.push(0)
        else
            0
        if z == 6
            if arity == 0
                stack.push(0)
            else
                0
            if arity == 1
                let a = stack[len(stack) - 1]
                stack.pop()
                stack.push(alu(OP_NEG, [a]))
            else
                stack.push(0)
        else
            0
        if z == 12
            if len(stack) > 0
                stack.pop()
            else
                0
        if z == 24
            if len(stack) > 0
                retval = stack[len(stack) - 1]
            done = 1
            i = n
        if done == 0
            i = i + 1
    if done == 1
        retval
    else
        0
    if len(stack) > 0
        stack[len(stack) - 1]
    else
        0

let alu_bragg_verify(z, args) =
    let native_result = backend_native(z, args)
    let wasm_result = backend_wasm(z, args)
    (native_result == wasm_result ? 1 : 0)

