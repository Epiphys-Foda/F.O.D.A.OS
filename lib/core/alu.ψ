let alu_verify() =
    let ok = 1
    if alu(OP_ADD, [3, 5]) != 8
        ok = 0
    if alu(OP_MUL, [3, 5]) != 15
        ok = 0
    if alu(OP_INV, [3]) * 3 % P != 1
        ok = 0
    if alu(OP_NEG, [5]) != P - 5
        ok = 0
    if alu(OP_POW, [2, 10]) != 1024
        ok = 0
    if alu(OP_GCD, [12, 18]) != 6
        ok = 0
    if alu(OP_IS_PRIME, [7]) != 1
        ok = 0
    if alu(OP_IS_PRIME, [8]) != 0
        ok = 0
    if alu(OP_FIB, [0]) != 0
        ok = 0
    if alu(OP_FIB, [10]) != 55
        ok = 0
    if alu(OP_OPLUS, [3, 4]) != 7
        ok = 0
    if alu(OP_ODOT, [3, 4]) != 12
        ok = 0
    if alu(OP_BORN, [3]) != 9
        ok = 0
    if alu_exec(OP_ADD, [3, 5], 0) != 8
        ok = 0
    if alu_exec(OP_ADD, [3, 5], 1) != 8
        ok = 0
    if alu_bragg_verify(OP_ADD, [3, 5]) != 1
        ok = 0
    if alu_bragg_verify(OP_MUL, [3, 5]) != 1
        ok = 0
    if alu_arity(OP_ADD) != 2
        ok = 0
    if alu_arity(OP_INV) != 1
        ok = 0
    ok

