let frozen3_pow(XX, YY, n, kidx, K) =
    let p = KP_T[kidx]
    let q = KQ_T[kidx]
    let sg = KS_T[kidx]
    let xa = XX[n - 1]
    let ya = YY[n - 1]
    let ok = 1
    let j = 0
    for j < K
        let xq = XX[n + j]
        let yq = YY[n + j]
        let d1 = 0
        let d2 = 0
        if sg == 0
            d1 = powi(yq, q) * powi(xa, p)
            d2 = powi(ya, q) * powi(xq, p)
        if sg == 1
            d1 = powi(yq, q) * powi(xq, p)
            d2 = powi(ya, q) * powi(xa, p)
        let diff = d1 - d2
        let neg = 0
        if diff < 0
            neg = 1
        let ad = diff
        if neg == 1
            ad = 0 - diff
        let pm = permille(ad, d2)
        let hit = 0
        if pm <= 10
            hit = 1
        ok = ok * hit
        j = j + 1
    ok

