let frozen9_hyp(YY, n, K) =
    let r0 = gf_div(YY[1], YY[0])
    let r1 = gf_div(YY[2], YY[1])
    let r2 = gf_div(YY[3], YY[2])
    let b = r0
    let den = gf_mul(2, gf_sub(r2, r1))
    let c = 0
    let a = 0
    let z = 0
    if den == 0
        z = 1
    if z == 0
        c = gf_div(gf_sub(gf_mul(2, r1), gf_add(b, r2)), den)
        a = gf_sub(gf_mul(r1, gf_add(c, 1)), b)
    let W = arr_new_n(n + K)
    let i = 0
    for i < n
        W[i] = YY[i]
        i = i + 1
    let ok = 1
    let k = 0
    for k < K
        let j = n + k - 1
        let rr = gf_div(gf_add(gf_mul(a, j), b), gf_add(gf_mul(c, j), 1))
        let pred = gf_mul(W[j], rr)
        W[j + 1] = pred
        let bad = 0
        if rel_permille(pred, 1, YY[n + k]) > QTOL
            bad = 1
        ok = ok * (1 - bad)
        k = k + 1
    ok

