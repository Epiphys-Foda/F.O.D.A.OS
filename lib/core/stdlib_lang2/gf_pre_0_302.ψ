let mulmod(a, b, m) =
    let r = 0
    let x = a % m
    let y = b
    for y > 0
        if y % 2 == 1
            r = (r + x) % m
        x = (x + x) % m
        y = y / 2
    r
let powmod(base, exp, m) =
    let result = 1
    let b = base % m
    let e = exp
    for e > 0
        if e % 2 == 1
            result = mulmod(result, b, m)
        b = mulmod(b, b, m)
        e = e / 2
    result
let invmod(a, m) =
    powmod(a, m - 2, m)
let field_eval(z, poles, residues, n) =
    let val = 0
    let i = 0
    for i < n
        let diff = (z + 65537 - poles[i]) % 65537
        let term = residues[i] * gf_inv(diff)
        val = (val + term) % 65537
        i = i + 1
    val
let field_energy(r, n) =
    let e = 0
    let i = 0
    for i < n
        e = (e + r[i] * r[i]) % 65537
        i = i + 1
    e
let field_execute(ops_type, ops_data, n) =
    let stack = arr_new_n(n)
    let sp = 0
    let i = 0
    for i < n
        let t = ops_type[i]
        if t == 0
            stack[sp] = ops_data[i]
            sp = sp + 1
        if t == 1
            if sp >= 2
                let b = stack[sp - 1]
                let a = stack[sp - 2]
                sp = sp - 2
                stack[sp] = (a * b) % 65537
                sp = sp + 1
        if t == 2
            if sp >= 2
                let b = stack[sp - 1]
                let a = stack[sp - 2]
                sp = sp - 2
                stack[sp] = (a + b) % 65537
                sp = sp + 1
        if t == 3
            if sp >= 1
                stack[sp - 1] = (stack[sp - 1] * 3) % 65537
        if t == 4
            if sp >= 1
                let a = stack[sp - 1]
                if a > 32768
                    stack[sp - 1] = 0
        if t == 5
            if sp >= 1
                stack[sp - 1] = (65535 * stack[sp - 1] + 2) % 65537
        i = i + 1
    (sp > 0 ? stack[sp - 1] : 0)
let field_eval_fractal(z, poles, residues, depths, n) =
    let total = 0
    let i = 0
    for i < n
        let zk = poles[i]
        let rk = residues[i]
        let nk = depths[i]
        let dz = gf_sub(z, zk)
        if dz == 0
            if nk == 0
                total = gf_add(total, rk)
            else
                total = gf_add(total, rk)
        else
            if nk == 0
                total = gf_add(total, rk)
            else
                0
            if nk == 1
                total = gf_add(total, gf_mul(rk, gf_inv(dz)))
            else
                0
            if nk == N_INFINITY
                total = gf_add(total, rk)
            else
                let inv_dz = gf_inv(dz)
                let inv_dz_n = gf_pow(inv_dz, nk)
                total = gf_add(total, gf_mul(rk, inv_dz_n))
        i = i + 1
    total
let field_nested_3(z, field1, field2, field3) =
