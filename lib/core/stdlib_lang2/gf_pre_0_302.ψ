let wfc_add(a, b) = (a + b) % P
let wfc_sub(a, b) = (a - b + P) % P
let wfc_neg(a) = (P - a) % P
let wfc_pow(base, exp) =
    let result = 1
    let b = base % P
    let e = exp
    for e > 0
        if e % 2 == 1
            result = wfc_mul(result, b)
        b = wfc_mul(b, b)
        e = e / 2
    result
let wfc_inv(a) =
    (a == 0 ? 0 : wfc_pow(a, P - 2))
let not_gate(x) = wfc_sub(1, x)
let and_gate(a, b) = wfc_mul(a, b)
