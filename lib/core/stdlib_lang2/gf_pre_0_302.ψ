        gf_sub(r, gf_mul(a, b))
    else
        0
    if op == 1
        gf_mul(a, b)
    else
        0
    if op == 2
        gf_sub(gf_add(a, b), gf_mul(a, b))
    else
        0
    if op == 3
        gf_sub(gf_add(a, b), gf_mul(2, gf_mul(a, b)))
    else
        0
    if op == 4
        gf_sub(r, a)
    else
        0
