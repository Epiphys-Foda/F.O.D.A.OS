let score_perdrift(YY, n, out2) =
    let best = 1000000000
    let bP = 0
    let P = 2
    for P < 9
        let ok = 0
        if 2 * P <= n
            ok = 1
        let s = 1000000000
        if ok == 1
            let d1 = YY[n] - YY[n - P]
            let d0 = YY[n - P] - YY[n - 2 * P]
            let a0 = abs_i(d0)
            let z = 0
            if a0 == 0
                z = 1
            if z == 0
                s = permille(abs_i(d1 - d0), a0)
        let take = 0
        if s < best
            take = 1
        if take == 1
            best = s
            bP = P
        P = P + 1
    out2[0] = best
    out2[1] = bP
