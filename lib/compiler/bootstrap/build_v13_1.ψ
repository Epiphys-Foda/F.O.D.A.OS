        pc = pc + 1
        if op == MICRO_TOKEN
          let v = micro_seq[pc]
          pc = pc + 1
          stack = stack.push(v)
        else
          0
        if op == MICRO_MUL_GF || op == MICRO_ADD_GF || op == MICRO_SUB_GF || op == MICRO_PROD_CL || op == MICRO_FFT_FWD || op == MICRO_FFT_INV || op == MICRO_DIFF_FWD || op == MICRO_DIFF_BWD || op == MICRO_DIFF_CEN || op == MICRO_FUSE_GEO_PROJ || op == MICRO_FUSE_FREQ_DIFF || op == MICRO_FUSE_TEN_GEO || op == MICRO_ROT_CL || op == MICRO_REF_CL || op == MICRO_DUAL_CL
          let n = len(stack)
          if n >= 2
            let b = stack[n - 1]
            let a = stack[n - 2]
            stack = stack.slice(0, n - 2)
            stack = stack.push(my_micro_eval(op, [a, b]))
          else
              0
        else
          0
        if op == MICRO_INV_GF || op == MICRO_FFT_BITREV
          let n = len(stack)
          if n >= 1
            let a = stack[n - 1]
            stack = stack.slice(0, n - 1)
            stack = stack.push(my_micro_eval(op, [a]))
          else
              0
        else
          0
        if op == MICRO_PROJ_HOM
          let n = len(stack)
          if n >= 2
            let t = stack[n - 1]
            let c = stack[n - 2]
            stack = stack.slice(0, n - 2)
            stack = stack.push(my_micro_eval(op, [c, t]))
          else
              0
        else
          0
        if op == MICRO_EMIT
          let n = len(stack)
          if n >= 1
            result = stack[n - 1]
          else
              0
        else
          0
        if op == MICRO_END
          done = true
        else
            0
      else
        done = true
    result

