let my_qqbc_to_dag(qqbc) =
    let nodes = []
    let edges = []
    let stack = []
    let pc = 0
    let done = false
    let root = -1
    for !done
      let op = qqbc[pc]
      pc = pc + 1
      if op == QQ_TOKEN
        pc = pc + 1
        let node = {node_id: len(nodes), opcode: op, pe_type: op, in_ports: [], out_ports: [], fusion_group: -1, schedule_hint: 0}
        nodes = nodes.push(node)
        stack = stack.push(len(nodes) - 1)
      else
        0
      if op <= 5
        let node = {node_id: len(nodes), opcode: op, pe_type: op, in_ports: [], out_ports: [], fusion_group: -1, schedule_hint: 0}
        nodes = nodes.push(node)
        let new_id = len(nodes) - 1
        let n = len(stack)
        if n >= 2
          let b_id = stack[n - 1]
          let a_id = stack[n - 2]
          let e1 = {src_node: a_id, src_port: 0, dst_node: new_id, dst_port: 0, token_type: 0, fifo_depth: 4}
          let e2 = {src_node: b_id, src_port: 0, dst_node: new_id, dst_port: 1, token_type: 0, fifo_depth: 4}
          edges = edges.push(e1)
          edges = edges.push(e2)
          stack = stack.slice(0, n - 2)
          stack = stack.push(new_id)
        else
            0
      else
        0
      if op == QQ_EMIT
        let node = {node_id: len(nodes), opcode: op, pe_type: op, in_ports: [], out_ports: [], fusion_group: -1, schedule_hint: 0}
        nodes = nodes.push(node)
        let new_id = len(nodes) - 1
        let n = len(stack)
        if n >= 1
          let src_id = stack[n - 1]
          let e1 = {src_node: src_id, src_port: 0, dst_node: new_id, dst_port: 0, token_type: 0, fifo_depth: 4}
          edges = edges.push(e1)
          stack = stack.slice(0, n - 1)
          stack = stack.push(new_id)
          root = new_id
        else
            0
      else
        0
      if op == QQ_END
        done = true
      else
        0
      if pc >= len(qqbc)
        done = true
      else
          0
    {nodes: nodes, edges: edges, node_count: len(nodes), edge_count: len(edges), root: root}

let my_pass_constant_fold(micro_seq) =
    let n = len(micro_seq)
    if n == 7
      let t1 = micro_seq[0]
      let a = micro_seq[1]
      let t2 = micro_seq[2]
      let b = micro_seq[3]
      let op = micro_seq[4]
      let emit = micro_seq[5]
      let end = micro_seq[6]
      let is_pattern = t1 == MICRO_TOKEN && t2 == MICRO_TOKEN && emit == MICRO_EMIT && end == MICRO_END
      let foldable = op == MICRO_MUL_GF || op == MICRO_ADD_GF || op == MICRO_SUB_GF || op == MICRO_PROD_CL || op == MICRO_FFT_FWD || op == MICRO_DIFF_FWD || op == MICRO_PROJ_HOM || op == MICRO_FUSE_GEO_PROJ || op == MICRO_FUSE_FREQ_DIFF || op == MICRO_FUSE_TEN_GEO
      if is_pattern && foldable
        let result = my_micro_eval(op, [a, b])
        [MICRO_TOKEN, result, MICRO_EMIT, MICRO_END]
      else
          0
    else
      0
    micro_seq

let my_pass_all(micro_seq) = my_pass_constant_fold(micro_seq)

