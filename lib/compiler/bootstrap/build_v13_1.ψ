let my_qq_match_utf8(b0, b1, b2) =
    if b0 == 226
      if b1 == 138
        (b2 == 153 ? QQ_GFMUL : 0)
      else
            0
        if b1 == 151
          (b2 == 166 ? QQ_CLIFFORD : 0)
        else
              0
          if b1 == 137
            (b2 == 139 ? QQ_NTT : 0)
          else
                0
            if b1 == 134
              (b2 == 161 ? QQ_BORN : 0)
            else
                  0
              if b1 == 136
                (b2 == 134 ? QQ_HEBBIAN : 0)
              else
                    0
                0
    else
                  0
      0

let my_qq_lexer(src) =
    let src_len = len(src)
    let a_val = 0
    let op_code = 0
    let b_val = 0
    let i = 6
    let a_found = false
    for !a_found
      if i < src_len
        let b = src[i]
        if b >= 48 && b <= 57
          a_val = b - 48
          a_found = true
        else
          0
        i = i + 1
      else
        a_found = true
    let op_found = false
    for !op_found
      if i + 2 < src_len
        let b = src[i]
        if b == 226
          let b1 = src[i + 1]
          let b2 = src[i + 2]
          op_code = my_qq_match_utf8(b, b1, b2)
          op_found = true
          i = i + 3
        else
          i = i + 1
      else
        op_found = true
    let b_found = false
    for !b_found
      if i < src_len
        let b = src[i]
        if b >= 48 && b <= 57
          b_val = b - 48
          b_found = true
        else
          0
        i = i + 1
      else
        b_found = true
    [QQ_TOKEN, a_val, QQ_TOKEN, b_val, op_code, QQ_EMIT, QQ_END]

let my_qq_lower_to_micro(qq_opcode) =
    if qq_opcode == QQ_GFMUL
        MICRO_MUL_GF
    else
      if qq_opcode == QQ_CLIFFORD
          MICRO_PROD_CL
      else
        if qq_opcode == QQ_NTT
            MICRO_FFT_FWD
        else
          if qq_opcode == QQ_BORN
              MICRO_PROJ_HOM
          else
            if qq_opcode == QQ_HEBBIAN
                MICRO_DIFF_FWD
            else
              if qq_opcode == QQ_TOKEN
                  MICRO_TOKEN
              else
                if qq_opcode == QQ_EMIT
                    MICRO_EMIT
                else
                  if qq_opcode == QQ_END
                      MICRO_END
                  else
                      0

let my_micro_to_pe(micro_opcode) =
    if micro_opcode == MICRO_MUL_GF
        PE_MAC
    else
      if micro_opcode == MICRO_ADD_GF
          PE_MAC
      else
        if micro_opcode == MICRO_SUB_GF
            PE_ALU
        else
          if micro_opcode == MICRO_INV_GF
              PE_LUT
          else
            if micro_opcode == MICRO_ROT_CL
                PE_LUT
            else
              if micro_opcode == MICRO_REF_CL
                  PE_ALU
              else
                if micro_opcode == MICRO_PROD_CL
                    PE_MAC
                else
                  if micro_opcode == MICRO_DUAL_CL
                      PE_ALU
                  else
                    if micro_opcode == MICRO_FFT_FWD
                        PE_FFT
                    else
                      if micro_opcode == MICRO_FFT_INV
                          PE_FFT
                      else
                        if micro_opcode == MICRO_FFT_BITREV
                            PE_ALU
                        else
                          if micro_opcode == MICRO_PROJ_HOM
                              PE_ALU
                          else
                            if micro_opcode == MICRO_PROJ_AFF
                                PE_ALU
                            else
                              if micro_opcode == MICRO_INTERP
                                  PE_MAC
                              else
                                if micro_opcode == MICRO_DIFF_FWD
                                    PE_ALU
                                else
                                  if micro_opcode == MICRO_DIFF_BWD
                                      PE_ALU
                                  else
                                    if micro_opcode == MICRO_DIFF_CEN
                                        PE_ALU
                                    else
                                      if micro_opcode == MICRO_FUSE_GEO_PROJ
                                          PE_LUT
                                      else
                                        if micro_opcode == MICRO_FUSE_FREQ_DIFF
                                            PE_FFT
                                        else
                                          if micro_opcode == MICRO_FUSE_TEN_GEO
                                              PE_MAC
                                          else
                                            if micro_opcode == MICRO_TOKEN
                                                PE_TOKEN
                                            else
                                              if micro_opcode == MICRO_EMIT
                                                  PE_EMIT
                                              else
                                                  0

let my_qqbc_to_micro_seq(qqbc) =
    let out = []
    let i = 0
    let done = false
    for !done
      if i < len(qqbc)
        let op = qqbc[i]
        let micro_op = my_qq_lower_to_micro(op)
        if micro_op == MICRO_TOKEN
          if i + 1 < len(qqbc)
            let imm = qqbc[i + 1]
            out = out.push(micro_op)
            out = out.push(imm)
            i = i + 2
          else
            i = i + 1
        else
          out = out.push(micro_op)
          i = i + 1
      else
        done = true
    out

let my_micro_seq_to_pe_opcodes(micro_seq) =
