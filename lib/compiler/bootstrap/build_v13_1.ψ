          if i + 1 < len(micro_seq)
            let imm = micro_seq[i + 1]
            out = out.push([pe_type, op])
            out = out.push([imm])
            i = i + 2
          else
            i = i + 1
        else
          out = out.push([pe_type, op])
          i = i + 1
      else
        done = true
    out

let my_micro_gf_mod(v) =
    let abs_v = (v < 0 ? 0 - v : v)
    abs_v - (abs_v / MICRO_GF_MOD) * MICRO_GF_MOD

let my_micro_eval(opcode, args) =
    if opcode == MICRO_MUL_GF
      let a = args[0]
      let b = args[1]
      my_micro_gf_mod(a * b)
    else
      if opcode == MICRO_ADD_GF
        let a = args[0]
        let b = args[1]
        my_micro_gf_mod(a + b)
      else
        if opcode == MICRO_SUB_GF
          let a = args[0]
          let b = args[1]
          my_micro_gf_mod(a - b)
        else
          if opcode == MICRO_INV_GF
            let a = args[0]
            if a == 1
                1
            else
                (a == 0 ? 0 : 1)
          else
                0
            if opcode == MICRO_PROD_CL
              let a = args[0]
              let b = args[1]
              bit_and(bit_xor(a, b), bit_or(a, b))
            else
              if opcode == MICRO_FFT_FWD
                let a = args[0]
                let b = args[1]
                bit_or(a + b, a - b)
              else
                if opcode == MICRO_FFT_INV
                  let a = args[0]
                  let b = args[1]
                  let fwd = bit_or(a + b, a - b)
                  fwd / 2
                else
                  if opcode == MICRO_PROJ_HOM
                    let c = args[0]
                    let t = args[1]
                    (c != 0 ? t : 0)
                  else
                        0
                    if opcode == MICRO_DIFF_FWD
                      let a = args[0]
                      let b = args[1]
                      a + b
                    else
                      if opcode == MICRO_DIFF_BWD
                        let a = args[0]
                        let b = args[1]
                        a - b
                      else
                        if opcode == MICRO_DIFF_CEN
                          let a = args[0]
                          let b = args[1]
                          (a + b) / 2
                        else
                          if opcode == MICRO_FUSE_GEO_PROJ
                            let a = args[0]
                            let b = args[1]
                            bit_and(bit_xor(a, b), bit_or(a, b))
                          else
                            if opcode == MICRO_FUSE_FREQ_DIFF
                              let a = args[0]
                              let b = args[1]
                              let fwd = bit_or(a + b, a - b)
                              fwd + 0
                            else
                              if opcode == MICRO_FUSE_TEN_GEO
                                let a = args[0]
                                let b = args[1]
                                my_micro_gf_mod(a * b)
                              else
                                0

let my_qq_interp(qqbc) =
    let stack = []
    let pc = 0
    let result = 0
    let done = false
    for !done
      let op = qqbc[pc]
      pc = pc + 1
      if op == QQ_TOKEN
        let v = qqbc[pc]
        pc = pc + 1
        stack = stack.push(v)
      else
        0
      if op <= 5
        let n = len(stack)
        if n >= 2
          let b = stack[n - 1]
          let a = stack[n - 2]
          stack = stack.slice(0, n - 2)
          let args = [a, b]
          let res = if op == QQ_GFMUL
            let prod = a * b
            let abs_prod = (prod < 0 ? 0 - prod : prod)
            abs_prod - (abs_prod / QQ_GFMUL_MOD) * QQ_GFMUL_MOD
        else
            if op == QQ_CLIFFORD
                bit_and(bit_xor(a, b), bit_or(a, b))
            else
              if op == QQ_NTT
                  bit_or(a + b, a - b)
              else
                if op == QQ_BORN
                    (a != 0 ? b : 0)
                else
                  if op == QQ_HEBBIAN
                      a + b
                  else
                      0
          stack = stack.push(res)
      else
        0
      if op == QQ_EMIT
        let n = len(stack)
        if n >= 1
          result = stack[n - 1]
        else
            0
      else
        0
      if op == QQ_END
        done = true
      else
        0
      if pc >= len(qqbc)
        done = true
      else
          0
    result

