let my_qbc_to_x86(qbc) =
    let x86 = [83, 87, 86, 76, 137, 195, 73, 137, 201, 73, 137, 210].flat()
    let pc = 0
    let done = 0
    for done == 0
      let op = qbc[pc]
      pc = pc + 1
      if op == 65
        let v = qbc[pc]
        pc = pc + 1
        let u = (v < 0 ? v + 4294967296 : v)
        let b0 = u - (u / 256) * 256
        let v1 = u / 256
        let b1 = v1 - (v1 / 256) * 256
        let v2 = v1 / 256
        let b2 = v2 - (v2 / 256) * 256
        let b3 = v2 / 256
        x86 = [x86, [104, b0, b1, b2, b3]].flat()
      else
        0
      if op == 106
        x86 = [x86, [88, 89, 72, 1, 200, 80]].flat()
      else
        0
      if op == 107
        x86 = [x86, [88, 89, 72, 41, 193, 81]].flat()
      else
        0
      if op == 108
        x86 = [x86, [88, 89, 72, 15, 175, 193, 80]].flat()
      else
        0
      if op == 109
        x86 = [x86, [89, 88, 72, 153, 72, 247, 249, 80]].flat()
      else
        0
      if op == 11
      else
        0
      if pc >= len(qbc)
        done = 1
      else
        0
      0
    let seg = [88, 94, 95, 91, 195].flat()
    [x86, seg].flat()

let mini_lexer(src_bytes) =
    let a_byte = src_bytes[6] - 48
    let op_byte = src_bytes[8]
    let b_byte = src_bytes[10] - 48
    let op_code = if op_byte == 43
      106
    else
      if op_byte == 45
        107
      else
        if op_byte == 42
          108
        else
          109
    let out = [65, a_byte, 65, b_byte, op_code, 11]
    out

let src_add = [112, 114, 105, 110, 116, 40, 49, 32, 43, 32, 50, 41]
let qbc_add = mini_lexer(src_add)
let x86_add = my_qbc_to_x86(qbc_add)
let n_add = arc_save(x86_add, 0, "qbc_add.arc")

let src_sub = [112, 114, 105, 110, 116, 40, 53, 32, 45, 32, 51, 41]
