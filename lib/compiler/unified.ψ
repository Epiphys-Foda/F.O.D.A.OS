let gcd(a, b) =
    let x = a
    let y = b
    for y != 0
        let t = x % y
        x = y
        y = t
    x

let lcm(a, b) = a / gcd(a, b) * b

let ext_gcd(a, b) =
    let old_r = a
    let r = b
    let old_s = 1
    let s = 0
    let old_t = 0
    let t = 1
    for r != 0
        let q = old_r / r
        let tmp = old_r - q * r
        old_r = r
        r = tmp
        let tmp_s = old_s - q * s
        old_s = s
        s = tmp_s
        let tmp_t = old_t - q * t
        old_t = t
        t = tmp_t
    let result = []
    result.push(old_r)
    result.push(old_s)
    result.push(old_t)
    result

let mod_inv(a, m) =
    let gxy = ext_gcd(a, m)
    let x = gxy[1]
    (x % m + m) % m

let crt(rems, mods) =
    let n = len(rems)
    let M = 1
    let i = 0
    for i < n
        M = M * mods[i]
        i = i + 1
    let x = 0
    let j = 0
    for j < n
        let Mj = M / mods[j]
        let yj = mod_inv(Mj, mods[j])
        x = (x + rems[j] * Mj * yj) % M
        j = j + 1
    x

let euler_totient(n) =
    let result = n
    let p = 2
    let m = n
    for p * p <= m
        if m % p == 0
            for m % p == 0
                m = m / p
            result = result - result / p
        p = p + 1
    if m > 1
        result = result - result / m
    result

let mobius(n) =
    if n == 1
        1
    else
        let p = 2
        let m = n
        let count = 0
        let square_free = 1
        for p * p <= m
            if m % p == 0
                count = count + 1
                m = m / p
                if m % p == 0
                    square_free = 0
            p = p + 1
        if m > 1
            count = count + 1
        if square_free == 0
            0
        else
            (count % 2 == 0 ? 1 : gf_neg(1))

let divisor_sum(n) =
    let sum = 0
    let i = 1
    for i <= n
        if n % i == 0
            sum = sum + i
        i = i + 1
    sum

let divisor_count(n) =
    let count = 0
    let i = 1
    for i <= n
        if n % i == 0
            count = count + 1
        i = i + 1
    count

let legendre(a, p) =
    let r = gf_pow(a % p, (p - 1) / 2)
    if r == 1
        1
    else
        (r == p - 1 ? gf_neg(1) : 0)

let is_prime(n) =
    if n < 2
        0
    else
        if n == 2
            1
        else
            if n % 2 == 0
                0
            else
                let r = 1
                let i = 3
                for i * i <= n
                    if n % i == 0
                        r = 0
                    i = i + 2
                r

let prime_sieve(n) =
    let primes = []
    let i = 2
    for len(primes) < n
        if is_prime(i) == 1
            primes.push(i)
        i = i + 1
    primes

let stirling2(n, k) =
    if k == 0
        (n == 0 ? 1 : 0)
    else
            0
        if k > n
            0
        else
            if k == 1
                1
            else
                if k == n
                    1
                else
                    (k * stirling2(n - 1, k) + stirling2(n - 1, k - 1)) % P

let bell(n) =
    let sum = 0
    let k = 0
    for k <= n
        sum = (sum + stirling2(n, k)) % P
        k = k + 1
    sum

let binom(n, k) =
    if k > n
        0
    else
        if k == 0
            1
        else
            if k == n
                1
            else
                (binom(n - 1, k - 1) + binom(n - 1, k)) % P

let burnside(fix_sizes, group_order) =
    let sum = 0
    let i = 0
    for i < len(fix_sizes)
        sum = sum + fix_sizes[i]
        i = i + 1
    sum / group_order

let resultant(f_coeffs, g_coeffs) =
    let f_deg = len(f_coeffs) - 1
    let g_deg = len(g_coeffs) - 1
    let result = 1
    let i = 0
    for i < g_deg
        let fc = f_coeffs[0]
        result = result * fc
        i = i + 1
    result

let fib(n) =
    if n == 0
        0
    else
        if n == 1
            1
        else
            (fib(n - 1) + fib(n - 2)) % P

let lucas(n) =
    if n == 0
        2
    else
        if n == 1
            1
        else
            (lucas(n - 1) + lucas(n - 2)) % P

let mat2_mul(a, b) =
    let r = []
    r.push((a[0] * b[0] + a[1] * b[2]) % P)
    r.push((a[0] * b[1] + a[1] * b[3]) % P)
    r.push((a[2] * b[0] + a[3] * b[2]) % P)
    r.push((a[2] * b[1] + a[3] * b[3]) % P)
    r

let mat2_pow(m, n) =
    let result = [1, 0, 0, 1]
    let base = m
    let e = n
    for e > 0
        if e % 2 == 1
            result = mat2_mul(result, base)
        base = mat2_mul(base, base)
        e = e / 2
    result

let fib_fast(n) =
    if n == 0
        0
    else
        let m = mat2_pow([1, 1, 1, 0], n)
        m[1]

let universal_recur_k(coeffs, init, n) =
    let k = len(coeffs)
    if n < k
        init[n]
    else
        let state = []
        let i = 0
        for i < k
            state.push(init[i])
            i = i + 1
        let j = k
        for j <= n
            let next = 0
            let c = 0
            for c < k
                next = (next + coeffs[c] * state[k - 1 - c]) % P
                c = c + 1
            let s = 1
            for s < k
                state[s - 1] = state[s]
                s = s + 1
            state[k - 1] = next
            j = j + 1
        state[k - 1]

let fib_universal(n) = universal_recur_k([1, 1], [0, 1], n)

let tribonacci(n) = universal_recur_k([1, 1, 1], [0, 0, 1], n)

let damped_oscillator(c1, c2, x0, x1, n) =
