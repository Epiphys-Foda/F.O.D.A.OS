let P = 65537

let prime_make(z, r, n) =
    let p = []
    p.push(z)
    p.push(r)
    p.push(n)
    p

let prime_z(p) = p[0]
let prime_r(p) = p[1]
let prime_n(p) = p[2]

let nprime_make(z, r, n, inner) =
    let p = []
    p.push(z)
    p.push(r)
    p.push(n)
    p.push(inner)
    p

let nprime_inner(p) = p[3]

let field_make_1(z, r, n) =
    let f = []
    f.push(prime_make(z, r, n))
    f

let field_make_2(z1, r1, n1, z2, r2, n2) =
    let f = []
    f.push(prime_make(z1, r1, n1))
    f.push(prime_make(z2, r2, n2))
    f

let field_make_3(z1, r1, n1, z2, r2, n2, z3, r3, n3) =
    let f = []
    f.push(prime_make(z1, r1, n1))
    f.push(prime_make(z2, r2, n2))
    f.push(prime_make(z3, r3, n3))
    f

let field_eval(field, z0) =
    let total = 0
    let i = 0
    for i < len(field)
        let p = field[i]
        let z = p[0]
        let r = p[1]
        let order = p[2]
        if order < 1
            order = 1
        let dz = gf_sub(z0, z)
        if dz == 0
            total = (total + r) % P
        if dz != 0
            let inv_dz = gf_inv(dz)
            let inv_dz_n = gf_pow(inv_dz, order)
            let term = r * inv_dz_n % P
            total = (total + term) % P
        i = i + 1
    total

let field_add(f1, f2) =
    let out = []
    let i = 0
    for i < len(f1)
        out.push(f1[i])
        i = i + 1
    let j = 0
    for j < len(f2)
        let p2 = f2[j]
        let z2 = p2[0]
        let r2 = p2[1]
        let n2 = p2[2]
        let found = 0
        let k = 0
        for k < len(out)
            let pk = out[k]
            if pk[0] == z2
                if pk[2] == n2
                    let merged = prime_make(z2, (pk[1] + r2) % P, n2)
                    out[k] = merged
                    found = 1
            k = k + 1
        if found == 0
            out.push(p2)
        j = j + 1
    out

let field_mul(f1, f2) =
    let out = []
    let i = 0
    for i < len(f1)
        let p1 = f1[i]
        let j = 0
        for j < len(f2)
            let p2 = f2[j]
            let z = gf_add(p1[0], p2[0])
            let r = gf_mul(p1[1], p2[1])
            let n = p1[2] + p2[2] - 1
            out.push(prime_make(z, r, n))
            j = j + 1
        i = i + 1
    out

let field_compose(outer, inner_z0) =
    let out = []
    let i = 0
    for i < len(outer)
        let p = outer[i]
        let z = p[0]
        let r = p[1]
        let n = p[2]
        let new_z = field_eval(inner_z0, z)
        out.push(prime_make(new_z, r, n))
        i = i + 1
    out

let field_equal(f1, f2) =
    let ok = 1
    if len(f1) != len(f2)
        ok = 0
    let i = 0
    for i < len(f1)
        if i < len(f2)
            let p1 = f1[i]
            let p2 = f2[i]
            if p1[0] != p2[0]
                ok = 0
            if p1[1] != p2[1]
                ok = 0
            if p1[2] != p2[2]
                ok = 0
        i = i + 1
    ok

let field_differentiate(field) =
    let out = []
    let i = 0
    for i < len(field)
        let p = field[i]
        let z = p[0]
        let r = p[1]
        let order = p[2]
        if order < 1
            order = 1
        let new_order = order + 1
        let new_r = r * gf_neg(order) % P
        out.push(prime_make(z, new_r, new_order))
        i = i + 1
    out

let field_integrate(field) =
    let out = []
    let i = 0
    for i < len(field)
        let p = field[i]
        let z = p[0]
        let r = p[1]
        let order = p[2]
        if order > 1
            let new_order = order - 1
            let denom = gf_neg(order - 1)
            let new_r = gf_div(r, denom)
            out.push(prime_make(z, new_r, new_order))
        i = i + 1
    out

let field_diff_n(field, times) =
    let result = field
    let i = 0
    for i < times
        result = field_differentiate(result)
        i = i + 1
    result

let field_int_n(field, times) =
    let result = field
    let i = 0
    for i < times
        result = field_integrate(result)
        i = i + 1
    result

let field_nest(field) =
    let out = []
    let i = 0
    for i < len(field)
        let p = field[i]
        let z = p[0]
        let r = p[1]
        let order = p[2]
        if order < 1
            order = 1
        let inner = field
        if order > 1
            inner = field_diff_n(field, order - 1)
        out.push(nprime_make(z, r, order, inner))
        i = i + 1
    out

let field_unnest(nested_field) =
    let out = []
    let i = 0
    for i < len(nested_field)
        let p = nested_field[i]
        let z = p[0]
        let r = p[1]
        let order = p[2]
        out.push(prime_make(z, r, order))
        i = i + 1
    out

let field_spectral(field, k) = field_diff_n(field, k)

let field_spectral_dim(field, k) =
    let e_k = field_spectral(field, k)
    len(e_k)

let hausdorff_verify(n_copies, ratio_inv, dim) =
    let rhs = gf_pow(ratio_inv, dim)
    (n_copies == rhs ? 1 : 0)

let nest_depth(nested_field) =
    let max_d = 0
    let i = 0
    for i < len(nested_field)
        let p = nested_field[i]
        if len(p) > 3
            let inner = p[3]
            let d = 1 + nest_depth(inner)
            if d > max_d
                max_d = d
        if len(p) <= 3
            if 1 > max_d
                max_d = 1
        i = i + 1
    max_d

let fractal_dim(n_copies, ratio_inv) =
    let dim = 0
    let i = 1
    for i < 20
        if gf_pow(ratio_inv, i) == n_copies
            dim = i
        i = i + 1
    dim

let TOK_NUM = 1
let TOK_IDENT = 2
let TOK_OP = 3
let TOK_KW = 4
let TOK_LP = 5
let TOK_RP = 6
let TOK_EQ = 7
let TOK_END = 0

let AST_NUM = 1
let AST_VAR = 2
let AST_LET = 3
let AST_IF = 4
let AST_WHILE = 5
let AST_CALL = 6
let AST_BINOP = 7
let AST_RETURN = 8

let OP_I32_CONST = 65
let OP_I32_ADD = 106
let OP_I32_SUB = 107
let OP_I32_MUL = 108
let OP_LOCAL_GET = 32
let OP_END = 11
let OP_RETURN = 15

let is_digit(c) =
    let r = 0
    if c >= 48
        (c <= 57 ? (r = 1) : 0)
    r

let is_alpha(c) =
    let r = 0
    if c >= 65
        (c <= 90 ? (r = 1) : 0)
    if c >= 97
        (c <= 122 ? (r = 1) : 0)
    if c == 95
        r = 1
    r

let is_space(c) =
    let r = 0
    if c == 32
        r = 1
    if c == 10
        r = 1
    if c == 13
        r = 1
    if c == 9
        r = 1
    r

let lex(src) =
    let tokens = []
    let i = 0
    let n = len(src)
    for i < n
        let c = src[i]
        if is_space(c) == 1
            i = i + 1
        if is_space(c) == 0
            if is_digit(c) == 1
                let num = 0
                for i < n
                    if is_digit(src[i]) == 1
                        num = num * 10 + (src[i] - 48)
                        i = i + 1
                    if is_digit(src[i]) == 0
                        i = n
                tokens.push(prime_make(TOK_NUM, num, i))
            if is_digit(c) == 0
                if is_alpha(c) == 1
                    let name = 0
                    let hash = 0
                    for i < n
                        if is_alpha(src[i]) == 1
                            hash = (hash * 31 + src[i]) % P
                            i = i + 1
                        if is_alpha(src[i]) == 0
                            i = n
                    tokens.push(prime_make(TOK_IDENT, hash, i))
                if is_alpha(c) == 0
                    if c == 40
                        tokens.push(prime_make(TOK_LP, 0, i))
                    if c == 41
                        tokens.push(prime_make(TOK_RP, 0, i))
                    if c == 61
                        tokens.push(prime_make(TOK_EQ, 0, i))
                    if c == 43
                        tokens.push(prime_make(TOK_OP, 43, i))
                    if c == 45
                        tokens.push(prime_make(TOK_OP, 45, i))
                    if c == 42
                        tokens.push(prime_make(TOK_OP, 42, i))
                    i = i + 1
    tokens.push(prime_make(TOK_END, 0, i))
    tokens

let parse_tokens(tokens) =
    let ast = []
    let pos = 0
    let n = len(tokens)
    for pos < n
        let t = tokens[pos]
        let tt = t[0]
        let tv = t[1]
        if tt == TOK_END
            pos = n
        if tt == TOK_NUM
            ast.push(prime_make(AST_NUM, tv, 0))
            pos = pos + 1
        if tt == TOK_IDENT
            ast.push(prime_make(AST_VAR, tv, 0))
            pos = pos + 1
        if tt == TOK_OP
            ast.push(prime_make(AST_BINOP, tv, 0))
            pos = pos + 1
        if tt == TOK_LP
            pos = pos + 1
        if tt == TOK_RP
            pos = pos + 1
        if tt == TOK_EQ
            pos = pos + 1
    ast

let codegen(ast) =
    let wasm = []
    let i = 0
    for i < len(ast)
        let node = ast[i]
        let nt = node[0]
        let nv = node[1]
        if nt == AST_NUM
            wasm.push(prime_make(OP_I32_CONST, nv, 0))
        if nt == AST_VAR
            wasm.push(prime_make(OP_LOCAL_GET, nv, 0))
        if nt == AST_BINOP
            if nv == 43
                wasm.push(prime_make(OP_I32_ADD, 0, 0))
            if nv == 45
                wasm.push(prime_make(OP_I32_SUB, 0, 0))
            if nv == 42
                wasm.push(prime_make(OP_I32_MUL, 0, 0))
        i = i + 1
    wasm.push(prime_make(OP_END, 0, 0))
    wasm

let compile_src(src) =
    let tokens = lex(src)
    let ast = parse_tokens(tokens)
    codegen(ast)

let wasm_to_bytes(wasm) =
    let bytes = []
    let i = 0
    for i < len(wasm)
        let w = wasm[i]
        bytes.push(w[0])
        if w[0] == OP_I32_CONST
            bytes.push(w[1])
        if w[0] == OP_LOCAL_GET
            bytes.push(w[1])
        i = i + 1
    bytes

let compile_to_bytes(src) =
    let wasm = compile_src(src)
    wasm_to_bytes(wasm)

let self_compile() =
