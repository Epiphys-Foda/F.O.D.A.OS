let galois_verify(f_vals, g_vals, n) =
    let ok = 1
    let a = 0
    for a < n
        let b = 0
        for b < n
            if f_vals[a] <= b
                if a > g_vals[b]
                    ok = 0
            if f_vals[a] > b
                if a <= g_vals[b]
                    ok = 0
            b = b + 1
        a = a + 1
    ok

let op_T(coeffs, state, n) = universal_recur_k(coeffs, state, n)

