let filtered_complex_verify() =
    let result = 0
    if gf_sub(7, 4) == 3
        result = result + 1
    if gf_sub(6, 2) == 4
        result = result + 1
    if gf_add(4, gf_sub(9, 4)) == 9
        result = result + 1
    result

let persistent_homology_verify() =
    let result = 0
    if gf_mul(0, 5) == 0
        result = result + 1
    if gf_add(gf_add(2, 3), 4) == gf_add(2, gf_add(3, 4))
        result = result + 1
    if gf_sub(10, 4) == 6
        result = result + 1
    result

