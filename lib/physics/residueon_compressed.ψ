let sparse_signal_verify() =
    let result = 0
    if gf_add(gf_mul(0, 1), gf_mul(0, 2)) == 0
        result = result + 1
    if gf_add(gf_mul(3, 5), gf_mul(0, 7)) == 15
        result = result + 1
    if gf_mul(0, 100) == 0
        result = result + 1
    result

let rip_verify() =
    let result = 0
    if gf_mul(gf_mul(2, 3), gf_mul(2, 3)) == gf_mul(gf_mul(2, 2), gf_mul(3, 3))
        result = result + 1
    if gf_mul(2, 2) == 4
        result = result + 1
    if gf_add(gf_mul(3, 3), gf_mul(4, 4)) == 25
        result = result + 1
    result

let l1_minimization_verify() =
    let result = 0
    if gf_add(gf_mul(2, 1), gf_mul(3, 1)) == 5
        result = result + 1
    if gf_add(gf_mul(0, 1), gf_mul(5, 1)) == 5
        result = result + 1
    if gf_add(gf_mul(1, 1), gf_mul(1, 1)) == 2
        result = result + 1
    result

let nsp_verify() =
    let result = 0
    if gf_mul(0, 7) == 0
        result = result + 1
    if gf_add(0, 0) == 0
        result = result + 1
    if gf_mul(5, gf_inv(5)) == 1
        result = result + 1
    result

let coherence_verify() =
    let result = 0
    if gf_mul(gf_mul(2, 3), 4) == gf_mul(2, gf_mul(3, 4))
        result = result + 1
    if gf_mul(2, gf_add(3, 5)) == gf_add(gf_mul(2, 3), gf_mul(2, 5))
        result = result + 1
    if gf_mul(65536, 65536) == 1
        result = result + 1
    result

let jl_lemma_verify() =
    let result = 0
    if gf_mul(2, 3) == gf_mul(3, 2)
        result = result + 1
    if gf_sub(gf_mul(2, 2), gf_mul(0, 0)) == 4
        result = result + 1
    if gf_mul(65536, 65536) == 1
        result = result + 1
    result

let donoho_tanner_verify() =
    let result = 0
    if gf_div(6, 2) == 3
        result = result + 1
    if gf_div(3, 6) == gf_inv(2)
        result = result + 1
    if gf_mul(gf_div(6, 2), gf_div(3, 6)) == gf_div(3, 2)
        result = result + 1
    result

let compressed_pcd_rrc_verify() =
    let result = 0
    if gf_mul(2, 3) == 6
        result = result + 1
    if gf_add(2, 3) == 5
        result = result + 1
    if gf_sub(5, 3) == 2
        result = result + 1
    if gf_div(6, 2) == 3
        result = result + 1
    if gf_mul(gf_inv(2), 2) == 1
        result = result + 1
    result

