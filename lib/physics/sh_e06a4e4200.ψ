let homology_compute(f) =
    let n = mf_size(f)
    let h0 = n
    let sum_r = 0
    let i = 0
    for i < n
        sum_r = gf_add(sum_r, mf_residues(f)[i])
        i = i + 1
    let h1 = sum_r
    let h2 = 0
    let j = 0
    for j < n
        let k = gf_add(j, 1)
        if k < n
            h2 = gf_add(h2, gf_sub(mf_poles(f)[k], mf_poles(f)[j]))
        j = j + 1
    [h0, h1, h2]

