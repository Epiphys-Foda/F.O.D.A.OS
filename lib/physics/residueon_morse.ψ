let morse_function_verify() =
    let result = 0
    if gf_add(gf_mul(0, 0), gf_mul(0, 0)) == 0
        result = result + 1
    if gf_sub(gf_mul(2, 2), gf_mul(0, 0)) != 0
        result = result + 1
    if gf_sub(gf_mul(2, 2), gf_mul(1, 1)) == 3
        result = result + 1
    result

let critical_points_verify() =
    let result = 0
    let c0 = 1
    let c1 = 0
    let c2 = 1
    if c0 == 1
        result = result + 1
    if c1 == 0
        result = result + 1
    if c2 == 1
        result = result + 1
    if gf_div(gf_sub(2, 2), 2) == 0
        result = result + 1
    result

let morse_inequality_verify() =
    let result = 0
    if 1 >= 1
        result = result + 1
    if 0 >= 0
        result = result + 1
    if 1 >= 1
        result = result + 1
    result

let euler_characteristic_verify() =
    let result = 0
    if gf_add(gf_sub(1, 0), 1) == 2
        result = result + 1
    if gf_add(gf_sub(1, 2), 1) == 0
        result = result + 1
    if gf_add(gf_sub(1, 0), 1) == 2
        result = result + 1
    result

let morse_complex_verify() =
    let result = 0
    if gf_add(gf_add(1, 0), 1) == 2
        result = result + 1
    if gf_sub(1, 0) == 1
        result = result + 1
    if gf_sub(1, 0) == 1
        result = result + 1
    result

let morse_homology_verify() =
    let result = 0
    if gf_sub(gf_sub(1, 0), 0) == 1
        result = result + 1
    if gf_add(1, 1) == 2
        result = result + 1
    if gf_mul(1, 1) == 1
        result = result + 1
    result

let gradient_flow_verify() =
    let result = 0
    if gf_sub(2, 0) == 2
        result = result + 1
    if gf_add(2, 0) == 2
        result = result + 1
    if gf_add(gf_sub(0, 1), 1) == 0
