let cauchy_schwarz_verify() =
    let result = 0
    let xy_sq = gf_mul(32, 32)
    let xx_yy = gf_mul(14, 77)
    if xy_sq <= xx_yy
        result = result + 1
    if xy_sq < xx_yy
        result = result + 1
    if gf_mul(10, 10) == gf_mul(20, 5)
        result = result + 1
    result

let orthogonality_verify() =
    let result = 0
    let inner = gf_add(gf_mul(1, 0), gf_mul(0, 1))
