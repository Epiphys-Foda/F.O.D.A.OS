let inner_product_verify() =
    let result = 0
    let xy = gf_add(gf_add(gf_mul(1, 4), gf_mul(2, 5)), gf_mul(3, 6))
    if xy == 32
        result = result + 1
    let xx = gf_add(gf_add(gf_mul(1, 1), gf_mul(2, 2)), gf_mul(3, 3))
    if xx == 14
        result = result + 1
    let yx = gf_add(gf_add(gf_mul(4, 1), gf_mul(5, 2)), gf_mul(6, 3))
    if xy == yx
        result = result + 1
    let axy = gf_add(gf_add(gf_mul(gf_mul(2, 1), 4), gf_mul(gf_mul(2, 2), 5)), gf_mul(gf_mul(2, 3), 6))
    if axy == 64
        result = result + 1
    result

let norm_verify() =
