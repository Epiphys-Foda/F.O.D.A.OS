    let pyth = gf_add(gf_add(gf_mul(3, 3), 0), gf_add(0, gf_mul(65533, 65533)))
    if pyth == 25
        result = result + 1
    if gf_add(gf_mul(0, 1), gf_mul(1, 0)) == 0
        result = result + 1
    result

