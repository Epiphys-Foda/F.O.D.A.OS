let k0_verify() =
    let result = 0
    if gf_add(1, 1) == 2
        result = result + 1
    if gf_mul(1, 1) == 1
        result = result + 1
    if gf_add(2, 3) == 5
        result = result + 1
    if gf_mul(2, 3) == 6
        result = result + 1
    result

let k1_verify() =
    let result = 0
    if gf_mul(1, 65536) == 65536
        result = result + 1
    if gf_mul(256, 256) == 65536
        result = result + 1
    if gf_inv(1) == 1
        result = result + 1
    result

let k2_verify() =
    let result = 0
    if gf_add(0, 0) == 0
        result = result + 1
    if gf_add(2, gf_sub(1, 2)) == 1
        result = result + 1
    if gf_mul(3, 5) == 15
        result = result + 1
    result

let bott_periodicity_verify() =
    let result = 0
    if gf_add(1, 0) == 1
        result = result + 1
    if gf_add(1, 1) == 2
        result = result + 1
    if gf_neg(gf_neg(3)) == 3
        result = result + 1
    result

let milnor_k_verify() =
    let result = 0
    if gf_mul(5, 1) == 5
        result = result + 1
    if gf_mul(7, 1) == 7
        result = result + 1
    if gf_add(3, gf_sub(1, 3)) == 1
        result = result + 1
    result

let adams_operation_verify() =
    let result = 0
    if gf_mul(2, 1) == 2
        result = result + 1
    if gf_mul(2, 3) == 6
        result = result + 1
    if gf_add(gf_mul(1, 2), gf_mul(1, 3)) == 5
        result = result + 1
    result

let k_sequence_verify() =
    let result = 0
    if 2 % 2 == 0
        result = result + 1
    if gf_neg(1) == 65536
        result = result + 1
    if gf_mul(0, 5) == 0
        result = result + 1
    result

