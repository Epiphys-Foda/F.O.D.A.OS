let metric_tensor_verify() =
    let result = 0
    let g11 = 1
    let g12 = 0
    let g22 = 1
    let det_g = gf_sub(gf_mul(g11, g22), gf_mul(g12, g12))
    if det_g == 1
        result = result + 1
    let g11b = 2
    let g22b = 3
    let det_b = gf_mul(g11b, g22b)
    if det_b == 6
        result = result + 1
    if g12 == 0
        result = result + 1
    let g11_inv = gf_div(1, g11b)
    if gf_mul(g11b, g11_inv) == 1
        result = result + 1
    result

let christoffel_verify() =
    let result = 0
    let d1_g22 = 6
    let gamma_formula = gf_mul(gf_div(1, 2), gf_neg(d1_g22))
    if gf_add(gamma_formula, 3) == 0
        result = result + 1
    let gamma1_22 = gf_neg(3)
    if gamma1_22 == 65534
        result = result + 1
    let gamma2_12 = gf_div(1, 3)
    if gf_mul(gamma2_12, 3) == 1
        result = result + 1
    result

let riemann_verify() =
    let result = 0
    let R_1212_a = gf_mul(2, 3)
    let R_2112_a = gf_neg(R_1212_a)
    if gf_add(R_1212_a, R_2112_a) == 0
        result = result + 1
    let h_pp = gf_add(gf_sub(9, gf_mul(2, 4)), 1)
    if h_pp == 2
        result = result + 1
    let K = gf_div(gf_neg(h_pp), 4)
    if gf_mul(K, 65536) == gf_div(1, 2)
        result = result + 1
    result

let ricci_verify() =
    let result = 0
    let K_r = 3
    let R_11 = gf_mul(K_r, 2)
    let R_22 = gf_mul(K_r, 5)
    let R_trace = gf_add(gf_mul(gf_div(1, 2), R_11), gf_mul(gf_div(1, 5), R_22))
    if R_trace == gf_mul(2, K_r)
        result = result + 1
    let K = gf_div(65535, 4)
    let R = gf_mul(2, K)
    if R == 65536
        result = result + 1
    if gf_sub(K, gf_mul(gf_div(R, 2), 1)) == 0
        result = result + 1
    result

let geodesic_verify() =
    let result = 0
    let x0 = 1
    let x1 = 3
    let x2 = 5
    let d2x = gf_sub(gf_sub(x2, gf_mul(2, x1)), x0)
    if d2x == 0
        result = result + 1
    if gf_sub(x1, x0) == 2
        result = result + 1
    if gf_sub(x2, x1) == 2
        result = result + 1
    result

let covariant_deriv_verify() =
    let result = 0
    let V_at_3 = gf_mul(2, 3)
    let V_at_1 = gf_mul(2, 1)
    let dV = gf_div(gf_sub(V_at_3, V_at_1), 2)
    if dV == 2
        result = result + 1
    let nabla_lin = gf_add(gf_mul(2, 2), gf_mul(3, 0))
    if nabla_lin == 4
        result = result + 1
    let leibniz = gf_add(gf_mul(1, 3), gf_mul(2, 0))
    if leibniz == 3
        result = result + 1
    result

let duality_verify() =
    let result = 0
    let V_flat = gf_mul(2, 3)
    if V_flat == 6
        result = result + 1
    let V_sharp = gf_mul(gf_div(1, 2), 6)
    if V_sharp == 3
        result = result + 1
    if gf_mul(2, 3) == 6
        result = result + 1
    result

let diffgeom_pcd_rrc_verify() =
    let result = 0
    let g_12_s = 5
    let g_21_s = 5
    if gf_sub(g_12_s, g_21_s) == 0
        result = result + 1
    let G_12 = gf_div(1, 3)
    let G_21 = gf_div(1, 3)
    if gf_sub(G_12, G_21) == 0
        result = result + 1
    let R_1212 = 1
    let R_2112 = gf_neg(1)
    if gf_add(R_1212, R_2112) == 0
        result = result + 1
    let K_e = 2
    let g_e = 3
    let R_mn_e = gf_mul(K_e, g_e)
    let R_sc_e = gf_mul(2, K_e)
    let half_Rg = gf_mul(gf_div(R_sc_e, 2), g_e)
    if gf_sub(R_mn_e, half_Rg) == 0
        result = result + 1
    if gf_add(gf_sub(5, 6), 1) == 0
        result = result + 1
    result

