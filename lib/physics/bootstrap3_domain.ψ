let ast_to_meta_field(ast_types, ast_values, n) =
    let poles = []
    let res = []
    let i = 0
    for i < n
        let t = ast_types[i]
        let v = ast_values[i]
        poles = poles.push(ast_to_pole(t, v))
        res = res.push(gf_add(gf_mul(t, 31), v))
        i = i + 1
    mf_make(poles, res, n)

let combinator_I(f) = f

let combinator_K(c_poles, c_res, c_n) = mf_make(c_poles, c_res, c_n)

let combinator_B(f, g, h) = mf_compose(f, mf_compose(g, h))

let combinator_C(f, g) = mf_compose(g, f)

let combinator_S(f, g, h) = mf_compose(mf_compose(f, h), mf_compose(g, h))

let combinator_Y(f, max_iter) =
    let result = f
    let i = 0
    for i < max_iter
        result = mf_compose(f, result)
        i = i + 1
    result

