let galois_orbit(f, sigma, orbit_len) =
    let orbit_fps = []
    let current = f
    let i = 0
    for i < orbit_len
        orbit_fps = orbit_fps.push(mf_fingerprint(current))
        current = galois_mutate(current, sigma)
        i = i + 1
    orbit_fps

