import "residueon_common.ψ"

let number_field_verify() =
    let result = 0
    if gf_mul(1, 7) == 7
        result = result + 1
    if gf_add(0, 7) == 7
        result = result + 1
    if gf_mul(7, 11) == gf_mul(11, 7)
        result = result + 1
    result

let dedekind_ring_verify() =
    let result = 0
    if gf_mul(gf_mul(2, 3), 5) == gf_mul(2, gf_mul(3, 5))
        result = result + 1
    if gf_mul(2, gf_add(3, 5)) == gf_add(gf_mul(2, 3), gf_mul(2, 5))
        result = result + 1
    if gf_div(gf_mul(2, 3), 2) == 3
        result = result + 1
    result

let dirichlet_unit_verify() =
    let result = 0
    if gf_mul(5, gf_inv(5)) == 1
        result = result + 1
    if gf_mul(7, gf_inv(7)) == 1
        result = result + 1
    if gf_mul(gf_inv(2), gf_inv(3)) == gf_inv(gf_mul(2, 3))
        result = result + 1
    result

let minkowski_verify() =
    let result = 0
    if gf_mul(65536, 65536) == 1
        result = result + 1
    if gf_mul(256, 256) == 65536
        result = result + 1
    if gf_add(1, 65536) == 0
        result = result + 1
    result

let class_number_verify() =
    let result = 0
    if gf_mul(2, 3) == gf_mul(3, 2)
        result = result + 1
    if gf_mul(gf_mul(2, 3), 5) == gf_mul(2, gf_mul(3, 5))
        result = result + 1
    if gf_mul(1, 7) == 7
        result = result + 1
    result

let prime_decomposition_verify() =
    let result = 0
    if gf_mul(2, 2) == 4
        result = result + 1
    if gf_mul(gf_mul(2, 2), 2) == 8
        result = result + 1
    if gf_div(gf_mul(12, 12), gf_mul(2, 2)) == gf_mul(6, 6)
        result = result + 1
    result

let hilbert_class_field_verify() =
    let result = 0
    if gf_mul(gf_inv(2), 2) == 1
        result = result + 1
    if gf_mul(65536, 65536) == 1
        result = result + 1
    if gf_mul(gf_inv(3), gf_inv(5)) == gf_inv(gf_mul(3, 5))
        result = result + 1
    result

let alg_numtheory_pcd_rrc_verify() =
    let result = 0
