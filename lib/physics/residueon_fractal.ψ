let hausdorff_dim_verify() =
    let result = 0
    if gf_mul(2, 3) == 6
        result = result + 1
    if gf_mul(4, 3) == 12
        result = result + 1
    if gf_sub(3, 2) == 1
        result = result + 1
    result

let box_dim_verify() =
    let result = 0
    if gf_div(4, 4) == 1
        result = result + 1
    if gf_mul(3, 3) == 9
        result = result + 1
    if gf_mul(2, gf_mul(2, 2)) == 8
        result = result + 1
    result

let self_similar_verify() =
    let result = 0
    if gf_div(2, 3) != 1
        result = result + 1
    if gf_div(4, 3) != 1
        result = result + 1
    if gf_mul(2, gf_div(1, 2)) == 1
        result = result + 1
    result

let cantor_set_verify() =
    let result = 0
    if gf_div(1, 3) == gf_div(1, 3)
        result = result + 1
    if gf_mul(4, gf_div(1, 9)) == gf_div(4, 9)
        result = result + 1
    if gf_div(2, 3) != 1
        result = result + 1
    result

let koch_curve_verify() =
    let result = 0
    if gf_mul(4, gf_div(1, 3)) == gf_div(4, 3)
        result = result + 1
    if gf_div(4, 3) != 1
        result = result + 1
    if 4 > 3
        result = result + 1
    result

let sierpinski_verify() =
    let result = 0
    if gf_div(3, 2) != 1
        result = result + 1
    if gf_div(3, 4) != 1
        result = result + 1
    if 3 > 2
        result = result + 1
    result

let dimension_relation_verify() =
    let result = 0
    if gf_div(2, 3) != 1
        result = result + 1
    if gf_div(3, 2) != 1
        result = result + 1
    if gf_add(1, 1) == 2
        result = result + 1
    result

let fractal_pcd_rrc_verify() =
    let result = 0
