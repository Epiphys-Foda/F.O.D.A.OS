let PE_SRC = 20
let PE_MAC = 21
let PE_ALU = 22
let PE_NTT = 23
let PE_CMP = 24
let PE_LAP = 25

let op_to_pe(op_type) =
    if op_type == 0
        PE_SRC
    else
        0
    if op_type == 1
        PE_MAC
    else
        0
    if op_type == 2
        PE_ALU
    else
        0
    if op_type == 3
        PE_NTT
    else
        0
    if op_type == 4
        PE_CMP
    else
        0
    if op_type == 5
        PE_LAP
    else
        PE_SRC

let field_to_pe(ops_type, ops_data, n, pe_op, pe_in, pe_out) =
    let i = 0
    for i < n
        pe_op[i] = op_to_pe(ops_type[i])
        pe_in[i] = ops_data[i]
        pe_out[i] = 0
        i = i + 1

let pe_execute(pe_op, pe_in, n) =
    let stack = arr_new_n(n)
    let sp = 0
    let i = 0
    for i < n
        let op = pe_op[i]
        if op == PE_SRC
            stack[sp] = pe_in[i]
            sp = sp + 1
        if op == PE_MAC
            if sp >= 2
                let b = stack[sp - 1]
                let a = stack[sp - 2]
                sp = sp - 2
                stack[sp] = gf_mul(a, b)
                sp = sp + 1
        if op == PE_ALU
            if sp >= 2
                let b = stack[sp - 1]
                let a = stack[sp - 2]
                sp = sp - 2
                stack[sp] = gf_add(a, b)
                sp = sp + 1
        if op == PE_NTT
            if sp >= 1
                stack[sp - 1] = (stack[sp - 1] * 3) % 65537
        if op == PE_CMP
            if sp >= 1
                let a = stack[sp - 1]
                if a > 32768
                    stack[sp - 1] = 0
        if op == PE_LAP
            if sp >= 1
                stack[sp - 1] = (65535 * stack[sp - 1] + 2) % 65537
        i = i + 1
    (sp > 0 ? stack[sp - 1] : 0)

