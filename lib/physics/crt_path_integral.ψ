let garner(x1, x2, q1, q2) =
    let t = (x2 + q2 - x1) % q2
    let k = mulmod(t, invmod(q1 % q2, q2), q2)
    let x = x1 + q1 * k
    x

let matmul(a, b) =
    let r = arr_new_n(4)
    r[0] = a[0] * b[0] + a[1] * b[2]
    r[1] = a[0] * b[1] + a[1] * b[3]
    r[2] = a[2] * b[0] + a[3] * b[2]
    r[3] = a[2] * b[1] + a[3] * b[3]
    r

