let riemann_surface_verify() =
    let result = 0
    if gf_mul(2, 1) == 2
        result = result + 1
    if gf_sub(2, gf_mul(2, 0)) == 2
        result = result + 1
    if gf_sub(2, gf_mul(2, 1)) == 0
        result = result + 1
    result

let genus_verify() =
    let result = 0
    if gf_div(gf_mul(gf_sub(2, 1), gf_sub(2, 2)), 2) == 0
        result = result + 1
    if gf_mul(gf_sub(3, 1), gf_sub(3, 2)) == 2
        result = result + 1
    if gf_div(gf_mul(2, 1), 2) == 1
        result = result + 1
    if gf_div(gf_mul(3, 2), 2) == 3
        result = result + 1
    result

let divisor_verify() =
    let result = 0
    if gf_add(2, 3) == 5
        result = result + 1
    if gf_sub(3, 3) == 0
        result = result + 1
    if gf_sub(gf_add(2, 3), 5) == 0
        result = result + 1
    result

let riemann_roch_verify() =
    let result = 0
    if gf_add(gf_add(2, 1), gf_neg(0)) == 3
        result = result + 1
    if gf_add(gf_add(1, 1), gf_neg(1)) == 1
        result = result + 1
    if gf_sub(gf_mul(2, 0), 2) == 65535
        result = result + 1
    if gf_sub(gf_mul(2, 1), 2) == 0
        result = result + 1
    result

let canonical_divisor_verify() =
    let result = 0
    if gf_sub(gf_mul(2, 0), 2) == 65535
        result = result + 1
    if gf_sub(gf_mul(2, 1), 2) == 0
        result = result + 1
    if gf_sub(gf_mul(2, 2), 2) == 2
        result = result + 1
    result

let abel_theorem_verify() =
    let result = 0
    if gf_mul(0, gf_inv(2)) == 0
        result = result + 1
    if gf_sub(gf_add(2, 3), gf_add(3, 2)) == 0
        result = result + 1
    if gf_sub(2, 2) == 0
        result = result + 1
    result

let jacobi_variety_verify() =
    let result = 0
    if gf_mul(2, 0) == 0
        result = result + 1
    if gf_sub(gf_add(1, 1), 1) == 1
        result = result + 1
    if gf_mul(2, 3) == 6
        result = result + 1
    result

let riemann_pcd_rrc_verify() =
    let result = 0
    if gf_add(2, 3) == 5
        result = result + 1
    if gf_sub(4, 4) == 0
        result = result + 1
    if gf_add(gf_add(2, 1), gf_neg(0)) == 3
        result = result + 1
    if gf_sub(gf_mul(2, 1), 2) == 0
        result = result + 1
    if gf_add(gf_sub(2, 5), gf_sub(5, 2)) == 0
        result = result + 1
    result

