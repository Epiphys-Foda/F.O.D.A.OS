let P = 65537

let fact(n) =
    let r = 1
    let i = 2
    for i <= n
        r = r * i % P
        i = i + 1
    r

let fact_mod(n, p) =
    let r = 1
    let i = 2
    for i <= n
        r = r * i % p
        i = i + 1
    r

let tower_zero(deg) =
    let out = []
    let i = 0
    for i <= deg
        out.push(0)
        i = i + 1
    out

let tower_one(deg) =
    let out = tower_zero(deg)
    out[0] = 1
    out

let tower_const(c, deg) =
    let out = tower_zero(deg)
    out[0] = c % P
    out

let tower_x(deg) =
    let out = tower_zero(deg)
    if deg >= 1
        out[1] = 1
    out

let tower_make(coeffs, deg) =
    let out = tower_zero(deg)
    let i = 0
    for i <= deg
        if i < len(coeffs)
            out[i] = coeffs[i] % P
        i = i + 1
    out

let tower_add(a, b, deg) =
    let out = tower_zero(deg)
    let i = 0
    for i <= deg
        let va = 0
        let vb = 0
        if i < len(a)
            va = a[i]
        if i < len(b)
            vb = b[i]
        out[i] = (va + vb) % P
        i = i + 1
    out

let tower_sub(a, b, deg) =
    let out = tower_zero(deg)
    let i = 0
    for i <= deg
        let va = 0
        let vb = 0
        if i < len(a)
            va = a[i]
        if i < len(b)
            vb = b[i]
        out[i] = (va + P - vb) % P
        i = i + 1
    out

let tower_mul(a, b, deg) =
    let out = tower_zero(deg)
    let i = 0
    for i <= deg
        let j = 0
        for j <= deg
            if i + j <= deg
                let va = 0
                let vb = 0
                if i < len(a)
                    va = a[i]
                if j < len(b)
                    vb = b[j]
                let old = out[i + j]
                out[i + j] = (old + va * vb) % P
            j = j + 1
        i = i + 1
    out

let tower_scalar_mul(c, a, deg) =
    let out = tower_zero(deg)
    let i = 0
    for i <= deg
        if i < len(a)
            out[i] = c * a[i] % P
        i = i + 1
    out

let tower_pow(a, n, deg) =
    let result = tower_one(deg)
    let i = 0
    for i < n
        result = tower_mul(result, a, deg)
        i = i + 1
    result

let tower_eval(t, x) =
    let deg = len(t) - 1
    let result = 0
    for deg >= 0
        result = (t[deg] + x * result) % P
        deg = deg - 1
    result

let tower_deriv(a, deg) =
    let out = tower_zero(deg)
    let i = 1
    for i <= deg + 1
        if i < len(a)
            let coeff = i * a[i] % P
            if i - 1 <= deg
                out[i - 1] = coeff
        i = i + 1
    out

let tower_compose(a, b, deg) =
    let result = tower_zero(deg)
    let bpow = tower_one(deg)
    let i = 0
    for i <= deg
        if i < len(a)
            let ai = a[i]
            let term = tower_scalar_mul(ai, bpow, deg)
            result = tower_add(result, term, deg)
        bpow = tower_mul(bpow, b, deg)
        i = i + 1
    result

let tower_exp(deg) =
    tower_exp_ax(1, deg)

let tower_exp_ax(a, deg) =
    let out = tower_zero(deg)
    let coeff = 1
    let k = 0
    for k <= deg
        let fk = fact(k)
        let val = gf_div(coeff, fk)
        out[k] = val
        coeff = coeff * a % P
        k = k + 1
    out

let tower_sin(deg) =
    let out = tower_zero(deg)
    let sgn = 1
    let n = 0
    for 2 * n + 1 <= deg
        let k = 2 * n + 1
        let fk = fact(k)
        let coeff = gf_div(sgn, fk)
        out[k] = coeff
        sgn = gf_neg(sgn)
        n = n + 1
    out

let tower_cos(deg) =
    let out = tower_zero(deg)
    let sgn = 1
    let n = 0
    for 2 * n <= deg
        let k = 2 * n
        let fk = fact(k)
        let coeff = gf_div(sgn, fk)
        out[k] = coeff
        sgn = gf_neg(sgn)
        n = n + 1
    out

let tower_log(deg) =
    let out = tower_zero(deg)
    let n = 1
    for n <= deg
        let sgn = 1
        if n % 2 == 0
            sgn = gf_neg(1)
        let val = gf_div(sgn, n)
        out[n] = val
        n = n + 1
    out

