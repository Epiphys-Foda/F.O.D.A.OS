    let deg = 10
    let exp_neg = tower_exp_ax(P - 1, deg)
    let exp_pos = tower_exp_ax(1, deg)
    let n0 = 100
    let boltzmann = tower_scalar_mul(n0, exp_neg, deg)
    let n_at_0 = tower_eval(boltzmann, 0)
    if n_at_0 == n0
        ok = ok + 1
    let product = tower_mul(boltzmann, exp_pos, deg)
    let n0_tower = tower_const(n0, deg)
    let match_val = 1
    let i = 0
    for i <= deg
        if product[i] != n0_tower[i]
            match_val = 0
        i = i + 1
    if match_val == 1
        ok = ok + 1
    let dn = tower_deriv(boltzmann, deg)
    let neg_boltzmann = tower_scalar_mul(P - 1, boltzmann, deg)
    let match2 = 1
    let j = 0
    for j < deg
        if dn[j] != neg_boltzmann[j]
            match2 = 0
        j = j + 1
    if match2 == 1
        ok = ok + 1
    ok

