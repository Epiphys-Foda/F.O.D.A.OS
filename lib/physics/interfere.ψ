let verify_interference_pattern() =
    let pass = 1

    let psi_00 = interfere(0, 0)
    if psi_00 != 0
        pass = 0

    let psi_11 = interfere(1, 1)
    if psi_11 != 0
        pass = 0

    let psi_01 = interfere(0, 1)
    if psi_01 == 0
        pass = 0

    let psi_10 = interfere(1, 0)
    if psi_10 == 0
        pass = 0

    pass

