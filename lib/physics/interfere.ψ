import "../core/stdlib_lang2/gf_pre_0_302.ψ"

let SLIT1 = 100
let SLIT2 = 200
let OBSERVE = 150

let interfere(a, b) =
    let d1 = wfc_sub(OBSERVE, SLIT1)
    let d2 = wfc_sub(OBSERVE, SLIT2)
    let inv_d1 = wfc_inv(d1)
    let inv_d2 = wfc_inv(d2)
    let term1 = wfc_mul(a, inv_d1)
    let term2 = wfc_mul(b, inv_d2)
    wfc_add(term1, term2)

let verify_xor() =
    let pass = 1
    if xor_gate(0, 0) != 0
        pass = 0
    if xor_gate(0, 1) != 1
        pass = 0
    if xor_gate(1, 0) != 1
        pass = 0
    if xor_gate(1, 1) != 0
        pass = 0
    pass

