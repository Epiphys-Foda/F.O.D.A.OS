let field_eval(poles, z) =
    let sum = 0
    let i = 0
    for i + 2 < len(poles)
        let zk = poles[i]
        let rk = poles[i + 1]
        let nk = poles[i + 2]
        let den = (z - zk + P) % P
        let pw = 1
        let k = 0
        for k < nk
            pw = pw * den % P
            k = k + 1
        sum = (sum + gf_div(rk, pw)) % P
        i = i + 3
    sum

