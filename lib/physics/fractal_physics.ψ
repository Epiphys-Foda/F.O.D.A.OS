let poly_mul(a, b, deg) =
    let out = []
    let i = 0
    for i <= deg
        out = arr_push(out, 0)
        i = i + 1
    let i = 0
    for i < len(a)
        let j = 0
        for j < len(b)
            if i + j <= deg
                let old = out[i + j]
                out[i + j] = (old + a[i] * b[j]) % P
            j = j + 1
        i = i + 1
    out

let poly_exp(sign, deg) =
    let out = [1]
    let term = 1
    let k = 1
    for k <= deg
        term = term * sign % P
        let coeff = gf_div(term, fact(k))
        out = arr_push(out, coeff)
        k = k + 1
    out

let fact(n) =
    let r = 1
    let i = 2
    for i <= n
        r = r * i % P
        i = i + 1
    r

