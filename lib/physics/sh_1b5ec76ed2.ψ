let galois_order(f, sigma, max_iter) =
    let original_fp = mf_fingerprint(f)
    let current = galois_mutate(f, sigma)
    let order = 1
    let i = 0
    let stop = 0
    for i < max_iter
        if stop == 0
            if mf_fingerprint(current) == original_fp
                stop = 1
            if mf_fingerprint(current) != original_fp
                current = galois_mutate(current, sigma)
                order = order + 1
        i = i + 1
    order

