let complex_manifold_verify() =
    let result = 0
    if gf_mul(256, 256) == 65536
        result = result + 1
    if gf_mul(2, 5) == 10
        result = result + 1
    if gf_add(gf_sub(gf_mul(2, 3), gf_mul(2, 3)), gf_add(gf_neg(gf_mul(2, 4)), gf_mul(2, 4))) == 0
        result = result + 1
    result

let kahler_metric_verify() =
    let result = 0
    if gf_add(gf_mul(4, 1), gf_mul(4, gf_neg(1))) == 0
        result = result + 1
    if gf_add(gf_add(3, gf_mul(4, 256)), gf_sub(3, gf_mul(4, 256))) == 6
        result = result + 1
    if gf_mul(2, 3) == 6
        result = result + 1
    result

let holomorphic_bundle_verify() =
    let result = 0
    if gf_mul(gf_mul(2, 3), gf_inv(6)) == 1
        result = result + 1
    if gf_add(gf_mul(3, 2), gf_mul(2, 3)) == 12
        result = result + 1
    if gf_mul(256, gf_mul(256, 2)) == gf_neg(2)
        result = result + 1
    result

let chern_class_verify() =
    let result = 0
    if gf_sub(gf_mul(1, 1), gf_mul(0, 0)) == 1
        result = result + 1
    if gf_add(1, gf_neg(1)) == 0
        result = result + 1
    if gf_add(2, 3) == 5
        result = result + 1
    result

let hodge_decomposition_verify() =
    let result = 0
    if gf_add(gf_add(gf_add(2, 0), gf_add(1, 1)), gf_add(0, 2)) == 6
        result = result + 1
    if gf_add(1, 1) == 2
        result = result + 1
    if gf_add(gf_add(1, 1), gf_add(0, 2)) == 4
        result = result + 1
    result

let dolbeault_verify() =
    let result = 0
    if gf_add(gf_mul(5, 1), gf_mul(5, gf_neg(1))) == 0
        result = result + 1
    if gf_add(5, gf_neg(5)) == 0
        result = result + 1
    if gf_add(3, gf_neg(3)) == 0
        result = result + 1
    result

let riemann_roch_verify() =
    let result = 0
    if gf_sub(0, 1) == gf_neg(1)
        result = result + 1
    if gf_div(6, 2) == 3
        result = result + 1
    if gf_div(gf_mul(2, 2), 2) == 2
        result = result + 1
    result

let complex_geom_pcd_rrc_verify() =
