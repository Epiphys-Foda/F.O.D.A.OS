let unify_opt_pass(node) =
    let z = uz(node)
    let result = node

    if z == 2
        let op = ur(node)
        let l = unify_norm(uc(node, 0))
        let r = unify_norm(uc(node, 1))
        result = unode2(2, op, l, r)

        if uz(l) == 0
            if uz(r) == 0
                if op == 43
                    result = unode(0, (ur(l) + ur(r)) % P)
                if op == 45
                    result = unode(0, (ur(l) - ur(r) + P) % P)
                if op == 42
                    result = unify_mul(l, r)

        if op == 43
            if uz(r) == 0
                if ur(r) == 0
            if uz(l) == 0
                if ur(l) == 0
        if op == 42
            if uz(r) == 0
                if ur(r) == 1
            if uz(r) == 0
                if ur(r) == 0
            if uz(l) == 0
                if ur(l) == 1
            if uz(l) == 0
                if ur(l) == 0

    if z == 15
        let n = uarity(node)
        if n == 0
            result = unode(0, 0)

    if z == 10
        let cond = unify_norm(uc(node, 0))
        if uz(cond) == 0
            if ur(cond) != 0
                result = uc(node, 1)
            if ur(cond) == 0
                result = uc(node, 2)

    result

let unify_optimize(node) =
    let current = node
    let changed = 1
    for changed == 1
        let next = unify_opt_pass(current)
        if next == current
            changed = 0
        current = next
    current

let unify_compile(ast, env) =
    let injected = unify_inject(env, 0, 0)
    let optimized = unify_optimize(ast)
    let evolved = unify_evolve(optimized)
    unify_collapse(evolved)

let unify_compile_pure(ast) =
    let optimized = unify_optimize(ast)
    unify_collapse(optimized)

let universal_recur(c1, c0, init0, init1) =
    [c1, c0, init0, init1]

let universal_eval(desc, n) =
    let c1 = desc[0]
    let c0 = desc[1]
    let a = desc[2]
    let b = desc[3]
    if n == 0
        a
    if n == 1
        b
    let i = 2
    for i <= n
        let c = (c1 * b + c0 * a) % P
        a = b
        b = c
        i = i + 1
    b

let universal_comb(n, k) =
    if k > n
        0
    if k == 0
        1
    if k == n
        1
    universal_comb(n - 1, k - 1) + universal_comb(n - 1, k)

let universal_phi(n) =
    let result = n
    let p = 2
    for p * p <= n
        if n % p == 0
            for n % p == 0
                n = n / p
            result = result - result / p
        p = p + 1
    if n > 1
        result = result - result / n
    result

