let P = 65537

let unode(z, r) = [z, r]
let unode1(z, r, c0) = [z, r, c0]
let unode2(z, r, c0, c1) = [z, r, c0, c1]
let unode3(z, r, c0, c1, c2) = [z, r, c0, c1, c2]

let uz(node) = node[0]
let ur(node) = node[1]
let uc(node, i) = node[i + 2]
let uarity(node) = len(node) - 2

let unify_add(a, b) =
    if uz(a) == 0
        if uz(b) == 0
            unode(0, (ur(a) + ur(b)) % P)
    unode2(2, 43, a, b)

let unify_mul(a, b) =
    if uz(a) == 0
        if uz(b) == 0
            let r = 0
            let x = ur(a) % P
            let y = ur(b)
            for y > 0
                if y % 2 == 1
                    r = (r + x) % P
                x = (x + x) % P
                y = y / 2
            unode(0, r)
    unode2(2, 42, a, b)

let unify_evolve(node) =
    let z = uz(node)
    if z == 0
        unode(0, ur(node) + 1)
    if z == 2
        let l = unify_evolve(uc(node, 0))
        let r = unify_evolve(uc(node, 1))
        unode2(2, ur(node), l, r)
    node

let unify_norm(node) =
    let z = uz(node)
    if z == 2
        let op = ur(node)
        let l = uc(node, 0)
        let r = uc(node, 1)
        if op == 43
            if uz(l) == 0
                (uz(r) == 0 ? unode(0, (ur(l) + ur(r)) % P) : 0)
        if op == 42
            if uz(l) == 0
                (uz(r) == 0 ? unify_mul(l, r) : 0)
    node

let unify_collapse(node) =
    let z = uz(node)
    if z == 0
        ur(node)
    if z == 2
        let op = ur(node)
        let l = unify_collapse(uc(node, 0))
        let r = unify_collapse(uc(node, 1))
        if op == 43
            (l + r) % P
        if op == 45
            (l - r + P) % P
        if op == 42
            let res = 0
            let x = l % P
            let y = r
            for y > 0
                if y % 2 == 1
                    res = (res + x) % P
                x = (x + x) % P
                y = y / 2
            res
        if op == 47
            let inv = 1
            let base = r % P
            let exp = P - 2
            for exp > 0
                if exp % 2 == 1
                    inv = inv * base % P
                base = base * base % P
                exp = exp / 2
            l * inv % P
        if op == 60
            (l < r ? 1 : 0)
        0
        if op == 62
            (l > r ? 1 : 0)
        0
        if op == 61
            if l == r
                1
            0
    if z == 1
        0
    if z == 15
        let n = uarity(node)
        if n == 0
            0
        unify_collapse(uc(node, n - 1))
    if z == 10
        let cond = unify_collapse(uc(node, 0))
        if cond != 0
            unify_collapse(uc(node, 1))
        unify_collapse(uc(node, 2))
    0

let unify_inject(env, var_id, value) =
    arr_push(arr_push(env, var_id), value)

let fractal_fib(n) =
    if n == 0
        0
    if n == 1
        1
    let a = 0
    let b = 1
    let i = 2
    for i <= n
        let c = (a + b) % P
        a = b
        b = c
        i = i + 1
    b

let fractal_lucas(n) =
    if n == 0
        2
    if n == 1
        1
    let a = 2
    let b = 1
    let i = 2
    for i <= n
        let c = (a + b) % P
        a = b
        b = c
        i = i + 1
    b

let fractal_pell(n) =
    if n == 0
        0
    if n == 1
        1
    let a = 0
    let b = 1
    let i = 2
    for i <= n
        let c = (2 * b + a) % P
        a = b
        b = c
        i = i + 1
    b

let fractal_catalan(n) =
    let c = 1
    let i = 0
    for i < n
        c = c * 2 * (2 * i + 1) / (i + 2)
        i = i + 1
    c

let fractal_gcd(a, b) =
    let x = a
    let y = b
    for y != 0
        let t = x % y
        x = y
        y = t
    x

let fractal_is_prime(n) =
    let ok = 0
    if n >= 2
        ok = 1
        let i = 2
        for i * i <= n
            if n % i == 0
                ok = 0
            i = i + 1
    ok

let fractal_binomial(n, k) =
    if k > n
        0
    if k == 0
        1
    if k == n
        1
    let result = 1
    let i = 0
    for i < k
        result = result * (n - i) / (i + 1)
        i = i + 1
    result

let fractal_stirling2(n, k) =
    let result = 0
    if n == 0
        if k == 0
    if n > 0
        if k == 0
            result = 0
        if k == n
            result = 1
        if k == 1
            result = 1
        if k > 1
            if k < n
                result = fractal_stirling2(n - 1, k - 1) + k * fractal_stirling2(n - 1, k)
    result

let fractal_burnside(fixes, n) =
    let len = len(fixes)
    let sum = 0
    let i = 0
    for i < len
        sum = sum + fixes[i]
        i = i + 1
    sum / n

let fractal_legendre(a, p) =
    let val = 1
    let base = a % p
    let exp = (p - 1) / 2
    for exp > 0
        if exp % 2 == 1
            val = val * base % p
        base = base * base % p
        exp = exp / 2
    let result = 0 - 1
    if val == 1
        result = 1
    if val == 0
        result = 0
    result

