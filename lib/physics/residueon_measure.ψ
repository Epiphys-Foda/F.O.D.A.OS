let sigma_algebra_verify() =
    let result = 0
    if gf_sub(gf_div(1, 3), gf_div(1, 3)) == 0
        result = result + 1
    if gf_sub(1, gf_div(1, 3)) == gf_div(2, 3)
        result = result + 1
    if gf_add(gf_div(1, 3), gf_div(2, 3)) == 1
        result = result + 1
    if gf_add(gf_div(1, 3), gf_div(2, 3)) == 1
        result = result + 1
    result

let measure_verify() =
    let result = 0
    let mu_a = gf_div(1, 3)
    let mu_b = gf_div(2, 3)
    if gf_sub(gf_div(2, 3), gf_div(2, 3)) == 0
        result = result + 1
    if gf_add(mu_a, mu_b) == 1
        result = result + 1
    if gf_add(mu_a, mu_b) == 1
        result = result + 1
    result

let lebesgue_integral_verify() =
    let result = 0
    let mu_a = gf_div(1, 3)
    let mu_b = gf_div(2, 3)
    let integral_f = gf_add(gf_mul(3, mu_a), gf_mul(5, mu_b))
    if integral_f == gf_div(13, 3)
        result = result + 1
    let integral_2f = gf_add(gf_mul(gf_mul(2, 3), mu_a), gf_mul(gf_mul(2, 5), mu_b))
    if integral_2f == gf_mul(2, integral_f)
        result = result + 1
    let integral_1 = gf_add(gf_mul(1, mu_a), gf_mul(1, mu_b))
    if integral_1 == 1
        result = result + 1
    let integral_g = gf_add(gf_mul(4, mu_a), gf_mul(6, mu_b))
    if integral_g == gf_div(16, 3)
        result = result + 1
    result

let monotone_convergence_verify() =
    let result = 0
    let f2 = gf_div(2, 3)
    let f3 = gf_div(3, 4)
    if gf_mul(2, 4) < gf_mul(3, 3)
        result = result + 1
    if gf_sub(1, f3) == gf_div(1, 4)
        result = result + 1
    if gf_sub(f3, f2) == gf_sub(gf_div(3, 4), gf_div(2, 3))
        result = result + 1
    result

let dominated_convergence_verify() =
    let result = 0
    let int_f1 = 1
    let int_f2 = gf_div(1, 2)
    let int_f3 = gf_div(1, 3)
    if gf_sub(1, int_f2) == gf_div(1, 2)
        result = result + 1
    if 3 > 2
        result = result + 1
    if gf_sub(gf_div(1, 2), gf_div(1, 3)) == gf_div(1, 6)
        result = result + 1
    result

let fubini_verify() =
    let result = 0
    let sum_xy = gf_add(gf_add(1, 2), gf_add(3, 4))
    let sum_yx = gf_add(gf_add(1, 3), gf_add(2, 4))
    if sum_xy == 10
        result = result + 1
    if sum_yx == 10
        result = result + 1
    if sum_xy == sum_yx
        result = result + 1
    result

let radon_nikodym_verify() =
    let result = 0
    let mu_a = gf_div(1, 3)
    let mu_b = gf_div(2, 3)
    let nu_a = gf_mul(2, mu_a)
    let nu_b = gf_mul(2, mu_b)
    if nu_a == gf_div(2, 3)
        result = result + 1
    if nu_b == gf_div(4, 3)
        result = result + 1
    if gf_mul(2, 3) == 6
        result = result + 1
    result

