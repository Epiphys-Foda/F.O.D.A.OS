let compiler_to_field(phases, data, n, poles, residues) =
    let i = 0
    for i < n
        let base = 200 + phases[i] * 1000
        poles[i] = base + i * 10
        residues[i] = data[i]
        i = i + 1

let field_compile_step(residues, n) =
    let changed = 0
    let i = 0
    for i < n
        if i > 0
            let prev = residues[i - 1]
            let cur = residues[i]
            let next_val = (prev + cur * 3) % 65537
            if next_val != cur
                residues[i] = next_val
                changed = 1
        i = i + 1
    changed

let field_self_compile(phases, data, n, max_steps) =
    let poles = arr_new_n(n)
    let residues = arr_new_n(n)
    compiler_to_field(phases, data, n, poles, residues)
    let steps = 0
    let converged = 0
    for steps < max_steps
        let changed = field_compile_step(residues, n)
        if changed == 0
            converged = 1
            steps = max_steps
        steps = steps + 1
    let result = arr_new_n(3)
    result[0] = residues[n - 1]
    result[1] = steps
    result[2] = converged
    result

let field_fixed_point_check(residues, n) =
    let r1 = arr_new_n(n)
    let i = 0
    for i < n
        r1[i] = residues[i]
        i = i + 1
    field_compile_step(r1, n)
    let r2 = arr_new_n(n)
    let j = 0
    for j < n
        r2[j] = r1[j]
        j = j + 1
    field_compile_step(r2, n)
    let ok = 1
    let k = 0
    for k < n
        if r1[k] != r2[k]
            ok = 0
        k = k + 1
    ok

let bootstrap_verify(phases, data, n, max_steps) =
    let result = field_self_compile(phases, data, n, max_steps)
    let fp_ok = field_fixed_point_check(data, n)
    let out = arr_new_n(4)
    out[0] = result[0]
    out[1] = result[1]
    out[2] = result[2]
    out[3] = fp_ok
    out

