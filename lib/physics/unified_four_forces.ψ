let four_force_evolve(fg, fe, fs, fw, grad_g, grad_e, grad_s, grad_w, dt) =
    let fg_new = force_evolve_forward(fg, grad_g, dt)
    let fe_new = force_evolve_forward(fe, grad_e, dt)
    let fs_new = force_evolve_forward(fs, grad_s, dt)
    let fw_new = force_evolve_forward(fw, grad_w, dt)
    crt_reconstruct(rp_r(fg_new), rp_r(fe_new), rp_r(fs_new), rp_r(fw_new))

let four_force_devolve(fg, fe, fs, fw, grad_g, grad_e, grad_s, grad_w, dt) =
    let fg_new = force_evolve_backward(fg, grad_g, dt)
    let fe_new = force_evolve_backward(fe, grad_e, dt)
    let fs_new = force_evolve_backward(fs, grad_s, dt)
    let fw_new = force_evolve_backward(fw, grad_w, dt)
    crt_reconstruct(rp_r(fg_new), rp_r(fe_new), rp_r(fs_new), rp_r(fw_new))

