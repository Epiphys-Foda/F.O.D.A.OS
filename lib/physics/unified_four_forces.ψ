let super_unified_force(source, value, gradient, dt) =
    let f_g = gravity_residue(source, value, 2)
    let f_e = em_residue(source, value, 1)
    let f_s = strong_residue(source, value, 3)
    let f_w = weak_residue(source, value, 2)

    let f_sum = four_force_add(f_g, f_e, f_s, f_w)

    let f_ge = force_couple(f_g, f_e)
    let f_sw = force_couple(f_s, f_w)
    let f_coupled = force_couple(f_ge, f_sw)

    let f_propagated = force_propagate(f_sum, f_coupled)

    let f_effective = force_low_energy(f_propagated, 100)

    let f_gradient = force_gradient(f_sum, f_effective)

    let f_evolved = force_evolve_forward(f_gradient, gradient, dt)

    let r_g = gravity_curvature(f_g)
    let r_e = em_field_strength(f_e)
    let r_s = strong_color(f_s)
    let r_w = weak_charge_val(f_w)
    let unified = crt_reconstruct(r_g, r_e, r_s, r_w)

    gf_add(rp_r(f_evolved), unified)

