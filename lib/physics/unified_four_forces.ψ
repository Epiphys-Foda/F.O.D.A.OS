let force_evolve_forward(f, gradient, dt) =
    let z = rp_z(f)
    let r = rp_r(f)
    let n = rp_n(f)
    let dr = gf_mul(gradient, dt)
    rp_make(z, gf_add(r, dr), n)

let force_evolve_backward(f, gradient, dt) =
    let z = rp_z(f)
    let r = rp_r(f)
    let n = rp_n(f)
    let dr = gf_mul(gradient, dt)
    rp_make(z, gf_sub(r, dr), n)

