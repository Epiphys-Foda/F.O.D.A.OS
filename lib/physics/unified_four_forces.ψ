let graviton_propagator(k, xi, R) =
    let k_sq = gf_mul(k, k)
    let denom = gf_add(k_sq, gf_mul(xi, R))
    gf_inv(denom)

let photon_propagator(k) =
    gf_inv(gf_mul(k, k))

let gluon_propagator(k, lambda_qcd) =
    let k_sq = gf_mul(k, k)
    gf_inv(gf_add(k_sq, lambda_qcd))

let weak_boson_propagator(k, m_w) =
    let k_sq = gf_mul(k, k)
    let m_sq = gf_mul(m_w, m_w)
    gf_inv(gf_sub(k_sq, m_sq))

let unified_propagator(k, xi, R, lambda_qcd, m_w) =
    let g_g = graviton_propagator(k, xi, R)
    let g_e = photon_propagator(k)
    let g_s = gluon_propagator(k, lambda_qcd)
    let g_w = weak_boson_propagator(k, m_w)
    crt_reconstruct(g_g, g_e, g_s, g_w)

let tree_amplitude(s, m, g) =
    let prop = gf_inv(gf_sub(s, gf_mul(m, m)))
    gf_mul(gf_neg(gf_mul(g, g)), prop)

let one_loop_correction(s, m, g) =
    let pi_gf = 103993
    let sixteen_pi_sq = gf_mul(16, gf_mul(pi_gf, pi_gf))
    let delta = gf_div(gf_mul(g, g), sixteen_pi_sq)
    let m_tree = tree_amplitude(s, m, g)
    gf_mul(m_tree, gf_add(1, delta))

let unified_scattering(s, m_g, m_e, m_s, m_w, g_g, g_e, g_s, g_w) =
