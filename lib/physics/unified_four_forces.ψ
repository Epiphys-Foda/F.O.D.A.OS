let ruft_cos(x) =
    let x2 = gf_mul(x, x)
    let x4 = gf_mul(x2, x2)
    let term0 = 1
    let term2 = gf_div(x2, 2)
    let term4 = gf_div(x4, 24)
    gf_sub(gf_add(term0, term4), term2)

let ruft_sin(x) =
    let x2 = gf_mul(x, x)
    let x3 = gf_mul(x2, x)
    let x5 = gf_mul(x3, x2)
    let term1 = x
    let term3 = gf_div(x3, 6)
    let term5 = gf_div(x5, 120)
    gf_sub(gf_add(term1, term5), term3)

