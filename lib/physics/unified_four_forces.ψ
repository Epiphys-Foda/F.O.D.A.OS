let force_propagate(f1, f2) =
    let z1 = rp_z(f1)
    let z2 = rp_z(f2)
    let r1 = rp_r(f1)
    let r2 = rp_r(f2)
    let n1 = rp_n(f1)
    let n2 = rp_n(f2)
    rp_make(z2, gf_mul(r1, r2), gf_add(n1, n2))

let force_gauge_equiv(f1, f2) =
    let r1 = rp_r(f1)
    let r2 = rp_r(f2)
    let diff = gf_sub(r1, r2)
    let result = 0
    if diff == 0
        result = 1
    result

let force_low_energy(f, scale) =
    let z = rp_z(f)
    let r = rp_r(f)
    let n = rp_n(f)
    let scale_n = gf_pow(scale, n)
    let r_low = gf_div(r, scale_n)
    rp_make(z, r_low, n)

let force_gradient(potential_left, potential_right) =
    let z_l = rp_z(potential_left)
    let z_r = rp_z(potential_right)
    let v_l = rp_r(potential_left)
    let v_r = rp_r(potential_right)
    let grad = gf_div(gf_sub(v_r, v_l), 2)
    rp_make(z_r, grad, 1)

let crt_modulus() = gf_mul(gf_mul(P_GRAVITY, P_EM), gf_mul(P_STRONG, P_WEAK))

let crt_decompose(x) =
    let x_g = x % P_GRAVITY
    let x_e = x % P_EM
    let x_s = x % P_STRONG
    let x_w = x % P_WEAK
    [x_g, x_e, x_s, x_w]

let crt_reconstruct(x_g, x_e, x_s, x_w) =
    let M = 5005
    let term_g = x_g * 1001
    let term_e = x_e * 715
    let term_s = x_s * 455 * 3
    let term_w = x_w * 385 * 5
    let sum = term_g + term_e + term_s + term_w
    sum % M

let four_force_parallel(source, value) =
    let f_g = gravity_residue(source, value, 2)
    let f_e = em_residue(source, value, 1)
    let f_s = strong_residue(source, value, 3)
    let f_w = weak_residue(source, value, 2)
    let r_g = gravity_curvature(f_g)
    let r_e = em_field_strength(f_e)
    let r_s = strong_color(f_s)
    let r_w = weak_charge_val(f_w)
    crt_reconstruct(r_g, r_e, r_s, r_w)

let action_gravity(metric, curvature) =
    let det_g = gf_mul(metric_g00(metric), metric_g11(metric))
    gf_mul(curvature, det_g)

let action_em(field_strength) =
    gf_div(gf_mul(field_strength, field_strength), 2)

let action_strong(color_r, color_g, color_b) =
    let sq_r = gf_mul(color_r, color_r)
    let sq_g = gf_mul(color_g, color_g)
    let sq_b = gf_mul(color_b, color_b)
    gf_add(gf_add(sq_r, sq_g), sq_b)

let action_weak(weak_charge, w_mass) =
    let kinetic = gf_mul(weak_charge, weak_charge)
    let mass_term = gf_mul(gf_mul(w_mass, w_mass), gf_mul(weak_charge, weak_charge))
    gf_add(kinetic, mass_term)

let action_unified(metric, curvature, em_f, color_r, color_g, color_b, weak_q, w_mass) =
    let s_g = action_gravity(metric, curvature)
    let s_e = action_em(em_f)
    let s_s = action_strong(color_r, color_g, color_b)
    let s_w = action_weak(weak_q, w_mass)
    gf_add(gf_add(gf_add(s_g, s_e), s_s), s_w)

