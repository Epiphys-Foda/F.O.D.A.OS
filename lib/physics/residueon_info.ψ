    if c0[0] == 0
        result = result + 1
    if c0[4] == 0
        result = result + 1
    let c1 = hamming_encode_74(0, 0, 0, 1)
    if c1[0] == 1
        result = result + 1
    if c1[4] == 1
        result = result + 1
    if c1[5] == 1
        result = result + 1
    if c1[6] == 0
        result = result + 1
    let c2 = hamming_encode_74(0, 0, 1, 1)
    if c2[4] == 0
        result = result + 1
    if c2[6] == 1
        result = result + 1
    result

let fisher_info(samples, n, mu) =
    let ss = 0
    let i = 0
    for i < n
        let diff = gf_sub(samples[i], mu)
        ss = gf_add(ss, gf_mul(diff, diff))
        i = i + 1
    gf_mul(n, gf_inv(ss))

let fisher_verify() =
    let result = 0
    let fi = fisher_info([2, 4], 2, 3)
    if fi == 1
        result = result + 1
    let fi2 = fisher_info([1, 3, 5], 3, 3)
    if fi2 > 0
        result = result + 1
    let fi3 = fisher_info([2, 4, 6, 8], 4, 5)
    if fi3 > 0
        result = result + 1
    result

let info_pcd(h_before, h_after) =
    let diff = gf_sub(h_after, h_before)
    if diff > 32768
        diff = gf_sub(0, diff)
    diff

let info_rrc(h1, h2, h3) =
    gf_sub(gf_add(h1, h3), gf_mul(2, h2))

let info_pcd_rrc_verify() =
    let result = 0
    let pcd = info_pcd(0, 8)
    if pcd == 8
        result = result + 1
    let pcd0 = info_pcd(4, 4)
    if pcd0 == 0
        result = result + 1
    let rrc0 = info_rrc(2, 4, 6)
    if rrc0 == 0
        result = result + 1
    let rrc1 = info_rrc(0, 2, 8)
    if rrc1 != 0
        result = result + 1
    let rrc2 = info_rrc(0, 1, 8)
    if rrc2 > 0
        result = result + 1
    result

let residueon_info_content(z, r, n) =
    let rp = rp_make(z, r, n)
    let magnitude = gf_add(gf_norm(rp_z(rp)), 1)
    log2_int(magnitude)

let residueon_info_content_verify() =
    let result = 0
    let i0 = residueon_info_content(0, 0, 0)
    if i0 == 0
        result = result + 1
    let i1 = residueon_info_content(1, 0, 0)
    if i1 == 1
        result = result + 1
    let i3 = residueon_info_content(3, 0, 0)
    if i3 == 2
        result = result + 1
    let i7 = residueon_info_content(7, 0, 0)
    if i7 == 3
        result = result + 1
    result

