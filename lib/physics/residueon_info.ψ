let conditional_entropy_verify() =
    let result = 0
    let hxy = entropy_scaled([2, 1, 1], 3, 4)
    let hy = entropy_scaled([2, 1, 1], 3, 4)
    let hxy_given_y = gf_sub(hxy, hy)
    if hxy_given_y == 0
        result = result + 1
    let hxy2 = entropy_scaled([1, 1, 1, 1], 4, 4)
    let hy2 = entropy_scaled([2, 2], 2, 4)
    let hxy_given_y2 = gf_sub(hxy2, hy2)
    if hxy_given_y2 == 4
        result = result + 1
    if hxy_given_y2 >= 0
        result = result + 1
    let hx2 = entropy_scaled([2, 2], 2, 4)
    if hxy_given_y2 <= hx2
        result = result + 1
    result

let kl_div_scaled(p_counts, q_counts, n_cat) =
    let d = 0
    let i = 0
    for i < n_cat
        let pi = p_counts[i]
        let qi = q_counts[i]
        if pi > 0
            if qi > 0
                let log_diff = gf_sub(log2_int(pi), log2_int(qi))
                d = gf_add(d, gf_mul(pi, log_diff))
        i = i + 1
    d

let kl_div_verify() =
    let result = 0
    let d_pp = kl_div_scaled([2, 2], [2, 2], 2)
    if d_pp == 0
        result = result + 1
    let d_pq = kl_div_scaled([4, 2, 1, 1], [2, 2, 2, 2], 4)
    if d_pq >= 0
        result = result + 1
    if d_pq == 2
        result = result + 1
    let d_qp = kl_div_scaled([2, 2, 2, 2], [4, 2, 1, 1], 4)
    if d_qp == 2
        result = result + 1
    let d1 = kl_div_scaled([4, 4], [2, 2], 2)
    if d1 == 8
        result = result + 1
    let d2 = kl_div_scaled([2, 2], [4, 4], 2)
    if d2 == 65533
        result = result + 1
    result

let mutual_info_scaled(hx, hy, hxy) =
    gf_sub(gf_add(hx, hy), hxy)

let mutual_info_verify() =
    let result = 0
    let hx_ind = entropy_scaled([2, 2], 2, 4)
    let hy_ind = entropy_scaled([2, 2], 2, 4)
    let hxy_ind = entropy_scaled([1, 1, 1, 1], 4, 4)
    let mi_ind = mutual_info_scaled(hx_ind, hy_ind, hxy_ind)
    if mi_ind == 0
        result = result + 1
    let hx_corr = entropy_scaled([2, 2], 2, 4)
    let hy_corr = entropy_scaled([2, 2], 2, 4)
    let hxy_corr = entropy_scaled([2, 2], 2, 4)
    let mi_corr = mutual_info_scaled(hx_corr, hy_corr, hxy_corr)
    if mi_corr == 4
        result = result + 1
    let hx_semi = entropy_scaled([2, 2], 2, 4)
    let hy_semi = entropy_scaled([2, 1, 1], 3, 4)
    let hxy_semi = entropy_scaled([2, 1, 1], 3, 4)
    let mi_semi = mutual_info_scaled(hx_semi, hy_semi, hxy_semi)
    if mi_semi == 4
        result = result + 1
    if mi_ind >= 0
        result = result + 1
    if mi_corr >= 0
        result = result + 1
    let h_self = entropy_scaled([2, 1, 1], 3, 4)
    let mi_self = mutual_info_scaled(h_self, h_self, h_self)
    if mi_self == h_self
        result = result + 1
    if mi_corr <= hx_corr
        result = result + 1
    if mi_corr <= hy_corr
        result = result + 1
    result

