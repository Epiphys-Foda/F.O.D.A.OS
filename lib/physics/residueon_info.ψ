let log2_int(n) =
    let result = 0
    let m = n
    for m > 1
        m = m / 2
        result = result + 1
    result

let entropy_scaled(counts, n_cat, total) =
    let n_log_n = 0
    let i = 0
    for i < n_cat
        let ni = counts[i]
        if ni > 0
            n_log_n = n_log_n + gf_mul(ni, log2_int(ni))
        i = i + 1
    let total_log = gf_mul(total, log2_int(total))
    gf_sub(total_log, n_log_n)

let entropy_verify() =
    let result = 0
    let h2 = entropy_scaled([1, 1], 2, 2)
    if h2 == 2
        result = result + 1
    let h4 = entropy_scaled([1, 1, 1, 1], 4, 4)
    if h4 == 8
        result = result + 1
    let h8 = entropy_scaled([1, 1, 1, 1, 1, 1, 1, 1], 8, 8)
    if h8 == 24
        result = result + 1
    let h22 = entropy_scaled([2, 2], 2, 4)
    if h22 == 4
        result = result + 1
    let h211 = entropy_scaled([2, 1, 1], 3, 4)
    if h211 == 6
        result = result + 1
    let h44 = entropy_scaled([4, 4], 2, 8)
    if h44 == 8
        result = result + 1
    let h422 = entropy_scaled([4, 2, 2], 3, 8)
    if h422 == 12
        result = result + 1
    let h41111 = entropy_scaled([4, 1, 1, 1, 1], 5, 8)
    if h41111 == 16
        result = result + 1
    result

