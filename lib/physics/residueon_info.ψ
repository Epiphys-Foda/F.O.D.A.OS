let hamming_distance(x, y, n) =
    let d = 0
    let i = 0
    for i < n
        if x[i] != y[i]
            d = d + 1
        i = i + 1
    d

let hamming_verify() =
    let result = 0
    let d_self = hamming_distance([1, 0, 1, 0], [1, 0, 1, 0], 4)
    if d_self == 0
        result = result + 1
    let d1 = hamming_distance([1, 0, 1, 0], [1, 0, 1, 1], 4)
    if d1 == 1
        result = result + 1
    let d2 = hamming_distance([1, 0, 1, 0], [0, 0, 1, 1], 4)
    if d2 == 2
        result = result + 1
    let d4 = hamming_distance([1, 0, 1, 0], [0, 1, 0, 1], 4)
    if d4 == 4
        result = result + 1
    let d_xy = hamming_distance([1, 0, 1, 1], [0, 1, 1, 0], 4)
    let d_yx = hamming_distance([0, 1, 1, 0], [1, 0, 1, 1], 4)
    if d_xy == d_yx
        result = result + 1
    let d_xz = hamming_distance([1, 0, 1, 0], [0, 1, 0, 1], 4)
    let d_xy2 = hamming_distance([1, 0, 1, 0], [1, 1, 0, 1], 4)
    let d_yz = hamming_distance([1, 1, 0, 1], [0, 1, 0, 1], 4)
    if d_xz <= d_xy2 + d_yz
        result = result + 1
    result

let hamming_encode_74(d3, d2, d1, d0) =
    let c0 = d0
    let c1 = d1
    let c2 = d2
    let c3 = d3
    let c4 = (d0 + d1) % 2
    let c5 = (d0 + d2) % 2
    let c6 = (d1 + d2) % 2
    [c0, c1, c2, c3, c4, c5, c6]

let hamming_code_verify() =
    let result = 0
