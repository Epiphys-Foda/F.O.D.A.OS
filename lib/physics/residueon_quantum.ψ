let hopf_algebra_verify() =
    let result = 0
    if gf_add(gf_add(2, 1), 1) == 4
        result = result + 1
    if gf_add(gf_mul(0, 1), gf_mul(1, 2)) == 2
        result = result + 1
    if gf_add(gf_mul(gf_neg(2), 1), gf_mul(1, 2)) == 0
        result = result + 1
    result

let yang_baxter_verify() =
    let result = 0
    if gf_mul(gf_mul(2, 2), 2) == 8
        result = result + 1
    if gf_mul(2, 2) == 4
        result = result + 1
    if gf_mul(gf_mul(gf_mul(2, 2), 2), gf_mul(gf_mul(2, 2), 2)) == 64
        result = result + 1
    result

let q_number_verify() =
    let result = 0
    if gf_div(2, 2) == 1
        result = result + 1
    if gf_add(1, 1) == 2
        result = result + 1
    if gf_div(gf_sub(1, 1), gf_sub(2, gf_inv(2))) == 0
        result = result + 1
    result

let drinfeld_jimbo_verify() =
    let result = 0
    if gf_mul(2, gf_inv(2)) == 1
        result = result + 1
    if gf_mul(2, 3) == gf_mul(3, 2)
        result = result + 1
    if gf_mul(gf_mul(2, 3), gf_mul(gf_inv(2), gf_inv(3))) == 1
        result = result + 1
    result

let quantum_determinant_verify() =
    let result = 0
    if gf_sub(gf_mul(1, 1), gf_mul(0, 0)) == 1
        result = result + 1
    if gf_sub(gf_mul(2, 3), gf_mul(1, 5)) == 1
        result = result + 1
    if gf_mul(gf_neg(1), gf_neg(1)) == 1
        result = result + 1
    result

let quantum_sl2_verify() =
    let result = 0
    if gf_mul(2, 3) == gf_mul(3, 2)
