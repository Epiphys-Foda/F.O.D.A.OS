let dag_to_field(nodes_op, nodes_data, n, out_p, out_r) =
    let i = 0
    for i < n
        let base = (nodes_op[i] == 0 ? 127 : (nodes_op[i] == 1 ? 101 : (nodes_op[i] == 2 ? 103 : (nodes_op[i] == 3 ? 107 : (nodes_op[i] == 4 ? 109 : (nodes_op[i] == 5 ? 113 : 127))))))
        out_p[i] = base + i * 1000
        out_r[i] = nodes_data[i]
        i = i + 1
    n

let compose_chain(all_poles, all_residues, n_nodes, node_size, out_p, out_r) =
    let cur_p = arr_new_n(n_nodes * node_size)
    let cur_r = arr_new_n(n_nodes * node_size)
    let cur_n = node_size
    let i = 0
    for i < node_size
        cur_p[i] = all_poles[i]
        cur_r[i] = all_residues[i]
        i = i + 1
    let node_idx = 1
    for node_idx < n_nodes
        let next_p = arr_new_n(node_size)
        let next_r = arr_new_n(node_size)
        let offset = node_idx * node_size
        let j = 0
        for j < node_size
            next_p[j] = all_poles[offset + j]
            next_r[j] = all_residues[offset + j]
            j = j + 1
        let tmp_p = arr_new_n(cur_n)
        let tmp_r = arr_new_n(cur_n)
        let new_n = field_compose(cur_p, cur_r, cur_n, next_p, next_r, node_size, tmp_p, tmp_r)
        let k = 0
        for k < new_n
            cur_p[k] = tmp_p[k]
            cur_r[k] = tmp_r[k]
            k = k + 1
        cur_n = new_n
        node_idx = node_idx + 1
    let m = 0
    for m < cur_n
        out_p[m] = cur_p[m]
        out_r[m] = cur_r[m]
        m = m + 1
    cur_n

