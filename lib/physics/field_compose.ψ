let field_compose(p1, r1, n1, p2, r2, n2, out_p, out_r) =
    let k = 0
    let i = 0
    for i < n1
        let collision_r = 0
        let j = 0
        for j < n2
            let diff = (p1[i] + 65537 - p2[j]) % 65537
            let cross = r1[i] * r2[j] * gf_inv(diff)
            collision_r = gf_add(collision_r, cross)
            j = j + 1
        out_p[k] = p1[i]
        out_r[k] = collision_r
        k = k + 1
        i = i + 1
    k

let field_merge(p1, r1, n1, p2, r2, n2, out_p, out_r) =
    let k = 0
    let i = 0
    for i < n1
        out_p[k] = p1[i]
        out_r[k] = r1[i]
        k = k + 1
        i = i + 1
    let j = 0
    for j < n2
        out_p[k] = p2[j]
        out_r[k] = r2[j]
        k = k + 1
        j = j + 1
    k

