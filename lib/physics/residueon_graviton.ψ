import "residueon_common.ψ"

let gw_make(position, amplitude, frequency) = rp_make(position, amplitude, frequency)

let gw_amplitude(gw) = rp_r(gw)

let gw_frequency(gw) = rp_n(gw)

let gw_position(gw) = rp_z(gw)

let gw_strain(gw) = gf_div(gw_amplitude(gw), 2)

let gw_energy(gw) =
    let h = gw_amplitude(gw)
    let f = gw_frequency(gw)
    gf_mul(gf_mul(h, h), gf_mul(f, f))

let gw_plus_polarization(gw) =
    let a = gw_amplitude(gw)
    let f = gw_frequency(gw)
    rp_make(gw_position(gw), a, f)

let gw_cross_polarization(gw) =
    let a = gw_amplitude(gw)
    let f = gw_frequency(gw)
    rp_make(gw_position(gw), gf_neg(a), f)

let gw_polarization_orthogonal_verify(gw) =
    let hp = gw_plus_polarization(gw)
    let hx = gw_cross_polarization(gw)
    let inner = gf_mul(gw_amplitude(hp), gw_amplitude(hx))
    let result = 0
    if inner >= 0
        result = 1
    result

let LIGO_ARM_LENGTH() = 4

let interferometer_arm1(gw) =
    let L = LIGO_ARM_LENGTH()
    let h = gw_amplitude(gw)
    let delta_L = gf_div(gf_mul(h, L), 2)
    gf_add(L, delta_L)

let interferometer_arm2(gw) =
    let L = LIGO_ARM_LENGTH()
    let h = gw_amplitude(gw)
    let delta_L = gf_div(gf_mul(h, L), 2)
    gf_sub(L, delta_L)

let interferometer_signal(gw) =
    let l1 = interferometer_arm1(gw)
    let l2 = interferometer_arm2(gw)
    let diff = gf_sub(l1, l2)
    let L = LIGO_ARM_LENGTH()
    gf_div(gf_mul(diff, diff), gf_mul(L, L))

let interferometer_verify(gw) =
    let signal = interferometer_signal(gw)
    let h = gw_amplitude(gw)
    let h_squared = gf_mul(h, h)
    let result = 0
    if signal == h_squared
        result = 1
    result

let pcd_detect(gw1, gw2) =
    let n1 = gw_frequency(gw1)
    let n2 = gw_frequency(gw2)
    let phase_jump = gf_sub(n1, n2)
    phase_jump

let pcd_vortex_detect(gw1, gw2) =
    let jump = pcd_detect(gw1, gw2)
    let result = 0
    if jump != 0
        result = 1
    result

let pcd_consistency_detect(gw_array, n) =
    let count = 0
    let i = 1
    for i < n
        let prev = gw_array[i - 1]
        let curr = gw_array[i]
        if pcd_vortex_detect(prev, curr) == 1
            count = count + 1
        i = i + 1
    count

let pcd_no_wave_verify() =
    let gw1 = gw_make(0, 0, 1)
    let gw2 = gw_make(1, 0, 1)
    let result = 0
    if pcd_vortex_detect(gw1, gw2) == 0
        result = 1
    result

let pcd_with_wave_verify() =
    let gw1 = gw_make(0, 2, 1)
    let gw2 = gw_make(1, 2, 3)
    let result = 0
    if pcd_vortex_detect(gw1, gw2) == 1
        result = 1
    result

let rrc_curvature(gw1, gw2, gw3) =
    let r1 = gw_amplitude(gw1)
    let r2 = gw_amplitude(gw2)
    let r3 = gw_amplitude(gw3)
    gf_sub(gf_add(r1, r3), gf_mul(2, r2))

let rrc_ripple_detect(gw1, gw2, gw3) =
    let curvature = rrc_curvature(gw1, gw2, gw3)
    let result = 0
    if curvature != 0
        result = 1
    result

let rrc_topology_class(gw1, gw2, gw3) =
    let curvature = rrc_curvature(gw1, gw2, gw3)
    let result = 0
    if curvature > 0
        result = 1
    if curvature < 0
        result = 2
    result

let rrc_flat_verify() =
    let gw1 = gw_make(0, 3, 1)
    let gw2 = gw_make(1, 3, 1)
    let gw3 = gw_make(2, 3, 1)
    let result = 0
    if rrc_ripple_detect(gw1, gw2, gw3) == 0
        result = 1
    result

let rrc_curved_verify() =
    let gw1 = gw_make(0, 1, 1)
    let gw2 = gw_make(1, 2, 1)
    let gw3 = gw_make(2, 5, 1)
    let result = 0
    if rrc_ripple_detect(gw1, gw2, gw3) == 1
        result = 1
    result

let gw_template_bbh() =
    let phase1 = gw_make(0, 1, 1)
    let phase2 = gw_make(1, 3, 2)
    let phase3 = gw_make(2, 2, 1)
    rpf_make([phase1, phase2, phase3], 3)

let gw_template_bns() =
    let phase1 = gw_make(0, 1, 1)
    let phase2 = gw_make(1, 1, 3)
    let phase3 = gw_make(2, 1, 1)
    rpf_make([phase1, phase2, phase3], 3)

let matched_filter(signal_field, template_field) =
    let n1 = rpf_count(signal_field)
    let n2 = rpf_count(template_field)
    let s_primes = rpf_primes(signal_field)
    let t_primes = rpf_primes(template_field)
    let inner = 0
    let i = 0
    for i < n1
        if i < n2
            let s = s_primes[i]
            let t = t_primes[i]
            inner = gf_add(inner, gf_mul(gw_amplitude(s), gw_amplitude(t)))
        i = i + 1
    inner

let snr(signal_field, template_field) =
    let inner = matched_filter(signal_field, template_field)
    let n = rpf_count(template_field)
    let t_primes = rpf_primes(template_field)
    let norm_sq = 0
    let i = 0
    for i < n
        let t = t_primes[i]
        let a = gw_amplitude(t)
        norm_sq = gf_add(norm_sq, gf_mul(a, a))
        i = i + 1
    gf_div(inner, norm_sq)

let template_match_verify() =
    let template = gw_template_bbh()
    let snr_val = snr(template, template)
    let result = 0
    if snr_val >= 0
        result = 1
    result

let minkowski_metric(mu, nu) =
    let result = 0
    if mu == 0
        if nu == 0
    if mu == 1
        if nu == 1
    if mu == 2
        if nu == 2
    if mu == 3
        if nu == 3
    result

let perturbed_metric(mu, nu, gw) =
    let eta = minkowski_metric(mu, nu)
    let h = 0
    if mu == 1
        if nu == 1
    if mu == 2
        if nu == 2
    gf_add(eta, h)

let metric_no_perturbation_verify() =
    let gw = gw_make(0, 0, 1)
    let g11 = perturbed_metric(1, 1, gw)
    let eta11 = minkowski_metric(1, 1)
    let result = 0
    if g11 == eta11
        result = 1
    result

let metric_with_perturbation_verify() =
    let gw = gw_make(0, 2, 1)
    let g11 = perturbed_metric(1, 1, gw)
    let result = 0
    if g11 == gf_add(1, 2)
        result = 1
    result

let metric_trace_verify() =
    let gw = gw_make(0, 0, 1)
    let trace = gf_add(gf_add(perturbed_metric(0, 0, gw), perturbed_metric(1, 1, gw)), gf_add(perturbed_metric(2, 2, gw), perturbed_metric(3, 3, gw)))
    let result = 0
    if trace == 2
        result = 1
    result

let gw_propagate(gw, step) =
    let z = gw_position(gw)
    let r = gw_amplitude(gw)
    let n = gw_frequency(gw)
    rp_make(gf_add(z, step), r, n)

let gw_propagation_verify() =
    let gw = gw_make(0, 2, 1)
    let gw1 = gw_propagate(gw, 1)
    let gw2 = gw_propagate(gw1, 1)
    let result = 0
    if gw_position(gw2) == 2
        result = 1
    result

let gw_superpose(gw1, gw2) =
    let z = gw_position(gw1)
    let r = gf_add(gw_amplitude(gw1), gw_amplitude(gw2))
    let n = gf_add(gw_frequency(gw1), gw_frequency(gw2))
    rp_make(z, r, n)

let gw_superposition_verify() =
    let gw1 = gw_make(0, 2, 1)
    let gw2 = gw_make(0, 3, 2)
    let s12 = gw_superpose(gw1, gw2)
    let s21 = gw_superpose(gw2, gw1)
    let result = 0
    if gw_amplitude(s12) == gw_amplitude(s21)
        result = 1
    result

let residueon_graviton_verify() =
    let ok = 0

    let gw = gw_make(5, 2, 3)

    if gw_amplitude(gw) == 2
        ok = ok + 1
    if gw_frequency(gw) == 3
        ok = ok + 1
    if gw_position(gw) == 5
        ok = ok + 1

    if gw_strain(gw) == 1
        ok = ok + 1

    if gw_energy(gw) == gf_mul(gf_mul(2, 2), gf_mul(3, 3))
        ok = ok + 1

    if gw_polarization_orthogonal_verify(gw) == 1
        ok = ok + 1

    let hp = gw_plus_polarization(gw)
    if gw_amplitude(hp) == 2
        ok = ok + 1

    let hx = gw_cross_polarization(gw)
    if gw_amplitude(hx) == gf_neg(2)
        ok = ok + 1

    if interferometer_verify(gw) == 1
        ok = ok + 1

    let arm1 = interferometer_arm1(gw)
    let arm2 = interferometer_arm2(gw)
    if arm1 >= 0
        ok = ok + 1
    if arm2 >= 0
        ok = ok + 1

    let signal = interferometer_signal(gw)
    if signal == gf_mul(2, 2)
        ok = ok + 1

    if LIGO_ARM_LENGTH() == 4
        ok = ok + 1

    if pcd_no_wave_verify() == 1
        ok = ok + 1
    if pcd_with_wave_verify() == 1
        ok = ok + 1

    let gw1 = gw_make(0, 2, 1)
    let gw2 = gw_make(1, 2, 3)
    if pcd_detect(gw1, gw2) == gf_sub(1, 3)
        ok = ok + 1
    if pcd_vortex_detect(gw1, gw2) == 1
        ok = ok + 1

    let gw_array = [gw_make(0, 2, 1), gw_make(1, 2, 3), gw_make(2, 2, 5)]
    let pcd_count = pcd_consistency_detect(gw_array, 3)
    if pcd_count == 2
        ok = ok + 1

    if rrc_flat_verify() == 1
        ok = ok + 1
    if rrc_curved_verify() == 1
        ok = ok + 1

    let gw_a = gw_make(0, 1, 1)
    let gw_b = gw_make(1, 2, 1)
    let gw_c = gw_make(2, 5, 1)
    if rrc_curvature(gw_a, gw_b, gw_c) == 2
        ok = ok + 1
    if rrc_ripple_detect(gw_a, gw_b, gw_c) == 1
        ok = ok + 1

    let topo = rrc_topology_class(gw_a, gw_b, gw_c)
    if topo >= 1
        ok = ok + 1

    if template_match_verify() == 1
        ok = ok + 1

    let bbh_template = gw_template_bbh()
    if rpf_count(bbh_template) == 3
        ok = ok + 1

    let bns_template = gw_template_bns()
    if rpf_count(bns_template) == 3
        ok = ok + 1

    let mf_val = matched_filter(bbh_template, bbh_template)
    if mf_val >= 0
        ok = ok + 1

    let snr_val = snr(bbh_template, bbh_template)
    if snr_val >= 0
        ok = ok + 1

    if metric_no_perturbation_verify() == 1
        ok = ok + 1
    if metric_with_perturbation_verify() == 1
        ok = ok + 1
    if metric_trace_verify() == 1
        ok = ok + 1

    if minkowski_metric(0, 0) == gf_neg(1)
        ok = ok + 1
    if minkowski_metric(1, 1) == 1
        ok = ok + 1
    if minkowski_metric(0, 1) == 0
        ok = ok + 1

    let g11 = perturbed_metric(1, 1, gw)
    if g11 == gf_add(1, 2)
        ok = ok + 1

    if gw_propagation_verify() == 1
        ok = ok + 1
    if gw_superposition_verify() == 1
        ok = ok + 1

    let gw_prop = gw_make(0, 2, 1)
    let gw_step1 = gw_propagate(gw_prop, 1)
    if gw_position(gw_step1) == 1
        ok = ok + 1

    let gw_s1 = gw_make(0, 2, 1)
    let gw_s2 = gw_make(0, 3, 2)
    let gw_sum = gw_superpose(gw_s1, gw_s2)
    if gw_amplitude(gw_sum) == 5
        ok = ok + 1
    if gw_frequency(gw_sum) == 3
        ok = ok + 1

    let field = rpf_make([gw1, gw2, gw_a], 3)
    let hom = rpf_homology(field)
    if hom[0] == 3
        ok = ok + 1

    let mutated = rpf_galois(field, 2)
    if rpf_count(mutated) == 3
        ok = ok + 1

    if ast_to_op(AST_LITERAL()) == OP_OBSERVE()
        ok = ok + 1

    let f = mf_make([0, 1], [3, 5], 2)
    let fI = combinator_I(f)
    if mf_equal(fI, f) == 1
        ok = ok + 1

    if bootstrap_tower(8) == 1
        ok = ok + 1

    let apop = apoptosis(f)
    if mf_size(apop) >= 0
        ok = ok + 1

    let mc = meta_compiler()
    if mf_size(mc) == 6
        ok = ok + 1

    if gw_amplitude(gw) == 2
        ok = ok + 1

    if pcd_with_wave_verify() == 1
        ok = ok + 1

    if gw_energy(gw) >= 0
        ok = ok + 1

    if gw_strain(gw) == 1
        ok = ok + 1

    if rrc_curved_verify() == 1
        ok = ok + 1

    if gw_frequency(gw) == 3
        ok = ok + 1

    if gw_position(gw) == 5
        ok = ok + 1

    if interferometer_verify(gw) == 1
        ok = ok + 1

    if gw_propagation_verify() == 1
        ok = ok + 1

    if template_match_verify() == 1
        ok = ok + 1

    ok

let main() = residueon_graviton_verify()
