import "residueon_common.ψ"

let affine_map(x, a, b) =
    gf_add(gf_mul(a, x), b)

let affine_fixed_point(a, b) =
    let one_minus_a = gf_sub(1, a)
    gf_div(b, one_minus_a)

let fixed_point_verify() =
    let result = 0
    let fp1 = affine_fixed_point(2, 3)
    if affine_map(fp1, 2, 3) == fp1
        result = result + 1
    let fp2 = affine_fixed_point(3, 1)
    if affine_map(fp2, 3, 1) == fp2
        result = result + 1
    if affine_map(5, 1, 0) == 5
        result = result + 1
    if affine_map(7, 1, 0) == 7
        result = result + 1
    let fp3 = affine_fixed_point(0, 5)
    if fp3 == 5
        result = result + 1
    if affine_map(5, 0, 5) == 5
        result = result + 1
    result

let gf_abs(x) = (x > 32768) ? gf_sub(0, x) : x

let stability_verify() =
    let result = 0
    if gf_abs(2) > 1
        result = result + 1
    if gf_abs(65536) == 1
        result = result + 1
    if gf_abs(0) < 1
        result = result + 1
    if gf_abs(65535) == 2
        result = result + 1
    if gf_abs(1) == 1
        result = result + 1
    let x = 100
    let i = 0
    for i < 10
        x = affine_map(x, 0, 5)
        i = i + 1
    if x == 5
        result = result + 1
    result

let logistic_map(x, r) =
    let rx = gf_mul(r, x)
    let rxx = gf_mul(rx, x)
    gf_sub(rx, rxx)

let bifurcation_verify() =
    let result = 0
    if logistic_map(5, 0) == 0
        result = result + 1
    if logistic_map(100, 0) == 0
        result = result + 1
    if logistic_map(0, 1) == 0
        result = result + 1
    if logistic_map(0, 2) == 0
        result = result + 1
    if logistic_map(0, 3) == 0
        result = result + 1
    if logistic_map(0, 5) == 0
        result = result + 1
    if logistic_map(7, 0) == 0
        result = result + 1
    result

let lyapunov_affine(a, n_iter) =
    let abs_a = gf_abs(a)
    let total = 0
    let i = 0
    for i < n_iter
        total = gf_add(total, abs_a)
        i = i + 1
    total

let lyapunov_verify() =
    let result = 0
    let l0 = lyapunov_affine(0, 10)
    if l0 == 0
        result = result + 1
    let l1 = lyapunov_affine(1, 10)
    if l1 == 10
        result = result + 1
    let l2 = lyapunov_affine(2, 10)
    if l2 == 20
        result = result + 1
    let l_neg = lyapunov_affine(65536, 10)
    if l_neg == 10
        result = result + 1
    let l_neg2 = lyapunov_affine(65535, 10)
    if l_neg2 == 20
        result = result + 1
    result

let affine_iterate(x, a, b, n) =
    let xn = x
    let i = 0
    for i < n
        xn = affine_map(xn, a, b)
        i = i + 1
    xn

let periodic_orbit_verify() =
    let result = 0
    if affine_iterate(5, 1, 0, 10) == 5
        result = result + 1
    if affine_iterate(7, 1, 0, 100) == 7
        result = result + 1
    let x1 = affine_iterate(5, 65536, 0, 2)
    if x1 == 5
        result = result + 1
    if affine_iterate(100, 0, 5, 1) == 5
        result = result + 1
    if affine_iterate(100, 0, 5, 10) == 5
        result = result + 1
    let x2 = affine_iterate(1, 2, 0, 32)
    if x2 == 1
        result = result + 1
    result

let symplectic_check(a, b, c, d) =
    let det = gf_sub(gf_mul(a, d), gf_mul(b, c))
    let result = 0
    if det == 1
        result = 1
    result

let hamiltonian_verify() =
    let result = 0
    if symplectic_check(1, 0, 0, 1) == 1
        result = result + 1
    if symplectic_check(0, 65536, 1, 0) == 1
        result = result + 1
    if symplectic_check(1, 3, 0, 1) == 1
        result = result + 1
    if symplectic_check(1, 5, 0, 1) == 1
        result = result + 1
    if symplectic_check(1, 0, 3, 1) == 1
        result = result + 1
    if symplectic_check(2, 0, 0, 1) == 0
        result = result + 1
    result

let arnold_cat(x, y, n) =
    let new_x = (gf_add(gf_mul(2, x), y)) % n
    let new_y = (gf_add(x, y)) % n
    [new_x, new_y]

let arnold_verify() =
    let result = 0
    if symplectic_check(2, 1, 1, 1) == 1
        result = result + 1
    let p0 = arnold_cat(0, 0, 8)
    if p0[0] == 0
        result = result + 1
    if p0[1] == 0
        result = result + 1
    let p1 = arnold_cat(1, 0, 8)
    if p1[0] == 2
        result = result + 1
    if p1[1] == 1
        result = result + 1
    let p2 = arnold_cat(1, 1, 8)
    if p2[0] == 3
        result = result + 1
    if p2[1] == 2
        result = result + 1
    if symplectic_check(2, 1, 1, 1) == 1
        result = result + 1
    result

let attractor_verify() =
    let result = 0
    let x = 100
    let x1 = affine_map(x, 0, 3)
    if x1 == 3
        result = result + 1
    let x2 = affine_map(x1, 0, 3)
    if x2 == 3
        result = result + 1
    let y = 4
    let y1 = affine_map(y, 32769, 0)
    if y1 == 2
        result = result + 1
    let y2 = affine_map(y1, 32769, 0)
    if y2 == 1
        result = result + 1
    result

let dyn_pcd(x_before, x_after) =
    let diff = gf_sub(x_after, x_before)
    gf_abs(diff)

let dyn_rrc(x1, x2, x3) =
    gf_sub(gf_add(x1, x3), gf_mul(2, x2))

let dyn_pcd_rrc_verify() =
    let result = 0
    let pcd = dyn_pcd(100, 3)
    if pcd == 97
        result = result + 1
    let pcd0 = dyn_pcd(5, 5)
    if pcd0 == 0
        result = result + 1
    let rrc0 = dyn_rrc(1, 2, 3)
    if rrc0 == 0
        result = result + 1
    let rrc1 = dyn_rrc(0, 1, 4)
    if rrc1 != 0
        result = result + 1
    let rrc2 = dyn_rrc(4, 2, 1)
    if rrc2 != 0
        result = result + 1
    result

let residueon_dynamics_verify() =
    let result = 0
    let rp = rp_make(3, 5, 2)
    let evolved = rp_galois(rp, 2)
    if rp_z(evolved) == 9
        result = result + 1
    let evolved2 = rp_galois(evolved, 2)
    if rp_z(evolved2) == 81
        result = result + 1
    let zero = rp_make(0, 0, 0)
    let zero_evolved = rp_galois(zero, 2)
    if rp_z(zero_evolved) == 0
        result = result + 1
    let one = rp_make(1, 0, 0)
    let one_evolved = rp_galois(one, 2)
    if rp_z(one_evolved) == 1
        result = result + 1
    result

let residueon_dynamics_full_verify() =
    let ok = 0

    if fixed_point_verify() == 6
        ok = ok + 1

    if stability_verify() == 6
        ok = ok + 1

    if bifurcation_verify() == 7
        ok = ok + 1

    if lyapunov_verify() == 5
        ok = ok + 1

    if periodic_orbit_verify() == 6
        ok = ok + 1

    if hamiltonian_verify() == 6
        ok = ok + 1

    if arnold_verify() == 8
        ok = ok + 1

    if attractor_verify() == 4
        ok = ok + 1
    if dyn_pcd_rrc_verify() == 5
        ok = ok + 1

    if residueon_dynamics_verify() == 4
        ok = ok + 1

    ok = ok + cross_domain_base()

    if affine_iterate(5, 1, 0, 10) == 5
        ok = ok + 1

    if symplectic_check(1, 0, 0, 1) == 1
        ok = ok + 1

    if symplectic_check(2, 1, 1, 1) == 1
        ok = ok + 1

    if affine_map(5, 1, 0) == 5
        ok = ok + 1

    if affine_iterate(5, 65536, 0, 2) == 5
        ok = ok + 1

    if lyapunov_affine(0, 10) == 0
        ok = ok + 1

    if affine_map(0, 2, 3) == 3
        ok = ok + 1

    if symplectic_check(0, 65536, 1, 0) == 1
        ok = ok + 1

    if lyapunov_affine(1, 10) == 10
        ok = ok + 1

    if affine_map(100, 0, 3) == 3
        ok = ok + 1

    if affine_map(5, 0, 5) == 5
        ok = ok + 1

    if gf_abs(0) < 1
        ok = ok + 1

    let arnold_p = arnold_cat(1, 0, 8)
    if arnold_p[0] == 2
        ok = ok + 1

    if lyapunov_affine(2, 10) == 20
        ok = ok + 1

    if symplectic_check(2, 1, 1, 1) == 1
        ok = ok + 1

    if symplectic_check(1, 3, 0, 1) == 1
        ok = ok + 1

    if symplectic_check(1, 0, 0, 1) == 1
        ok = ok + 1

    if logistic_map(0, 2) == 0
        ok = ok + 1

    if affine_iterate(7, 1, 0, 100) == 7
        ok = ok + 1

    if affine_map(100, 0, 5) == 5
        ok = ok + 1

    if affine_iterate(1, 2, 0, 32) == 1
        ok = ok + 1

    if lyapunov_affine(65536, 10) == 10
        ok = ok + 1

    if affine_map(0, 0, 5) == 5
        ok = ok + 1

    if affine_iterate(5, 1, 0, 1) == 5
        ok = ok + 1

    ok

let main() = residueon_dynamics_full_verify()
