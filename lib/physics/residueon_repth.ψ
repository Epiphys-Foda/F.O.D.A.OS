let group_rep_verify() =
    let result = 0
    if gf_mul(1, 1) == 1
        result = result + 1
    if gf_mul(65536, 65536) == 1
        result = result + 1
    if gf_div(1, 65536) == 65536
        result = result + 1
    if gf_add(1, 0) == 1
        result = result + 1
    result

let cyclic_rep_verify() =
    let result = 0
    let rho0 = 1
    if rho0 == 1
        result = result + 1
    let rho1 = 65536
    if rho1 == 65536
        result = result + 1
    if gf_mul(rho1, rho1) == 1
        result = result + 1
    result

let character_verify() =
    let result = 0
    if gf_mul(2, 1) == 2
        result = result + 1
    if gf_add(1, 1) == 2
        result = result + 1
    let chi_std_123 = 65536
    if chi_std_123 == 65536
        result = result + 1
    result

let orthogonality_verify() =
    let result = 0
    if gf_add(1, 1) == 2
        result = result + 1
    if gf_add(1, 65536) == 0
        result = result + 1
    if gf_add(1, gf_mul(65536, 65536)) == 2
        result = result + 1
    result

let s3_rep_verify() =
    let result = 0
    if gf_add(gf_add(1, 1), 4) == 6
        result = result + 1
    let std_norm = gf_add(gf_add(gf_mul(1, 4), gf_mul(3, 0)), gf_mul(2, 1))
    if gf_div(std_norm, 6) == 1
        result = result + 1
    let triv_std = gf_add(gf_add(gf_mul(1, 2), gf_mul(3, 0)), gf_mul(2, 65536))
    if triv_std == 0
        result = result + 1
    result

let schur_verify() =
    let result = 0
