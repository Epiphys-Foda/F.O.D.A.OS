let field_new(poles, res, n) = mf_make(poles, res, n)
let field_add(f1, f2) = mf_add(f1, f2)
let field_mul(f1, f2) = mf_mul(f1, f2)
let field_compose(f1, f2) = mf_compose(f1, f2)
let field_fingerprint(f) = mf_fingerprint(f)
let field_equal(f1, f2) = mf_equal(f1, f2)

let meta_observe(f) = g0_apply(OP_OBSERVE())
let meta_galois(f, sigma) = galois_mutate(f, sigma)
let meta_homology(f) = homology_compute(f)
let meta_compile(f) = g0_apply(OP_COMPILE())
let meta_self_verify(f) = g0_apply(OP_SELF_VERIFY())
let meta_meta_observe(f) = g0_apply(OP_META_OBSERVE())

let comb_I(f) = combinator_I(f)
let comb_K(p, r, n) = combinator_K(p, r, n)
let comb_B(f, g, h) = combinator_B(f, g, h)
let comb_C(f, g) = combinator_C(f, g)
let comb_S(f, g, h) = combinator_S(f, g, h)
let comb_Y(f, n) = combinator_Y(f, n)

let kleene_fp_scalar(init, tf, max_iter) = kleene_fp(init, tf, max_iter)
let kleene_fp_field(f, max_iter) = kleene_mf_fp(f, max_iter)

let topology_homology(f) = homology_compute(f)
let topology_cancer(f) = homology_cancer_check(f)
let topology_apoptosis(f) = apoptosis(f)

let ast_map(node_type, node_value) = ast_to_op(node_type)
let ast_compile(types, values, n) = ast_to_meta_field(types, values, n)

let plugin_init(spec_poles, spec_res, n) = field_new(spec_poles, spec_res, n)
let plugin_step(sys, state, sigma) = meta_galois(state, sigma)

let crypto_key_exchange(g, a, b) =
    let A = gf_pow(g, a)
    let B = gf_pow(g, b)
    let s_a = gf_pow(B, a)
    let s_b = gf_pow(A, b)
    [s_a, s_b]

let flow_simulate(initial, steps, sigma) =
    let current = initial
    let i = 0
    for i < steps
        current = meta_galois(current, sigma)
        i = i + 1
    current

let logic_converge(f, max_iter) = kleene_fp_field(f, max_iter)

let user_load_plugin(name_poles, name_res, n) = plugin_init(name_poles, name_res, n)
let user_connect(basin_a, basin_b) = field_compose(basin_a, basin_b)
let user_observe(basin) = field_fingerprint(basin)

