let bootstrap_compile() =
    let src = compiler_self_source()
    let n = compiler_self_len()
    compile(src, n)

let bootstrap_compile2() =
    let compiled = bootstrap_compile()
    let n = rpf_count(compiled)
    let primes = rpf_primes(compiled)
    let src2 = primes
    let i = 0
    for i < n
        let rp = primes[i]
        src2[i] = rp_r(rp)
        i = i + 1
    compile(src2, n)

let project_compile(source, n) =
    let compiled = compile(source, n)
    let cn = rpf_count(compiled)
    let primes = rpf_primes(compiled)
    let src2 = primes
    let i = 0
    for i < cn
        let rp = primes[i]
        src2[i] = rp_r(rp)
        i = i + 1
    compile(src2, cn)

let idempotent_verify(source, n) =
    let p1 = compile(source, n)
    let p2 = project_compile(source, n)
    let cnt1 = rpf_count(p1)
    let cnt2 = rpf_count(p2)
    let hom1 = rpf_homology(p1)
    let hom2 = rpf_homology(p2)
    let result = 0
    if cnt1 == cnt2
        if hom1[0] == hom2[0]
    result

let galois_commute_verify(source, n, sigma) =
    let compiled = compile(source, n)
    let left = rpf_galois(compiled, sigma)
    let gsource = source
    let i = 0
    for i < n
        let code = source[i]
        gsource[i] = gf_pow(code, sigma)
        i = i + 1
    let right = compile(gsource, n)
    let result = 0
    if rpf_count(left) == rpf_count(right)
        result = 1
    result

let compiler_dna() =
    let src = compiler_self_source()
    let n = compiler_self_len()
    let token_field = lex(src, n)
    token_field

let compiler_mutate(sigma) =
    let dna = compiler_dna()
    rpf_galois(dna, sigma)

let compiler_fitness(sigma) =
    let mutated = compiler_mutate(sigma)
    let n = rpf_count(mutated)
    let primes = rpf_primes(mutated)
    let src = primes
    let i = 0
    for i < n
        let rp = primes[i]
        src[i] = rp_r(rp)
        i = i + 1
    let compiled = compile(src, n)
    let fp = rpf_fingerprint(compiled)
    let result = 0
    if fp >= 0
        result = 1
    result

