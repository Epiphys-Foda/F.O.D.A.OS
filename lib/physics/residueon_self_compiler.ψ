let tok_make(typ, value, line) = rp_make(typ, value, line)
let tok_type(tok) = rp_z(tok)
let tok_value(tok) = rp_r(tok)
let tok_line(tok) = rp_n(tok)

let lex_classify(code) =
    let result = TOK_NUM()
    if code < 1000
        result = TOK_NUM()
    if code >= 1000
        if code < 2000
    if code >= 2000
        if code < 3000
    if code >= 3000
        if code < 4000
    if code >= 4000
        if code < 5000
    if code >= 5000
        result = TOK_EOF()
    result

let lex(source, n) =
    let tokens = source
    let i = 0
    for i < n
        let code = source[i]
        let ttype = lex_classify(code)
        let tok = tok_make(ttype, code, i)
        tokens[i] = tok
        i = i + 1
    rpf_make(tokens, n)

let ast_make(typ, value, children) = rp_make(typ, value, children)
let ast_type(node) = rp_z(node)
let ast_value(node) = rp_r(node)
let ast_children(node) = rp_n(node)

let parse_token(tok) =
    let ttype = tok_type(tok)
    let val = tok_value(tok)
    let result = ast_make(AST_LITERAL(), val, 0)
    if ttype == TOK_NUM()
        result = ast_make(AST_LITERAL(), val, 0)
    if ttype == TOK_ID()
        result = ast_make(AST_VARIABLE(), val, 0)
    if ttype == TOK_OP()
        result = ast_make(AST_BINOP(), val, 2)
    if ttype == TOK_KW()
        let kw = val
        result = ast_make(AST_LITERAL(), val, 0)
        if kw == KW_FN()
            result = ast_make(AST_FUNCTION(), val, 3)
        if kw == KW_LET()
            result = ast_make(AST_LET(), val, 2)
        if kw == KW_IF()
            result = ast_make(AST_IF(), val, 3)
        if kw == KW_WHILE()
            result = ast_make(AST_WHILE(), val, 2)
        if kw == KW_RETURN()
            result = ast_make(AST_RETURN(), val, 1)
        if kw == KW_IMPORT()
            result = ast_make(AST_IMPORT(), val, 1)
    if ttype == TOK_SEP()
        result = ast_make(AST_LITERAL(), val, 0)
    result

let parse(token_field) =
    let n = rpf_count(token_field)
    let primes = rpf_primes(token_field)
    let ast_nodes = primes
    let i = 0
    for i < n
        let tok = primes[i]
        let node = parse_token(tok)
        ast_nodes[i] = node
        i = i + 1
    rpf_make(ast_nodes, n)

let OP_PUSH() = 10
let OP_POP() = 11
let OP_ADD() = 12
let OP_SUB() = 13
let OP_MUL() = 14
let OP_CMP() = 15
let OP_JMP() = 16
let OP_CALL() = 17
let OP_RET() = 18

let codegen_node(node) =
    let nt = ast_type(node)
    let val = ast_value(node)
    let cc = ast_children(node)
    let result = rp_make(OP_PUSH(), val, 0)
    if nt == AST_LITERAL()
        result = rp_make(OP_PUSH(), val, 0)
    if nt == AST_VARIABLE()
        result = rp_make(OP_PUSH(), val, 0)
    if nt == AST_BINOP()
        let op_code = OP_ADD()
        if val == OP_PLUS()
            op_code = OP_ADD()
        if val == OP_MINUS()
            op_code = OP_SUB()
        if val == OP_MUL()
            op_code = OP_MUL()
        if val == OP_EQ()
            op_code = OP_CMP()
        if val == OP_LT()
            op_code = OP_CMP()
        if val == OP_GT()
            op_code = OP_CMP()
        result = rp_make(op_code, val, cc)
    if nt == AST_IF()
        result = rp_make(OP_JMP(), val, cc)
    if nt == AST_WHILE()
        result = rp_make(OP_JMP(), val, cc)
    if nt == AST_LET()
        result = rp_make(OP_PUSH(), val, cc)
    if nt == AST_FUNCTION()
        result = rp_make(OP_CALL(), val, cc)
    if nt == AST_CALL()
        result = rp_make(OP_CALL(), val, cc)
    if nt == AST_RETURN()
        result = rp_make(OP_RET(), val, cc)
    if nt == AST_IMPORT()
        result = rp_make(OP_PUSH(), val, cc)
    result

let codegen(ast_field) =
    let n = rpf_count(ast_field)
    let primes = rpf_primes(ast_field)
    let instructions = primes
    let i = 0
    for i < n
        let node = primes[i]
        let instr = codegen_node(node)
        instructions[i] = instr
        i = i + 1
    rpf_make(instructions, n)

let compile(source, n) =
    let token_field = lex(source, n)
    let ast_field = parse(token_field)
    let target_field = codegen(ast_field)
    target_field

let compile_fingerprint(source, n) =
    let token_field = lex(source, n)
    let ast_field = parse(token_field)
    let target_field = codegen(ast_field)
    let fp1 = rpf_fingerprint(token_field)
    let fp2 = rpf_fingerprint(ast_field)
    let fp3 = rpf_fingerprint(target_field)
    [fp1, fp2, fp3]

