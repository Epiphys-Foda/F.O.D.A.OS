let gauge_field_config(values, n) = mf_make([0, 1, 2, 3, 4], values, n)

let wilson_loop_u1(gauge, g, path_indices, path_len) =
    let w = 1
    let i = 0
    for i < path_len
        let idx = path_indices[i]
        let a = mf_residues(gauge)[idx]
        w = gf_mul(w, gf_pow(g, a))
        i = i + 1
    w

let vortex_charge_u1(gauge, path_indices, path_len) =
    let q = 0
    let i = 0
    for i < path_len
        let idx = path_indices[i]
        let a = mf_residues(gauge)[idx]
        q = gf_add(q, a)
        i = i + 1
    q

let verify_t_hooft_duality(gauge, g, path_indices, path_len) =
    let w = wilson_loop_u1(gauge, g, path_indices, path_len)
    let q = vortex_charge_u1(gauge, path_indices, path_len)
    let w_from_q = gf_pow(g, q)
    let result = 0
    if w == w_from_q
        result = 1
    result

let su2_matrix(a, b, c, d) = [a, b, c, d]

let su2_mul(m1, m2) =
    let a1 = m1[0]
    let b1 = m1[1]
    let c1 = m1[2]
    let d1 = m1[3]
    let a2 = m2[0]
    let b2 = m2[1]
    let c2 = m2[2]
    let d2 = m2[3]
    su2_matrix(
        gf_add(gf_mul(a1, a2), gf_mul(b1, c2)),
        gf_add(gf_mul(a1, b2), gf_mul(b1, d2)),
        gf_add(gf_mul(c1, a2), gf_mul(d1, c2)),
        gf_add(gf_mul(c1, b2), gf_mul(d1, d2))
    )

let su2_trace(m) = gf_add(m[0], m[3])

let wilson_loop_su2(matrices, n) =
    let product = matrices[0]
    let i = 1
    for i < n
        product = su2_mul(product, matrices[i])
        i = i + 1
    su2_trace(product)

let center_vortex_z2() = su2_matrix(gf_sub(0, 1), 0, 0, gf_sub(0, 1))

let center_vortex_act(w, z) = gf_mul(z, w)

let residue_to_gauge(field) =
    let n = mf_size(field)
    let gauge_values = []
    let i = 0
    for i < n
        gauge_values = gauge_values.push(mf_residues(field)[i])
        i = i + 1
    mf_make(mf_poles(field), gauge_values, n)

let gauge_to_residue(gauge) =
    let n = mf_size(gauge)
    let res = []
    let i = 0
    for i < n
        res = res.push(mf_residues(gauge)[i])
        i = i + 1
    mf_make(mf_poles(gauge), res, n)

let verify_roundtrip(field) =
    let gauge = residue_to_gauge(field)
    let back = gauge_to_residue(gauge)
    mf_equal(field, back)

let propagator_residue(m) = gf_inv(gf_mul(2, m))

let s_matrix_element(masses, n) =
    let s = 1
    let i = 0
    for i < n
        let m = masses[i]
        s = gf_mul(s, propagator_residue(m))
        i = i + 1
    s

let particle_mass(field, k) = mf_poles(field)[k]

let verify_lsz(field, n) =
    let masses = []
    let i = 0
    for i < n
        masses = masses.push(particle_mass(field, i))
        i = i + 1
    let s_from_residues = s_matrix_element(masses, n)
    let s_direct = 1
    let j = 0
    for j < n
        let m = particle_mass(field, j)
        s_direct = gf_mul(s_direct, propagator_residue(m))
        j = j + 1
    let result = 0
    if s_from_residues == s_direct
        result = 1
    result

let regge_trajectory(j, alpha0, alpha_prime) =
    gf_div(gf_sub(j, alpha0), alpha_prime)

let regge_pole(j, alpha0, alpha_prime) = regge_trajectory(j, alpha0, alpha_prime)

let verify_regge(j, alpha0, alpha_prime) =
    let m2 = regge_pole(j, alpha0, alpha_prime)
    let j_back = gf_add(alpha0, gf_mul(alpha_prime, m2))
    let result = 0
    if j_back == j
        result = 1
    result

