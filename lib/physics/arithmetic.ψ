let half_adder_sum(a, b) = xor_gate(a, b)
let half_adder_carry(a, b) = and_gate(a, b)

let full_adder_sum(a, b, cin) =
    let s1 = xor_gate(a, b)
    xor_gate(s1, cin)

let full_adder_carry(a, b, cin) =
    let s1 = xor_gate(a, b)
    let c1 = and_gate(a, b)
    let c2 = and_gate(s1, cin)
    or_gate(c1, c2)

let add2_sum0(a0, b0) = full_adder_sum(a0, b0, 0)
let add2_sum1(a0, a1, b0, b1) =
    let c0 = full_adder_carry(a0, b0, 0)
    full_adder_sum(a1, b1, c0)
let add2_carry(a0, a1, b0, b1) =
    let c0 = full_adder_carry(a0, b0, 0)
    full_adder_carry(a1, b1, c0)

