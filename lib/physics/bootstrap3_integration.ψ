let evolve_mutate(organism, sigma) = galois_mutate(organism, sigma)

let evolve_select_pop(population, n) =
    let best = population[0]
    let best_fit = organism_fitness(best)
    let i = 1
    for i < n
        let candidate = population[i]
        let cand_fit = organism_fitness(candidate)
        if cand_fit > best_fit
            best = candidate
            best_fit = cand_fit
        i = i + 1
    best
let evolve_inherit(parent1, parent2) =
    let n1 = mf_size(parent1)
    let n2 = mf_size(parent2)
    let n = n1
    if n2 < n1
        n = n2
    let out_p = []
    let out_r = []
    let i = 0
    for i < n
        if i % 2 == 0
            out_p = out_p.push(mf_poles(parent1)[i])
            out_r = out_r.push(mf_residues(parent1)[i])
        if i % 2 != 0
            out_p = out_p.push(mf_poles(parent2)[i])
            out_r = out_r.push(mf_residues(parent2)[i])
        i = i + 1
    mf_make(out_p, out_r, n)

let evolve_crossover(parent1, parent2, crossover_point) =
    let n1 = mf_size(parent1)
    let n2 = mf_size(parent2)
    let n = n1
    if n2 < n1
        n = n2
    let out_p = []
    let out_r = []
    let i = 0
    for i < n
        if i < crossover_point
            out_p = out_p.push(mf_poles(parent1)[i])
            out_r = out_r.push(mf_residues(parent1)[i])
        if i >= crossover_point
            out_p = out_p.push(mf_poles(parent2)[i])
            out_r = out_r.push(mf_residues(parent2)[i])
        i = i + 1
    mf_make(out_p, out_r, n)

let evolve_one_generation(population, n, sigma) =
    let parent1 = evolve_select_pop(population, n)
    let mutated = evolve_mutate(parent1, sigma)
    let parent2 = population[0]
    let child = evolve_inherit(parent1, parent2)
    child

let speciation(pop1, pop2) =
    let fit1 = organism_fitness(pop1)
    let fit2 = organism_fitness(pop2)
    let diff = gf_sub(fit1, fit2)
    gf_mul(diff, diff)

let evolutionary_tree(organism, generations, sigma) =
    let tree_fps = []
    let current = organism
    let i = 0
    for i < generations
        tree_fps = tree_fps.push(mf_fingerprint(current))
        current = evolve_mutate(current, sigma)
        i = i + 1
    tree_fps

