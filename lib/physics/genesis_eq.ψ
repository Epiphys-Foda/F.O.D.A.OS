let berry_curvature(e1, e2, matrix_element) =
    let gap = gf_sub(e1, e2)
    if gap == 0
        0
    else
        let numer = gf_mul(matrix_element, matrix_element)
        gf_div(numer, gf_mul(gap, gap))

let chern_simons_action(A, n) =
    let cs = 0
    let i = 0
    for i < n - 1
        let dA = gf_sub(A[i + 1], A[i])
        cs = gf_add(cs, gf_mul(A[i], dA))
        i = i + 1
    cs

let wzw_term(g_values, n) =
    let wzw = 0
    let i = 0
    for i < n - 1
        if g_values[i] == 0
            wzw
        else
            let dg = gf_div(gf_sub(g_values[i + 1], g_values[i]), g_values[i])
            wzw = gf_add(wzw, gf_mul(dg, dg))
            i = i + 1
    wzw

