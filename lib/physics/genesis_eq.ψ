let ALPHA = 100
let BETA = 200
let EPSILON = 500
let GAMMA_R = 1000
let KAPPA = 300
let LAMBDA_DECAY = 50

let DT = 100

let cx_add(u1, u2) = [gf_add(u1[0], u2[0]), gf_add(u1[1], u2[1])]
let cx_sub(u1, u2) = [gf_sub(u1[0], u2[0]), gf_sub(u1[1], u2[1])]
let cx_mul(u1, u2) =
    [gf_sub(gf_mul(u1[0], u2[0]), gf_mul(u1[1], u2[1])),
     gf_add(gf_mul(u1[0], u2[1]), gf_mul(u1[1], u2[0]))]
let cx_scale(s, u) = [gf_mul(s, u[0]), gf_mul(s, u[1])]
let cx_abs_sq(u) = gf_add(gf_mul(u[0], u[0]), gf_mul(u[1], u[1]))
let cx_conj(u) = [u[0], gf_neg(u[1])]
let cx_im(u) = u[1]

let cgl_diffusion(U, psi, i, n) =
    let sum_re = 0
    let sum_im = 0
    let j = 0
    for j < n
        if j != i
            let u_ij = U[i * n + j]
            let prod_re = gf_mul(u_ij, psi[j][0])
            let prod_im = gf_mul(u_ij, psi[j][1])
            sum_re = gf_add(sum_re, gf_sub(prod_re, psi[i][0]))
            sum_im = gf_add(sum_im, gf_sub(prod_im, psi[i][1]))
        j = j + 1
    [gf_sub(sum_re, gf_mul(ALPHA, sum_im)),
     gf_add(sum_im, gf_mul(ALPHA, sum_re))]

let cgl_pumping(psi_i) = cx_scale(EPSILON, psi_i)

let cgl_nonlinear(psi_i) =
    let abs_sq = cx_abs_sq(psi_i)
    let scaled = cx_scale(abs_sq, psi_i)
    [gf_sub(scaled[0], gf_mul(BETA, scaled[1])),
     gf_add(scaled[1], gf_mul(BETA, scaled[0]))]

let cgl_pcd_dissipation(psi_i, pcd_i) = cx_scale(gf_mul(GAMMA_R, pcd_i), psi_i)

let cgl_external_drive(j_val) = j_val

let genesis_eq_I(U, psi, i, n, pcd_i, j_val) =
    let term1 = cgl_diffusion(U, psi, i, n)
    let term2 = cgl_pumping(psi[i])
    let term3 = cgl_nonlinear(psi[i])
    let term4 = cgl_pcd_dissipation(psi[i], pcd_i)
    let term5 = cgl_external_drive(j_val)
    let result = cx_add(term1, term2)
    result = cx_sub(result, term3)
    result = cx_sub(result, term4)
    result = cx_add(result, term5)
    result

let genesis_step_I(U, psi, i, n, pcd_i, j_val) =
    let dpsi = genesis_eq_I(U, psi, i, n, pcd_i, j_val)
    let new_re = gf_add(psi[i][0], gf_mul(DT, dpsi[0]))
    let new_im = gf_add(psi[i][1], gf_mul(DT, dpsi[1]))
    [new_re, new_im]

let covariant_derivative(A_mu, psi) = cx_mul([A_mu, 0], psi)

let im_psi_star_d_psi(psi, A_mu) =
    let d_psi = covariant_derivative(A_mu, psi)
    let psi_star = cx_conj(psi)
    let product = cx_mul(psi_star, d_psi)
    cx_im(product)

let genesis_eq_II(psi, A_mu) =
    let im_val = im_psi_star_d_psi(psi, A_mu)
    gf_sub(gf_mul(KAPPA, im_val), gf_mul(LAMBDA_DECAY, A_mu))

let genesis_step_II(psi, A_mu) =
    let dA = genesis_eq_II(psi, A_mu)
    gf_add(A_mu, gf_mul(DT, dA))

let degrade_to_schrodinger(psi_i, energy) =
    [gf_mul(energy, psi_i[1]), gf_neg(gf_mul(energy, psi_i[0]))]

let degrade_to_diffusion(psi_i, diff_coeff) =
    [gf_mul(diff_coeff, psi_i[0]), 0]

let degrade_to_turing(psi_i, reaction_rate, diff_coeff) =
    [gf_add(gf_mul(reaction_rate, psi_i[0]), gf_mul(diff_coeff, psi_i[0])), 0]

let free_energy_density(psi_i, potential, coupling) =
    let abs_sq = cx_abs_sq(psi_i)
    let abs_4 = gf_mul(abs_sq, abs_sq)
    gf_add(gf_mul(potential, abs_sq), gf_mul(coupling, abs_4))

let hopf_bifurcation(psi_i, epsilon) =
    let abs_sq = cx_abs_sq(psi_i)
    let linear = cx_scale(epsilon, psi_i)
    let nonlinear = cx_scale(abs_sq, psi_i)
    cx_sub(linear, nonlinear)

