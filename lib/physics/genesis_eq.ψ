    if sqrt_a == 0
        0
    else
        let exponent = gf_div(gf_mul(barrier, gf_abs(delta_phi)), sqrt_a)
        gf_div(1, gf_add(1, exponent))

let cognitive_annealing_temp(t, t0, sigma_anneal, t_cognitive) =
    if t_cognitive == 0
