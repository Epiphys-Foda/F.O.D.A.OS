let cplx_add(u1, u2) = [gf_add(u1[0], u2[0]), gf_add(u1[1], u2[1])]

let cplx_sub(u1, u2) = [gf_sub(u1[0], u2[0]), gf_sub(u1[1], u2[1])]

let cplx_mul(u1, u2) =
    let re = gf_sub(gf_mul(u1[0], u2[0]), gf_mul(u1[1], u2[1]))
    let im = gf_add(gf_mul(u1[0], u2[1]), gf_mul(u1[1], u2[0]))
    [re, im]

let cplx_norm_sq(u) = gf_add(gf_mul(u[0], u[0]), gf_mul(u[1], u[1]))

let cplx_l1_norm(u) = gf_add(gf_abs(u[0]), gf_abs(u[1]))

let cplx_from_polar(s, cos_phi, sin_phi) =
    [gf_mul(s, cos_phi), gf_mul(s, sin_phi)]

let pcd_compute(edges, n) =
    if n == 0
        0
    else
        let sum_re = 0
        let sum_im = 0
        let sum_abs = 0
        let i = 0
        for i < n
            sum_re = gf_add(sum_re, edges[i][0])
            sum_im = gf_add(sum_im, edges[i][1])
            sum_abs = gf_add(sum_abs, cplx_l1_norm(edges[i]))
            i = i + 1
        let sum_u = [sum_re, sum_im]
        let numer = cplx_l1_norm(sum_u)
        if sum_abs == 0
            0
        else
            gf_div(gf_sub(sum_abs, numer), sum_abs)

let pcd_compute_norm(edges, n) =
    if n == 0
        0
    else
        let sum_re = 0
        let sum_im = 0
        let sum_abs = 0
        let i = 0
        for i < n
            sum_re = gf_add(sum_re, edges[i][0])
            sum_im = gf_add(sum_im, edges[i][1])
            sum_abs = gf_add(sum_abs, cplx_l1_norm(edges[i]))
            i = i + 1
        let norm_sq = gf_add(gf_mul(sum_re, sum_re), gf_mul(sum_im, sum_im))
        let denom = gf_mul(sum_abs, sum_abs)
        if denom == 0
            0
        else
            gf_div(gf_sub(denom, norm_sq), denom)

