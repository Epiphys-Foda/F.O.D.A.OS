let op_to_pe_type(op_type) =
    if op_type == 0
        0
    else
        0
    if op_type == 1
        1
    else
        0
    if op_type == 2
        2
    else
        0
    if op_type == 3
        3
    else
        0
    if op_type == 4
        4
    else
        0
    if op_type == 5
        5
    else
        0

let field_to_cgra(ops_type, ops_data, n, pe_type, pe_data, pe_x, pe_y, fifo_src, fifo_dst) =
    let i = 0
    for i < n
        pe_type[i] = op_to_pe_type(ops_type[i])
        pe_data[i] = ops_data[i]
        pe_x[i] = i % 4
        pe_y[i] = i / 4
        if i > 0
            fifo_src[i] = i - 1
            fifo_dst[i] = i
        else
            fifo_src[i] = 0
            fifo_dst[i] = 0
        i = i + 1

let cgra_execute(pe_type, pe_data, n) =
    let stack = arr_new_n(n)
    let sp = 0
    let i = 0
    for i < n
        let t = pe_type[i]
        if t == 0
            stack[sp] = pe_data[i]
            sp = sp + 1
        if t == 1
            if sp >= 2
                let b = stack[sp - 1]
                let a = stack[sp - 2]
                sp = sp - 2
                stack[sp] = gf_mul(a, b)
                sp = sp + 1
        if t == 2
            if sp >= 2
                let b = stack[sp - 1]
                let a = stack[sp - 2]
                sp = sp - 2
                stack[sp] = gf_add(a, b)
                sp = sp + 1
        if t == 3
            if sp >= 1
                stack[sp - 1] = (stack[sp - 1] * 3) % 65537
        if t == 4
            if sp >= 1
                let a = stack[sp - 1]
                if a > 32768
                    stack[sp - 1] = 0
        if t == 5
            if sp >= 1
                stack[sp - 1] = (65535 * stack[sp - 1] + 2) % 65537
        i = i + 1
    (sp > 0 ? stack[sp - 1] : 0)

