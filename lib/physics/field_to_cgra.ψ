let bit_identical_verify(ops_type, ops_data, n) =
    let field_result = field_execute(ops_type, ops_data, n)
    let pe_type = arr_new_n(n)
    let pe_data = arr_new_n(n)
    let pe_x = arr_new_n(n)
    let pe_y = arr_new_n(n)
    let fifo_src = arr_new_n(n)
    let fifo_dst = arr_new_n(n)
    field_to_cgra(ops_type, ops_data, n, pe_type, pe_data, pe_x, pe_y, fifo_src, fifo_dst)
    let cgra_result = cgra_execute(pe_type, pe_data, n)
    let ok = 0
    if field_result == cgra_result
        ok = 1
    let out = arr_new_n(3)
    out[0] = field_result
    out[1] = cgra_result
    out[2] = ok
    out

