let field_optimize(residues, n, threshold, out) =
    let spectrum = arr_new_n(n)
    ntt_into(residues, n, spectrum)
    let kept = 0
    let k = 0
    for k < n
        let v = spectrum[k]
        let abs_v = v
        if v > 32768
            abs_v = 65537 - v
        if abs_v > threshold
            kept = kept + 1
        else
            spectrum[k] = 0
        k = k + 1
    intt_into(spectrum, n, out)
    kept

let field_verify_roundtrip(residues, n) =
    let spectrum = arr_new_n(n)
    ntt_into(residues, n, spectrum)
    let reconstructed = arr_new_n(n)
    intt_into(spectrum, n, reconstructed)
    let ok = 1
    let i = 0
    for i < n
        if residues[i] != reconstructed[i]
            ok = 0
        i = i + 1
    ok

let field_energy(r, n) =
    let e = 0
    let i = 0
    for i < n
        e = (e + r[i] * r[i]) % 65537
        i = i + 1
    e

