let brownian_verify() =
    let result = 0
    let W0 = 0
    if W0 == 0
        result = result + 1
    let W1 = 1
    let W3 = 1
    if gf_add(W1, gf_sub(W3, W1)) == W3
        result = result + 1
    let qw = gf_add(gf_add(gf_add(gf_add(gf_add(gf_mul(1, 1), gf_mul(65536, 65536)), gf_mul(1, 1)), gf_mul(65536, 65536)), gf_mul(1, 1)), gf_mul(65536, 65536))
    if qw == 6
        result = result + 1
    if gf_add(1, 65536) == 0
        result = result + 1
    result

let martingale_verify() =
    let result = 0
    if gf_add(1, 65536) == 0
        result = result + 1
    if gf_mul(1, 1) == 1
        result = result + 1
    if gf_mul(gf_mul(2, 1), 1) == 2
        result = result + 1
    result

let poisson_verify() =
    let result = 0
    if gf_mul(1, 0) == 0
        result = result + 1
    let N2 = 1
    let N5 = 3
    if N5 >= N2
        result = result + 1
    let expected_N3 = gf_mul(1, 3)
    if expected_N3 == 3
        result = result + 1
    result

let markov_verify() =
    let result = 0
    let p00 = gf_div(2, 3)
    let p01 = gf_div(1, 3)
    let p10 = gf_div(1, 4)
    let p11 = gf_div(3, 4)
    if gf_add(p00, p01) == 1
        result = result + 1
    if gf_add(p10, p11) == 1
        result = result + 1
    let p2_00 = gf_add(gf_mul(p00, p00), gf_mul(p01, p10))
    let p2_01 = gf_add(gf_mul(p00, p01), gf_mul(p01, p11))
    if gf_add(p2_00, p2_01) == 1
        result = result + 1
    let pi0 = gf_div(3, 7)
    let pi1 = gf_div(4, 7)
    let piP0 = gf_add(gf_mul(pi0, p00), gf_mul(pi1, p10))
    if piP0 == pi0
        result = result + 1
    result

let ito_integral_verify() =
    let result = 0
    let Wt = 1
    let integral = gf_mul(gf_add(2, 3), Wt)
    if integral == 5
        result = result + 1
    if gf_sub(Wt, 0) == Wt
        result = result + 1
    if gf_mul(Wt, Wt) == 1
        result = result + 1
    result

let ito_lemma_verify() =
    let result = 0
    let W = 1
    let dW = 1
    let dt = 1
    let dW2 = gf_add(gf_mul(gf_mul(2, W), dW), gf_mul(dW, dW))
    if dW2 == 3
        result = result + 1
    if dW == 1
        result = result + 1
    let df_xt = gf_sub(dW, dt)
    if df_xt == 0
        result = result + 1
    result

let sde_verify() =
    let result = 0
    let X0 = 1
    let X1 = gf_mul(X0, gf_add(gf_add(1, 1), 1))
    if X1 == 3
        result = result + 1
    let X2 = gf_mul(X1, gf_add(gf_add(1, 1), 1))
    if X2 == 9
        result = result + 1
    let Y0 = 0
    let Y1 = gf_add(gf_mul(Y0, gf_sub(1, 1)), 1)
    if Y1 == 1
        result = result + 1
    result

