let homotopy_group_verify() =
    let result = 0
    if gf_add(1, 0) == 1
        result = result + 1
    if gf_add(gf_add(1, 1), 1) == 3
        result = result + 1
    if gf_mul(1, 1) == 1
        result = result + 1
    result

let fibration_verify() =
    let result = 0
    if gf_sub(gf_add(2, 3), 5) == 0
        result = result + 1
    if gf_add(1, 2) == 3
        result = result + 1
    if gf_mul(0, 7) == 0
        result = result + 1
    result

let van_kampen_verify() =
    let result = 0
    if gf_add(1, 1) == 2
        result = result + 1
    if gf_mul(2, 3) == 6
        result = result + 1
    if gf_mul(0, 1) == 0
        result = result + 1
    result

let covering_space_verify() =
    let result = 0
    if gf_add(1, 1) == 2
        result = result + 1
    if gf_mul(2, 1) == 2
        result = result + 1
    if gf_mul(gf_mul(2, 3), 4) == gf_mul(2, gf_mul(3, 4))
        result = result + 1
    result

let whitehead_verify() =
    let result = 0
    if gf_mul(2, gf_div(1, 2)) == 1
        result = result + 1
    if gf_mul(1, 1) == 1
        result = result + 1
    if gf_add(gf_add(2, 3), 4) == gf_add(2, gf_add(3, 4))
        result = result + 1
    result

let hurewicz_verify() =
    let result = 0
    if gf_mul(2, 3) == gf_mul(3, 2)
        result = result + 1
    if gf_mul(2, 1) == 2
        result = result + 1
    if gf_add(gf_mul(2, 1), gf_mul(3, 1)) == gf_mul(5, 1)
        result = result + 1
    result

let suspension_loop_verify() =
    let result = 0
    if gf_add(1, 1) == 2
        result = result + 1
    if gf_add(2, 1) == 3
        result = result + 1
    if gf_mul(2, 4) == 8
        result = result + 1
    result

let homotopy_pcd_rrc_verify() =
    let result = 0
    if gf_sub(gf_mul(3, 4), 12) == 0
        result = result + 1
    if gf_sub(gf_add(1, 1), 2) == 0
        result = result + 1
    if gf_mul(2, 3) == gf_mul(3, 2)
        result = result + 1
    if gf_mul(2, gf_div(1, 2)) == 1
        result = result + 1
    if gf_add(1, 1) == 2
        result = result + 1
    result

