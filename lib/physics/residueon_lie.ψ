let lie_basic_verify() =
    let result = 0
    let HE = 2
    let EH = gf_neg(2)
    if gf_add(HE, EH) == 0
        result = result + 1
    if gf_sub(2, 2) == 0
        result = result + 1
    let jac1 = 0
    let jac2 = gf_mul(2, 1)
    let jac3 = gf_mul(65535, 1)
    if gf_add(gf_add(jac1, jac2), jac3) == 0
        result = result + 1
    if gf_mul(gf_mul(3, 5), 2) == 30
        result = result + 1
    result

let sl2_structure_verify() =
    let result = 0
    if gf_sub(1, gf_neg(1)) == 2
        result = result + 1
    if gf_neg(2) == 65535
        result = result + 1
    if gf_mul(2, 4) == 8
        result = result + 1
    result

let su2_structure_verify() =
    let result = 0
    if gf_add(gf_mul(1, 1), gf_mul(gf_neg(1), gf_neg(1))) == 2
        result = result + 1
    if gf_neg(1) == 65536
        result = result + 1
    if gf_add(gf_add(0, 0), 0) == 0
        result = result + 1
    result

let killing_form_verify() =
    let result = 0
    let kappa_HH = gf_add(gf_add(gf_mul(2, 2), 0), gf_mul(65535, 65535))
    if kappa_HH == 8
        result = result + 1
    let kappa_EF = gf_add(gf_add(2, 2), 0)
    if kappa_EF == 4
        result = result + 1
    if kappa_EF == 4
        result = result + 1
    result

let root_decomp_verify() =
    let result = 0
    let alpha_H = 2
    if alpha_H == 2
        result = result + 1
    let neg_alpha_H = gf_neg(alpha_H)
    if neg_alpha_H == 65535
        result = result + 1
    if gf_add(alpha_H, neg_alpha_H) == 0
        result = result + 1
    result

let representation_verify() =
    let result = 0
    if gf_add(gf_mul(2, 0), 1) == 1
        result = result + 1
    if gf_add(gf_mul(2, 1), 1) == 3
        result = result + 1
    let casimir = gf_mul(1, gf_add(1, 1))
    if casimir == 2
        result = result + 1
    result

let adjoint_verify() =
    let result = 0
