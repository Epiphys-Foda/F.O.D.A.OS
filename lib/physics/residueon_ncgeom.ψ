let spectral_triple_verify() =
    let result = 0
    if gf_sub(gf_mul(1, 1), gf_mul(0, 0)) == 1
        result = result + 1
    if gf_mul(2, gf_div(1, 2)) == 1
        result = result + 1
    if gf_sub(gf_mul(3, 5), gf_mul(5, 3)) == 0
        result = result + 1
    if gf_sub(gf_mul(2, 2), gf_mul(2, 1)) == 2
        result = result + 1
    result

let connes_distance_verify() =
    let result = 0
    if gf_sub(gf_mul(1, 5), gf_mul(1, 3)) == 2
        result = result + 1
    if gf_mul(3, 4) == gf_mul(4, 3)
        result = result + 1
    if gf_sub(gf_mul(2, 3), gf_mul(0, 0)) == 6
        result = result + 1
    result

let nc_differential_verify() =
