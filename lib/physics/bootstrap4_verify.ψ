let meta_compiler_fp() =
    let h = 0
    let i = 0
    for i < 6
        h = gf_add(gf_mul(h, 31), gf_pow(i + 1, 2))
        i = i + 1
    h

let meta_meta_apply(op) =
    let base_fp = meta_compiler_fp()
    let result = 0
    if op == 0
        result = base_fp
    else
        0
    if op == 1
        result = gf_mul(base_fp, base_fp)
    else
        0
    if op == 2
        result = gf_pow(base_fp, 2)
    else
        0
    if op == 3
        result = gf_pow(base_fp, 3)
    else
        0
    if op == 4
        result = gf_add(base_fp, 1)
    else
        0
    if op == 5
        result = gf_mul(gf_pow(base_fp, 2), gf_pow(base_fp, 2))
    result

let meta_meta_compiler() =
    let poles = [0, 1, 2, 3, 4, 5]
    let res = [meta_meta_apply(0), meta_meta_apply(1), meta_meta_apply(2), meta_meta_apply(3), meta_meta_apply(4), meta_meta_apply(5)]
    [poles, res, 6]

let mm_compile_self() =
    let mc = meta_meta_compiler()
    let mc_poles = mc[0]
    let out_poles = []
    let out_res = []
    let i = 0
    for i < 6
        let op = mc_poles[i]
        out_poles = out_poles.push(op)
        out_res = out_res.push(meta_meta_apply(op))
        i = i + 1
    [out_poles, out_res, 6]

let verify_t9() =
    let mc = meta_meta_compiler()
    let compiled = mm_compile_self()
    let p1 = mc[0]
    let r1 = mc[1]
    let p2 = compiled[0]
    let r2 = compiled[1]
    let identical = 1
    let i = 0
    for i < 6
        if p1[i] != p2[i]
            identical = 0
        if r1[i] != r2[i]
            identical = 0
        i = i + 1
    identical

let verify_t10() =
    let mc = meta_meta_compiler()
    let mc_poles = mc[0]
    let mc_res = mc[1]
    let has_observe = 0
    let has_meta_fp = 0
    let expected_fp = meta_compiler_fp()
    let i = 0
    for i < 6
        if mc_poles[i] == 0
            has_observe = 1
        if mc_poles[i] == 0
            if mc_res[i] == expected_fp
                has_meta_fp = 1
        i = i + 1
    has_observe * has_meta_fp

let verify_t11() =
    let mc = meta_meta_compiler()
