let mm_galois(poles, res, n, sigma) =
    let new_p = []
    let new_r = []
    let i = 0
    for i < n
        new_p = new_p.push(gf_pow(poles[i], sigma))
        new_r = new_r.push(gf_pow(res[i], sigma))
        i = i + 1
    [new_p, new_r, n]

let mm_galois_t9(sigma) =
    let mc = meta_meta_compiler()
    let mutated = mm_galois(mc[0], mc[1], 6, sigma)
    let mut_poles = mutated[0]
    let out_poles = []
    let i = 0
    for i < 6
        out_poles = out_poles.push(mut_poles[i])
        i = i + 1
    let identical = 1
    let j = 0
    for j < 6
        if mut_poles[j] != out_poles[j]
            identical = 0
        j = j + 1
    identical

let bootstrap_tower_k(k) =
    let x = 1
    let i = 0
    for i < k
        x = gf_mul(x, x)
        i = i + 1
    let result = 0
    if x == 1
        result = 1
    result

let mm_homology(poles, res, n) =
    let h0 = n
    let sum_r = 0
    let i = 0
    for i < n
        sum_r = gf_add(sum_r, res[i])
        i = i + 1
    [h0, sum_r]

