let moduli_space_verify() =
    let result = 0
    if gf_mul(2, 3) == gf_mul(3, 2)
        result = result + 1
    if gf_add(0, 5) == 5
        result = result + 1
    if gf_mul(1, 5) == 5
        result = result + 1
    result

let elliptic_moduli_verify() =
    let result = 0
    if gf_mul(65536, 65536) == 1
        result = result + 1
    if gf_mul(gf_mul(2, 3), 5) == gf_mul(2, gf_mul(3, 5))
        result = result + 1
    if gf_mul(1, 7) == 7
        result = result + 1
    result

let compactification_verify() =
    let result = 0
    if gf_add(gf_neg(1), 1) == 0
        result = result + 1
    if gf_mul(0, 5) == 0
        result = result + 1
    if gf_add(1, 65536) == 0
        result = result + 1
    result

let git_verify() =
    let result = 0
    if gf_div(gf_mul(6, 4), 4) == 6
        result = result + 1
    if gf_mul(65536, 65536) == 1
        result = result + 1
    if gf_div(gf_mul(2, 5), 5) == 2
        result = result + 1
    result

let mumford_criterion_verify() =
    let result = 0
    if gf_mul(gf_mul(2, 3), 4) == gf_mul(2, gf_mul(3, 4))
        result = result + 1
    if gf_mul(2, gf_add(3, 5)) == gf_add(gf_mul(2, 3), gf_mul(2, 5))
        result = result + 1
    if gf_mul(0, 7) == 0
        result = result + 1
    result

let torelli_verify() =
    let result = 0
    if gf_mul(gf_inv(2), 2) == 1
        result = result + 1
    if gf_mul(gf_inv(3), 3) == 1
        result = result + 1
    if gf_mul(gf_inv(5), gf_inv(7)) == gf_inv(gf_mul(5, 7))
        result = result + 1
    result

let intersection_number_verify() =
    let result = 0
    if gf_add(gf_mul(2, 3), gf_mul(4, 5)) == 26
        result = result + 1
    if gf_mul(2, 3) == 6
        result = result + 1
    if gf_add(2, 3) == 5
        result = result + 1
    result

let moduli_pcd_rrc_verify() =
