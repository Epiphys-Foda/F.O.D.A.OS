let field_fingerprint(residues, n) =
    let spectrum = arr_new_n(n)
    ntt_into(residues, n, spectrum)
    let hash = 0
    let k = 0
    for k < n
        let v = spectrum[k]
        let weight = gf_pow(3, k)
        hash = (hash + v * v * weight) % 65537
        k = k + 1
    hash

let field_equivalent(r1, n1, r2, n2) =
    if n1 != n2
        0
    else
        let fp1 = field_fingerprint(r1, n1)
        let fp2 = field_fingerprint(r2, n2)
        (fp1 == fp2 ? 1 : 0)

