let extract_residue(poles, residues, n, z_k) =
    let i = 0
    for i < n
        if poles[i] == z_k
            residues[i]
        i = i + 1
    0

let perturb_poles(poles, n, delta, out) =
    let i = 0
    for i < n
        let noise = (delta * (i + 1)) % 65537
        out[i] = (poles[i] + noise) % 65537
        i = i + 1

let compute_result(residues, n) =
    let sum = 0
    let i = 0
    for i < n
        sum = (sum + residues[i]) % 65537
        i = i + 1
    sum

let nand_soliton(a, b, z1, z2) =
    let residue = a * b * gf_inv(z1 + 65537 - z2)
    let product = residue * (z1 + 65537 - z2)
    gf_sub(1, product)

