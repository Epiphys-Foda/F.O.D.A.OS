    result

let ramanujan_tau_verify() =
    let result = 0
    let tau2 = gf_neg(24)
    let tau3 = 252
    if gf_mul(1, tau2) == tau2
        result = result + 1
    if tau2 == 65513
        result = result + 1
    if tau3 == 252
        result = result + 1
    if gf_mul(tau2, tau3) == gf_neg(6048)
        result = result + 1
    result

