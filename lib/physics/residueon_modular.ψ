let modular_group_verify() =
    let result = 0
    if gf_sub(gf_mul(1, 1), gf_mul(0, 0)) == 1
        result = result + 1
    if gf_sub(gf_mul(0, 0), gf_mul(65536, 1)) == 1
        result = result + 1
    if gf_sub(gf_mul(1, 1), gf_mul(1, 0)) == 1
        result = result + 1
    if gf_sub(gf_mul(0, 1), gf_mul(65536, 1)) == 1
        result = result + 1
    result

let modular_form_verify() =
    let result = 0
    if gf_mul(240, 9) == 2160
        result = result + 1
    if gf_neg(504) == 65033
        result = result + 1
    if gf_mul(2, 2) == 4
        result = result + 1
    result

let eisenstein_verify() =
    let result = 0
    if gf_mul(16, 15) == 240
        result = result + 1
    if gf_neg(504) == 65033
        result = result + 1
    let lhs = gf_sub(gf_mul(3, 240), gf_mul(2, gf_neg(504)))
    if lhs == 1728
        result = result + 1
    if gf_mul(2, 240) == 480
        result = result + 1
    result

let discriminant_verify() =
    let result = 0
    if gf_mul(1, 7) == 7
        result = result + 1
    if gf_neg(24) == 65513
        result = result + 1
    if gf_div(1728, 1728) == 1
        result = result + 1
    result

let j_function_verify() =
    let result = 0
    if gf_add(gf_mul(3, 240), 24) == 744
        result = result + 1
    if 196884 % 65537 == 273
        result = result + 1
    if gf_add(720, 24) == 744
        result = result + 1
    result

let eta_function_verify() =
    let result = 0
