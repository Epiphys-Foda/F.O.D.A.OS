let time_step(field, dt) =
    let primes = rpf_primes(field)
    let n = rpf_count(field)
    let new_primes = []
    let i = 0
    for i < n
        let rp = primes[i]
        let z = rp_z(rp)
        let r = rp_r(rp)
        let nn = rp_n(rp)
        let new_z = gf_add(z, gf_mul(dt, r))
        let new_r = gf_add(r, gf_mul(dt, z))
        new_primes = new_primes.push(rp_make(new_z, new_r, nn))
        i = i + 1
    rpf_make(new_primes, n)

let pde_solve(field, dt, steps) =
    let current = field
    let i = 0
    for i < steps
        current = time_step(current, dt)
        i = i + 1
    current

let verify_pde_conservation(field, dt, steps) =
    let before = rpf_total_residue(field)
    let after = pde_solve(field, dt, steps)
    let after_res = rpf_total_residue(after)
    let result = 0
    if before == after_res
        result = 1
    result

