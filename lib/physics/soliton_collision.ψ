let soliton_make(kappa, x0) =
    let r = gf_mul(gf_mul(2, kappa), kappa)
    rp_make(x0, r, 1)

let soliton_amplitude(sol) = rp_r(sol)

let soliton_position(sol) = rp_z(sol)

let soliton_kappa(sol) =
    let r = rp_r(sol)
    gf_div(r, 2)

let soliton_phase_shift(kappa1, kappa2) =
    let sum_k = gf_add(kappa1, kappa2)
    let diff_k = gf_sub(kappa1, kappa2)
    let ratio = gf_mul(sum_k, gf_inv(diff_k))
    gf_mul(gf_inv(kappa1), ratio)

let soliton_collide(sol1, sol2) =
    let k1 = soliton_kappa(sol1)
    let k2 = soliton_kappa(sol2)
    let x1 = soliton_position(sol1)
    let x2 = soliton_position(sol2)
    let r1 = soliton_amplitude(sol1)
    let r2 = soliton_amplitude(sol2)

    let delta1 = soliton_phase_shift(k1, k2)
    let delta2 = soliton_phase_shift(k2, k1)

    let new_x1 = gf_add(x1, delta1)
    let new_x2 = gf_add(x2, delta2)

    [rp_make(new_x1, r1, 1), rp_make(new_x2, r2, 1)]

let soliton_momentum(solitons, n) =
    let p = 0
    let i = 0
    for i < n
        p = gf_add(p, soliton_kappa(solitons[i]))
        i = i + 1
    p

let soliton_energy(solitons, n) =
    let e = 0
    let i = 0
    for i < n
        let k = soliton_kappa(solitons[i])
        e = gf_add(e, gf_pow(k, 3))
        i = i + 1
    e

let soliton_residue_sum(solitons, n) =
    let r = 0
    let i = 0
    for i < n
        r = gf_add(r, soliton_amplitude(solitons[i]))
        i = i + 1
    r

let verify_conservation(sol1, sol2) =
    let before = [sol1, sol2]
    let after_collide = soliton_collide(sol1, sol2)
    let after = [after_collide[0], after_collide[1]]

    let p_before = soliton_momentum(before, 2)
    let p_after = soliton_momentum(after, 2)
    let momentum_ok = 0
    if p_before == p_after
        momentum_ok = 1

    let r_before = soliton_residue_sum(before, 2)
    let r_after = soliton_residue_sum(after, 2)
    let residue_ok = 0
    if r_before == r_after
        residue_ok = 1

    [momentum_ok, residue_ok]

let verify_shape_preserved(sol1, sol2) =
    let after = soliton_collide(sol1, sol2)
    let new_sol1 = after[0]
    let new_sol2 = after[1]

    let r1_before = soliton_amplitude(sol1)
    let r1_after = soliton_amplitude(new_sol1)
    let r2_before = soliton_amplitude(sol2)
    let r2_after = soliton_amplitude(new_sol2)

    let shape_ok = 0
    if r1_before == r1_after
        if r2_before == r2_after
            shape_ok = 1
    shape_ok

let n_soliton_collide(solitons, n) =
    let current = solitons
    let i = 0
    for i < n
        let j = gf_add(i, 1)
        for j < n
            let sol_i = current[i]
            let sol_j = current[j]
            let collided = soliton_collide(sol_i, sol_j)
            current[i] = collided[0]
            current[j] = collided[1]
            j = j + 1
        i = i + 1
    current

let verify_n_soliton_conservation(solitons, n) =
    let p_before = soliton_momentum(solitons, n)
    let r_before = soliton_residue_sum(solitons, n)
    let after = n_soliton_collide(solitons, n)
    let p_after = soliton_momentum(after, n)
    let r_after = soliton_residue_sum(after, n)
    let result = 0
    if p_before == p_after
        if r_before == r_after
            result = 1
    result

let s_matrix_2soliton(sol1, sol2) = soliton_collide(sol1, sol2)

let verify_s_matrix_involution(sol1, sol2) =
