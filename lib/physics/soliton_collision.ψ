    if verify_pde_conservation(field, 1, 5) == 1
        ok = ok + 1

    let before_momentum = soliton_momentum(solitons, 3)
    let before_energy = soliton_energy(solitons, 3)
    let before_residue = soliton_residue_sum(solitons, 3)
    if before_momentum >= 0
        ok = ok + 1
