        ok = ok + 1
    if before_residue >= 0
        ok = ok + 1

    let after_momentum = soliton_momentum(n_collided, 3)
    let after_residue = soliton_residue_sum(n_collided, 3)
    if before_momentum == after_momentum
        ok = ok + 1
    if before_residue == after_residue
        ok = ok + 1

    let rp_collided = rp_collide(sol1, sol2)
    let rp_before = gf_add(rp_r(sol1), rp_r(sol2))
    let rp_after = gf_add(rp_r(rp_collided[0]), rp_r(rp_collided[1]))
    if rp_before == rp_after
        ok = ok + 1

    let perturbed = rp_galois(sol1, 2)
    if rp_r(perturbed) >= 0
        ok = ok + 1

    let hom = rpf_homology(field)
    if hom[0] == 2
        ok = ok + 1

    let t0 = rpf_fingerprint(field)
    let t1 = rpf_fingerprint(time_step(field, 1))
    let t2 = rpf_fingerprint(time_step(time_step(field, 1), 1))
    if t0 >= 0
        ok = ok + 1
    if t1 >= 0
        ok = ok + 1
    if t2 >= 0
        ok = ok + 1

    let one_step_result = soliton_collide(sol1, sol2)
    if rp_z(one_step_result[0]) >= 0
        ok = ok + 1
    if rp_z(one_step_result[1]) >= 0
        ok = ok + 1

    let all_ok = 1
    if conservation[0] == 0
        all_ok = 0
    if conservation[1] == 0
        all_ok = 0
    if verify_shape_preserved(sol1, sol2) == 0
        all_ok = 0
    if all_ok == 1
        ok = ok + 1

    ok

