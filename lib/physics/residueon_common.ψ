let _ts_find_i(t, i) =
    if gf_pow(t, 1 << i) == 1
        i
    else
        _ts_find_i(t, i + 1)
let _ts_loop(M, c, t, R) =
    if t == 1
        R
    else
        let i = _ts_find_i(t, 1)
        let b = gf_pow(c, 1 << (M - i - 1))
        let b2 = gf_mul(b, b)
        _ts_loop(i, b2, gf_mul(t, b2), gf_mul(R, b))
let gf_mod(a, m) = (m == 0 ? 0 : ((a % m) + m) % m)

let _poly_hash_acc(arr, n, primes, fp, i) =
    if i >= n
        fp
    else
        _poly_hash_acc(arr, n, primes, gf_add(gf_mul(fp, primes[i % len(primes)]), arr[i]), i + 1)
let poly_hash(arr, primes) = _poly_hash_acc(arr, len(arr), primes, 0, 0)

