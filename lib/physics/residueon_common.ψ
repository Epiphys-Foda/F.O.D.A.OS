let cross_domain_base() =
    let p1 = rp_make(1, 2, 0)
    let p2 = rp_make(3, 4, 1)
    let p3 = rp_make(5, 6, 2)
    let field = rpf_make([p1, p2, p3], 3)
    let hom = rpf_homology(field)
    let mutated = rpf_galois(field, 2)
    let f = mf_make([0, 1], [3, 5], 2)
    let fI = combinator_I(f)
    let apop = apoptosis(f)
    let mc = meta_compiler()
    let ok = 0
    ok = ok + (hom[0] == 3)
    ok = ok + (rpf_count(mutated) == 3)
    ok = ok + (ast_to_op(AST_LITERAL) == OP_OBSERVE)
    ok = ok + (mf_equal(fI, f) == 1)
    ok = ok + (bootstrap_tower(8))
    ok = ok + (mf_size(apop) >= 0)
    ok = ok + (mf_size(mc) == 6)
    ok
