    let hg = gf_mul(F_g, F_f)
    if gf_mul(hg, x) == gf_mul(F_g, gf_mul(F_f, x))
        result = result + 1
    if gf_mul(F_id, gf_mul(F_f, x)) == gf_mul(F_f, x)
