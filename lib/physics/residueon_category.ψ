    if left == right
        result = result + 1
    if gf_mul(1, gf_mul(F_f, x)) == gf_mul(F_f, gf_mul(1, x))
        result = result + 1
    if gf_mul(gf_mul(1, eta_B), eta_A) == gf_mul(eta_B, eta_A)
