let mmm_compiler_fp() =
    let mc = meta_compiler()
    let mc_fp = mf_fingerprint(mc)
    let h = 0
    let i = 0
    for i < 6
        h = gf_add(gf_mul(h, 31), gf_pow(gf_add(mc_fp, i + 1), 2))
        i = i + 1
    h

let mmm_apply(op) =
    let base_fp = mmm_compiler_fp()
    let result = 0
    if op == 0
        result = base_fp
    else
        0
    if op == 1
        result = gf_pow(base_fp, 2)
    else
        0
    if op == 2
        result = gf_pow(base_fp, 3)
    else
        0
    if op == 3
        result = gf_add(base_fp, 1)
    else
        0
    if op == 4
        result = gf_mul(base_fp, base_fp)
    else
        0
    if op == 5
        result = gf_pow(base_fp, 4)
    else
        0
    if op == 6
        result = gf_mul(gf_pow(base_fp, 2), gf_pow(base_fp, 3))
    else
        0
    if op == 7
        result = gf_add(gf_mul(base_fp, 31), 7)
    result

let mmm_compiler() =
    let poles = [0, 1, 2, 3, 4, 5, 6, 7]
    let res = [mmm_apply(0), mmm_apply(1), mmm_apply(2), mmm_apply(3), mmm_apply(4), mmm_apply(5), mmm_apply(6), mmm_apply(7)]
    mf_make(poles, res, 8)

let mmm_compile_self() =
    let mmm = mmm_compiler()
    let n = mf_size(mmm)
    let out_p = []
    let out_r = []
    let i = 0
    for i < n
        let op = mf_poles(mmm)[i]
        out_p = out_p.push(op)
        out_r = out_r.push(mmm_apply(op))
        i = i + 1
    mf_make(out_p, out_r, n)

let verify_t12() =
    let mmm = mmm_compiler()
    let mmm_compiled = mmm_compile_self()
    mf_equal(mmm, mmm_compiled)

let verify_t13() =
    let mmm = mmm_compiler()
    let n = mf_size(mmm)
    let has_observe = 0
    let i = 0
    for i < n
        if mf_poles(mmm)[i] == 0
            has_observe = 1
        i = i + 1
    let fp = mmm_compiler_fp()
    let has_fp = 0
    let j = 0
    for j < n
        if mf_poles(mmm)[j] == 0
            if mf_residues(mmm)[j] == fp
                has_fp = 1
        j = j + 1
    gf_mul(has_observe, has_fp)

let verify_t14() =
    let mmm = mmm_compiler()
    let n = mf_size(mmm)
    let has_meta = 0
    let has_high = 0
    let i = 0
    for i < n
        if mf_poles(mmm)[i] == 4
            has_meta = 1
        if mf_poles(mmm)[i] == 7
            has_high = 1
        i = i + 1
    gf_mul(has_meta, has_high)

let mmm_galois_t12(sigma) =
    let mmm = mmm_compiler()
    let mutated = galois_mutate(mmm, sigma)
    let n1 = mf_size(mmm)
    let n2 = mf_size(mutated)
    let result = 0
    if n1 == n2
        result = 1
    result

let mmm_homology_check() =
