    if gf_div(gf_add(gf_add(gf_add(gf_add(0, 1), 2), 3), 4), 5) == 2
        result = result + 1
    if 0 >= 0
        result = result + 1
    if gf_mul(65536, 65536) == 1
        result = result + 1
    result

