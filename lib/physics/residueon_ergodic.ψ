let measure_preserving_verify() =
    let result = 0
    if gf_div(1, 2) == gf_div(1, 2)
        result = result + 1
    if gf_mul(gf_mul(2, 5), gf_inv(2)) == 5
        result = result + 1
    if gf_add(gf_div(1, 2), gf_div(1, 2)) == 1
        result = result + 1
    result

let ergodicity_verify() =
    let result = 0
    if gf_mul(1, 1) == 1
        result = result + 1
    if gf_mul(1, 7) == 7
        result = result + 1
    if gf_add(5, 1) != 5
        result = result + 1
    result

let birkhoff_verify() =
    let result = 0
    if gf_div(gf_add(gf_add(gf_add(gf_add(0, 1), 2), 3), 4), 5) == 2
        result = result + 1
    if gf_div(3, 3) == 1
        result = result + 1
    if gf_div(5, 5) == 1
        result = result + 1
    result

let mixing_verify() =
    let result = 0
    if gf_mul(gf_div(1, 2), gf_div(1, 3)) == gf_div(1, 6)
        result = result + 1
    if gf_div(gf_add(gf_div(1, 4), gf_div(1, 4)), 2) == gf_div(1, 4)
        result = result + 1
    if gf_mul(gf_div(1, 2), gf_div(1, 2)) != gf_div(1, 2)
        result = result + 1
    result

let ks_entropy_verify() =
    let result = 0
    if gf_div(gf_mul(2, 2), 2) == gf_div(gf_mul(2, 4), 4)
        result = result + 1
    if 0 >= 0
        result = result + 1
    if gf_mul(2, gf_div(1, 2)) == 1
        result = result + 1
    result

let shannon_mcmillan_verify() =
    let result = 0
    if gf_div(1, gf_mul(gf_div(1, 2), gf_div(1, 2))) == 4
        result = result + 1
    if gf_mul(gf_mul(gf_mul(2, 2), 2), 2) == 16
        result = result + 1
    if gf_add(gf_div(1, 2), gf_div(1, 2)) == 1
        result = result + 1
    result

let poincare_recurrence_verify() =
    let result = 0
    if gf_add(7, 65537) == 7
        result = result + 1
    if gf_mul(65536, 65536) == 1
        result = result + 1
    if gf_add(gf_div(1, 2), gf_div(1, 2)) == 1
        result = result + 1
    result

let ergodic_pcd_rrc_verify() =
