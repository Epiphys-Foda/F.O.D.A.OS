import "../core/stdlib_lang2/gf_pre_0_302.ψ"

let fp_map(x, a, b) =
    let one_minus_a = wfc_sub(1, a)
    wfc_add(wfc_mul(one_minus_a, x), b)

let fp_exact(a, b) = wfc_mul(b, wfc_inv(a))

let fp_iterate(a, b, n) =
    let x = 0
    let i = 0
    for i < n
        x = fp_map(x, a, b)
        i = i + 1
    x

let verify_fixedpoint() =
    let pass = 1

    let x_star = fp_exact(2, 10)
    let f_x = fp_map(x_star, 2, 10)
    if f_x != x_star
        pass = 0

    let x2 = fp_exact(3, 15)
    let f2 = fp_map(x2, 3, 15)
    if f2 != x2
        pass = 0

    let x3 = fp_exact(4, 100)
    let f3 = fp_map(x3, 4, 100)
    if f3 != x3
        pass = 0

    pass

let verify_division() =
    let pass = 1

    if fp_exact(2, 10) != 5
        pass = 0
    if fp_exact(3, 15) != 5
        pass = 0
    if fp_exact(4, 100) != 25
        pass = 0
    if fp_exact(5, 50) != 10
        pass = 0
    if fp_exact(10, 100) != 10
        pass = 0
    if fp_exact(7, 21) != 3
        pass = 0

    pass

let verify_analytical_fp() =
    let pass = 1

    let pairs = 0

    let x1 = fp_exact(2, 10)
    if fp_map(x1, 2, 10) == x1
        pairs = pairs + 1

    let x2 = fp_exact(3, 15)
    if fp_map(x2, 3, 15) == x2
        pairs = pairs + 1

    let x3 = fp_exact(4, 100)
    if fp_map(x3, 4, 100) == x3
        pairs = pairs + 1

    let x4 = fp_exact(7, 21)
    if fp_map(x4, 7, 21) == x4
        pairs = pairs + 1

    let x5 = fp_exact(5, 50)
    if fp_map(x5, 5, 50) == x5
        pairs = pairs + 1

    if pairs != 5
        pass = 0
    pass

let verify_uniqueness() =
    let pass = 1

    let x1 = fp_exact(2, 10)
    if fp_map(x1, 2, 10) != x1
        pass = 0
    if fp_map(4, 2, 10) == 4
        pass = 0
    if fp_map(6, 2, 10) == 6
        pass = 0

    pass

let verify_equation_solving() =
    let pass = 1

    if fp_exact(3, 21) != 7
        pass = 0

    let b_minus_c = wfc_sub(20, 5)
    if fp_exact(3, b_minus_c) != 5
        pass = 0

    if fp_exact(7, 49) != 7
        pass = 0

    if fp_exact(11, 121) != 11
        pass = 0

    pass

let verify_combination() =
    let pass = 1

    let lhs = fp_exact(3, wfc_add(6, 9))
    let rhs = wfc_add(fp_exact(3, 6), fp_exact(3, 9))
    if lhs != rhs
        pass = 0

    pass

let main() =
    let result = 0
    if verify_fixedpoint() == 1
        result = result + 1
    if verify_division() == 1
        result = result + 1
    if verify_analytical_fp() == 1
        result = result + 1
    if verify_uniqueness() == 1
        result = result + 1
    if verify_equation_solving() == 1
        result = result + 1
    if verify_combination() == 1
        result = result + 1
    result