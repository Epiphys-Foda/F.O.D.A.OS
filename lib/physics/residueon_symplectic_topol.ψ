let symplectic_manifold_verify() =
    let result = 0
    if gf_add(gf_sub(gf_mul(2, 7), gf_mul(3, 5)), gf_sub(gf_mul(5, 3), gf_mul(7, 2))) == 0
        result = result + 1
    if gf_sub(gf_mul(2, gf_neg(2)), gf_mul(3, 3)) == gf_neg(13)
        result = result + 1
    if gf_sub(gf_mul(3, 1), gf_mul(1, 1)) == gf_add(gf_mul(3, gf_sub(gf_mul(1, 1), gf_mul(0, 1))), gf_sub(gf_mul(0, 1), gf_mul(1, 1)))
        result = result + 1
    result

let hamilton_vector_verify() =
    let result = 0
    if gf_sub(gf_mul(2, 0), gf_mul(gf_neg(3), 1)) == 3
        result = result + 1
    if gf_sub(gf_mul(2, 3), gf_mul(3, 2)) == 0
        result = result + 1
    if gf_add(gf_mul(1, 1), gf_mul(gf_neg(1), 1)) == 0
        result = result + 1
    result

let maslov_index_verify() =
    let result = 0
    if gf_add(5, 7) == 12
        result = result + 1
    if gf_add(7, gf_neg(7)) == 0
        result = result + 1
    if gf_add(0, 11) == 11
        result = result + 1
    result

let arnold_conjecture_verify() =
    let result = 0
    if gf_add(gf_add(1, 0), 1) == 2
        result = result + 1
    if gf_add(gf_add(gf_add(1, 2), 1), 0) == 4
        result = result + 1
    if gf_add(gf_add(1, 1), 1) == 3
        result = result + 1
    result

let floer_homology_verify() =
    let result = 0
    if gf_mul(0, 0) == 0
        result = result + 1
    if gf_sub(gf_sub(5, 3), 1) == 1
        result = result + 1
    if gf_sub(1, 1) == 0
        result = result + 1
    result

let gromov_nonsqueezing_verify() =
    let result = 0
    if gf_sub(gf_mul(4, 4), gf_mul(2, 2)) == 12
        result = result + 1
    if gf_add(gf_mul(2, 2), gf_mul(2, 2)) == gf_mul(2, 4)
        result = result + 1
    if gf_mul(4, 4) == 16
        result = result + 1
    result

let lagrangian_verify() =
    let result = 0
    if gf_sub(gf_mul(1, 0), gf_mul(0, 1)) == 0
        result = result + 1
    if gf_sub(gf_mul(3, 3), gf_mul(3, 3)) == 0
        result = result + 1
    if gf_sub(gf_mul(2, 3), gf_mul(3, 2)) == 0
        result = result + 1
    result

