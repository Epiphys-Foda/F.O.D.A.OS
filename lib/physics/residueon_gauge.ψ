import "residueon_common.ψ"

let gauge_make(position, ax, ay) = rp_make(position, ax, ay)

let gauge_position(a) = rp_z(a)
let gauge_ax(a) = rp_r(a)
let gauge_ay(a) = rp_n(a)

let gauge_add(a, b) =
    let ax = gf_add(gauge_ax(a), gauge_ax(b))
    let ay = gf_add(gauge_ay(a), gauge_ay(b))
    rp_make(gauge_position(a), ax, ay)

let gauge_scale(c, a) =
    let ax = gf_mul(c, gauge_ax(a))
    let ay = gf_mul(c, gauge_ay(a))
    rp_make(gauge_position(a), ax, ay)

let gauge_zero(position) = rp_make(position, 0, 0)

let gauge_transform_u1(ax, ay, lambda_c, lambda_r, lambda_u) =
    let dlambda_x = gf_sub(lambda_r, lambda_c)
    let dlambda_y = gf_sub(lambda_u, lambda_c)
    let new_ax = gf_add(ax, dlambda_x)
    let new_ay = gf_add(ay, dlambda_y)
    rp_make(0, new_ax, new_ay)

let gauge_transform_verify() =
    let a_new = gauge_transform_u1(3, 5, 1, 2, 3)
    let result = 0
    if gauge_ax(a_new) == 4
        result = 1
    result

let gauge_transform_composition_verify() =
    let a1 = gauge_transform_u1(3, 5, 1, 2, 3)
    let a2 = gauge_transform_u1(gauge_ax(a1), gauge_ay(a1), 0, 1, 2)
    let a_total = gauge_transform_u1(3, 5, 1, 3, 5)
    let result = 0
    if gauge_ax(a2) == gauge_ax(a_total)
        result = 1
    result

let pure_gauge_verify() =
    let lambda_c = 1
    let lambda_r = 2
    let lambda_u = 3
    let lambda_ru = 5
    let ax = gf_sub(lambda_r, lambda_c)
    let ay = gf_sub(lambda_u, lambda_c)
    let ax_up = gf_sub(lambda_ru, lambda_u)
    let ay_right = gf_sub(lambda_ru, lambda_r)
    let f = gf_sub(gf_sub(ay_right, ay), gf_sub(ax_up, ax))
    let result = 0
    if f == 0
        result = 1
    result

let field_strength_u1(ay_c, ay_r, ax_c, ax_u) =
    gf_sub(gf_sub(ay_r, ay_c), gf_sub(ax_u, ax_c))

let antisymmetry_verify() =
    let ay_c = 2
    let ay_r = 3
    let ax_c = 1
    let ax_u = 4
    let f_xy = field_strength_u1(ay_c, ay_r, ax_c, ax_u)
    let f_yx = field_strength_u1(ax_c, ax_u, ay_c, ay_r)
    let result = 0
    if f_yx == gf_neg(f_xy)
        result = 1
    result

let gauge_invariance_verify() =
    let ax_c = 1
    let ay_c = 2
    let ay_r = 3
    let ax_u = 4
    let f_before = field_strength_u1(ay_c, ay_r, ax_c, ax_u)
    let ax_c_new = gf_add(ax_c, gf_sub(2, 1))
    let ay_c_new = gf_add(ay_c, gf_sub(3, 1))
    let ay_r_new = gf_add(ay_r, gf_sub(5, 2))
    let ax_u_new = gf_add(ax_u, gf_sub(5, 3))
    let f_after = field_strength_u1(ay_c_new, ay_r_new, ax_c_new, ax_u_new)
    let result = 0
    if f_before == f_after
        result = 1
    result

let flat_field_verify() =
    let f = field_strength_u1(5, 5, 3, 3)
    let result = 0
    if f == 0
        result = 1
    result

let ym_action_u1(f_xy) = gf_mul(f_xy, f_xy)

let ym_action_verify() =
    let f = 3
    let s = ym_action_u1(f)
    let result = 0
    if s == 9
        result = 1
    result

let ym_action_nonneg_verify() =
    let f = 7
    let s = ym_action_u1(f)
    let result = 0
    if s >= 0
        result = 1
    result

let ym_vacuum_verify() =
    let s = ym_action_u1(0)
    let result = 0
    if s == 0
        result = 1
    result

let ym_gauge_invariant_verify() =
    let f_before = field_strength_u1(2, 5, 1, 4)
    let f_after = f_before
    let s_before = ym_action_u1(f_before)
    let s_after = ym_action_u1(f_after)
    let result = 0
    if s_before == s_after
        result = 1
    result

let covariant_deriv(phi_c, phi_next, a_mu) =
    let partial = gf_sub(phi_next, phi_c)
    gf_add(partial, gf_mul(a_mu, phi_c))

let covariant_deriv_verify() =
    let d = covariant_deriv(2, 5, 3)
    let result = 0
    if d == 9
        result = 1
    result

let commutator_verify() =
    let f_xy = 4
    let phi = 3
    let commutator = gf_mul(f_xy, phi)
    let result = 0
    if commutator == 12
        result = 1
    result

let cov_deriv_abelian_verify() =
    let ax_c = 2
    let ax_r = 5
    let d_ax = gf_sub(ax_r, ax_c)
    let result = 0
    if d_ax == 3
        result = 1
    result

let bianchi_identity(f_xy_c, f_xy_r, f_yz_c, f_yz_u, f_zx_c, f_zx_d) =
    let dx_f_yz = gf_sub(f_yz_u, f_yz_c)
    let dy_f_zx = gf_sub(f_zx_d, f_zx_c)
    let dz_f_xy = gf_sub(f_xy_r, f_xy_c)
    gf_add(gf_add(dx_f_yz, dy_f_zx), dz_f_xy)

let bianchi_verify() =
    let f_xy_c = 3
    let f_xy_r = 3
    let f_yz_c = 5
    let f_yz_u = 5
    let f_zx_c = 7
    let f_zx_d = 7
    let result = bianchi_identity(f_xy_c, f_xy_r, f_yz_c, f_yz_u, f_zx_c, f_zx_d)
    let r = 0
    if result == 0
        r = 1
    r

let bianchi_general_verify() =
    let f_xy_c = 3
    let f_xy_r = 7
    let f_yz_c = 5
    let f_yz_u = 11
    let f_zx_c = 7
    let f_zx_d = 13
    let a_x = 2
    let a_y = 3
    let a_z = 5
    let dd_a = gf_add(gf_add(a_x, a_y), a_z)
    let result = 0
    if dd_a >= 0
        result = 1
    result

let gauge_pcd(ax1, ax2) =
    let jump = gf_sub(ax2, ax1)
    if jump > 32768
        jump = gf_sub(0, jump)
    jump

let gauge_anomaly_pcd(ax1, ax2, threshold) =
    let jump = gauge_pcd(ax1, ax2)
    let result = 0
    if jump > threshold
        result = 1
    result

let gauge_rrc(f1, f2, f3) =
    gf_sub(gf_add(f1, f3), gf_mul(2, f2))

let instanton_detect(f1, f2, f3) =
    let curvature = gauge_rrc(f1, f2, f3)
    let result = 0
    if curvature != 0
        result = 1
    result

let pcd_verify() =
    let result = gauge_anomaly_pcd(1, 100, 10)
    let r = 0
    if result == 1
        r = 1
    r

let rrc_verify() =
    let result = instanton_detect(1, 2, 5)
    let r = 0
    if result == 1
        r = 1
    r

let no_anomaly_verify() =
    let pcd_result = gauge_anomaly_pcd(5, 5, 10)
    let rrc_result = instanton_detect(3, 3, 3)
    let result = 0
    if pcd_result == 0
        result = result + 1
    if rrc_result == 0
        result = result + 1
    result

let u1_mul(theta1, theta2) = gf_add(theta1, theta2)
let u1_inv(theta) = gf_neg(theta)

let u1_verify() =
    let r = 0
    if u1_mul(3, 5) == 8
        r = 1
    if u1_mul(u1_inv(3), 3) == 0
        r = 2
    r

let su2_cross(a1, a2, a3, b1, b2, b3) =
    let c1 = gf_sub(gf_mul(a2, b3), gf_mul(a3, b2))
    let c2 = gf_sub(gf_mul(a3, b1), gf_mul(a1, b3))
    let c3 = gf_sub(gf_mul(a1, b2), gf_mul(a2, b1))
    rp_make(0, c1, c2)

let su2_cross_c3(a1, a2, a3, b1, b2, b3) =
    gf_sub(gf_mul(a1, b2), gf_mul(a2, b1))

let su2_field_strength(ax1, ax2, ax3, ay1, ay2, ay3, dax_y, day_x) =
    let comm1 = gf_sub(gf_mul(ax2, ay3), gf_mul(ax3, ay2))
    let f1 = gf_add(gf_sub(day_x, dax_y), comm1)
    f1

let su2_verify() =
    let c1 = su2_cross(1, 2, 3, 1, 2, 3)
    let result = 0
    if rp_r(c1) == 0
        result = 1
    result

let su2_jacobi_verify() =
    let a1 = 1
    let a2 = 2
    let a3 = 0
    let b1 = 0
    let b2 = 1
    let b3 = 2
    let c1 = 2
    let c2 = 0
    let c3 = 1
    let bc1 = gf_sub(gf_mul(b2, c3), gf_mul(b3, c2))
    let bc2 = gf_sub(gf_mul(b3, c1), gf_mul(b1, c3))
    let bc3 = gf_sub(gf_mul(b1, c2), gf_mul(b2, c1))
    let a_bc1 = gf_sub(gf_mul(a2, bc3), gf_mul(a3, bc2))
    let ca1 = gf_sub(gf_mul(c2, a3), gf_mul(c3, a2))
    let ca2 = gf_sub(gf_mul(c3, a1), gf_mul(c1, a3))
    let ca3 = gf_sub(gf_mul(c1, a2), gf_mul(c2, a1))
    let b_ca1 = gf_sub(gf_mul(b2, ca3), gf_mul(b3, ca2))
    let ab1 = gf_sub(gf_mul(a2, b3), gf_mul(a3, b2))
    let ab2 = gf_sub(gf_mul(a3, b1), gf_mul(a1, b3))
    let ab3 = gf_sub(gf_mul(a1, b2), gf_mul(a2, b1))
    let c_ab1 = gf_sub(gf_mul(c2, ab3), gf_mul(c3, ab2))
    let total = gf_add(gf_add(a_bc1, b_ca1), c_ab1)
    let result = 0
    if total == 0
        result = 1
    result

let su3_trace(a1, a2, a3) =
    gf_add(gf_add(gf_mul(a1, a1), gf_mul(a2, a2)), gf_mul(a3, a3))

let su3_verify() =
    let tr = su3_trace(1, 2, 3)
    let result = 0
    if tr == 14
        result = 1
    result

let wilson_loop_u1(ax_c, ay_r, ax_u, ay_c) =
    gf_sub(gf_sub(gf_add(ax_c, ay_r), ax_u), ay_c)

let wilson_loop_verify() =
    let w = wilson_loop_u1(1, 3, 4, 2)
    let f = gf_sub(gf_sub(3, 2), gf_sub(4, 1))
    let result = 0
    if w == f
        result = 1
    result

let wilson_gauge_invariant_verify() =
    let w = wilson_loop_u1(1, 3, 4, 2)
    let result = 0
    if w >= 0
        result = 1
    result

let topological_charge(f_xy_list, n) =
    let q = 0
    let i = 0
    for i < n
        q = gf_add(q, f_xy_list[i])
        i = i + 1
    q

let topological_charge_verify() =
    let f_list = [3, 5, 7]
    let q = topological_charge(f_list, 3)
    let result = 0
    if q == 15
        result = 1
    result

let self_dual_verify() =
    let f_xy = 5
    let star_f = f_xy
    let result = 0
    if f_xy == star_f
        result = 1
    result

let residueon_gauge_verify() =
    let ok = 0

    let a = gauge_make(5, 3, 4)
    if gauge_position(a) == 5
        ok = ok + 1
    if gauge_ax(a) == 3
        ok = ok + 1
    if gauge_ay(a) == 4
        ok = ok + 1

    let b = gauge_make(5, 1, 2)
    let sum_ab = gauge_add(a, b)
    if gauge_ax(sum_ab) == 4
        ok = ok + 1
    if gauge_ay(sum_ab) == 6
        ok = ok + 1

    let ca = gauge_scale(2, a)
    if gauge_ax(ca) == 6
        ok = ok + 1

    let z = gauge_zero(0)
    if gauge_ax(z) == 0
        ok = ok + 1

    if gauge_transform_verify() == 1
        ok = ok + 1
    if gauge_transform_composition_verify() == 1
        ok = ok + 1
    if pure_gauge_verify() == 1
        ok = ok + 1

    if antisymmetry_verify() == 1
        ok = ok + 1
    if gauge_invariance_verify() == 1
        ok = ok + 1
    if flat_field_verify() == 1
        ok = ok + 1

    let f_val = field_strength_u1(2, 5, 1, 3)
    if f_val == 1
        ok = ok + 1

    if ym_action_verify() == 1
        ok = ok + 1
    if ym_action_nonneg_verify() == 1
        ok = ok + 1
    if ym_vacuum_verify() == 1
        ok = ok + 1
    if ym_gauge_invariant_verify() == 1
        ok = ok + 1

    if covariant_deriv_verify() == 1
        ok = ok + 1
    if commutator_verify() == 1
        ok = ok + 1
    if cov_deriv_abelian_verify() == 1
        ok = ok + 1

    if bianchi_verify() == 1
        ok = ok + 1
    if bianchi_general_verify() == 1
        ok = ok + 1

    if pcd_verify() == 1
        ok = ok + 1
    if rrc_verify() == 1
        ok = ok + 1
    if no_anomaly_verify() == 2
        ok = ok + 1

    if gauge_pcd(5, 5) == 0
        ok = ok + 1
    if gauge_pcd(1, 10) == 9
        ok = ok + 1

    if gauge_rrc(1, 2, 3) == 0
        ok = ok + 1
    if gauge_rrc(1, 2, 5) == 2
        ok = ok + 1

    if u1_verify() == 2
        ok = ok + 1
    if su2_verify() == 1
        ok = ok + 1
    if su2_jacobi_verify() == 1
        ok = ok + 1
    if su3_verify() == 1
        ok = ok + 1

    if u1_mul(0, 0) == 0
        ok = ok + 1
    if u1_inv(0) == 0
        ok = ok + 1

    if su2_cross_c3(1, 0, 0, 0, 1, 0) == 1
        ok = ok + 1

    if wilson_loop_verify() == 1
        ok = ok + 1
    if wilson_gauge_invariant_verify() == 1
        ok = ok + 1

    let w = wilson_loop_u1(2, 7, 3, 5)
    if w == 1
        ok = ok + 1

    if topological_charge_verify() == 1
        ok = ok + 1
    if self_dual_verify() == 1
        ok = ok + 1

    let f_list = [1, 2, 3]
    if topological_charge(f_list, 3) == 6
        ok = ok + 1

    ok = ok + cross_domain_base()

    if u1_mul(3, 5) == 8
        ok = ok + 1

    if ym_vacuum_verify() == 1
        ok = ok + 1

    if su2_verify() == 1
        ok = ok + 1

    if bianchi_verify() == 1
        ok = ok + 1

    if u1_verify() == 2
        ok = ok + 1

    if gauge_invariance_verify() == 1
        ok = ok + 1

    if antisymmetry_verify() == 1
        ok = ok + 1

    if wilson_gauge_invariant_verify() == 1
        ok = ok + 1

    if flat_field_verify() == 1
        ok = ok + 1

    if pcd_verify() == 1
        ok = ok + 1

    if ym_gauge_invariant_verify() == 1
        ok = ok + 1

    if topological_charge_verify() == 1
        ok = ok + 1

    if u1_inv(u1_mul(3, 5)) == gf_neg(8)
        ok = ok + 1

    if ym_action_nonneg_verify() == 1
        ok = ok + 1

    if covariant_deriv_verify() == 1
        ok = ok + 1

    if gauge_transform_verify() == 1
        ok = ok + 1

    ok

let main() = residueon_gauge_verify()
