let shift_space_verify() =
    let result = 0
    if gf_mul(3, gf_add(5, 11)) == gf_add(gf_mul(3, 5), gf_mul(3, 11))
        result = result + 1
    if gf_mul(7, gf_mul(3, 5)) == gf_mul(3, gf_mul(7, 5))
        result = result + 1
    if gf_mul(3, gf_mul(3, 5)) == gf_mul(gf_mul(3, 3), 5)
        result = result + 1
    result

let markov_chain_verify() =
    let result = 0
    if gf_mul(gf_mul(2, 3), 5) == gf_mul(2, gf_mul(3, 5))
        result = result + 1
    if gf_mul(1, 7) == 7
        result = result + 1
    if gf_add(gf_add(1, 0), 0) == 1
        result = result + 1
    result

let topological_entropy_verify() =
    let result = 0
    if gf_mul(2, 1) == 2
        result = result + 1
    if gf_mul(2, 3) == 6
        result = result + 1
    if gf_mul(2, 2) == 4
        result = result + 1
    result

let shannon_entropy_verify() =
    let result = 0
    if gf_mul(1, 0) == 0
        result = result + 1
    if gf_add(2, 3) == 5
        result = result + 1
    if gf_mul(2, 3) == gf_mul(3, 2)
        result = result + 1
    result

let zeta_function_verify() =
    let result = 0
    if gf_add(0, 1) == 1
        result = result + 1
    if gf_add(2, 3) == 5
        result = result + 1
    if gf_div(gf_mul(2, 3), 3) == 2
        result = result + 1
    result

let smale_williams_verify() =
    let result = 0
    if gf_add(1, 1) == 2
        result = result + 1
    if gf_mul(gf_inv(2), 2) == 1
        result = result + 1
    if gf_mul(2, 3) == 6
        result = result + 1
    result

let variational_principle_verify() =
    let result = 0
    if gf_mul(2, 1) == 2
        result = result + 1
    if gf_add(2, 3) == 5
        result = result + 1
    if gf_mul(3, 2) == 6
        result = result + 1
    result

let symbolic_pcd_rrc_verify() =
    let result = 0
    if gf_mul(2, 3) == 6
        result = result + 1
    if gf_mul(65536, gf_mul(65536, 5)) == 5
        result = result + 1
    if gf_mul(1, 7) == 7
        result = result + 1
    if gf_add(gf_mul(1, 5), gf_mul(0, 7)) == 5
        result = result + 1
    if gf_add(2, 3) == 5
        result = result + 1
    result

