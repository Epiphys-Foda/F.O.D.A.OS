let rp_eval(rp, z0) =
    let z = rp_z(rp)
    let r = rp_r(rp)
    let n = rp_n(rp)
    let dz = gf_sub(z0, z)
    let dz_n = gf_pow(dz, n)
    gf_mul(r, gf_inv(dz_n))

let rp_residue(rp) = rp_r(rp)

let rpf_eval(field, z0) =
    let primes = rpf_primes(field)
    let n = rpf_count(field)
    let total = 0
    let i = 0
    for i < n
        total = gf_add(total, rp_eval(primes[i], z0))
        i = i + 1
    total

let rpf_total_residue(field) =
