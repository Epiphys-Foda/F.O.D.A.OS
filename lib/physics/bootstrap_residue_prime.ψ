    let n = rpf_count(field)
    let total = 0
    let i = 0
    for i < n
        total = gf_add(total, rp_residue(primes[i]))
        i = i + 1
    total

let rpf_add(f1, f2) =
    let p1 = rpf_primes(f1)
    let n1 = rpf_count(f1)
    let p2 = rpf_primes(f2)
    let n2 = rpf_count(f2)
    let combined = []
    let i = 0
    for i < n1
        combined = combined.push(p1[i])
        i = i + 1
    let j = 0
    for j < n2
        combined = combined.push(p2[j])
        j = j + 1
    rpf_make(combined, gf_add(n1, n2))

let rpf_galois(field, sigma) =
    let primes = rpf_primes(field)
    let n = rpf_count(field)
    let new_primes = []
    let i = 0
    for i < n
        new_primes = new_primes.push(rp_galois(primes[i], sigma))
        i = i + 1
    rpf_make(new_primes, n)

let rpf_fingerprint(field) =
    let primes = rpf_primes(field)
    let n = rpf_count(field)
    let fp = 0
    let i = 0
    for i < n
        let rp = primes[i]
        fp = gf_add(gf_mul(fp, 31), rp_z(rp))
        fp = gf_add(gf_mul(fp, 37), rp_r(rp))
        fp = gf_add(gf_mul(fp, 41), rp_n(rp))
        i = i + 1
    fp

let rp_collide(rp1, rp2) =
    let z1 = rp_z(rp1)
    let z2 = rp_z(rp2)
    let r1 = rp_r(rp1)
    let r2 = rp_r(rp2)
    let dz = gf_sub(z1, z2)
    let dz_inv = gf_inv(dz)
    let phase_shift = gf_mul(gf_mul(r1, r2), dz_inv)
    let new_r1 = gf_add(r1, phase_shift)
    let new_r2 = gf_sub(r2, phase_shift)
    [rp_make(z1, new_r1, 1), rp_make(z2, new_r2, 1)]

