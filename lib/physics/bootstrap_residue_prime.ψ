let rp_add(rp1, rp2) =
    let z1 = rp_z(rp1)
    let z2 = rp_z(rp2)
    let r1 = rp_r(rp1)
    let r2 = rp_r(rp2)
    let n1 = rp_n(rp1)
    let n2 = rp_n(rp2)
    let result = rp1
    if z1 == z2
        if n1 == n2
            result = rp_make(z1, gf_add(r1, r2), n1)
    result

