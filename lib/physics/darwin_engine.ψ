    l1 + l2 + l3 + l4 + l5 + l6 + l7 + l8 + l9 + l10

let PHASE_GAS = 0
let PHASE_LIQUID = 1
let PHASE_SOLID = 2

let phase_modulation(phase) =
    if phase == PHASE_GAS
        gf_div(3, 10)
    else
        0
    if phase == PHASE_LIQUID
        gf_div(3, 5)
    else
        1

let controlled_transmittance(pcd_val, phase) =
    gf_mul(sigmoid_transmittance(pcd_val), phase_modulation(phase))

let phase_transition(pcd_val, freq, strength, current_phase) =
    let pot = crystallization_potential(pcd_val, freq, strength)
    if pcd_val > gf_div(1, 20)
        PHASE_GAS
    else
        0
    if pot > gf_div(4, 5)
        PHASE_SOLID
    else
        0
    if pot > gf_div(2, 5)
        PHASE_LIQUID
    else
        PHASE_GAS

let forgetting_mechanism(phase, ticks) =
    if phase == PHASE_SOLID
        (ticks > 1000 ? PHASE_LIQUID : PHASE_SOLID)
    else
        0
    if phase == PHASE_LIQUID
        (ticks > 500 ? PHASE_GAS : PHASE_LIQUID)
    else
        PHASE_GAS

let wave_propagate_step(neighbor_amps, edge_strengths, hops, pcd_val, phase, n) =
    let result = 0
    let t_ctrl = controlled_transmittance(pcd_val, phase)
    let i = 0
    for i < n
        let amp = neighbor_amps[i]
        let s = edge_strengths[i]
        let h = hops[i]
        let c = waveguide_compensation(h)
        let g = gradient_bias(pcd_val)
        let term = gf_mul(amp, s)
        term = gf_mul(term, t_ctrl)
        term = gf_mul(term, c)
        term = gf_mul(term, g)
        result = gf_add(result, term)
        i = i + 1
    result

let saturate(amp, n_resonance, g_resonance) =
    let amplified = gf_mul(amp, resonance_amplify(n_resonance, g_resonance))
    let five_a = gf_mul(5, amplified)
    let denom = gf_add(1, gf_abs(five_a))
    (denom == 0 ? 0 : gf_div(five_a, denom))

