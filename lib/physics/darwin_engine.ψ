let horizontal_inheritance(pcd_val, freq, strength) =
    let potential = gf_add(gf_add(gf_mul(gf_div(1, 2), gf_sub(1, pcd_val)), gf_mul(gf_div(3, 10), freq)), gf_mul(gf_div(1, 5), strength))
