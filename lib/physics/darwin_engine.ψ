let SIGMOID_ALPHA = 10
let SIGMOID_BETA = 3
let sigmoid_transmittance(pcd_val) =
    let x = gf_sub(SIGMOID_BETA, gf_mul(SIGMOID_ALPHA, pcd_val))
    if x > 32768
        0
    else
        if x < 32768
            65536
        else
            gf_div(1, 2)

let law4_sigmoid_center_test() =
    let pcd_center = gf_div(SIGMOID_BETA, SIGMOID_ALPHA)
    let t = sigmoid_transmittance(pcd_center)
    (gf_abs(gf_sub(t, gf_div(1, 2))) <= 1 ? 1 : 0)

let waveguide_compensation(h) =
    if h <= 1
        1
    else
        0
    if h == 2
        gf_div(1, 2)
    else
        0
    if h == 3
        gf_div(1, 2)
    else
        gf_div(1, 4)

let law5_waveguide_decay_test() =
    let c1 = waveguide_compensation(1)
    let c2 = waveguide_compensation(2)
    let c4 = waveguide_compensation(4)
    if c1 > c2
        (c2 > c4 ? 1 : 0)
    else
        0

let gradient_bias(pcd_val) =
    gf_add(1, gf_mul(2, gf_sub(1, pcd_val)))

let law6_gradient_monotone_test() =
    let g_low = gradient_bias(0)
    let g_high = gradient_bias(1)
    (g_low > g_high ? 1 : 0)

let resonance_amplify(n, g) =
    if n <= 0
        1
    else
        let log_n = 0
        let temp = n
        for temp > 1
            temp = temp / 2
            log_n = log_n + 1
        gf_add(1, gf_mul(g, gf_sub(log_n, 1)))

let law7_resonance_log_test() =
    let r1 = resonance_amplify(1, 1)
    let r10 = resonance_amplify(10, 1)
    (r10 >= r1 ? 1 : 0)

let crystallization_potential(pcd_val, freq, strength) =
    let c = gf_sub(1, pcd_val)
    gf_add(gf_add(gf_mul(gf_div(1, 2), c), gf_mul(gf_div(3, 10), freq)), gf_mul(gf_div(1, 5), strength))

let law8_crystal_bounded_test() =
    let p = crystallization_potential(0, 1, 1)
    (p <= 1 ? 1 : 0)

let law9_contradiction_not_crystal_test() =
    let high_pcd = gf_div(1, 10)
    let p = crystallization_potential(high_pcd, 1, 1)
    let p_coherent = crystallization_potential(0, 1, 1)
    (p < p_coherent ? 1 : 0)

let law10_asymptotic_convergence_test() =
    let p1 = crystallization_potential(0, gf_div(1, 1), 1)
    let p10 = crystallization_potential(0, gf_div(10, 10), 1)
    let p100 = crystallization_potential(0, gf_div(100, 100), 1)
    if p1 <= p10
        (p10 <= p100 ? 1 : 0)
    else
        0

let pcd_verify_all_laws() =
    let l1 = law1_pcd_range_test()
    let l2 = law2_inphase_min_test()
    let l3 = law3_cancellation_max_test()
