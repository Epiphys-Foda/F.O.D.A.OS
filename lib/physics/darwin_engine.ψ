let darwin_step(edges, pcd_vals, phases, fitnesses, n, t, barrier, delta_phi, amp, t0, t_cognitive) =
    let new_edges = []
    let i = 0
    for i < n
        let mutated_pcd = structural_mutation(pcd_vals[i], barrier, delta_phi, amp)
        let mutated_fitness = parametric_mutation(fitnesses[i], t, t0, t_cognitive)
        let selected = darwin_select(mutated_pcd, mutated_fitness)
        let inherited = vertical_inheritance(phases[i], mutated_pcd, selected)
        new_edges.push([edges[i], mutated_pcd, selected, inherited])
        i = i + 1
    new_edges

let darwin_engine_run(edges, pcd_vals, phases, fitnesses, n, max_iter, barrier, delta_phi, amp, t0, t_cognitive) =
    let curr_pcd = pcd_vals
    let curr_fit = fitnesses
    let t = 0
    for t < max_iter
        let step_result = darwin_step(edges, curr_pcd, phases, curr_fit, n, t, barrier, delta_phi, amp, t0, t_cognitive)
        let new_pcd = []
        let new_fit = []
        let i = 0
        for i < n
            new_pcd.push(step_result[i][1])
            new_fit.push(step_result[i][2])
            i = i + 1
        curr_pcd = new_pcd
        curr_fit = new_fit
        t = t + 1
    [curr_pcd, curr_fit]

let species_form(edges, pcd_vals, n, threshold) =
    let species = []
    let i = 0
    for i < n
        if pcd_vals[i] < threshold
            species.push(edges[i])
        i = i + 1
    species

