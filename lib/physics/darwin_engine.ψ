let sllas_state(edges, n, freq, strength, phase, ticks) =
    let l1_wave = edges
    let l2_pcd = pcd_compute(l1_wave, n)
    let l3_gate = controlled_transmittance(l2_pcd, phase)
    let l5_phase = phase_transition(l2_pcd, freq, strength, phase)
    let l5_forget = forgetting_mechanism(l5_phase, ticks)
    let l7_meaning = logic_firewall(l2_pcd)
