let verify_reconfig() =
    let pass = 1

    if verify_and() != 1
        pass = 0
    if verify_nand() != 1
        pass = 0

    if verify_or() != 1
        pass = 0
    if verify_nor() != 1
        pass = 0

    if verify_xor() != 1
        pass = 0
    if verify_xnor() != 1
        pass = 0

    pass

let verify_superposition() =
    let r = 32768
    let pass = 1

    let f0 = chaos_map(0, r)
    if f0 == 0
        pass = 0
    if f0 == 1
        pass = 0

    let f1 = chaos_map(1, r)
    if f1 == 0
        pass = 0
    if f1 == 1
        pass = 0

    pass

let main() =
    let result = 0
    if verify_and() == 1
        result = result + 1
    if verify_nand() == 1
        result = result + 1
    if verify_or() == 1
        result = result + 1
    if verify_nor() == 1
        result = result + 1
    if verify_xor() == 1
        result = result + 1
    if verify_xnor() == 1
        result = result + 1
    if verify_reconfig() == 1
        result = result + 1
    if verify_superposition() == 1
        result = result + 1
    result