import "../core/stdlib_lang2/gf_pre_0_302.ψ"

let chaos_map(x, r) =
    wfc_add(wfc_mul(x, x), r)

let chaos_iter(x0, r, n) =
    let x = x0
    let i = 0
    for i < n
        x = chaos_map(x, r)
        i = i + 1
    x

let chaos_gate(a, b, r, n, target) =
    let x0 = a + b
    let xn = chaos_iter(x0, r, n)
    (xn == target ? 1 : 0)

let verify_and() =
    let r = 32768
    let n = 2
    let target = 16396
    let pass = 1
    if chaos_gate(0, 0, r, n, target) != 0
        pass = 0
    if chaos_gate(0, 1, r, n, target) != 0
        pass = 0
    if chaos_gate(1, 0, r, n, target) != 0
        pass = 0
    if chaos_gate(1, 1, r, n, target) != 1
        pass = 0
    pass

