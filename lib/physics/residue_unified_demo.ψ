let table_exec(tab, rows) =
    let stack = arr_new_n(16)
    let sp = 0
    let i = 0
    for i < rows
        let z = tab[i * 3]
        let r = tab[i * 3 + 1]
        let n = tab[i * 3 + 2]
        if n == 0
            stack[sp] = r
            sp = sp + 1
        if n == 2
            sp = sp - 1
            let y = stack[sp]
            sp = sp - 1
            let x = stack[sp]
            let v = 0
            if z == 1
                v = x + y
            if z == 2
                v = x * y
            stack[sp] = v
            sp = sp + 1
        i = i + 1
    stack[0]

