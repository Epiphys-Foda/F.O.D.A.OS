let ym_la_to_su2(x) =
    let i = 256
    let xi = x[0]
    let yi = x[1]
    let zi = x[2]
    let off_diag_re = xi
    let off_diag_im = gf_mul(i, yi)
    [
        gf_add(1, zi),
        gf_add(off_diag_re, off_diag_im),
        gf_sub(off_diag_re, off_diag_im),
        gf_sub(1, zi)
    ]

let ym_wilson_loop(path_a, n) =
    let product = ym_la_to_su2(path_a[0])
    let i = 1
    for i < n
        product = ym_su2_mul(product, ym_la_to_su2(path_a[i]))
        i = i + 1
    ym_su2_trace(product)

let ym_wilson_loop_vacuum(n) =
    let zero_path = []
    let i = 0
    for i < n
        zero_path = zero_path.push(ym_la_zero())
        i = i + 1
    ym_wilson_loop(zero_path, n)

