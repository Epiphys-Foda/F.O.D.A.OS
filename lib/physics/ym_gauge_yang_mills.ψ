let ym_nonabelian_term(a_mu, a_nu) = ym_lie_bracket(a_mu, a_nu)
let ym_field_strength(da_munu, a_mu, a_nu) = ym_la_add(da_munu, ym_lie_bracket(a_mu, a_nu))
let ym_field_strength_pure(a_mu, a_nu) = ym_lie_bracket(a_mu, a_nu)

let ym_field_strength_antisym(da_munu, a_mu, a_nu) =
    let f_munu = ym_field_strength(da_munu, a_mu, a_nu)
    let f_numu = ym_field_strength(ym_la_scale(da_munu, gf_sub(0, 1)), a_nu, a_mu)
    ym_la_equal(f_munu, ym_la_scale(f_numu, gf_sub(0, 1)))

let ym_covariant_deriv(dx, a_mu, x) = ym_la_add(dx, ym_lie_bracket(a_mu, x))

let ym_jacobi(x, y, z) =
    let t1 = ym_lie_bracket(x, ym_lie_bracket(y, z))
    let t2 = ym_lie_bracket(y, ym_lie_bracket(z, x))
    let t3 = ym_lie_bracket(z, ym_lie_bracket(x, y))
    let sum = ym_la_add(ym_la_add(t1, t2), t3)
    ym_la_equal(sum, ym_la_zero())

let ym_bianchi_pure(a0, a1, a2) =
    let f12 = ym_field_strength_pure(a1, a2)
    let f20 = ym_field_strength_pure(a2, a0)
    let f01 = ym_field_strength_pure(a0, a1)
    let t0 = ym_lie_bracket(a0, f12)
    let t1 = ym_lie_bracket(a1, f20)
    let t2 = ym_lie_bracket(a2, f01)
    let sum = ym_la_add(ym_la_add(t0, t1), t2)
    ym_la_equal(sum, ym_la_zero())

let ym_bianchi_general(d_f12, d_f20, d_f01, a0, a1, a2) =
    let f12 = ym_field_strength_pure(a1, a2)
    let f20 = ym_field_strength_pure(a2, a0)
    let f01 = ym_field_strength_pure(a0, a1)
    let t0 = ym_la_add(d_f12, ym_lie_bracket(a0, f12))
    let t1 = ym_la_add(d_f20, ym_lie_bracket(a1, f20))
    let t2 = ym_la_add(d_f01, ym_lie_bracket(a2, f01))
    let sum = ym_la_add(ym_la_add(t0, t1), t2)
    ym_la_equal(sum, ym_la_zero())

let ym_ym_residual(d_f, a_mu, f_munu, j_nu) =
