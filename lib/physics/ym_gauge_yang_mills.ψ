let ym_su2_mul(m1, m2) =
    let a1 = m1[0]
    let b1 = m1[1]
    let c1 = m1[2]
    let d1 = m1[3]
    let a2 = m2[0]
    let b2 = m2[1]
    let c2 = m2[2]
    let d2 = m2[3]
    [
        gf_add(gf_mul(a1, a2), gf_mul(b1, c2)),
        gf_add(gf_mul(a1, b2), gf_mul(b1, d2)),
        gf_add(gf_mul(c1, a2), gf_mul(d1, c2)),
        gf_add(gf_mul(c1, b2), gf_mul(d1, d2))
    ]

let ym_su2_trace(m) = gf_add(m[0], m[3])
