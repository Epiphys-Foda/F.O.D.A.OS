let ym_lie_bracket(x, y) =
    let cx = gf_sub(gf_mul(x[1], y[2]), gf_mul(x[2], y[1]))
    let cy = gf_sub(gf_mul(x[2], y[0]), gf_mul(x[0], y[2]))
    let cz = gf_sub(gf_mul(x[0], y[1]), gf_mul(x[1], y[0]))
    [gf_mul(2, cx), gf_mul(2, cy), gf_mul(2, cz)]

let ym_la_add(x, y) = [gf_add(x[0], y[0]), gf_add(x[1], y[1]), gf_add(x[2], y[2])]
let ym_la_sub(x, y) = [gf_sub(x[0], y[0]), gf_sub(x[1], y[1]), gf_sub(x[2], y[2])]
let ym_la_scale(x, s) = [gf_mul(x[0], s), gf_mul(x[1], s), gf_mul(x[2], s)]
let ym_la_dot(x, y) = gf_add(gf_add(gf_mul(x[0], y[0]), gf_mul(x[1], y[1])), gf_mul(x[2], y[2]))
let ym_killing(x, y) = gf_mul(gf_sub(0, 2), ym_la_dot(x, y))

let ym_la_equal(x, y) =
    let result = 0
    if x[0] == y[0]
        if x[1] == y[1]
            if x[2] == y[2]
                result = 1
    result

let ym_la_zero() = [0, 0, 0]
let ym_e1() = [1, 0, 0]
