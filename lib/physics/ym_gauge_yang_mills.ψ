let ym_chern_simons(a0, a1, a2, da01, da12, da20) =
    let term1 = ym_killing(a0, da12)
    let term2 = ym_killing(a1, da20)
    let term3 = ym_killing(a2, da01)
    let aaa1 = ym_killing(a0, ym_lie_bracket(a1, a2))
    let aaa2 = ym_killing(a1, ym_lie_bracket(a2, a0))
    let aaa3 = ym_killing(a2, ym_lie_bracket(a0, a1))
    let two_thirds = gf_div(2, 3)
    gf_add(gf_add(gf_add(term1, term2), term3), gf_mul(two_thirds, gf_add(gf_add(aaa1, aaa2), aaa3)))

