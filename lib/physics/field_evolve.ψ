let field_step(ops_type, ops_data, n) =
    let changed = 0
    let stack = arr_new_n(n)
    let sp = 0
    let i = 0
    for i < n
        let t = ops_type[i]
        if t == 0
            stack[sp] = ops_data[i]
            sp = sp + 1
        if t == 1
            if sp >= 2
                let b = stack[sp - 1]
                let a = stack[sp - 2]
                sp = sp - 2
                let r = gf_mul(a, b)
                stack[sp] = r
                sp = sp + 1
                ops_data[i] = r
                changed = 1
        if t == 2
            if sp >= 2
                let b = stack[sp - 1]
                let a = stack[sp - 2]
                sp = sp - 2
                let r = gf_add(a, b)
                stack[sp] = r
                sp = sp + 1
                ops_data[i] = r
                changed = 1
        if t == 3
            if sp >= 1
                let a = stack[sp - 1]
                let r = gf_mul(a, 3)
                stack[sp - 1] = r
                ops_data[i] = r
                changed = 1
        if t == 4
            if sp >= 1
                let a = stack[sp - 1]
                let r = a
                if a > 32768
                    r = 0
                stack[sp - 1] = r
                ops_data[i] = r
                changed = 1
        if t == 5
            if sp >= 1
                let a = stack[sp - 1]
                let r = (65535 * a + 2) % 65537
                stack[sp - 1] = r
                ops_data[i] = r
                changed = 1
        i = i + 1
    changed

let field_evolve(ops_type, ops_data, n, max_steps) =
    let steps = 0
    let converged = 0
    for steps < max_steps
        let changed = field_step(ops_type, ops_data, n)
        if changed == 0
            converged = 1
            steps = max_steps
        steps = steps + 1
    let stack = arr_new_n(n)
    let sp = 0
    let i = 0
    for i < n
        let t = ops_type[i]
        if t == 0
            stack[sp] = ops_data[i]
            sp = sp + 1
        if t == 1
            if sp >= 2
                let b = stack[sp - 1]
                let a = stack[sp - 2]
                sp = sp - 2
                stack[sp] = gf_mul(a, b)
                sp = sp + 1
        if t == 2
            if sp >= 2
                let b = stack[sp - 1]
                let a = stack[sp - 2]
                sp = sp - 2
                stack[sp] = gf_add(a, b)
                sp = sp + 1
        if t == 3
            if sp >= 1
                stack[sp - 1] = (stack[sp - 1] * 3) % 65537
        if t == 4
            if sp >= 1
                let a = stack[sp - 1]
                if a > 32768
                    stack[sp - 1] = 0
        if t == 5
            if sp >= 1
                stack[sp - 1] = (65535 * stack[sp - 1] + 2) % 65537
        i = i + 1
    let result = 0
    if sp > 0
        result = stack[sp - 1]
    let out = arr_new_n(3)
    out[0] = result
    out[1] = steps
    out[2] = converged
    out

let residue_theorem_global(residues, n) =
    let sum = 0
    let i = 0
    for i < n
        sum = (sum + residues[i]) % 65537
        i = i + 1
    sum

let field_energy(residues, n) =
    let e = 0
    let i = 0
    for i < n
        let r = residues[i]
        e = (e + r * r) % 65537
        i = i + 1
    e

let field_gradient(poles, residues, n, k) =
    let grad = 0
    let z_k = poles[k]
    let r_k = residues[k]
    let j = 0
    for j < n
        if j != k
            let diff = (z_k + 65537 - poles[j]) % 65537
            let inv_diff = gf_inv(diff)
            let inv_diff2 = gf_mul(inv_diff, inv_diff)
            grad = (grad + r_k * inv_diff2) % 65537
        j = j + 1
    grad

let field_flow(poles, residues, n, eta) =
    let new_poles = arr_new_n(n)
    let i = 0
    for i < n
        let grad = field_gradient(poles, residues, n, i)
        let new_z = (poles[i] + eta * grad) % 65537
        new_poles[i] = new_z
        i = i + 1
    new_poles

let field_fixed_point(data1, data2, n) =
    let ok = 1
    let i = 0
    for i < n
        if data1[i] != data2[i]
            ok = 0
        i = i + 1
    ok

