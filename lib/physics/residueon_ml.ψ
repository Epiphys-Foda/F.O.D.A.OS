        ok = ok + 1

    if dropout_verify() == 2
        ok = ok + 1

    if sgd_verify() == 1
        ok = ok + 1

    if momentum_verify() == 1
        ok = ok + 1

    if regularized_loss_verify() == 1
        ok = ok + 1

