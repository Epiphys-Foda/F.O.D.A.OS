        result = 1
    result

let hash_avalanche_verify() =
    let x = 12345
    let y = 12346
    let h1 = simple_hash(x)
    let h2 = simple_hash(y)
    let result = 0
    if h1 != h2
        result = 1
    result

let residueon_hash(values, n) =
    let hash = 0
    let i = 0
    for i < n
        let v = values[i]
        hash = gf_add(gf_mul(hash, 31), v)
        i = i + 1
    simple_hash(hash)

let residueon_hash_verify() =
    let vals = [1, 2, 3]
    let h = residueon_hash(vals, 3)
    let result = 0
    if h >= 0
        result = 1
    result

let sign(message, private_key) = gf_mul(simple_hash(message), private_key)

let verify_signature(message, signature, private_key) =
    let expected = simple_hash(message)
    let computed = gf_div(signature, private_key)
    let result = 0
    if computed == expected
        result = 1
    result

let signature_verify() =
    let M = 12345
    let sk = 678
    let S = sign(M, sk)
    let result = verify_signature(M, S, sk)
    result

let signature_unforgeable_verify() =
    let M = 12345
    let sk1 = 111
    let sk2 = 222
    let S1 = sign(M, sk1)
    let S2 = sign(M, sk2)
    let result = 0
    if S1 != S2
        result = 1
    result

let zkp_commit(secret) = gf_pow(DH_GENERATOR(), secret)

let zkp_challenge() = 42

let zkp_response(secret, challenge, blinding) = gf_add(secret, gf_mul(challenge, blinding))

let zkp_verify_proof(commitment, response, challenge, public_blinding) =
    let lhs = gf_pow(DH_GENERATOR(), response)
    let y_c = gf_pow(public_blinding, challenge)
    let rhs = gf_mul(commitment, y_c)
    let result = 0
    if lhs == rhs
        result = 1
    result

let zkp_verify() =
    let secret = 12345
    let blinding = 678
    let public_blinding = gf_pow(DH_GENERATOR(), blinding)
    let C = zkp_commit(secret)
    let c = zkp_challenge()
    let r = zkp_response(secret, c, blinding)
    let valid = zkp_verify_proof(C, r, c, public_blinding)
    let result = 0
    if valid == 1
        result = 1
    result

let zkp_zero_knowledge_verify() =
    let secret = 12345
    let C = zkp_commit(secret)
    let result = 0
    if C >= 0
        result = 1
    result

