let residueon_encrypt(message, key) = gf_add(message, key)

let residueon_decrypt(ciphertext, key) = gf_sub(ciphertext, key)

let encrypt_decrypt_verify() =
    let M = 12345
    let K = 67890
    let C = residueon_encrypt(M, K)
    let M_recovered = residueon_decrypt(C, K)
    let result = 0
    if M_recovered == M
        result = 1
    result

let mul_encrypt(message, key) = gf_mul(message, key)

let mul_decrypt(ciphertext, key) = gf_div(ciphertext, key)

let mul_encrypt_verify() =
    let M = 12345
    let K = 678
    let C = mul_encrypt(M, K)
    let M_recovered = mul_decrypt(C, K)
    let result = 0
