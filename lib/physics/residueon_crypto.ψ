let DH_GENERATOR() = 3

let dh_public_key(private_key) = gf_pow(DH_GENERATOR(), private_key)

let dh_shared_secret(their_public, my_private) = gf_pow(their_public, my_private)

let dh_verify() =
    let a = 12345
    let b = 67890
    let A = dh_public_key(a)
    let B = dh_public_key(b)
    let K_alice = dh_shared_secret(B, a)
    let K_bob = dh_shared_secret(A, b)
    let result = 0
    if K_alice == K_bob
        result = 1
    result

