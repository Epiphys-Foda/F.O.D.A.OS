let lattice_basis() = [3, 5, 7]

let lattice_point(a, b, c) =
    let basis = lattice_basis()
    let b1 = basis[0]
    let b2 = basis[1]
    let b3 = basis[2]
    gf_add(gf_add(gf_mul(a, b1), gf_mul(b, b2)), gf_mul(c, b3))

let lattice_verify() =
    let p = lattice_point(2, 3, 1)
    let result = 0
    if p >= 0
        result = 1
    result

let closest_vector(target) =
    let basis = lattice_basis()
    let b1 = basis[0]
    let coeff = gf_div(target, b1)
    gf_mul(coeff, b1)

let cvp_verify() =
    let target = 10
    let closest = closest_vector(target)
    let result = 0
    if closest >= 0
        result = 1
    result

