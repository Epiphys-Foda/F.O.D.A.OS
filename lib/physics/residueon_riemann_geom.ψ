let riemann_metric_verify() =
    let result = 0
    if gf_add(gf_mul(2, 5), gf_mul(3, 7)) == gf_add(gf_mul(5, 2), gf_mul(7, 3))
        result = result + 1
    if gf_add(gf_mul(2, 2), gf_mul(3, 3)) == 13
        result = result + 1
    if gf_add(gf_mul(2, 2), gf_mul(3, 3)) == 13
        result = result + 1
    result

let levi_civita_verify() =
    let result = 0
    if gf_sub(5, 5) == 0
        result = result + 1
    if gf_sub(gf_sub(4, gf_mul(2, 1)), gf_mul(2, 1)) == 0
        result = result + 1
    if gf_mul(0, 1) == 0
        result = result + 1
    result

let curvature_tensor_verify() =
    let result = 0
    if gf_add(2, gf_neg(2)) == 0
        result = result + 1
    if gf_sub(2, 2) == 0
        result = result + 1
    if gf_add(gf_mul(1, 1), gf_mul(1, 1)) == 2
        result = result + 1
    result

let sectional_curvature_verify() =
    let result = 0
    if gf_add(gf_add(1, gf_neg(1)), 0) == 0
        result = result + 1
    if gf_sub(gf_mul(1, 1), gf_mul(0, 0)) == 1
        result = result + 1
    if gf_div(1, gf_mul(1, 1)) == 1
        result = result + 1
    result

let geodesic_verify() =
    let result = 0
    if gf_add(gf_neg(gf_mul(gf_mul(2, 3), 4)), gf_mul(gf_mul(2, 3), 4)) == 0
        result = result + 1
    if gf_add(2, 3) == 5
        result = result + 1
    if gf_add(gf_mul(3, 3), gf_mul(4, 4)) == 25
        result = result + 1
    result

let completeness_verify() =
    let result = 0
    if gf_sub(1, 1) == 0
        result = result + 1
    if gf_add(0, 5) == 5
        result = result + 1
    if gf_mul(4, 1) == 4
        result = result + 1
    result

let comparison_theorem_verify() =
    let result = 0
    if gf_sub(2, 1) == 1
        result = result + 1
    if gf_sub(2, 1) == 1
        result = result + 1
    if gf_mul(gf_sub(2, 1), 1) == 1
        result = result + 1
    result

