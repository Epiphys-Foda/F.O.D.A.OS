import "residueon_common.ψ"

let reidemeister_verify() =
    let result = 0
    if gf_add(2, 1) == 3
        result = result + 1
    if gf_add(1, gf_neg(1)) == 0
        result = result + 1
    if gf_sub(gf_add(gf_add(1, 2), 3), gf_add(gf_add(3, 2), 1)) == 0
        result = result + 1
    result

let jones_polynomial_verify() =
    let result = 0
    if gf_add(0, 1) == 1
        result = result + 1
    if gf_sub(gf_mul(1, 5), gf_mul(1, 5)) == gf_mul(gf_sub(1, 1), 7)
        result = result + 1
    if gf_add(gf_add(gf_neg(1), 1), 1) == 1
        result = result + 1
    result

let homflypt_verify() =
    let result = 0
    if gf_add(0, 1) == 1
        result = result + 1
    if gf_add(gf_mul(1, 3), gf_mul(1, 3)) == gf_mul(2, 3)
        result = result + 1
    if gf_add(gf_mul(1, 1), gf_neg(1)) == 0
        result = result + 1
    result

let kauffman_bracket_verify() =
    let result = 0
    if gf_add(0, 1) == 1
        result = result + 1
    if gf_neg(2) == 65535
        result = result + 1
    if gf_add(gf_mul(1, 5), gf_mul(1, 7)) == 12
        result = result + 1
    result

let knot_group_verify() =
    let result = 0
    if gf_sub(3, 3) == 0
        result = result + 1
    if gf_sub(1, 0) == 1
        result = result + 1
    if gf_sub(2, 1) == 1
        result = result + 1
    result

let knot_invariant_verify() =
    let result = 0
    if gf_sub(gf_add(gf_mul(2, 0), 1), 1) == 0
        result = result + 1
    if gf_sub(gf_add(gf_mul(2, 1), 2), 1) == 3
        result = result + 1
    if gf_div(gf_sub(gf_add(3, 1), 2), 2) == 1
        result = result + 1
    result

let alexander_polynomial_verify() =
    let result = 0
    if gf_add(gf_mul(1, 1), gf_neg(1)) == 0
        result = result + 1
    if gf_mul(gf_neg(1), gf_neg(1)) == 1
        result = result + 1
    if gf_add(gf_sub(1, 1), 1) == 1
        result = result + 1
    result

let knot_pcd_rrc_verify() =
    let result = 0
    if gf_sub(3, gf_add(1, gf_neg(1))) == 3
        result = result + 1
    if gf_sub(gf_mul(1, 4), gf_mul(1, 4)) == gf_mul(gf_sub(1, 1), 9)
        result = result + 1
    if gf_add(gf_add(gf_sub(1, 1), gf_sub(1, 1)), 1) == 1
        result = result + 1
    if gf_add(gf_sub(1, 1), 1) == 1
        result = result + 1
    if gf_neg(2) == 65535
        result = result + 1
    result

