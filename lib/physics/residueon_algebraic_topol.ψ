let fundamental_group_verify() =
    let result = 0
    if gf_add(1, 1) == 2
        result = result + 1
    if gf_add(2, 3) == gf_add(3, 2)
        result = result + 1
    if gf_add(gf_add(1, 1), 1) == 3
        result = result + 1
    result

let singular_homology_verify() =
    let result = 0
    if gf_add(3, gf_neg(3)) == 0
        result = result + 1
    if gf_mul(1, 1) == 1
        result = result + 1
    if gf_add(1, 0) == 1
        result = result + 1
    result

let cohomology_verify() =
    let result = 0
    if gf_add(5, gf_neg(5)) == 0
        result = result + 1
    if gf_mul(gf_add(2, 3), 5) == gf_add(gf_mul(2, 5), gf_mul(3, 5))
        result = result + 1
    if gf_mul(2, 3) == gf_mul(3, 2)
        result = result + 1
    result

let fiber_bundle_verify() =
    let result = 0
    if gf_mul(2, gf_inv(2)) == 1
        result = result + 1
    if gf_add(1, 2) == 3
        result = result + 1
    if gf_mul(gf_inv(3), 3) == 1
        result = result + 1
    result

let characteristic_class_verify() =
    let result = 0
    if gf_mul(1, 1) == 1
        result = result + 1
    if gf_add(gf_mul(1, 1), 0) == 1
        result = result + 1
    if gf_add(1, 1) == 2
        result = result + 1
    result

let spectral_sequence_verify() =
    let result = 0
    if gf_add(2, 3) == 5
        result = result + 1
    if gf_add(7, gf_neg(7)) == 0
        result = result + 1
    if gf_add(gf_add(1, 2), 3) == gf_add(1, gf_add(2, 3))
        result = result + 1
    result

let cw_complex_verify() =
    let result = 0
