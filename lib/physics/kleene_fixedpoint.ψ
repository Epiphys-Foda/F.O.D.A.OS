let vec_add(a, b, n) =
    let r = arr_new_n(n)
    let i = 0
    for i < n
        r[i] = (a[i] + b[i]) % 65537
        i = i + 1
    r

let vec_scale(a, s, n) =
    let r = arr_new_n(n)
    let i = 0
    for i < n
        r[i] = a[i] * s
        i = i + 1
    r

let vec_eq(a, b, n) =
    let ok = 1
    let i = 0
    for i < n
        if a[i] != b[i]
            ok = 0
        i = i + 1
    ok

