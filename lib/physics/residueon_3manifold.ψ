let three_manifold_verify() =
    let result = 0
    if gf_mul(1, 7) == 7
        result = result + 1
    if gf_div(6, 2) == 3
        result = result + 1
    if gf_mul(gf_mul(2, 3), 5) == gf_mul(2, gf_mul(3, 5))
        result = result + 1
    result

let witten_invariant_verify() =
    let result = 0
    if gf_mul(1, 1) == 1
        result = result + 1
    if gf_mul(2, 3) == 6
        result = result + 1
    if gf_mul(gf_mul(2, 3), 4) == gf_mul(2, gf_mul(3, 4))
        result = result + 1
    result

let tqft_verify() =
    let result = 0
    if gf_mul(1, 5) == 5
        result = result + 1
    if gf_mul(2, gf_add(3, 5)) == gf_add(gf_mul(2, 3), gf_mul(2, 5))
        result = result + 1
    if gf_mul(65536, 65536) == 1
        result = result + 1
    result

let wrt_invariant_verify() =
    let result = 0
    if gf_mul(1, 1) == 1
        result = result + 1
    if gf_add(gf_mul(3, 3), gf_mul(4, 4)) == 25
        result = result + 1
    if gf_div(gf_mul(6, 6), gf_mul(2, 2)) == gf_mul(3, 3)
        result = result + 1
    result

let heegaard_floer_verify() =
    let result = 0
    if gf_add(2, 2) == 4
        result = result + 1
    if gf_mul(gf_inv(5), 5) == 1
        result = result + 1
    if gf_div(gf_mul(2, 3), 2) == 3
        result = result + 1
    result

let prime_decomposition_verify() =
    let result = 0
    if gf_mul(gf_mul(2, 3), 5) == gf_mul(2, gf_mul(3, 5))
        result = result + 1
    if gf_mul(gf_inv(7), 7) == 1
        result = result + 1
    if gf_add(2, 3) == 5
        result = result + 1
    result

let geometrization_verify() =
    let result = 0
    if gf_mul(gf_mul(2, 2), 2) == 8
        result = result + 1
    if gf_mul(2, gf_add(3, 5)) == gf_add(gf_mul(2, 3), gf_mul(2, 5))
        result = result + 1
    if gf_mul(gf_inv(2), 2) == 1
        result = result + 1
    result

let three_manifold_pcd_rrc_verify() =
    let result = 0
