    let fp1 = rpf_fingerprint(bulk)
    let fp2 = rpf_fingerprint(reconstructed)
    let result = 0
    if fp1 == fp2
        result = 1
    result

let verify_information_conservation(bulk) =
    let boundary = bulk_to_boundary(bulk)
