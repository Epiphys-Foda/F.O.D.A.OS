let tunneling_probability(kappa, barrier_width) =
    let exponent = gf_mul(gf_mul(gf_sub(0, 2), kappa), barrier_width)
    gf_pow(2, exponent)

let tunneling_residue(rp, kappa, barrier_width) =
    let t_prob = tunneling_probability(kappa, barrier_width)
    let new_r = gf_mul(rp_r(rp), t_prob)
    rp_make(rp_z(rp), new_r, rp_n(rp))

let verify_tunneling(rp, kappa, barrier_width) =
    let tunneled = tunneling_residue(rp, kappa, barrier_width)
    let original_r = rp_r(rp)
    let tunneled_r = rp_r(tunneled)
    let result = 0
    if tunneled_r >= 0
        result = 1
    result

