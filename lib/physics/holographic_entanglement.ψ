let entanglement_entropy(field, subsystem_indices, n_sub) =
    let primes = rpf_primes(field)
    let s = 0
    let i = 0
    for i < n_sub
        let idx = subsystem_indices[i]
        let r = rp_r(primes[idx])
        s = gf_add(s, gf_mul(r, gf_sub(1, r)))
        i = i + 1
    s

let total_entropy(field) = rpf_entropy(field)

let minimal_surface_area(subsystem_indices, n_sub) = n_sub

let ryu_takayanagi_entropy(n_sub) = gf_div(n_sub, 4)

let verify_ryu_takayanagi(field, subsystem_indices, n_sub) =
    let s_entanglement = entanglement_entropy(field, subsystem_indices, n_sub)
    let s_rt = ryu_takayanagi_entropy(n_sub)
    let result = 0
    if s_entanglement >= 0
