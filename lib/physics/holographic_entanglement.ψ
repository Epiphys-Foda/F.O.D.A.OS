let schmidt_decompose(field) =
    let primes = rpf_primes(field)
    let n = rpf_count(field)
    let subsystem_a = []
    let subsystem_b = []
    let i = 0
    for i < n
        if i < gf_div(n, 2)
            subsystem_a = subsystem_a.push(primes[i])
        if i >= gf_div(n, 2)
            subsystem_b = subsystem_b.push(primes[i])
        i = i + 1
    [rpf_make(subsystem_a, gf_div(n, 2)), rpf_make(subsystem_b, gf_div(n, 2))]

let schmidt_rank(field) =
    let n = rpf_count(field)
    gf_div(n, 2)

