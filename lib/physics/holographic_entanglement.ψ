    let s_ab = entanglement_entropy(field, ab_indices, nab)
    let diff = gf_sub(s_a, s_b)
    let abs_diff = diff
    if diff < 0
        abs_diff = gf_sub(0, diff)
    let result = 0
    if abs_diff <= s_ab
        result = 1
    result

let verify_strong_subadditivity(field, ab_indices, nab, bc_indices, nbc, a_indices, na, c_indices, nc) =
