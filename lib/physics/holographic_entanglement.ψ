let bulk_field(primes, n) = rpf_make(primes, n)

let bulk_to_boundary(bulk) =
    let primes = rpf_primes(bulk)
    let n = rpf_count(bulk)
    let boundary_primes = []
    let i = 0
    for i < n
        let rp = primes[i]
        let z = rp_z(rp)
        let r = rp_r(rp)
        boundary_primes = boundary_primes.push(rp_make(z, r, 1))
        i = i + 1
    rpf_make(boundary_primes, n)

let boundary_to_bulk(boundary) =
    let primes = rpf_primes(boundary)
    let n = rpf_count(boundary)
    let bulk_primes = []
    let i = 0
    for i < n
        let rp = primes[i]
        bulk_primes = bulk_primes.push(rp_make(rp_z(rp), rp_r(rp), rp_n(rp)))
        i = i + 1
    rpf_make(bulk_primes, n)

let verify_holographic_duality(bulk) =
    let boundary = bulk_to_boundary(bulk)
