let double_slit_field() =
    let slit1 = rp_make(SLIT_1(), 10, 1)
    let slit2 = rp_make(SLIT_2(), 10, 1)
    rpf_make([slit1, slit2], 2)

let double_slit_intensity(field, x) =
    let g = rpf_eval(field, x)
    gf_mul(g, g)

let double_slit_interference(field, x) =
    let primes = rpf_primes(field)
    let rp1 = primes[0]
    let rp2 = primes[1]
    let g1 = rp_eval(rp1, x)
    let g2 = rp_eval(rp2, x)
    gf_mul(gf_mul(2, g1), g2)

let verify_residue_theorem(field) =
    let total_residue = rpf_total_residue(field)
    let primes = rpf_primes(field)
    let n = rpf_count(field)
    let manual_sum = 0
    let i = 0
    for i < n
        manual_sum = gf_add(manual_sum, rp_residue(primes[i]))
        i = i + 1
    let result = 0
    if total_residue == manual_sum
        result = 1
    result

