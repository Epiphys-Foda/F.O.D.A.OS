let field_gradient(r, n, k) =
    (2 * r[k]) % 65537

let field_gradient_descent(r, n, eta, out) =
    let i = 0
    for i < n
        let grad = field_gradient(r, n, i)
        let new_r = (r[i] + 65537 - eta * grad) % 65537
        out[i] = new_r
        i = i + 1

let field_global_solve(init, n, eta, max_steps, out) =
    let cur = arr_new_n(n)
    let i = 0
    for i < n
        cur[i] = init[i]
        i = i + 1
    let steps = 0
    let prev_energy = field_energy(cur, n)
    for steps < max_steps
        let next = arr_new_n(n)
        field_gradient_descent(cur, n, eta, next)
        let new_energy = field_energy(next, n)
        if new_energy == prev_energy
            steps = max_steps
        else
            prev_energy = new_energy
        let j = 0
        for j < n
            cur[j] = next[j]
            j = j + 1
        steps = steps + 1
    let k = 0
    for k < n
        out[k] = cur[k]
        k = k + 1
    prev_energy

