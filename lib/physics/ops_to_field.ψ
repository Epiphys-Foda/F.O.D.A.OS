let op_type_to_pole(op_type) =
    if op_type == 0
        127
    else
        0
    if op_type == 1
        101
    else
        0
    if op_type == 2
        103
    else
        0
    if op_type == 3
        107
    else
        0
    if op_type == 4
        109
    else
        0
    if op_type == 5
        113
    else
        127

let pole_to_op_type(base) =
    if base == 127
        0
    else
        0
    if base == 101
        1
    else
        0
    if base == 103
        2
    else
        0
    if base == 107
        3
    else
        0
    if base == 109
        4
    else
        0
    if base == 113
        5
    else
        0

let ops_to_field(ops_type, ops_data, n, poles, residues) =
    let i = 0
    for i < n
        let base = op_type_to_pole(ops_type[i])
        let pole = base + i * 1000
        poles[i] = pole
        residues[i] = ops_data[i]
        i = i + 1

let extract_residue(poles, residues, n, z_k) =
    let i = 0
    for i < n
        if poles[i] == z_k
            residues[i]
        i = i + 1
    0

let field_multiply(p1, r1, n1, p2, r2, n2, out_poles, out_residues) =
    let k = 0
    let i = 0
    for i < n1
        let collision_residue = 0
        let j = 0
        for j < n2
            let diff = (p1[i] + 65537 - p2[j]) % 65537
            let cross = r1[i] * r2[j] * gf_inv(diff)
            collision_residue = gf_add(collision_residue, cross)
            j = j + 1
        out_poles[k] = p1[i]
        out_residues[k] = collision_residue
        k = k + 1
        i = i + 1
    k

let field_add(p1, r1, n1, p2, r2, n2, out_poles, out_residues) =
    let k = 0
    let i = 0
    for i < n1
        out_poles[k] = p1[i]
        out_residues[k] = r1[i]
        k = k + 1
        i = i + 1
    let j = 0
    for j < n2
        out_poles[k] = p2[j]
        out_residues[k] = r2[j]
        k = k + 1
        j = j + 1
    k

let field_to_ops(poles, residues, n, out_type, out_data) =
    let i = 0
    for i < n
        let pole = poles[i]
        let base = pole % 1000
        let index = pole / 1000
        let op_type = pole_to_op_type(base)
        out_type[index] = op_type
        out_data[index] = residues[i]
        i = i + 1

let simulate(ops_type, ops_data, n) =
    let stack = arr_new_n(n)
    let sp = 0
    let i = 0
    for i < n
        let t = ops_type[i]
        if t == 0
            stack[sp] = ops_data[i]
            sp = sp + 1
        if t == 1
            if sp >= 2
                let b = stack[sp - 1]
                let a = stack[sp - 2]
                sp = sp - 2
                stack[sp] = gf_mul(a, b)
                sp = sp + 1
        if t == 2
            if sp >= 2
                let b = stack[sp - 1]
                let a = stack[sp - 2]
                sp = sp - 2
                stack[sp] = gf_add(a, b)
                sp = sp + 1
        if t == 3
            if sp >= 1
                let a = stack[sp - 1]
                stack[sp - 1] = gf_mul(a, 3)
        if t == 4
            if sp >= 1
                let a = stack[sp - 1]
                let projected = a
                if a > 32768
                    projected = 0
                stack[sp - 1] = projected
        if t == 5
            if sp >= 1
                let a = stack[sp - 1]
                stack[sp - 1] = (a * 65535 + 2) % 65537
        i = i + 1
    (sp > 0 ? stack[sp - 1] : 0)

let field_energy(residues, n) =
    let e = 0
    let i = 0
    for i < n
        let r = residues[i]
        e = (e + r * r) % 65537
        i = i + 1
    e

let field_ntt_fingerprint(residues, n) =
    let energy = 0
    let k = 0
    for k < n
        let re = 0
        let im = 0
        let j = 0
        for j < n
            let angle = (k * j) % n
            let w = gf_pow(3, angle * 65536 / n)
            re = (re + residues[j] * w) % 65537
            im = (im + residues[j] * gf_pow(256, angle * 65536 / n)) % 65537
            j = j + 1
        energy = (energy + re * re + im * im) % 65537
        k = k + 1
    energy

