let s5_mul(ar, as, br, bs) =
    let rr = ar * br + 5 * as * bs
    let rs = ar * bs + as * br
    let r = arr_new_n(2)
    r[0] = rr
    r[1] = rs
    r

let s5_pow(zr, zs, e) =
    let rr = 1
    let rs = 0
    let br = zr
    let bs = zs
    let ee = e
    for ee > 0
        if ee % 2 == 1
            let t = s5_mul(rr, rs, br, bs)
            rr = t[0]
            rs = t[1]
        let t2 = s5_mul(br, bs, br, bs)
        br = t2[0]
        bs = t2[1]
        ee = ee / 2
    let r = arr_new_n(2)
    r[0] = rr
    r[1] = rs
    r

