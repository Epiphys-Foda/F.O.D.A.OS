let elliptic_operator_verify() =
    let result = 0
    let sigma = 3
    if gf_mul(sigma, sigma) != 0
        result = result + 1
    let ker_dim = 2
    let coker_dim = 1
    if gf_add(ker_dim, coker_dim) == 3
        result = result + 1
    if gf_sub(ker_dim, coker_dim) == 1
        result = result + 1
    result

let index_verify() =
    let result = 0
    if gf_sub(2, 1) == 1
        result = result + 1
    if gf_neg(1) == 65536
        result = result + 1
    if gf_add(1, 2) == 3
        result = result + 1
    if gf_sub(1, 1) == 0
        result = result + 1
    result

let gauss_bonnet_verify() =
    let result = 0
    if gf_add(gf_sub(1, 0), 1) == 2
        result = result + 1
    if gf_add(gf_sub(1, 2), 1) == 0
        result = result + 1
    if gf_add(gf_sub(1, 0), 1) == 2
        result = result + 1
    result

let hirzebruch_rr_verify() =
    let result = 0
    if gf_sub(1, 0) == 1
        result = result + 1
    if gf_sub(1, 1) == 0
        result = result + 1
    if gf_sub(1, 2) == 65536
        result = result + 1
    result

let dirac_operator_verify() =
    let result = 0
    let s_plus_dim = 2
    let s_minus_dim = 2
    if s_plus_dim == s_minus_dim
        result = result + 1
    let ind_d = gf_sub(1, 0)
    if ind_d == 1
        result = result + 1
    if gf_sub(0, 0) == 0
        result = result + 1
    result

let todd_class_verify() =
    let result = 0
    let x1 = 1
    if gf_div(x1, 1) == 1
        result = result + 1
    if gf_div(1, 1) == 1
        result = result + 1
    if gf_sub(1, 1) == 0
        result = result + 1
    result

let chern_character_verify() =
    let result = 0
    let rank = 1
    if rank == 1
        result = result + 1
    if gf_mul(1, 1) == 1
        result = result + 1
    if gf_add(1, 1) == 2
        result = result + 1
    result

let index_pcd_rrc_verify() =
    let result = 0
