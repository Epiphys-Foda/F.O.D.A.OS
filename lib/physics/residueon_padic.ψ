let padic_valuation_verify() =
    let result = 0
    if gf_mul(2, 1) == 2
        result = result + 1
    if gf_add(1, 1) == 2
        result = result + 1
    if gf_add(2, 6) == 8
        result = result + 1
    result

let padic_absolute_verify() =
    let result = 0
    if gf_div(1, 2) == gf_div(1, 2)
        result = result + 1
    if gf_mul(gf_div(1, 2), gf_div(1, 2)) == gf_div(1, 4)
        result = result + 1
    if gf_mul(2, 4) == 8
        result = result + 1
    result

let padic_convergence_verify() =
