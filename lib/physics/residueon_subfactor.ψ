let von_neumann_verify() =
    let result = 0
    if gf_add(gf_add(1, 1), 1) == 3
        result = result + 1
    if gf_mul(3, 5) == gf_mul(5, 3)
        result = result + 1
    if gf_mul(1, 7) == 7
        result = result + 1
    result

let jones_index_verify() =
    let result = 0
    if gf_mul(gf_div(1, 1), 1) == 1
        result = result + 1
    if gf_mul(gf_div(1, 2), 2) == 1
        result = result + 1
    if gf_mul(2, 3) == 6
        result = result + 1
    result

let temperley_lieb_verify() =
    let result = 0
    if gf_mul(1, 1) == 1
        result = result + 1
    if gf_mul(gf_div(1, 4), 4) == 1
        result = result + 1
    if gf_mul(7, 11) == gf_mul(11, 7)
        result = result + 1
    result

let standard_invariant_verify() =
    let result = 0
    if gf_mul(gf_mul(2, 2), 1) == 4
        result = result + 1
    if gf_mul(3, gf_inv(3)) == 1
        result = result + 1
    if gf_mul(2, 1) == 2
        result = result + 1
    result

let jones_polynomial_verify() =
    let result = 0
    if gf_mul(1, 1) == 1
        result = result + 1
    if gf_sub(gf_add(1, 1), 1) == 1
        result = result + 1
    if gf_sub(gf_add(gf_pow(1, 1), gf_pow(1, 3)), gf_pow(1, 4)) == 1
        result = result + 1
    result

let haagerup_verify() =
    let result = 0
    if gf_mul(gf_div(1, 4), 4) == 1
        result = result + 1
    if gf_add(3, 0) == 3
        result = result + 1
    if gf_mul(3, 1) == 3
        result = result + 1
    result

let planar_algebra_verify() =
    let result = 0
    if gf_mul(2, 3) == gf_mul(3, 2)
        result = result + 1
    if gf_div(6, 4) == gf_div(3, 2)
        result = result + 1
    if gf_mul(5, gf_inv(5)) == 1
        result = result + 1
    result

let subfactor_pcd_rrc_verify() =
    let result = 0
