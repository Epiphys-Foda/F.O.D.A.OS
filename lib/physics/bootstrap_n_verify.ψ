let tower_level_fp(k) =
    let fp = g0_fingerprint()
    let i = 0
    for i < k
        fp = gf_add(gf_mul(fp, 31), gf_pow(fp, 2))
        i = i + 1
    fp

let tower_level_ops(k) =
    let ops = 4
    let i = 0
    for i < k
        ops = gf_mul(ops, 2)
        i = i + 1
    ops

let tower_level_compiler(k) =
    let n_ops = tower_level_ops(k)
    let base_fp = tower_level_fp(k)
    let poles = []
    let res = []
    let i = 0
    for i < n_ops
        if i < 8
            poles = poles.push(i)
        if i >= 8
            poles = poles.push(i)
        let r = base_fp
        if i == 0
            r = base_fp
        if i == 1
            r = gf_pow(base_fp, 2)
        if i == 2
            r = gf_pow(base_fp, 3)
        if i == 3
            r = gf_add(base_fp, 1)
        if i == 4
            r = gf_mul(base_fp, base_fp)
        if i == 5
            r = gf_pow(base_fp, 4)
        if i == 6
            r = gf_mul(gf_pow(base_fp, 2), gf_pow(base_fp, 3))
        if i == 7
            r = gf_add(gf_mul(base_fp, 31), 7)
        if i >= 8
            r = gf_add(base_fp, i)
        res = res.push(r)
        i = i + 1
    mf_make(poles, res, n_ops)

let tower_level_compile_self(k) =
    let compiler = tower_level_compiler(k)
    let n = mf_size(compiler)
    let base_fp = tower_level_fp(k)
    let out_p = []
    let out_r = []
    let i = 0
    for i < n
        let op = mf_poles(compiler)[i]
        out_p = out_p.push(op)
        let r = base_fp
        if op == 0
            r = base_fp
        if op == 1
            r = gf_pow(base_fp, 2)
        if op == 2
            r = gf_pow(base_fp, 3)
        if op == 3
            r = gf_add(base_fp, 1)
        if op == 4
            r = gf_mul(base_fp, base_fp)
        if op == 5
            r = gf_pow(base_fp, 4)
        if op == 6
            r = gf_mul(gf_pow(base_fp, 2), gf_pow(base_fp, 3))
        if op == 7
            r = gf_add(gf_mul(base_fp, 31), 7)
        if op >= 8
            r = gf_add(base_fp, op)
        out_r = out_r.push(r)
        i = i + 1
    mf_make(out_p, out_r, n)

let tower_level_verify(k) =
    let compiler = tower_level_compiler(k)
    let compiled = tower_level_compile_self(k)
    mf_equal(compiler, compiled)

let tower_verify_all(n) =
    let all_ok = 1
    let i = 1
    for i <= n
        let verify = tower_level_verify(i)
        if verify == 0
            all_ok = 0
        i = i + 1
    all_ok

let tower_fingerprint_chain(n) =
    let chain = []
    let i = 1
    for i <= n
        let compiler = tower_level_compiler(i)
        chain = chain.push(mf_fingerprint(compiler))
        i = i + 1
    chain

let tower_galois_verify(k, sigma) =
    let compiler = tower_level_compiler(k)
    let mutated = galois_mutate(compiler, sigma)
    let n = mf_size(mutated)
    let base_fp = tower_level_fp(k)
    let out_p = []
    let out_r = []
    let i = 0
    for i < n
        let op = mf_poles(mutated)[i]
        out_p = out_p.push(op)
        let r = base_fp
        if op == 0
            r = base_fp
        if op == 1
            r = gf_pow(base_fp, 2)
        if op == 2
            r = gf_pow(base_fp, 3)
        if op == 3
            r = gf_add(base_fp, 1)
        if op == 4
            r = gf_mul(base_fp, base_fp)
        if op == 5
            r = gf_pow(base_fp, 4)
        if op == 6
            r = gf_mul(gf_pow(base_fp, 2), gf_pow(base_fp, 3))
        if op == 7
            r = gf_add(gf_mul(base_fp, 31), 7)
        if op >= 8
            r = gf_add(base_fp, op)
        out_r = out_r.push(r)
        i = i + 1
    let compiled = mf_make(out_p, out_r, n)
    mf_equal(mutated, compiled)

