let rel_permille(num, den, actual) =
    let aden = abs_i(den)
    let diff = abs_i(num - actual * den)
    diff * 1000 / (aden * actual)

let permille(diff, rhs) =
    let pm = 0
    if rhs > 100000
        pm = diff / (rhs / 1000)
    if rhs <= 100000
        pm = diff * 1000 / rhs
    pm

