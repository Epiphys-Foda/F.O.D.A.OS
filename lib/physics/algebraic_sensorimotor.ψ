import "../core/stdlib_lang2/gf_pre_0_302.ψ"

let sense_light(photon, refractive_index) =
    gf_div(photon, refractive_index)

let act_sound(signal, amplitude) =
    gf_mul(amplitude, signal)

let feedback_refraction(sound_wave, base_refraction) =
    gf_add(base_refraction, sound_wave)

let sensorimotor_loop(photon, base_refraction, amplitude, steps) =
    let current_photon = photon
    let current_refraction = base_refraction
    let total_signal = 0
    let step = 0
    for step < steps
        let signal = sense_light(current_photon, current_refraction)
        let sound = act_sound(signal, amplitude)
        current_refraction = feedback_refraction(sound, base_refraction)
        total_signal = gf_add(total_signal, signal)
        current_photon = gf_add(current_photon, sound)
        step = step + 1
    total_signal

let learn_amplitude(photon, base_refraction, initial_amp, learning_steps) =
    let amp = initial_amp
    let best_signal = sensorimotor_loop(photon, base_refraction, amp, 5)
    let best_amp = amp
    let step = 0
    for step < learning_steps
        let new_amp = gf_add(amp, 1)
        let new_signal = sensorimotor_loop(photon, base_refraction, new_amp, 5)
        if new_signal < best_signal || best_signal == 0
            best_signal = new_signal
            best_amp = new_amp
        amp = new_amp
        step = step + 1
    best_amp

let multimodal_perceive(photon, phonon, thermal) =
    let visual = gf_mul(photon, 100)
    let auditory = gf_mul(phonon, 50)
    let tactile = gf_mul(thermal, 25)
    gf_add(gf_add(visual, auditory), tactile)

let proprioception(refraction, energy, entropy) =
    gf_add(gf_add(refraction, energy), entropy)

let sensorimotor_verify() =
    let ok = 0

    let s1 = sense_light(10, 2)
    if s1 == 5
        ok = ok + 1

    let a1 = act_sound(3, 4)
    if a1 == 12
        ok = ok + 1

    let f1 = feedback_refraction(5, 10)
    if f1 == 15
        ok = ok + 1

    let loop1 = sensorimotor_loop(10, 2, 3, 1)
    if loop1 == 5
        ok = ok + 1

    let loop5 = sensorimotor_loop(10, 2, 3, 5)
    if loop5 >= 0
        ok = ok + 1

    let learned = learn_amplitude(10, 2, 1, 3)
    if learned >= 0
        ok = ok + 1

    let mm = multimodal_perceive(1, 1, 1)
    if mm == 175
        ok = ok + 1

    let prop = proprioception(3, 5, 7)
    if prop == 15
        ok = ok + 1

    let loop10 = sensorimotor_loop(5, 1, 2, 10)
    if loop10 >= 0
        ok = ok + 1

    let zero_loop = sensorimotor_loop(0, 1, 1, 3)
    if zero_loop == 0
        ok = ok + 1

    ok

let main() = sensorimotor_verify()