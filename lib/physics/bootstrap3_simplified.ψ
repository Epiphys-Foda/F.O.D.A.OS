let simp_verify_t7() =
    let mc = meta_compiler()
    let mc_poles = mf_poles(mc)
    let mc_res = mf_residues(mc)
    let n = mf_size(mc)
    let has_observe = 0
    let has_g0_fp = 0
    let g0_fp = g0_fingerprint()
    let i = 0
    for i < n
        if mc_poles[i] == OP_OBSERVE()
            has_observe = 1
        if mc_poles[i] == OP_OBSERVE()
            if mc_res[i] == g0_fp
                has_g0_fp = 1
        i = i + 1
    gf_mul(has_observe, has_g0_fp)

let simp_verify_t8() =
    let mc = meta_compiler()
    let mc_poles = mf_poles(mc)
    let n = mf_size(mc)
    let has_meta = 0
    let has_self = 0
