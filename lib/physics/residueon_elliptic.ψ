let frobenius_verify() =
    let result = 0
    let fx = 7
    if gf_mul(fx, gf_inv(fx)) == 1
        result = result + 1
    let phi_at_1 = 1
    let ap_val = gf_neg(2)
    let pp_val = 5
    let char_at_1 = gf_add(gf_sub(gf_mul(phi_at_1, phi_at_1), gf_mul(ap_val, phi_at_1)), pp_val)
    if char_at_1 == 8
        result = result + 1
    let small_p = 5
    let count_small = 8
    let a_small = gf_sub(gf_add(small_p, 1), count_small)
    if a_small == gf_neg(2)
        result = result + 1
    result

let elliptic_pcd_rrc_verify() =
    let result = 0
