let weierstrass_verify() =
    let result = 0
    let a = 65536
    let b = 0
    let a3 = gf_mul(gf_mul(a, a), a)
    let disc_inner = gf_add(gf_mul(4, a3), gf_mul(27, gf_mul(b, b)))
    let delta = gf_mul(gf_neg(16), disc_inner)
    if delta == 64
        result = result + 1
    if delta != 0
        result = result + 1
    let four_a = gf_mul(4, a)
    let four_a_cubed = gf_mul(gf_mul(four_a, four_a), four_a)
    let j = gf_div(gf_mul(gf_neg(1728), four_a_cubed), delta)
    if j == 1728
        result = result + 1
    let px = 1
    let py = 0
    let lhs = gf_mul(py, py)
    let rhs = gf_add(gf_add(gf_mul(px, gf_mul(px, px)), gf_mul(a, px)), b)
    if lhs == rhs
        result = result + 1
    result

let group_law_verify() =
    let result = 0
    let px = 5
    if gf_add(0, px) == px
        result = result + 1
    if gf_add(3, gf_neg(3)) == 0
        result = result + 1
    let p1 = 7
    let p2 = 11
    if gf_add(p1, p2) == gf_add(p2, p1)
        result = result + 1
    result

let discriminant_j_verify() =
    let result = 0
    let aj = 2
    let a3j = gf_mul(gf_mul(aj, aj), aj)
    let dj = gf_mul(gf_neg(16), gf_mul(4, a3j))
    let faj = gf_mul(4, aj)
    let jj = gf_div(gf_mul(gf_neg(1728), gf_mul(gf_mul(faj, faj), faj)), dj)
    if jj == 1728
        result = result + 1
    let ak = 0
    let bk = 3
    let fak = gf_mul(4, ak)
    let fak3 = gf_mul(gf_mul(fak, fak), fak)
    let dk = gf_mul(gf_neg(16), gf_add(gf_mul(4, gf_mul(gf_mul(ak, ak), ak)), gf_mul(27, gf_mul(bk, bk))))
    let jk = gf_div(gf_mul(gf_neg(1728), fak3), dk)
    if jk == 0
        result = result + 1
    if gf_add(gf_mul(4, 0), gf_mul(27, 0)) == 0
        result = result + 1
    result

let modularity_verify() =
    let result = 0
    let mp = 5
    let count_E = 8
    let a_p = gf_sub(gf_add(mp, 1), count_E)
    if a_p == gf_neg(2)
        result = result + 1
    let a_n = 13
    if gf_mul(1, a_n) == a_n
        result = result + 1
    let l = 3
    let a_l = gf_sub(gf_add(l, 1), 4)
    if a_l == 0
        result = result + 1
    result

let mordell_verify() =
    let result = 0
    let torsion_order = 4
    if gf_mul(2, 2) == torsion_order
        result = result + 1
    let x0 = 0
    let x1 = 1
    let x2 = gf_neg(1)
    let r0 = gf_sub(gf_mul(x0, gf_mul(x0, x0)), x0)
    let r1 = gf_sub(gf_mul(x1, gf_mul(x1, x1)), x1)
    let r2 = gf_sub(gf_mul(x2, gf_mul(x2, x2)), x2)
    if gf_add(gf_add(r0, r1), r2) == 0
        result = result + 1
    let r = 0
    if gf_mul(r, r) == 0
        result = result + 1
    result

let hasse_verify() =
