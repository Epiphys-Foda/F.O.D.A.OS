    let a = 65536
    let a3 = gf_mul(gf_mul(a, a), a)
    let delta = gf_mul(gf_neg(16), gf_mul(4, a3))
    if delta != 0
        result = result + 1
    let four_a = gf_mul(4, a)
    let four_a_cubed = gf_mul(gf_mul(four_a, four_a), four_a)
    let j = gf_div(gf_mul(gf_neg(1728), four_a_cubed), delta)
    if j == 1728
        result = result + 1
    if 512 > 0
        result = result + 1
    let phi_r = 1
    let ap_r = 0
    let pp_r = 3
    let char_r = gf_add(gf_sub(gf_mul(phi_r, phi_r), gf_mul(ap_r, phi_r)), pp_r)
    if char_r == 4
        result = result + 1
    result

