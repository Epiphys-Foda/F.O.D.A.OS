import "residueon_common.ψ"

let cstar_identity_verify() =
    let result = 0
    if gf_mul(2, 2) == 4
        result = result + 1
    if gf_mul(2, 1) == 2
        result = result + 1
    if gf_mul(2, 3) == gf_mul(3, 2)
        result = result + 1
    result

let gns_verify() =
    let result = 0
    if gf_mul(1, 1) == 1
        result = result + 1
    if gf_mul(0, 0) == 0
        result = result + 1
    if gf_mul(2, 1) == 2
        result = result + 1
    result

let spectrum_verify() =
    let result = 0
    if gf_mul(1, 1) == 1
        result = result + 1
    if gf_mul(2, 2) == 4
        result = result + 1
    if gf_mul(0, 0) == 0
        result = result + 1
    result

let gelfand_transform_verify() =
    let result = 0
    if gf_mul(1, 1) == 1
        result = result + 1
    if gf_mul(2, 1) == 2
        result = result + 1
    if gf_mul(3, 1) == 3
        result = result + 1
    result

let positive_element_verify() =
    let result = 0
    if gf_mul(2, 2) == 4
        result = result + 1
    if gf_add(4, 9) == 13
        result = result + 1
    if gf_mul(2, 2) == 4
        result = result + 1
    result

let projection_verify() =
    let result = 0
    if gf_mul(1, 1) == 1
        result = result + 1
    if gf_mul(0, 0) == 0
        result = result + 1
    if gf_sub(1, 1) == 0
        result = result + 1
    result

let factor_verify() =
    let result = 0
    if gf_mul(1, 2) == gf_mul(2, 1)
        result = result + 1
    if gf_mul(1, 1) == 1
        result = result + 1
    if gf_mul(2, 2) == 4
        result = result + 1
    result

let cstar_pcd_rrc_verify() =
    let result = 0
    if gf_mul(2, 2) == 4
        result = result + 1
    if gf_mul(1, 1) == 1
        result = result + 1
    if gf_mul(1, 1) == 1
        result = result + 1
    if gf_mul(1, 1) == 1
        result = result + 1
    if gf_mul(2, 2) == 4
        result = result + 1
    result

