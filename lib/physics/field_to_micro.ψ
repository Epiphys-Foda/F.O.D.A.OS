let MUL_GF = 10
let ADD_ALU = 11
let NTT_OP = 12
let PROJ_BR = 13
let LAP_HE = 14
let NOP_DATA = 15

let op_to_micro(op_type) =
    if op_type == 0
        NOP_DATA
    else
        0
    if op_type == 1
        MUL_GF
    else
        0
    if op_type == 2
        ADD_ALU
    else
        0
    if op_type == 3
        NTT_OP
    else
        0
    if op_type == 4
        PROJ_BR
    else
        0
    if op_type == 5
        LAP_HE
    else
        NOP_DATA

let field_to_micro(ops_type, ops_data, n, micro_op, micro_a, micro_b, micro_out) =
    let i = 0
    for i < n
        micro_op[i] = op_to_micro(ops_type[i])
        micro_a[i] = ops_data[i]
        micro_b[i] = 0
        micro_out[i] = 0
        i = i + 1

let micro_execute(micro_op, micro_a, micro_b, n) =
    let stack = arr_new_n(n)
    let sp = 0
    let i = 0
    for i < n
        let op = micro_op[i]
        if op == NOP_DATA
            stack[sp] = micro_a[i]
            sp = sp + 1
        if op == MUL_GF
            if sp >= 2
                let b = stack[sp - 1]
                let a = stack[sp - 2]
                sp = sp - 2
                stack[sp] = gf_mul(a, b)
                sp = sp + 1
        if op == ADD_ALU
            if sp >= 2
                let b = stack[sp - 1]
                let a = stack[sp - 2]
                sp = sp - 2
                stack[sp] = gf_add(a, b)
                sp = sp + 1
        if op == NTT_OP
            if sp >= 1
                stack[sp - 1] = (stack[sp - 1] * 3) % 65537
        if op == PROJ_BR
            if sp >= 1
                let a = stack[sp - 1]
                if a > 32768
                    stack[sp - 1] = 0
        if op == LAP_HE
            if sp >= 1
                stack[sp - 1] = (65535 * stack[sp - 1] + 2) % 65537
        i = i + 1
    (sp > 0 ? stack[sp - 1] : 0)

