let symplectic_form_verify() =
    let result = 0
    let w12 = 1
    let w21 = 65536
    if gf_add(w12, w21) == 0
        result = result + 1
    let det_w = gf_sub(gf_mul(0, 0), gf_mul(w12, w21))
    if det_w == 1
        result = result + 1
    if gf_add(gf_neg(1), gf_add(1, 0)) == 0
        result = result + 1
    let w2_11 = gf_add(gf_mul(0, 0), gf_mul(1, 65536))
    if w2_11 == 65536
        result = result + 1
    result

let hamilton_verify() =
    let result = 0
    let q_dot = 4
    if q_dot == 4
        result = result + 1
    let p_dot = gf_neg(3)
    if p_dot == 65534
        result = result + 1
    let energy = gf_add(gf_mul(3, 3), gf_mul(4, 4))
    if energy == 25
        result = result + 1
    result

let poisson_verify() =
    let result = 0
    let qp = gf_sub(gf_mul(1, 1), gf_mul(0, 0))
    if qp == 1
        result = result + 1
    let pq = gf_sub(gf_mul(0, 0), gf_mul(1, 1))
    if pq == 65536
        result = result + 1
    if gf_sub(gf_mul(1, 4), gf_mul(0, 0)) == 4
        result = result + 1
    result

let canonical_transform_verify() =
    let result = 0
    let det = gf_add(gf_div(9, 25), gf_div(16, 25))
    if det == 1
        result = result + 1
    if gf_sub(gf_mul(2, 2), gf_mul(3, 1)) == 1
        result = result + 1
    if gf_sub(gf_mul(3, 4), gf_mul(4, 3)) == 0
        result = result + 1
    result

let liouville_verify() =
    let result = 0
    let jac = gf_sub(gf_mul(0, 0), gf_mul(1, 65536))
    if jac == 1
        result = result + 1
    if gf_sub(gf_mul(3, 2), gf_mul(5, 1)) == 1
        result = result + 1
    if gf_sub(gf_mul(3, 4), gf_mul(4, 3)) == 0
        result = result + 1
    result

let action_angle_verify() =
    let result = 0
    let J = gf_div(25, 2)
    if gf_mul(J, 2) == 25
        result = result + 1
    if gf_sub(gf_add(1, gf_div(1, 2)), gf_div(1, 2)) == 1
        result = result + 1
    if 6 > 0
        result = result + 1
    result

let hamilton_jacobi_verify() =
    let result = 0
    let dW_dq = 1
    if dW_dq == 1
        result = result + 1
    let H = gf_add(gf_div(1, 2), gf_div(9, 2))
    if H == 5
