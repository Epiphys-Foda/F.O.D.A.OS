let chain_complex_verify() =
    let result = 0
    let d1 = 2
    let d0 = 0
    if gf_mul(d0, d1) == 0
        result = result + 1
    if d1 == 2
        result = result + 1
    if d0 == 0
        result = result + 1
    if gf_mul(d0, 2) == 0
        result = result + 1
    result

let homology_group_verify() =
    let result = 0
    if gf_mul(2, 1) == 2
        result = result + 1
    if gf_div(10, 2) == 5
        result = result + 1
    if gf_sub(1, 0) == 1
        result = result + 1
    result

let exact_sequence_verify() =
    let result = 0
    if 2 % 2 == 0
        result = result + 1
    if gf_sub(1 % 2, 0 % 2) == 1
        result = result + 1
    if gf_mul(2, 4) == 8
        result = result + 1
    if gf_sub(1, 1) == 0
        result = result + 1
    result

let snake_lemma_verify() =
