let curio_target(visits, n) =
    let best = 0
    let bestv = 1000000
    let i = 0
    for i < n
        if visits[i] < bestv
            bestv = visits[i]
            best = i
        i = i + 1
    best

let is_novel(L, c1, c2, KL, K1, K2, nk) =
    let novel = 1
    let i = 0
    for i < nk
        let eq = 0
        if KL[i] == L
            if K1[i] == c1
                if K2[i] == c2
                    eq = 1
        novel = novel * (1 - eq)
        i = i + 1
    novel

