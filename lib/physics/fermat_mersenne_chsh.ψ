let c_mul(ar, ai, br, bi, m) =
    let rr = (ar * br + m * m - ai * bi) % m
    let ri = (ar * bi + ai * br) % m
    let r = arr_new_n(2)
    r[0] = rr
    r[1] = ri
    r

let c_pow(zr, zi, e, m) =
    let rr = 1
    let ri = 0
    let br = zr
    let bi = zi
    let ee = e
    for ee > 0
        if ee % 2 == 1
            let t = c_mul(rr, ri, br, bi, m)
            rr = t[0]
            ri = t[1]
        let t2 = c_mul(br, bi, br, bi, m)
        br = t2[0]
        bi = t2[1]
        ee = ee / 2
    let r = arr_new_n(2)
    r[0] = rr
    r[1] = ri
    r

let bell_E(C, S, ka, kb) =
    let ca = C[ka]
    let sa = S[ka]
    let cb = C[kb]
    let sb = S[kb]
    let a00 = (ca * cb + sa * sb) * 2040
    let a01 = (ca * (0 - sb) + sa * cb) * 2040
    let a10 = ((0 - sa) * cb + ca * sb) * 2040
    let a11 = ((0 - sa) * (0 - sb) + ca * cb) * 2040
    let p00 = a00 * a00
    let p01 = a01 * a01
    let p10 = a10 * a10
    let p11 = a11 * a11
    let e = p00 + p11 - p01 - p10
    e

