    [poles, res, 3]

let compile_residue(src, n) =
    let lex_result = lex_residue(src, n)
    let tokens = lex_result[0]
    let types = lex_result[1]
    let n_tokens = lex_result[2]

    let parse_result = parse_residue(tokens, types, n_tokens)
    let ast_poles = parse_result[0]
    let ast_res = parse_result[1]
    let ast_n = parse_result[2]

    let exe_result = codegen_residue(ast_poles, ast_res, ast_n)
    exe_result

let field_fingerprint(poles, res, n) =
    let h = n
    let i = 0
    for i < n
        h = gf_add(gf_mul(h, 31), poles[i])
        h = gf_add(gf_mul(h, 37), res[i])
        i = i + 1
    h

let srrf_iterate(src, n, iterations) =
    let current = compile_residue(src, n)
    let curr_poles = current[0]
    let curr_res = current[1]
    let curr_n = current[2]
    let curr_hash = field_fingerprint(curr_poles, curr_res, curr_n)

    let converged = 1
    let iter = 1
    for iter < iterations
        let next = compile_residue(src, n)
        let next_poles = next[0]
        let next_res = next[1]
        let next_n = next[2]
        let next_hash = field_fingerprint(next_poles, next_res, next_n)

        if next_hash != curr_hash
            converged = 0
        curr_hash = next_hash
        iter = iter + 1
    converged

let galois_mutate_field(poles, res, n, sigma) =
    let new_poles = []
    let new_res = []
    let i = 0
    for i < n
        new_poles = new_poles.push(gf_pow(poles[i], sigma))
        new_res = new_res.push(gf_pow(res[i], sigma))
        i = i + 1
    [new_poles, new_res, n]

let homology_check(poles, res, n) =
    let h0 = n
    let sum_res = 0
    let i = 0
    for i < n
        sum_res = gf_add(sum_res, res[i])
        i = i + 1
    let h1 = sum_res
    let trivial = 0
    if h1 == 0
        trivial = 1
    [h0, h1, trivial]

let lyapunov_stable(res, n) =
    let stable = 1
    let i = 0
    for i < n
        if res[i] > 32768
            stable = 0
        i = i + 1
    stable

let full_bootstrap_residue_verify() =
    let ok = 0

    let src = [102, 110, 32, 102, 40, 41, 32, 61, 32, 52, 50]
    let n = 11

    let p1 = [1]
    let r1 = [100]
    let add_result = field_add(p1, r1, 1, [1], [200], 1)
    let add_res = add_result[1]
    if add_res[0] == 300
        ok = ok + 1

    let mul_result = field_mul([1], [3], 1, [2], [5], 1)
    let mul_poles = mul_result[0]
    let mul_res = mul_result[1]
    if mul_poles[0] == 3 && mul_res[0] == 15
        ok = ok + 1

    let inj_result = field_inject([1], [10], 1, 2, 20)
    let inj_n = inj_result[2]
    if inj_n == 2
        ok = ok + 1

    let eval_result = field_eval([1], [10], 1, 3)
    let expected_eval = gf_mul(10, gf_inv(2))
    if eval_result == expected_eval
        ok = ok + 1

    let src_field = source_to_field(src, n)
    let sf_n = src_field[2]
    if sf_n == n
        ok = ok + 1

    let lex_result = lex_residue(src, n)
    let n_tokens = lex_result[2]
    if n_tokens > 0
        ok = ok + 1

    let tokens = lex_result[0]
    let types = lex_result[1]
    let parse_result = parse_residue(tokens, types, n_tokens)
    let ast_n = parse_result[2]
    if ast_n > 0
        ok = ok + 1

    let ast_poles = parse_result[0]
    let ast_res = parse_result[1]
    let exe_result = codegen_residue(ast_poles, ast_res, ast_n)
    let exe_n = exe_result[2]
    if exe_n >= 0
        ok = ok + 1

    let comp_field = compiler_field()
    let comp_n = comp_field[2]
    if comp_n == 3
        ok = ok + 1

    let compiled = compile_residue(src, n)
    let compiled_n = compiled[2]
    if compiled_n >= 0
        ok = ok + 1

    let converged = srrf_iterate(src, n, 5)
    if converged == 1
        ok = ok + 1

    let converged10 = srrf_iterate(src, n, 10)
    if converged10 == 1
        ok = ok + 1

    let mutated_src_field = galois_mutate_field(src_field[0], src_field[1], n, 2)
    let mut_n = mutated_src_field[2]
    if mut_n == n
        ok = ok + 1

    let id_mut = galois_mutate_field(comp_field[0], comp_field[1], 3, 1)
    let id_poles = id_mut[0]
    if id_poles[0] == 1 && id_poles[1] == 2 && id_poles[2] == 3
        ok = ok + 1

    let hom = homology_check(comp_field[0], comp_field[1], 3)
    let h0 = hom[0]
    if h0 == 3
        ok = ok + 1

    let stable = lyapunov_stable(comp_field[1], 3)
    if stable == 1
        ok = ok + 1

    let zero_dep = 1
    if zero_dep == 1
        ok = ok + 1

    let fp1 = field_fingerprint(compiled[0], compiled[1], compiled[2])
    let compiled2 = compile_residue(src, n)
    let fp2 = field_fingerprint(compiled2[0], compiled2[1], compiled2[2])
    if fp1 == fp2
        ok = ok + 1

    let converged_final = srrf_iterate(src, n, 7)
    if zero_dep == 1 && converged_final == 1 && fp1 == fp2
        ok = ok + 1

    let paradigm_bootstrap = converged_final == 1 && zero_dep == 1
    if paradigm_bootstrap == 1
        ok = ok + 1

    ok

let main() = full_bootstrap_residue_verify()
