let field_add(p1, r1, n1, p2, r2, n2) =
    let poles = []
    let res = []
    let n = 0
    let i = 0
    for i < n1
        poles = poles.push(p1[i])
        res = res.push(r1[i])
        n = n + 1
        i = i + 1
    let j = 0
    for j < n2
        let pz = p2[j]
        let pr = r2[j]
        let found = 0
        let k = 0
        for k < n
            if poles[k] == pz
                let old_r = res[k]
                res[k] = gf_add(old_r, pr)
                found = 1
            k = k + 1
        if found == 0
            poles = poles.push(pz)
            res = res.push(pr)
            n = n + 1
        j = j + 1
    [poles, res, n]

let field_mul(p1, r1, n1, p2, r2, n2) =
    let poles = []
    let res = []
    let n = 0
    let i = 0
    for i < n1
        let j = 0
        for j < n2
            let new_pole = gf_add(p1[i], p2[j])
            let new_res = gf_mul(r1[i], r2[j])
            let found = 0
            let k = 0
            for k < n
                if poles[k] == new_pole
                    let old_r = res[k]
                    res[k] = gf_add(old_r, new_res)
                    found = 1
                k = k + 1
            if found == 0
                poles = poles.push(new_pole)
                res = res.push(new_res)
                n = n + 1
            j = j + 1
        i = i + 1
    [poles, res, n]

let field_inject(poles, res, n, z_k, r_k) =
    let found = 0
    let i = 0
    for i < n
        if poles[i] == z_k
            let old_r = res[i]
            res[i] = gf_add(old_r, r_k)
            found = 1
        i = i + 1
    let result_poles = poles
    let result_res = res
    let result_n = n
    if found == 0
        result_poles = poles.push(z_k)
        result_res = res.push(r_k)
        result_n = n + 1
    [result_poles, result_res, result_n]

let field_eval(poles, res, n, z0) = domain_field_eval(poles, res, z0)

let source_to_field(src, n) =
    let poles = []
    let res = []
    let i = 0
    for i < n
        poles = poles.push(i + 1)
        res = res.push(src[i])
        i = i + 1
    [poles, res, n]

