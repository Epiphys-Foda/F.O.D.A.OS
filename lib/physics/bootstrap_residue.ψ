let lex_residue(src, n) =
    let src_field = source_to_field(src, n)
    let sf_poles = src_field[0]
    let sf_res = src_field[1]
    let sf_n = src_field[2]

    let tokens = []
    let token_types = []
    let n_tokens = 0
    let i = 0
    for i < n
        let c = src[i]
        if c >= 48 && c <= 57
            tokens = tokens.push(c)
            token_types = token_types.push(tok_type_number())
            n_tokens = n_tokens + 1
        else
            0
        if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95
            tokens = tokens.push(c)
            token_types = token_types.push(tok_type_ident())
            n_tokens = n_tokens + 1
        else
            0
        if c == 43 || c == 45 || c == 42 || c == 47 || c == 61
            tokens = tokens.push(c)
            token_types = token_types.push(tok_type_op())
            n_tokens = n_tokens + 1
        i = i + 1
    [tokens, token_types, n_tokens]

let meta_compose(p1, r1, n1, p2, r2, n2) = field_mul(p1, r1, n1, p2, r2, n2)

let meta_derivative(poles, res, n) =
    let new_res = []
    let i = 0
    for i < n
        new_res = new_res.push(gf_sub(0, res[i]))
        i = i + 1
    [poles, new_res, n]

let parse_residue(tokens, types, n) =
    let poles = []
    let res = []
    let np = 0
    let i = 0
    for i < n
        let pole = gf_add(i + 1, types[i])
        let r = tokens[i]
        let inj = field_inject(poles, res, np, pole, r)
        poles = inj[0]
        res = inj[1]
        np = inj[2]
        i = i + 1
    [poles, res, np]

let codegen_residue(poles, res, n) =
    let out_poles = []
    let out_res = []
    let out_n = 0
    let i = 0
    for i < n
        if res[i] != 0
            let inj = field_inject(out_poles, out_res, out_n, poles[i], res[i])
            out_poles = inj[0]
            out_res = inj[1]
            out_n = inj[2]
        i = i + 1
    [out_poles, out_res, out_n]

let compiler_field() =
    let poles = [1, 2, 3]
