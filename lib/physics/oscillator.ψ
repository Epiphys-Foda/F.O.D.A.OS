import "../core/stdlib_lang2/gf_pre_0_302.ψ"

let feedback(x, c) = wfc_add(wfc_mul(x, x), c)

let OSC_C = 65536

let verify_period2() =
    let pass = 1
    let f0 = feedback(0, OSC_C)
    if f0 != 65536
        pass = 0
    let f1 = feedback(65536, OSC_C)
    if f1 != 0
        pass = 0
    let f2_0 = feedback(feedback(0, OSC_C), OSC_C)
    if f2_0 != 0
        pass = 0
    let f2_1 = feedback(feedback(65536, OSC_C), OSC_C)
    if f2_1 != 65536
        pass = 0
    pass

let verify_square_wave() =
    let pass = 1
    let x = 0
    x = feedback(x, OSC_C)
    if x != 65536
        pass = 0
    x = feedback(x, OSC_C)
