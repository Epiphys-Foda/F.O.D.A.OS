let nf_gf_add(a, b) = gfadd(a, b)
let nf_gf_sub(a, b) = gfsub(a, b)
let nf_gf_neg(a) = (a == 0) ? 0 : (65537 - a)

let nf_gf_mul(a, b) = gfmul(a, b)

let nf_gf_inv(a) = gfinv(a)

let nf_gf_div(a, b) =
    if b == 0
        0
    else
        gfmul(a, gfinv(b))

let nf_gf_pow(a, n) = gfpow(a, n)

let gf_sqrt_pow2(k) =
    if (k & 1) == 0
        nf_gf_pow(2, k >> 1)
    else
        gf_tonelli_shanks(nf_gf_pow(2, k))

let gf_legendre(n) =
