let _ts_find_i(t, i, M) =
    if i >= M
        0
    else
        if nf_gf_pow(t, 1 << i) == 1
            i
        else
            _ts_find_i(t, i + 1, M)
let _ts_loop(M, c, t, R) =
    if t == 1
        R
    else
        let i = _ts_find_i(t, 1, M)
        let b = nf_gf_pow(c, 1 << (M - i - 1))
        let b2 = nf_gf_mul(b, b)
        _ts_loop(i, b2, nf_gf_mul(t, b2), nf_gf_mul(R, b))
