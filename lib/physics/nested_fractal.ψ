let _conway_poly_eval_acc(coeffs, x, n, i, acc, xp) =
    if i >= n
        acc
    else
        let term = nf_gf_mul(arr_get(coeffs, i), xp)
        _conway_poly_eval_acc(coeffs, x, n, i + 1, nf_gf_add(acc, term), nf_gf_mul(xp, x))

let prime_make(z, r, n) =
    let p = []
    p.push(z)
    p.push(r)
    p.push(n)
    p

let prime_z(p) =
    p[0]
let prime_r(p) =
    p[1]
let prime_n(p) =
    p[2]

let field_make_3(z1, r1, n1, z2, r2, n2) =
    let field = []
    let p1 = prime_make(z1, r1, n1)
    field.push(p1)
    let p2 = prime_make(z2, r2, n2)
    field.push(p2)
    field

let field_make_1(z, r, n) =
    let field = []
    let p = prime_make(z, r, n)
    field.push(p)
    field

let nf_field_eval(field, z0) =
    let total = 0
    let i = 0
    for i < len(field)
        let p = field[i]
        let z = p[0]
        let r = p[1]
        let order = p[2]
        if order < 1
            order = 1
        let dz = nf_gf_sub(z0, z)
        if dz == 0
            total = (total + r) % P
        if dz != 0
            let inv_dz = nf_gf_inv(dz)
            let inv_dz_n = nf_gf_pow(inv_dz, order)
            let term = r * inv_dz_n % P
            total = (total + term) % P
        i = i + 1
    total

let field_differentiate(field) =
    let out = []
    let i = 0
    for i < len(field)
        let p = field[i]
        let z = p[0]
        let r = p[1]
        let order = p[2]
        if order < 1
            order = 1
        let new_order = order + 1
        let neg_order = nf_gf_neg(order)
        let new_r = r * neg_order % P
        let np = prime_make(z, new_r, new_order)
        out.push(np)
        i = i + 1
    out

let field_integrate(field) =
    let out = []
    let i = 0
    for i < len(field)
        let p = field[i]
        let z = p[0]
        let r = p[1]
        let order = p[2]
        if order > 1
            let new_order = order - 1
            let denom = nf_gf_neg(order - 1)
            let new_r = nf_gf_div(r, denom)
            let np = prime_make(z, new_r, new_order)
            out.push(np)
        i = i + 1
    out

let field_diff_n(field, times) =
    let result = field
    let i = 0
    for i < times
        result = field_differentiate(result)
        i = i + 1
    result

let nprime_make(z, r, n, inner) =
    let p = []
    p.push(z)
    p.push(r)
    p.push(n)
    p.push(inner)
    p

let field_nest(field) =
    let out = []
    let i = 0
    for i < len(field)
        let p = field[i]
        let z = p[0]
        let r = p[1]
        let order = p[2]
        if order < 1
            order = 1
        let inner = field
        if order > 1
            inner = field_diff_n(field, order - 1)
        let np = nprime_make(z, r, order, inner)
        out.push(np)
        i = i + 1
    out

let field_unnest(nested_field) =
    let out = []
    let i = 0
    for i < len(nested_field)
        let p = nested_field[i]
        let z = p[0]
        let r = p[1]
        let order = p[2]
        let np = prime_make(z, r, order)
        out.push(np)
        i = i + 1
    out

let field_equal(f1, f2) =
    let match_val = 1
    if len(f1) != len(f2)
        match_val = 0
    let i = 0
    for i < len(f1)
        if i < len(f2)
            let p1 = f1[i]
            let p2 = f2[i]
            if p1[0] != p2[0]
                match_val = 0
            if p1[1] != p2[1]
                match_val = 0
            if p1[2] != p2[2]
                match_val = 0
        i = i + 1
    match_val

let field_spectral(field, k) =
    field_diff_n(field, k)

let field_spectral_dim(field, k) =
    let e_k = field_spectral(field, k)
    len(e_k)

let hausdorff_verify(n_copies, ratio_inv, dim) =
    let rhs = nf_gf_pow(ratio_inv, dim)
    (n_copies == rhs ? 1 : 0)

