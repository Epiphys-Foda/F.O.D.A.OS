let nf_gf_sqrt(n) =
    let x = gf_tonelli_shanks(n)
    if x == 0
        0
    else
        0
    if x > 32768
        65537 - x
    else
        x

let gf_p2_add(a, b) = gf_p2_make(nf_gf_add(gf_p2_re(a), gf_p2_re(b)), nf_gf_add(gf_p2_im(a), gf_p2_im(b)))
let gf_p2_sub(a, b) = gf_p2_make(nf_gf_sub(gf_p2_re(a), gf_p2_re(b)), nf_gf_sub(gf_p2_im(a), gf_p2_im(b)))
let gf_p2_mul(a, b) =
    let ar = gf_p2_re(a)
    let ai = gf_p2_im(a)
    let br = gf_p2_re(b)
    let bi = gf_p2_im(b)
    let re = nf_gf_add(nf_gf_mul(ar, br), nf_gf_mul(GF_P2_NONRES, nf_gf_mul(ai, bi)))
    let im = nf_gf_add(nf_gf_mul(ar, bi), nf_gf_mul(ai, br))
    gf_p2_make(re, im)
let gf_p2_norm(a) = nf_gf_sub(nf_gf_mul(gf_p2_re(a), gf_p2_re(a)), nf_gf_mul(GF_P2_NONRES, nf_gf_mul(gf_p2_im(a), gf_p2_im(a))))
let gf_p2_conj(a) = gf_p2_make(gf_p2_re(a), nf_gf_neg(gf_p2_im(a)))
let gf_p2_inv(a) =
    let n = gf_p2_norm(a)
    if n == 0
        gf_p2_make(0, 0)
    else
        let n_inv = nf_gf_inv(n)
        let c = gf_p2_conj(a)
        gf_p2_make(nf_gf_mul(gf_p2_re(c), n_inv), nf_gf_mul(gf_p2_im(c), n_inv))
let conway_poly_p2() =
