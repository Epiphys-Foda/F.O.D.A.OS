let bm_scan(s, n, T, C) = bm_discover(s, n, T, C)

let bm_predict(C, L, s, n) =
    let acc = 0
    let k = 1
    for k < L + 1
        acc = gf_add(acc, gf_mul(C[k], s[n - k]))
        k = k + 1
    gf_sub(0, acc)

