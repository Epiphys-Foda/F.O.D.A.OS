let residue_energy(arr, n) =
    let energy = 0
    let i = 0
    for i < n
        let v = arr[i]
        energy = energy + v * v
        i = i + 1
    energy

let poly_eval(coeffs, n, x) =
    let result = 0
    let i = n - 1
    for i >= 0
        result = result * x + coeffs[i]
        i = i - 1
    result

let find_roots(coeffs, n) =
    let roots = arr_new()
    let x = 0
    for x < 65537
        if poly_eval(coeffs, n, x) == 0
            roots = arr_push(roots, x)
            if len(roots) >= 8
                x = 65537
        x = x + 1
    roots

