let riemann_zeta_verify() =
    let result = 0
    if gf_mul(gf_inv(2), gf_inv(3)) == gf_inv(6)
        result = result + 1
    if gf_mul(gf_inv(2), 2) == 1
        result = result + 1
    if gf_div(1, gf_mul(2, 3)) == gf_div(gf_inv(2), 3)
        result = result + 1
    result

let prime_number_theorem_verify() =
    let result = 0
    if gf_div(6, 2) == 3
        result = result + 1
    if gf_div(10, 5) == 2
        result = result + 1
    if gf_mul(2, 3) == 6
        result = result + 1
    result

let riemann_hypothesis_verify() =
    let result = 0
    if gf_add(1, 1) == 2
        result = result + 1
    if gf_sub(65536, 65535) == 1
        result = result + 1
    if gf_mul(65536, 65536) == 1
        result = result + 1
    result

let dirichlet_l_verify() =
    let result = 0
    if gf_mul(gf_mul(2, 3), 5) == gf_mul(2, gf_mul(3, 5))
        result = result + 1
    if gf_div(gf_mul(2, 3), gf_mul(2, 5)) == gf_div(3, 5)
        result = result + 1
    if gf_mul(1, 7) == 7
        result = result + 1
    result

let euler_product_verify() =
    let result = 0
    if gf_mul(gf_inv(2), 2) == 1
        result = result + 1
    if gf_mul(gf_inv(3), 3) == 1
        result = result + 1
    if gf_mul(gf_inv(2), gf_inv(3)) == gf_inv(6)
        result = result + 1
    result

let functional_equation_verify() =
    let result = 0
    if gf_add(2, 65536) == 1
        result = result + 1
    if gf_add(5, gf_sub(1, 5)) == 1
        result = result + 1
    if gf_add(0, 1) == 1
        result = result + 1
    result

let bsd_conjecture_verify() =
    let result = 0
    if gf_mul(2, 3) == 6
        result = result + 1
    if gf_mul(gf_mul(2, 2), 2) == 8
        result = result + 1
    if gf_mul(65536, 65536) == 1
        result = result + 1
    result

let analytic_nt_pcd_rrc_verify() =
    let result = 0
