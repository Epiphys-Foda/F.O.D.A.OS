let multi_start_convergence(starts, n_starts, max_iter) =
    let omegas = []
    let i = 0
    for i < n_starts
        let result = omega_approximate(starts[i], max_iter)
        omegas.push(result[0])
        i = i + 1
    let all_converged = 1
    let j = 0
    for j < n_starts
        if desc_prn(omegas[j]) != 0
            all_converged = 0
        j = j + 1
    all_converged

let omega_residue_field(z, poles, residues, n) =
    let val = 0
    let i = 0
    for i < n
        let diff = gf_sub(z, poles[i])
        if diff != 0
            val = gf_add(val, gf_mul(residues[i], gf_inv(diff)))
        i = i + 1
    val

let omega_self_pole(omega, poles, residues, n) =
    let psi_omega = omega_residue_field(omega, poles, residues, n)
    (psi_omega == omega ? 1 : 0)

