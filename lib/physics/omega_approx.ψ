let pigeonhole_check(values, n, p) =
    if n > p
        1
    else
        let has_dup = 0
        let i = 0
        for i < n && has_dup == 0
            let j = i + 1
            for j < n && has_dup == 0
                if values[i] == values[j]
                    has_dup = 1
                j = j + 1
            i = i + 1
        has_dup

let contraction_check(a_prn, b_prn) =
    let d_ab = prn_metric(a_prn, b_prn)
    let ka_prn = (a_prn == 8 ? 7 : (a_prn == 7 ? 4 : (a_prn == 4 ? 3 : (a_prn == 3 ? 2 : (a_prn == 2 ? 0 : 0)))))
    let kb_prn = (b_prn == 8 ? 7 : (b_prn == 7 ? 4 : (b_prn == 4 ? 3 : (b_prn == 3 ? 2 : (b_prn == 2 ? 0 : 0)))))
    let d_kakb = prn_metric(ka_prn, kb_prn)
    (d_kakb <= d_ab ? 1 : 0)

let universe_bootstrap(init_hash, init_prn, init_size, max_iter) =
