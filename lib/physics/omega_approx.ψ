let prn_metric(psi1_prn, psi2_prn) =
    let diff = psi1_prn - psi2_prn
    (diff < 0 ? 0 - diff : diff)

let contraction_factor(prn_before, prn_after) =
    if prn_before == 0
        0
    else
        gf_div(prn_after, prn_before)

let code_descriptor(code_hash, prn, size) = [code_hash, prn, size]

let desc_hash(d) = d[0]
let desc_prn(d) = d[1]
let desc_size(d) = d[2]

let kleene_map(d) =
    let h = desc_hash(d)
    let prn = desc_prn(d)
    let sz = desc_size(d)
    let new_prn = (prn == 8 ? 7 : (prn == 7 ? 4 : (prn == 4 ? 3 : (prn == 3 ? 2 : (prn == 2 ? 0 : 0)))))
    let new_hash = gf_pow(h, 65536)
    let new_size = (prn == 0 ? sz : gf_add(sz, gf_mul(new_prn, 100)))
    code_descriptor(new_hash, new_prn, new_size)

let omega_step(d) = kleene_map(d)

let omega_trajectory(init, n) =
    let traj = []
    let curr = init
    traj.push(curr)
    let i = 0
    for i < n
        curr = kleene_map(curr)
        traj.push(curr)
        i = i + 1
    traj

let is_converged(d) =
    (desc_prn(d) == 0 ? 1 : 0)

let omega_approximate(init, max_iter) =
    let curr = init
    let iter = 0
    let converged = 0
    for iter < max_iter
        if is_converged(curr) == 1
            converged = 1
            iter = max_iter
        else
            curr = kleene_map(curr)
        iter = iter + 1
    [curr, converged, iter]

