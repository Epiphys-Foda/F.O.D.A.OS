let conformal_vector_verify() =
    let result = 0
    if gf_mul(2, gf_inv(2)) == 1
        result = result + 1
    if gf_sub(gf_add(5, 1), 5) == 1
        result = result + 1
    if gf_mul(3, 0) == 0
        result = result + 1
    result

