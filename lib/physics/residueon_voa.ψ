let vertex_operator_verify() =
    let result = 0
    if gf_mul(1, 7) == 7
        result = result + 1
    if gf_add(0, 9) == 9
        result = result + 1
    if gf_mul(gf_mul(2, 3), 4) == gf_mul(2, gf_mul(3, 4))
        result = result + 1
    result

let virasoro_verify() =
    let result = 0
    if gf_sub(1, 0) == 1
        result = result + 1
    if gf_sub(gf_mul(2, gf_mul(2, 2)), 2) == 6
        result = result + 1
    if gf_mul(2, gf_sub(gf_mul(2, gf_mul(2, 2)), 2)) == 12
        result = result + 1
    result

let ope_verify() =
    let result = 0
    if gf_mul(gf_mul(2, 3), 4) == gf_mul(2, gf_mul(3, 4))
        result = result + 1
    if gf_add(gf_mul(2, 3), gf_mul(2, 5)) == gf_mul(2, gf_add(3, 5))
        result = result + 1
    if gf_mul(6, gf_inv(2)) == 3
        result = result + 1
    result

let moonshine_verify() =
    let result = 0
    if gf_mul(12, 2) == 24
        result = result + 1
    if gf_mul(gf_mul(2, gf_mul(2, 2)), 3) == 24
        result = result + 1
    if 196884 % 65537 == 273
        result = result + 1
    result

let zhu_algebra_verify() =
    let result = 0
    if gf_mul(gf_mul(2, 3), 4) == gf_mul(2, gf_mul(3, 4))
        result = result + 1
    if gf_mul(gf_add(2, 3), 4) == gf_add(gf_mul(2, 4), gf_mul(3, 4))
        result = result + 1
    if gf_mul(1, 6) == 6
        result = result + 1
    result

let character_verify() =
    let result = 0
    if gf_mul(2, 2) == 4
