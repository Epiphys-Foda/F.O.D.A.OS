let ricci_flat_verify() =
    let result = 0
    if gf_add(7, gf_neg(7)) == 0
        result = result + 1
    if gf_mul(7, gf_inv(7)) == 1
        result = result + 1
    if gf_sub(gf_mul(3, 5), gf_mul(5, 3)) == 0
        result = result + 1
    result

let yau_theorem_verify() =
    let result = 0
    if gf_mul(gf_neg(1), gf_neg(1)) == 1
        result = result + 1
    if gf_mul(gf_mul(2, 3), 4) == gf_mul(2, gf_mul(3, 4))
        result = result + 1
    if gf_sub(gf_add(4, 5), gf_add(5, 4)) == 0
        result = result + 1
    result

let kahler_verify() =
    let result = 0
    if gf_mul(0, 11) == 0
        result = result + 1
    if gf_mul(gf_neg(1), gf_neg(1)) == 1
        result = result + 1
    if gf_mul(2, gf_add(3, 4)) == gf_add(gf_mul(2, 3), gf_mul(2, 4))
        result = result + 1
    result

