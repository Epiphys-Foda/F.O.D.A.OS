let add(a, b) = a + b

let fib(n) =
  if n < 2
    return n
  else
    return fib(n - 1) + fib(n - 2)

let factorial(n) =
  if n <= 1
    return 1
  else
    return n * factorial(n - 1)

print(add(3, 4))
print(fib(10))
print(factorial(5))
